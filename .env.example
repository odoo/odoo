# Copy this file to .env and fill in the values
# .env is gitignored — never commit real credentials

# SMTP (Gmail) — used for sending invitation emails
# Generate an App Password at: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=TNPD Prison HRMS

# Frontend URL — used in activation links sent via email
# Local  : http://localhost
# Dev    : https://dev-tnprisons.giggso.com
# Prod   : https://tnprisons.giggso.com
APP_URL=http://localhost
