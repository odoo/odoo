<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sifnext_vehicle_booking_list"
            model="ir.ui.view">

        <field name="name">
            sifnext.operational.vehicle.booking.list
        </field>

        <field name="model">sifnext.operational.vehicle.booking</field>

        <field name="arch" type="xml">

            <list string="Peminjaman Kendaraan"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">

                <field name="name"/>
                <field name="applicant_id"/>
                <field name="vehicle_id"/>
                <field name="destination"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="availability"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <record id="view_sifnext_vehicle_booking_form"
            model="ir.ui.view">

        <field name="name">
            sifnext.operational.vehicle.booking.form
        </field>

        <field name="model">sifnext.operational.vehicle.booking</field>

        <field name="arch" type="xml">

            <form string="Peminjaman Kendaraan">

                <header>

                    <button name="action_submit"
                            string="Ajukan Peminjaman"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="state != 'draft'"/>

                    <button name="action_check_availability"
                            string="Cek Ketersediaan"
                            type="object"
                            class="btn-secondary"
                            icon="fa-search"
                            invisible="state != 'submitted'"/>

                    <button name="action_approve"
                            string="Setujui"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"
                            groups="sifnext_operational.group_sifnext_operational_ga"
                            invisible="state != 'waiting_approval'"/>

                    <button name="action_reject"
                            string="Tolak"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"
                            groups="sifnext_operational.group_sifnext_operational_ga"
                            invisible="state != 'waiting_approval'"/>

                    <button name="action_book"
                            string="Booking Jadwal"
                            type="object"
                            class="btn-primary"
                            icon="fa-calendar-check-o"
                            invisible="state != 'approved'"/>

                    <button name="action_done"
                            string="Tandai Selesai"
                            type="object"
                            class="btn-primary"
                            icon="fa-check-circle"
                            invisible="state != 'booked'"/>

                    <button name="action_cancel"
                            string="Batalkan"
                            type="object"
                            class="btn-secondary"
                            icon="fa-ban"
                            invisible="state in ('done', 'cancelled')"/>

                    <button name="action_reset_draft"
                            string="Kembalikan ke Draft"
                            type="object"
                            class="btn-secondary"
                            icon="fa-undo"
                            invisible="state != 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,waiting_approval,approved,booked,done"/>

                </header>

                <sheet>

                    <div class="oe_title">

                        <span class="text-muted">
                            PEMINJAMAN KENDARAAN DINAS
                        </span>

                        <h1>
                            <field name="name"
                                   readonly="1"/>
                        </h1>

                    </div>


                    <div class="alert alert-warning sifnext-alert"
                         role="alert"
                         invisible="state != 'waiting_approval'">

                        <strong>Menunggu Approval GA</strong>
                        <br/>
                        Pengajuan sedang menunggu persetujuan
                        General Affair.

                    </div>


                    <div class="alert alert-success sifnext-alert"
                         role="alert"
                         invisible="availability != 'available'">

                        <strong>âœ“ Kendaraan Tersedia</strong>
                        <br/>
                        Kendaraan tersedia pada jadwal yang dipilih.

                    </div>


                    <div class="alert alert-danger sifnext-alert"
                         role="alert"
                         invisible="availability != 'unavailable'">

                        <strong>âœ• Kendaraan Tidak Tersedia</strong>
                        <br/>
                        Silakan pilih kendaraan atau jadwal yang berbeda.

                    </div>


                    <group>

                        <group string="Informasi Pengajuan">

                            <field name="applicant_id"/>

                            <field name="vehicle_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>

                            <field name="passenger_count"
                                   readonly="state != 'draft'"/>

                            <field name="destination"
                                   placeholder="Contoh: Surabaya - Gresik"
                                   readonly="state != 'draft'"/>

                            <field name="purpose"
                                   placeholder="Contoh: Kunjungan kerja..."
                                   readonly="state != 'draft'"/>

                        </group>


                        <group string="Jadwal Perjalanan">

                            <field name="start_datetime"
                                   readonly="state != 'draft'"/>

                            <field name="end_datetime"
                                   readonly="state != 'draft'"/>

                            <field name="availability"
                                   readonly="1"/>

                        </group>

                    </group>


                    <separator string="Catatan Approval"/>

                    <group>

                        <field name="rejection_reason"
                               placeholder="Isi alasan jika pengajuan ditolak..."
                               invisible="state != 'rejected'"/>

                    </group>


                    <div class="sifnext-hint">

                        <strong>Alur Peminjaman</strong>

                        <div class="sifnext-flow">

                            <span class="sifnext-flow-item">
                                1. Ajukan
                            </span>

                            <span>â†’</span>

                            <span class="sifnext-flow-item">
                                2. Cek
                            </span>

                            <span>â†’</span>

                            <span class="sifnext-flow-item">
                                3. Approval GA
                            </span>

                            <span>â†’</span>

                            <span class="sifnext-flow-item">
                                4. Booking
                            </span>

                        </div>

                    </div>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>


    <record id="action_sifnext_vehicle_booking"
            model="ir.actions.act_window">

        <field name="name">Peminjaman Kendaraan</field>

        <field name="res_model">sifnext.operational.vehicle.booking</field>

        <field name="view_mode">list,form</field>

    </record>


    <menuitem id="menu_sifnext_vehicle_booking"
              name="Pengajuan Kendaraan"
              parent="menu_sifnext_vehicle"
              action="action_sifnext_vehicle_booking"
              sequence="10"/>

</odoo>
