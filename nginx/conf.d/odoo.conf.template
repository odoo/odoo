# =============================================================================
# nginx/conf.d/odoo.conf.template — Nginx reverse proxy for Odoo 19
#
# Dynamically configured via DOMAIN environment variable.
# Proxies Odoo (8069) and websocket (8072) upstreams.
# =============================================================================

upstream odoo_upstream {
    server odoo:8069;
}

upstream odoo_ws_upstream {
    server odoo:8072;
}

# =============================================================================
# HTTP → HTTPS redirect (required for Let's Encrypt ACME HTTP-01 challenge)
# =============================================================================
server {
    listen 80;
    server_name ${DOMAIN};

    # ACME HTTP-01 challenge — Let's Encrypt certbot writes here
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Everything else → HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# =============================================================================
# HTTPS server
# =============================================================================
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # ========================
    # TLS Certificates (Mounted from Certbot container / host)
    # ========================
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # ========================
    # Modern TLS best practices
    # ========================
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # HSTS (strict transport security) — 1 year, include subdomains
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Security headers (OWASP A05 — Security Misconfiguration)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss:; frame-ancestors 'none';" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # ========================
    # Common proxy headers
    # ========================
    proxy_set_header Host             $host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP        $remote_addr;
    proxy_redirect off;

    # ========================
    # Standard Odoo requests (HTTP)
    # ========================
    location / {
        proxy_pass http://odoo_upstream;

        # Increase body size for scanned invoice PDFs (up to 100 MB)
        client_max_body_size 100m;

        # Odoo long-poll: business flows can take 10+ minutes
        proxy_read_timeout 720s;
        proxy_connect_timeout 90s;

        # Buffering: let Odoo stream responses, don't buffer large bodies
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ========================
    # Websocket connections (Odoo live chat, bus, queue kanban)
    # ========================
    location /websocket {
        proxy_pass http://odoo_ws_upstream;

        # WebSocket protocol upgrade headers
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long timeout: websockets can idle for hours
        proxy_read_timeout 86400s;

        # No body buffering for websocket connections
        client_max_body_size 100m;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ========================
    # /ai/ — invoice-ai extraction service (ADR-003)
    # ========================
    # The AI service publishes no port to the host; nginx is its only
    # external entry point. /ai/healthz → /healthz so probes work end-to-end.
    # proxy_read_timeout raised to 300s for slow extractions (multi-page
    # scan OCR + Claude round-trip can exceed nginx's 60s default).
    location /ai/ {
        proxy_pass http://invoice-ai:8000/;
        proxy_set_header Host             $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        # Service caps uploads at 10 MiB; keep nginx above it so the
        # service's own 413 wins instead of an nginx 413.
        client_max_body_size 12m;
        proxy_buffering off;
    }

    # ========================
    # Static assets — serve directly from Odoo (or CDN if needed)
    # ========================
    location /web/static/ {
        proxy_pass http://odoo_upstream;
        proxy_cache_valid 200 60m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header Cache-Control "public, immutable";
    }

    # Deny access to hidden files
    location ~ /\. {
        deny all;
    }
}
