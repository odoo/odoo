# ============================================================
# AUTO-INFO Odoo 19 CE Project - Custom Exclusions
# ============================================================

# Python virtual environments
venv/
venv19/
venv*/
.env
.venv/

# Project backups & reference data
Odoo15Backup/
/backups/
*.bak
*.backup

# Legacy O15 database dump (may contain real business data - keep local only)
migration/od15_export/*.dump

# Local IDE debug notes (machine specific, not project source)
debug-trae-terminal-crash.md

# Generated report previews (sale report variants; local QA output only)
srn_preview/

# Ad-hoc API responses downloaded while developing (e.g. BOT OpenAPI specs)
response_*.json

# Data files (Excel, CSV, PDFs with sensitive data)
*.xlsx
*.xls
*.csv
*.pdf
!docs/**/*.xlsx
!docs/**/*.xls
!docs/**/*.csv
!custom_addons/**/security/*.csv

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Logs
*.log
logs/
install_log.txt
upgrade_log.txt

# Vendored Python libraries (large, environment-specific)
pylibs/

# Odoo local data (repo root only; module data/ folders must stay versioned)
/data/
/data_dir/
/data_test/
/data/sessions/
/data/attachments/
/data/backups/
odoo_local.conf
*.pid
*.sock

# Vendored nginx distribution (binary + shipped files);
# only the project reverse-proxy config is kept under version control
nginx/nginx-1.27.2/*
!nginx/nginx-1.27.2/conf/
nginx/nginx-1.27.2/conf/*
!nginx/nginx-1.27.2/conf/nginx.conf

# Agent Message Queue
.agent-mail/
.amqrc

# ============================================================
# Prebuilt Windows binaries & installers (not part of source)
# ============================================================
wkhtmltox_setup.exe
/wkhtmltopdf/bin/
upgrade_error.txt
