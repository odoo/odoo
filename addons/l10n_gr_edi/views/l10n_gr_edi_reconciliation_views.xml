<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_gr_edi_reconciliation_list" model="ir.ui.view">
        <field name="name">l10n_gr_edi.reconciliation.list</field>
        <field name="model">l10n_gr_edi.reconciliation</field>
        <field name="arch" type="xml">
            <list string="myDATA Reconciliation"
                  create="false"
                  edit="false"
                  delete="false"
                  default_order="aade_invoice_date desc, id desc">
                <header>
                    <button name="action_sync"
                            string="Sync"
                            type="object"
                            display="always"
                            class="btn-primary"
                            groups="account.group_account_user"/>
                </header>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="aade_invoice_date" string="Invoice Date"/>
                <field name="mark"/>
                <field name="state"
                       widget="badge"
                       decoration-warning="state == 'deviation'"
                       decoration-danger="state == 'rejected'"/>
                <field name="sync_datetime"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_gr_edi_reconciliation_form" model="ir.ui.view">
        <field name="name">l10n_gr_edi.reconciliation.form</field>
        <field name="model">l10n_gr_edi.reconciliation</field>
        <field name="arch" type="xml">
            <form string="myDATA Reconciliation" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <label for="mark"/>
                        <h1>
                            <field name="mark"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Odoo">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Status">
                            <field name="state"
                                   widget="badge"
                                   decoration-warning="state == 'deviation'"
                                   decoration-danger="state == 'rejected'"/>
                            <field name="classification_mark"/>
                            <field name="sync_datetime"/>
                        </group>
                    </group>
                    <group>
                        <group string="References">
                            <field name="uid"/>
                            <field name="qr_url" widget="url"/>
                        </group>
                        <group string="Invoice Data">
                            <field name="aade_invoice_series"/>
                            <field name="aade_invoice_number"/>
                            <field name="aade_invoice_date"/>
                            <field name="aade_invoice_type"/>
                            <field name="aade_counterpart_vat"/>
                        </group>
                    </group>
                    <group string="Official Amounts">
                        <field name="currency_id"/>
                        <field name="aade_amount_untaxed"/>
                        <field name="aade_amount_tax"/>
                        <field name="aade_amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_gr_edi_reconciliation_search" model="ir.ui.view">
        <field name="name">l10n_gr_edi.reconciliation.search</field>
        <field name="model">l10n_gr_edi.reconciliation</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="mark"/>
                <field name="classification_mark"/>
                <separator/>
                <filter name="no_exception"
                        string="No Exception Reported"
                        domain="[('state', '=', 'no_exception')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="deviation" string="Deviation" domain="[('state', '=', 'deviation')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_invoice_date" string="Invoice Date" context="{'group_by': 'aade_invoice_date'}"/>
                    <filter name="group_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_gr_edi_reconciliation" model="ir.actions.act_window">
        <field name="name">myDATA Reconciliation</field>
        <field name="res_model">l10n_gr_edi.reconciliation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_gr_edi_reconciliation_search"/>
    </record>

    <menuitem id="menu_l10n_gr_edi_reconciliation"
              name="myDATA Reconciliation"
              parent="account.account_audit_control_menu"
              action="action_l10n_gr_edi_reconciliation"
              sequence="30"/>
</odoo>
