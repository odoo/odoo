<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.WebrtcDebugPopup">
        <Dialog bodyClass="'d-flex flex-column gap-3 pt-0'" footer="false" title.translate="WebRTC" backdrop="true" size="'md'">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <button class="nav-link" t-att-class="{ active: this.state.tab === 'actions' }"
                        t-on-click="() => this.state.tab = 'actions'">Actions</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link d-flex align-items-center gap-1" t-att-class="{ active: this.state.tab === 'peers' }"
                        t-on-click="() => this.state.tab = 'peers'">
                        Peers
                        <span class="badge rounded-pill text-bg-secondary" t-out="this.peers.length"/>
                    </button>
                </li>
            </ul>

            <!-- Fixed grid: the shared control buttons CSS would make few buttons very large. -->
            <div t-if="this.state.tab === 'actions'" class="control-buttons control-buttons-modal d-grid gap-2"
                style="--grid-columns: 3; --oi-font-size: 1.5rem;">
                <t t-call="point_of_sale.controlButton"
                    icon="'send'"
                    btnText.translate="Broadcast &quot;Hi&quot;"
                    btnClasses="'btn-secondary '"
                    disabled="!this.peers.length"
                    onClick="() => this.broadcastHi()"/>
                <t t-call="point_of_sale.controlButton"
                    icon="'refresh'"
                    btnText.translate="Announce"
                    btnClasses="'btn-secondary '"
                    onClick="() => this.announce()"/>
            </div>

            <div t-if="this.state.tab === 'peers'" class="d-flex flex-column gap-2">
                <div class="d-flex align-items-center gap-2 p-2 rounded bg-100">
                    <i class="oi text-info" data-icon="account_tree" aria-hidden="true"/>
                    <span class="fw-bold">This terminal</span>
                    <code class="ms-auto" t-out="this.webrtc.id"/>
                </div>
                <div t-if="!this.peers.length" class="text-muted text-center py-3">No peer yet.</div>
                <div t-foreach="this.peers" t-as="peer" t-key="peer.id"
                    class="d-flex align-items-center gap-2 p-2 border rounded">
                    <code class="me-auto" t-out="peer.id"/>
                    <span t-attf-class="badge rounded-pill {{ peer.badgeClass }}" t-out="peer.state"/>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
