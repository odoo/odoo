<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.PaymentScreenPaymentLines">
        <div t-if="this.paymentLines.length" class="paymentlines flex-grow-1 d-flex flex-column overflow-y-auto gap-2" t-att-class="{'mb-3': !this.ui.isSmall}">
            <t t-foreach="this.paymentLines" t-as="line" t-key="line.uuid">
                <div class="paymentline d-flex align-items-center rounded-3" t-att-class="{ 'selected': line.isSelected() }">
                    <t t-set="controls" t-value="this.getLineControls(line)" />
                    <t t-foreach="controls.start" t-as="control" t-key="control.id">
                        <t t-call="point_of_sale.PaymentScreenPaymentLines.Control" />
                    </t>

                    <!-- Payment Info -->
                    <div class="payment-infos d-flex align-items-center justify-content-between flex-grow-1 px-3 py-3 text-truncate cursor-pointer fs-2" t-on-click="() => this.selectLine(line)">
                        <span class="payment-name">
                            <t t-out="line.displayName" /> <t t-out="line.currency.name" t-if="line.payment_method_id.availableCurrencies.length > 1" />
                        </span>
                        <div class="payment-amount px-3">
                            <PriceFormatter price="this.getFormattedPrice(line)" />
                        </div>
                    </div>

                    <t t-foreach="controls.end" t-as="control" t-key="control.id">
                        <t t-call="point_of_sale.PaymentScreenPaymentLines.Control" />
                    </t>
                </div>

                <!-- Payment Status -->
                <div t-if="line?.isSelected()" class="paymentline_status bg-body-secondary rounded-3">
                    <t t-set="state" t-value="this.getPaymentActionState(line)" />
                    <t t-if="state">
                        <div class="paymentline_status_title d-flex justify-content-between align-items-center gap-2 py-3 px-4 fs-4" t-attf-class="paymentline_status_title_{{state.id}}">
                            <span class="text-truncate" t-out="state.title" />
                            <t t-if="state.icon">
                                <i class="oi" t-att-class="state.iconClass" t-att-data-icon="state.icon" role="img" />
                            </t>
                        </div>
                        <div t-if="state.id == 'waiting' and line.payment_method_id.payment_interface?.amountInserted != null"
                            class="d-flex align-items-center justify-content-between pb-3 px-4 fs-4">
                            <span>Cash inserted</span>
                            <span t-out="this.pos.formatCurrency(line.payment_method_id.payment_interface.amountInserted)"/>
                        </div>
                        <div class="paymentline_status_actions btn-group d-flex w-100" role="group">
                            <button t-foreach="state.actions" t-as="button" t-key="button.id"
                                    t-if="button.show === undefined || button.show"
                                    t-attf-class="paymentline_status_actions_button paymentline_status_actions_button_{{button.id}} ms-0 p-3 fs-4 btn btn-{{button.severity}}"
                                    t-att-title="button.title || button.label"
                                    t-on-click="button.action"
                                    t-out="button.label" />
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>

    <t t-name="point_of_sale.PaymentScreenPaymentLines.Control">
        <button t-if="control.action"
                class="btn btn-link"
                t-att-class="control.classes"
                t-on-click="control.action"
                t-att-disabled="control.disabled"
                t-att-aria-label="control.title"
                t-att-title="control.title">
            <i class="oi" t-att-class="control.iconClass" t-att-data-icon="control.icon" role="img" />
        </button>
        <div t-else="" t-att-class="control.classes">
            <i class="oi" t-att-class="control.iconClass" t-att-data-icon="control.icon" role="img" />
        </div>
    </t>

</templates>
