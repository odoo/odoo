<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.TipScreen">
        <TipSelector
            title.translate="Add a tip"
            class="'o_pos_tip_screen'"
            onBack.bind="this.goPreviousScreen"
            overallAmount="this.overallAmount"
            tipSubText="this.tipSubText"
            percentageTips="this.percentageTips"
            selectedPercentage="this.state.selectedPercentage || ''"
            inputValue="this.state.inputTipAmount"
            currencySymbol="this.currentOrder.orderCurrency.symbol"
            onSelect.bind="this.selectTip"
            onInput.bind="this.onTipInput"
            onNoTip="() => this.noTip()"
            onSettle="() => this.settle()"/>
    </t>

</templates>
