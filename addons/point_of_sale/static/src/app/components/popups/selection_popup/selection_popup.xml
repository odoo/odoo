<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.SelectionPopup">
        <t t-set="bodyClass" t-value="'d-flex gap-2 pt-0 ' + (this.props.displayType === 'pills' ? 'flex-wrap align-items-start ' : 'flex-column ') + (this.props.bodyClass || '')"/>
        <Dialog title="this.props.title" footer="false" size="this.props.size" bodyClass="bodyClass">
            <button t-foreach="this.state.list" t-as="item" t-key="item.id"
                    class="selection-item d-flex align-items-center btn btn-lg btn-outline-secondary text-start"
                    t-attf-class="{{ item.color === undefined ? '' : 'o_colorlist_color o_colorlist_color_' + item.color }}"
                    t-att-class="this.getItemBtnClass(item)"
                    t-on-click="() => this.selectItem(item.id)">

                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center my-n3 ms-n3 px-3 align-self-stretch"
                         t-if="this.props.stars"
                         t-on-click.stop="() => this.star(item.id)">
                        <i class="oi"
                           data-icon="star"
                           t-att-class="{ 'oi-filled o_star_gold': item.isStarred }"
                        />
                    </div>
                    <div class="ratio ratio-1x1 me-3" style="width: 40px" t-if="item.image">
                         <img class="rounded-3" t-att-src="item.image"/>
                    </div>
                    <div class="d-flex flex-column">
                        <span t-out="item.label" />
                        <span t-out="item.description" t-if="item.description" />
                    </div>
                </div>
                <i t-if="this.props.displayType === 'list' or item.isSelected"
                    class="oi"
                    t-att-class="{ 'text-action': item.isSelected }"
                    t-attf-data-icon="{{ item.isSelected ? 'check' : 'chevron_forward' }}"/>
            </button>
        </Dialog>
    </t>

</templates>
