<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.SnoozeDialog">
        <Dialog size="'sm'">
            <t t-set-slot="header">
                <h3> <t t-out="this.headerTitle " /> </h3>
            </t>
            <div class="d-flex flex-row flex-wrap gap-2 o_snooze_options" role="group">
                <t t-foreach="this.getSnoozeOptions()" t-as="option" t-key="option.value">
                    <button type="button"
                        t-attf-class="btn btn-secondary o_snooze_option {{ this.state.hours === option.value ? 'o_snooze_option_selected' : '' }}"
                            t-on-click="() => this.select(option.value)">
                        <t t-out="option.label"/>
                    </button>
                </t>

            </div>
            <t t-set-slot="footer">
                <div class="d-flex flex-row gap-2 w-100">
                    <button class="btn btn-primary flex-grow-1 flex-sm-grow-0" t-on-click="this.save">Apply</button>
                    <button class="btn btn-secondary flex-grow-1 flex-sm-grow-0" t-on-click="this.props.close">Discard</button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
