<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.CashierName">
        <button t-att-class="this.cssClass"
            class="cashier-name btn btn-sm ms-2 btn-light border-0"
            t-attf-style="background-image: url('{{this.avatar}}');">
            <i class="oi oi-fw" aria-hidden="true"/>
        </button>
    </t>

</templates>
