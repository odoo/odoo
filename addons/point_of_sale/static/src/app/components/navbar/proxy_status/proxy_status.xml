<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.ProxyStatus">
        <button class="oe_status js_proxy btn btn-light" t-on-click="() => this.pos.connectToProxy()">
            <span t-if="this.message and !this.ui.isSmall" class="js_msg">
                <t t-out="this.message" />
            </span>
            <span t-if="this.connectionInfo.status === 'connected' and !this.message" class="js_connected text-success">
                <i class="fa-solid fa-sitemap" role="img" aria-label="Proxy Connected"
                   title="Proxy Connected"></i>
            </span>
            <span t-if="this.connectionInfo.status === 'connecting'" class="js_connecting">
                <i class="fa-solid fa-circle-notch fa-spin" role="img" aria-label="Connecting to Proxy"
                   title="Connecting to Proxy"></i>
            </span>
            <span t-elif="this.connectionInfo.status === 'disconnected'" class="js_disconnected text-danger">
                <i class="fa-solid fa-sitemap" role="img" aria-label="Proxy Disconnected"
                   title="Proxy Disconnected"></i>
            </span>
            <span t-elif="this.connectionInfo.status === 'warning' or this.message" class="js_warning text-warning">
                <i class="fa-solid fa-sitemap" role="img" aria-label="Proxy Warning"
                   title="Proxy Warning"></i>
            </span>
        </button>
    </t>

</templates>
