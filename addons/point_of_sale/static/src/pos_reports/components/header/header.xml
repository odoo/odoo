<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="pos_reports.Header">
        <div class="o_report_header_row d-grid align-items-end border-bottom">
            <div class="o_report_section_title fw-semibold py-1">
                <span t-out="this.props.sectionName"/>
            </div>
            <t t-foreach="this.props.columns" t-as="col" t-key="col.id">
                <div class="o_report_column_header fw-medium text-muted py-1" t-att-class="'text-' + (col.align === 'right' ? 'end' : 'start')">
                    <span t-out="col.label"/>
                </div>
            </t>
        </div>
    </t>
</templates>
