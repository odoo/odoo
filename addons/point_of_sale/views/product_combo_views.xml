<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="point_of_sale.product_combo_view_form" model="ir.ui.view">
        <field name="name">product.combo.form.inherit.point.of.sale</field>
        <field name="model">product.combo</field>
        <field name="inherit_id" ref="product.product_combo_view_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="context">{'default_available_in_pos': True}</attribute>
            </field>

            <xpath expr="//group[@name='combo_left_col']" position="after">
                <group>
                    <field
                        name="base_price"
                        widget="monetary"
                        options="{'field_digits': True}"
                        invisible="not context.get('is_from_pos')"
                    />
                </group>
            </xpath>

            <xpath expr="//field[@name='included_qty']" position="before">
                <field name="qty_max" string="Maximum items" invisible="not context.get('is_from_pos')"/>
            </xpath>

            <xpath expr="//field[@name='included_qty']" position="attributes">
                <attribute name="invisible">is_upsell</attribute>
            </xpath>

            <xpath expr="//field[@name='included_qty']" position="after">
                <field name="is_upsell" widget="boolean_toggle" invisible="not context.get('is_from_pos')"/>
            </xpath>

            <xpath expr="//group[@name='combo_groups']" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not is_upsell or context.get('is_from_pos')"
                >
                    <field name="upsell_warning"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
