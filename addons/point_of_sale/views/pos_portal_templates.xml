<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_invoice" name="Portal layout : pos menu entries" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li name="pos_orders_breadcrumb" t-if="page_name == 'pos_order'" class="breadcrumb-item active">
                Store Orders
            </li>
        </xpath>
    </template>

    <template id="portal_my_pos_orders" name="My PoS Orders">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Your Store Orders"/>
            <div t-if="not pos_orders" class="alert alert-warning" role="alert">
                There are currently no in store orders for your account.
            </div>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Receipt Number</th>
                        <th class="text-end">Order Date</th>
                        <th class="text-end">Total</th>
                        <th/>
                        <th/>
                    </tr>
                </thead>
                <tr t-foreach="pos_orders" t-as="order">
                    <td t-out="order.pos_reference" />
                    <td class="text-end">
                        <span t-field="order.date_order" t-options="{'widget': 'date'}"/>&amp;nbsp;
                        <span class="d-none d-md-inline" t-field="order.date_order" t-options="{'time_only': True}"/>
                    </td>
                    <td class="text-end">
                        <span t-field="order.amount_total"/>
                    </td>
                    <td class="text-end">
                        <a t-att-href="order.get_receipt_url(download=True)" title="Download receipt">
                            <i class="oi oi-fw fs-4" data-icon="download"/>
                        </a>
                    </td>
                    <td class="text-start">
                        <a t-att-href="order.get_portal_invoice_url()" target="_blank" title="Invoice">
                            <i class="oi oi-fw fs-4" data-icon="description"/>
                            <span class="d-none d-md-inline">Invoice</span>
                        </a>
                    </td>
                </tr>
            </t>
        </t>
    </template>
</odoo>
