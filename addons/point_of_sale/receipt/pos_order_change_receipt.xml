<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="point_of_sale.pos_order_change_receipt">
            <html id="pos-receipt">
                <head>
                    <meta charset="UTF-8"></meta>  <!--  Needed for wkhtmltoimage to render UTF-8 characters properly -->
                    <t t-call="point_of_sale.pos_order_receipt_style" />
                </head>
                <body>
                    <div class="pos-receipt m-0 p-0" style="padding-top: 80px !important;">
                        <div name="receipt-header" class="text-center">
                            <div name="preset-info" class="preset-name text-huge text-center text-bold" t-if="preset">
                                <span t-if="preset" t-out="preset['name']"/>
                                <span t-if="extra_data.get('preset_time')"> (<t t-out="extra_data['preset_time']"/>)</span>
                            </div>

                            <div name="employee-info" class="text-small">
                                <span><t t-out="config['name']"/> : <t t-out="extra_data['time']"/></span><br/>
                                <span t-if="extra_data.get('employee_name')">By: <t t-out="extra_data['employee_name']"/></span>
                            </div>
                            <div name="order-info" class="mt-2 text-huge">
                                <div name="tracking-number">
                                    <span t-out="extra_data['prefix']"/>
                                    <span> </span>
                                    <span class="text-bold" t-out="order['tracking_number']"/>
                                </div>
                                <div t-if="extra_data.get('order_label')" name="order-label" class="text-large" t-out="extra_data['order_label']" />
                            </div>
                            <div name="order-reference" t-out="order['pos_reference']" />
                        </div>
                        <hr style="border: none; border-top: 4px dashed black;"/>
                        <div name="body" class="pos-receipt-body pb-5">
                            <t t-set="hasDataChanges" t-value="changes.get('data') or changes.get('title') or changes.get('groupedData')" />
                            <div t-if="changes.get('title')" class="text-center text-bold text-insane w-100">
                                <t t-out="changes['title']" />
                                <t t-if="extra_data['reprint']">
                                    (DUPLICATE !)
                                </t>
                            </div>

                            <t t-if="changes.get('groupedData') and len(changes['groupedData'])">
                                <div t-foreach="changes['groupedData']" t-as="group">
                                    <div style="border-bottom: 2px dashed black;" class="mb-2 pb-1 text-bold mt-1 text-huge" t-out="group['name']" />
                                    <div t-foreach="group['data']" t-as="line">
                                        <t t-call="point_of_sale.pos_order_change_receipt_line" />
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div t-foreach="changes['data']" t-as="line">
                                    <t t-call="point_of_sale.pos_order_change_receipt_line" />
                                </div>
                            </t>
                            <t t-if="extra_data.get('general_customer_note')" t-set="extraNoteClass" t-value="'mb-3'"/>
                            <t t-else="" t-set="extraNoteClass" t-value="''"/>
                            <div t-if="extra_data.get('internal_note')" name="new-changes-internal-note" t-attf-class="new-changes w-100 {{extraNoteClass}}">
                                <div class="pos-receipt-title text-center text-insane w-100 text-bold">
                                    <strong>INTERNAL NOTE</strong>
                                </div>
                                <div class="text-center text-large text-italic" t-out="extra_data['internal_note']" />
                            </div>

                            <div t-if="extra_data['general_customer_note']" name="new-changes-customer-note" class="new-changes w-100">
                                <div class="pos-receipt-title text-center text-insane w-100 text-bold">
                                    <strong>CUSTOMER NOTE</strong>
                                </div>
                                <div class="text-center text-large text-italic" t-out="extra_data['general_customer_note']" />
                            </div>
                        </div>
                    </div>
                </body>
            </html>
        </template>

        <template id="point_of_sale.pos_order_change_receipt_line">
            <t t-if="line['combo_parent_uuid']" t-set="extraComboLineClass" t-value="'ps-5'"/>
            <t t-else="" t-set="extraComboLineClass" t-value="''"/>
            <div t-attf-class="orderline text-large {{extraComboLineClass}}">
                <div class="text-huge">
                    <span class="me-3 font-monospace" t-out="line['quantity']"/>
                    <span class="product-name text-break" t-out="line['basic_name']"/>
                </div>
                <div t-if="line.get('attribute_value_names') and len(line['attribute_value_names'])" class="ps-5">
                    <t t-foreach="line['attribute_value_names']" t-as="name">
                        <div class="text-large">- <t t-out="name" /></div>
                    </t>
                </div>
                <div t-if="line.get('pack_lot_lines') and len(line['pack_lot_lines'])" class="ps-5">
                    <t t-foreach="line['pack_lot_lines']" t-as="name">
                        <div class="text-normal">• <t t-out="name" /></div>
                    </t>
                </div>
                <div t-if="line.get('note')" class="text-italic" t-out="line['note']"/>
                <div t-if="line.get('customer_note')" class="text-italic" t-out="line['customer_note']"/>
            </div>
        </template>
    </data>
</odoo>
