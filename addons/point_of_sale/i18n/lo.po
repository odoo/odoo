msgstr "ເລກທີໃບບິນຄວນມີຄວາມຍາວຢ່າງໜ້ອຍ 12 ຕົວອັກສອນ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/screens/payment_screen/payment_screen.js:0
msgid ""
"The amount cannot be higher than the due amount if you don't have a cash "
"payment method configured."
msgstr "ຈຳນວນເງິນບໍ່ສາມາດສູງກວ່າຍອດທີ່ຕ້ອງຊຳລະ ຖ້າຫາກທ່ານບໍ່ໄດ້ຕັ້ງຄ່າວິທີການຊຳລະດ້ວຍເງິນສົດໄວ້."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/order_payment_validation.js:0
msgid ""
"The amount of your payment lines must be rounded to validate the "
"transaction.\n"
"The rounding precision is %(rounding)s so you should set %(expectedAmount)s "
"as payment amount instead of %(paidAmount)s."
msgstr ""
"ຈຳນວນເງິນໃນລາຍການຊຳລະຂອງທ່ານຕ້ອງຖືກປັດເສດເພື່ອຢືນຢັນທຸລະກຳ.\n"
"ຄວາມລະອຽດໃນການປັດເສດແມ່ນ %(rounding)s ດັ່ງນັ້ນທ່ານຄວນໃສ່ %(expectedAmount)s "
"ເປັນຈຳນວນເງິນຊຳລະ ແທນທີ່ຈະເປັນ %(paidAmount)s."

#. module: point_of_sale
#: model:ir.model.fields,help:point_of_sale.field_pos_payment__card_brand
msgid "The brand of the payment card (e.g. Visa, AMEX, ...)"
msgstr "ຍີ່ຫໍ້ຂອງບັດຊຳລະເງິນ (ຕົວຢ່າງ: Visa, AMEX, ...)"

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_config.py:0
msgid ""
"The cash payment method must have a linked bank statement to open the cash "
"control."
msgstr ""
"ວິທີການຊຳລະດ້ວຍເງິນສົດຕ້ອງມີການເຊື່ອມໂຍງກັບໃບແຈ້ງຍອດບັນຊີທະນາຄານ ເພື່ອເປີດການຄວບຄຸມເງິນສົດ."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_config.py:0
msgid "The company must have a fiscal country set."
msgstr "ບໍລິສັດຕ້ອງມີການກຳນົດປະເທດທາງດ້ານບັນຊີ-ອາກອນ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/models/utils/indexed_db.js:0
msgid ""
"The connection to the local database was lost. Reloading the page will "
"restore it and prevent any loss of unsaved orders."
msgstr ""
"ການເຊື່ອມຕໍ່ກັບຖານຂໍ້ມູນພາຍໃນຫຼຸດຂາດ. ການໂຫຼດໜ້າໃໝ່ຈະຊ່ວຍກູ້ຄືນການເຊື່ອມຕໍ່ ແລະ "
"ປ້ອງກັນການສູນຫາຍຂອງອໍເດີທີ່ຍັງບໍ່ທັນບັນທຶກ."

#. module: point_of_sale
#: model:ir.model.fields,help:point_of_sale.field_pos_payment__foreign_currency_id
msgid ""
"The currency in which the payment was made, if different from the order's "
"currency."
msgstr "ສະກຸນເງິນທີ່ໃຊ້ໃນການຊຳລະ, ໃນກໍລະນີທີ່ຕ່າງຈາກສະກຸນເງິນຂອງອໍເດີ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/backend/test_epos/test_epos.js:0
msgid "The cutter has a foreign matter, please check the cutter mechanism"
msgstr "ມີສິ່ງແປກປອມຕິດຢູ່ໃນໃບມີດຕັດ, ກະລຸນາກວດສອບກົນໄກຂອງໃບມີດຕັດ"

#. module: point_of_sale
#: model:ir.model.fields,help:point_of_sale.field_pos_config__default_partner_id
#: model:ir.model.fields,help:point_of_sale.field_res_config_settings__pos_default_partner_id
msgid "The default customer used in PoS session closing"
msgstr "ລູກຄ້າເລີ່ມຕົ້ນທີ່ໃຊ້ໃນຕອນປິດຮອບການຂາຍ PoS"

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_config.py:0
msgid "The default pricelist must be included in the available pricelists."
msgstr "ລາຍການລາຄາເລີ່ມຕົ້ນຕ້ອງມີຢູ່ໃນລາຍການລາຄາທີ່ພ້ອມໃຊ້ງານ."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_config.py:0
msgid ""
"The default pricelist must belong to no company or the company of the point "
"of sale."
msgstr "ລາຍການລາຄາເລີ່ມຕົ້ນຕ້ອງບໍ່ຂຶ້ນກັບບໍລິສັດໃດ ຫຼື ຂຶ້ນກັບບໍລິສັດຂອງຈຸດຂາຍໜ້າຮ້ານນັ້ນ."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_config.py:0
msgid ""
"The default tip product is missing. Please manually specify the tip product. "
"(See Tips field.)"
msgstr "ບໍ່ພົບສິນຄ້າເງິນຕິບເລີ່ມຕົ້ນ. ກະລຸນາລະບຸສິນຄ້າເງິນຕິບດ້ວຍຕົນເອງ. (ເບິ່ງທີ່ຊ່ອງ ເງິນຕິບ)"

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/backend/test_epos/test_epos.js:0
msgid ""
"The device is not connected, please check the printer power / connection"
msgstr "ອຸປະກອນບໍ່ໄດ້ເຊື່ອມຕໍ່, ກະລຸນາກວດສອບສາຍໄຟ / ການເຊື່ອມຕໍ່ຂອງເຄື່ອງພິມ"

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/controllers/main.py:0
msgid "The field %s must be filled."
msgstr "ຊ່ອງຂໍ້ມູນ %s ຕ້ອງຖືກຕື່ມ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/screens/ticket_screen/ticket_screen.js:0
msgid ""
"The fiscal position used in the original order is not loaded. Make sure it "
"is loaded by adding it in the pos configuration."
msgstr ""
"ສະຖານະທາງອາກອນທີ່ໃຊ້ໃນອໍເດີຕົ້ນສະບັບບໍ່ໄດ້ຖືກໂຫຼດ. ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າມັນຖືກໂຫຼດແລ້ວ "
"ໂດຍການເພີ່ມມັນເຂົ້າໃນການຕັ້ງຄ່າ PoS."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/utils/printer/epson_printer.js:0
msgid ""
"The following error code was given by the printer: %s \n"
"To find more details on the error reason, please search online for: Epson "
"ePoS error %s "
msgstr ""
"ລະຫັດຂໍ້ຜິດພາດດັ່ງກ່າວຖືກສົ່ງມາຈາກເຄື່ອງພິມ: %s \n"
"ເພື່ອຊອກຫາລາຍລະອຽດເພີ່ມເຕີມກ່ຽວກັບສາເຫດຂໍ້ຜິດພາດ, ກະລຸນາຄົ້ນຫາທາງອອນລາຍ: Epson ePoS error "
"%s "

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/wizard/pos_make_invoice.py:0
msgid ""
"The following refund orders can't be part of a consolidated invoice because "
"they refunded invoiced orders. Each refund order should be handled "
"separately.\n"
"\n"
"%s"
msgstr ""
"ອໍເດີສົ່ງເງິນຄືນຕໍ່ໄປນີ້ບໍ່ສາມາດລວມຢູ່ໃນໃບແຈ້ງໜີ້ລວມໄດ້ "
"ເນື່ອງຈາກເປັນການສົ່ງເງິນຄືນສຳລັບອໍເດີທີ່ອອກໃບແຈ້ງໜີ້ແລ້ວ. "
"ແຕ່ລະອໍເດີສົ່ງເງິນຄືນຄວນຖືກຈັດການແຍກຕ່າງຫາກ.\n"
"\n"
"%s"

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/product_combo.py:0
msgid "The free quantity must be smaller or equal to the maximum quantity."
msgstr "ຈຳນວນທີ່ແຖມຟຣີຕ້ອງໜ້ອຍກວ່າ ຫຼື ເທົ່າກັບຈຳນວນສູງສຸດ."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/product_combo.py:0
msgid "The free quantity of a combo must be greater or equal to 1."
msgstr "ຈຳນວນທີ່ແຖມຟຣີຂອງຊຸດຄອມໂບຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/product_combo.py:0
msgid "The free quantity of an upsell combo must be equal to 0."
msgstr "ຈຳນວນທີ່ແຖມຟຣີຂອງຊຸດຄອມໂບເພື່ອຂາຍເພີ່ມຕ້ອງເທົ່າກັບ 0."

#. module: point_of_sale
#: model:ir.model.fields,help:point_of_sale.field_pos_config__session_closing_daily_hour
#: model:ir.model.fields,help:point_of_sale.field_res_config_settings__pos_session_closing_daily_hour
msgid ""
"The hour at which the session will be automatically closed when the closing "
"mode is set to 'Daily'."
msgstr "ເວລາທີ່ຈະປິດຮອບການຂາຍໂດຍອັດຕະໂນມັດ ເມື່ອໂໝດການປິດຖືກຕັ້ງເປັນ 'ປະຈຳວັນ'."

#. module: point_of_sale
#: model_terms:ir.ui.view,arch_db:point_of_sale.res_config_settings_view_form
msgid ""
"The invoice will be downloaded on your device whenever you invoice an order"
msgstr "ໃບແຈ້ງໜີ້ຈະຖືກດາວໂຫຼດລົງໃນອຸປະກອນຂອງທ່ານທຸກຄັ້ງທີ່ທ່ານອອກໃບແຈ້ງໜີ້ສຳລັບອໍເດີ"

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_order.py:0
msgid "The mail template with xmlid %s has been deleted."
msgstr "ແມ່ແບບອີເມວທີ່ມີ xmlid %s ໄດ້ຖືກລຶບໄປແລ້ວ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/components/popups/closing_popup/closing_popup.js:0
msgid ""
"The maximum difference allowed is %s.\n"
"Please contact your manager to accept the closing difference."
msgstr ""
"ສ່ວນຕ່າງສູງສຸດທີ່ອະນຸຍາດແມ່ນ %s.\n"
"ກະລຸນາຕິດຕໍ່ຜູ້ຈັດການຂອງທ່ານເພື່ອອະນຸມັດສ່ວນຕ່າງຕອນປິດຮອບ."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/product_combo.py:0
msgid "The maximum quantity of a combo must be greater or equal to 1."
msgstr "ຈຳນວນສູງສຸດຂອງຊຸດຄອມໂບຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/backend/lna_checklist/lna_checklist.xml:0
msgid "The message will appear from the browser."
msgstr "ຂໍ້ຄວາມຈະສະແດງຂຶ້ນຈາກບຣາວເຊີ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/components/popups/closing_popup/closing_popup.js:0
msgid ""
"The money counted doesn't match what we expected. Want to log the difference "
"for the books?"
msgstr "ເງິນທີ່ນັບໄດ້ຕົວຈິງບໍ່ກົງກັບຍອດທີ່ຄາດໄວ້. ທ່ານຕ້ອງການບັນທຶກສ່ວນຕ່າງລົງໃນບັນຊີບໍ່?"

#. module: point_of_sale
#: model:ir.model.fields,help:point_of_sale.field_res_partner__pos_order_count
#: model:ir.model.fields,help:point_of_sale.field_res_users__pos_order_count
msgid "The number of point of sales orders related to this customer"
msgstr "ຈຳນວນອໍເດີລະບົບຂາຍໜ້າຮ້ານທີ່ກ່ຽວຂ້ອງກັບລູກຄ້ານີ້"

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_order.py:0
msgid ""
"The order delivery / pickup date is in the future. You cannot cancel it."
msgstr "ວັນທີຈັດສົ່ງ / ຮັບອໍເດີແມ່ນຢູ່ໃນອະນາຄົດ. ທ່ານບໍ່ສາມາດຍົກເລີກໄດ້."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_order.py:0
msgid "The paid amount is different from the total amount of the order."
msgstr "ຈຳນວນເງິນທີ່ຊຳລະແລ້ວບໍ່ກົງກັບຍອດລວມທັງໝົດຂອງອໍເດີ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/backend/test_epos/test_epos.js:0
msgid "The paper is empty, please load paper into the printer"
msgstr "ເຈ້ຍໝົດ, ກະລຸນາໃສ່ເຈ້ຍລົງໃນເຄື່ອງພິມ"

#. module: point_of_sale
#: model_terms:ir.ui.view,arch_db:point_of_sale.res_config_settings_view_form
msgid "The partner account will be used to generate out receipts."
msgstr "ບັນຊີຄູ່ຄ້າຈະຖືກນຳໃຊ້ເພື່ອອອກໃບບິນຮັບເງິນ."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/backend/lna_checklist/lna_checklist.xml:0
msgid "The password is located on the back of the printer (remove covers)."
msgstr "ລະຫັດຜ່ານຢູ່ດ້ານຫຼັງຂອງເຄື່ອງພິມ (ຖອດຝາປິດອອກ)."

#. module: point_of_sale
#. odoo-python
#: code:addons/point_of_sale/models/pos_payment.py:0
msgid ""
"The payment method selected is not allowed in the config of the POS session."
msgstr "ວິທີການຊຳລະເງິນທີ່ເລືອກບໍ່ໄດ້ຮັບອະນຸຍາດໃນການຕັ້ງຄ່າຂອງຮອບການຂາຍ PoS ນີ້."

#. module: point_of_sale
#. odoo-javascript
#: code:addons/point_of_sale/static/src/app/components/popups/select_default_payment_method_popup/select_default_payment_method_popup.xml:0
msgid ""
"The payment method you choose will be linked to your device. You can change "
"it later from the menu on top right."
msgstr ""

#. module: point_of_sale
#: model:ir.model.fields,help:point_of_sale.field_pos_config__iface_available_categ_ids
msgid ""
"The point of sale will only display products which are within one of the "
"selected category trees. If no category is specified, all available products "
