<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="action_sign_invoices" model="ir.actions.server">
            <field name="name">Sign Invoices</field>
            <field name="model_id" ref="account.model_account_move" />
            <field name="binding_model_id" ref="account.model_account_move" />
            <field name="state">code</field>
            <field name="code">action = records.action_post_sign_invoices()</field>
        </record>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">view_move_form_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="priority" eval="40" />
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_post']" position="after">
                    <button
                        name="action_post_sign_invoices"
                        type="object"
                        string="Sign Invoice"
                        groups="account.group_account_manager"
                        invisible="country_code != 'EG' or l10n_eg_is_signed or state != 'posted'"
                        class="oe_highlight" />
                </xpath>
                <notebook position="inside">
                    <page
                        name="page_eta_e_invoice"
                        string="ETA E-Invoice"
                        invisible="country_code != 'EG'">
                        <group>
                            <group>
                                <field name="l10n_eg_uuid" readonly="1" />
                                <field name="l10n_eg_submission_number" readonly="1" />
                            </group>
                            <group>
                                <field
                                    name="l10n_eg_eta_json_doc_file"
                                    widget="binary"
                                    invisible="1" />
                                <field name="l10n_eg_is_signed" invisible="1" />
                            </group>
                            <group>
                                <button
                                    name="action_get_eta_invoice_pdf"
                                    type="object"
                                    string="Get ETA Invoice PDF"
                                    icon="fa-clone"
                                    groups="account.group_account_invoice"
                                    invisible="edi_state != 'sent'"
                                    class="oe_link" />
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>

</odoo>
