<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.BuilderNumberInput">
    <BuilderComponent>
        <BuilderTextInputBase
            t-props="this.textInputBaseProps"
            inputRef="this.inputRef"
            value="this.displayValue"
            classes="'o-hb-input-field-number justify-content-end'"
            inputClasses="this.props.inputClasses ? `o-hb-input-number text-end ${this.props.inputClasses}` : 'o-hb-input-number text-end'"
            commit="this.commit"
            preview="this.preview"
            onKeydown.bind="this.onKeydown"
            >
            <span class="o-hb-input-field-unit" t-out="this.props.unit"/>
        </BuilderTextInputBase>
    </BuilderComponent>
</t>

</templates>
