<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.BuilderTextInput">
    <BuilderComponent>
        <BuilderTextInputBase
                t-props="this.textInputBaseProps"
                commit="this.commit"
                preview="this.preview"
                value="this.state.value"
                classes="'o_hb_input_field_text'"
                inputClasses="this.textInputBaseProps.inputClasses ? `o_hb_input_text ${this.textInputBaseProps.inputClasses}` : 'o_hb_input_text'"
        />
    </BuilderComponent>
</t>

</templates>
