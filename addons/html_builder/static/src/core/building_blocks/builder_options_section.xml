<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.BuilderOptionsSection">
    <div class="o_hb_options_container mb-1" t-att-data-container-title="this.props.title" t-att-class="this.props.containerClass">
        <div t-if="this.props.title" class="o_hb_options_container_header d-flex align-items-center">
            <span class="o_hb_options_container_label ps-2 py-2" t-out="this.props.title"/>
        </div>
        <div class="o_hb_bg_options_container pb-3">
            <t t-call-slot="default"/>
        </div>
    </div>
</t>

</templates>
