<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.BuilderUrlPicker">
    <BuilderComponent>
        <BuilderTextInputBase
                t-props="this.textInputBaseProps"
                inputRef="this.inputRef"
                commit="this.commit"
                preview="this.preview"
                value="this.state.value"
        >
            <button class="btn" title="Preview this URL in a new tab" t-on-click="this.openPreviewUrl">
                <i class="oi oi-fw" data-icon="open_in_new" role="img" aria-hidden="true"/>
                <span class="visually-hidden">Preview this URL in a new tab</span>
            </button>
        </BuilderTextInputBase>
    </BuilderComponent>
</t>

</templates>
