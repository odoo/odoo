<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.Builder">
    <div class="h-100 o-snippets-menu d-flex flex-column" t-ref="this.builderSidebarRef">
        <div class="o-snippets-top-actions d-flex justify-content-between flex-shrink-0 p-2">
            <div class="d-flex gap-1">
                <button type="button" t-on-click="() => this.undo()" class="oi oi-lg px-1 o-hb-btn btn" data-icon="undo" t-att-disabled="!this.state.canUndo"/>
                <button type="button"  t-on-click="() => this.redo()" class="oi oi-lg px-1 o-hb-btn btn" data-icon="redo" t-att-disabled="!this.state.canRedo"/>
            </div>
            <div class="d-flex gap-1">
                <button t-on-click="this.onMobilePreviewClick" type="button" class="o-hb-btn btn btn-success-color-active px-1 d-flex align-items-center" t-att-class="{ active: this.props.isMobile }" data-action="mobile" title="Mobile Preview" accesskey="m"><span class="oi oi-lg" data-icon="smartphone" role="img"/></button>
                <t t-if="this.props.slots?.extraActions" t-call-slot="extraActions"/>
            </div>
        </div>
        <div t-if="!this.props.onlyCustomizeTab" class="o-snippets-tabs position-relative">
            <div
                class="o-snippets-tabs-highlighter position-absolute start-50 h-100 pe-none"
                t-att-class="{
                    'o-highlight-blocks': this.state.activeTab === 'blocks',
                    'o-highlight-theme': this.state.activeTab === 'theme',
                }"
            />
            <ul class="nav nav-underline" role="tablist">
                <li class="nav-item" role="presentation">
                    <button id="blocks-tab" data-name="blocks" data-hotkey="1" class="o-hb-tab nav-link position-relative w-100 px-1" t-att-class="{'active cursor-default': this.state.activeTab === 'blocks'}" t-on-click="() => this.onTabClick('blocks')" t-att-disabled="this.props.onlyCustomizeTab" role="tab" t-att-aria-selected="this.state.activeTab === 'blocks' ? 'true' : 'false'" data-text-truncate-tooltip="">
                        <i class="oi me-2" data-icon="add" role="none"/>Blocks
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button id="customize-tab" data-name="customize" class="o-hb-tab nav-link position-relative w-100 px-1" t-att-class="{'active cursor-default': this.state.activeTab === 'customize'}" t-on-click="() => this.onTabClick('customize')" role="tab" t-att-aria-selected="this.state.activeTab === 'customize' ? 'true' : 'false'" data-text-truncate-tooltip="">
                        <i class="oi oi-filled me-2" data-icon="edit" role="none"/>Style
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button id="theme-tab" data-name="theme" data-hotkey="2" t-if="this.ThemeTab" class="o-hb-tab nav-link position-relative w-100 px-1" t-att-class="{'active cursor-default': this.state.activeTab === 'theme'}" t-on-click="() => this.onTabClick('theme')" t-att-disabled="this.props.onlyCustomizeTab" role="tab" t-att-aria-selected="this.state.activeTab === 'theme' ? 'true' : 'false'" data-text-truncate-tooltip="">
                        <i class="oi oi-filled me-2" data-icon="settings" role="none"/><t t-out="this.props.themeTabDisplayName"/>
                    </button>
                </li>
            </ul>
        </div>
        <div class="o-tab-content overflow-y-auto overflow-x-hidden flex-grow-1" t-att-class="{ 'o-faded-tab-content': !!this.state.pendingTab }" t-on-transitionend="this.onTabTransitionEnd">
            <t t-if="this.state.activeTab === 'blocks'">
                <BlockTab snippetsName="this.props.snippetsName" newInstalledModule="this.props.newInstalledModule"/>
            </t>
            <t t-if="this.state.activeTab === 'customize'">
                <CustomizeTab currentOptionsContainers="this.state.currentOptionsContainers"/>
            </t>
            <t t-if="this.state.activeTab === 'theme'">
                <t t-component="this.ThemeTab" t-props="this.themeTabProps"/>
            </t>
        </div>
        <div class="o_we_lower_panel mt-auto flex-grow-0 flex-shrink-0">
            <t t-foreach="this.lowerPanelEntries()" t-as="entry" t-key="entry_index">
                <t t-component="entry.Component" t-props="entry.props"/>
            </t>
        </div>
    </div>
</t>

</templates>
