<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.BorderConfiguratorOption">
    <t t-set="widthActionParam" t-value="{ mainParam: this.getStyleActionParam('width'), extraClass: this.props.withBSClass and 'border' }"/>
    <t t-set="radiusActionParam" t-value="{ mainParam: this.getStyleActionParam('radius'), extraClass: this.props.withBSClass and 'rounded' }"/>
    <BuilderRow label="this.props.label" level="this.props.level">
        <BuilderRange t-if="this.props.withSliders" action="this.props.widthAction or this.props.action" actionParam="widthActionParam" unit="'px'" min="0" max="50" withNumberInput="true"/>
        <t t-else="">
            <BuilderNumberInput action="this.props.widthAction or this.props.action" actionParam="widthActionParam" unit="'px'" min="0" composable="true"/>
            <t t-call="html_builder.BorderConfiguratorStyle"/>
        </t>
    </BuilderRow>
    <!-- A slider takes the row's width: the style on its own row. -->
    <BuilderRow t-if="this.props.withSliders and this.state.hasBorder" label.translate="Style" level="(this.props.level or 0) + 1">
        <t t-call="html_builder.BorderConfiguratorStyle"/>
    </BuilderRow>

    <!-- TODO: handle the dependency with border_width_opt bg_color_opt-->
    <BuilderRow t-if="this.props.withRoundCorner" label.translate="Round Corners" level="this.props.level">
        <BuilderRange t-if="this.props.withSliders" action="this.props.action" actionParam="radiusActionParam" unit="'px'" min="0" max="100" withNumberInput="true"/>
        <BuilderNumberInput t-else="" action="this.props.action" actionParam="radiusActionParam" unit="'px'" min="0" composable="true"/>
    </BuilderRow>
</t>

<t t-name="html_builder.BorderConfiguratorStyle">
    <BuilderSelect action="this.props.action" actionParam="this.getStyleActionParam('style')" t-if="this.state.hasBorder">
        <BuilderSelectItem title.translate="Solid" actionValue="'solid'"><div class="o_hb_border_preview" style="border-style: solid;"/></BuilderSelectItem>
        <BuilderSelectItem title.translate="Dashed" actionValue="'dashed'"><div class="o_hb_border_preview" style="border-style: dashed;"/></BuilderSelectItem>
        <BuilderSelectItem title.translate="Dotted" actionValue="'dotted'"><div class="o_hb_border_preview" style="border-style: dotted;"/></BuilderSelectItem>
        <BuilderSelectItem title.translate="Double" actionValue="'double'"><div class="o_hb_border_preview" style="border-style: double; border-left: none; border-right: none;"/></BuilderSelectItem>
    </BuilderSelect>
    <BuilderColorPicker action="this.props.action" actionParam="this.getStyleActionParam('color')"
        t-if="this.state.hasBorder"
        enabledTabs="['solid', 'custom']"
    />
</t>

</templates>
