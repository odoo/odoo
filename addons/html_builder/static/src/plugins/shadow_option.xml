<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.ShadowOption">
    <BuilderRow label.translate="Shadow">
        <BuilderSelect action="this.props.setShadowClassAction">
            <BuilderSelectItem actionParam="''">None</BuilderSelectItem>
            <BuilderSelectItem actionParam="'shadow-sm'">
                <t t-call="html_builder.BuilderSelectItemWithEdit" editAction="this.getEditAction('shadow-sm')">Small</t>
            </BuilderSelectItem>
            <BuilderSelectItem actionParam="'shadow'">
                <t t-call="html_builder.BuilderSelectItemWithEdit" editAction="this.getEditAction('shadow')">Normal</t>
            </BuilderSelectItem>
            <BuilderSelectItem actionParam="'shadow-lg'">
                <t t-call="html_builder.BuilderSelectItemWithEdit" editAction="this.getEditAction('shadow-lg')">Large</t>
            </BuilderSelectItem>
            <BuilderSelectItem id="'custom_shadow'" actionParam="'o-shadow-custom'">Custom</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderContext t-if="this.isActiveItem('custom_shadow')" level="true">
        <BuilderRow label.translate="Outset/Inset">
            <BuilderButtonGroup action="this.props.setShadowModeAction">
                <BuilderButton actionValue="'outset'" title.translate="Outset" iconImg="'/html_builder/static/img/options/shadow_out.svg'"/>
                <BuilderButton actionValue="'inset'" title.translate="Inset" iconImg="'/html_builder/static/img/options/shadow_in.svg'"/>
            </BuilderButtonGroup>
        </BuilderRow>
        <BuilderContext action="this.props.setShadowStyleAction">
            <BuilderRow label.translate="Color">
                <BuilderColorPicker actionParam="'color'" enabledTabs="['solid', 'custom']"/>
            </BuilderRow>

            <BuilderRow label.translate="Offset" tooltip.translate="Vertical and Horizontal offset">
                <BuilderNumberInput actionParam="'offsetY'" unit="'px'" tooltip.translate="Vertical offset" prefixIcon="'height'"/>
                <BuilderNumberInput actionParam="'offsetX'" unit="'px'" tooltip.translate="Horizontal offset" prefixIcon="'arrow_range'"/>
            </BuilderRow>

            <BuilderRow label.translate="Blur">
                <BuilderNumberInput actionParam="'blur'" unit="'px'"/>
            </BuilderRow>

            <BuilderRow label.translate="Spread">
                <BuilderNumberInput actionParam="'spread'" unit="'px'"/>
            </BuilderRow>
        </BuilderContext>
    </BuilderContext>
</t>

</templates>
