<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.ImageToolOption">
    <t t-if="!this.state.isGridMode and !this.state.isSocialMediaImg and !this.state.isImageBinaryField">
        <MediaSizeOption level="1"/>
    </t>
    <BuilderRow label.translate="Transform" level="1" preview="false">
        <div class="btn-group o-hb-button-group">
            <BuilderButton t-if="this.state.showCropTool" title.translate="Crop image" action="'cropImage'" icon="'crop'" id="'cropImage'" />
            <BuilderButton title.translate="Reset crop" action="'resetCrop'" t-if="this.state.showCropTool and this.isActiveItem('cropImage')" icon="'close_small'" className="'btn-danger-color-hover border-start-0 rounded-start-0 m-0 py-0 flex-grow-0'" />
        </div>
        <ImageTransformOption t-if="!this.state.isImageAnimated and !this.state.isSocialMediaImg and !this.state.isImageBinaryField" />
    </BuilderRow>
    <ImageFilterOption level="1"/>
    <ImageFormatOption level="1"/>
    <t t-if="!this.state.isSocialMediaImg">
        <t t-if="!this.state.isDynamicSVG">
            <ImageShapeOption />
        </t>
        <BuilderRow label.translate="Description" t-if="!this.state.isImageBinaryField"
            tooltip="this.altTranslations.tooltip">
            <BuilderTextInput
                action="'alt'"
                placeholder="this.altTranslations.placeholder"
                />
        </BuilderRow>
        <BuilderRow label.translate="Tooltip" t-if="!this.state.isImageBinaryField"
            tooltip="this.titleTranslations.tooltip">
            <BuilderTextInput
                attributeAction="'title'"
                placeholder="this.titleTranslations.placeholder" />
        </BuilderRow>
    </t>
</t>

<t t-name="html_builder.ImageAndFaOption">
    <BuilderRow label.translate="Alignment">
        <BuilderSelect action="'imageAlignClassAction'">
            <BuilderSelectItem actionParam="''" title.translate="Unalign">None</BuilderSelectItem>
            <BuilderSelectItem ltrRtlMapping="'left-right'" actionParam="'me-auto float-start'" title.translate="Align Left">Left</BuilderSelectItem>
            <BuilderSelectItem actionParam="'mx-auto d-block'" title.translate="Align Center">Center</BuilderSelectItem>
            <BuilderSelectItem ltrRtlMapping="'left-right'" actionParam="'ms-auto float-end'" title.translate="Align Right">Right</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Style">
        <BuilderButton icon="'square'" classAction="'rounded'" title.translate="Shape: Rounded"/>
        <BuilderButton icon="'circle'" classAction="'rounded-circle'" title.translate="Shape: Circle"/>
        <BuilderButton icon="'shadow'" classAction="'shadow'" title.translate="Shadow"/>
        <BuilderButton icon="'image'" classAction="'img-thumbnail'" title.translate="Shape: Thumbnail"/>
    </BuilderRow>

    <BuilderRow label.translate="Padding">
        <BuilderNumberInput styleAction="'padding'" unit="'px'" composable="true"/>
    </BuilderRow>

</t>

</templates>
