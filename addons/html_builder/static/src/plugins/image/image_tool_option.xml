<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.ImageToolOption">
    <t t-if="!this.state.isGridMode and !this.state.isSocialMediaImg and !this.state.isImageBinaryField">
        <MediaSizeOption level="1"/>
    </t>
    <BuilderRow label.translate="Transform" level="1" preview="false">
        <div class="btn-group o_hb_button_group">
            <BuilderButton t-if="this.state.showCropTool" title.translate="Crop image" action="'cropImage'" icon="'crop'" id="'cropImage'" />
            <BuilderButton title.translate="Reset crop" action="'resetCrop'" t-if="this.state.showCropTool and this.isActiveItem('cropImage')" icon="'close_small'" className="'btn-danger-color-hover border-start-0 rounded-start-0 m-0 py-0 flex-grow-0'" />
        </div>
        <ImageTransformOption t-if="!this.state.isImageAnimated and !this.state.isSocialMediaImg and !this.state.isImageBinaryField" />
    </BuilderRow>
    <ImageFilterOption level="1"/>
    <ImageFormatOption level="1"/>
    <t t-if="!this.state.isSocialMediaImg">
        <t t-if="!this.state.isDynamicSVG">
            <ImageShapeOption />
        </t>
        <BuilderRow label.translate="Description" t-if="!this.state.isImageBinaryField"
            tooltip="this.altTranslations.tooltip">
            <BuilderTextInput
                action="'alt'"
                placeholder="this.altTranslations.placeholder"
                />
        </BuilderRow>
        <BuilderRow label.translate="Tooltip" t-if="!this.state.isImageBinaryField"
            tooltip="this.titleTranslations.tooltip">
            <BuilderTextInput
                attributeAction="'title'"
                placeholder="this.titleTranslations.placeholder" />
        </BuilderRow>
    </t>
</t>

</templates>
