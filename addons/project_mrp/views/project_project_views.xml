<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_view_form_inherit_project_mrp" model="ir.ui.view">
        <field name="name">project.view.form.inherit.project.mrp</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_mrp_bom" icon="experiment"
                    groups="mrp.group_mrp_user" invisible="bom_count == 0">
                    <field string="Bills of Materials" name="bom_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" type="object" name="action_view_mrp_production" icon="build"
                    groups="mrp.group_mrp_user" invisible="production_count == 0">
                    <field string="Manufacturing Orders" name="production_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="hub_item_bills_of_materials" model="ir.hub.item">
        <field name="hub_id" ref="project.hub_project"/>
        <field name="sequence">95</field>
        <field name="name">Bills of Materials</field>
        <field name="python_method">action_view_mrp_bom</field>
        <field name="res_model">mrp.bom</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="context">{'form_when_one': False}</field>
    </record>

    <record id="hub_item_manufacturing_orders" model="ir.hub.item">
        <field name="hub_id" ref="project.hub_project"/>
        <field name="sequence">100</field>
        <field name="name">Manufacturing Orders</field>
        <field name="python_method">action_view_mrp_production</field>
        <field name="res_model">mrp.production</field>
        <field name="context">{'form_when_one': False}</field>
    </record>
</odoo>
