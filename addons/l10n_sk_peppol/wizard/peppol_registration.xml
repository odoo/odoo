<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="peppol_sk_registration_form" model="ir.ui.view">
        <field name="name">peppol.registration.form</field>
        <field name="model">peppol.registration</field>
        <field name="inherit_id" ref="account_peppol.peppol_registration_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='contact_email']" position="attributes">
                <attribute name="invisible">peppol_eas == '0245' and edi_mode == 'prod'</attribute>
            </xpath>

            <xpath expr="//field[@name='contact_email']" position="after">
                <div invisible="peppol_eas != '0245'">
                        <div class="alert alert-info" role="alert">
                        <h4>Activate Electronic Invoicing (Slovakia – Peppol)</h4>
                        <p>
                            Your company is registered in Slovakia. Before you can send and receive
                            electronic invoices via Peppol, you need to complete your registration on
                            the official government portal.
                        </p>

                        <p><strong>Steps to follow:</strong></p>

                        <ol>
                            <li invisible="edi_mode != 'prod'">
                                <strong>Register your company on the Slovak government portal</strong><br/>
                                Click on the following link and, on the government portal, designate Odoo as your service provider (Access Point):
                                <a href="https://www.financnasprava.sk/sk/podnikatelia/dane/dan-z-pridanej-hodnoty/e-faktura" target="_blank">
                                    Peppol Registration
                                </a>
                                <br/><br/>
                            </li>

                            <li invisible="edi_mode == 'prod'">
                                <strong>Register on the verification platform</strong><br/>
                                Go to the <a href="https://www.overtoken.sk/generate" target="_blank">Token Generator</a>.<br/>
                                In <code>DIČ poskytovateľa služby</code>, enter our Service Provider ID: <strong>BE0477472701</strong>.<br/>
                                In <code>DIČ subjektu</code>, enter your DIČ: <strong><field name="peppol_endpoint" readonly="1" class="oe_inline"/></strong><br/>
                                Click the <strong>Vygenerovať verifikačný token (údaj)</strong> button.
                                <br/><br/>
                            </li>

                            <li>
                                <strong>Retrieve your verification token</strong><br/>
                                After validation, the portal will generate a unique verification token.
                                <ul>
                                    <li invisible="edi_mode != 'prod'">This token will be sent to your email.</li>
                                    <li invisible="edi_mode == 'prod'">
                                        This token will be shown below the form.<br/>
                                        Once the token is generated, click the <strong>Kopírovať</strong> button to copy the entire token to your clipboard.
                                    </li>
                                    <li>It will also be sent to Odoo to confirm your identity.</li>
                                </ul>
                                <br/>
                            </li>

                            <li>
                                <strong>Enter the verification token below</strong><br/>
                                <div class="border-bottom">
                                    <field name="peppol_validation_token" required="peppol_eas == '0245'"/>
                                </div>
                            </li>
                        </ol>

                        <p class="mb-0">
                            <strong>Important:</strong> Without this token, your company will not be able
                            to send or receive electronic invoices via Peppol in Slovakia.
                        </p>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
