<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_razorpay" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.razorpay</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'razorpay'">
                    <page name="settings" string="Razorpay">
                        <group>
                            <group>
                                <field name="razorpay_username" required="payment_provider == 'razorpay'"/>
                                <field name="razorpay_tid" required="payment_provider == 'razorpay'"/>
                                <field name="razorpay_api_key" required="payment_provider == 'razorpay'"/>
                                <field name="razorpay_test_mode"/>
                                <field name="razorpay_allowed_payment_modes" required="payment_provider == 'razorpay'"/>
                            </group>
                            <group>
                                <div class="d-flex justify-content-end" colspan="2">
                                    <button name="action_razorpay_test_creds" type="object" string="Test" class="btn-primary text-nowrap" groups="point_of_sale.group_pos_manager"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
