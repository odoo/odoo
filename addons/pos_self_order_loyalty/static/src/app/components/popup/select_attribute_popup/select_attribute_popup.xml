<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order_loyalty.SelectAttributePopup">
        <div class="o_dialog" t-att-id="id">
            <div role="dialog" class="modal d-block" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                    <div class="modal-content" t-on-click.stop="">
                        <div class="modal-header border-0 pb-0">
                            <h2 class="m-0" t-out="this.props.productTemplate.name"/>
                            <button type="button" class="btn-close" t-on-click.stop="() => this.props.close()"/>
                        </div>
                        <div class="modal-body px-3 px-sm-4 pt-0">
                            <AttributeSelection productTemplate="this.props.productTemplate"/>
                        </div>
                        <div class="modal-footer d-flex justify-content-center border-0">
                            <button type="button" class="btn btn-primary w-100"
                                    t-att-disabled="this.hasMissingAttributeValue()"
                                    t-on-click="() => this.confirm()">
                                Confirm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
