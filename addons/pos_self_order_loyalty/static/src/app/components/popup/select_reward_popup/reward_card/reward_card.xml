<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_self_order_loyalty.RewardCard">
        <button t-on-click.stop="this.props.onClick" t-att-disabled="this.isLocked" class="d-flex align-items-center justify-content-between btn btn-lg btn-outline-secondary w-100 p-3 text-start">
            <div class="ratio ratio-1x1 me-3" style="width: 90px" t-if="this.props.reward.imageUrl">
                <img class="rounded-3" t-att-src="this.props.reward.imageUrl"/>
            </div>
            <div class="d-flex flex-column w-100 text-start">
                <span t-out="this.props.reward.description" t-if="this.props.reward.description" />
                <span t-if="this.props.claimedLabel" class="text-muted" t-out="this.props.claimedLabel"/>
                <t t-if="!this.props.claimed">
                    <div t-if="this.props.showPoints and this.props.reward.required_points" class="progress">
                        <div class="progress-bar" role="progressbar" t-att-style="'width: ' + (this.currentProgramPoints / this.props.reward.required_points * 100) + '%'" t-att-aria-valuenow="this.currentProgramPoints" t-att-aria-valuemin="0" t-att-aria-valuemax="this.props.reward.required_points"></div>
                    </div>
                    <span t-if="this.props.showPoints and this.props.reward.required_points" t-out="this.pointText"/>
                </t>
            </div>
            <div class="border rounded-4 disabled p-3 m-3" t-if="this.isLocked">
                <span class="text-center w-100">Locked</span>
            </div>
            <div class="border border-success text-success rounded-4 p-3 m-3" t-if="this.props.claimed">
                <span class="text-center w-100">Claimed</span>
            </div>
        </button>
    </t>
</templates>

