<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order_loyalty.PaymentPage" t-inherit="pos_self_order.PaymentPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_self_payment_page')]//button[hasclass('payment-method')]" position="after">
            <button
                t-if="this.showGiftCardButton"
                role="button"
                class="col-12 col-md-4 m-1 btn btn-light btn-lg d-flex flex-column align-items-center gap-2 px-0 border shadow-sm overflow-hidden payment-method"
                t-att-class="this.cardTotal('gift_card') ? 'border-primary o_card_with_total' : 'border-light py-5'"
                t-on-click="() => this.useGiftCard()">
                <i class="oi" data-icon="card_giftcard" aria-hidden="true"></i>
                <span>Gift Card</span>
                <span t-if="this.cardTotal('gift_card')" class="text-primary" t-out="this.cardTotalDisplay('gift_card')" />
            </button>
            <button
                t-if="this.showEwalletButton"
                role="button"
                class="col-12 col-md-4 m-1 btn btn-light btn-lg d-flex flex-column align-items-center gap-2 px-0 border shadow-sm overflow-hidden payment-method"
                t-att-class="this.cardTotal('ewallet') ? 'border-primary o_card_with_total' : 'border-light py-5'"
                t-on-click="() => this.useEwallet()">
                <i class="oi" data-icon="credit_card" aria-hidden="true"></i>
                <span>eWallet</span>
                <span t-if="this.cardTotal('ewallet')" class="text-primary" t-out="this.cardTotalDisplay('ewallet')" />
            </button>
        </xpath>
    </t>
</templates>