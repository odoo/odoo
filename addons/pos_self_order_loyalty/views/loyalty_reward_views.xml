<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loyalty_reward_view_form_inherit_pos_self_order_loyalty" model="ir.ui.view">
        <field name="name">loyalty.reward.view.form.inherit.pos.self.order.loyalty</field>
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_form"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="image_512"/>
            </field>
        </field>
    </record>

    <record id="loyalty_reward_view_kanban_inherit_pos_self_order_loyalty" model="ir.ui.view">
        <field name="name">loyalty.reward.view.kanban.inherit.pos.self.order.loyalty</field>
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_kanban"/>
        <field name="arch" type="xml">
            <div name="reward_info" position="before">
                <aside class="pe-2">
                    <field
                        name="image_128"
                        widget="image"
                        alt="Product"
                        options="{'img_class': 'w-100 object-fit-contain'}"
                        invisible="not image_128"
                        class="rounded"
                    />
                </aside>
            </div>
        </field>
    </record>

</odoo>
