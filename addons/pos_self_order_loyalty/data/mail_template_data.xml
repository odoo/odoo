<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="mail_template_self_otp" model="mail.template">
            <field name="name">Self Order: Verification Code</field>
            <field name="model_id" ref="pos_self_order_loyalty.model_pos_self_order_loyalty_otp"/>
            <field name="subject">{{ ctx.get('otp_code') }} is your verification code</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="description">Sent when a customer requests a one-time code to identify themselves in self-order.</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; background:#f5f5f4;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f5f5f4;">
        <tr>
            <td align="center" style="padding:32px 12px;">
                <table border="0" cellpadding="0" cellspacing="0" width="480" style="width:480px; max-width:100%; background:#ffffff; border:1px solid #e7e5e4; border-radius:6px;">
                    <tr>
                        <td style="padding:32px 32px 0 32px; font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:15px; line-height:22px; color:#1c1917;">
                            <p style="margin:0 0 8px 0;">
                                Your verification code is:
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:12px 32px 20px 32px;">
                            <div style="font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace; font-size:34px; font-weight:600; letter-spacing:9px; color:#1c1917; padding:16px 8px 16px 17px; background:#fafaf9; border:1px solid #e7e5e4; border-radius:4px;">
                                <t t-out="ctx.get('otp_code') or ''">000000</t>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 32px 32px; font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:15px; line-height:22px; color:#1c1917;">
                            <p style="margin:0 0 20px 0;">
                                It expires in <t t-out="ctx.get('validity_minutes') or 10">10</t> minutes and can be used once.
                            </p>
                            <p style="margin:0; padding-top:20px; border-top:1px solid #e7e5e4; font-size:13px; line-height:20px; color:#78716c;">
                                If you didn't ask for a code, you can ignore this message. Nobody can use it without your mailbox.
                            </p>
                        </td>
                    </tr>
                </table>
                <table border="0" cellpadding="0" cellspacing="0" width="480" style="width:480px; max-width:100%;">
                    <tr>
                        <td align="center" style="padding:16px 8px 0 8px; font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:12px; line-height:18px; color:#a8a29e;">
                            <t t-out="object.company_id.name or ''">YourCompany</t>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

    <record id="delivery_address_email_template" model="mail.template">
        <field name="name">Delivery: Confirmation order for self (delivery address)</field>
        <field name="description">Replaces "Delivery: Confirmation order for self" for an identified customer whose order is delivered to one of their addresses</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="subject">Your {{ object.config_id.name }} receipt</field>
        <field name="email_from">{{ (object.company_id.email_formatted or object.user_id.email_formatted)}}</field>
        <field name="email_to" eval="False"/>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="False"/>
        <field name="lang">{{ object.partner_id.lang or user.lang }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; font-size: 14px;">
                <t t-set="client" t-value="object.partner_id"/>
                <t t-set="address" t-value="object.delivery_partner_id or client"/>
                <t t-set="client_name" t-value="client.name"/>
                <t t-set="street" t-value="address.street or ''"/>
                <t t-set="state" t-value="address.state_id.name or ''"/>
                <t t-set="city" t-value="address.city or ''"/>
                <t t-set="country" t-value="address.country_id.name or ''"/>
                <t t-set="store_name" t-value="object.config_id.name"/>
                <t t-set="tz" t-value="object.company_id.partner_id.tz"/>
                <t t-set="lg" t-value="object.partner_id.lang or user.lang"/>
                <div>
                    <t t-if="client_name">Hello <t t-out="client_name">Client name</t>,</t>
                    <t t-else="">Hello,</t>
                </div>
                <br/>
                <div>Your order <t t-out="object.tracking_number">...</t> amounting in <t t-out="format_amount(object.amount_total,object.currency_id)">$xx.xx</t> has been confirmed. <span t-if="object.preset_time or address.street">It will be ready</span> <span t-if="object.preset_time">at <t t-out="format_time(time=object.preset_time, tz=tz, time_format='short', lang_code=lg)">12:00 pm</t></span> <span t-if="address.street">at <t t-out="street">street</t>, <t t-out="state">state</t>, <t t-out="address.zip or ''">zip</t>, <t t-out="city">city</t>, <t t-out="country">country</t></span></div>
                <br/>
                <div>Thank you,</div>
                <br/>
                <div t-if="object.state == 'paid'">
                    <div>You can download your receipt <a t-attf-href="{{ object.get_base_url() }}/pos-self-order/receipt/{{ object.id }}?access_token={{ object.access_token }}">here</a></div>
                    <br/>
                </div>
                <t t-out="store_name">Store name</t>
            </div>
        </field>
    </record>
</data>
</odoo>
