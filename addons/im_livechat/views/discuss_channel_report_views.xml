<?xml version="1.0"?>
<odoo>
    <data>

        <record id="discuss_channel_view_pivot_livechat_report" model="ir.ui.view">
            <field name="name">discuss.channel.pivot.livechat.report</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <pivot js_class="im_livechat.report_channel_pivot" string="Live Chat Support Statistics" sample="1" display_quantity="1">
                    <field name="livechat_has_call" type="measure" invisible="1"/>
                    <field name="livechat_call_duration_hour" type="measure" widget="float_time" options="{'show_seconds': true}"/>
                    <field name="livechat_handler_partner_id" type="row"/>
                    <field name="livechat_call_percentage" type="measure" widget="percentage"/>
                    <field name="livechat_response_time_hour" string="Response Time" type="measure" widget="float_time" options="{'show_seconds': true}"/>
                    <field name="duration" type="measure" widget="float_time" options="{'show_seconds': true}"/>
                    <field name="livechat_rating_percentage" type="measure"/>
                    <field name="livechat_call_count" string="# of calls" type="measure" widget="integer"/>
                </pivot>
            </field>
        </record>

        <record id="discuss_channel_view_list_livechat_report" model="ir.ui.view">
            <field name="name">discuss.channel.list.livechat.report</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <list sample="1" string="History" create="false" default_order="create_date desc, id desc">
                    <field name="create_date" string="Date"/>
                    <field name="livechat_customer_history_ids" string="Customer" widget="many2many_tags_avatar" optional="show"/>
                    <field name="livechat_agent_history_ids" string="Agents" widget="many2many_tags_avatar" optional="show"/>
                    <field name="livechat_agent_requesting_help_history" widget="many2one_avatar" optional="hide"/>
                    <field name="livechat_agent_providing_help_history" widget="many2one_avatar" optional="hide"/>
                    <field name="livechat_chatbot_script_id" string="Chatbot" optional="hide"/>
                    <field name="name" string="Participants" optional="hide"/>
                    <field name="country_id" string="Country" optional="show"/>
                    <field name="livechat_lang_id" optional="show"/>
                    <field name="livechat_expertise_ids" string="Expertise" widget="many2many_tags" optional="show"/>
                    <field name="livechat_channel_id" optional="hide"/>
                    <field name="duration" string="Duration" widget="float_time" optional="show" options="{'show_seconds': true}"/>
                    <field name="livechat_message_count" string="Messages" optional="show"/>
                    <field name="livechat_rating" string="Rating"
                        decoration-danger="livechat_rating == '1'"
                        decoration-warning="livechat_rating == '3'"
                        decoration-success="livechat_rating == '5'"
                        widget="badge"
                        optional="show"/>
                </list>
            </field>
        </record>

        <record id="discuss_channel_view_graph_livechat_report" model="ir.ui.view">
            <field name="name">discuss.channel.graph.livechat.report</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <graph js_class="im_livechat.channel_report_graph_views" string="Live Chat Support Statistics" type="line" stacked="1" sample="1">
                    <field name="livechat_call_duration_hour" type="measure" widget="float_time"/>
                    <field name="livechat_has_call" invisible="1"/>
                    <field name="livechat_call_percentage" type="measure" widget="percentage"/>
                    <field name="create_date" interval="day"/>
                    <field name="livechat_rating"/>
                    <field name="livechat_rating_percentage" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="discuss_channel_view_search_livechat_report" model="ir.ui.view">
            <field name="name">discuss.channel.search.livechat.report</field>
            <field name="model">discuss.channel</field>
            <field name="arch" type="xml">
                <search string="Search report">
                    <field name="livechat_handler_partner_id"/>
                    <field name="livechat_agent_requesting_help_history"/>
                    <field name="livechat_agent_providing_help_history"/>
                    <field name="livechat_channel_id" string="Channel"/>
                    <field name="country_id" string="Country"/>
                    <field name="livechat_chatbot_script_id"/>
                    <field name="livechat_chatbot_answers_path_str" string="Chatbot Answers"/>
                    <field name="livechat_expertise_ids" string="Expertise"/>
                    <field name="livechat_visitor_partner_id"/>
                    <filter name="my_session" domain="[('livechat_handler_partner_id.user_ids', '=', uid)]" string="My Sessions"/>
                    <separator/>
                    <filter name="escalated" string="Escalated" domain="[('livechat_outcome', '=', 'escalated')]"/>
                    <filter name="no_answer" string="Not Answered" domain="[('livechat_outcome', '=', 'no_answer')]"/>
                    <filter name="no_agent" string="No one Available" domain="[('livechat_outcome', '=', 'no_agent')]"/>
                    <separator/>
                    <filter name="rating_happy" string="Happy" domain="[('livechat_rating','=', 5)]"/>
                    <filter name="rating_neutral" string="Neutral" domain="[('livechat_rating','=', 3)]"/>
                    <filter name="rating_unhappy" string="Unhappy" domain="[('livechat_rating','=', 1)]"/>
                    <separator />
                    <filter name="filter_start_date" string="Date" date="create_date"/>
                    <filter name="filter_date_last_month" invisible="1" string="Date: Last month"
                        domain="[('create_date', '&gt;=', 'today -1m')]"/>
                    <filter name="filter_date_last_week" invisible="1" string="Date: Last week"
                        domain="[('create_date', '&gt;=', 'today -1w')]"/>
                    <group>
                        <filter name="group_by_channel" string="Channel" domain="[]" context="{'group_by':'livechat_channel_id'}"/>
                        <filter name="group_by_operator" string="Agent" domain="[]" context="{'group_by': 'livechat_handler_partner_id'}"/>
                        <filter name="group_by_agent_requesting_help" domain="[]" context="{'group_by': 'livechat_agent_requesting_help_history'}"/>
                        <filter name="group_by_agent_providing_help" domain="[]" context="{'group_by': 'livechat_agent_providing_help_history'}"/>
                        <filter name="group_by_rating" string="Rating" domain="[]" context="{'group_by':'livechat_rating'}"/>
                        <filter name="group_by_country" string="Country" domain="[]" context="{'group_by':'country_id'}"/>
                        <filter name="group_by_outcome" string="Status" domain="[]" context="{'group_by':'livechat_outcome'}"/>
                        <filter name="group_by_chatbot" string="Chatbot" domain="[]" context="{'group_by':'livechat_chatbot_script_id'}"/>
                        <filter name="group_by_chatbot_answers" domain="[]" context="{'group_by':'livechat_chatbot_answers_path'}"/>
                        <filter name="group_by_expertise" string="Expertise" domain="[]" context="{'group_by':'livechat_expertise_ids'}"/>
                        <filter name="group_by_customer" domain="[]" context="{'group_by':'livechat_visitor_partner_id'}"/>
                        <separator orientation="vertical" />
                        <filter name="group_by_hour" string="Hour of Day" domain="[]" context="{'group_by':'livechat_start_hour'}"/>
                        <filter name="group_by_day_of_week" string="Day of Week" domain="[]" context="{'group_by':'livechat_week_day'}"/>
                        <filter name="group_by_month" string="Date" domain="[]" context="{'group_by':'create_date:month'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="im_livechat_report_channel_action" model="ir.actions.act_window">
            <field name="name">Sessions Analysis</field>
            <field name="res_model">discuss.channel</field>
            <field name="domain">[('channel_type', '=', 'livechat')]</field>
            <field name="view_mode">graph,pivot,list,form</field>
            <field name="search_view_id" ref="discuss_channel_view_search_livechat_report"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'sequence': 1, 'view_mode': 'graph', 'view_id': ref('discuss_channel_view_graph_livechat_report')}),
                (0, 0, {'sequence': 2, 'view_mode': 'pivot', 'view_id': ref('discuss_channel_view_pivot_livechat_report')}),
                (0, 0, {'sequence': 3, 'view_mode': 'list', 'view_id': ref('discuss_channel_view_list_livechat_report')}),
                (0, 0, {'sequence': 4, 'view_mode': 'form', 'view_id': ref('discuss_channel_view_form')})
            ]"/>
            <field name="context">
                {
                    "search_default_filter_date_last_month": 1,
                    "pivot_measures": ["__count", "livechat_response_time_hour", "duration", "livechat_rating_percentage", "livechat_call_count"],
                    "graph_measure": "__count__",
                    "im_livechat_hide_partner_company": True,
                }
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">No data yet!</p>
                <p>Track and improve live chat performance with insights on session activity, response times, customer ratings, and call interactions.</p>
            </field>
        </record>

        <record id="im_livechat_report_channel_time_to_answer_action" model="ir.actions.act_window">
            <field name="name">Sessions</field>
            <field name="res_model">discuss.channel</field>
            <field name="domain">[('channel_type', '=', 'livechat')]</field>
            <field name="view_mode">graph,pivot</field>
            <field name="search_view_id" ref="discuss_channel_view_search_livechat_report"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'sequence': 1, 'view_mode': 'graph', 'view_id': ref('discuss_channel_view_graph_livechat_report')}),
                (0, 0, {'sequence': 2, 'view_mode': 'pivot', 'view_id': ref('discuss_channel_view_pivot_livechat_report')})
            ]"/>
            <field name="context">{"graph_measure": "livechat_response_time_hour", "search_default_filter_date_last_week":1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No data yet!</p>
                <p>Track and improve live chat performance with insights on session activity, response times, customer ratings, and call interactions.</p>
            </field>
        </record>

        <menuitem
            id="menu_reporting_livechat_channel"
            name="Sessions Analysis"
            parent="menu_reporting_livechat"
            sequence="20"
            action="im_livechat_report_channel_action"/>

    </data>
</odoo>
