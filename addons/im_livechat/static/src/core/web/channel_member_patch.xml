<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="discuss.ChannelMember" t-inherit-mode="extension">
        <xpath expr="//*[@t-ref='this.displayNameRef']" position="inside">
                <div t-if="this.props.member().channel_id.channel_type === 'livechat'" class="ms-2 d-flex flex-wrap">
                    <span t-if="this.props.member().getLangName()" class="me-2">
                        <i class="oi me-1" data-icon="chat_bubble" aria-label="Lang"/>
                        <t t-out="this.props.member().getLangName()"/>
                    </span>
                    <span t-if="this.props.member().persona?.country_id or this.props.member().channel_id.country_id">
                        <i class="oi me-1" data-icon="public" aria-label="country"/>
                        <t t-out="this.props.member().persona?.country_id?.name ?? this.props.member().channel_id.country_id.name"/>
                    </span>
                </div>
        </xpath>
    </t>
</templates>
