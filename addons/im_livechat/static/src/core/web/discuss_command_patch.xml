<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.DiscussCommand" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o-mail-DiscussCommand-nameContainer')]" position="after">
            <span t-if="this.lastMessagePreview" class="o-livechat-DiscussCommand-lastMessage text-truncate text-muted smaller opacity-75" t-out="this.lastMessagePreview"/>
        </xpath>
    </t>
</templates>
