<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Thread')]" position="before">
            <div t-if="this.showVisitorDisconnected" class="o-livechat-VisitorDisconnected alert alert-light py-1 fw-bold smaller shadow-sm border d-print-none" t-att-class="{ 'rounded-4': !this.ancestors.inChatWindow, 'rounded-0': this.ancestors.inChatWindow, 'mx-3': this.ancestors.inDiscussContent }" t-out="this.disconnectedText"/>
        </xpath>
    </t>
</templates>
