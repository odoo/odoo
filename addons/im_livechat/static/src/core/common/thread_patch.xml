<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Thread')]" position="before">
            <div t-if="this.showVisitorDisconnected" class="o-livechat-VisitorDisconnected alert alert-secondary py-1 px-3 fw-bold smaller shadow-sm border d-print-none rounded-4" t-out="this.disconnectedText"/>
        </xpath>
    </t>
</templates>
