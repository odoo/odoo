<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="im_livechat.LivechatCommandDialog">
        <ActionPanel close="this.props.close" title="this.props.title" icon="this.props.icon" resizable="false">
            <div class="o-livechat-LivechatCommandDialog-form o_field_highlight d-flex flex-column gap-2 my-2 p-3 border rounded-3 bg-view shadow">
                <input type="text" class="o_input form-control" t-att-placeholder="this.props.placeholderText" t-on-keydown="this.onKeydown" t-ref="this.autofocusRef" t-model.proxy="this.state.inputText" accesskey="Q" aria-autocomplete="list"/>
                <div class="d-flex justify-content-end gap-1">
                    <button class="btn btn-secondary" t-on-click="this.props.close">Cancel</button>
                    <button class="btn btn-primary" t-on-click="this.executeCommand" t-att-disabled="!this.state.inputText.trim()" t-out="this.props.title"/>
                </div>
            </div>
        </ActionPanel>
    </t>
</templates>
