<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="im_livechat.FeedbackPanel" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('btn-outline-secondary')]" position="after">
            <button t-if="this.allowNewSession" class="btn btn-outline-secondary" t-on-click="this.embedProps.onClickNewSession">New Session</button>
        </xpath>
    </t>
</templates>
