<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ChatWindow" t-inherit-mode="extension">
        <xpath expr="//FeedbackPanel" position="attributes">
            <attribute name="onClickNewSession">() => this.onClickNewSession()</attribute>
        </xpath>
        <xpath expr="//*[hasclass('o-mail-ChatWindow-header')]" position="attributes">
            <attribute name="t-attf-style" add="color: {{ this.livechatService.options.title_color }}; --o-mail-livechat-btn-color: {{ this.livechatService.options.title_color }}; background-color: {{ this.livechatService.options.header_background_color }} !important;" separator=" "/>
        </xpath>
    </t>
</templates>
