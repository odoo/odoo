<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//*[@name='content']" position="before">
            <div t-if="this.props.thread?.channel?.livechatWelcomeMessage" class="bg-100 py-3" data-name="LivechatWelcomeMessage">
                <Message message="this.props.thread.channel.livechatWelcomeMessage" thread="this.props.thread"/>
            </div>
        </xpath>
        <xpath expr="//*[hasclass('o-mail-Thread-empty')]" position="replace">
            <t t-if="this.channel?.channel_type !== 'livechat'">$0</t>
        </xpath>
    </t>
</templates>
