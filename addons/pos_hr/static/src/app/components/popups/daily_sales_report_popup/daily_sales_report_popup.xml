<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_hr.DailySalesReportPopup">
        <Dialog title.translate="Session Report">
            <div class="form-check form-switch ps-0 d-flex justify-content-between align-items-center">
                <label class="form-check-label" for="include_employee_reports">
                    Add a report for each employee
                </label>
                <input class="form-check-input mt-0" type="checkbox" role="switch" id="include_employee_reports" t-model.proxy="this.state.includeEmployees" />
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg lh-lg" t-on-click="() => this.confirm()">Print</button>
                <button class="btn btn-secondary btn-lg lh-lg" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
