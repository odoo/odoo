msgstr "Așteptare pentru eliminarea surplusului de monede"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/utils/constants.js:0
msgid "Waiting for error recovery"
msgstr "Așteptare recuperare eroare"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/utils/constants.js:0
