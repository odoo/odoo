#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid "The cash machine has an error, please consult its display for details."
msgstr ""
"Bancomatul are o eroare, vă rugăm să consultați afișajul pentru detalii."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/screens/payment_screen/payment_lines/payment_lines.xml:0
msgid "The cash machine has run out of the following coins/bills:"
msgstr ""
"Automatul de gestionare a numerarului a rămas fără următoarele monede/"
"bancnote:"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is busy counting its inventory, please wait a few seconds "
"and retry."
msgstr ""
"Aparatul de numerar își numără inventarul. Așteptați câteva secunde și "
"încercați din nou."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is busy with another operation. Do you want to cancel it?"
msgstr "Bancomatul este ocupat cu o altă operațiune. Doriți să anulați?"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is currently in collection/replenishment mode, please "
"finish this process on the machine before making a payment."
msgstr ""
"Bancomatul se află în prezent în modul de colectare/reaprovizionare. Vă "
"rugăm să finalizați acest proces la bancomat înainte de a efectua o plată."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid "The cash machine is disconnected."
msgstr "Bancomatul este deconectat."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid "The cash machine is in use by another POS."
msgstr "Bancomatul este utilizat de un alt POS."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is not ready to start a transaction. Check all the covers "
"are closed and then try again."
msgstr ""
"Aparatul de numerar nu este pregătit să înceapă o tranzacție. Verificați "
"dacă toate capacele sunt închise, apoi încercați din nou."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/screens/payment_screen/payment_lines/payment_lines.xml:0
msgid "The cash machine is running low on the following coins/bills:"
msgstr ""
"Automatul de gestionare a numerarului are un stoc redus pentru următoarele "
"monede/bancnote:"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The cash machine is unable to return the inserted cash, please refund the "
"client %s via another method."
msgstr ""
"Aparatul de numerar nu poate returna numerarul introdus. Rambursați "
"clientului suma de %s prin altă metodă."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/screens/payment_screen/payment_lines/payment_lines.xml:0
msgid "The cash machine must be emptied, the following coins/bills are full:"
msgstr ""
"Automatul de gestionare a numerarului trebuie golit; compartimentele pentru "
"următoarele monede/bancnote sunt pline:"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"The payment failed due to an unrecoverable error - see the cash machine "
"screen for details."
msgstr ""
"Plata a eșuat din cauza unei erori irecuperabile - consultați ecranul "
"bancomatului pentru detalii."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid "The payment failed for an unknown reason: %s"
msgstr "Plata a eșuat dintr-un motiv necunoscut: %s"

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"There is an error with the bill or coin device. The machine will now be "
"reset and the contents verified. Once this is complete, the amount that must "
"be returned to the customer will be displayed."
msgstr ""
"A apărut o eroare la dispozitivul pentru bancnote sau monede. Aparatul va fi "
"resetat, iar conținutul va fi verificat. După finalizare, se va afișa suma "
"care trebuie returnată clientului."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"There is insufficient cash in the machine to give change. You will need to "
"refund %s via another method."
msgstr ""
"Aparatul nu are suficient numerar pentru a da rest. Va trebui să rambursați "
"%s prin altă metodă."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/app/payment_glory.js:0
msgid ""
"There is insufficient change in the cash machine to handle the payment. It "
"must be cancelled to continue."
msgstr ""
"Nu există suficient rest în bancomat pentru a efectua plata. Aceasta trebuie "
"anulată pentru a continua."

#. module: pos_glory_cash
#. odoo-javascript
#: code:addons/pos_glory_cash/static/src/utils/constants.js:0
