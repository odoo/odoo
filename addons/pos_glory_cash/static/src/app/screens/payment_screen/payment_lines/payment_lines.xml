<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentline_status')]" position="after">
            <div t-if="line.isSelected() and line.payment_method_id.payment_provider === 'glory'" class="d-flex flex-column gap-3">
                <t t-set="glory" t-value="line.payment_method_id.payment_interface"/>

                <t t-set="emptyDenominations" t-value="glory.gloryService.emptyDenominations()"/>
                <t t-set="fullDenominations" t-value="glory.gloryService.fullDenominations()"/>
                <t t-set="nearEmptyDenominations" t-value="glory.gloryService.nearEmptyDenominations()"/>
                <t t-set="nearFullDenominations" t-value="glory.gloryService.nearFullDenominations()"/>

                <div class="d-flex flex-wrap gap-2">
                    <div t-if="emptyDenominations.length > 0" class="alert alert-danger" style="width: calc(50% - 4px)">
                        The cash machine has run out of the following coins/bills:
                        <ul class="my-1 ps-4">
                            <li style="list-style-type: disc;" t-foreach="emptyDenominations" t-as="denomination" t-key="denomination.value">
                                <t t-out="this.pos.formatCurrency(denomination.value / Math.pow(10, line.currency.decimal_places))"/>
                            </li>
                        </ul>
                    </div>

                    <div t-if="fullDenominations.length > 0" class="alert alert-danger" style="width: calc(50% - 4px)">
                        The cash machine must be emptied, the following coins/bills are full:
                        <ul class="my-1 ps-4">
                            <li style="list-style-type: disc;" t-foreach="fullDenominations" t-as="denomination" t-key="denomination.value">
                                <t t-out="this.pos.formatCurrency(denomination.value / Math.pow(10, line.currency.decimal_places))"/> <t t-if="this.pos.accessRight.loggedCashier._role === 'manager'" t-out="'(' + denomination.amount + ')'"/>
                            </li>
                        </ul>
                    </div>

                    <div t-if="nearEmptyDenominations.length > 0" class="alert alert-warning" style="width: calc(50% - 4px)">
                        The cash machine is running low on the following coins/bills:
                        <ul class="my-1 ps-4">
                            <li style="list-style-type: disc;" t-foreach="nearEmptyDenominations" t-as="denomination" t-key="denomination.value">
                                <t t-out="this.pos.formatCurrency(denomination.value / Math.pow(10, line.currency.decimal_places))"/> <t t-if="this.pos.accessRight.loggedCashier._role === 'manager'" t-out="'(' + denomination.amount + ')'"/>
                            </li>
                        </ul>
                    </div>

                    <div t-if="nearFullDenominations.length > 0" class="alert alert-warning" style="width: calc(50% - 4px)">
                        Consider emptying the cash machine, the following coins/bills are nearly full:
                        <ul class="my-1 ps-4">
                            <li style="list-style-type: disc;" t-foreach="nearFullDenominations" t-as="denomination" t-key="denomination.value">
                                <t t-out="this.pos.formatCurrency(denomination.value / Math.pow(10, line.currency.decimal_places))"/> <t t-if="this.pos.accessRight.loggedCashier._role === 'manager'" t-out="'(' + denomination.amount + ')'"/>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
