<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_id_efaktur_document_pajakio_form_view" model="ir.ui.view">
        <field name="name">l10n_id.efaktur_coretax.document.pajakio.form</field>
        <field name="model">l10n_id_efaktur_coretax.document</field>
        <field name="inherit_id" ref="l10n_id_efaktur_coretax.l10n_id_efaktur_document_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_download']" position="attributes">
                <attribute name="invisible">document_type == 'pajakio'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_regenerate']" position="attributes">
                <attribute name="invisible">document_type == 'pajakio'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_regenerate']" position="after">
                <button name="action_update_pajakio_status"
                        string="Update Pajak.io Status"
                        class="btn-primary"
                        type="object"
                        invisible="document_type != 'pajakio' or not l10n_id_pajakio_transaction_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pajak.io" invisible="document_type != 'pajakio' or not l10n_id_pajakio_transaction_id">
                    <group>
                        <field name="l10n_id_pajakio_transaction_id" readonly="1"/>
                        <field name="l10n_id_pajakio_status" readonly="1"/>
                        <field name="l10n_id_pajakio_transaction_url" readonly="1"/>
                        <field name="l10n_id_pajakio_reject_reason" readonly="1" invisible="not l10n_id_pajakio_reject_reason"/>
                        <field name="l10n_id_pajakio_cancel_reason" readonly="1" invisible="not l10n_id_pajakio_cancel_reason"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
