<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="registry_vat_external_layout">
        <li t-if="company.partner_id._get_additional_identifier('CZ_EN') and company.account_fiscal_country_id.code == 'CZ'">
            Company ID: <span t-out="company.partner_id._get_additional_identifier('CZ_EN')"/>
        </li>
    </template>

    <template id="l10n_cz_external_layout_standard" inherit_id="web.company_address_list">
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <t t-call="l10n_cz.registry_vat_external_layout"/>
        </xpath>
    </template>
</odoo>
