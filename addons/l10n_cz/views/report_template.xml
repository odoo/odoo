<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="registry_vat_external_layout">
        <li
            t-if="company.company_registry and company.account_config_id.account_fiscal_country_id.code == 'CZ'">
            Company ID: <span t-field="company.company_registry" />
        </li>
        <li
            t-if="company.vat and company.account_config_id.account_fiscal_country_id.code == 'CZ'">
            <t t-set="default_vat_label">Tax ID</t>
            <t t-out="company.country_id.vat_label or default_vat_label" />:
            <span t-out="company.vat" />
        </li>
    </template>

    <template
        id="l10n_cz_external_layout_folder"
        inherit_id="web.external_layout_folder">
        <xpath expr="//div[hasclass('o_folder_company_info')]" position="after">
            <div
                t-if="company.company_registry and company.account_config_id.account_fiscal_country_id.code == 'CZ'">
                Company ID: <span t-field="company.company_registry" />
            </div>
            <div
                t-if="company.vat and company.account_config_id.account_fiscal_country_id.code == 'CZ'">
                <t t-set="default_vat_label">Tax ID</t>
                <t t-out="company.country_id.vat_label or default_vat_label" />:
                <span t-out="company.vat" />
            </div>
        </xpath>
    </template>

    <!--
        `web.company_address_block` is the template that owns this <ul>, and every
        external layout t-calls it; the per-layout overrides this replaces anchored on
        a <ul> the layouts themselves no longer contain.
    -->
    <template id="l10n_cz_company_address_block" inherit_id="web.company_address_block">
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <t t-call="l10n_cz.registry_vat_external_layout" />
        </xpath>
    </template>

</odoo>
