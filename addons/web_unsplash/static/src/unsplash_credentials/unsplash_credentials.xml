<templates id="template" xml:space="preserve">
    <t t-name="web_unsplash.UnsplashCredentials">
        <div class="d-flex align-items-center flex-wrap">
            <DocumentationLink
              path="'/applications/websites/website/optimize/unsplash.html#generate-an-unsplash-access-key'"
              label.translate="'Get an Access key'"
              class="'me-1'"
              hideIcon="true"
            />
            and paste it here:
            <input type="text"
                   class="o_input o_required_modifier form-control w-auto mx-2"
                   id="accessKeyInput"
                   placeholder="Paste your access key here"
                   t-model.proxy="this.state.key"
                   t-on-input="() => this.state.hasKeyError = false"
                   t-att-class="{ 'is-invalid': this.state.hasKeyError }"/>
            and paste
            <DocumentationLink
              path="'/applications/websites/website/optimize/unsplash.html#generate-an-unsplash-application-id'"
              label.translate="'Application ID'"
              class="'mx-1'"
              hideIcon="true"
            />
            here:
            <input type="text"
                   class="o_input o_required_modifier form-control w-auto ms-2"
                   placeholder="Paste your application ID here"
                   t-model.proxy="this.state.appId"
                   t-on-input="() => this.state.hasAppIdError = false"
                   t-att-class="{ 'is-invalid': this.state.hasAppIdError }"/>
            <button type="button" class="btn btn-primary w-auto ms-3 p-auto save_unsplash" t-on-click="() => this.submitCredentials()">Apply</button>
        </div>
    </t>
</templates>
