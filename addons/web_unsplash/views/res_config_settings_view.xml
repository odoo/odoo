<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.web.unsplash</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="web_unsplash_warning" position="replace">
                <div invisible="not module_web_unsplash">
                    <a href="https://unsplash.com/join" class="fw-bold" target="_blank">
                        <i class="oi" data-icon="east"/> Create Unsplash Account
                    </a>
                    <div class="row mt16">
                        <label for="unsplash_access_key" class="col-3 o_light_label mr8"/>
                        <field name="unsplash_access_key"/>
                    </div>
                    <div class="row">
                        <label for="unsplash_app_id" class="col-3 text-nowrap o_light_label mr8"/>
                        <field name="unsplash_app_id"/>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
