<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="l10n_sa.external_layout_footer_content" inherit_id="web.external_layout_footer_content">
        <xpath expr="//div[hasclass('o_footer_pager_pdf')]" position="before">
            <span t-if="report_type == 'pdf' and additional_footer_text" class="text-muted mb-1" t-out="additional_footer_text"/>
        </xpath>
    </template>
    <template id="l10n_sa_external_layout_folder" inherit_id="web.external_layout_folder">
        <t t-set="header_shape_height" position="after">
            <t t-set="header_shape_height" t-if="o and o._name == 'account.move' and o.country_code == 'SA'">250</t>
        </t>
    </template>
</odoo>
