<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_irmodeloverview_document">
        <t t-call="web.internal_layout">
            <div class="page">
                <h2 name="document_title"><span t-field="o.model" /></h2>
                <dl class="row mb-4">
                    <dt class="col-3">Name</dt>
                    <dd class="col-9"><span t-field="o.name" /></dd>
                    <dt class="col-3">Type</dt>
                    <dd class="col-9"><span t-field="o.state" /></dd>
                    <dt class="col-3">Abstract</dt>
                    <dd class="col-9"><t t-if="o.abstract">Yes</t><t t-else="">No</t></dd>
                    <dt class="col-3">Transient</dt>
                    <dd class="col-9"><t t-if="o.transient">Yes</t><t t-else="">No</t></dd>
                    <dt class="col-3">Apps</dt>
                    <dd class="col-9"><span t-field="o.modules" /></dd>
                </dl>

                <h3 name="security" class="h5">Security</h3>
                <table class="table table-sm table-bordered o_table_fixed mb-4">
                    <colgroup>
                        <col width="30%" />
                        <col width="15%" />
                        <col width="55%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Group</th>
                            <th>Rights</th>
                            <th>Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.access_ids" t-as="access">
                            <td class="text-break"><span t-field="access.group_id" /></td>
                            <td><t t-if="access.perm_read">R</t><t t-if="access.perm_write"> W</t><t t-if="access.perm_create"> C</t><t t-if="access.perm_unlink"> U</t></td>
                            <td class="text-break"><span t-field="access.name" /></td>
                        </tr>
                    </tbody>
                </table>

                <h3 name="fields" class="h5">Fields</h3>
                <table class="table table-sm table-bordered o_table_fixed mb-4">
                    <colgroup>
                        <col width="20%" />
                        <col width="20%" />
                        <col width="12%" />
                        <col width="10%" />
                        <col width="38%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Label</th>
                            <th>Type</th>
                            <th>Flags</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.field_id" t-as="field">
                            <td class="text-break"><span t-field="field.name" /></td>
                            <td class="text-break"><span t-field="field.field_description" /></td>
                            <td><span t-field="field.ttype" /></td>
                            <td><t t-if="field.required">Rq </t><t t-if="field.readonly">Ro </t><t t-if="field.translate">Tr </t><t t-if="field.index">Idx</t></td>
                            <td class="text-break">
                                <div t-if="field.relation">Relation: <span t-field="field.relation" /></div>
                                <div t-if="field.relation_field">Inverse field: <span t-field="field.relation_field" /></div>
                                <div t-if="field.selection_ids">Selection: <span t-out="', '.join('%s (%s)' % (selection.value, selection.name) for selection in field.selection_ids)" /></div>
                                <div t-if="field.size">Size: <span t-field="field.size" /></div>
                                <div t-if="field.on_delete">On delete: <span t-field="field.on_delete" /></div>
                                <div t-if="field.domain">Domain: <span t-field="field.domain" /></div>
                                <div t-if="field.groups">Groups: <span t-out="', '.join(field.groups.mapped('name'))" /></div>
                                <div t-if="field.modules">Apps: <span t-field="field.modules" /></div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h3 name="views" class="h5">Views</h3>
                <table class="table table-sm table-bordered o_table_fixed">
                    <colgroup>
                        <col width="8%" />
                        <col width="12%" />
                        <col width="35%" />
                        <col width="45%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Priority</th>
                            <th>Type</th>
                            <th>Name</th>
                            <th>External ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.view_ids" t-as="view">
                            <td><span t-field="view.priority" /></td>
                            <td><span t-field="view.type" /></td>
                            <td class="text-break"><span t-field="view.name" /></td>
                            <td class="text-break">
                                <span t-field="view.xml_id" />
                                <div t-if="view.inherit_id" class="text-muted">Inherits: <span t-out="view.inherit_id.xml_id or view.inherit_id.name" /></div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_irmodeloverview">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.report_irmodeloverview_document" />
            </t>
        </t>
    </template>

</odoo>
