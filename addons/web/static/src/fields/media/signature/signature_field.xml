<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.SignatureField">
        <t t-if="this.value">
            <img class="o_signature img img-fluid"
                alt="Binary file"
                t-att-src="this.url"
                t-att-name="this.props.name"
                t-att-style="this.sizeStyle"
                t-on-click="this.onClickSignature"
                t-on-error.stop="this.onLoadFailed"
                />
        </t>
        <t t-else="">
            <div class="o_signature o_signature_empty" t-att-style="this.sizeStyle" t-on-click="this.onClickSignature">
                <svg t-on-error.stop="this.onLoadFailed"></svg>
                <p>SIGNATURE</p>
            </div>
        </t>
    </t>

</templates>
