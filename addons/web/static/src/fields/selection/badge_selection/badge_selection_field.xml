<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.BadgeSelectionField">
        <div class="d-flex flex-wrap gap-1 mb-3" t-att-role="props.readonly ? '' : 'radiogroup'" t-att-aria-label="props.readonly ? '' : props.record.fields[props.name].string">
            <t t-if="props.readonly">
                <span t-esc="string" t-att-raw-value="value" />
            </t>
            <t t-else="">
                <t t-foreach="options" t-as="option" t-key="option[0]">
                    <span
                        class="o_selection_badge btn btn-secondary mb-1"
                        t-att-class="{ 'disabled': !isReady, 'active': value === option[0], 'btn-sm': props.size === 'sm', 'btn-lg': props.size === 'lg' }"
                        t-att-aria-disabled="!isReady ? 'true' : 'false'"
                        t-att-value="stringify(option[0])"
                        role="radio"
                        t-att-tabindex="isReady ? 0 : -1"
                        t-att-aria-checked="value === option[0] ? 'true' : 'false'"
                        t-esc="option[1]"
                        t-on-click="() => this.onChange(option[0])"
                        t-on-keydown="(ev) => this.onKeydown(ev, option[0])"
                    />
                </t>
            </t>
        </div>
    </t>

</templates>
