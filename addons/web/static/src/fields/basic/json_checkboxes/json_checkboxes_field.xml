<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.JsonCheckboxes">
        <div aria-atomic="true">
            <t t-foreach="this.checkboxes" t-as="checkbox" t-key="checkbox">
                <div t-att-class="this.props.stacked ? 'd-block' : 'd-inline-block me-3'">
                    <CheckBox
                        id="checkbox"
                        value="checkbox_value.checked"
                        disabled="this.props.readonly || checkbox_value.readonly"
                        onChange="(ev) => this.onChange(checkbox, ev)"
                    >
                        <t t-out="checkbox_value.label" />
                    </CheckBox>
                    <i t-if="checkbox_value.question_circle"
                       class="fa-solid fa-question-circle"
                       role="img"
                       aria-label="Warning"
                       t-att-title="checkbox_value.question_circle"/>
                </div>
            </t>
        </div>
    </t>

</templates>
