    <t t-name="web.HubTabs">
        <t t-set="pinnedIems" t-value="this.getPinnedItems()"/>
        <div t-if="pinnedIems.length > 0" class="o_hub_tabs px-3 pt-2">
            <ul class="nav nav-tabs border-bottom-0">
                <t t-foreach="pinnedIems" t-as="hubItem" t-key="hubItem.id">  
                    <li class="nav-item me-1">
                        <a href="#" class="nav-link"
                            t-att-class="{ 'active': this.props.hub.activeItemId === hubItem.id }"
                            t-on-click.prevent="() => this.openHubItem(hubItem)">
                            <t t-out="hubItem.display_name"/>
                        </a>
                    </li>
                </t>
