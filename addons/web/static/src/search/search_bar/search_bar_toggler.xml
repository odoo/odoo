<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.SearchBar.Toggler">
        <button t-if="this.props.isSmall" t-attf-class="btn btn-secondary {{ this.props.showSearchBar ? 'active' : '' }}" t-on-click="this.props.toggleSearchBar" aria-label="Display search bar" t-att-aria-pressed="this.props.showSearchBar ? 'true' : 'false'">
            <i class="oi oi-fw" data-icon="search" data-tooltip="Display search bar" aria-hidden="true"/>
        </button>
    </t>

    <t t-name="web.SearchBar.Toggler.Offline">
        <button t-if="this.props.isSmall" t-att-disabled="this.isDisabled" t-attf-class="btn btn-secondary {{ this.props.showSearchBar ? 'active' : '' }}" t-on-click="this.props.toggleSearchBar" aria-label="Display search bar" t-att-aria-pressed="this.props.showSearchBar ? 'true' : 'false'" data-available-offline="">
            <i class="oi oi-fw" data-icon="search" aria-hidden="true"/>
        </button>
    </t>

</templates>
