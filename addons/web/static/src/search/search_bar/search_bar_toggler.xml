<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.SearchBar.Toggler">
        <button t-if="this.props.isSmall" t-attf-class="btn btn-secondary {{ this.props.showSearchBar ? 'active' : '' }}" t-on-click="this.props.toggleSearchBar" title="Toggle the search bar" aria-label="Toggle the search bar">
            <i class="fa-solid fa-fw fa-search"/>
        </button>
    </t>

</templates>
