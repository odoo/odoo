<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.CustomFavoriteItem">
        <div t-if="this.showSaveFavorite" class="o_custom_favorite_item">
            <div class="d-flex flex-column gap-2">
                <label class="form-label mb-0 fw-bold" for="saveCurrentSearchInput">Save current search</label>
                <input type="text"
                    class="o_custom_favorite_input form-control rounded"
                    t-ref="this.descriptionRef"
                    t-model.proxy="this.state.description"
                    t-on-keydown="this.onInputKeydown"
                    placeholder="Filter name"
                    id="saveCurrentSearchInput"
                    />
                <CheckBox value="this.state.isDefault" onChange.bind="(checked) => this.state.isDefault = checked" className="'form-switch d-flex gap-1'">
                    <span class="small" data-tooltip="Use this filter by default when opening this view">Default filter</span>
                </CheckBox>
                <div class="d-flex gap-1">
                    <button class="o_save_favorite btn btn-primary btn-sm w-100" t-on-click="this.saveFavorite">
                        Save
                    </button>
                    <button class="o_edit_favorite btn btn-secondary btn-sm w-100" t-on-click="this.editFavorite">
                        Edit
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
