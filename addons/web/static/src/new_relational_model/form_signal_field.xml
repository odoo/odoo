<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.FormSignalField">
        <div class="o_field_widget" t-attf-class="o_field_{{ this.type() }}" t-att-name="this.props.name">
            <t t-if="!this.isEditable()">
                <div t-if="this.type() === 'boolean'" class="form-check">
                    <input type="checkbox" class="form-check-input" t-att-checked="this.value()" disabled="disabled"/>
                </div>
                <span t-else="" t-out="this.displayValue()"/>
            </t>
            <div t-elif="this.type() === 'boolean'" class="form-check">
                <input type="checkbox" class="form-check-input" t-att-checked="this.value()" t-on-change="this.onChange"/>
            </div>
            <select t-elif="this.type() === 'selection'" class="o_input" t-on-change="this.onChange">
                <option value="" t-att-selected="!this.value()"/>
                <t t-foreach="this.props.field.selection" t-as="option" t-key="option[0]">
                    <option t-att-value="option[0]" t-att-selected="option[0] === this.value()" t-out="option[1]"/>
                </t>
            </select>
            <textarea t-elif="this.type() === 'text'" class="o_input" rows="2" t-att-value="this.inputValue()" t-on-input="this.onInput"/>
            <input t-elif="this.type() === 'date'" type="date" class="o_input" t-att-value="this.inputValue()" t-on-change="this.onChange"/>
            <input t-elif="this.type() === 'char'" type="text" class="o_input" t-att-value="this.inputValue()" t-on-input="this.onInput"/>
            <input t-else="" type="number" step="any" class="o_input" t-att-value="this.inputValue()" t-on-input="this.onInput" t-on-change="this.onChange"/>
        </div>
    </t>

</templates>
