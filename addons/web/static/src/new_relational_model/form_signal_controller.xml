<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.FormSignalView">
        <div t-att-class="this.props.className" t-ref="this.rootRef">
            <div class="o_form_view_container">
                <Layout display="this.props.display">
                    <t t-set-slot="control-panel-buttons">
                        <button t-if="this.canCreate" type="button" class="btn btn-outline-primary o_form_button_create" data-hotkey="c" t-on-click="this.create">New</button>
                    </t>
                    <t t-set-slot="control-panel-status-indicator">
                        <FormSignalStatusIndicator t-if="this.canEdit or this.model.isNew()" model="this.model" save.bind="this.save" discard.bind="this.discard"/>
                    </t>
                    <t t-if="this.model.root()">
                        <t t-component="this.props.Renderer"
                           record="this.model.root()"
                           archInfo="this.props.archInfo"
                           fields="this.props.fields"
                           evalContext="this.model.evalContext()"
                           readonly="!this.canEdit and !this.model.isNew()"/>
                    </t>
                </Layout>
            </div>
        </div>
    </t>

    <t t-name="web.FormSignalView.StatusIndicator">
        <div t-if="this.props.model.isNew() or this.props.model.isDirty()" class="o_form_status_indicator d-flex align-items-center gap-1 border-start ps-1 ps-xl-2">
            <button type="button" class="o_form_button_save btn btn-light p-1" data-hotkey="s" data-tooltip="Save manually" aria-label="Save manually" t-on-click.stop="this.props.save">
                <i class="oi oi-fw" data-icon="cloud_upload"/>
            </button>
            <button type="button" class="o_form_button_cancel btn btn-light p-1" data-hotkey="j" data-tooltip="Discard all changes" aria-label="Discard all changes" t-on-click.stop="this.props.discard">
                <i class="oi oi-fw" data-icon="close"/>
            </button>
        </div>
    </t>

</templates>
