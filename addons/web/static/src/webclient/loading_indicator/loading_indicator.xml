<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.LoadingIndicator">
        <Transition visible="this.state.show" name="'o-fade'" t-slot-scope="transition" leaveDuration="400">
            <span class="o_loading_indicator" t-att-class="transition.className" role="status" aria-live="polite">Loading<t t-if="this.env.debug" t-out="' (' + this.state.count + ')'" /></span>
        </Transition>
    </t>

</templates>
