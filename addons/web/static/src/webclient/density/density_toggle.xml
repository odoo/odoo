<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.DensityToggle">
        <div class="o_density_toggle d-flex align-items-center px-2"
             t-on-click="this.toggle"
             role="button"
             t-att-title="this.title"
             t-att-aria-label="this.title">
            <i t-att-class="this.icon"/>
        </div>
    </t>
</templates>