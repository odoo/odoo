<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_control_panel_navigation')]/t/t[@t-call-slot='control-panel-additional-actions']" position="before">
            <t t-call="web.HubItemsMobileDropdown"/>
        </xpath>
        <xpath expr="//div[hasclass('o_cp_pager')]" position="after">
            <button t-if="this.env.config.hub and !this.uiService.isSmall" name="hub_tabs" class="btn btn-secondary"
                    t-att-class="{active: this.env.config.hub.showTabs()}"
                    t-on-click="() => this.env.config.hub.toggleTabs()"
                    aria-label="View related documents"
                    data-tooltip="View related documents">
                <i class="oi" data-icon="tune" role="img" aria-hidden="true"/>
            </button>
        </xpath>
    </t>

    <t t-name="web.HubItemsMobileDropdown">
        <Dropdown t-if="this.env.config.hub and this.env.config.hub.items().length" menuClass="'o_hub_items_mobile_dropdown'">
            <button class="btn btn-secondary" aria-label="View related documents" data-tooltip="View related documents">
                <i class="oi oi-fw" data-icon="tune" role="img" aria-hidden="true"/>
            </button>
            <t t-set-slot="content">
                <t t-call="web.HubItemsMobileDropdownItems"/>
            </t>
        </Dropdown>
    </t>

    <t t-name="web.HubItemsMobileDropdownItems">
        <DropdownItem t-foreach="this.env.config.hub.items()" t-as="item" t-key="item.id"
            class="item.id === this.env.config.hub.activeItemId ? 'selected' : ''"
            onSelected="() => this.env.config.hub.openItem(item)">
            <span t-out="item.display_name"/>
        </DropdownItem>
    </t>

</templates>
