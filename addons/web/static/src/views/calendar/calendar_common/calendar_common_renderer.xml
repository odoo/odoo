<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.CalendarCommonRenderer">
        <div class="o_calendar_widget" t-att-class="{ o_multi_create_mode: this.props.model.hasMultiCreate, 'o_calendar_current': !this.props.isDisabled }" t-ref="this.ref" />
    </t>

    <t t-name="web.CalendarCommonRenderer.event">
            <t t-if="!isTimeHidden">
                <span class="d-none d-lg-inline o_calendar_event_time" t-out="startTime" />
                <t> </t>
            </t>
            <div class="o_event_title">
                <i area-hidden="true" t-if="titleIcon" class="oi me-2" t-att-data-icon="titleIcon"/>
                <t t-out="title"/>
            </div>
    </t>

    <t t-name="web.CalendarCommonRendererHeader">
        <span class="o_calendar_day_name" t-out="scale == 'day' ? weekdayLong : weekdayShort "/> <span t-if="scale != 'month'" class="o_calendar_day_number text-center" t-out="day"/>
    </t>

</templates>
