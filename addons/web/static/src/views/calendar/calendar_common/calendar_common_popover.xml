<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.CalendarCommonPopover">
        <CardPopover t-props="this.cardPopoverProps">
            <t t-set-slot="footer">
                <t t-call="{{ this.constructor.defaultFooterButtonsTemplate }}"/>
            </t>
        </CardPopover>
    </t>

    <t t-name="web.CalendarCommonPopover.CloseButton" t-inherit="web.CardPopover.CloseButton" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_card_popover_close')]" position="attributes">
            <attribute name="class" add="my-3 mx-2" separator=" "/>
        </xpath>
    </t>

    <t t-name="web.CalendarCommonPopover.DefaultFooterButtons">
        <t t-if="this.isEventEditable or this.isEventViewable">
            <a href="#" class="btn btn-primary o_cw_popover_edit" t-on-click="this.onEditEvent">
                <t t-if="this.isEventEditable">Edit</t>
                <t t-else="">View</t>
            </a>
        </t>
        <t t-if="this.isEventDeletable">
            <a href="#" class="btn btn-danger o_cw_popover_delete" t-on-click="this.onDeleteEvent">
                Delete
            </a>
        </t>
    </t>

</templates>
