<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.CalendarSidePanel">
        <t t-if="this.props.sidePanelExpanded">
            <div class="o_calendar_sidepanel_resize h-100 px-2 d-print-none" t-on-click.stop.prevent="" t-ref="this.handleRef"/>
            <div class="o_calendar_sidepanel_container d-print-none position-relative w-100 w-md-auto bg-view overflow-x-hidden overflow-y-auto"
                t-ref="this.rootRef">
                <div t-if="this.props.model.meta.canScheduleEvents and this.state.isDragging" class="d-flex o_calendar_unschedule_zone m-3 align-items-center justify-content-center">
                    <b>Drop here to unschedule</b>
                </div>
                <div class="o_calendar_sidepanel" t-att-class="{ 'd-none': this.props.model.meta.canScheduleEvents and this.state.isDragging }">
                    <DatePicker t-if="this.showDatePicker" t-props="this.datePickerProps" />
                    <div class="o_calendar_sidepanel_content px-3">
                        <t t-foreach="this.sortedFilterSections" t-as="section" t-key="section.fieldName">
                            <FilterSection model="this.props.model" section="section"/>
                        </t>
                        <ScheduleSection
                            t-if="this.props.model.meta.canScheduleEvents"
                            model="this.props.model"
                            editRecord="this.props.editRecord"
                        />
                    </div>
                </div>
            </div>
        </t>
        <t t-elif="!this.uiService.isSmall">
            <div class="o_calendar_sidepanel_resize h-100 px-2 d-print-none" t-on-click.stop.prevent="" t-ref="this.handleRef"/>
            <div class="h-100 o_calendar_sidebar cursor-pointer d-print-none px-2" t-on-click="() => this.props.toggleSidePanel()" t-ref="this.foldedRef">
                <div class="o_calendar_sidebar_current_selection d-flex align-items-center gap-1 mx-auto">
                    <t t-if="this.filters.length">
                        <i class="oi mb-2" data-icon="filter_alt"/>
                        <t t-foreach="this.filters" t-as="filter" t-key="filter_index">
                            <span class="text-truncate mb-2" t-att-class="{ 'text-muted': !filter.active }" t-out="filter.label"/>
                        </t>
                    </t>
                    <t t-if="this.props.model.meta.canScheduleEvents">
                        <i class="oi mb-2" t-att-class="{ 'mt-3': this.filters.length }" data-icon="schedule"/>
                        <span class="text-truncate mb-2" t-out="this.toScheduleString"/>
                    </t>
                </div>
            </div>
        </t>
    </t>
</templates>
