<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.CalendarController">
        <div t-att-class="this.className">
            <Layout className="this.model.useSampleModel ? 'o_view_sample_data' : ''" display="this.props.display">
                <t t-set-slot="control-panel-additional-actions">
                    <CogMenu/>
                </t>
                <t t-set-slot="control-panel-buttons">
                    <t t-call="{{ this.props.buttonTemplate }}"/>
                </t>
                <t t-set-slot="control-panel-actions">
                    <SearchBar toggler="this.searchBarToggler"/>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-component="this.searchBarToggler.component" t-props="this.searchBarToggler.props"/>
                </t>
                <div class="o_calendar_container d-grid h-100 bg-view">
                    <div class="o_calendar_header d-flex flex-row-reverse flex-sm-row align-items-center gap-1 px-3 py-2 px-print-0 pt-print-0 border-bottom">
                        <div t-if="!this.uiService.isSmall" class="o_calendar_navigation_buttons btn-group d-print-none">
                            <button
                                class="o_calendar_button_prev btn btn-secondary d-none d-md-block"
                                title="Previous"
                                aria-label="Previous"
                                t-on-click.stop="() => this.setDate('previous')"
                            ><i class="oi" data-icon="west"/></button>
                            <button
                                class="o_calendar_button_next btn btn-secondary d-none d-md-block"
                                title="Next"
                                aria-label="Next"
                                t-on-click.stop="() => this.setDate('next')"
                            ><i class="oi" data-icon="east"/></button>
                        </div>
                        <ViewScaleSelector scales="this.scales" currentScale="this.model.scale" isWeekendVisible="this.state.isWeekendVisible" setScale.bind="this.setScale" toggleWeekendVisibility.bind="this.toggleWeekendVisibility" dropdownClass="'d-print-none order-3 order-lg-0'"/>
                        <button
                            class="btn btn-secondary o_calendar_button_today d-print-none order-2 order-lg-0 ms-md-0"
                            t-on-click.stop="() => this.setDate('today')">
                            Today
                        </button>
                        <h5 class="d-inline-flex ps-lg-2 ps-print-0 mb-0">
                            <t t-if="this.model.meta.scale === 'year'">
                                <t t-out="this.currentYear"/>
                            </t>
                            <t t-elif="this.model.meta.scale === 'month'">
                                <t t-out="this.currentMonth"/>
                            </t>
                            <t t-elif="this.model.meta.scale === 'week'">
                                <t t-out="this.weekHeader"/> <span t-if="this.model.meta.scale === 'week'" class="o_current_week badge bg-100 rounded px-1 ms-1">Week <t t-out="this.currentWeek"/></span>
                            </t>
                            <t t-else="">
                                <t t-out="this.dayHeader" />
                            </t>
                        </h5>
                        <MultiSelectionButtons reactive="this.multiSelectionButtonsReactive" />
                        <div t-if="this.hasSidePanel and !this.uiService.isSmall" class="o_calendar_sidebar_controller d-flex align-items-center gap-2 ms-auto d-print-none small">
                            <div t-if="!this.sidePanelExpanded" class="d-flex align-items-center gap-1">
                                <i t-if="this.filters.length" class="oi" data-icon="filter_alt"/>
                                <t t-foreach="this.filters" t-as="filter" t-key="filter_index">
                                    <div class="d-flex align-items-center gap-1 badge bg-300" t-att-class="{ 'text-muted': !filter.active }">
                                        <span class="text-truncate" t-out="filter.label"/>
                                    </div>
                                </t>
                                <span t-if="this.filters &amp;&amp; this.model.meta.canScheduleEvents">-</span>
                                <div t-if="this.model.meta.canScheduleEvents" class="badge bg-info-light text-truncate" t-out="this.toScheduleString"/>
                            </div>
                            <button
                                class="btn btn-secondary"
                                t-att-class="{ 'active': this.sidePanelExpanded }"
                                t-on-click="() => this.toggleSidePanel()"
                                title="Toggle Side Panel"
                                aria-label="Toggle Side Panel"
                                >
                                <i class="oi" t-att-class="{'oi-filled': this.sidePanelExpanded}" data-icon="dock_to_left"/>
                            </button>
                        </div>
                    </div>
                    <MobileFilterPanel t-if="this.uiService.isSmall and this.hasSidePanel" t-props="this.mobileFilterPanelProps" />
                    <div class="o_calendar_wrapper d-flex overflow-hidden">
                        <t t-if="this.showCalendar" t-component="this.props.Renderer" t-props="this.rendererProps"/>
                        <CalendarSidePanel t-if="this.hasSidePanel" t-props="this.sidePanelProps"/>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <t t-name="web.CalendarController.controlButtons"/>
</templates>
