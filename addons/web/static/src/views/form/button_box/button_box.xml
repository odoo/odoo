<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="web.Form.ButtonBox" >
    <!--
        No `w-100` below md: the buttons are all behind the "More" toggler
        there (`maxVisibleButtons` is 0), so a full width would only make the
        toggler claim a row of its own and wrap what sits next to it.
    -->
    <div class="o-form-buttonbox d-print-none position-relative d-flex" t-attf-class="{{ this.isFull ? 'o_full' : 'o_not_full'}} {{this.props.class}}">
        <t t-call-slot="{{ button_value }}" t-foreach="this.visibleButtons" t-as="button" t-key="button_value"/>
        <div t-if="this.additionalButtons.length" class="oe_stat_button btn position-relative p-0 border-0">
            <Dropdown position="!this.ui.isSmall ? 'bottom-end' : ''" menuClass="'o-form-buttonbox p-0 border-0 ' + (!this.ui.isSmall ? 'o_dropdown_more' : 'o-form-buttonbox-small')">
                <button class="o_button_more btn d-flex justify-content-center align-items-center" t-att-class="!this.ui.isSmall ? 'o-dropdown-caret btn-outline-secondary' : 'btn-secondary'" data-available-offline="">
                    <span t-if="!this.ui.isSmall">More</span>
                    <i t-else="" class="oi oi-fw lh-base" data-icon="widgets" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem t-foreach="this.additionalButtons" t-as="button" t-key="button_value" class="'d-flex flex-column p-0'">
                        <t t-call-slot="{{ button_value }}" />
                    </DropdownItem>
                </t>
            </Dropdown>
        </div>
    </div>
</t>

</templates>
