<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.FormStatusIndicator">
        <div class="o_form_status_indicator d-md-flex align-items-center align-self-md-end me-auto" t-att-class="{ o_form_status_indicator_new_record: this.props.isNew }">
            <div class="d-flex align-items-center ps-1 ps-xl-2 border-start" t-att-class="{ invisible: !(this.isNew or this.displayButtons or this.state.feedback) }">
                <span t-if="this.state.feedback" class="o_form_status_indicator_feedback small">
                    <i class="oi oi-fw me-1" t-att-class="this.state.feedback.className" t-att-data-icon="this.state.feedback.icon" /><t t-out="this.state.feedback.text"/>
                </span>
                <div class="o_form_status_indicator_buttons d-flex gap-1" t-att-class="{ invisible: !(this.isNew or this.displayButtons) }">
                    <button
                        type="button"
                        class="o_form_button_save btn btn-light p-1"
                        data-hotkey="s"
                        t-on-click.stop="this.save"
                        data-tooltip="Save manually"
                        aria-label="Save manually"
                        data-available-offline=""
                        t-att-disabled="!this.props.isNew and this.indicatorMode === 'invalid'">
                        <i class="oi oi-fw" data-icon="cloud_upload" />
                    </button>
                    <button
                        type="button"
                        class="o_form_button_cancel btn btn-light p-1"
                        data-hotkey="j"
                        t-on-click.stop="this.discard"
                        data-tooltip="Discard all changes"
                        data-available-offline=""
                        aria-label="Discard all changes">
                        <i class="oi oi-fw" data-icon="close" />
                    </button>
                </div>
            </div>
            <span
                t-if="!this.props.isNew and this.indicatorMode === 'invalid'"
                class="text-danger small ms-2"
                data-tooltip="Unable to save. Correct the issue or discard all changes">
                <i class="oi" data-icon="warning" />
            </span>
        </div>
    </t>
</templates>
