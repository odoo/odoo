<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.StatusBarButtons">
        <div class="o_statusbar_buttons d-flex align-items-center align-content-around flex-wrap gap-1">
            <t t-if="this.uiService.isSmall">
                <!--
                    Only the first button: the others are in the single
                    actions menu of the control panel, so that a form view
                    shows one ellipsis rather than one per concern.
                -->
                <t t-set="firstSlot" t-value="this.visibleSlotNames[0]" />
                <t t-if="firstSlot" t-call-slot="{{ firstSlot }}" />
            </t>
            <t t-else="">
                <t t-foreach="this.visibleSlotNames" t-as="slot" t-key="slot">
                    <t t-call-slot="{{ slot }}" />
                </t>
            </t>
        </div>
    </t>

</templates>
