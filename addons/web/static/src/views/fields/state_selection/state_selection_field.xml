<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.StateSelectionField">
        <!-- When readonly, the wrapper carries the tooltip -->
        <div
            class="o_state_selection_wrapper"
            t-att-class="this.props.readonly ? '' : 'd-contents'"
            t-att-data-tooltip="!this.props.showLabel and this.props.readonly ? this.label : ''"
        >
            <Dropdown menuClass="'state_selection_field_menu'" state="this.dropdownState" disabled="this.props.readonly">
                <button
                    class="o_state_selection_btn btn btn-secondary mw-100 rounded-pill lh-1 text-truncate opacity-trigger-hover"
                    t-att-class="{
                        'o_has_not_label': !this.props.showLabel,
                        'btn-sm py-1 px-2': this.props.showLabel and this.props.viewType != 'form',
                    }"
                    data-available-offline=""
                    t-att-data-tooltip="!this.props.showLabel and !this.props.readonly ? this.label : ''"
                    t-att-disabled="this.props.readonly"
                >
                    <i
                        class="o_status oi transition-base opacity-100-hover"
                        t-att-class="{ 'me-1': this.props.showLabel }"
                        t-attf-class="{{ this.stateIconClass(this.currentValue) }} {{this.statusColor(this.currentValue) }} {{ this.dropdownState.isOpen ? 'opacity-100' : 'opacity-75' }}"
                        t-att-data-icon="this.stateIcon(this.currentValue)"
                    />
                    <span t-if="this.props.showLabel" class="o_status_label text-truncate" t-out="this.label"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="this.options" t-as="option" t-key="option[0]">
                        <CheckboxItem
                            class="'d-flex align-items-baseline gap-2 ' + (option[0] === this.currentValue ? 'active' : '')"
                            checked="option[0] === this.currentValue"
                            onSelected="() => this.updateRecord(option[0])">
                                <i class="oi o_status" t-attf-class="{{ this.stateIconClass(option[0]) }} {{ this.statusColor(option[0]) }}" t-att-data-icon="this.stateIcon(option[0])"/>
                                <span t-out="option[1]"/>
                        </CheckboxItem>
                    </t>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
