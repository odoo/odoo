<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ReferenceField">
        <t t-set="relation" t-value="this.getRelation()"/>
        <div class="o_row" t-ref="this.rootRef">
            <t t-if="!this.props.readonly and !this.hideModelSelector">
                <SelectMenu
                    class="'o_input border-0'"
                    value="relation"
                    choices="this.choices"
                    onSelect.bind="this.updateModel"
                />
            </t>
            <t t-if="relation">
                <Many2One t-key="relation" t-props="this.m2oProps"/>
            </t>
        </div>
    </t>

</templates>
