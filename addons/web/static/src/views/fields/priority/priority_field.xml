<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.PriorityField">
        <Dropdown t-if="!this.props.readonly and this.ui.isSmall" menuClass="'o_priority_menu'">
            <button
                class="o_priority_dropdown_toggle btn btn-link btn-link-inline d-flex align-items-center p-0"
                name="priority"
                aria-label="Priority"
            >
                <span class="o_priority d-inline-flex" t-att-class="this.colorClass">
                    <t t-foreach="this.options" t-as="value" t-key="value[0]">
                        <i
                            t-if="!value_first"
                            class="o_priority_star oi py-1"
                            data-icon="flag"
                            t-attf-class="{{value_index lte this.index ? 'o_star_active oi-filled' : 'opacity-25'}}"
                        />
                    </t>
                </span>
            </button>
            <t t-set-slot="content">
                <t t-foreach="this.options" t-as="value" t-key="value[0]">
                    <DropdownItem
                        class="'d-flex align-items-center gap-2' + (value_index === this.index ? ' active' : '')"
                        attrs="{ role: 'menuitemradio', 'aria-checked': value_index === this.index ? 'true' : 'false' }"
                        onSelected="() => this.updateRecord(value[0])"
                    >
                        <span class="o_priority d-flex" t-att-class="value_index > 0 ? 'o_priority_lvl_' + value_index : ''">
                            <i
                                class="o_priority_star oi"
                                data-icon="flag"
                                t-attf-class="{{value_index > 0 ? 'o_star_active oi-filled' : 'opacity-25'}}"
                            />
                        </span>
                        <span t-out="value[1]"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
        <div t-else="" class="o_priority opacity-trigger-hover d-flex" t-att-class="this.colorClass" role="radiogroup" name="priority" aria-label="Priority">
            <t t-foreach="this.options" t-as="value" t-key="value">
                <t t-if="!value_first">
                    <t t-if="this.props.readonly">
                        <i
                            class="o_priority_star oi py-1"
                            role="radio"
                            data-icon="flag"
                            t-att-class="{'o_star_active oi-filled': value_index lte this.index}"
                            tabindex="0"
                            t-att-data-tooltip="this.getTooltip(value[0],value[1])"
                            t-att-aria-checked="value_index === this.index ? 'true' : 'false'"
                            t-att-aria-label="value[1]"
                        />
                    </t>
                    <t t-else="">
                        <button
                            class="o_priority_star btn btn-link btn-link-inline oi py-1"
                            t-att-class="{'ps-1': value_index === 1, 'pe-1': value_last}"
                            role="radio"
                            data-icon="flag"
                            t-attf-class="{{value_index lte this.index ? 'o_star_active oi-filled' : 'opacity-25 opacity-50-hover'}}"
                            tabindex="0"
                            t-att-data-tooltip="this.getTooltip(value[0], value[1])"
                            t-att-aria-checked="value_index === this.index ? 'true' : 'false'"
                            t-att-aria-label="value[1]"
                            t-on-click.stop="() => this.onStarClicked(value[0])"
                            t-on-mouseenter="() => this.state.index = value_index"
                            t-on-mouseleave="() => this.state.index = -1"
                            data-available-offline=""
                        />
                    </t>
                </t>
            </t>
        </div>
    </t>

</templates>
