<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.PriorityField">
        <div class="o_priority opacity-trigger-hover d-flex" role="radiogroup" name="priority" aria-label="Priority">
            <t t-foreach="this.options" t-as="value" t-key="value">
                <t t-if="!value_first">
                    <t t-if="this.props.readonly">
                        <span
                            class="o_priority_star oi"
                            role="radio"
                            data-icon="star"
                            t-att-class="{'oi-filled': value_index lte this.index}"
                            tabindex="0"
                            t-att-data-tooltip="this.getTooltip(value[0],value[1])"
                            t-att-aria-checked="value_index === this.index ? 'true' : 'false'"
                            t-att-aria-label="value[1]"
                        />
                    </t>
                    <t t-else="">
                        <button
                            class="o_priority_star btn btn-link btn-link-inline oi p-0"
                            role="radio"
                            data-icon="star"
                            t-att-class="(value_index lte this.index ? 'oi-filled' : 'opacity-25 opacity-100-hover') + (value[0] === this.justSet.value ? ' o-isJustSet' : '')"
                            tabindex="0"
                            t-att-data-tooltip="this.getTooltip(value[0], value[1])"
                            t-att-aria-checked="value_index === this.index ? 'true' : 'false'"
                            t-att-aria-label="value[1]"
                            t-on-click.stop="(ev) => this.onStarClicked(value[0], ev)"
                            t-on-mouseenter="() => this.state.index = value_index"
                            t-on-mouseleave="() => this.state.index = -1"
                            data-available-offline=""
                        />
                    </t>
                </t>
            </t>
        </div>
    </t>

</templates>
