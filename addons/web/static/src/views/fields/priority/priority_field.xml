<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.PriorityField">
        <div class="o_priority opacity-trigger-hover d-flex" role="radiogroup" name="priority" aria-label="Priority">
            <t t-foreach="this.options" t-as="value" t-key="value">
                <t t-if="!value_first">
                    <t t-if="this.props.readonly">
                        <span
                            class="oi o_priority_star"
                            role="radio"
                            t-att-data-icon="value_index lte this.index ? 'star' : 'star'"
                            tabindex="0"
                            t-att-data-tooltip="this.getTooltip(value[0],value[1])"
                            t-att-aria-checked="value_index === this.index ? 'true' : 'false'"
                            t-att-aria-label="value[1]"
                        />
                    </t>
                    <t t-else="">
                        <button
                            class="oi o_priority_star btn btn-link btn-link-inline p-0"
                            role="radio"
                            t-att-data-icon="value_index lte this.index ? 'star' : 'star'"
                            tabindex="0"
                            t-att-data-tooltip="this.getTooltip(value[0], value[1])"
                            t-att-aria-checked="value_index === this.index ? 'true' : 'false'"
                            t-att-aria-label="value[1]"
                            t-on-click.stop="() => this.onStarClicked(value[0])"
                            t-on-mouseenter="() => this.state.index = value_index"
                            t-on-mouseleave="() => this.state.index = -1"
                            data-available-offline=""
                        />
                    </t>
                </t>
            </t>
        </div>
    </t>

</templates>
