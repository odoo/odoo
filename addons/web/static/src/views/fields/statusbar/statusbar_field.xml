<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.StatusBarField.Dropdown">
        <t t-foreach="items" t-as="item" t-key="item.value">
            <DropdownItem
                class="this.getDropdownItemClassNames(item)"
                onSelected="() => this.selectItem(item)"
            >
                <span t-out="item.label" />
            </DropdownItem>
        </t>
    </t>

    <t t-name="web.StatusBarField">
        <div class="o_statusbar_status o_switcher" t-ref="this.rootRef" role="radiogroup" aria-label="Statusbar">
            <span class="o_statusbar_highlighter" t-ref="this.highlighterRef" aria-hidden="true"/>
            <Dropdown position="'bottom-end'">
                <button
                    t-ref="this.afterRef"
                    type="button"
                    class="btn btn-secondary dropdown-toggle o_arrow_button o_first"
                    t-att-disabled="this.props.isDisabled"
                    aria-label="More..."
                >
                    ...
                </button>
                <t t-set-slot="content">
                    <t t-call="web.StatusBarField.Dropdown" items="this.items.after"/>
                </t>
            </Dropdown>
            <t t-foreach="this.items.inline" t-as="item" t-key="item.value">
                <div class="o_arrow_button_wrap d-flex gap-1">
                    <button
                        type="button"
                        class="btn btn-secondary o_arrow_button"
                        t-att-class="{
                            o_first: item_first,
                            o_arrow_button_current: item.isSelected,
                            o_last: item_last,
                        }"
                        t-att-disabled="this.props.isDisabled || item.isSelected"
                        role="radio"
                        t-att-aria-checked="item.isSelected.toString()"
                        t-att-aria-current="item.isSelected and 'step'"
                        t-att-data-value="item.value"
                        t-out="item.label"
                        t-on-click="() => this.selectItem(item)"
                    />
                    <i t-if="!item_first"
                        class="oi align-self-center opacity-75 d-none d-md-inline"
                        data-icon="chevron_forward"/>
                </div>
            </t>
            <Dropdown position="'bottom-start'">
                <button
                    t-ref="this.beforeRef"
                    type="button"
                    class="btn btn-secondary dropdown-toggle o_arrow_button o_last"
                    t-att-disabled="this.props.isDisabled"
                    aria-label="More..."
                >
                    ...
                </button>
                <t t-set-slot="content">
                    <t t-call="web.StatusBarField.Dropdown" items="this.items.before"/>
                </t>
            </Dropdown>
            <Dropdown position="'bottom-end'">
                <t t-set="allItems" t-value="this.getAllItems()" />
                <t t-set="selectedIndex" t-value="allItems.findIndex((item) => item.isSelected)" />
                <button
                    t-ref="this.dropdownRef"
                    type="button"
                    class="btn btn-secondary dropdown-toggle"
                    t-att-class="{'o_arrow_button': this.uiService.isSmall, 'o_last': selectedIndex === 0 , 'o_first': selectedIndex === allItems.length - 1}"
                    t-att-disabled="this.props.isDisabled"
                >
                    <i class="oi oi-fw" data-icon="chevron_forward" role="presentation"/> <t t-out="this.getCurrentLabel()" />
                </button>
                <t t-set-slot="content">
                    <t t-call="web.StatusBarField.Dropdown" items="this.getAllItems()"/>
                </t>
            </Dropdown>
        </div>
    </t>
</templates>
