<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.BooleanFavoriteField">
        <button class="o_favorite btn btn-light d-flex p-1" t-att-class="(this.props.readonly ? 'pe-none o_disabled' : '') + ' ' + this.btnClass" t-on-click.prevent.stop="this.update" data-available-offline="">
            <i class="oi" t-att-class="this.iconClass" data-icon="star" role="img" t-att-title="this.label" t-att-aria-label="this.label"/>
            <t t-if="!this.props.readonly and !this.props.noLabel" t-out="this.label"/>
        </button>
    </t>

</templates>
