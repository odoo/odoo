<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="web.WeekDaysForm">
        <div class="o_recurrent_weekdays mb-2 d-flex">
            <t t-foreach="this.weekdays" t-as="day" t-key="day">
                <div t-attf-class="o_week_days_form_rounded {{this.data[day] ? 'text-bg-action' : 'btn-secondary'}}"
                    t-on-click="this.props.readonly? () => {} : () => this.onChange(day)">
                    <t t-esc="this.props.record.fields[day].string[0]"/>
                </div>
            </t>
        </div>
    </t>
</templates>
