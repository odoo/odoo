<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.VideoWidget">
        <a class="o_video_preview position-relative overflow-hidden d-inline-block mb-2 rounded-4"
           role="button" t-att-title="this.title" t-on-click="this.openVideo">
            <i class="oi oi-4x oi-filled position-absolute top-50 start-50 translate-middle w-auto h-auto z-1" data-icon="play_circle"/>
            <div class="position-absolute top-0 end-0 w-100 h-100"/>
            <img t-att-src="this.props.preview" t-att-alt="this.title" class="img w-100"/>
        </a>
    </t>

    <t t-name="web.VideoDialog">
        <Dialog
            bodyClass="'shadow'"
            contentClass="'border-0 bg-transparent shadow-none'"
            footer="false"
            size="'xl'"
            technical="false"
            withBodyPadding="false"
            t-on-click="this.props.close"
        >
            <div class="ratio ratio-16x9">
                <iframe
                    allow="autoplay; encrypted-media; picture-in-picture; web-share"
                    width="1140"
                    height="641"
                    t-att-src="this.props.url"
                    t-att-title="this.props.title"
                    frameborder="0"
                    allowfullscreen="1"
                >
                    Your browser does not support iframe.
                </iframe>
            </div>
        </Dialog>
    </t>

</templates>
