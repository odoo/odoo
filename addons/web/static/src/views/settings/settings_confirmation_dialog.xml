<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.SettingsConfirmationDialog">
        <Dialog size="'md'" title="this.props.title" modalRef="this.modalRef">
            <t t-out="this.props.body" />
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.confirm">
                    Save
                </button>
                <button class="btn btn-secondary" t-on-click="this._stayHere">
                    Stay Here
                </button>
                <button class="btn btn-secondary" t-on-click="this.cancel">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>
</templates>
