<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.KanbanRecord" t-inherit="web.CardRenderer">
        <xpath expr="article" position="attributes">
            <attribute name="t-ref">this.rootRef</attribute>
            <attribute name="t-custom-click">this.onGlobalClick</attribute>
            <attribute name="t-on-touchstart">this.onTouchStart</attribute>
            <attribute name="t-on-touchmove">this.onTouchMoveOrCancel</attribute>
            <attribute name="t-on-touchcancel">this.onTouchMoveOrCancel</attribute>
            <attribute name="t-on-touchend">this.onTouchEnd</attribute>
        </xpath>
        <xpath expr="article" position="attributes">
            <attribute name="t-attf-class">#{(this.props.selectionAvailable or this.props.hasSelectedRecords) and !this.props.record.selected ? 'opacity-75 opacity-100-hover' : ''} #{this.props.record.selected ? 'z-2' : ''}</attribute>
        </xpath>
        <xpath expr="article" position="inside">
            <button
                t-if="this.props.selectionAvailable or this.props.hasSelectedRecords"
                type="button"
                class="o_record_selection_btn btn position-absolute d-flex align-items-start justify-content-end p-2 cursor-pointer z-1"
                t-att-aria-pressed="this.props.record.selected ? 'true' : 'false'"
            >
                <i class="oi rounded-circle p-1 bg-view fs-3" t-att-class="this.props.record.selected ? 'oi-filled text-action' : 'text-muted'" t-att-data-icon="this.props.record.selected ? 'check_circle' : 'circle'"/>
            </button>
            <t t-call="{{ this.constructor.menuTemplate }}"/>
        </xpath>
    </t>

    <t t-name="web.KanbanMenu">
        <div t-if="this.showMenu and !this.props.forceGlobalClick and !(this.props.hasSelectedRecords or this.props.selectionAvailable)" class="o_dropdown_kanban bg-transparent position-absolute end-0 top-0 w-auto p-1">
            <Dropdown menuClass="'o-dropdown--kanban-record-menu'" position="'bottom-end'">
                <button class="btn btn-light o-no-caret px-2" title="Dropdown menu">
                    <i class="oi" data-icon="more_vert"/>
                </button>
                <t t-set-slot="content">
                    <KanbanDropdownMenuWrapper>
                        <t t-call="{{ this.templates[this.constructor.MENU_ATTRIBUTE] }}" t-call-context="this.renderingContext"/>
                    </KanbanDropdownMenuWrapper>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
