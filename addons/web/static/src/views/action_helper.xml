<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ActionHelper">
        <div class="o_view_nocontent">
            <Help t-if="this.helpArchInfo" archInfo="this.helpArchInfo" actionHelp="this.actionHelp"/>
            <div t-else="" class="o_nocontent_help">
                <t t-if="this.props.noContentHelp" t-out="this.props.noContentHelp"/>
                <t t-else="">
                    <p class="o_view_nocontent_empty_folder">No data to display</p>
                    <p>Try to add some records, or make sure that there is no active filter in the search bar.</p>
                </t>
            </div>
        </div>
    </t>

</templates>
