<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

 <t t-name="web.ListRenderer">
 <t t-set="_canSelectRecord" t-value="this.canSelectRecord"/>
 <div
 class="o_list_renderer o_renderer table-responsive"
 tabindex="-1"
 t-ref="root"
 >
 <t t-if="this.showNoContentHelper">
 			<ActionHelper noContentHelp="this.props.noContentHelp" showRibbon="this.props.list.model.useSampleModel"/>
 </t>
 <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 {{this.props.list.isGrouped ? 'o_list_table_grouped' : 'o_list_table_ungrouped table-striped'}}" t-ref="table">
 <thead>
 <tr>
 <th t-if="this.hasSelectors" class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer" tabindex="-1" t-on-keydown="(ev) => this.onCellKeydown(ev)" t-on-click.stop="this.toggleSelection">
 <CheckBox disabled="!_canSelectRecord" value="this.selectAll" className="'d-flex m-0'" onChange.bind="this.toggleSelection"/>
 </th>
 <t t-foreach="this.columns" t-as="column" t-key="column.id">
 <th t-if="column.type === 'field'"
 t-att-data-name="column.name"
 t-att-class="this.getColumnClass(column) + ' opacity-trigger-hover w-print-auto'"
 t-on-click="() => this.onClickSortColumn(column)"
 t-on-keydown="(ev) => this.onCellKeydown(ev)"
 data-tooltip-delay="1000"
 tabindex="-1">
 <t t-if="column.hasLabel and column.widget !== 'handle'">
 <t t-set="isNumeric" t-value="this.isNumericColumn(column)"/>
 <div class="d-flex align-items-center"
 t-att-data-tooltip-template="this.isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
 t-att-data-tooltip-info="this.makeTooltip(column)">
 <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1" t-att-class="isNumeric ? 'o_list_number_th' : ''"
 t-out="column.label"/>
 <div class="o_list_header_label_spacer"/>
 <i class="o_list_sortable_icon" t-att-class="this.getSortableIconClass(column)"/>
 </div>
 <span
 class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-1"
 t-on-pointerdown.stop.prevent="(ev) => this.columnWidths.onStartResize(ev)"
 t-on-dblclick="() => this.columnWidths.resetWidths()"/>
 </t>
 </th>
 <th t-else="" t-on-keydown="(ev) => this.onCellKeydown(ev)" t-att-class="{'o_list_button w-print-0 p-print-0': column.type === 'button_group'}"/>
 </t>
 <th t-if="this.hasOpenFormViewColumn" t-on-keydown="(ev) => this.onCellKeydown(ev)" class="o_list_open_form_view w-print-0 p-print-0"/>
 <th t-if="this.hasActionsColumn" t-on-keydown="(ev) => this.onCellKeydown(ev)" class="o_list_controller o_list_actions_header w-print-0 p-print-0 position-sticky end-0">
 <div t-if="this.displayOptionalFields or this.hasOptionalOpenFormViewColumn" class="o_optional_columns_dropdown d-print-none text-center border-top-0">
 <Dropdown position="'bottom-end'" menuClass="'o_optional_columns_menu'">
 <button class="btn p-0" tabindex="-1" t-att-class="{ 'o_invalid_optional_columns_button': this.hasInvalidOptionalFields }">
 <i class="o_optional_columns_dropdown_toggle oi oi-fw oi-settings-adjust"/>
 </button>

 <t t-set-slot="content">
 <t t-foreach="this.optionalFieldGroups" t-as="group" t-key="group_index">
 <div t-if="!group_first" role="separator" class="dropdown-divider"/>
 <DropdownItem t-if="group.displayName" closingMode="'none'" onSelected="() => this.toggleOptionalFieldGroup(group.id)">
 <div class="fw-bold" t-out="group.displayName"/>
 </DropdownItem>
 <t t-foreach="group.optionalFields" t-as="field" t-key="field_index">
 <DropdownItem closingMode="'none'" onSelected="() => this.toggleOptionalField(field.name)" class="this.getOptionalDropdownItemClass(field)">
 <CheckBox
 onChange="() => this.toggleOptionalField(field.name)"
 value="field.value"
 name="field.name"
 >
 <span class="d-flex align-items-center"><span class="text-truncate" t-out="field.label"/><span class="ps-1" t-if="this.env.debug" t-out="' (' + field.name + ')'" /></span>
 </CheckBox>
 </DropdownItem>
 </t>
 </t>
 <div t-if="this.hasOptionalOpenFormViewColumn" role="separator" class="dropdown-divider"/>
 <DropdownItem t-if="this.hasOptionalOpenFormViewColumn" closingMode="'none'" onSelected="() => this.toggleDebugOpenView()">
 <CheckBox
 onChange="() => this.toggleDebugOpenView()"
 value="this.debugOpenView"
 name="'View Button'"
 >
 <span class="d-flex align-items-center"><span class="text-truncate">View Button</span></span>
 </CheckBox>
 </DropdownItem>
 </t>
 </Dropdown>
 </div>
 </th>
 </tr>
 </thead>
 <tbody class="ui-sortable">
 <t t-call="{{ this.constructor.rowsTemplate }}" list="this.props.list"/>
 </tbody>
 <tfoot t-on-click="() => this.props.list.leaveEditMode()" class="o_list_footer cursor-default" t-att-class="{o_sample_data_disabled: this.props.list.model.useSampleModel}">
 <ListAggregatesRow
 agg="this.agg"
 list="this.props.list"
 archInfo="this.props.archInfo"
 columns="this.columns"
 hasSelectors="this.hasSelectors"
 hasOpenFormViewColumn="this.hasOpenFormViewColumn"
 displayOptionalFields="this.displayOptionalFields"
 hasActionsColumn="this.hasActionsColumn"
 activeActions="this.activeActions"
 canCreateGroup="this.canCreateGroup"
 showGroupInput="this.state.showGroupInput"
 onShowGroupInput="() => { this.state.showGroupInput = true; }"
 onHideGroupInput="() => { this.state.showGroupInput = false; }"
 onGroupInputConfirm="(value) => this.addNewGroup(value)"
 />
 </tfoot>
 </table>
 </div>
 </t>

 <t t-name="web.ListRenderer.Rows">
 <t t-if="this.virt and this.virt.isActive">
 <tr t-if="this.virt.topSpacerHeight > 0" class="o_virtual_spacer">
 <td t-att-colspan="this.nbCols" t-attf-style="height: {{ this.virt.topSpacerHeight }}px;"/>
 </tr>
 <t t-foreach="this.virt.visibleFlatRows" t-as="flatRow" t-key="flatRow.type === 'record' ? flatRow.record.id : (flatRow.type === 'group' ? 'group:' + flatRow.group.id : 'addline:' + (flatRow.parentGroup ? flatRow.parentGroup.id : flatRow.globalIndex))">
 <t t-if="flatRow.type === 'record'">
 <t t-component="this.rowComponent" t-props="this.getRowProps(flatRow.record, flatRow.parentGroup, flatRow.parentGroup ? flatRow.parentGroup.id : undefined)"/>
 </t>
 <t t-elif="flatRow.type === 'group'">
 <t t-set="group" t-value="flatRow.group"/>
 <t t-call="{{ this.constructor.groupRowTemplate }}"/>
 </t>
 <t t-elif="flatRow.type === 'add-line'">
 <tr t-att-data-row-index="flatRow.globalIndex">
 <td t-if="this.hasSelectors"/>
 <td t-att-colspan="this.hasSelectors ? this.nbCols - 1 : this.nbCols"
 class="o_group_field_row_add">
 <a href="#" role="button"
 t-on-click.stop.prevent="() => this.addInGroup(flatRow.parentGroup)"
 t-on-keydown="(ev) => this.onCellKeydown(ev)">
 Add a line
 </a>
 </td>
 </tr>
 </t>
 </t>
 <tr t-if="this.virt.bottomSpacerHeight > 0" class="o_virtual_spacer">
 <td t-att-colspan="this.nbCols" t-attf-style="height: {{ this.virt.bottomSpacerHeight }}px;"/>
 </tr>
 <t t-if="!this.props.list.isGrouped" t-call="{{ this.constructor.createControlsTemplate }}"/>
 </t>
 <t t-else="">
 <t t-if="!list.isGrouped">
 <t t-foreach="this.getRowRecords(list)" t-as="record" t-key="record.id">
 <t t-component="this.rowComponent" t-props="this.getRowProps(record, group, groupId)"/>
 </t>
 <t t-call="{{ this.constructor.createControlsTemplate }}"/>
 <t t-if="!this.props.list.isGrouped and !this.props.noContentHelp">
 <tr t-foreach="this.emptyRowIds" t-as="emptyRowId" t-key="emptyRowId">
 <td t-att-colspan="this.nbCols">&#8203;</td>
 </tr>
 </t>
 </t>
 <t t-else="">
 <t t-foreach="list.groups" t-as="group" t-key="group.id">
 <t t-call="{{ this.constructor.groupRowTemplate }}"/>
 <t t-if="!group.isFolded">
 <t t-call="{{ this.constructor.rowsTemplate }}" list="group.list" groupId="group.id"/>
 <tr t-if="!group.list.isGrouped and this.props.editable and this.canCreate"
 t-att-data-row-index="this.gridState.findAddLineByGroupId(group.id)?.globalIndex">
 <td t-if="this.hasSelectors"/>
 <td
 t-att-colspan="this.hasSelectors ? this.nbCols - 1 : this.nbCols"
 class="o_group_field_row_add"
 >
 <a href="#"
 role="button"
 t-on-click.stop.prevent="() => this.addInGroup(group)"
 t-on-keydown="(ev) => this.onCellKeydown(ev)"
 >
 Add a line
 </a>
 </td>
 </tr>
 </t>
 </t>
 </t>
 </t>
 </t>

 <t t-name="web.ListRenderer.CreateControls">
 <tr t-if="this.displayRowCreates" class="d-print-none">
 <td t-if="this.withHandleColumn"/>
 <td t-att-colspan="this.withHandleColumn ? this.nbCols - 1 : this.nbCols"
 class="o_field_x2many_list_row_add"
 t-on-keydown="(ev) => this.onCellKeydown(ev, null)"
 >
 <t t-foreach="this.controls" t-as="control" t-key="control_index">
 <a
 t-if="control.type === 'create' and !this.evalColumnInvisible(control.invisible)"
 href="#"
 role="button"
 t-att-class="`${control_index !== 0 ? 'ml16' : ''} ${control.class or ''}`.trim()"
 t-att-tabindex="this.props.list.editedRecord ? '-1' : '0'"
 t-on-click.stop.prevent="() => this.add({ context: control.context })"
 >
 <t t-out="control.string"/>
 </a>
 <ViewButton
 t-if="control.type === 'button' and !this.evalColumnInvisible(control.invisible)"
 className="`${control.className} ${control_index !== 0 ? 'ml16' : ''}`"
 clickParams="control.clickParams"
 icon="control.icon"
 record="this.props.list"
 string="control.string"
 title="control.title"
 tabindex="this.props.list.editedRecord ? '-1' : '0'"
 />
 </t>
 </td>
 </tr>
 </t>

 <t t-name="web.ListRenderer.GroupRow">
 <tr t-attf-class="{{group.count > 0 ? 'o_group_has_content' : ''}} o_group_header {{!group.isFolded ? 'o_group_open' : ''}} cursor-pointer {{ this.canResequenceRows and group_index > 0 ? 'o_row_draggable' : '' }}"
 t-att-data-group-id="group.id"
 t-att-data-row-index="this.gridState.findRowByGroupId(group.id)?.globalIndex"
 t-on-click="(ev) => this.onGroupHeaderClicked(ev, group)"
 >
 <th t-on-keydown="(ev) => this.onCellKeydown(ev, group)"
 tabindex="-1"
 t-attf-class="o_group_name fs-6 fw-bold {{!group.isFolded ? 'text-black' : 'text-body'}}"
 t-att-colspan="this.getGroupNameCellColSpan(group)">
 <div class="d-flex align-items-center">
 <span t-attf-class="o_group_caret fa-solid {{group.isFolded ? 'fa-caret-right' : 'fa-caret-down' }} me-1"
 t-attf-style="--o-list-group-level: {{this.getGroupLevel(group)}}"/>
 <t t-out="group.displayName"/> (<t t-out="group.count"/>)
 <div t-if="(this.groupByButtons[group.groupByField.name] and !group.isFolded and group.record.resId)" class="o_group_buttons">
 <t t-foreach="this.groupByButtons[group.groupByField.name]" t-as="button" t-key="button.id">
 <t t-if="!this.evalInvisible(button.invisible, group.record)">
 <t t-if="button.clickParams.type === 'edit'">
 <button t-att-title="button.title" class="btn" t-on-click.stop="() => this.editGroupRecord(group)" tabindex="-1">
 <i t-if="button.icon" t-att-class="'o_button_icon ' + (button.icon.startsWith('fa-solid') || button.icon.startsWith('fa-regular') || button.icon.startsWith('fa-brands') ? button.icon : 'fa-solid ' + button.icon)"/>
 </button>
 </t>
 <t t-else="">
 <ViewButton
 className="button.className"
 clickParams="button.clickParams"
 icon="button.icon"
 record="group.record"
 string="button.string"
 title="button.title"
 tabindex="'-1'"
 />
 </t>
 </t>
 </t>
 </div>
 <div t-if="this.showGroupPager(group)" t-on-click.stop="" class="ms-auto">
 <Pager t-props="this.getGroupPagerProps(group)"/>
 </div>
 </div>
 </th>
 <td t-on-keydown="(ev) => this.onCellKeydown(ev, group)" t-foreach="this.getAggregateColumns(group)" t-as="column" t-key="column.id" t-att-class="{'o_list_number': column.type === 'field'}">
 <t t-if="column.type === 'field'">
 <t t-set="groupAggregate" t-value="this.formatGroupAggregate(group, column)"/>
 <span class="fw-bold" t-att-data-tooltip="groupAggregate.help">
 <t t-out="groupAggregate.value"/>
 <sup
 t-if="groupAggregate.multiCurrency"
 class="p-1 fw-bolder text-info"
 t-on-mouseover.stop="(ev) => this.openMultiCurrencyPopover(ev, groupAggregate.rawValue, column.name)"
 t-on-touchstart.stop="(ev) => this.openMultiCurrencyPopover(ev, groupAggregate.rawValue, column.name)"
 >?</sup>
 </span>
 </t>
 </td>
 <t t-set="groupPagerColspan" t-value="this.getGroupPagerCellColspan(group)"/>
 <th t-on-keydown="(ev) => this.onCellKeydown(ev, group)" t-if="groupPagerColspan > 0" t-att-colspan="groupPagerColspan"/>
 <th class="p-0" t-on-keydown="(ev) => this.onCellKeydown(ev, group)">
 <GroupConfigMenu t-if="this.showGroupConfigMenu(group)" t-props="this.getGroupConfigMenuProps(group)"/>
 </th>
 </tr>
 </t>

 <t t-name="web.ListRenderer.RecordRow">
 <tr class="o_data_row"
 t-att-class="this.api.getRowClass(record)"
 t-att-data-id="record.id"
 t-att-data-group-id="groupId"
 t-att-data-row-index="this.props.rowIndex"
 t-on-click.capture="(ev) => this.api.onClickCapture(record, ev)"
 t-on-mouseover.capture="(ev) => this.api.ignoreEventInSelectionMode(ev)"
 t-on-mouseout.capture="(ev) => this.api.ignoreEventInSelectionMode(ev)"
 t-on-mouseenter.capture="(ev) => this.api.ignoreEventInSelectionMode(ev)"
 t-on-touchstart="(ev) => this.api.onRowTouchStart(record, ev)"
 t-on-touchend="() => this.api.onRowTouchEnd(record)"
 t-on-touchmove="() => this.api.onRowTouchMove(record)"
 t-on-touchcancel="() => this.api.onRowTouchMove(record)"
 >
 <td t-on-keydown="(ev) => this.api.onCellKeydown(ev, group, record)" t-if="this.hasSelectors" class="o_list_record_selector user-select-none" t-on-click.stop="() => this.api.toggleRecordSelection(record)" tabindex="-1">
 <CheckBox disabled="!_canSelectRecord" value="record.selected" onChange.alike="() => this.api.toggleRecordSelection(record)" />
 </td>
 <t t-foreach="this.api.getColumns(record)" t-as="column" t-key="column.id">
 <t t-if="column.type === 'field'">
 <t t-set="isInvisible" t-value="this.api.evalInvisible(column.invisible, record) or !(column.name in record.data)"/>
 <t t-set="formattedValue" t-value="!isInvisible and this.api.canUseFormatter(column, record) ? this.api.getFormattedValue(column, record) : undefined"/>
 <td t-on-keydown="(ev) => this.api.onCellKeydown(ev, group, record)"
 class="o_data_cell cursor-pointer"
 t-att-class="this.api.getCellClass(column, record)"
 t-att-name="column.name"
 t-att-colspan="column.colspan"
 t-att-data-col-index="this.gridState.getColIndexOfColumn(column)"
 t-att-data-tooltip="!isInvisible ? this.api.getCellTitle(column, record, formattedValue) : false"
 data-tooltip-delay="1000"
 t-custom-click="(ev, isMiddleClick) => api.onCellClicked(record, column, ev, isMiddleClick)"
 tabindex="-1">
 <t t-if="!isInvisible">
 <t t-if="formattedValue !== undefined" t-out="formattedValue"/>
 <Field t-else="" name="column.name" record="record" type="column.widget" class="this.api.getFieldClass(column)" fieldInfo="column" t-props="this.api.getFieldProps(record, column)"/>
 </t>
 </td>
 </t>
 <t t-if="column.type === 'button_group'">
 <td t-on-keydown="(ev) => this.api.onCellKeydown(ev, group, record)" class="o_data_cell w-print-0 p-print-0 cursor-pointer" t-att-class="this.api.getCellClass(column, record)" t-att-data-col-index="this.gridState.getColIndexOfColumn(column)" t-on-click="(ev) => this.api.onButtonCellClicked(record, column, ev)" tabindex="-1">
 <div class="d-flex flex-wrap gap-1">
 <t t-foreach="column.buttons" t-as="button" t-key="button.id">
 <ViewButton t-if="!this.api.evalInvisible(button.invisible, record)"
 className="button.className"
 clickParams="button.clickParams"
 defaultRank="button.defaultRank"
 disabled="button.disabled"
 icon="button.icon"
 record="record"
 string="button.string"
 title="button.title"
 tabindex="this.editedRecord ? '-1' : '0'"
 onClick="this.isX2Many and record.isNew ? this._displaySaveNotification : undefined"
 />
 </t>
 </div>
 </td>
 </t>
 <t t-if="column.type === 'widget'">
 <td class="o_data_cell" t-att-class="this.api.getCellClass(column, record)"
 t-att-data-col-index="this.gridState.getColIndexOfColumn(column)">
 <Widget t-props="column.props" record="record"/>
 </td>
 </t>
 </t>

 <t t-if="this.hasOpenFormViewColumn">
 <td class="o_list_record_open_form_view w-print-0 p-print-0 text-center"
 t-on-keydown="(ev) => this.api.onCellKeydown(ev, group, record)"
 t-custom-click.stop="(ev, newWindow) => props.onOpenFormView(record, { force: true, newWindow })"
 tabindex="-1"
 >
 <button class="btn btn-link align-top text-end"
 name="Open in form view"
 aria-label="Open in form view"
 tabindex="-1"
 >View</button>
 </td>
 </t>

 <t t-set="useUnlink" t-value="'unlink' in this.activeActions" />
 <t t-set="hasX2ManyAction" t-value="this.isX2Many and (useUnlink ? this.activeActions.unlink : this.activeActions.delete)" />
 <t t-if="this.displayOptionalFields or this.props.list.isGrouped or hasX2ManyAction">
 <t t-if="hasX2ManyAction">
 <t t-set="hasDeleteButton" t-value="this.api.displayDeleteIcon(record)"/>
 <td class="o_list_record_remove w-print-0 p-print-0 text-center"
 t-on-keydown="(ev) => this.api.onCellKeydown(ev, group, record)"
 t-on-click.stop="hasDeleteButton ? (ev) => this.api.onRemoveCellClicked(record, ev) : () => {}"
 tabindex="-1"
 >
 <button class="d-print-none"
 t-if="hasDeleteButton"
 t-att-class="{
 'fa-regular': !useUnlink and this.activeActions.delete,
 'fa-trash-can': !useUnlink and this.activeActions.delete,
 'fa-solid': useUnlink and this.activeActions.unlink,
 'fa-xmark': useUnlink and this.activeActions.unlink,
 }"
 name="delete"
 aria-label="Delete row"
 tabindex="-1"
 />
 </td>
 </t>
 <td t-else="" tabindex="-1" class="w-print-0 p-print-0"/>
 </t>
 </tr>
 </t>

 <t t-name="web.ListHeaderTooltip">
 <t t-out="field.label"/>
 <div t-if="field.help" class="mt-2" t-out="field.help"/>
 </t>

</templates>
