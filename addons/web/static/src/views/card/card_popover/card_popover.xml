<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.CardPopoverRenderer">
        <div t-if="this.templates[this.constructor.HEADER_ATTRIBUTE]"
            class="o_popover_header flex-shrink-0 d-flex justify-content-between p-3 fs-4 fw-bold border-bottom">
            <t t-call="{{ this.templates[this.constructor.HEADER_ATTRIBUTE] }}"
                t-call-context="this.renderingContext"/>
        </div>
        <div class="o_popover_body o_cw_body flex-grow-1 flex-shrink-1 overflow-y-auto p-3">
            <t t-call="web.CardRenderer"/>
        </div>
        <div class="o_popover_footer flex-shrink-0 d-flex gap-1 p-3 border-top">
            <t t-call-slot="defaultFooter"/>
            <t t-if="this.templates[this.constructor.FOOTER_ATTRIBUTE]">
                <t t-call="{{ this.templates[this.constructor.FOOTER_ATTRIBUTE] }}"
                    t-call-context="this.renderingContext"/>
            </t>
        </div>
    </t>

    <t t-name="web.CardPopover">
        <div t-att-class="this.props.rootClass">
            <div class="o_card_popover_close p-1 cursor-pointer d-flex justify-content-center position-absolute top-0 end-0"
                t-on-click.stop="this.props.close">
                <i class="oi" data-icon="close"></i>
            </div>
            <CardPopoverCard t-props="this.cardProps">
                <t t-set-slot="defaultFooter">
                    <t t-if="this.displayDefaultFooter" t-call-slot="footer"/>
                </t>
            </CardPopoverCard>
        </div>
    </t>

    <t t-name="web.CardPopover.DefaultFooterButtons">
        <button class="btn btn-sm btn-primary o_open_record_btn" t-on-click="(ev) => this.onFooterBtnClicked(() => this.props.openRecord(ev))">
            <t t-out="this.openRecordButtonLabel"/>
        </button>
    </t>

</templates>
