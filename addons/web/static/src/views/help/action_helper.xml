<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ActionHelper">
        <div class="o_view_nocontent" t-ref="this.rootRef">
            <div class="o_nocontent_help" t-att-class="this.helpArchInfo?.className">
                <t t-if="this.helpTemplate" t-call="{{ this.helpTemplate }}" t-call-context="this.renderingContext"/>
                <t t-elif="this.props.noContentHelp" t-out="this.props.noContentHelp"/>
                <t t-else="">
                    <p class="o_view_nocontent_empty_folder">No data to display</p>
                    <p>Try to add some records, or make sure that there is no active filter in the search bar.</p>
                </t>
            </div>    
        </div>
    </t>

</templates>
