<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="web.Dropzone">
    <div class="o-Dropzone position-fixed d-flex align-items-end justify-content-center pb-4"
        t-attf-class="{{ this.props.extraClass or '' }}"
        t-on-dragover.prevent=""
        t-on-drop="this.onDrop"
        t-ref="this.root"
    >
        <div class="o-Dropzone-hint d-flex flex-column align-items-center gap-1 px-5 py-3 text-center">
            <i class="oi oi-fw fs-1" data-icon="cloud_upload"/>
            <span t-out="this.hint()"/>
        </div>
    </div>
</t>

</templates>
