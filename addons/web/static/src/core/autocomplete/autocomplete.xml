<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.AutoComplete">
        <div class="o-autocomplete" t-ref="this.root" t-att-class="this.autoCompleteRootClass">
            <input
                type="text"
                t-att-id="this.props.id"
                class="o-autocomplete--input o_input pe-3 text-truncate"
                t-att-autocomplete="this.props.autocomplete"
                t-att-placeholder="this.props.placeholder"
                t-att-title="this.props.title"
                role="combobox"
                t-att-aria-expanded="this.displayOptions ? 'true' : 'false'"
                t-att-aria-controls="this.listId"
                aria-autocomplete="list"
                aria-haspopup="listbox"
                t-model.proxy="this.state.value"
                t-on-blur="this.onInputBlur"
                t-on-click="this.onInputClick"
                t-on-change="this.onInputChange"
                t-on-input="this.onInput"
                t-on-keydown="this.onInputKeydown"
                t-on-focus="this.onInputFocus"
                t-ref="this.inputRef"
            />
            <AutoCompleteDropdown t-if="this.props.dropdown"
                state="this.dropdownState"
                target="() => this.targetDropdown"
                menuRef="this.menuRef"
                menuClass="this.menuClass"
                position="this.props.menuPosition"
                manual="true"
                noClasses="true"
                bottomSheet="false"
                focusToggleOnClosed="false"
                navigationOptions="this.navigationOptions"
            >
                <t t-set-slot="content">
                    <t t-call="{{ this.constructor.listTemplate }}"/>
                </t>
            </AutoCompleteDropdown>
            <t t-else="" t-call="{{ this.constructor.listTemplate }}"/>
        </div>
    </t>

    <t t-name="web.AutoComplete.list">
        <ul t-att-id="this.listId" role="listbox" t-att-class="this.ulDropdownClass" t-ref="this.listRef" t-on-pointerdown="this.onListPointerDown" t-on-mousedown="this.onListMouseDown">
            <t t-foreach="this.sources" t-as="source" t-key="source.id">
                <li t-if="source.isLoading" class="o-autocomplete--dropdown-item ui-menu-item d-block">
                    <a t-attf-id="{{this.props.id or 'autocomplete'}}_{{source_index}}_loading" role="option" class="o_loading dropdown-item ui-menu-item-wrapper">
                        <i class="oi oi-spin" data-icon="autorenew" /> <t t-out="source.placeholder" />
                    </a>
                </li>
                <t t-else="" t-foreach="source.options" t-as="option" t-key="option.id">
                    <li class="o-autocomplete--dropdown-item ui-menu-item d-block" t-att-class="option.cssClass" t-on-click="() => this.onOptionSelected(option)">
                        <t t-tag="option.unselectable ? 'span' : 'a'"
                            t-attf-id="{{this.props.id or 'autocomplete'}}_{{source_index}}_{{option_index}}"
                            class="dropdown-item ui-menu-item-wrapper text-truncate"
                            t-att-class="{ 'o-navigable cursor-pointer': !option.unselectable }"
                            t-att-role="!option.unselectable and 'option'"
                            t-att-data-option-id="option.id"
                        >
                            <t t-call-slot="{{ source.optionSlot }}" label="option.label" data="option.data">
                                <t t-if="!option.labelTermOrder" t-out="option.label"/>
                                <t t-else="">
                                    <t t-foreach="option.labelTermOrder.labelBits" t-as="bit" t-key="bit.id">
                                        <t t-if="!option.labelTermOrder.searchTermIndexes.includes(bit.id)" t-out="bit.bit"/>
                                        <mark t-else="" class="o-autocomplete--mark" t-out="bit.bit"/>
                                    </t>
                                </t>
                            </t>
                        </t>
                    </li>
                </t>
            </t>
        </ul>
    </t>

</templates>
