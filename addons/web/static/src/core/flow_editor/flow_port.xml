<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.FlowPort">
        <div class="o_flow_editor_port position-absolute"
            t-att-class="{
                'o_flow_editor_port_input': this.props.port.direction === 'input',
                'o_flow_editor_port_output': this.props.port.direction === 'output',
                'o_flow_editor_port_connected': this.props.connected,
                'o_flow_editor_port_valid': this.props.validation === 'valid',
                'o_flow_editor_port_invalid': this.props.validation === 'invalid',
            }"
            t-att-style="this.style"
            t-att-title="this.props.port.label"
            t-att-data-node-id="this.props.nodeId"
            t-att-data-port-id="this.props.port.id"
            t-att-data-port-direction="this.props.port.direction"
            t-on-click="this.onClick"
            t-on-pointerdown="this.onPointerDown">
            <span t-if="this.props.port.direction === 'output' and this.props.port.label"
                class="o_flow_editor_port_label position-absolute">
                <t t-out="this.props.port.label"/>
            </span>
        </div>
    </t>

</templates>
