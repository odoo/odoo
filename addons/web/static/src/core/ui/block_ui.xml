<?xml version="1.0"?>
<templates>
<t t-name="web.BlockUI">
    <div>
        <!-- Read by screen readers as the messages change (see web.LoadingIndicator): the
             status region stays in this root, which is always there. -->
        <span class="visually-hidden" role="status">
            <t t-if="this.state.blockState === this.BLOCK_STATES.VISIBLY_BLOCKED"><t t-out="this.state.line1"/> <t t-out="this.state.line2"/></t>
        </span>
        <t t-if="this.state.blockState !== this.BLOCK_STATES.UNBLOCKED">
            <t t-set="visiblyBlocked" t-value="this.state.blockState === this.BLOCK_STATES.VISIBLY_BLOCKED"/>
            <div class="o_blockUI fixed-top d-flex justify-content-center align-items-center flex-column vh-100"
                    t-att-class="visiblyBlocked ? '' : 'o_blockUI_invisible'" aria-hidden="true">
                <t t-if="visiblyBlocked">
                    <div class="o_spinner mb-4">
                        <img src="/web/static/img/spin.svg" alt="Loading..."/>
                    </div>
                    <div class="o_message text-center px-4">
                        <t t-out="this.state.line1"/><br/>
                        <t t-out="this.state.line2"/>
                    </div>
                </t>
            </div>
        </t>
    </div>
</t>
</templates>
