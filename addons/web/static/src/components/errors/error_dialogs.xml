<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.WarningDialog">
        <Dialog title="this.title" size="'xl'" contentClass="'o_error_dialog'">
            <div role="alert">
                <p t-out="this.message" class="text-prewrap"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o-default-button" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web.RedirectWarningDialog">
        <Dialog title="this.title" size="'xl'" contentClass="'o_error_dialog'">
            <div role="alert">
                <p t-out="this.message" class="text-prewrap"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.onClick" t-out="this.buttonText"/>
                <button class="btn btn-secondary" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web.Error504Dialog">
        <Dialog title.translate="Request timeout" size="'xl'" contentClass="'o_error_dialog'">
            <div role="alert">
                <p class="text-prewrap">
                    The operation was interrupted. This usually means that the current operation is taking too much time.
                </p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o-default-button" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web.SessionExpiredDialog">
        <Dialog title.translate="Odoo Session Expired" size="'xl'" contentClass="'o_error_dialog'">
            <div role="alert">
                <p class="text-prewrap">
                    Your Odoo session expired. The current page is about to be refreshed.
                </p>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o-default-button" t-on-click="this.onClick">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="web.ErrorDialog">
        <Dialog title.translate="Oops!" size="'xl'" contentClass="'o_error_dialog'">
            <div role="alert">
                <p class="text-prewrap">
                    Something went wrong... If you really are stuck, share the report with your friendly support service
                </p>
                <button class="btn btn-link p-0" t-on-click="() => { this.state.showTraceback = !this.state.showTraceback }" t-out="this.state.showTraceback ? this.constructor.hideTracebackButtonText : this.constructor.showTracebackButtonText"/>
                <div t-if="this.state.showTraceback" class="bg-100 mb-0 clearfix mt-3 position-relative o_error_detail">
                    <CopyButton
                        className="'position-absolute bg-100'"
                        icon="'fa-solid fa-paste'"
                        successText="this.copiedText"
                        content="this.clipboardReport"
                    />
                    <div class="ps-3 pt-3">
                        <p class="m-0"><b t-out="this.title"/></p>
                        <code t-if="this.props.name" t-out="this.props.name"></code>
                        <p class="m-0" t-if="this.props.message" t-out="this.props.message"></p>
                        <p class="m-0" t-out="this.contextDetails"/>
                        <pre class="m-0 p-0 mt-2" t-out="this.traceback"/>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o-default-button" t-on-click="this.props.close">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
