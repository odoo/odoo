<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.RecordSelector" >
        <div class="o_input d-flex flex-wrap gap-1 o_record_selector">
            <span t-if="this.hasAvatarImg" class="o_avatar o_m2o_avatar">
                <img class="rounded" t-att-src="this.avatarUrl" alt=""/>
            </span>
            <RecordAutocomplete
                resModel="this.props.resModel"
                value="this.displayName"
                domain="this.props.domain"
                context="this.props.context"
                className="'h-100 flex-grow-1'"
                fieldString="this.props.fieldString"
                placeholder="this.props.placeholder"
                multiSelect="false"
                getIds="() => []"
                update.bind="this.update"
            />
            <span class="o_dropdown_button"/>
        </div>
    </t>

</templates>
