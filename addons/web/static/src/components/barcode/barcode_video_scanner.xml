<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.BarcodeVideoScanner">
        <CropOverlay onResize.bind="this.onResize" isReady="this.state.isReady">
            <video t-ref="videoPreview" muted="true" autoplay="true" playsinline="true" t-att-class="this.props.cssClass"/>
            <input t-if="this.state.zoom" type="range" class="align-self-end m-5 z-1"
                   t-att-min="this.state.zoom.min" t-att-max="this.state.zoom.max" t-att-step="this.state.zoom.step"
                   t-att-value="this.state.zoom.value" t-on-input="this.onZoomInput"/>
        </CropOverlay>
    </t>
</templates>
