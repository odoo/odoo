<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.SignalListRenderer">
        <div class="o_list_renderer o_renderer table-responsive">
            <table class="o_list_table table table-sm table-hover table-striped mb-0">
                <thead>
                    <tr>
                        <th t-foreach="this.props.columns" t-as="column" t-key="column_index"
                            t-att-data-name="column.name"
                            t-out="column.string"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="this.props.records" t-as="record" t-key="record.id"
                        class="o_data_row cursor-pointer"
                        t-on-click="() => this.props.openRecord(record)">
                        <td t-foreach="this.props.columns" t-as="column" t-key="column_index"
                            class="o_data_cell"
                            t-att-name="column.name"
                            t-out="this.displayValue(record, column)"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

</templates>
