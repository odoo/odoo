<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <t t-name="web.ConfirmationDialog">
    <Dialog size="'md'" title="props.title" modalRef="modalRef">
      <p t-out="props.body" class="text-prewrap"/>
      <t t-set-slot="footer">
        <button type="button" class="btn" t-att-class="props.confirmClass" t-att-disabled="state.isProcess" t-on-click="confirm" t-out="props.confirmLabel" data-hotkey="q"/>
        <button type="button" t-if="props.cancel" class="btn btn-secondary" t-att-disabled="state.isProcess" t-on-click="cancel" t-out="props.cancelLabel" data-hotkey="x"/>
      </t>
    </Dialog>
  </t>

  <t t-name="web.AlertDialog" t-inherit="web.ConfirmationDialog" t-inherit-mode="primary">
    <xpath expr="//Dialog" position="attributes">
      <attribute name="size">'sm'</attribute>
      <attribute name="contentClass">props.contentClass</attribute>
    </xpath>
  </t>

</templates>
