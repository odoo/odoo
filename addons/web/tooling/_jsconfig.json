{
    "compilerOptions": {
        "module": "preserve",
        "target": "ES2022",
        "noEmit": true,
        "disableSizeLimit": true,
        "typeRoots": [
            "*/static/src/@types",
            "addons/mail/static/src/js/tooling/types",
            "addons/web/tooling/types"
        ]
    },
    "include": ["**/*.js", "**/*.ts"],
    "exclude": [
        "node_modules",
        "setup",
        "doc",
        "**/lib/ace",
        "**/lib/bootstrap",
        "**/lib/Chart",
        "**/lib/chartjs-adapter-luxon",
        "**/lib/fullcalendar",
        "**/lib/luxon",
        "**/lib/odoo_ui_icons",
        "**/lib/owl",
        "**/lib/pdfjs",
        "**/lib/popper",
        "**/lib/signature_pad",
        "**/lib/stacktracejs",
        "**/lib/zxing-library",
        "**/l10n*",
        "addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js"
    ]
}
