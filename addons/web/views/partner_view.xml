<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_kanban_view" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}" />
            </xpath>
        </field>
    </record>

    <record id="download_contact" model="ir.actions.server">
        <field name="name">Download (vCard)</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="binding_model_id" ref="model_res_partner" />
        <field name="binding_view_types">form,list,kanban</field>
        <field name="binding_icon">fa-solid fa-download</field>
        <field name="state">code</field>
        <field
            name="code">action = {
    'type': 'ir.actions.act_url',
    'url': '/web/partner/vcard?partner_ids=' + ','.join(map(str, records.ids)),
    'target': 'download',
}</field>
    </record>

</odoo>
