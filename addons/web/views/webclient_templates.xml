<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="web.conditional_assets_tests" name="Tests Assets Bundle">
        <t t-if="'tests' in debug or test_mode_enabled">
            <t t-call-assets="web.assets_tests" defer_load="True" />
        </t>
    </template>

    <template id="web.layout" name="Web layout">
 &lt;!DOCTYPE html&gt; <html t-att="html_data or {}">
            <head>
                <meta charset="utf-8" />
                <meta name="chrome" content="nointentdetection" />
                <title t-out="title or 'Odoo'" />
                <link rel="icon" t-att-href="x_icon or '/web/static/img/favicon.ico'" />
                <script id="web.layout.odooscript">
window.odoo = {csrf_token: "<t t-out="request.csrf_token(None)" />",debug: "<t t-out="debug" />",};
                </script>
                <t t-out="head or ''" />
            </head>
            <body t-att-class="body_classname">
                <t t-out="0" />
            </body>
        </html>
    </template>

    <template
        id="web.frontend_layout"
        name="Frontend Layout"
        inherit_id="web.layout"
        primary="True">
        <xpath expr="//head/meta[last()]" position="after">
            <meta name="viewport" content="width=device-width, initial-scale=1" />
        </xpath>
        <xpath expr="//head/link[last()]" position="after">
            <t t-call-assets="web.assets_frontend" t-js="false" />
        </xpath>
        <!-- the public app flips it to "true" once its interactions run; until
            then a page whose DOM is parsed but whose scripts have not run must
            not read as ready to a tour or to the website preview -->
        <xpath expr="//body" position="attributes">
            <attribute name="is-ready">false</attribute>
        </xpath>
        <xpath expr="//head/script[@id='web.layout.odooscript']" position="after">
            <script> odoo.__session_info__ = <t t-out="json.dumps(request.env['ir.http'].get_frontend_session_info())" />;
                if (!/(^|;\s)tz=/.test(document.cookie)) {
                    const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
                    document.cookie = `tz=${userTZ}; path=/; SameSite=Lax`;
                }
            </script>
            <t
                t-call-assets="web.assets_frontend_lazy"
                t-css="false"
                defer_load="True" />
            <t
                t-call-assets="web.assets_frontend_minimal"
                t-css="false"
                defer_load="True" />
            <t t-call="web.conditional_assets_tests" ignore_missing_deps="True" />
        </xpath>
        <xpath expr="//t[@t-out='0']" position="replace">
            <div id="wrapwrap" t-attf-class="#{pageName or ''}">
                <header t-if="not no_header" id="top" data-anchor="true">
                    <img
                        class="img-responsive d-block mx-auto"
                        src="/web/binary/company_logo"
                        alt="Logo" />
                </header>
                <main>
                    <t t-out="0" />
                </main>
                <footer
                    t-if="not no_footer"
                    id="bottom"
                    data-anchor="true"
                    t-attf-class="bg-light o_footer">
                    <div id="footer" />
                    <div t-if="not no_copyright" class="o_footer_copyright">
                        <div class="container py-3">
                            <div class="row row-gap-2">
                                <div
                                    class="col-sm text-center text-sm-start text-muted">
                                    <span class="o_footer_copyright_name me-2">Copyright &amp;copy; <span t-field="res_company.name" itemprop="name">Company name</span></span>
                                </div>
                                <div class="col-sm text-center text-sm-end">
                                    <t t-call="web.brand_promotion" />
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>

    <template id="web.brand_promotion_message" name="Brand Promotion Message">
        <t t-set="odoo_logo">
            <a
                target="_blank"
                rel="noopener noreferrer"
                t-attf-href="https://www.odoo.com?utm_source=db&amp;utm_medium=#{_utm_medium}"
                class="badge text-bg-light">
                <img
                    alt="Odoo"
                    src="/web/static/img/odoo_logo_tiny.png"
                    width="62"
                    height="20"
                    style="width: auto; height: 1em; vertical-align: baseline;" />
            </a>
        </t>
        Powered by <t t-out="odoo_logo" /><t t-if="_message"> - <t t-out="_message" /></t>
    </template>

    <template id="web.brand_promotion" name="Brand Promotion">
        <div class="o_brand_promotion">
            <t t-call="web.brand_promotion_message">
                <t t-set="_message" />
                <t t-set="_utm_medium" t-valuef="portal" />
            </t>
        </div>
    </template>

    <template id="web.login_layout" name="Login Layout">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
            <t t-set="body_classname" t-value="'o_home_menu_background'" />
            <t t-set="login_card_classes" t-value="'rounded-0 shadow-sm bg-white'" />
            <t t-set="no_header" t-value="True" />
            <t t-set="no_footer" t-value="True" />
            <div class="container py-5">
                <div
                    t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list"
                    style="max-width: 300px;">
                    <div class="card-body">
                        <div class="text-center pb-3 border-bottom mb-4">
                            <img
                                t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                                alt="Logo"
                                style="max-height:120px; max-width: 100%; width:auto" />
                        </div>
                        <t t-out="0" />
                        <div
                            class="text-center small mt-4 pt-3 border-top"
                            t-if="not disable_footer">
                            <t t-if="not disable_database_manager">
                                <a class="border-end pe-2 me-1" href="/web/database/manager">Manage
                                    Databases</a>
                            </t>
                            <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank" rel="noopener noreferrer">Powered by <span>Odoo</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="web.login" name="Login">
        <t t-call="web.login_layout">
            <div class="oe_structure" id="oe_structure_login_top" />
            <owl-component t-if="not login" name="web.user_switch" />
            <form
                class="oe_login_form"
                role="form"
                action="/web/login"
                method="post"
                onsubmit="this.action = '/web/login' + location.hash"
                data-captcha="login">
                <input
                    type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()" />
                <div class="mb-3" t-if="databases and len(databases) &gt; 1">
                    <label for="db" class="col-form-label">Database</label>
                    <div class="input-group">
                        <input
                            type="text"
                            name="db"
                            t-att-value="request.db"
                            id="db"
                            class="form-control"
                            required="required"
                            readonly="readonly" />
                        <a role="button" href="/web/database/selector" class="btn border border-start-0">Select <i class="fa-solid fa-database" role="img" aria-label="Database" title="Database" /></a>
                    </div>
                </div>
                <div class="mb-3 field-login">
                    <label for="login" class="form-label d-flex justify-content-between">Email</label>
                    <input
                        type="text"
                        placeholder="Enter your email"
                        name="login"
                        t-att-value="login"
                        id="login"
                        class="form-control"
                        required="required"
                        autocapitalize="off"
                        autocomplete="username" />
                </div>
                <div class="o_caps_lock_warning">
                    <div class="d-flex justify-content-between align-items-start">
                        <label for="password" class="form-label">Password</label>
                    </div>
                    <div class="input-group mb-1">
                        <input
                            type="password"
                            placeholder="Enter your password"
                            name="password"
                            id="password"
                            class="form-control"
                            required="required"
                            autocomplete="current-password"
                            t-att-autofocus="'autofocus' if login else None"
                            maxlength="4096" />
                        <button
                            type="button"
                            class="btn btn-sm border border-start-0 o_show_password"
                            aria-label="Show password">
                            <i class="fa-regular fa-eye" role="presentation" />
                        </button>
                    </div>
                </div>
                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-out="error" />
                </p>
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-out="message" />
                </p>
                <div class="oe_login_buttons text-center d-grid mb-1 pt-3">
                    <button type="submit" class="btn btn-primary">Log in</button>
                    <t t-if="debug">
                        <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">Log in as superuser</button>
                    </t>
                    <t t-call="web.login_oauth" />
                </div>
                <input type="hidden" name="type" value="password" />
                <input type="hidden" name="redirect" t-att-value="redirect" />
            </form>
            <div class="oe_structure" id="oe_structure_login_bottom" />
        </t>
    </template>

    <template id="web.login_successful" name="Login successful">
        <t t-call="web.login_layout">
            <div class="oe_login_form">
                <p>
                    You are logged in.
                </p>
                <div class="clearfix oe_login_buttons text-center mb-1 pt-3">
                    <a class="btn btn-primary w-100" href="/web/session/logout">Log out</a>
                </div>
            </div>
        </t>
    </template>

    <template id="web.login_oauth" name="Login OAuth">
        <t t-set="auth_btns" t-value="[]" />
        <div t-if="auth_btns" class="o_login_auth">
            <em class="d-block my-3 small text-center text-muted">- or -</em>
            <div class="list-group">
                <a
                    t-foreach="auth_btns"
                    t-as="p"
                    t-attf-class="{{p.get('list_item_class')}} list-group-item list-group-item-action d-flex align-items-center gap-2 py-2"
                    t-att-href="p.get('auth_link') or '#'">
                    <i t-att-class="p.get('css_class', '')" role="presentation" />
                    <span class="mx-auto" t-out="p.get('body', '')" />
                </a>
            </div>
        </div>
    </template>

    <template id="web.unit_tests_suite">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
            <t t-set="title">Web Unit Tests</t>
            <t t-set="head">
                <meta
                    name="viewport"
                    content="width=device-width, initial-scale=1, user-scalable=no" />
                <script> odoo.__session_info__ = <t t-out="json.dumps(session_info)" />; </script>
                <t t-call-assets="web.assets_unit_tests_setup" />
                <t t-call-assets="web.assets_unit_tests" defer_load="True" />
            </t>
        </t>
    </template>

    <template id="web.webclient_bootstrap" name="Web Client Bootstrap">
        <t t-call="web.layout">
            <t
                t-set="html_data"
                t-value="{} if color_scheme_preference == 'system'                         else {'data-color-scheme': color_scheme}" />
            <t t-set="head_web">
                <meta
                    name="viewport"
                    content="width=device-width, initial-scale=1, user-scalable=no" />
                <meta
                    name="theme-color"
                    t-att-content="'#242733' if color_scheme == 'dark' else '#714B67'" />
                <link
                    rel="manifest"
                    href="/web/manifest.webmanifest"
                    crossorigin="use-credentials" />
                <link rel="apple-touch-icon" href="/web/static/img/odoo-icon-ios.png" />
                <script> // Block to avoid leaking variables in the script scope
                    {
                        odoo.__session_info__ = <t t-out="json.dumps(session_info)" />;
                        const { user_context, registry_hash, menus_cache_version, translationURL } = odoo.__session_info__;
                        const lang = new URLSearchParams(document.location.search).get("lang");
                        let menuURL = "/web/webclient/load_menus";
                        if (lang) {
                            user_context.lang = lang;
                            menuURL += `?lang=${lang}`;
                        }
                        // Conditional menus preload: pass the hash of the localStorage
                        // copy (persisted by menu_service) so the server can answer an
                        // empty 304 instead of the full payload (base64 icons included)
                        // when nothing changed. Resolves to `{ menus, hash }`, or
                        // `null` when the cached copy is confirmed up-to-date (304).
                        odoo.reloadMenus = (menusHash) =&gt; {
                            let url = menuURL;
                            if (menusHash) {
                                url += (url.includes("?") ? "&amp;" : "?") + `hash=${encodeURIComponent(menusHash)}`;
                            }
                            return fetch(url, { cache: "no-store" }).then((res) =&gt; {
                                if (res.status === 304) {
                                    return null;
                                }
                                if (!res.ok) {
                                    throw new Error("Error while fetching menus");
                                }
                                return res.json().then((menus) =&gt; ({
                                    menus,
                                    hash: res.headers.get("X-Menus-Hash") || undefined,
                                }));
                            });
                        };
                        let storedMenusHash;
                        try {
                            // Only revalidate by hash when a menus copy for this cache
                            // version exists. `menus_cache_version` is composed server
                            // side precisely so this check and menu_storage.js compare
                            // the same string; do not recompose it here.
                            if (localStorage.getItem("webclient_menus_version") === menus_cache_version
                                &amp;&amp; localStorage.getItem("webclient_menus")) {
                                storedMenusHash = localStorage.getItem("webclient_menus_hash") || undefined;
                            }
                        } catch (e) { /* localStorage unavailable: plain full fetch */ }
                        odoo.loadMenusPromise = odoo.reloadMenus(storedMenusHash);

                        // Translations preload — cold boot only. localization_service
                        // mirrors its IndexedDB translations cache with a synchronous
                        // localStorage marker ("webclient_translations_version" =
                        // `${registry_hash}/${lang}`). Marker present and matching →
                        // the IndexedDB read will hit, no early fetch needed (the
                        // service still revalidates in the background with ?hash=).
                        // Marker absent/stale (first visit, deploy that bumped
                        // registry_hash, language change) → start the fetch at parse
                        // time so it overlaps with asset download/eval instead of
                        // starting after them. localization_service adopts the
                        // promise only when its own URL matches odoo.loadTranslationsURL.
                        const transLang = user_context.lang || "";
                        let translationsCached = false;
                        try {
                            translationsCached = localStorage.getItem("webclient_translations_version") === `${registry_hash}/${transLang}`;
                        } catch (e) { /* localStorage unavailable: preload anyway */ }
                        if (!translationsCached) {
                            const transBase = translationURL || "/web/webclient/translations";
                            // Must match the URL built by localization_service
                            // (objectToUrlEncodedString keeps the empty hash key).
                            odoo.loadTranslationsURL = `${transBase}?hash=&amp;lang=${encodeURIComponent(transLang)}`;
                            odoo.loadTranslationsPromise = fetch(odoo.loadTranslationsURL, { cache: "no-store" });
                        }
                    }
                </script>
                <t t-if="color_scheme_preference == 'system'">
                    <script id="web.layout.colorscheme">
                        {
                            const resolved = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                            document.cookie = `color_scheme=${resolved}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax`;
                            document.documentElement.dataset.colorScheme = resolved;
                        }
                    </script>
                </t>
                <t t-call-assets="web.assets_web_print" media="print" t-js="false" />
                <t t-call-assets="web.assets_web" t-css="false" />

                <t t-if="color_scheme_preference == 'system'">
                    <t
                        t-call-assets="web.assets_web"
                        media="screen and (prefers-color-scheme: light)"
                        t-js="false" />
                    <t
                        t-call-assets="web.assets_web_dark"
                        media="screen and (prefers-color-scheme: dark)"
                        t-js="false" />
                </t>
                <t t-elif="color_scheme == 'dark'">
                    <t
                        t-call-assets="web.assets_web_dark"
                        media="screen"
                        t-js="false" />
                </t>
                <t t-else="">
                    <t t-call-assets="web.assets_web" media="screen" t-js="false" />
                </t>
                <t t-call="web.conditional_assets_tests" media="screen" />
            </t>
            <t t-set="head" t-value="head_web + (head or '')" />
            <t
                t-set="body_classname"
                t-value="'o_web_client' + (' o-density-' + content_density if content_density and content_density != 'default' else '')" />
        </t>
    </template>

    <template id="web.webclient_offline">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
            <t t-set="title">Offline</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <script>
                    window.addEventListener('online', () =&gt; location.reload());
                </script>
                <style>
                    body {
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, "Noto Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
                        padding: 0;
                        margin: 0;
                        background-color: #fff;
                        color: rgb(17, 24, 39);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        text-align: center;
                        height: 100vh;
                        width: 100vw;
                        user-select: none;
                    }
                    .card {
                        width: 80%;
                        max-width: 500px;
                    }
                    .card img {
                        width: 96px;
                        height: auto;
                        filter: grayscale(.6);
                    }
                    .card button {
                        background-color: #6C5CE7;
                        color: #FFFFFF;
                        border: 1px solid #6C5CE7;
                        border-radius: .25rem;
                        padding: .5rem 1rem;
                        cursor: pointer;
                        font-size: 1.2rem;
                        font-weight: 500;
                    }
                    @media (prefers-color-scheme: dark) {
                        body { background-color: #262A36; color: #FFFFFF; }
                    }
                </style>
            </t>
            <div class="card">
                <img t-attf-src="data:image/png;base64,{{odoo_icon}}" alt="Odoo logo" />
                <h1>You are offline</h1>
                <p>Check your network connection and come back here. Odoo will load as soon as
                    you're back online.</p>
                <button type="button" onclick="location.reload()">Check again</button>
            </div>
        </t>
    </template>

    <template id="web.webclient_scoped_app" name="Scoped App">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
            <t t-set="title" t-value="f'Install {app_name}'" />
            <t t-set="x_icon" t-value="f'/scoped_app_icon_png?app_id={app_id}'" />
            <t t-set="head">
                <t t-call-assets="web.assets_frontend_minimal" />
                <t t-call-assets="web.assets_frontend_lazy" />
                <link rel="apple-touch-icon" t-att-href="x_icon" />
                <link
                    rel="manifest"
                    t-att-href="safe_manifest_url"
                    crossorigin="use-credentials" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
            </t>
            <owl-component name="web.install_scoped_app" />
        </t>
    </template>

</odoo>
