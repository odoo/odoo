<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        A scorecard names the company whose subjects it measures, or none for a
        scale every company shares. This is about who may *see* a scorecard; the
        one that applies to a subject is resolved by scorecard._for, as superuser.
    -->
    <record id="rule_scorecard_company" model="ir.rule">
        <field name="name">scorecard: multi-company</field>
        <field name="model_id" ref="model_scorecard" />
        <field name="global" eval="True" />
        <field
            name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
