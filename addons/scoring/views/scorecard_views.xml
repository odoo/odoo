<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="scorecard_view_search" model="ir.ui.view">
        <field name="name">scorecard.search</field>
        <field name="model">scorecard</field>
        <field name="arch" type="xml">
            <search string="Search Scorecards">
                <field name="name" />
                <field name="res_model" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="model"
                        string="Scored Model"
                        context="{'group_by': 'res_model'}" />
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by': 'company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="scorecard_view_list" model="ir.ui.view">
        <field name="name">scorecard.list</field>
        <field name="model">scorecard</field>
        <field name="arch" type="xml">
            <list string="Scorecards">
                <field name="name" />
                <field name="res_model" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="max_points" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="scorecard_view_form" model="ir.ui.view">
        <field name="name">scorecard.form</field>
        <field name="model">scorecard</field>
        <field name="arch" type="xml">
            <form string="Scorecard">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Scorecard Name" />
                        </h1>
                    </div>
                    <group>
                        <group name="scope">
                            <field name="res_model" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                        <group name="totals">
                            <field name="max_points" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page name="dimensions" string="Dimensions">
                            <field
                                name="dimension_ids"
                                context="{'default_res_model': res_model}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="kind" />
                                    <field name="catalog_model" column_invisible="1" />
                                    <field name="weight" />
                                    <field name="missing" />
                                    <field name="precision" optional="hide" />
                                    <field name="max_points" />
                                    <field name="active" />
                                </list>
                                <form string="Dimension">
                                    <group>
                                        <group>
                                            <field name="code" />
                                            <field name="name" />
                                            <field name="kind" />
                                            <field
                                                name="catalog_model"
                                                invisible="kind != 'catalog'" />
                                        </group>
                                        <group>
                                            <field
                                                name="weight"
                                                invisible="kind != 'measure'" />
                                            <field name="missing" />
                                            <field
                                                name="precision"
                                                invisible="kind != 'measure'" />
                                            <field name="max_points" />
                                            <field name="active" />
                                        </group>
                                    </group>
                                    <field
                                        name="band_ids"
                                        invisible="kind != 'measure'">
                                        <list editable="bottom">
                                            <field name="min_value" />
                                            <field name="max_value" />
                                            <field name="points" />
                                            <field name="active" />
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="scorecard_action" model="ir.actions.act_window">
        <field name="name">Scorecards</field>
        <field name="res_model">scorecard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="scorecard_view_search" />
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a scorecard
            </p>
            <p>
                A scorecard says what a model's records are scored on, what each
                dimension weighs and where its bands lie.
            </p>
        </field>
    </record>

</odoo>
