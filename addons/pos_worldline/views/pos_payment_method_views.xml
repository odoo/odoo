<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_worldline" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.worldline</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'worldline_api'">
                    <page name="settings" string="Worldline">
                        <group invisible="payment_provider != 'worldline_api'">
                            <group>
                                <field name="worldline_merchant_id" required="payment_provider == 'worldline_api'"/>
                                <field name="worldline_api_key" password="True" required="payment_provider == 'worldline_api'"/>
                                <field name="worldline_test_mode"/>
                            </group>
                            <group>
                                <div class="d-flex justify-content-end" colspan="2" groups="point_of_sale.group_pos_manager">
                                    <button name="action_worldline_connect_terminal" type="object" string="Connect Terminal" class="btn-primary text-nowrap" invisible="not (worldline_merchant_id and worldline_api_key)"/>
                                    <button name="action_worldline_test" type="object" string="Test" class="btn-secondary text-nowrap ms-2" invisible="not (worldline_merchant_id and worldline_terminal_id and worldline_api_key)"/>
                                </div>
                                <field name="worldline_terminal_id" placeholder="Use 'Connect Terminal' button to find one"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
