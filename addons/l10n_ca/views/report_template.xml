<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pst_external_layout">
        <li t-if="company.account_fiscal_country_id.code == 'CA' and company.l10n_ca_pst">
            <t t-if="'TQ' in company.l10n_ca_pst.upper()">QST: <span t-field="company.l10n_ca_pst"/></t>
            <t t-else="">PST: <span t-field="company.l10n_ca_pst"/></t>
        </li>
    </template>

    <template id="l10n_ca_external_layout_standard" inherit_id="web.company_address_list">
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <t t-call="l10n_ca.pst_external_layout"/>
        </xpath>
    </template>
</odoo>
