<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="before">
                <t t-set="jp_recipient_partner" t-value="doc.partner_id"/>
            </xpath>

            <xpath expr="//div[@t-field='doc.partner_id']" position="attributes">
                <attribute name="t-options">{"widget": "contact", "fields": ["address"], "no_marker": True}</attribute>
            </xpath>

            <xpath expr="//th[@name='th_priceunit']" position="replace">
                <t t-set="jp_currency_label" t-value="doc.currency_id.name if doc.currency_id.name != 'JPY' else '円'"/>
                <th name="th_priceunit" class="text-end text-nowrap" t-if="company.external_report_layout_id.key == 'l10n_jp.external_layout_jp_standard'">
                    <span t-out="'Unit Price (%s)' % jp_currency_label"/>
                </th>
                <th name="th_priceunit" class="text-end text-nowrap" t-else="">
                    Unit Price
                </th>
            </xpath>

            <xpath expr="//th[@name='th_subtotal']/span" position="replace">
                <span t-if="company.external_report_layout_id.key == 'l10n_jp.external_layout_jp_standard'" t-out="'Amount (%s)' % jp_currency_label"/>
                <span t-else="">Amount</span>
            </xpath>
        </template>
    </data>
</odoo>
