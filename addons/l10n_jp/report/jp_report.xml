<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="external_layout_jp_standard">
            <t t-set="jp_recipient_partner" t-value="jp_recipient_partner or (o and 'partner_id' in o and o.partner_id) or False"/>
            <t t-set="jp_recipient_lang" t-value="(jp_recipient_partner and jp_recipient_partner.lang) or company.partner_id.lang or ''"/>
            <t t-set="jp_honorific" t-value="jp_recipient_lang.startswith('ja') and (' 御中' if jp_recipient_partner and jp_recipient_partner.is_company else ' 様') or ''"/>
            <t t-set="jp_document_date"
               t-value="(o and 'invoice_date' in o and o.invoice_date) or (o and 'date_order' in o and o.date_order) or (o and 'date' in o and o.date) or (o and 'scheduled_date' in o and o.scheduled_date) or False"/>

            <t t-call="web.external_layout_body" hide_recipient_address="True" hide_title="True">
                <div class="o_jp_standard_header">
                    <div class="text-end text-muted" t-if="jp_document_date">
                        <span t-out="jp_document_date" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="text-center mb-4">
                        <h2 class="mb-0" t-if="layout_document_title" t-out="layout_document_title"/>
                    </div>
                    <div class="row">
                        <div class="col-6 pe-4">
                            <div class="fw-bold mb-3" t-if="jp_recipient_partner and jp_recipient_partner.name">
                                <span t-out="jp_recipient_partner.name"/><span t-out="jp_honorific"/>
                            </div>
                            <div t-out="address or jp_recipient_partner.address"/>
                        </div>
                    </div>
                    <div class="text-end mt-4">
                        <img t-if="company.logo" class="o_company_logo_big mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                        <t t-call="web.company_address_list"/>
                    </div>
                </div>
                <div class="mb-3" t-if="information_block" t-out="information_block"/>
                <t t-out="0"/>
            </t>

            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <t t-call="web.external_layout_footer_content" footer_content_classes="'border-top pt-2'"/>
            </div>
        </template>

        <template id="report_invoice_wizard_preview" inherit_id="web.report_invoice_wizard_preview">
            <xpath expr="//t[@t-set='address']" position="before">
                <t t-set="jp_preview_currency" t-value="company._name == 'base.document.layout' and company.company_id.currency_id"/>
                <t t-set="jp_preview_currency_label"
                   t-value="' (%s)' % (jp_preview_currency.currency_unit_label if jp_preview_currency.name == 'JPY' else jp_preview_currency.name)
                            if jp_preview_currency
                            and company.external_report_layout_id.key == 'l10n_jp.external_layout_jp_standard'
                            and company.l10n_jp_currency_in_headers
                            else ''"/>
            </xpath>
            <xpath expr="//th[@name='th_priceunit']/span" position="inside">
                <t t-out="jp_preview_currency_label"/>
            </xpath>
            <xpath expr="//th[@name='th_subtotal']" position="attributes">
                <attribute name="t-att-class">'text-end text-nowrap' if jp_preview_currency_label else 'text-end'</attribute>
            </xpath>
            <xpath expr="//th[@name='th_subtotal']/span" position="inside">
                <t t-out="jp_preview_currency_label"/>
            </xpath>
        </template>

        <template id="document_tax_totals_template" inherit_id="account.document_tax_totals_template">
            <xpath expr="//t[@t-set='same_tax_base']" position="after">
                <t t-set="jp_layout_selected" t-value="company and company.external_report_layout_id.key == 'l10n_jp.external_layout_jp_standard'"/>
            </xpath>
            <xpath expr="//tr[hasclass('o_taxes')]" position="attributes">
                <attribute name="t-if">not jp_layout_selected</attribute>
            </xpath>
            <xpath expr="//tr[hasclass('o_taxes')]" position="after">
                <tr t-if="jp_layout_selected" class="o_taxes">
                    <td>
                        <span t-out="tax_group['group_name']">Tax 10%</span>
                        <span>Taxable Amount</span>
                        <t t-if="tax_group['display_base_amount_currency'] is not False">
                            <span class="text-nowrap"
                                  t-out="tax_group['display_base_amount_currency']"
                                  t-options='{"widget": "monetary", "display_currency": currency}'
                            >27.00</span>
                            <span>Tax</span>
                        </t>
                    </td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap"
                              t-out="tax_group['tax_amount_currency']"
                              t-options='{"widget": "monetary", "display_currency": currency}'
                        >2.70</span>
                    </td>
                </tr>
            </xpath>
        </template>
    </data>
</odoo>
