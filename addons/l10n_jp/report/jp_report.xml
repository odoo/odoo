<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="external_layout_jp_standard">
            <t t-set="jp_recipient_partner" t-value="jp_recipient_partner or (o and 'partner_id' in o and o.partner_id) or False"/>
            <t t-set="jp_recipient_lang" t-value="(jp_recipient_partner and jp_recipient_partner.lang) or company.partner_id.lang or ''"/>
            <t t-set="jp_honorific" t-value="jp_recipient_lang.startswith('ja') and (' 御中' if jp_recipient_partner and jp_recipient_partner.is_company else ' 様') or ''"/>
            <t t-set="jp_document_date"
               t-value="(o and 'invoice_date' in o and o.invoice_date) or (o and 'date_order' in o and o.date_order) or (o and 'date' in o and o.date) or (o and 'scheduled_date' in o and o.scheduled_date) or False"/>

            <t t-call="web.external_layout_body" hide_recipient_address="True" hide_title="True">
                <div class="o_jp_standard_header">
                    <div class="text-end text-muted" t-if="jp_document_date">
                        <span t-out="jp_document_date" t-options='{"widget": "date"}'/>
                    </div>
                    <div class="text-center mb-4">
                        <h2 class="mb-0" t-if="layout_document_title" t-out="layout_document_title"/>
                    </div>
                    <div class="row">
                        <div class="col-6 pe-4">
                            <div class="fw-bold mb-3" t-if="jp_recipient_partner and jp_recipient_partner.name">
                                <span t-out="jp_recipient_partner.name"/><span t-out="jp_honorific"/>
                            </div>
                            <div t-out="address or jp_recipient_partner.address"/>
                        </div>
                    </div>
                    <div class="text-end mt-4">
                        <img t-if="company.logo" class="o_company_logo_big mb-2" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                        <t t-call="web.company_address_list"/>
                    </div>
                </div>
                <div class="mb-3" t-if="information_block" t-out="information_block"/>
                <t t-out="0"/>
            </t>

            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <t t-call="web.external_layout_footer_content" footer_content_classes="'border-top pt-2'"/>
            </div>
        </template>
    </data>
</odoo>
