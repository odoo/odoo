<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <!-- A whole price in a currency without decimals prints none, unless another price of its column needs them. -->
            <t t-set="jp_hide_zero_decimals" t-value="o.currency_id.decimal_places == 0 and all(line.price_unit.is_integer() for line in o._get_move_lines_to_report())"/>
            <t t-set="jp_document_date" t-value="o.invoice_date"/>
        </xpath>

        <!-- The recipient's name heads the address with its honorific, in each of the three shipping cases. -->
        <xpath expr="//t[@name='address_not_same_as_shipping']/address" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "jp_honorific": True}</attribute>
        </xpath>
        <xpath expr="//t[@name='address_same_as_shipping']/address" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "jp_honorific": True}</attribute>
        </xpath>
        <xpath expr="//t[@name='no_shipping']/address" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "jp_honorific": True}</attribute>
        </xpath>

        <xpath expr="//td[@name='td_price_unit']/span" position="attributes">
            <attribute name="t-options">{'min_precision': 0} if jp_hide_zero_decimals else {}</attribute>
        </xpath>
    </template>

    <!-- Workaround for Studio reports, see odoo/odoo#60660 -->
    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'l10n_jp.report_invoice_document'"
               t-call="l10n_jp.report_invoice_document"
               t-lang="lang"/>
        </xpath>
    </template>
</odoo>
