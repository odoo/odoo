<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A Japanese address reads from the largest area to the smallest, so the
         country leads the line it shares with the prefecture and the city. -->
    <record id="base.jp" model="res.country">
        <field name="address_format" eval="'%(zip)s\n%(country_name)s %(state_name)s %(city)s\n%(street)s\n%(street2)s'"/>
    </record>
</odoo>
