<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ImportDataColumnError">
        <div>
            <t t-foreach="this.props.errors" t-as="error" t-key="error_index">
                <a t-if="error_index === 3" href="#" class="o_import_report_count" t-on-click="() => this.state.isExpanded = !this.state.isExpanded">
                    <i class="oi" t-attf-data-icon="{{this.state.isExpanded ? 'expand_less' : 'expand_more'}}"></i> <t t-out="this.props.errors.length - error_index"/> more
                </a>
                <div t-if="this.isErrorVisible(error_index)" t-attf-class="o_import_report {{ error_index > 0 ? 'border-top mt-2 pt-2' : '' }}">
                    <p class="mb-0" t-att-class="this.getMessageClass(error)" t-out="this.getErrorText(error)"/>
                    <ImportErrorResolution
                        error="error"
                        fieldInfo="this.props.fieldInfo"
                        onResolve="this.props.onErrorResolved"
                    />
                </div>
            </t>
        </div>
    </t>
</templates>
