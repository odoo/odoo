<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_demo_company_mc" model="res.partner" forcecreate="1">
        <field name="name">MC Company</field>
        <field name="vat">FR90000012345</field>
        <field name="street">Boulevard des Moulins</field>
        <field name="city">Monaco</field>
        <field name="country_id" ref="base.mc"/>
        <field name="zip">98000</field>
        <field name="phone">+377 6 12 34 56 78</field>
        <field name="email">info@company.mcexample.com</field>
        <field name="website">www.mcexample.com</field>
    </record>

    <record id="base.demo_company_mc" model="res.company" forcecreate="1">
        <field name="name">MC Company</field>
        <field name="partner_id" ref="base.partner_demo_company_mc"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('base.demo_company_mc')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('base.demo_company_mc'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>mc</value>
        <value model="res.company" eval="obj().env.ref('base.demo_company_mc')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
