<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- https://developers.payfast.co.za/docs#step_1_form_fields (payment_method options) -->

    <!-- === PRIMARY PAYMENT METHODS === -->

    <record id="payment_method_eft" model="payment.method">
        <field name="name">EFT</field>
        <field name="code">eft</field>
        <field name="provider_id" ref="payment.payment_provider_payfast"/>
        <field name="image" type="bytes" file="payment/static/img/bank.png"/>
        <field name="supported_country_ids" eval="[Command.set([ref('base.za')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.ZAR')])]"/>
    </record>

    <record id="payment_method_card" model="payment.method">
        <field name="name">Card</field>
        <field name="code">card</field>
        <field name="sequence">10</field>
        <field name="provider_id" ref="payment.payment_provider_payfast"/>
        <field name="image" type="bytes" file="payment/static/img/card.png"/>
        <field name="support_manual_capture">partial</field>
        <field name="support_refund">partial</field>
        <field name="support_tokenization">True</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.za')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.ZAR')])]"/>
    </record>

