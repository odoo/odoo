<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Payfast Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <field
                    string="Merchant ID"
                    name="payfast_merchant_id"
                    invisible="code != 'payfast'"
                    required="is_live"
                />
                <field
                    string="Merchant Key"
                    name="payfast_merchant_key"
                    invisible="code != 'payfast'"
                    required="is_live"
                    widget="password"
                />
                <field
                    string="Passphrase"
                    name="payfast_passphrase"
                    invisible="code != 'payfast'"
                    widget="password"
                    help="Required for Recurring Billing (subscriptions/tokenization). Set the
                          same value under Settings -> Recurring Billing on your Payfast (or
                          Sandbox) dashboard."
                />
            </group>
        </field>
    </record>

</odoo>
