#. module: website_crm_partner_assign
#: model:mail.template,body_html:website_crm_partner_assign.email_template_lead_forward_mail
msgid ""
"<t>\n"
"Hello,<br/>\n"
"We have been contacted by those prospects that are in your region. Thus, the "
"following leads have been assigned to <t t-out=\"ctx['partner_id'].name if "
"ctx.get('partner_id') else ''\"/>:<br/>\n"
"<ol>\n"
"    <li t-foreach=\"ctx.get('partner_leads', [])\" t-as=\"lead\"><a t-att-"
"href=\"lead['lead_link']\" t-out=\"lead['lead_id'].name or 'Subject "
"Undefined'\">Subject Undefined</a>, <t t-out=\"lead['lead_id'].partner_name "
"or lead['lead_id'].contact_name or 'Contact Name Undefined'\">Contact Name "
"Undefined</t>, <t t-out=\"lead['lead_id'].country_id and "
"lead['lead_id'].country_id.name or 'Country Undefined'\">Country Undefined</"
"t>, <t t-out=\"lead['lead_id'].email_from or 'Email Undefined' or ''\">Email "
"Undefined</t>, <t t-out=\"lead['lead_id'].phone or ''\">+1 650-123-4567</t> "
"</li><br/>\n"
"</ol>\n"
"<t t-if=\"ctx.get('partner_in_portal')\">\n"
"    Please connect to your <a t-att-href=\"'%s?db=%s' % "
"(object.get_base_url(), object.env.cr.dbname)\">Partner Portal</a> to get "
"details.\n"
"    <t t-if=\"any(lead['lead_id'].type == 'lead' for lead in "
"ctx['partner_leads'])\">On each lead, there are two buttons that you should "
"press after contacting the lead: \"I'm interested\" &amp; \"I'm not "
"interested\".</t><br/>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    You do not have yet a portal access to our database. Please contact\n"
"    <t t-out=\"ctx.get('partner_id') and ctx['partner_id'].user_id and "
"ctx['partner_id'].user_id.email and 'your account manager %s (%s)' % "
"(ctx['partner_id'].user_id.name,ctx['partner_id'].user_id.email) or "
"'us'\">us</t>.<br/>\n"
"</t>\n"
"The lead will be sent to another partner if you do not contact the lead "
"before 20 days.<br/><br/>\n"
"Thank you,<br/>\n"
"<t t-out=\"ctx.get('partner_id') and ctx['partner_id'].user_id and "
"ctx['partner_id'].user_id.signature or ''\"/>\n"
"<br/>\n"
"<t t-if=\"not ctx.get('partner_id') or not ctx['partner_id'].user_id\">\n"
"    PS: It looks like you do not have an account manager assigned to you, "
"please contact us.\n"
"</t>\n"
"            </t>"
msgstr ""
"<t>\n"
"ສະບາຍດີ,<br/>\n"
"ພວກເຮົາໄດ້ຮັບການຕິດຕໍ່ຈາກກຸ່ມເປົ້າໝາຍທີ່ຢູ່ໃນເຂດຂອງທ່ານ. ດັ່ງນັ້ນ, ເບາະແສຕໍ່ໄປນີ້ຈຶ່ງຖືກມອບໝາຍໃຫ້ກັບ <t "
"t-out=\"ctx['partner_id'].name if ctx.get('partner_id') else ''\"/>:<br/>\n"
"<ol>\n"
"    <li t-foreach=\"ctx.get('partner_leads', [])\" t-as=\"lead\"><a t-att-"
"href=\"lead['lead_link']\" t-out=\"lead['lead_id'].name or 'Subject "
"Undefined'\">ຫົວຂໍ້ບໍ່ໄດ້ກຳນົດ</a>, <t t-out=\"lead['lead_id'].partner_name or "
"lead['lead_id'].contact_name or 'Contact Name Undefined'\">ຊື່ຜູ້ຕິດຕໍ່ບໍ່ໄດ້ກຳນົດ</t>, "
"<t t-out=\"lead['lead_id'].country_id and lead['lead_id'].country_id.name or "
"'Country Undefined'\">ປະເທດບໍ່ໄດ້ກຳນົດ</t>, <t t-"
"out=\"lead['lead_id'].email_from or 'Email Undefined' or ''\">ອີເມວບໍ່ໄດ້ກຳນົດ</t>"
", <t t-out=\"lead['lead_id'].phone or ''\">+1 650-123-4567</t> </li><br/>\n"
"</ol>\n"
"<t t-if=\"ctx.get('partner_in_portal')\">\n"
"    ກະລຸນາເຂົ້າສູ່ລະບົບ <a t-att-href=\"'%s?db=%s' % (object.get_base_url(), "
"object.env.cr.dbname)\">ພອດທໍຄູ່ຄ້າ</a> ຂອງທ່ານເພື່ອເບິ່ງລາຍລະອຽດ.\n"
"    <t t-if=\"any(lead['lead_id'].type == 'lead' for lead in "
"ctx['partner_leads'])\">ໃນແຕ່ລະເບາະແສ ຈະມີສອງປຸ່ມທີ່ທ່ານຄວນກົດຫຼັງຈາກຕິດຕໍ່ເບາະແສແລ້ວ: \"ຂ້ອ"
"ຍສົນໃຈ\" &amp; \"ຂ້ອຍບໍ່ສົນໃຈ\".</t><br/>\n"
"</t>\n"
"<t t-else=\"\">\n"
"    ທ່ານຍັງບໍ່ມີສິດເຂົ້າເຖິງພອດທໍໃນຖານຂໍ້ມູນຂອງພວກເຮົາ. ກະລຸນາຕິດຕໍ່\n"
"    <t t-out=\"ctx.get('partner_id') and ctx['partner_id'].user_id and "
"ctx['partner_id'].user_id.email and 'your account manager %s (%s)' % "
"(ctx['partner_id'].user_id.name,ctx['partner_id'].user_id.email) or 'us'\">ພວ"
"ກເຮົາ</t>.<br/>\n"
"</t>\n"
"ເບາະແສຈະຖືກສົ່ງຕໍ່ໄປໃຫ້ຄູ່ຄ້າອື່ນ ຖ້າທ່ານບໍ່ຕິດຕໍ່ເບາະແສພາຍໃນ 20 ວັນ.<br/><br/>\n"
"ຂອບໃຈ,<br/>\n"
"<t t-out=\"ctx.get('partner_id') and ctx['partner_id'].user_id and "
"ctx['partner_id'].user_id.signature or ''\"/>\n"
"<br/>\n"
"<t t-if=\"not ctx.get('partner_id') or not ctx['partner_id'].user_id\">\n"
"    ໝາຍເຫດ: ເບິ່ງຄືວ່າທ່ານຍັງບໍ່ມີຜູ້ຈັດການບັນຊີຖືກມອບໝາຍໃຫ້ທ່ານ, ກະລຸນາຕິດຕໍ່ພວກເຮົາ.\n"
"</t>\n"
"            </t>"

