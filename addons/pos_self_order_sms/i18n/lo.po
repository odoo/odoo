#. module: pos_self_order_sms
#: model:ir.module.module,description:base.module_pos_self_order_sms
msgid ""
"Integrates POS Self Order with SMS to send customers order confirmation via "
"SMS."
msgstr ""
"ເຊື່ອມໂຍງ POS ສັ່ງຊື້ດ້ວຍຕົນເອງ ເຂົ້າກັບ SMS ເພື່ອສົ່ງຂໍ້ຄວາມຢືນຢັນການສັ່ງຊື້ໃຫ້ລູກຄ້າຜ່ານ SMS."

#. module: pos_self_order_sms
#: model_terms:ir.ui.view,arch_db:pos_self_order_sms.view_pos_preset_form_inherit_pos_self_order_sms
