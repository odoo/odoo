<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <!-- External page : thanks message -->
        <template id="rating_external_page_view" name="Thanks for your Feedback">
            <t t-call="web.frontend_layout">
                <div class="o_rating_page_thank_you d-flex flex-column justify-content-center">
                    <div class="container py-5">
                        <div class="oe_structure" id="oe_structure_rating_header_thanks_you"/>
                        <h3 class="text-center mt-4 pb-2">Thank you for your feedback!</h3>
                        <a t-att-href="web_base_url" class="d-block text-decoration-none text-center mb-4">
                            <i class="oi me-1" data-icon="arrow_back"/> Back to the Homepage
                        </a>
                        <div class="oe_structure" id="oe_structure_rating_footer_thanks_you"/>
                    </div>
                </div>
            </t>
        </template>

        <!-- External page: Invalid partner rating -->
        <template id="rating_external_page_invalid_partner" name="Not allows to rating">
            <t t-call="web.frontend_layout">
                <section class="mt128">
                    <div class="container">
                        <div class="row" >
                            <div class="col-lg-4">
                                <img class="img img-fluid mx-auto" src="/rating/static/src/img/503.svg" alt=""/>
                            </div>
                            <div class="col-lg-8 text-lg-start">
                                <h1>You cannot rate this <t t-out="model_name"/></h1>
                                <p>
                                    Only the customer of "<t t-out="name"/>" or someone from the same company can give it a rating.
                                </p>
                            </div>
                            <hr class="my-5 opacity-100"/>
                            <div class="mb128 col-lg-12">
                                <ul class="list-inline text-center">
                                    <li>
                                        <a t-att-href="web_base_url" class="btn btn-primary">Home</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <!-- External page: rate and submit feedback -->
        <template id="rating_external_page_submit" name="Rate our Services">
            <t t-set="rate_colors" t-value="{5: 'success', 3: 'warning', 1: 'danger'}"/>
            <t t-call="web.frontend_layout">
                <div class="o_rating_page_submit container my-sm-5">
                    <div class="oe_structure" id="oe_structure_rate_submit_header"/>
                    <div class="row justify-content-center">
                        <div class="o_rating_page_col col-lg-9 col-xl-8 rounded-4 p-4 p-md-5">
                            <h1 class="h3-fs text-sm-center">Thank you for rating our services!</h1>
                            <p class="text-sm-center text-muted fw-medium mb-0">Your rating has been recorded.</p>
                            <form t-attf-action="/rate/#{token}/submit_feedback" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row row-cols-3 g-3 my-4">
                                    <t t-foreach="rate_names" t-as="rate_name">
                                        <t t-set="rate_color" t-value="rate_colors[rate_name]"/>
                                        <div class="col">
                                            <input
                                                type="radio"
                                                name="rate"
                                                class="o_rating_input btn-check"
                                                t-attf-id="rate_{{rate_name}}"
                                                t-att-value="rate_name"
                                                t-att-checked="rate == rate_name"
                                                autocomplete="off"/>
                                            <label
                                                t-att-for="'rate_%s' % (rate_name)"
                                                t-attf-class="o_rating_label btn d-flex flex-column align-items-center h-100 gap-2 border-#{rate_color} rounded-3 py-4 px-2 bg-#{rate_color}-subtle"
                                            >
                                                <img
                                                    t-attf-src="/rating/static/src/img/rating_#{rate_name}.svg"
                                                    t-att-alt="rate_name_value" width="48" height="48"/>
                                                <span t-out="rate_name_value"/>
                                            </label>
                                        </div>
                                    </t>
                                </div>
                                <label for="rating_feedback" class="form-label fw-medium">Feel free to share feedback on your experience</label>
                                <textarea
                                    id="rating_feedback"
                                    class="form-control"
                                    name="feedback"
                                    rows="5"
                                    placeholder="What went well? What could be better?"
                                    t-out="rating.feedback or ''"/>
                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-primary">Send Feedback</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="oe_structure" id="oe_structure_rate_submit_footer"/>
                </div>
            </t>
        </template>
</odoo>
