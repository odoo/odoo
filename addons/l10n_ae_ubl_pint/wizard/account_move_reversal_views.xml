<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_move_reversal_inherit_l10n_ae_ubl_pint" model="ir.ui.view">
            <field name="name">account.move.reversal.form.inherit.l10n_ae_ubl_pint</field>
            <field name="inherit_id" ref="account.view_account_move_reversal"/>
            <field name="model">account.move.reversal</field>
            <field name="arch" type="xml">
                <field name="journal_id" position="before">
                    <!-- ibr-158-ae: a customer credit note needs its reason, asked for here rather than at sending. -->
                    <field name="l10n_ae_credit_note_reason" string="Reason"
                           invisible="move_type == 'entry' or country_code != 'AE'"
                           required="move_type == 'out_invoice' and country_code == 'AE'"/>
                </field>
                <field name="reason" position="attributes">
                    <attribute name="invisible" separator="or" add="country_code == 'AE'"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
