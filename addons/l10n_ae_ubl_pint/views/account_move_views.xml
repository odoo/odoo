<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_ae_ubl_pint" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ae_ubl_pint</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <group name="sale_info_group" position="inside">
                <field name="l10n_ae_credit_note_reason" string="Reason" invisible="move_type != 'out_refund' or country_code != 'AE'" readonly="state != 'draft'"/>
            </group>
            <xpath expr="//div[@name='journal_div']" position="after">
                    <label for="l10n_ae_invoice_type" string="Invoice Type" invisible="move_type not in ['out_invoice']"/>
                    <label for="l10n_ae_invoice_type" string="Credit Note Type" invisible="move_type not in ['out_refund']"/>
                    <div name="invoice_type" class="d-flex" invisible="move_type not in ['out_invoice', 'out_refund']">
                        <field name="l10n_ae_invoice_type" style="width: 150px;" readonly="state != 'draft'"/>
                        <span class="o_form_label mx-3 oe_edit_only text-center" style="width: 6ch;" invisible="(state != 'draft' and not l10n_ae_invoice_transaction_type) or l10n_ae_invoice_type == 'simplified'">with</span>
                        <field name="l10n_ae_invoice_transaction_type" string="Transaction Type" placeholder="Leave empty if not applicable" invisible="l10n_ae_invoice_type == 'simplified'" readonly="state != 'draft'"/>
                    </div>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group string="FTA" invisible="country_code != 'AE'">
                    <field name="l10n_ae_beneficiary_id"/>
                    <field name="l10n_ae_principal_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
