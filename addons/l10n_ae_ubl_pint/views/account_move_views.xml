<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_ae_ubl_pint" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ae_ubl_pint</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                    <label for="l10n_ae_invoice_type" string="Invoice Type" invisible="move_type not in ['out_invoice'] or l10n_ae_company_country_code != 'AE'"/>
                    <label for="l10n_ae_invoice_type" string="Credit Note Type" invisible="move_type not in ['out_refund'] or l10n_ae_company_country_code != 'AE'"/>
                    <!-- Self-billed bills have no invoice type. -->
                    <label for="l10n_ae_invoice_type" string="Bill Type" invisible="move_type not in ['in_invoice', 'in_refund'] or l10n_ae_company_country_code != 'AE' or not l10n_ae_invoice_type"/>
                    <div name="invoice_type" class="d-flex" invisible="move_type not in ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'] or l10n_ae_company_country_code != 'AE' or (move_type in ['in_invoice', 'in_refund'] and not l10n_ae_invoice_type)">
                        <field name="l10n_ae_invoice_type" style="width: 150px;" readonly="state != 'draft'"/>
                        <span class="o_form_label mx-3 oe_edit_only text-center" style="width: 6ch;" invisible="(state != 'draft' and not l10n_ae_transaction_type_ids) or l10n_ae_invoice_type == 'simplified'">with</span>
                        <field name="l10n_ae_transaction_type_ids" string="Transaction Type" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"
                               domain="[('code', 'not in', ['01000000', '00100000', '00000001'])] if l10n_ae_invoice_type == 'commercial' else []" placeholder="Leave empty if not applicable" invisible="l10n_ae_invoice_type == 'simplified'" readonly="state != 'draft'"/>
                    </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
                <field name="l10n_ae_item_type" optional="hide" column_invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified'"/>
                <field name="l10n_ae_hs_code" optional="hide" column_invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified'" invisible="l10n_ae_item_type == 'S'"/>
                <field name="l10n_ae_service_accounting_code" optional="hide" column_invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified'" invisible="l10n_ae_item_type == 'G'"/>
                <field name="l10n_ae_goods_service_type" optional="hide" column_invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified'" invisible="l10n_ae_item_type == 'S'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="after">
                <field name="l10n_ae_item_type" invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified'"/>
                <field name="l10n_ae_hs_code" invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified' or l10n_ae_item_type == 'S'"/>
                <field name="l10n_ae_service_accounting_code" invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified' or l10n_ae_item_type == 'G'"/>
                <field name="l10n_ae_goods_service_type" invisible="parent.l10n_ae_company_country_code != 'AE' or parent.l10n_ae_invoice_type == 'simplified' or l10n_ae_item_type == 'S'"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group string="FTA" invisible="l10n_ae_company_country_code != 'AE' or l10n_ae_invoice_type == 'simplified'">
                    <field name="l10n_ae_beneficiary_id"/>
                    <field name="l10n_ae_principal_id"/>
                    <field name="l10n_ae_credit_note_reason" string="Reason" invisible="move_type not in ('out_refund', 'in_refund')" readonly="state != 'draft'"/>
                    <!-- ibr-055-ae: the preceding invoice reference (IBG-03) of a credit note not made from its invoice. -->
                    <field name="reversed_entry_id"
                           invisible="move_type not in ('out_refund', 'in_refund')"
                           readonly="state != 'draft'"
                           domain="[('move_type', '=', 'out_invoice' if move_type == 'out_refund' else 'in_invoice'), ('commercial_partner_id', '=', commercial_partner_id), ('state', '=', 'posted')]"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
