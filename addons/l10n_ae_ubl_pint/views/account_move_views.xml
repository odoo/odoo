<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_ae_ubl_pint" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_ae_ubl_pint</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                    <label for="l10n_ae_invoice_type" string="Invoice Type" invisible="move_type not in ['out_invoice'] or debit_origin_id"/>
                    <label for="l10n_ae_invoice_type" string="Credit Note Type" invisible="move_type not in ['out_refund']"/>
                    <div name="invoice_type" class="d-flex" invisible="move_type not in ['out_invoice', 'out_refund'] or debit_origin_id">
                        <field name="l10n_ae_invoice_type" style="width: 150px;" readonly="state != 'draft'"/>
                        <span class="o_form_label mx-3 oe_edit_only text-center" style="width: 6ch;" invisible="(state != 'draft' and not l10n_ae_invoice_transaction_type) or l10n_ae_invoice_type == 'simplified'">with</span>
                        <field name="l10n_ae_invoice_transaction_type" string="Transaction Type" placeholder="Leave empty if not applicable" invisible="l10n_ae_invoice_type == 'simplified'" readonly="state != 'draft'"/>
                    </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
                <field name="l10n_ae_item_type" optional="show" column_invisible="parent.country_code != 'AE'"/>
                <field name="l10n_ae_classification_code" optional="show" column_invisible="parent.country_code != 'AE'" invisible="l10n_ae_item_type == 'S'"/>
                <field name="l10n_ae_service_accounting_code" optional="show" column_invisible="parent.country_code != 'AE'" invisible="l10n_ae_item_type == 'G'"/>
                <field name="l10n_ae_goods_service_type" optional="hide" column_invisible="parent.country_code != 'AE'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="after">
                <field name="l10n_ae_item_type" invisible="parent.country_code != 'AE'"/>
                <field name="l10n_ae_classification_code" invisible="parent.country_code != 'AE' or l10n_ae_item_type == 'S'"/>
                <field name="l10n_ae_service_accounting_code" invisible="parent.country_code != 'AE' or l10n_ae_item_type == 'G'"/>
                <field name="l10n_ae_goods_service_type" invisible="parent.country_code != 'AE'"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="after">
                <group string="FTA" invisible="country_code != 'AE'">
                    <field name="l10n_ae_beneficiary_id"/>
                    <field name="l10n_ae_principal_id"/>
                    <field name="l10n_ae_credit_note_reason" string="Reason" invisible="move_type != 'out_refund' and not (move_type == 'in_refund' and l10n_ae_is_self_billing)" readonly="state != 'draft'"/>
                    <!-- ibr-055-ae: the preceding invoice reference (IBG-03) of a credit note not made from its invoice. -->
                    <field name="reversed_entry_id"
                           invisible="move_type != 'out_refund' and not (move_type == 'in_refund' and l10n_ae_is_self_billing)"
                           readonly="state != 'draft'"
                           domain="[('move_type', '=', 'out_invoice' if move_type == 'out_refund' else 'in_invoice'), ('commercial_partner_id', '=', commercial_partner_id), ('state', '=', 'posted')]"/>
                    <field name="l10n_ae_card_number" invisible="l10n_ae_invoice_transaction_type != '00100000'"/>
                    <field name="l10n_ae_card_network" invisible="l10n_ae_invoice_transaction_type != '00100000'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
