<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_ae_ubl_pint" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_ae_ubl_pint</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="company_registry" position="after">
                <field name="l10n_ae_registration_identifier_type"
                       invisible="country_code != 'AE'"/>
                <field name="l10n_ae_registration_identifier"
                       invisible="country_code != 'AE'"/>
                <field name="l10n_ae_authority_name"
                       invisible="country_code != 'AE' or l10n_ae_registration_identifier_type != 'TL'"/>
                <field name="l10n_ae_passport_issuing_country_id"
                       invisible="country_code != 'AE' or l10n_ae_registration_identifier_type != 'PAS'"/>
            </field>
        </field>
    </record>
</odoo>
