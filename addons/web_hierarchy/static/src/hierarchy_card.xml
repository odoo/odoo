<?xml version="1.0" encoding="utf-8" ?>
<templates>

    <t t-name="web_hierarchy.HierarchyCard" t-inherit="web.CardRenderer">
        <xpath expr="article" position="attributes">
            <attribute name="t-custom-click.synthetic">this.onGlobalClick</attribute>
        </xpath>

        <xpath expr="article/t" position="replace">
            <div class="flex-fill">$0</div>
            <button
                t-if="this.props.isParentNode and this.parent().id"
                class="btn btn-secondary text-center m-2 mt-0"
                title="Show ancestor"
                t-on-click.synthetic="this.showAncestor"
            >
                <t t-out="this.showAncestorLabel()" />
            </button>
            <button
                t-if="!this.props.isParentNode and this.children().count"
                class="btn btn-secondary text-center m-2 mt-0"
                title="Unfold"
                t-on-click.synthetic="this.unfold"
            >
                <i class="oi oi-fw" data-icon="arrow_right"/>
                <t t-out="this.unfoldLabel()"/>
            </button>
        </xpath>
    </t>

</templates>
