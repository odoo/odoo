<?xml version="1.0" encoding="utf-8" ?>
<templates>

    <t t-name="web_hierarchy.HierarchyCard" t-inherit="web.CardRenderer">
        <xpath expr="article" position="attributes">
            <attribute name="t-att-data-node-id">this.props.record.resId</attribute>
            <attribute name="t-custom-click.synthetic">this.onGlobalClick</attribute>
        </xpath>

        <xpath expr="article" position="inside">
            <button
                t-if="this.countChildren"
                class="btn btn-secondary text-center m-2 mt-0"
                t-att-title="this.props.leaf ? 'Unfold' : 'Fold'"
                t-on-click.synthetic="this.toggleChildren"
            >
                <t t-if="this.props.leaf">
                    <i class="oi oi-fw" data-icon="arrow_right"/>
                    <t t-out="this.countChildren + ' ' + (this.env.config.getDisplayName() || 'Unfold')"/>
                </t>
                <t t-else="">
                    <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                    <t t-out="this.countChildren + ' ' + (this.env.config.getDisplayName() || 'Fold')"/>
                </t>
            </button>
        </xpath>
    </t>

</templates>
