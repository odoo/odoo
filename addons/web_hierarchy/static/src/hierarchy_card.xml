<?xml version="1.0" encoding="utf-8" ?>
<templates>

    <t t-name="web_hierarchy.HierarchyCard" t-inherit="web.CardRenderer">
        <xpath expr="article" position="attributes">
            <attribute name="t-custom-click.synthetic">this.onGlobalClick</attribute>
        </xpath>

        <xpath expr="article/t" position="replace">
            <div class="flex-fill">$0</div>
            <button
                t-if="this.props.record.childCount"
                class="btn btn-secondary text-center m-2 mt-0"
                t-att-title="this.props.record.areChildrenLoaded ? 'Fold' : 'Unfold'"
                t-on-click.synthetic="this.props.record.toggleChildren.bind(this.props.record)"
            >
                <t t-if="this.props.record.areChildrenLoaded">
                    <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                    <t t-out="this.props.record.childCount + ' ' + (this.env.config.getDisplayName() || 'Fold')"/>
                </t>
                <t t-else="">
                    <i class="oi oi-fw" data-icon="arrow_right"/>
                    <t t-out="this.props.record.childCount + ' ' + (this.env.config.getDisplayName() || 'Unfold')"/>
                </t>
            </button>
        </xpath>
    </t>

</templates>
