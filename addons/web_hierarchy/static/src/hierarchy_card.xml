<?xml version="1.0" encoding="utf-8" ?>
<templates>

    <t t-name="web_hierarchy.HierarchyCard" t-inherit="web.CardRenderer">
        <xpath expr="article" position="attributes">
            <attribute name="t-custom-click.synthetic">this.onGlobalClick</attribute>
        </xpath>

        <xpath expr="article/t" position="replace">
            <div class="flex-fill">$0</div>
            <div class="d-flex">
                <button
                    t-if="this.showChildrenBtn()"
                    class="btn btn-secondary text-center m-2 mt-0 flex-fill"
                    title="Unfold"
                    t-on-click.synthetic="this.unfold"
                >
                    <i class="oi oi-fw" data-icon="arrow_right"/>
                    <t t-out="this.unfoldLabel()"/>
                </button>
                <button
                    t-if="this.props.showAncestorBtn and this.parent().id"
                    class="btn btn-secondary text-center m-2 mt-0"
                    t-att-class="{'flex-fill': !this.showChildrenBtn()}"
                    title="Show ancestor"
                    t-on-click.synthetic="this.showAncestor"
                >
                    <i class="oi oi-fw" data-icon="subdirectory_arrow_left" style="transform: rotate(90deg)"/>
                    <span t-if="!this.showChildrenBtn()" class="ms-1" t-out="this.showAncestorLabel()" />
                </button>
            </div>
        </xpath>
    </t>

</templates>
