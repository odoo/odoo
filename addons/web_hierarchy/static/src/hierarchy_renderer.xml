<?xml version="1.0" encoding="utf-8" ?>
<templates>

    <t t-name="web_hierarchy.HierarchyRenderer">
        <div class="o_hierarchy_renderer o_renderer w-100 d-flex justify-content-center" t-ref="this.rendererRef">
            <div class="o_hierarchy_container d-flex flex-column w-100 w-lg-75 h-100 p-2">
                <div t-foreach="this.props.model.root.groups" t-as="row" t-key="row.id">
                    <div
                        t-att-data-row-id="row.id"
                        class="o_hierarchy_row d-flex justify-content-center align-items-stretch flex-wrap"
                    >
                        <div
                            t-foreach="row.list.records"
                            t-as="record"
                            t-key="record.resId"
                            class="o_hierarchy_node_container m-2"
                        >
                            <HierarchyCard
                                classNames="'o_hierarchy_node'"
                                archInfo="this.props.archInfo.cardArchInfo"
                                openRecord="this.props.openRecord"
                                record="record"
                                model="this.props.model"
                                leaf="row_last"
                            />
                        </div>
                    </div>
                    <t t-if="!row_last">
                        <div t-if="row.hiddenChildren > 0" class="d-flex justify-content-center mt-2">
                            <button class="btn btn-outline-secondary rounded-circle">
                            + <t t-out="row.hiddenChildren" />
                            </button>
                        </div>
                        <div class="o_hierarchy_separator d-flex mt-4">
                            <div class="o_hierarchy_line_part o_hierarchy_line_left"></div>
                            <div class="o_hierarchy_line_part o_hierarchy_line_right"></div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
