#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Aaaaaw este foarte drăguț, dar, știi, roboții nu funcționează așa. Ești prea "
"uman pentru mine! Să-l păstrăm profesionist ❤️"

#. module: mail_bot
#: model:ir.module.module,summary:base.module_mail_bot
msgid "Add OdooBot in discussions"
msgstr "Adaugă OdooBot în discuții"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "Dezactivat"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "Canal Discuții"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "Nume afișat"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Go ahead - Try sending me an emoji 😊"
msgstr "Încearcă să-mi trimiți un emoji 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app settings."
msgstr ""
"Minunat! Poți personaliza %(bold_start)srăspunsurile predefinite%(bold_end)s "
"în setările aplicației Discuții."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello 👋"
msgstr "Salut 👋"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "Hmmm..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "Mă tem că nu înțeleg. Îmi pare rău!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide, "
"ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"Nu sunt suficient de inteligent ca să răspund la întrebarea ta.%(new_line)"
"sPentru a urma ghidul meu, scrie: %(command_start)sstart the tour%"
"(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "Inactiv"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"It looks like you're not sure what to do next. Please type %(command_start)s/"
"%(command_end)s to see the suggestions, then select %(command_start)shelp%"
"(command_end)s and press Enter."
msgstr ""
"Se pare că nu știi ce să faci mai departe. Tastează %(command_start)s/%"
"(command_end)s pentru a vedea sugestiile, apoi selectează %(command_start)"
"shelp%(command_end)s și apasă Enter."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Bot de e-mail"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "Neinițializat"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not quite. To continue the tour, please send an emoji by typing %"
"(command_start)s:)%(command_end)s and pressing Enter, or by clicking the %"
"(smile_icon)s icon to pick one."
msgstr ""
"Nu chiar. Pentru a continua turul, trimite un emoji tastând %(command_start)"
"s:)%(command_end)s și apăsând Enter sau fă clic pe pictograma %(smile_icon)s "
"pentru a alege unul."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you're doing? Please type %(command_start)s::%(command_end)s "
"to see canned responses. Select one and press Enter."
msgstr ""
"Nu știi ce să faci? Tastează %(command_start)s::%(command_end)s pentru a "
"vedea răspunsurile predefinite. Selectează unul și apasă Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's Discuss application helps employees collaborate efficiently. I'm here "
"to help you explore its features."
msgstr ""
"Aplicația Discuții din Odoo îi ajută pe angajați să colaboreze eficient. "
"Sunt aici ca să te ajut să-i descoperi funcționalitățile."

#. module: mail_bot
#: model:ir.module.module,shortdesc:base.module_mail_bot
msgid "OdooBot"
msgstr "OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "Stare OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "Odoobot nu a reușit"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "onboarding_attachment"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "onboarding_canned"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "onboarding_command"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "onboarding_emoji"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "onboarding_ping"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: %"
"(command_start)sstart the tour%(command_end)s."
msgstr ""
"Îmi pare rău, mi-e somn. Sau poate nu! Poate încerc doar să-mi ascund "
"necunoașterea limbajului uman...%(new_line)sÎți pot arăta funcționalitățile "
"dacă scrii: %(command_start)sstart the tour%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I'm not listening right now. To get my attention, %"
"(bold_start)smention me%(bold_end)s by typing %(command_start)s@OdooBot%"
"(command_end)s and selecting me."
msgstr ""
"Îmi pare rău, nu sunt atent acum. Ca să-mi atragi atenția, %(bold_start)"
"smenționează-mă%(bold_end)s tastând %(command_start)s@OdooBot%(command_end)s "
"și selectându-mă."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "Mulțumiri"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "Mulțumesc pentru feedback. La revedere!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "Asta nu-i frumos! Sunt robot dar am sentimente ... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That's the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the tour%"
"(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"Acesta este sfârșitul prezentării. Poți %(bold_start)sînchide această "
"conversație%(bold_end)s sau poți scrie %(command_start)sstart the tour%"
"(command_end)s pentru a o vedea din nou. Descoperă Odoo cu plăcere!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, first click the %"
"(plus_icon)s icon, then select %(paperclip_icon)s Attach files."
msgstr ""
"Pentru a %(bold_start)strimite un atașament%(bold_end)s, fă clic mai întâi "
"pe pictograma %(plus_icon)s, apoi selectează %(paperclip_icon)s Atașează "
"fișiere."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To get started, try sending me an emoji 😊"
msgstr "Pentru început, încearcă să-mi trimiți un emoji 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To use special commands, %(bold_start)sstart your message with a %"
"(bold_end)s %(command_start)s/%(command_end)s. For example, try typing %"
"(command_start)s/help%(command_end)s."
msgstr ""
"Pentru a folosi comenzi speciale, %(bold_start)sîncepe mesajul cu%(bold_end)"
"s %(command_start)s/%(command_end)s. De exemplu, încearcă să tastezi %"
"(command_start)s/help%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand that.%(new_line)sIf you "
"need help exploring our apps, please check out %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour videos%"
"(slides_link_end)s."
msgstr ""
"Din păcate, sunt doar un bot 😞 și nu înțeleg asta.%(new_line)sDacă ai "
"nevoie de ajutor pentru a explora aplicațiile noastre, consultă %"
"(document_link_start)sdocumentația%(document_link_end)s sau %"
"(slides_link_start)svideoclipurile noastre%(slides_link_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "Operator"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to "
"use canned responses. I've created a temporary one just for you."
msgstr ""
"Minunat! 😇%(new_line)sTastează %(command_start)s::%(command_end)s pentru a "
"folosi răspunsuri predefinite. Am creat unul temporar special pentru tine."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow, you're a natural!%(new_line)s Use @username to mention someone and grab "
"their attention.%(new_line)s %(bold_start)sTry mentioning me by typing%"
"(bold_end)s %(command_start)s@OdooBot%(command_end)s in your message."
msgstr ""
"Uau, te descurci de minune!%(new_line)s Folosește @username pentru a "
"menționa pe cineva și a-i atrage atenția.%(new_line)s %(bold_start)sÎncearcă "
"să mă menționezi tastând%(bold_end)s %(command_start)s@OdooBot%(command_end)"
"s în mesaj."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I'm here! 🎉 %(new_line)sNow, try %(bold_start)ssending an attachment%"
"(bold_end)s 📎 - maybe a picture of your cute dog... 🐕"
msgstr ""
"Da, sunt aici! 🎉 %(new_line)sAcum încearcă %(bold_start)s să trimiți un "
"atașament%(bold_end)s 📎 — poate o poză cu cățelul tău drăguț... 🐕"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "fuck"
msgstr "La dracu"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "help"
msgstr "ajutor"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "i love you"
msgstr "te iubesc"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "love"
msgstr "iubire"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "start the tour"
msgstr "începeți turul"
