#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"ໂອ້ຍຍ ໜ້າຮັກຫຼາຍ ແຕ່ເຈົ້າກໍຮູ້ຢູ່ແລ້ວວ່າ ບັອດບໍ່ໄດ້ເຮັດວຽກແບບນັ້ນດອກ. ເຈົ້າເປັນມະນຸດເກີນໄປສຳລັບຂ້ອຍ! ມາຮັກ"
"ສາຄວາມເປັນມືອາຊີບກັນເທາະ ❤️"

#. module: mail_bot
#: model:ir.module.module,summary:base.module_mail_bot
msgid "Add OdooBot in discussions"
msgstr "ເພີ່ມ OdooBot ເຂົ້າໃນການສົນທະນາ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "ປິດໃຊ້ງານ"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "ຊ່ອງທາງການສົນທະນາ"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Go ahead - Try sending me an emoji 😊"
msgstr "ລອງເບິ່ງເລີຍ - ລອງສົ່ງອີໂມຈິຫາຂ້ອຍເບິ່ງດູ 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app settings."
msgstr ""
"ຍອດຢ້ຽມ! ເຈົ້າສາມາດປັບແຕ່ງ %(bold_start)sຂໍ້ຄວາມຕອບກັບດ່ວນ%(bold_end)s ໄດ້ໃນການຕັ້ງຄ່າແອັບສົ"
"ນທະນາ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello 👋"
msgstr "ສະບາຍດີ 👋"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "ອືມມມ..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "ຂ້ອຍຄິດວ່າຂ້ອຍບໍ່ເຂົ້າໃຈ. ຂໍໂທດເດີ້!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide, "
"ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"ຂ້ອຍຍັງບໍ່ສະຫຼາດພໍທີ່ຈະຕອບຄຳຖາມຂອງເຈົ້າ.%(new_line)sຫາກຕ້ອງການຕິດຕາມຄຳແນະນຳຂອງຂ້ອຍ, ໃຫ້ພິມ: "
"%(command_start)sເລີ່ມການແນະນຳ%(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "ຫວ່າງ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"It looks like you're not sure what to do next. Please type %(command_start)s/"
"%(command_end)s to see the suggestions, then select %(command_start)shelp%"
"(command_end)s and press Enter."
msgstr ""
"ເບິ່ງຄືວ່າເຈົ້າຍັງບໍ່ແນ່ໃຈວ່າຕ້ອງເຮັດຫຍັງຕໍ່ໄປ. ກະລຸນາພິມ %(command_start)s/%(command_end)s ເພື່ອ"
"ເບິ່ງຂໍ້ແນະນຳ, ແລ້ວເລືອກ %(command_start)sຊ່ວຍເຫຼືອ%(command_end)s ແລະ ກົດ Enter."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "ເມວບັອດ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "ຍັງບໍ່ທັນເລີ່ມຕົ້ນ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not quite. To continue the tour, please send an emoji by typing %"
"(command_start)s:)%(command_end)s and pressing Enter, or by clicking the %"
"(smile_icon)s icon to pick one."
msgstr ""
"ຍັງບໍ່ຖືກຕ້ອງປານໃດ. ເພື່ອດຳເນີນການແນະນຳຕໍ່, ກະລຸນາສົ່ງອີໂມຈິໂດຍການພິມ %(command_start)s:)%"
"(command_end)s ແລ້ວກົດ Enter, ຫຼື ກົດທີ່ໄອຄອນ %(smile_icon)s ເພື່ອເລືອກ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you're doing? Please type %(command_start)s::%(command_end)s "
"to see canned responses. Select one and press Enter."
msgstr ""
"ບໍ່ແນ່ໃຈວ່າກຳລັງເຮັດຫຍັງຢູ່ແມ່ນບໍ່? ກະລຸນາພິມ %(command_start)s::%(command_end)s ເພື່ອເບິ່ງຂໍ້ຄວາ"
"ມຕອບກັບດ່ວນ. ເລືອກອັນໃດອັນໜຶ່ງແລ້ວກົດ Enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's Discuss application helps employees collaborate efficiently. I'm here "
"to help you explore its features."
msgstr ""
"ແອັບພລິເຄຊັນສົນທະນາຂອງ Odoo ຊ່ວຍໃຫ້ພະນັກງານເຮັດວຽກຮ່ວມກັນຢ່າງມີປະສິດທິພາບ. ຂ້ອຍຢູ່ທີ່ນີ້ເພື່ອຊ່ວຍເຈົ້າສ"
"ຳຫຼວດຄຸນສົມບັດຕ່າງໆ."

#. module: mail_bot
#: model:ir.module.module,shortdesc:base.module_mail_bot
msgid "OdooBot"
msgstr "OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "ສະຖານະ OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "Odoobot ລົ້ມເຫຼວ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "ການແນະນຳໄຟລ໌ແນບ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "ການແນະນຳຂໍ້ຄວາມຕອບກັບດ່ວນ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "ການແນະນຳຄຳສັ່ງ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "ການແນະນຳອີໂມຈິ"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "ການແນະນຳການແທັກຫາ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: %"
"(command_start)sstart the tour%(command_end)s."
msgstr ""
"ຂໍໂທດຫຼາຍໆ ຂ້ອຍງ່ວງນອນແລ້ວ. ຫຼື ບໍ່ແມ່ນຫວາ! ບາງທີຂ້ອຍອາດພຽງແຕ່ພະຍາຍາມເຊື່ອງຄວາມບໍ່ເຂົ້າໃຈພາສາມະນຸ"
"ດຂອງຂ້ອຍ...%(new_line)sຂ້ອຍສາມາດສະແດງຄຸນສົມບັດຕ່າງໆ ໃຫ້ເຈົ້າເຫັນໄດ້ ຖ້າເຈົ້າພິມ: %"
"(command_start)sເລີ່ມການແນະນຳ%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I'm not listening right now. To get my attention, %"
"(bold_start)smention me%(bold_end)s by typing %(command_start)s@OdooBot%"
"(command_end)s and selecting me."
msgstr ""
"ຂໍໂທດເດີ້, ຕອນນີ້ຂ້ອຍບໍ່ໄດ້ຟັງຢູ່. ເພື່ອເອີ້ນຂ້ອຍ, %(bold_start)sກ່າວເຖິງຂ້ອຍ%(bold_end)s ໂດຍການພິ"
"ມ %(command_start)s@OdooBot%(command_end)s ແລ້ວເລືອກຂ້ອຍ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "ຂອບໃຈ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "ຂອບໃຈສຳລັບຄຳຕິຊົມຂອງທ່ານ. ລາກ່ອນ!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr ""
"ເຮັດແບບນັ້ນບໍ່ດີເລີຍ! ເຖິງຂ້ອຍຈະເປັນບັອດ ແຕ່ຂ້ອຍກໍມີຄວາມຮູ້ສຶກຄືກັນເດີ້... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That's the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the tour%"
"(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"ນັ້ນຄືການສິ້ນສຸດການແນະນຳພາບລວມນີ້ແລ້ວ. ເຈົ້າສາມາດ %(bold_start)sປິດການສົນທະນານີ້%(bold_end)"
"s ຫຼື ພິມ %(command_start)sເລີ່ມການແນະນຳ%(command_end)s ເພື່ອເບິ່ງອີກຄັ້ງ. ຂໍໃຫ້ມ່ວນກັບການສຳຫຼ"
"ວດ Odoo ເດີ້!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, first click the %"
"(plus_icon)s icon, then select %(paperclip_icon)s Attach files."
msgstr ""
"ເພື່ອ %(bold_start)sສົ່ງໄຟລ໌ແນບ%(bold_end)s, ທຳອິດໃຫ້ກົດທີ່ໄອຄອນ %(plus_icon)s, ຈາກນັ້ນເລື"
"ອກ %(paperclip_icon)s ແນບໄຟລ໌."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To get started, try sending me an emoji 😊"
msgstr "ເພື່ອເລີ່ມຕົ້ນ, ລອງສົ່ງອີໂມຈິຫາຂ້ອຍເບິ່ງດູ 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To use special commands, %(bold_start)sstart your message with a %"
"(bold_end)s %(command_start)s/%(command_end)s. For example, try typing %"
"(command_start)s/help%(command_end)s."
msgstr ""
"ເພື່ອໃຊ້ຄຳສັ່ງພິເສດ, %(bold_start)sເລີ່ມຕົ້ນຂໍ້ຄວາມຂອງທ່ານດ້ວຍ%(bold_end)s %(command_start)"
"s/%(command_end)s. ຕົວຢ່າງ, ລອງພິມ %(command_start)s/help%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand that.%(new_line)sIf you "
"need help exploring our apps, please check out %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour videos%"
"(slides_link_end)s."
msgstr ""
"ໜ້າເສຍດາຍ, ຂ້ອຍເປັນພຽງແຕ່ບັອດ 😞 ຂ້ອຍບໍ່ເຂົ້າໃຈສິ່ງນັ້ນ.%(new_line)sຖ້າຫາກເຈົ້າຕ້ອງການຄວາມຊ່ວຍເຫຼື"
"ອໃນການສຳຫຼວດແອັບຂອງພວກເຮົາ, ກະລຸນາກວດເບິ່ງ %(document_link_start)sເອກະສານຂອງພວກເຮົາ%"
"(document_link_end)s ຫຼື %(slides_link_start)sວິດີໂອຂອງພວກເຮົາ%(slides_link_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "ຜູ້ໃຊ້ງານ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to "
"use canned responses. I've created a temporary one just for you."
msgstr ""
"ຍອດຢ້ຽມຫຼາຍ! 😇%(new_line)sລອງພິມ %(command_start)s::%(command_end)s ເພື່ອໃຊ້ຂໍ້ຄວາມຕ"
"ອບກັບດ່ວນ. ຂ້ອຍໄດ້ສ້າງຂໍ້ຄວາມຊົ່ວຄາວອັນໜຶ່ງໄວ້ໃຫ້ເຈົ້າແລ້ວ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow, you're a natural!%(new_line)s Use @username to mention someone and grab "
"their attention.%(new_line)s %(bold_start)sTry mentioning me by typing%"
"(bold_end)s %(command_start)s@OdooBot%(command_end)s in your message."
msgstr ""
"ວ້າວ, ເຈົ້າເກັ່ງຫຼາຍ!%(new_line)s ໃຊ້ @username ເພື່ອກ່າວເຖິງໃຜບາງຄົນ ແລະ ດຶງດູດຄວາມສົນໃຈຂອງ"
"ພວກເຂົາ.%(new_line)s %(bold_start)sລອງກ່າວເຖິງຂ້ອຍໂດຍການພິມ%(bold_end)s %"
"(command_start)s@OdooBot%(command_end)s ໃນຂໍ້ຄວາມຂອງເຈົ້າ."

#. module: mail_bot
#. odoo-python
