#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Ооох, това е наистина сладко, но, нали знаеш, ботовете не работят така. "
"Прекалено човек си за мен! Нека го караме професионално ❤️"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "Изключено"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "Дискусионен канал"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "Име за показване"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app."
msgstr ""
"Чудесно! Можете да персонализирате %(bold_start)sсканираните отговори%"
"(bold_end)s в приложението Discuss."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! 👍%(new_line)sTo access special commands, %(bold_start)sstart your "
"sentence with%(bold_end)s %(command_start)s/%(command_end)s. Try getting "
"help."
msgstr ""
"Чудесно! 👍%(new_line)sЗа достъп до специални команди %(bold_start)"
"sзапочнете изречението си с%(bold_end)s %(command_start)s/%(command_end)s. "
"Опитайте да получите помощ."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello,"
msgstr "Здравейте,"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "Хмм..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "Боя се, че не разбирам. Съжалявам!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide, "
"ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"Не съм достатъчно умен да отговоря на въпроса Ви.%(new_line)sЗа да следвате "
"моето ръководство, попитайте: %(command_start)sзапочни обиколката%"
"(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "Номер (ID)"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "Неактивен"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Пощенски бот"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not exactly. To continue the tour, send an emoji: %(bold_start)stype%"
"(bold_end)s%(command_start)s :)%(command_end)s and press enter."
msgstr ""
"Не съвсем. За да продължите обиколката, изпратете емоджи: %(bold_start)"
"sнапишете%(bold_end)s%(command_start)s :)%(command_end)s и натиснете enter."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "Не е инициализирано"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s/%(command_end)s "
"and wait for the propositions. Select %(command_start)shelp%(command_end)s "
"and press enter."
msgstr ""
"Не е ясно какво правите. Моля, напишете %(command_start)s/%(command_end)s и "
"изчакайте предложенията. Изберете %(command_start)shelp%(command_end)s и "
"натиснете enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s:%(command_end)s "
"and wait for the propositions. Select one of them and press enter."
msgstr ""
"Не е ясно какво правите. Моля, напишете %(command_start)s:%(command_end)s и "
"изчакайте предложенията. Изберете едно от тях и натиснете enter."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's chat helps employees collaborate efficiently. I'm here to help you "
"discover its features."
msgstr ""
"Чатът на Odoo помага на служителите да си сътрудничат ефективно. Тук съм, за "
"да ви помогна да откриете неговите функции."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "Състояние на OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "Грешка от Odoobot"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "Въвеждащ прикачен файл"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "Въвеждащ готов отговор"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "Въвеждаща команда"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "Въвеждащо емоджи"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "Въвеждащ пинг"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: %"
"(command_start)sstart the tour%(command_end)s."
msgstr ""
"Извинявайте, сънлив съм. Или не! Може би просто се опитвам да скрия "
"незнанието си за човешкия език...%(new_line)sМога да ви покажа функции, ако "
"напишете: %(command_start)sстартирай обиколката%(command_end)s."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I am not listening. To get someone's attention, %(bold_start)sping "
"him%(bold_end)s. Write %(command_start)s@OdooBot%(command_end)s and select "
"me."
msgstr ""
"Съжалявам, не слушам. За да привлечете нечие внимание, %(bold_start)"
"sпингнете го%(bold_end)s. Напишете %(command_start)s@OdooBot%(command_end)s "
"и ме изберете."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "Благодаря"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "Благодарим за обратната връзка. Довиждане!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "Това не е любезно! Аз съм бот, но имам чувства... 💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That’s the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the tour%"
"(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"Това е краят на този преглед. Можете да %(bold_start)sзатворите този "
"разговор%(bold_end)s или да напишете %(command_start)sстарт на обиколката%"
"(command_end)s, за да я видите отново. Приятно разглеждане на Odoo!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "This is a temporary canned response to see how canned responses work."
msgstr ""
"Това е временен шаблонен отговор, за да видите как работят шаблонните "
"отговори."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, click on the %"
"(paperclip_icon)s icon and select a file."
msgstr ""
"За да %(bold_start)sизпратите прикачен файл%(bold_end)s, кликнете върху "
"иконата %(paperclip_icon)s и изберете файл."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To start, try to send me an emoji :)"
msgstr "За начало, опитайте да ми изпратите емоджи :)"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Try to send me an emoji"
msgstr "Опитайте да ми изпратите емоджи"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand! If you need help "
"discovering our product, please check %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour videos%"
"(slides_link_end)s."
msgstr ""
"За съжаление, аз съм просто бот 😞 Не разбирам! Ако имате нужда от помощ за "
"разглеждане на нашия продукт, моля, проверете %(document_link_start)sнашата "
"документация%(document_link_end)s или %(slides_link_start)sнашите видеа%"
"(slides_link_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "Потребител"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to "
"use canned responses. I've created a temporary one for you."
msgstr ""
"Чудесно! 😇%(new_line)sОпитайте да въведете %(command_start)s::%(command_end)"
"s, за да използвате готови отговори. Създадох един временен за вас."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow you are a natural!%(new_line)sPing someone with @username to grab their "
"attention. %(bold_start)sTry to ping me using%(bold_end)s %"
"(command_start)s@OdooBot%(command_end)s in a sentence."
msgstr ""
"Браво, имаш усет!%(new_line)sСпоменете някого с @username, за да привлечете "
"вниманието му. %(bold_start)sОпитайте да ме споменете с%(bold_end)s %"
"(command_start)s@OdooBot%(command_end)s в изречение."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I am here! 🎉 %(new_line)sNow, try %(bold_start)ssending an attachment%"
"(bold_end)s, like a picture of your cute dog..."
msgstr ""
"Да, тук съм! 🎉 %(new_line)sСега опитайте да %(bold_start)sизпратите "
"прикачен файл%(bold_end)s, например снимка на сладкото ви куче..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "fuck"
msgstr "по дяволите"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "help"
msgstr "помощ"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "i love you"
msgstr "обичам те"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "love"
msgstr "любов"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "start the tour"
msgstr "започнете обиколката"
