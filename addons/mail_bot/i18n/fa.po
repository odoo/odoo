#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"واقعا زیبا است، اما ربات‌ها اینطور کار نمی‌کنند. شما برای من زیادی انسان "
"هستید! اجازه دهید کارمان حرفه‌ای پیش برود ❤️"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "غیر فعال شده"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "کانال گفتگو"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "نام نمایشی"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app."
msgstr ""
"عالی! می‌توانید %(bold_start)sپاسخ‌های آماده%(bold_end)s را در برنامه پیام‌رسان "
"سفارشی کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! 👍%(new_line)sTo access special commands, %(bold_start)sstart your "
"sentence with%(bold_end)s %(command_start)s/%(command_end)s. Try getting "
"help."
msgstr ""
"عالی! 👍%(new_line)sبرای دسترسی به دستورات ویژه، %(bold_start)sجمله خود را "
"با%(bold_end)s %(command_start)s/%(command_end)s شروع کنید و کمک بگیرید "

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello,"
msgstr "سلام،"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "خب..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "ببخشید، متوجه نشدم!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide, "
"ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"من به اندازه کافی هوشمند نیستم که به سؤال شما پاسخ دهم.%(new_line)sبرای "
"پیروی از راهنمای من، بپرسید: %(command_start)sشروع تور%(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "شناسه (ID)"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "بیکار"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "ربات ایمیل"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not exactly. To continue the tour, send an emoji: %(bold_start)stype%"
"(bold_end)s%(command_start)s :)%(command_end)s and press enter."
msgstr ""
"دقیقاً نه. برای ادامه تور، یک ایموجی ارسال کنید: %(bold_start)تایپ کنید%"
"(bold_end)s%(command_start)s :)%(command_end)s و اینتر را فشار دهید."

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "بدون مقداردهی اولیه"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s/%(command_end)s "
"and wait for the propositions. Select %(command_start)shelp%(command_end)s "
"and press enter."
msgstr ""
"مطمئن نیستم چه کاری انجام می‌دهید. لطفاً %(command_start)s/%(command_end)s را "
"تایپ کنید و منتظر پیشنهادات باشید. گزینه %(command_start)sکمک%(command_end)s "
"را انتخاب کرده و اینتر را فشار دهید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you are doing. Please, type %(command_start)s:%(command_end)s "
"and wait for the propositions. Select one of them and press enter."
msgstr ""
"مطمئن نیستم چه کاری انجام می‌دهید. لطفاً %(command_start)s/%(command_end)s را "
"تایپ کنید و منتظر پیشنهادات باشید. یکی از گزینه‌ها را انتخاب کرده و اینتر را "
"فشار دهید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's chat helps employees collaborate efficiently. I'm here to help you "
"discover its features."
msgstr ""
"پیام‌رسان اودوو به کارمندان اجازه می‌دهد به صورت بهینه با هم ارتباط برقرار "
"کنند. من اینجام تا در کشف ویژگی‌های این برنامه به شما کمک کنم."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "وضعیت ربات اودوو"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "ربات ادوو ناموفق بود"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "پیوست همسوسازی"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "آموزش استفاده از پاسخ‌های آماده"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "فرمان همسوسازی"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "ایموجی همسوسازی"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "پینگ همسوسازی"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: %"
"(command_start)sstart the tour%(command_end)s."
msgstr ""
"ببخشید، خواب‌آلودم. یا شاید نه! شاید فقط دارم تلاش می‌کنم ناآگاهی‌ام از زبان "
"انسانی را پنهان کنم...%(new_line)sاگر بنویسید: %(command_start)sشروع تور%"
"(command_end)s، می‌توانم ویژگی‌ها را به شما نشان دهم."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I am not listening. To get someone's attention, %(bold_start)sping "
"him%(bold_end)s. Write %(command_start)s@OdooBot%(command_end)s and select "
"me."
msgstr ""
"ببخشید، من گوش نمی‌کنم. برای جلب توجه کسی، %(bold_start)sاو را منشن کنید%"
"(bold_end)s. بنویسید %(command_start)s@OdooBot%(command_end)s و مرا انتخاب "
"کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "با تشکر"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "بابت بازخوردی که دادید متشکرم. خدانگهدار!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "این رفتار خوب نیست! من ربات هستم، اما احساس هم دارم...💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That’s the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the tour%"
"(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"این پایان نمای کلی بود. می‌توانید %(bold_start)sاین گفتگو را ببندید%(bold_end)"
"s یا %(command_start)sشروع تور%(command_end)s را تایپ کنید تا دوباره آن را "
"ببینید. از کاوش در اودو لذت ببرید!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "This is a temporary canned response to see how canned responses work."
msgstr ""
"این یک پاسخ آماده موقت است تا نشان دهد پاسخ‌های آماده چگونه کار می‌کنند."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, click on the %"
"(paperclip_icon)s icon and select a file."
msgstr ""
"برای %(bold_start)ارسال پیوست%(bold_end)s، روی آیکون %(paperclip_icon)s کلیک "
"کنید و یک فایل انتخاب کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To start, try to send me an emoji :)"
msgstr "برای شروع، ایموجی :) را ارسال کنید"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Try to send me an emoji"
msgstr "با ارسال ایموجی شروع کنید"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand! If you need help "
"discovering our product, please check %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour videos%"
"(slides_link_end)s."
msgstr ""
"متاسفم، من فقط یک ربات هستم 😞 من نمی‌فهمم! اگر به کمک نیاز دارید تا محصول ما "
"را کشف کنید، لطفاً مستندات ما را در %(document_link_start)s اینجا %"
"(document_link_end)s بررسی کنید یا %(slides_link_start)s ویدیوهای ما %"
"(slides_link_end)s را مشاهده کنید."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "کاربر"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to "
"use canned responses. I've created a temporary one for you."
msgstr ""
"عالی است! 😇%(new_line)sسعی کنید %(command_start)s::%(command_end)s را برای "
"استفاده از پاسخ‌های آماده تایپ کنید. من یک پاسخ موقت برای شما ایجاد کرده‌ام."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow you are a natural!%(new_line)sPing someone with @username to grab their "
"attention. %(bold_start)sTry to ping me using%(bold_end)s %"
"(command_start)s@OdooBot%(command_end)s in a sentence."
msgstr ""
"وای، شما یک استعداد طبیعی دارید!%(new_line)sبرای جلب توجه کسی، از @username "
"استفاده کنید. %(bold_start)s من را با استفاده از%(bold_end)s %(command_start)"
"s@OdooBot%(command_end)s در یک جمله تگ کنید."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I am here! 🎉 %(new_line)sNow, try %(bold_start)ssending an attachment%"
"(bold_end)s, like a picture of your cute dog..."
msgstr ""
"بله، من اینجا هستم! 🎉 %(new_line)sحالا، %(bold_start)sیک پیوست ارسال کنید%"
"(bold_end)s، مانند عکسی از سگ بامزه شما..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "fuck"
msgstr "عجب"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "help"
msgstr "راهنما"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "i love you"
msgstr "دوستت دارم"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "love"
msgstr "دوست داشتنی"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "start the tour"
msgstr "شروع تور"

