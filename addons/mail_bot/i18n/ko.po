"It looks like you're not sure what to do next. Please type %(command_start)s/"
"%(command_end)s to see the suggestions, then select %(command_start)shelp%"
"(command_end)s and press Enter."
msgstr ""

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "메일 봇"

