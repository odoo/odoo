#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Ooooh, das ist wirklich süß, aber so funktionieren Bots nicht. Sie sind zu "
"menschlich für mich! Bleiben wir professionell ❤️"

#. module: mail_bot
#: model:ir.module.module,summary:base.module_mail_bot
msgid "Add OdooBot in discussions"
msgstr "OdooBot in Diskussionen hinzufügen"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
msgid "Disabled"
msgstr "Deaktiviert"

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_discuss_channel
msgid "Discussion Channel"
msgstr "Diskussionskanal"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__display_name
#: model:ir.model.fields,field_description:mail_bot.field_res_users__display_name
msgid "Display Name"
msgstr "Anzeigename"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Go ahead - Try sending me an emoji 😊"
msgstr "Nur zu – versuchen Sie, mir ein Emoji zu senden 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app settings."
msgstr ""
"Großartig! Sie können %(bold_start)svorformulierte Antworten%(bold_end)s in "
"den Einstellungen der Dialog-App anpassen."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid "Hello 👋"
msgstr "Hallo 👋"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Hmmm..."
msgstr "Hmmm..."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "I'm afraid I don't understand. Sorry!"
msgstr "Leider verstehe ich Sie nicht. Es tut mir leid!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide, "
"ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"Ich bin nicht schlau genug, diese Frage zu beantworten.%(new_line)sUm sich "
"meinen Leitfaden anzusehen, %(command_start)sstarten Sie die Tour%"
"(command_end)s."

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#: model:ir.model.fields,field_description:mail_bot.field_mail_bot__id
#: model:ir.model.fields,field_description:mail_bot.field_res_users__id
msgid "ID"
msgstr "ID"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
msgid "Idle"
msgstr "Inaktiv"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"It looks like you're not sure what to do next. Please type %(command_start)s/"
"%(command_end)s to see the suggestions, then select %(command_start)shelp%"
"(command_end)s and press Enter."
msgstr ""
"Sie scheinen nicht zu wissen, was Sie als Nächstes tun sollen. Bitte geben "
"Sie %(command_start)s/%(command_end)s ein, um die Vorschläge zu sehen, "
"wählen Sie dann %(command_start)sHilfe%(command_end)s aus und drücken Sie "
"die Eingabetaste (Enter)."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_mail_bot
msgid "Mail Bot"
msgstr "Mailbot"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
msgid "Not initialized"
msgstr "Nicht initialisiert"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not quite. To continue the tour, please send an emoji by typing %"
"(command_start)s:)%(command_end)s and pressing Enter, or by clicking the %"
"(smile_icon)s icon to pick one."
msgstr ""
"Nicht ganz. Um die Tour fortzusetzen, senden Sie bitte ein Emoji, indem Sie %"
"(command_start)s:)%(command_end)s eingeben und die Eingabetaste (Enter) "
"drücken oder auf das Symbol %(smile_icon)s klicken, um eins auszuwählen."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Not sure what you're doing? Please type %(command_start)s::%(command_end)s "
"to see canned responses. Select one and press Enter."
msgstr ""
"Sie wissen nicht, was Sie tun sollen? Bitte geben Sie %(command_start)s::%"
"(command_end)s ein, um vorformulierte Antworten anzuzeigen. Wählen Sie eine "
"aus und drücken Sie die Eingabetaste (Enter)."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/res_users.py:0
msgid ""
"Odoo's Discuss application helps employees collaborate efficiently. I'm here "
"to help you explore its features."
msgstr ""
"Die Odoo-App Dialog hilft Mitarbeitern, effizient zusammenzuarbeiten. Ich "
"bin hier, um Ihnen dabei zu helfen, die Funktionen zu erkunden."

#. module: mail_bot
#: model:ir.module.module,shortdesc:base.module_mail_bot
msgid "OdooBot"
msgstr "OdooBot"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
msgid "OdooBot Status"
msgstr "OdooBot-Status"

#. module: mail_bot
#: model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
msgid "Odoobot Failed"
msgstr "Odoobot Fehlgeschlagen"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_attachement
msgid "Onboarding attachment"
msgstr "Anhang für Einführung"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_canned
msgid "Onboarding canned"
msgstr "Einführung vorformuliert"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_command
msgid "Onboarding command"
msgstr "Befehl für Einführung"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_emoji
msgid "Onboarding emoji"
msgstr "Emoji für Einführung"

#. module: mail_bot
#: model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
msgid "Onboarding ping"
msgstr "Ping für Einführung"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: %"
"(command_start)sstart the tour%(command_end)s."
msgstr ""
"Tut mir leid, ich bin müde. Oder ich versuche zu verbergen, dass ich die "
"menschliche Sprache nicht verstehe ...%(new_line)sIch kann Ihnen Funktionen "
"zeigen, wenn Sie %(command_start)sTour starten%(command_end)s tippen."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Sorry, I'm not listening right now. To get my attention, %"
"(bold_start)smention me%(bold_end)s by typing %(command_start)s@OdooBot%"
"(command_end)s and selecting me."
msgstr ""
"Entschuldigung, ich höre gerade nicht zu. Um meine Aufmerksamkeit zu "
"erhalten, %(bold_start)serwähnen Sie mich%(bold_end)s, indem Sie %"
"(command_start)s@OdooBot%(command_end)s eingeben und mich auswählen."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks"
msgstr "Dankeschön"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "Thanks for your feedback. Goodbye!"
msgstr "Vielen Dank für Ihr Feedback! Auf Wiedersehen!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr "Das ist nicht nett! Ich bin ein Bot und habe Gefühle ...💔"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"That's the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the tour%"
"(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"Das ist das Ende dieser Übersicht. Sie können %(bold_start)sdiese "
"Unterhaltung schließen%(bold_end)s oder %(command_start)sdie Tour starten%"
"(command_end)s, um sie erneut anzuzeigen. Viel Erfolg beim Erkunden von Odoo!"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
#, fuzzy
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, first click the %"
"(plus_icon)s icon, then select %(paperclip_icon)s Attach files."
msgstr ""
"Um %(bold_start)seinen Anhang zu senden%(bold_end)s, klicken Sie zuerst auf "
"das Symbol %(plus_icon)s und wählen Sie dann %(paperclip_icon)s Dateien "
"anhängen."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "To get started, try sending me an emoji 😊"
msgstr "Um zu beginnen, versuchen Sie, mir ein Emoji zu senden 😊"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"To use special commands, %(bold_start)sstart your message with a %"
"(bold_end)s %(command_start)s/%(command_end)s. For example, try typing %"
"(command_start)s/help%(command_end)s."
msgstr ""
"Um Spezialbefehle zu verwenden, %(bold_start)sbeginnen Sie Ihre Nachricht "
"mit einem %(bold_end)s %(command_start)s/%(command_end)s. Versuchen Sie zum "
"Beispiel, %(command_start)s/help%(command_end)s einzugeben."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand that.%(new_line)sIf you "
"need help exploring our apps, please check out %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour videos%"
"(slides_link_end)s."
msgstr ""
"Leider bin ich nur ein Bot 😞 Das verstehe ich nicht.%(new_line)sWenn Sie "
"Hilfe beim Erkunden unserer Apps benötigen, lesen Sie sich bitte %"
"(document_link_start)sunsere Dokumentation%(document_link_end)s oder schauen "
"Sie %(slides_link_start)sunsere Videos%(slides_link_end)s."

#. module: mail_bot
#: model:ir.model,name:mail_bot.model_res_users
msgid "User"
msgstr "Benutzer"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to "
"use canned responses. I've created a temporary one just for you."
msgstr ""
"Wunderbar! 😇%(new_line)sGeben Sie %(command_start)s::%(command_end)s ein, "
"um Textbausteine zu verwenden. Ich habe eine temporäre Vorlage nur für Sie "
"erstellt."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Wow, you're a natural!%(new_line)s Use @username to mention someone and grab "
"their attention.%(new_line)s %(bold_start)sTry mentioning me by typing%"
"(bold_end)s %(command_start)s@OdooBot%(command_end)s in your message."
msgstr ""
"Wow, Sie sind ein Naturtalent!%(new_line)s Verwenden Sie @Benutzername, um "
"jemanden zu erwähnen und dessen Aufmerksamkeit zu gewinnen.%(new_line)s %"
"(bold_start)sVersuchen Sie, mich zu erwähnen, indem Sie%(bold_end)s %"
"(command_start)s@OdooBot%(command_end)s in Ihrer Nachricht eingeben."

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid ""
"Yep, I'm here! 🎉 %(new_line)sNow, try %(bold_start)ssending an attachment%"
"(bold_end)s 📎 - maybe a picture of your cute dog... 🐕"
msgstr ""
"Ja, ich bin da! 🎉 %(new_line)sVersuchen Sie jetzt, %(bold_start)seinen "
"Anhang zu senden%(bold_end)s 📎 - vielleicht ein Bild Ihres süßen Hundes … 🐕"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "fuck"
msgstr "Mist"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "help"
msgstr "Hilfe"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "i love you"
msgstr "Ich liebe Dich"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "love"
msgstr "Liebe"

#. module: mail_bot
#. odoo-python
#: code:addons/mail_bot/models/mail_bot.py:0
msgid "start the tour"
msgstr "die Tour starten"

msgid "This is a temporary canned response to see how canned responses work."
msgstr ""
"Dies ist eine temporäre vorformulierte Antwort, um zu sehen, wie "
"vorformulierte Antworten funktionieren."
