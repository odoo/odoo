<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="web.DocMethod">
    <article class="o-doc-method mb-3 rounded" t-att-class="this.props.class" t-att-id="this.method.name">
        <div
            class="o-doc-method-header position-sticky d-flex flex-nowrap align-items-center w-100 cursor-pointer rounded bg-1"
            t-on-click="() => this.state.open = !this.state.open"
            t-att-class="{ ['border-bottom']: this.state.open, o_collapsed: !this.state.open }"
            role="button"
        >
            <div class="icon-btn" role="button" t-att-class="{ o_collapsed: !this.state.open }">
                <i class="oi" data-icon="keyboard_arrow_right" aria-hidden="true"></i>
            </div>
            <h4 class="ms-2 mb-0" t-out="this.method.name"></h4>
            <a
                class="ms-2 fs-5"
                t-att-href="'#' + this.method.name"
                t-on-click.stop=""
            >#</a>
            <div class="text-muted ms-auto" t-out="this.method.module"></div>
        </div>

        <div
            t-if="this.state.open"
            class="o-doc-method-content bg-1 d-flex flex-nowrap"
            t-att-class="{ 'flex-column': this.isVertical }"
        >
            <div class="o-doc-method-doc" t-att-class="{ 'w-100': this.isVertical, 'w-50': !this.isVertical }">
                <section>
                    <h4>Route</h4>
                    <DocCopyablePre value="this.method.url"/>
                </section>
                <section t-if="this.doc">
                    <h4>Description</h4>
                    <div class="doc_method_description o-doc-docutils" t-out="this.doc"></div>
                </section>
                <section>
                    <h4>Parameters</h4>
                    <DocTable
                        t-if="this.parametersData.items.length > 0"
                        data="this.parametersData"
                    />
                    <div class="text-muted" t-else="">There's no parameters for this method</div>
                </section>
                <section t-if="(this.method.returnAnnotation || this.method.returnDoc)" class="d-flex flex-column gap-2">
                    <h4 class="mb-0">Return</h4>
                    <DocCopyablePre value="this.method.returnAnnotation" t-if="this.method.returnAnnotation"/>
                    <div class="doc_method_description o-doc-docutils" t-if="this.method.returnDoc" t-out="this.method.returnDoc"/>
                </section>
            </div>
            <div t-att-class="{ 'w-100 pt-4 border-top': this.isVertical, 'w-50 ps-4 border-start': !this.isVertical }">
                <DocRequest url="this.method.url" request="this.request"/>
            </div>
        </div>
    </article>
</t>
</templates>
