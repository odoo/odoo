<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_view_form_product" model="ir.ui.view">
        <field name="name">resource.asset.form.product</field>
        <field name="model">resource.asset</field>
        <field name="inherit_id" ref="resource_asset.resource_asset_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_logs"
                    type="object"
                    icon="fa-book"
                    groups="resource_asset.group_asset_user"
                    class="oe_stat_button">
                    <field name="log_count" string="Ledger" widget="statinfo" />
                </button>
                <button
                    name="action_view_parts"
                    type="object"
                    string="Parts"
                    icon="fa-cogs"
                    groups="resource_asset.group_asset_user"
                    class="oe_stat_button" />
                <button
                    name="action_view_flagged_parts"
                    type="object"
                    icon="fa-flag"
                    groups="resource_asset.group_asset_user"
                    invisible="not part_flagged_count"
                    class="oe_stat_button text-danger">
                    <field
                        name="part_flagged_count"
                        string="Flagged Parts"
                        widget="statinfo" />
                </button>
            </div>
            <field name="kind_id" position="before">
                <field name="product_id" />
            </field>
            <page name="meters" position="after">
                <page
                    name="ledger"
                    string="Ledger"
                    groups="resource_asset.group_asset_user">
                    <field name="log_ids">
                        <list>
                            <field name="date" />
                            <field name="log_type" />
                            <field name="product_id" />
                            <field name="vendor_id" optional="hide" />
                            <field name="state" widget="badge" />
                            <field name="amount" sum="Total" />
                            <field name="currency_id" column_invisible="True" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="resource_asset_view_search_product" model="ir.ui.view">
        <field name="name">resource.asset.search.product</field>
        <field name="model">resource.asset</field>
        <field name="inherit_id" ref="resource_asset.resource_asset_view_search" />
        <field name="arch" type="xml">
            <field name="kind_id" position="after">
                <field name="product_id" />
            </field>
            <filter name="group_state" position="after">
                <filter
                    name="group_product"
                    string="Model"
                    context="{'group_by': 'product_tmpl_id'}" />
            </filter>
        </field>
    </record>

</odoo>
