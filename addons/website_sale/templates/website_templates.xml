                _link_class.f="o_navlink_background btn position-relative rounded-pill p-1 text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"/>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _item_class.f="position-relative"
                _btn_class.f="nav-link"
                _dropdown_menu_class.f="dropdown-menu-end"
                _txt_class.f="small"
            />
        </t>
    </template>

    <template id="website_sale.template_header_sidebar" inherit_id="website.template_header_sidebar">
        <xpath expr="//t[@t-call='website.placeholder_header_brand']" position="after">
            <ul class="list-unstyled d-flex gap-1 ms-auto mb-0">
                <t t-call="website_sale.header_cart_link"
                    _icon="True"
                    _link_class.f="o_navlink_background btn position-relative p-1 rounded-circle text-reset"
                    _badge_class.f="position-absolute top-0 end-0 rounded-pill mt-n1 me-n1"/>
                <t t-call="website_sale.header_wishlist_link"
                    _icon="True"
                    _link_class.f="o_navlink_background btn position-relative p-1 rounded-circle text-reset"
                    _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"/>
            </ul>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _div_classes.f="dropup"
                _btn_class.f="{{_additional_btn_color or 'nav-link'}} d-flex align-items-center w-100"
                _dropdown_menu_class.f="w-100"
                _txt_class.f="me-auto small"
            />
        </t>
    </template>

    <template id="website_sale.template_header_boxed" inherit_id="website.template_header_boxed">
        <xpath expr="//t[@t-call='website.placeholder_header_search_box']" position="before">
            <t t-call="website_sale.header_cart_link"
                _icon="True"
                _link_class.f="o_navlink_background btn position-relative rounded-circle p-1 text-center text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"/>
            <t t-call="website_sale.header_wishlist_link"
                _icon="True"
                _link_class.f="o_navlink_background btn position-relative rounded-circle p-1 text-center text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"/>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _btn_class.f="{{_additional_btn_color or 'nav-link'}} d-flex align-items-center gap-1 border-0 rounded-pill px-3"
                _dropdown_menu_class.f="dropdown-menu-end"
                _txt_class.f="small"
            />
        </t>
    </template>

    <template id="website_sale.brand_promotion" inherit_id="website.brand_promotion">
        <xpath expr="//t[@t-call='web.brand_promotion_message']" position="replace">
            <t t-set="_message">
                    The #1 <a target="_blank" href="http://www.odoo.com/app/ecommerce?utm_source=db&amp;utm_medium=website">Open Source eCommerce</a>
            </t>
            <t t-call="web.brand_promotion_message" _message="_message" _utm_medium.f="website"/>
        </xpath>
    </template>

    <template id="website_sale.search_result_items" inherit_id="website.search_result_items">
        <xpath expr="//div[hasclass('o_search_result_description')]" position="inside">
            <div t-if="result.get('attribute_value_ids')"
                class="o_line_clamp o_line_clamp_1 mb-0"
                t-out="result['attribute_value_ids']"/>
            <p t-elif="result.get('description_sale')"
                class="o_line_clamp o_line_clamp_1 mb-0 small"
                t-out="result['description_sale']"/>
        </xpath>
    </template>

    <template id="robots" inherit_id="website.robots">
        <xpath expr="//t[@id='robots_module_rules']" position="inside">
<t t-translation="off">
Disallow: /shop/cart
Disallow: /*/shop/cart
Disallow: /shop/checkout
Disallow: /*/shop/checkout
Disallow: /shop/payment
Disallow: /*/shop/payment
Disallow: /shop/confirmation
Disallow: /*/shop/confirmation
</t>
        </xpath>
    </template>

    <template
        id="website_sale.placeholder_header_pricelist_selector"
        name="Placeholder Header Pricelist Selector"
    />

    <template
        id="website_sale.header_pricelist_selector"
        inherit_id="website_sale.placeholder_header_pricelist_selector"
        name="Header Pricelist Selector"
    >
        <xpath expr="." position="inside">
            <li
                t-if="
                    not hide_pricelist_selector
                    and website_sale_pricelists
                    and len(website_sale_pricelists) &gt; 1
                "
                name="header_pricelist_selector"
                t-attf-class="o_header_pricelist_selector #{_item_class}"
            >
                <t t-call="website_sale.pricelist_selector" _div_classes.f="#{_div_classes} dropdown"/>
            </li>
        </xpath>
    </template>

    <template
        id="website_sale.footer_pricelist_selector"
        inherit_id="portal.frontend_layout"
        name="Footer Pricelist Selector"
        priority="10"
    >
        <xpath expr="//span[hasclass('o_footer_copyright_name')]" position="replace">
            <div class="d-flex flex-column-reverse flex-md-row align-items-center gap-2">
                <div class="flex-md-shrink-0">$0</div>
                <div class="d-flex align-items-center gap-2 min-w-0 mw-100">
                    <t
                        t-call="website_sale.pricelist_selector"
                        _div_classes.f="dropup flex-grow-1 min-w-0"
                        _btn_class.f="d-inline-flex align-items-center btn btn-secondary btn-sm border-0 min-w-0 w-100"
                    />
                </div>
            </div>
        </xpath>
    </template>

    <template
        id="website_sale.footer_pricelist_selector_with_language_selector"
        inherit_id="website_sale.footer_pricelist_selector"
        active="False"
    >
        <t t-call="website_sale.pricelist_selector" position="before">
            <t id="language_selector_hook" position="move"/>
        </t>
    </template>

    <template id="website_sale.pricelist_selector" name="Pricelist Selector">
        <div
            t-if="
                not hide_pricelist_selector
                and website_sale_pricelists
                and len(website_sale_pricelists) &gt; 1
            "
            name="pricelist_selector"
            t-attf-class="#{_div_classes or 'dropdown'} o_typeahead d-print-none"
        >
            <t t-set="active_pricelist" t-value="website.pricelist_id"/>
            <button
                t-attf-class="dropdown-toggle #{_btn_class or 'btn btn-sm btn-secondary border-0'}"
                type="button"
                data-bs-toggle="dropdown"
                data-bs-auto-close="true"
                aria-haspopup="true"
                aria-expanded="false"
                t-attf-aria-label="Pricelist: #{active_pricelist.name}"
            >
                <span t-attf-class="text-truncate #{_txt_class}" t-out="active_pricelist.name"/>
            </button>
            <div t-attf-class="dropdown-menu #{_dropdown_menu_class}">
                <a
                    t-foreach="website_sale_pricelists"
                    t-as="pricelist"
                    t-attf-class="dropdown-item {{pricelist == active_pricelist and 'active'}}"
                    t-att-aria-current="pricelist == active_pricelist and 'true'"
                    t-attf-href="/shop/change_pricelist/#{pricelist.id}"
                >
                    <span t-att-class="_txt_class" t-out="pricelist.name"/>
                </a>
            </div>
        </div>
    </template>

    <template id="website_sale.typeahead_language_selector" inherit_id="portal.language_selector">
        <xpath expr="//div[contains(@t-attf-class, 'js_language_selector')]" position="attributes">
            <attribute name="t-attf-class" add="o_typeahead" separator=" "/>
        </xpath>
        <xpath expr="//a[hasclass('dropdown-item')]" position="attributes">
            <attribute name="t-att-data-value">lg.name.split('/').pop()</attribute>
        </xpath>
    </template>

</odoo>
