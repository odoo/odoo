        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _btn_class.f="btn rounded-circle text-reset o_navlink_background"
                _dropdown_menu_class.f="dropdown-menu-end"
                _txt_class.f="small"
            />
        </t>
    </template>

    <template id="website_sale.template_header_sales_two" inherit_id="website.template_header_sales_two">
        <xpath expr="//t[@t-call='portal.placeholder_user_sign_in']" position="before">
            <t t-call="website_sale.header_cart_link"
                _icon="True"
                _text="True"
                _icon_wrap_class.f="o_navlink_background position-relative me-2 rounded-circle p-2 transition-base"
                _link_class.f="o_navlink_trigger_hover btn d-flex align-items-center fw-bold text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"
                _text_class.f="small"/>
            <t t-call="website_sale.header_wishlist_link"
                _icon="True"
                _text="True"
                _icon_wrap_class.f="o_navlink_background position-relative me-2 rounded-circle p-2 transition-base"
                _link_class.f="o_navlink_trigger_hover btn d-flex align-items-center fw-bold text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"
                _text_class.f="small"/>
        </xpath>
        <xpath expr="//div[hasclass('o_header_sales_two_top')]" position="attributes">
            <attribute name="t-if" add="is_view_active('website_sale.header_pricelist_selector')" separator="or"/>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="replace">
            <li class="d-flex align-items-center">
                <ul class="navbar-nav flex-row align-items-center gap-2">
                    <t>$0</t>
                    <t
                        t-call="website_sale.placeholder_header_pricelist_selector"
                        _div_classes.f="d-flex align-items-center h-100"
                        _btn_class.f="btn btn-sm btn-outline-secondary border-0"
                    />
                </ul>
            </li>
        </t>
        <!-- We replaced the language selector by an always visible `<li>` element,
             making the dedicated spacer redundant. -->
        <xpath expr="//li[hasclass('o_header_sales_two_lang_selector_placeholder')]" position="replace"/>
    </template>

    <template id="website_sale.template_header_sales_three" inherit_id="website.template_header_sales_three">
        <xpath expr="//t[@t-call='website.placeholder_header_language_selector']" position="before">
            <t t-call="website_sale.header_cart_link"
                _text="True"
                _item_class.f="position-relative"
                _link_class.f="nav-link d-flex flex-row-reverse align-items-center text-uppercase fw-bold"
                _icon_wrap_class.f="d-contains"
