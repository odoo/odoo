                _link_class.f="o_navlink_background btn position-relative rounded-circle p-1 text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"/>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _btn_class.f="o_navlink_background btn text-reset"
                _dropdown_menu_class.f="dropdown-menu-end"
            />
        </t>
    </template>

    <template id="website_sale.template_header_search" inherit_id="website.template_header_search">
        <xpath expr="//t[@t-call='portal.placeholder_user_sign_in']" position="before">
            <t t-call="website_sale.header_cart_link"
                _text="True"
                _item_class.f="border-start o_border_contrast"
                _link_class.f="o_navlink_background_hover btn btn-sm d-flex align-items-center gap-1 h-100 rounded-0 p-2 text-reset"
                _badge_class.f="rounded"/>
            <t t-call="website_sale.header_wishlist_link"
                _text="True"
                _item_class.f="border-start o_border_contrast"
                _link_class.f="o_navlink_background_hover btn btn-sm d-flex align-items-center gap-1 h-100 rounded-0 p-2 text-reset"
                _badge_class.f="rounded"/>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _div_classes.f="h-100 border-end o_border_contrast"
                _btn_class.f="o_navlink_background_hover btn btn-sm d-flex align-items-center h-100 rounded-0 p-2 text-reset"
            />
        </t>
    </template>

    <template id="website_sale.template_header_sales_one" inherit_id="website.template_header_sales_one">
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="before">
            <t t-call="website_sale.header_cart_link"
                _icon="True"
                _link_class.f="btn position-relative rounded-circle p-1 text-reset o_navlink_background"
