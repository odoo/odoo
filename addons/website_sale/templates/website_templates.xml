            <t t-call="website_sale.header_wishlist_link"
                _icon="True"
                _link_class.f="o_navlink_background btn position-relative rounded-circle p-1 text-center text-reset"
                _badge_class.f="position-absolute top-0 end-0 mt-n1 me-n1 rounded-pill"/>
        </xpath>
        <t t-call="website.placeholder_header_language_selector" position="after">
            <t
                t-call="website_sale.placeholder_header_pricelist_selector"
                _btn_class="_additional_btn_color or 'nav-link'"
                _dropdown_menu_class.f="dropdown-menu-end"
            />
        </t>
    </template>

    <template id="website_sale.template_header_hamburger" inherit_id="website.template_header_hamburger">
        <xpath expr="//t[@t-call='portal.placeholder_user_sign_in']" position="before">
            <t t-call="website_sale.header_cart_link"
