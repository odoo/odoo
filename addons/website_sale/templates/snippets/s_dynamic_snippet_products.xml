<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="website_sale.s_dynamic_snippet_product_grid_template"
        inherit_id="website.s_dynamic_snippet_template"
        primary="True"
    >
        <section id="main_section" position="attributes">
            <attribute name="t-att-data-grid-columns">'3'</attribute>
            <attribute name="t-att-data-number-of-records">'6'</attribute>
            <attribute name="t-att-data-mobile-columns">'2'</attribute>
        </section>
    </template>

    <!-- Snippets -->
    <template id="website_sale.s_dynamic_snippet_products" name="Products">
        <t t-set="snippet_name" t-value="snippet_name or 's_dynamic_snippet_products'"/>
        <t
            t-set="default_design_classes"
            t-value="env.website._get_shop_products_design_classes()"
        />
        <t t-set="snippet_title" t-valuef="Our latest products"/>
        <t t-set="snippet_description" t-valuef="Explore our curated selection and find the products that perfectly match your needs."/>
        <t t-set="snippet_button_text" t-valuef="Shop all"/>
        <t t-set="snippet_heading_extra_classes" t-valuef="flex-column justify-content-between"/>
        <t t-set="snippet_button_classes" t-valuef="btn btn-secondary"/>
        <!--
            TODO: `.oe_website_sale` is used as a selector in `tracking.js`. This
            is a temporary solution to load the tracking utilities and will be removed once
            tracking utilities will be fully integrated into a service.
        -->
        <!-- Force default single mode using the `o_carousel_multi_items` class -->
        <t t-call="website.s_dynamic_snippet_template"
            snippet_name="snippet_name"
            snippet_classes="'oe_website_sale o_dynamic_carousel_snippet s_dynamic_snippet_products o_carousel_multi_items ' + default_design_classes"
            main_page_url.f="/shop">
            <t t-call="website_sale.s_dynamic_snippet_products_preview_data"/>
        </t>
    </template>

    <template
        name="Products Carousel"
        id="website_sale.s_dynamic_snippet_products_carousel"
        inherit_id="website_sale.s_dynamic_snippet_products"
        primary="True"
    >
        <t t-set="snippet_name" position="attributes">
            <attribute name="t-value">'s_dynamic_snippet_products_carousel'</attribute>
        </t>
    </template>

    <template
        name="Products Grid"
        id="website_sale.s_dynamic_snippet_products_grid"
        inherit_id="website_sale.s_dynamic_snippet_products_carousel"
        primary="True"
    >
        <t t-set="snippet_name" position="attributes">
            <attribute name="t-value">'s_dynamic_snippet_products_grid'</attribute>
        </t>
        <t t-call="website.s_dynamic_snippet_template" position="attributes">
            <attribute name="t-call">website_sale.s_dynamic_snippet_product_grid_template</attribute>
        </t>
        <t t-call="website_sale.s_dynamic_snippet_products_preview_data" position="attributes">
            <attribute name="t-call">website_sale.s_dynamic_snippet_products_grid_preview_data</attribute>
        </t>
    </template>
    <!-- Multi record snippets (coming soon...) -->
    <!-- Single record snippets (coming soon...) -->

</odoo>
