<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t
        t-name="website_sale.DynamicSnippetCategoryOptions"
        name="Category List"
        t-inherit="website.DynamicSnippetOption"
    >
        <BuilderRow id="this.template_opt_row" position="replace"/>
        <BuilderRow id="this.number_of_records_opt_row" position="replace"/>
        <BuilderRow id="this.filter_opt_row" position="replace"/>
        <BuilderRow id="this.section_title_opt_row" position="after">
            <BuilderRow label.translate="Filters">
                <BuilderSelect dataAttributeAction="'parentCategoryId'" preview="false">
                    <BuilderSelectItem
                        dataAttributeActionValue=""
                        title.translate="All Categories"
                    >
                        All Categories
                    </BuilderSelectItem>
                    <t
                        t-foreach="this.categories"
                        t-as="category"
                        t-key="category.id"
                    >
                        <BuilderSelectItem
                            dataAttributeActionValue="`${category.id}`"
                            label="category.name"
                            t-out="category.name"
                        />
                    </t>
                </BuilderSelect>
            </BuilderRow>
            <BuilderRow
                t-if="this.dynamicOptionParams.domState.parentCategoryId"
                label.translate="Parent Category"
                dataAttributeAction="'showParent'"
                preview="false"
            >
                <BuilderCheckbox dataAttributeActionValue="'true'"/>
            </BuilderRow>
            <BuilderRow label.translate="Size">
                <BuilderSelect>
                    <BuilderSelectItem classAction="'s_dynamic_category_size_small'">
                        Small
                    </BuilderSelectItem>
                    <BuilderSelectItem classAction="'s_dynamic_category_size_medium'">
                        Medium
                    </BuilderSelectItem>
                    <BuilderSelectItem classAction="'s_dynamic_category_size_large'">
                        Large
                    </BuilderSelectItem>
                </BuilderSelect>
            </BuilderRow>
            <BuilderRow label.translate="Columns">
                <BuilderRange
                    action="'setClassRange'"
                    actionParam="[
                        's_dynamic_category_columns_2',
                        's_dynamic_category_columns_3',
                        's_dynamic_category_columns_4',
                        's_dynamic_category_columns_5'
                    ]"
                    max="3"
                />
            </BuilderRow>
            <BuilderRow label.translate="Spacing">
                <BuilderRange
                    action="'setClassRange'"
                    actionParam="[
                        's_dynamic_category_gap_0',
                        's_dynamic_category_gap_1',
                        's_dynamic_category_gap_2',
                        's_dynamic_category_gap_3',
                        's_dynamic_category_gap_4',
                        's_dynamic_category_gap_5'
                    ]"
                    max="5"
                />
            </BuilderRow>
            <BuilderRow label.translate="Roundness">
                <BuilderRange
                    action="'setClassRange'"
                    actionParam="[
                        's_dynamic_category_rounded_0',
                        's_dynamic_category_rounded_1',
                        's_dynamic_category_rounded_2',
                        's_dynamic_category_rounded_3',
                        's_dynamic_category_rounded_4',
                        's_dynamic_category_rounded_5'
                    ]"
                    max="5"
                />
            </BuilderRow>
            <BuilderRow label.translate="Alignment">
                <BuilderButtonGroup>
                    <BuilderButton classAction="'s_dynamic_category_alignment_left'">
                        <i class="oi oi-fw" data-icon="format_align_left"/>
                    </BuilderButton>
                    <BuilderButton classAction="'s_dynamic_category_alignment_center'">
                        <i class="oi oi-fw" data-icon="format_align_center"/>
                    </BuilderButton>
                    <BuilderButton classAction="'s_dynamic_category_alignment_right'">
                        <i class="oi oi-fw" data-icon="format_align_right"/>
                    </BuilderButton>
                </BuilderButtonGroup>
            </BuilderRow>
            <BuilderRow label.translate="Clickable items">
                <BuilderCheckbox
                    id="'clickable_items_opt'"
                    action="'toggleClickable'"
                    classAction="'s_dynamic_category_clickable_items'"
                    preview="false"
                />
            </BuilderRow>
            <BuilderRow
                t-if="this.isActiveItem('clickable_items_opt')"
                label.translate="Arrows"
                level="1"
            >
                <BuilderCheckbox
                    classAction="'s_dynamic_category_no_arrows'"
                    inverseAction="true"
                />
            </BuilderRow>
            <BuilderRow
                t-if="this.isActiveItem('clickable_items_opt')"
                label.translate="Color Filter"
                level="1"
            >
                <BuilderColorPicker
                    styleAction="'--category-overlay-color'"
                    defaultOpacity="50"
                    enabledTabs="['custom', 'gradient']"
                    grayscales="{
                        'transparent': [
                            'black-75',
                            'black-50',
                            'black-25',
                            'black-15',
                            'white-25',
                            'white-50',
                            'white-75',
                            'white-85'
                        ],
                        'solid': [],
                    }"
                />
            </BuilderRow>
            <BuilderRow label.translate="Button" t-if="!this.isActiveItem('clickable_items_opt')">
                <BuilderTextInput dataAttributeAction="'button'" preview="false"/>
            </BuilderRow>
        </BuilderRow>
    </t>
    <t t-name="website_sale.dynamicSnippetCategoryItemOptions" name="Category">
        <BuilderRow label.translate="Media">
            <BuilderButton
                label.translate="Replace"
                className="'w-100'"
                type="'success'"
                action="'setCategoryImage'"
                preview="false"
            />
        </BuilderRow>
    </t>
</templates>
