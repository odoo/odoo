<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_sale.ProductAttributeOption">
    <BuilderRow
        t-if="this.domState.canShowThumbnails"
        label.translate="Thumbnails"
        tooltip.translate="Use product variant images instead of the attribute values displays"
    >
        <BuilderCheckbox action="'productAttributeThumbnail'"/>
    </BuilderRow>
    <BuilderRow t-if="!this.domState.isThumbnailVisible" label.translate="Display Type">
        <BuilderSelect action="'productAttributeDisplay'">
            <BuilderSelectItem actionValue="'radio'">Radio</BuilderSelectItem>
            <BuilderSelectItem actionValue="'pills'">Pills</BuilderSelectItem>
            <BuilderSelectItem actionValue="'select'">Select</BuilderSelectItem>
            <BuilderSelectItem actionValue="'color'">Color</BuilderSelectItem>
            <BuilderSelectItem actionValue="'image'">Image</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
</t>

</templates>
