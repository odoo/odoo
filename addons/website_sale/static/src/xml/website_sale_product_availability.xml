<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="website_sale.product_availability">
        <div
            t-if="this.is_storable and !this.prevent_sale"
            id="product_stock_availability"
        >
            <div
                t-if="this.free_qty lte 0"
                t-attf-class="availability_message_#{this.product_template} d-flex flex-column gap-2 mb-4"
            >
                <div id="out_of_stock_message" class="d-flex flex-column gap-1 align-items-start">
                    <t
                        t-if="this.allow_out_of_stock_order and this.has_out_of_stock_message"
                        t-out="this.out_of_stock_message"
                    />
                    <t t-elif="this.has_out_of_stock_message">
                        <div class="d-inline-flex align-items-center badge text-start text-bg-danger text-wrap">
                            <i class="oi oi-filled me-2 text-danger" data-icon="circle"/>
                            <span>
                                <t t-out="this.out_of_stock_message"/>
                            </span>
                        </div>
                    </t>
                    <t t-elif="!this.allow_out_of_stock_order">
                        <div class="badge text-bg-danger">
                            <i class="oi oi-filled me-2 text-danger" data-icon="circle"/>Out of Stock
                        </div>
                    </t>
                </div>
            </div>
            <div
                id="threshold_message"
                t-elif="this.show_availability and this.free_qty lte this.available_threshold"
                t-attf-class="availability_message_#{this.product_template} my-3 badge text-bg-warning"
            >
                <i class="oi oi-filled text-warning me-2" data-icon="circle" role="presentation"/>
                <t t-out="this.formatQuantity(this.free_qty)"/><t t-if="this.uom_name" t-out="' ' + this.uom_name"/> in stock
                <span
                    id="already_in_cart_message"
                    t-if="!this.allow_out_of_stock_order and this.show_availability and this.cart_qty"
                    t-attf-class="availability_message_#{this.product_template}"
                >
                    <t t-if="!this.free_qty">
                        You already added all the available product in your cart
                    </t>
                    <t t-else="">
                        (<t t-out="this.cart_qty" /> in your cart)
                    </t>
                </span>
            </div>
        </div>
    </t>
</templates>
