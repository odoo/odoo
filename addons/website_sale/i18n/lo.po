#. module: website_sale
#: model:mail.template,body_html:website_sale.email_template_back_in_stock
msgid ""
"<t t-set=\"website\" t-value=\"object.website_id or object.env.website or "
"object.env.website.browse(env.context.get('host_id'))\"/>\n"
"                <div style=\"margin: 0px; padding: 0px;\">\n"
"                    <t t-if=\"website\" t-set=\"logo_src\" t-"
"value=\"website.image_url(website, 'logo')\"/>\n"
"                    <t t-else=\"\" t-set=\"logo_src\" t-valuef=\"/logo.png?"
"company=#{object.company_id.id}\"/>\n"
"                    <img t-att-src=\"logo_src\" style=\"display:block; "
"height:50px; margin:0 0 16px;\" alt=\"Logo\"/>\n"
"                    <p>\n"
"                        Hello <t t-out=\"ctx.get('customer_name')"
"\">Customer</t>,\n"
"                    </p>\n"
"                    <p>The product you were waiting for is now back in stock!"
"</p>\n"
"                    <div t-if=\"not is_html_empty(user.signature)\" "
"style=\"font-size: 14px; margin: 0 0 16px;\">\n"
"                        <t t-out=\"user.signature or ''\">Mitchell Admin</"
"t>\n"
"                    </div>\n"
"                    <div t-attf-style=\"margin-bottom: 22px; font-size: 14px;"
"\">\n"
"                        <a t-att-href=\"website.get_base_url() + "
"object.website_url\" t-attf-style=\"background-color: "
"{{website.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{website.company_id.email_primary_color or '#fff'}}; border-radius: 5px; "
"font-size:14px;\">\n"
"                            Order Now\n"
"                        </a>\n"
"                    </div>\n"
"                    <div style=\"margin-bottom: 12px;\">\n"
"                        <table role=\"presentation\" width=\"100%\" "
"style=\"max-width: 590px; border-collapse: collapse; font-size: 14px;\">\n"
"                            <tr>\n"
"                                <td width=\"24%\" style=\"max-width: 120px; "
"padding: 0 10px 10px 0; vertical-align: top;\">\n"
"                                    <img t-att-"
"src=\"website.image_url(object, 'image_1920')\" style=\"width: 100px; "
"height: 100px; object-fit: contain;\" alt=\"Product image\"/>\n"
"                                </td>\n"
"                                <td style=\"padding-bottom: 8px; vertical-"
"align: top;\">\n"
"                                    <h2 t-att-style=\"'margin:0; font-"
"size:14px; color:%s;' % ((website and "
"website.company_id.email_secondary_color) or '#875A7B')\">\n"
"                                        <strong t-out=\"object.name or "
"''\">Desk Combination</strong>\n"
"                                    </h2>\n"
"                                    <p t-"
"if=\"object.product_template_attribute_value_ids\" style=\"margin: 4px "
"0;\">\n"
"                                        ( <t t-out=\"', "
"'.join(object.product_template_attribute_value_ids.mapped('name'))\">Wood</"
"t> )\n"
"                                    </p>\n"
"                                    <t t-out=\"object.description_ecommerce "
"or ''\">Desk Description</t>\n"
"                                </td>\n"
"                                <td width=\"19%\" align=\"right\" "
"style=\"max-width: 100%; vertical-align: top;\">\n"
"                                    <t t-"
"out=\"format_amount(ctx.get('product_price') or 0, object.currency_id)\">$ "
"450</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""

#. module: website_sale
#: model:mail.template,body_html:website_sale.mail_template_sale_withdrawal_request_confirmation
msgid ""
"<t>\n"
"Hello,<br/><br/>\n"
"This email confirms that we have received your request to cancel Order <t t-"
"out=\"object.name\">S00001</t>.<br/><br/>\n"
"Our team is currently reviewing your request. We will notify you once it is "
"processed.<br/><br/>\n"
"Sincerely,<br/>\n"
"<t t-out=\"(object.company_id or object.user_id.company_id or "
"user.company_id).name\">YourCompany</t> Team\n"
"</t>\n"
"            "
msgstr ""
"<t>\n"
"ສະບາຍດີ,<br/><br/>\n"
"ອີເມວນີ້ເປັນການຢືນຢັນວ່າພວກເຮົາໄດ້ຮັບຄຳຮ້ອງຂໍຍົກເລີກການສັ່ງຊື້ <t t-"
"out=\"object.name\">S00001</t> ຂອງທ່ານແລ້ວ.<br/><br/>\n"
"ທີມງານຂອງພວກເຮົາກຳລັງກວດສອບຄຳຮ້ອງຂໍຂອງທ່ານ ແລະ ຈະແຈ້ງໃຫ້ທ່ານຊາບເມື່ອດຳເນີນການແລ້ວ.<br/"
"><br/>\n"
"ດ້ວຍຄວາມນັບຖື,<br/>\n"
"ທີມງານ <t t-out=\"(object.company_id or object.user_id.company_id or "
"user.company_id).name\">YourCompany</t>\n"
"</t>\n"
"            "

#. module: website_sale
#: model:mail.template,body_html:website_sale.mail_template_sale_cart_recovery
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" "
"style=\"max-width: 590px; padding: 0px; background-color: white; color: "
"#454748; border-collapse: collapse;\" role=\"presentation\">\n"
"<tbody>\n"
"    <!-- CONTENT -->\n"
"    <tr>\n"
"        <td align=\"center\" style=\"min-width: 590px;\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" "
"width=\"100%\" style=\"max-width: 590px; background-color: white; padding: "
"0px 0px 0px 0px; border-collapse:collapse;\" role=\"presentation\">\n"
"                <tr><td valign=\"top\" style=\"font-size: 14px;\">\n"
"                    <t t-set=\"color\" t-"
"value=\"object.company_id.email_secondary_color or '#875A7B'\"/>\n"
"                    <t t-if=\"'website_id' in object and object.website_id\" "
"t-set=\"logo_src\" t-value=\"object.website_id.image_url(object.website_id, "
"'logo')\"/>\n"
"                    <t t-else=\"\" t-set=\"logo_src\" t-valuef=\"/logo.png?"
"company=#{object.company_id.id}\"/>\n"
"                    <img t-att-src=\"logo_src\" style=\"display: block; "
"height: 50px; margin: 0 0 16px;\" alt=\"Logo\"/>\n"
"                    <p style=\"margin: 0 0 12px; line-height: 18px;\">\n"
"                        Hello <t t-out=\"object.partner_id.display_name or "
"''\">Johnny Tester</t>,\n"
"                        <br/><br/>\n"
"                        You did not complete your online order.<br/>\n"
"                        Do you have any question about our products?<br/>\n"
"                        Just reply to this email to discuss!<br/>\n"
"                    </p>\n"
"                    <t t-if=\"not is_html_empty(user.signature)\">\n"
"                        <div style=\"font-size: 14px; margin: 0 0 16px;\"><t "
"t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"                    </t>\n"
"                    <t t-if=\"'hide_recovery_button' not in ctx\">\n"
"                        <div t-attf-style=\"margin-bottom: 22px; font-size: "
"14px;\">\n"
"                            <a t-attf-href=\"{{ object.get_base_url() }}/"
"shop/cart?id={{ object.id }}&amp;access_token={{ object.access_token }}\" "
"target=\"_blank\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#fff'}}; border-radius: 5px; "
"font-size:14px;\">\n"
"                                Resume order\n"
"                            </a>\n"
"                        </div>\n"
"                    </t>\n"
"                    <t t-if=\"object.order_line\">\n"
"                        <!-- The following loop is also used in the addons > "
"sale > data > mail_template_data.xml file because we want the same layout. --"
">\n"
"                        <t t-foreach=\"object.order_line\" t-as=\"line\">\n"
"                            <t t-if=\"(not hasattr(line, 'is_delivery') or "
"not line.is_delivery) and not line.combo_item_id\">\n"
"                                <table width=\"100%\" style=\"max-width: "
"590px; color: #454748; font-size: 14px; border-collapse: collapse;\" "
"role=\"presentation\">\n"
"                                    <tr>\n"
"                                        <td width=\"24%\" style=\"max-width: "
"120px; padding: 0 10px 10px 0; vertical-align: top;\">\n"
"                                            <img t-attf-src=\"/web/image/"
"product.product/{{ line.product_id.id }}/image_128\" style=\"width: 100px; "
"height: 100px; object-fit: contain;\" alt=\"Product image\"/>\n"
"                                        </td>\n"
"                                        <td align=\"left\" style=\"vertical-"
"align: top; padding-bottom: 22px;\">\n"
"                                            <h3 t-attf-style=\"mso-line-"
"height-rule:exactly; margin:0; font-size: 14px; color: {{color}}; {{'margin-"
"bottom: 6px;' if line.product_type == 'combo' else ''}}\">\n"
"                                                <strong t-"
"out=\"line.product_id.name or ''\">Taking care of Trees Course</strong>\n"
"                                                <span t-"
"if=\"line.product_id.product_template_attribute_value_ids\" style=\"color: "
"#6c757d;\">\n"
"                                                    <t t-out=\"', "
"'.join(line.product_id.product_template_attribute_value_ids.mapped('name'))"
"\"/>\n"
"                                                </span>\n"
"                                            </h3>\n"
"                                            <t t-set=\"combo_line_idx\" t-"
"value=\"0\"/>\n"
"                                            <t t-set=\"totalComboLines\" t-"
"value=\"0\"/>\n"
"                                            <t t-set=\"line_idx\" t-"
"value=\"line_index\"/>\n"
"                                            <t t-"
"foreach=\"object.order_line\" t-as=\"combo_liness\">\n"
"                                                <t t-if=\"(not hasattr(line, "
"'is_delivery') or not line.is_delivery) and (combo_liness.linked_line_id.id "
"== line.id) and line_idx == line_index\">\n"
"                                                    <t t-"
"if=\"combo_liness.linked_line_id.id == line.id and combo_liness.id != "
"line.id\">\n"
"                                                        <t t-"
"set=\"totalComboLines\" t-value=\"totalComboLines + 1\"/>\n"
"                                                    </t>\n"
"                                                </t>\n"
"                                            </t>\n"
"                                            <t t-"
"foreach=\"object.order_line\" t-as=\"combo_line\">\n"
"                                                <t t-if=\"(not hasattr(line, "
"'is_delivery') or not line.is_delivery) and (combo_line.linked_line_id.id == "
"line.id) and combo_line.combo_item_id and line_idx == line_index\">\n"
"                                                        <t t-"
"set=\"borderRadiusStyle\" t-value=\"''\"/>\n"
"                                                        <t t-"
"set=\"borderTopStyle\" t-value=\"''\"/>\n"
"                                                        <t t-"
"set=\"borderBottomStyle\" t-value=\"''\"/>\n"
"\n"
"                                                        <t t-"
"if=\"combo_line.linked_line_id.id == line.id and combo_line.id != "
"line.id\">\n"
"                                                            <t t-"
"set=\"combo_line_idx\" t-value=\"combo_line_idx + 1\"/>\n"
"                                                        </t>\n"
"                                                        <t t-"
"elif=\"combo_line.id == line.id and line_idx != line_index\">\n"
"                                                            <t t-"
"set=\"combo_line_idx\" t-value=\"0\"/>\n"
"                                                        </t>\n"
"                                                        <t t-"
"if=\"combo_line_idx == 1\">\n"
"                                                            <t t-"
"if=\"totalComboLines != 1\">\n"
"                                                                <t t-"
"set=\"borderRadiusStyle\" t-value=\"'border-radius: 6px 6px 0 0;'\"/>\n"
"                                                                <t t-"
"set=\"borderBottomStyle\" t-value=\"'border-bottom: none;'\"/>\n"
"                                                            </t>\n"
"                                                            <t t-else=\"\">\n"
"                                                                <t t-"
"set=\"borderRadiusStyle\" t-value=\"'border-radius: 6px;'\"/>\n"
"                                                            </t>\n"
"                                                        </t>\n"
"                                                        <t t-"
"elif=\"totalComboLines == combo_line_idx\">\n"
"                                                            <t t-"
"set=\"borderRadiusStyle\" t-value=\"'border-radius: 0 0 6px 6px;'\"/>\n"
"                                                            <t t-"
"if=\"totalComboLines != 2\">\n"
"                                                                <t t-"
"set=\"borderTopStyle\" t-value=\"'border-top: none;'\"/>\n"
"                                                            </t>\n"
"                                                        </t>\n"
"                                                        <div t-attf-"
"style=\"width: 100%; border: 1px solid #dee2e6; padding: 5px 8px; "
"{{ borderRadiusStyle }} {{ borderBottomStyle }} {{ borderTopStyle }}\">\n"
"                                                                    <t t-"
"out=\"combo_line.product_id.name or ''\">Taking care of Trees Course</t>\n"
"                                                                    <span t-"
"if=\"combo_line.product_id.product_template_attribute_value_ids\" "
"style=\"color: #6c757d;\">\n"
"                                                                        <t t-"
"out=\"', "
"'.join(combo_line.product_id.product_template_attribute_value_ids.mapped('name'))"
"\"/>\n"
"                                                                    </span>\n"
"                                                                    -\n"
"                                                                    <span>\n"
"                                                                        <t t-"
"out=\"int(combo_line.product_uom_qty) or ''\">10000</t>\n"
"                                                                        <t t-"
"out=\"combo_line.product_uom_id.name or ''\" t-"
"if=\"combo_line.order_id.create_uid._has_group('uom.group_uom')\"/>\n"
"                                                                    </span>\n"
"                                                                    <p t-"
"if=\"hasattr(combo_line, 'is_rental') and combo_line.is_rental and "
"combo_line.id == line.id\" style=\"color: #6c757d;\">\n"
"                                                                        <t t-"
"out=\"combo_line._get_rental_pricing_description() or ''\"/><br/>\n"
"                                                                    </p>\n"
"                                                                    <t t-"
"if=\"(hasattr(combo_line, 'is_rental') and combo_line.is_rental) or "
"(hasattr(combo_line, 'event_id') and combo_line.event_id) or "
"(hasattr(combo_line, 'calendar_event_id') and combo_line.calendar_event_id)"
"\">\n"
"                                                                        <t t-"
"set=\"description_lines\" t-"
"value=\"combo_line.get_description_following_lines()\"/>\n"
"                                                                        <div "
"t-if=\"description_lines\" style=\"color: #6c757d;\">\n"
"                                                                            <t "
"t-foreach=\"description_lines\" t-as=\"description_line\">\n"
"                                                                                <p "
"t-if=\"description_line\" t-out=\"description_line\" style=\"margin: 4px 0 "
"0;\"/>\n"
"                                                                            </"
"t>\n"
"                                                                        </"
"div>\n"
"                                                                    </t>\n"
"                                                        </div>\n"
"                                                    </t>\n"
"                                                <t t-"
"elif=\"not(combo_line.linked_line_id) and combo_line.id == line.id\">\n"
"                                                    <p t-if=\"hasattr(line, "
"'is_rental') and line.is_rental\" style=\"margin: 4px 0 0; color: #6c757d;"
"\">\n"
"                                                        <t t-"
"out=\"line._get_rental_pricing_description() or ''\"/><br/>\n"
"                                                    </p>\n"
"                                                    <t t-"
"if=\"(hasattr(combo_line, 'is_rental') and combo_line.is_rental) or "
"(hasattr(combo_line, 'event_id') and combo_line.event_id) or "
"(hasattr(combo_line, 'calendar_event_id') and combo_line.calendar_event_id)"
"\">\n"
"                                                        <t t-"
"set=\"product_description_lines\" t-"
"value=\"line.get_description_following_lines()\"/>\n"
"                                                        <div t-"
"if=\"product_description_lines\" style=\"color: #6c757d;\">\n"
"                                                            <t t-"
"foreach=\"product_description_lines\" t-as=\"product_description_line\">\n"
"                                                                <p t-"
"if=\"product_description_line\" t-out=\"product_description_line\" "
"style=\"margin: 4px 0 0;\"/>\n"
"                                                            </t>\n"
"                                                        </div>\n"
"                                                    </t>\n"
"                                                </t>\n"
"                                            </t>\n"
"                                            <span style=\"display: inline-"
"block;  margin-top: 4px; padding: 4px 8px; border-radius: 20px; background-"
"color: #e9ecef; color: #454748; font-size: 12px;\">\n"
"                                                <t t-"
"out=\"int(line.product_uom_qty) or ''\">10000</t>\n"
"                                                <t t-"
"out=\"line.product_uom_id.name or ''\" t-"
"if=\"line.order_id.create_uid._has_group('uom.group_uom')\"/>\n"
"                                            </span>\n"
"                                        </td>\n"
"                                        <td width=\"19%\" align=\"right\" "
"style=\"max-width: 100px; vertical-align: top;\">\n"
"                                            <t t-if=\"line.product_type == "
"'combo'\">\n"
"                                                <span t-"
"out=\"format_amount(line._get_cart_display_price(), object.currency_id) or "
"''\">$ 10.00</span>\n"
"                                            </t>\n"
"                                            <t t-else=\"\">\n"
"                                                <span style=\"white-space: "
"nowrap;\">\n"
"                                                    <t t-"
"if=\"object.company_price_include == 'tax_excluded'\">\n"
"                                                        <t t-"
"out=\"format_amount(line.price_subtotal, object.currency_id) or ''\">$ "
"10.00</t>\n"
"                                                    </t>\n"
"                                                    <t t-else=\"\">\n"
"                                                        <t t-"
"out=\"format_amount(line.price_total, object.currency_id) or ''\">$ 10.00</"
"t>\n"
"                                                    </t>\n"
"                                                </span>\n"
"                                            </t>\n"
"                                            <t t-if=\"hasattr(line, "
"'recurring_invoice') and line.recurring_invoice\">\n"
"                                                <br/>\n"
"                                                <t t-"
"out=\"line.subscription_plan_id.billing_period_display_sentence or ''\"/>\n"
"                                            </t>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </t>\n"
"                        </t>\n"
"                        <table width=\"100%\" role=\"presentation\" "
"style=\"font-size: 14px; border-collapse:collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"padding-top: 8px;  border-top: "
"1px solid #dee2e6; color: #495057;\">Delivery</td>\n"
"                                <td style=\"padding-top: 8px;  border-top: "
"1px solid #dee2e6; text-align: right; color: #495057;\" width=\"100px\" "
"align=\"right\">\n"
"                                    <t t-"
"out=\"format_amount(object.amount_delivery, object.currency_id) or ''\">-</"
"t>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding-top: 4px; color: "
"#495057;\">Subtotal</td>\n"
"                                <td style=\"padding-top: 4px; text-align: "
"right; color: #495057;\" width=\"100px\" align=\"right\"><t t-"
"out=\"format_amount(object.amount_untaxed, object.currency_id) or ''\">-</"
"t></td>\n"
"                            </tr>\n"
"                        </table>\n"
"                        <t t-if=\"object.tax_totals and "
"object.tax_totals['subtotals']\">\n"
"                            <t t-set=\"all_tax_lines\" t-value=\"[tax for "
"line in object.tax_totals['subtotals'] for tax in line['tax_groups']]\"/>\n"
"                            <table width=\"100%\" t-if=\"all_tax_lines\" "
"style=\"font-size: 14px; border-collapse:collapse;\" role=\"presentation\">\n"
"                                <tr t-foreach=\"all_tax_lines\" t-"
"as=\"tax_line\">\n"
"                                    <td style=\"padding: 4px 0 8px 0; color: "
"#495057;\"><span t-out=\"tax_line['group_name']\"/></td>\n"
"                                    <td style=\"padding: 4px 0 8px 0; text-"
"align: right; color: #495057;\" width=\"100px\" align=\"right\" t-"
"out=\"format_amount(tax_line['tax_amount_currency'], object.currency_id) or "
"''\">$ 0.00</td>\n"
"                                </tr>\n"
"                            </table>\n"
"                        </t>\n"
"                        <table width=\"100%\" role=\"presentation\" "
"style=\"font-size: 14px; border-collapse:collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"padding-top: 8px; border-top: "
"1px solid #343a40;\"><strong>Total</strong></td>\n"
"                                <td style=\"padding-top: 8px; border-top: "
"1px solid #343a40; text-align: right\" width=\"100px\" align=\"right\">\n"
"                                    <strong t-"
"out=\"format_amount(object.amount_total, object.currency_id) or ''\">-</"
"strong>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </t>\n"
"                    <t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"                </td></tr>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</tbody>\n"
"</table>\n"
"            "
msgstr ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" "
"style=\"max-width: 590px; padding: 0px; background-color: white; color: "
"#454748; border-collapse: collapse;\" role=\"presentation\">\n"
"<tbody>\n"
"    <!-- CONTENT -->\n"
"    <tr>\n"
"        <td align=\"center\" style=\"min-width: 590px;\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" "
"width=\"100%\" style=\"max-width: 590px; background-color: white; padding: "
"0px 0px 0px 0px; border-collapse:collapse;\" role=\"presentation\">\n"
"                <tr><td valign=\"top\" style=\"font-size: 14px;\">\n"
"                    <t t-set=\"color\" t-"
"value=\"object.company_id.email_secondary_color or '#875A7B'\"/>\n"
"                    <t t-if=\"'website_id' in object and object.website_id\" "
"t-set=\"logo_src\" t-value=\"object.website_id.image_url(object.website_id, "
"'logo')\"/>\n"
"                    <t t-else=\"\" t-set=\"logo_src\" t-valuef=\"/logo.png?"
"company=#{object.company_id.id}\"/>\n"
"                    <img t-att-src=\"logo_src\" style=\"display: block; "
"height: 50px; margin: 0 0 16px;\" alt=\"Logo\"/>\n"
"                    <p style=\"margin: 0 0 12px; line-height: 18px;\">\n"
"                        ສະບາຍດີ <t t-out=\"object.partner_id.display_name or "
"''\">Johnny Tester</t>,\n"
"                        <br/><br/>\n"
"                        ທ່ານຍັງບໍ່ທັນສຳເລັດການສັ່ງຊື້ອອນລາຍຂອງທ່ານ.<br/>\n"
"                        ທ່ານມີຄຳຖາມຫຍັງກ່ຽວກັບສິນຄ້າຂອງພວກເຮົາບໍ່?<br/>\n"
"                        ພຽງແຕ່ຕອບກັບອີເມວນີ້ເພື່ອສອບຖາມໄດ້ເລີຍ!<br/>\n"
"                    </p>\n"
"                    <t t-if=\"not is_html_empty(user.signature)\">\n"
"                        <div style=\"font-size: 14px; margin: 0 0 16px;\"><t "
"t-out=\"user.signature or ''\">Mitchell Admin</t></div>\n"
"                    </t>\n"
"                    <t t-if=\"'hide_recovery_button' not in ctx\">\n"
"                        <div t-attf-style=\"margin-bottom: 22px; font-size: "
"14px;\">\n"
"                            <a t-attf-href=\"{{ object.get_base_url() }}/"
"shop/cart?id={{ object.id }}&amp;access_token={{ object.access_token }}\" "
"target=\"_blank\" t-attf-style=\"background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#fff'}}; border-radius: 5px; "
"font-size:14px;\">\n"
"                                ສັ່ງຊື້ຕໍ່\n"
"                            </a>\n"
"                        </div>\n"
"                    </t>\n"
"                    <t t-if=\"object.order_line\">\n"
"                        <!-- The following loop is also used in the addons > "
"sale > data > mail_template_data.xml file because we want the same layout. --"
">\n"
"                        <t t-foreach=\"object.order_line\" t-as=\"line\">\n"
"                            <t t-if=\"(not hasattr(line, 'is_delivery') or "
"not line.is_delivery) and not line.combo_item_id\">\n"
"                                <table width=\"100%\" style=\"max-width: "
"590px; color: #454748; font-size: 14px; border-collapse: collapse;\" "
"role=\"presentation\">\n"
"                                    <tr>\n"
"                                        <td width=\"24%\" style=\"max-width: "
"120px; padding: 0 10px 10px 0; vertical-align: top;\">\n"
"                                            <img t-attf-src=\"/web/image/"
"product.product/{{ line.product_id.id }}/image_128\" style=\"width: 100px; "
"height: 100px; object-fit: contain;\" alt=\"Product image\"/>\n"
"                                        </td>\n"
"                                        <td align=\"left\" style=\"vertical-"
"align: top; padding-bottom: 22px;\">\n"
"                                            <h3 t-attf-style=\"mso-line-"
"height-rule:exactly; margin:0; font-size: 14px; color: {{color}}; {{'margin-"
"bottom: 6px;' if line.product_type == 'combo' else ''}}\">\n"
"                                                <strong t-"
"out=\"line.product_id.name or ''\">Taking care of Trees Course</strong>\n"
"                                                <span t-"
"if=\"line.product_id.product_template_attribute_value_ids\" style=\"color: "
"#6c757d;\">\n"
"                                                    <t t-out=\"', "
"'.join(line.product_id.product_template_attribute_value_ids.mapped('name'))"
"\"/>\n"
"                                                </span>\n"
"                                            </h3>\n"
"                                            <t t-set=\"combo_line_idx\" t-"
"value=\"0\"/>\n"
"                                            <t t-set=\"totalComboLines\" t-"
"value=\"0\"/>\n"
"                                            <t t-set=\"line_idx\" t-"
"value=\"line_index\"/>\n"
"                                            <t t-"
"foreach=\"object.order_line\" t-as=\"combo_liness\">\n"
"                                                <t t-if=\"(not hasattr(line, "
"'is_delivery') or not line.is_delivery) and (combo_liness.linked_line_id.id "
"== line.id) and line_idx == line_index\">\n"
"                                                    <t t-"
"if=\"combo_liness.linked_line_id.id == line.id and combo_liness.id != "
"line.id\">\n"
"                                                        <t t-"
"set=\"totalComboLines\" t-value=\"totalComboLines + 1\"/>\n"
"                                                    </t>\n"
"                                                </t>\n"
"                                            </t>\n"
"                                            <t t-"
"foreach=\"object.order_line\" t-as=\"combo_line\">\n"
"                                                <t t-if=\"(not hasattr(line, "
"'is_delivery') or not line.is_delivery) and (combo_line.linked_line_id.id == "
"line.id) and combo_line.combo_item_id and line_idx == line_index\">\n"
"                                                        <t t-"
"set=\"borderRadiusStyle\" t-value=\"''\"/>\n"
"                                                        <t t-"
"set=\"borderTopStyle\" t-value=\"''\"/>\n"
"                                                        <t t-"
"set=\"borderBottomStyle\" t-value=\"''\"/>\n"
"\n"
"                                                        <t t-"
"if=\"combo_line.linked_line_id.id == line.id and combo_line.id != "
"line.id\">\n"
"                                                            <t t-"
"set=\"combo_line_idx\" t-value=\"combo_line_idx + 1\"/>\n"
"                                                        </t>\n"
"                                                        <t t-"
"elif=\"combo_line.id == line.id and line_idx != line_index\">\n"
"                                                            <t t-"
"set=\"combo_line_idx\" t-value=\"0\"/>\n"
"                                                        </t>\n"
"                                                        <t t-"
"if=\"combo_line_idx == 1\">\n"
"                                                            <t t-"
"if=\"totalComboLines != 1\">\n"
"                                                                <t t-"
"set=\"borderRadiusStyle\" t-value=\"'border-radius: 6px 6px 0 0;'\"/>\n"
"                                                                <t t-"
"set=\"borderBottomStyle\" t-value=\"'border-bottom: none;'\"/>\n"
"                                                            </t>\n"
"                                                            <t t-else=\"\">\n"
"                                                                <t t-"
"set=\"borderRadiusStyle\" t-value=\"'border-radius: 6px;'\"/>\n"
"                                                            </t>\n"
"                                                        </t>\n"
"                                                        <t t-"
"elif=\"totalComboLines == combo_line_idx\">\n"
"                                                            <t t-"
"set=\"borderRadiusStyle\" t-value=\"'border-radius: 0 0 6px 6px;'\"/>\n"
"                                                            <t t-"
"if=\"totalComboLines != 2\">\n"
"                                                                <t t-"
"set=\"borderTopStyle\" t-value=\"'border-top: none;'\"/>\n"
"                                                            </t>\n"
"                                                        </t>\n"
"                                                        <div t-attf-"
"style=\"width: 100%; border: 1px solid #dee2e6; padding: 5px 8px; "
"{{ borderRadiusStyle }} {{ borderBottomStyle }} {{ borderTopStyle }}\">\n"
"                                                                    <t t-"
"out=\"combo_line.product_id.name or ''\">Taking care of Trees Course</t>\n"
"                                                                    <span t-"
"if=\"combo_line.product_id.product_template_attribute_value_ids\" "
"style=\"color: #6c757d;\">\n"
"                                                                        <t t-"
"out=\"', "
"'.join(combo_line.product_id.product_template_attribute_value_ids.mapped('name'))"
"\"/>\n"
"                                                                    </span>\n"
"                                                                    -\n"
"                                                                    <span>\n"
"                                                                        <t t-"
"out=\"int(combo_line.product_uom_qty) or ''\">10000</t>\n"
"                                                                        <t t-"
"out=\"combo_line.product_uom_id.name or ''\" t-"
"if=\"combo_line.order_id.create_uid._has_group('uom.group_uom')\"/>\n"
"                                                                    </span>\n"
"                                                                    <p t-"
"if=\"hasattr(combo_line, 'is_rental') and combo_line.is_rental and "
"combo_line.id == line.id\" style=\"color: #6c757d;\">\n"
"                                                                        <t t-"
"out=\"combo_line._get_rental_pricing_description() or ''\"/><br/>\n"
"                                                                    </p>\n"
"                                                                    <t t-"
"if=\"(hasattr(combo_line, 'is_rental') and combo_line.is_rental) or "
"(hasattr(combo_line, 'event_id') and combo_line.event_id) or "
"(hasattr(combo_line, 'calendar_event_id') and combo_line.calendar_event_id)"
"\">\n"
"                                                                        <t t-"
"set=\"description_lines\" t-"
"value=\"combo_line.get_description_following_lines()\"/>\n"
"                                                                        <div "
"t-if=\"description_lines\" style=\"color: #6c757d;\">\n"
"                                                                            <t "
"t-foreach=\"description_lines\" t-as=\"description_line\">\n"
"                                                                                <p "
"t-if=\"description_line\" t-out=\"description_line\" style=\"margin: 4px 0 "
"0;\"/>\n"
"                                                                            </"
"t>\n"
"                                                                        </"
"div>\n"
"                                                                    </t>\n"
"                                                        </div>\n"
"                                                    </t>\n"
"                                                <t t-"
"elif=\"not(combo_line.linked_line_id) and combo_line.id == line.id\">\n"
"                                                    <p t-if=\"hasattr(line, "
"'is_rental') and line.is_rental\" style=\"margin: 4px 0 0; color: #6c757d;"
"\">\n"
"                                                        <t t-"
"out=\"line._get_rental_pricing_description() or ''\"/><br/>\n"
"                                                    </p>\n"
"                                                    <t t-"
"if=\"(hasattr(combo_line, 'is_rental') and combo_line.is_rental) or "
"(hasattr(combo_line, 'event_id') and combo_line.event_id) or "
"(hasattr(combo_line, 'calendar_event_id') and combo_line.calendar_event_id)"
"\">\n"
"                                                        <t t-"
"set=\"product_description_lines\" t-"
"value=\"line.get_description_following_lines()\"/>\n"
"                                                        <div t-"
"if=\"product_description_lines\" style=\"color: #6c757d;\">\n"
"                                                            <t t-"
"foreach=\"product_description_lines\" t-as=\"product_description_line\">\n"
"                                                                <p t-"
"if=\"product_description_line\" t-out=\"product_description_line\" "
"style=\"margin: 4px 0 0;\"/>\n"
"                                                            </t>\n"
"                                                        </div>\n"
"                                                    </t>\n"
"                                                </t>\n"
"                                            </t>\n"
"                                            <span style=\"display: inline-"
"block;  margin-top: 4px; padding: 4px 8px; border-radius: 20px; background-"
"color: #e9ecef; color: #454748; font-size: 12px;\">\n"
"                                                <t t-"
"out=\"int(line.product_uom_qty) or ''\">10000</t>\n"
"                                                <t t-"
"out=\"line.product_uom_id.name or ''\" t-"
"if=\"line.order_id.create_uid._has_group('uom.group_uom')\"/>\n"
"                                            </span>\n"
"                                        </td>\n"
"                                        <td width=\"19%\" align=\"right\" "
"style=\"max-width: 100px; vertical-align: top;\">\n"
"                                            <t t-if=\"line.product_type == "
"'combo'\">\n"
"                                                <span t-"
"out=\"format_amount(line._get_cart_display_price(), object.currency_id) or "
"''\">$ 10.00</span>\n"
"                                            </t>\n"
"                                            <t t-else=\"\">\n"
"                                                <span style=\"white-space: "
"nowrap;\">\n"
"                                                    <t t-"
"if=\"object.company_price_include == 'tax_excluded'\">\n"
"                                                        <t t-"
"out=\"format_amount(line.price_subtotal, object.currency_id) or ''\">$ "
"10.00</t>\n"
"                                                    </t>\n"
"                                                    <t t-else=\"\">\n"
"                                                        <t t-"
"out=\"format_amount(line.price_total, object.currency_id) or ''\">$ 10.00</"
"t>\n"
"                                                    </t>\n"
"                                                </span>\n"
"                                            </t>\n"
"                                            <t t-if=\"hasattr(line, "
"'recurring_invoice') and line.recurring_invoice\">\n"
"                                                <br/>\n"
"                                                <t t-"
"out=\"line.subscription_plan_id.billing_period_display_sentence or ''\"/>\n"
"                                            </t>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </t>\n"
"                        </t>\n"
"                        <table width=\"100%\" role=\"presentation\" "
"style=\"font-size: 14px; border-collapse:collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"padding-top: 8px;  border-top: "
"1px solid #dee2e6; color: #495057;\">ການຈັດສົ່ງ</td>\n"
"                                <td style=\"padding-top: 8px;  border-top: "
"1px solid #dee2e6; text-align: right; color: #495057;\" width=\"100px\" "
"align=\"right\">\n"
"                                    <t t-"
"out=\"format_amount(object.amount_delivery, object.currency_id) or ''\">-</"
"t>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding-top: 4px; color: "
"#495057;\">ມູນຄ່າຍ່ອຍ</td>\n"
"                                <td style=\"padding-top: 4px; text-align: "
"right; color: #495057;\" width=\"100px\" align=\"right\"><t t-"
"out=\"format_amount(object.amount_untaxed, object.currency_id) or ''\">-</"
"t></td>\n"
"                            </tr>\n"
"                        </table>\n"
"                        <t t-if=\"object.tax_totals and "
"object.tax_totals['subtotals']\">\n"
"                            <t t-set=\"all_tax_lines\" t-value=\"[tax for "
"line in object.tax_totals['subtotals'] for tax in line['tax_groups']]\"/>\n"
"                            <table width=\"100%\" t-if=\"all_tax_lines\" "
"style=\"font-size: 14px; border-collapse:collapse;\" role=\"presentation\">\n"
"                                <tr t-foreach=\"all_tax_lines\" t-"
"as=\"tax_line\">\n"
"                                    <td style=\"padding: 4px 0 8px 0; color: "
"#495057;\"><span t-out=\"tax_line['group_name']\"/></td>\n"
"                                    <td style=\"padding: 4px 0 8px 0; text-"
"align: right; color: #495057;\" width=\"100px\" align=\"right\" t-"
"out=\"format_amount(tax_line['tax_amount_currency'], object.currency_id) or "
"''\">$ 0.00</td>\n"
"                                </tr>\n"
"                            </table>\n"
"                        </t>\n"
"                        <table width=\"100%\" role=\"presentation\" "
"style=\"font-size: 14px; border-collapse:collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"padding-top: 8px; border-top: "
"1px solid #343a40;\"><strong>ລວມທັງໝົດ</strong></td>\n"
"                                <td style=\"padding-top: 8px; border-top: "
"1px solid #343a40; text-align: right\" width=\"100px\" align=\"right\">\n"
"                                    <strong t-"
"out=\"format_amount(object.amount_total, object.currency_id) or ''\">-</"
"strong>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </t>\n"
"                    <t t-set=\"company\" t-value=\"object.company_id or "
"object.user_id.company_id or user.company_id\"/>\n"
"                </td></tr>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</tbody>\n"
"</table>\n"
"            "

#. module: website_sale
#: model:ir.model.fields,help:website_sale.field_delivery_carrier__website_description
#: model:ir.model.fields,help:website_sale.field_product_product__description_sale
#: model:ir.model.fields,help:website_sale.field_product_template__description_sale
msgid ""
"A description of the Product that you want to communicate to your customers. "
"This description will be copied to every Sales Order, Delivery Order and "
"Customer Invoice/Credit Note"
