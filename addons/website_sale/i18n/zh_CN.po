"style=\"font-size: 14px; margin: 0 0 16px;\">\n"
"                        <t t-out=\"user.signature or ''\">Mitchell Admin</"
"t>\n"
"                    </div>\n"
"                    <div t-attf-style=\"margin-bottom: 22px; font-size: 14px;"
"\">\n"
"                        <a t-att-href=\"website.get_base_url() + "
"object.website_url\" t-attf-style=\"background-color: "
"{{website.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
