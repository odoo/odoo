#: model:mail.template,body_html:website_sale.email_template_back_in_stock
msgid ""
"<t t-set=\"website\" t-value=\"object.website_id or object.env.website or "
"object.env.website.browse(env.context.get('host_id'))\"/>\n"
"                <div style=\"margin: 0px; padding: 0px;\">\n"
"                    <t t-if=\"website\" t-set=\"logo_src\" t-"
"value=\"website.image_url(website, 'logo')\"/>\n"
"                    <t t-else=\"\" t-set=\"logo_src\" t-valuef=\"/logo.png?"
"company=#{object.company_id.id}\"/>\n"
"                    <img t-att-src=\"logo_src\" style=\"display:block; "
"height:50px; margin:0 0 16px;\" alt=\"Logo\"/>\n"
"                    <p>\n"
"                        Hello <t t-out=\"ctx.get('customer_name')"
"\">Customer</t>,\n"
"                    </p>\n"
"                    <p>The product you were waiting for is now back in stock!"
"</p>\n"
"                    <div t-if=\"not is_html_empty(user.signature)\" "
"style=\"font-size: 14px; margin: 0 0 16px;\">\n"
"                        <t t-out=\"user.signature or ''\">Mitchell Admin</"
"t>\n"
"                    </div>\n"
"                    <div t-attf-style=\"margin-bottom: 22px; font-size: 14px;"
"\">\n"
"                        <a t-att-href=\"website.get_base_url() + "
"object.website_url\" t-attf-style=\"background-color: "
"{{website.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{website.company_id.email_primary_color or '#fff'}}; border-radius: 5px; "
"font-size:14px;\">\n"
"                            Order Now\n"
"                        </a>\n"
"                    </div>\n"
"                    <div style=\"margin-bottom: 12px;\">\n"
"                        <table role=\"presentation\" width=\"100%\" "
"style=\"max-width: 590px; border-collapse: collapse; font-size: 14px;\">\n"
"                            <tr>\n"
"                                <td width=\"24%\" style=\"max-width: 120px; "
"padding: 0 10px 10px 0; vertical-align: top;\">\n"
"                                    <img t-att-"
"src=\"website.image_url(object, 'image_1920')\" style=\"width: 100px; "
"height: 100px; object-fit: contain;\" alt=\"Product image\"/>\n"
"                                </td>\n"
"                                <td style=\"padding-bottom: 8px; vertical-"
"align: top;\">\n"
"                                    <h2 t-att-style=\"'margin:0; font-"
"size:14px; color:%s;' % ((website and "
"website.company_id.email_secondary_color) or '#875A7B')\">\n"
"                                        <strong t-out=\"object.name or "
"''\">Desk Combination</strong>\n"
"                                    </h2>\n"
"                                    <p t-"
"if=\"object.product_template_attribute_value_ids\" style=\"margin: 4px "
"0;\">\n"
"                                        ( <t t-out=\"', "
"'.join(object.product_template_attribute_value_ids.mapped('name'))\">Wood</"
"t> )\n"
"                                    </p>\n"
"                                    <t t-out=\"object.description_ecommerce "
"or ''\">Desk Description</t>\n"
"                                </td>\n"
"                                <td width=\"19%\" align=\"right\" "
"style=\"max-width: 100%; vertical-align: top;\">\n"
"                                    <t t-"
"out=\"format_amount(object.list_price, object.currency_id)\">$ 450</t>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"                </div>\n"
"            "
