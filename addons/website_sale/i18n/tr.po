"                                                <strong t-attf-"
"style=\"color: {{secondary_color}};\" t-out=\"product.name\"/> \n"
"                                           </h3>\n"
"                                        </div> \n"
"                                       <div>\n"
"                                            <span t-"
"if=\"line.product_id.product_template_attribute_value_ids\" style=\"color: "
"#6c757d;\"> \n"
"                                               <t t-out=\"', "
"'.join(line.product_id.product_template_attribute_value_ids.mapped('name'))"
"\"/>\n"
"                                            </span> \n"
"                                       </div>\n"
"                                    </td> \n"
"                                   <td style=\"padding: 10px 0; text-align: "
"right;\">\n"
"                                        <a t-att-"
"href=\"product.website_absolute_url + '#o_product_page_reviews'\" t-attf-"
"style=\"border-radius: 5px; background-color: {{secondary_color}}; padding: "
"8px 16px 8px 16px; color: {{primary_color}}; text-decoration: none; font-"
"size:13px; white-space: nowrap;\" target=\"_blank\"> \n"
"                                            Şimdi Değerlendirin\n"
"                                       </a>\n"
"                                    </td> \n"
"                               </tr>\n"
"                            </table> \n"
"                       </t>\n"
"                    </p> \n"
