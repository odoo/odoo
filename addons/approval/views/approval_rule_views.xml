<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_rule_list" model="ir.ui.view">
        <field name="name">approval.rule.list</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="category_id" />
                <field name="condition_type" />
                <field name="condition_field" optional="show" />
                <field name="operator" optional="show" />
                <field name="threshold" optional="show" />
                <field
                    name="threshold_max"
                    invisible="condition_type != 'threshold' or operator != 'between'" />
                <field name="subject_model_id" optional="hide" />
                <field name="subject_domain" optional="hide" />
                <field name="action_type" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_approval_rule_form" model="ir.ui.view">
        <field name="name">approval.rule.form</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <group>
                        <group string="Rule">
                            <field name="name" placeholder="e.g. High-Value Purchase" />
                            <field name="category_id" />
                            <field name="sequence" />
                            <field name="active" invisible="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                        <group string="Condition">
                            <field name="condition_type" />
                            <field
                                name="condition_field"
                                invisible="condition_type != 'threshold'"
                                required="condition_type == 'threshold'" />
                            <field
                                name="operator"
                                invisible="condition_type != 'threshold'"
                                required="condition_type == 'threshold'" />
                            <field
                                name="threshold"
                                invisible="condition_type != 'threshold'" />
                            <field
                                name="threshold_max"
                                invisible="condition_type != 'threshold' or operator != 'between'" />
                            <field
                                name="currency_id"
                                options="{'no_create': True, 'no_open': True}"
                                groups="base.group_multi_currency"
                                invisible="condition_type != 'threshold' or condition_field != 'amount'" />
                            <field
                                name="subject_model_id"
                                options="{'no_create': True}"
                                invisible="condition_type == 'threshold'"
                                required="condition_type != 'threshold'" />
                            <field name="subject_model_name" invisible="1" />
                            <field
                                name="subject_domain"
                                widget="domain"
                                options="{'model': 'subject_model_name'}"
                                invisible="condition_type != 'domain'"
                                required="condition_type == 'domain'" />
                            <field
                                name="subject_field"
                                invisible="condition_type != 'field_selection'"
                                required="condition_type == 'field_selection'" />
                            <field
                                name="subject_value"
                                invisible="condition_type != 'field_selection'" />
                        </group>
                    </group>
                    <group string="Action">
                        <group>
                            <field name="action_type" widget="radio" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_rule_search" model="ir.ui.view">
        <field name="name">approval.rule.search</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="category_id" />
                <filter
                    name="filter_inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="groupby_category"
                        string="Category"
                        context="{'group_by': 'category_id'}" />
                    <filter
                        name="groupby_condition"
                        string="Condition"
                        context="{'group_by': 'condition_field'}" />
                    <filter
                        name="groupby_action"
                        string="Action Type"
                        context="{'group_by': 'action_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_approval_rule" model="ir.actions.act_window">
        <field name="name">Conditional Rules</field>
        <field name="res_model">approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first conditional approval rule
            </p>
            <p>Rules decide a request outright or tell a step when it applies.
            For example: "If amount exceeds 10,000, the Finance step applies."</p>
        </field>
    </record>

</odoo>
