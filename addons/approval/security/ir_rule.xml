        <field name="name">Approval Request: read for restricted users audience</field>
        <field name="model_id" ref="model_approval_request" />
        <field
            name="domain_force">[
                ('category_id.privacy_visibility', '=', 'restricted_users'),
                ('category_id.allowed_user_ids', 'in', [user.id])
