    <record id="approval_request_user_read" model="ir.rule">
        <field
            name="name">Approval Request: user read own or approver or delegate</field>
        <field name="model_id" ref="model_approval_request" />
        <field
            name="domain_force">[
                '|', '|',
                ('request_owner_id', '=', user.id),
                ('approver_ids.user_id', '=', user.id),
                ('approver_ids.delegate_id', '=', user.id)
            ]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="approval_approver_user_read" model="ir.rule">
        <field
            name="name">Approval Approver: user read own request, self, delegated, or co-approver</field>
        <field name="model_id" ref="model_approval_approver" />
        <field
            name="domain_force">[
                '|', '|', '|', '|',
                ('request_id.request_owner_id', '=', user.id),
                ('user_id', '=', user.id),
                ('delegate_id', '=', user.id),
                ('request_id.approver_ids.user_id', '=', user.id),
                ('request_id.approver_ids.delegate_id', '=', user.id)
            ]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

