<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_rule" model="ir.rule">
        <field name="name">Approval Category: multi-company</field>
        <field
            name="model_id"
            model="ir.model"
            search="[('model','=','approval.category')]" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

