<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_expense.ListButtons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <button t-if="this.displaySubmit()" class="d-none d-md-block btn btn-secondary" t-on-click="() => this.onClick('action_submit')">
                Submit
            </button>
            <button t-if="this.displayApprove()" class="d-none d-md-block btn btn-secondary" t-on-click="() => this.onClick('action_approve')">
                Approve
            </button>
            <button title="Refuse" t-if="this.displayApprove()" class="d-none d-md-block btn btn-secondary" t-on-click="() => this.onClick('action_refuse')">
                Refuse
            </button>
        </xpath>
    </t>

    <t t-name="hr_expense.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-selection-actions']//t[@t-if='this.props.info.actionMenus']" position="before">
            <button class="d-none d-md-block btn btn-secondary" t-on-click="this.onClickPrintSelected">
                <i class="oi me-1" data-icon="print"/>
                Print
            </button>
        </xpath>
    </t>

    <t t-name="hr_expense.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="attributes">
            <attribute name="class" add="hr_expense h-auto o_forbidden_tooltip_parent" separator=" "/>
        </xpath>
    </t>


    <t t-name="hr_expense.DashboardListRenderer" t-inherit="hr_expense.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <ExpenseDashboard/>
        </xpath>
    </t>
</templates>
