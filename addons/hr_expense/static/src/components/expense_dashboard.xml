<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_expense.ExpenseDashboard">
        <div class="o_expense_container position-sticky start-0 d-none d-md-flex align-items-stretch gap-2 px-3 pt-1 pb-3">
            <t t-foreach="Object.entries(this.state.expenses)" t-as="expense" t-key="expense[0]">
                <t t-set="name" t-value="expense[0]"/>
                <t t-set="data" t-value="expense[1]"/>
                <t t-set="color" t-value="name === 'draft' ? 'info' : name === 'submitted' ? 'warning' : 'success'"/>
                <button t-attf-class="o_expense_card btn flex-grow-1 flex-basis-0 d-flex flex-column align-items-center border-0 rounded-3 py-2 px-3 bg-{{ color }}-subtle bg-gradient text-center text-{{ color }}-emphasis"
                        t-att-data-tooltip="data['tooltip']" t-on-click="() => this.applyFilter(name)"
                        type="button">
                    <span t-out="this.renderMonetaryField(data['amount'], data['currency'])" class="fs-2"/>
                    <span t-out="data['description']"/>
                </button>
                <i t-if="name !== 'approved'" class="oi align-self-center text-muted" aria-hidden="true" data-icon="keyboard_arrow_right"/>
            </t>
            <i t-if="this.debugMode.isActive()" class="oi align-self-center text-muted" data-icon="help_outline" data-tooltip="Numbers computed from your personal expenses."/>
        </div>
    </t>
</templates>
