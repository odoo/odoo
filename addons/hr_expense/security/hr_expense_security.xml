<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_expenses" model="res.groups.privilege">
        <field name="name">Expenses</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_human_resources" />
    </record>

    <record id="group_hr_expense_team_approver" model="res.groups">
        <field name="name">Team Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_expenses" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_hr_expense_user" model="res.groups">
        <field name="name">All Approver</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_expenses" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('hr_expense.group_hr_expense_team_approver'))]" />
    </record>

    <record id="group_hr_expense_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_expenses" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('hr_expense.group_hr_expense_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

    <record id="hr_expense_config_rule_company" model="ir.rule">
        <field name="name">hr_expense.config: the reader's companies</field>
        <field name="model_id" ref="model_hr_expense_config" />
        <field name="global" eval="False" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[Command.set([ref('base.group_user'), ref('base.group_portal'), ref('base.group_public')])]" />
    </record>

    <record id="hr_expense_config_rule_erp_manager" model="ir.rule">
        <field
            name="name">hr_expense.config: every company for an access-rights manager</field>
        <field name="model_id" ref="model_hr_expense_config" />
        <field name="global" eval="False" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('base.group_erp_manager')])]" />
    </record>

</odoo>
