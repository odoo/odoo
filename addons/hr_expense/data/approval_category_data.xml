<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_expense" model="approval.category">
        <field name="name">Expense</field>
        <field name="sequence_code">HREXP</field>
        <field name="company_id" eval="False" />
        <field name="approval_minimum">1</field>
        <field name="activity_target">document</field>
    </record>

    <record id="approval_category_expense_step_manager" model="approval.category.step">
        <field name="category_id" ref="approval_category_expense" />
        <field name="activity_type_id" ref="hr_expense.mail_act_expense_approval" />
        <field name="name">Expense Approver</field>
        <field name="sequence">10</field>
        <field name="minimum">1</field>
        <field name="subject_model_id" ref="hr_expense.model_hr_expense" />
        <field name="subject_user_path">manager_id</field>
        <field name="group_id" ref="hr_expense.group_hr_expense_team_approver" />
    </record>

</odoo>
