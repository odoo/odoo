<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_deposit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.deposit.management</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']" position="inside">
                <field name="is_deposit" invisible="deposit_product_id"/>
                <field name="deposit_product_id" invisible="is_deposit"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_form_normalized_inherit_pos_deposit" model="ir.ui.view">
        <field name="name">product.template.view.form.normalized.inherit.pos.deposit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="is_deposit" invisible="deposit_product_id"/>
                <field name="deposit_product_id" invisible="is_deposit"/>
            </xpath>
        </field>
    </record>
</odoo>
