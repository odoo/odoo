<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pos_deposit.pos_orderline_receipt_inherit" inherit_id="point_of_sale.pos_orderline_receipt">
        <xpath expr="//tr[@name='standard-line']" position="attributes">
            <attribute name="t-if" add="not line.get('is_deposit_line')" separator="and"/>
        </xpath>
        <xpath expr="//tr[@name='combo-child-line']" position="before">
            <tr t-elif="line.get('is_deposit_line')" name="deposit-line" class="lines">
                <td t-if="line.get('is_combo_child_deposit')" class="deposit-indent text-start w-10 top"/>
                <td t-else="" class="deposit-indent text-start w-5 top"/>
                <td class="text-start w-10 top">
                    <span class="qty text-large"><t t-out="line['qty']" /></span>
                </td>
                <td class="text-start w-50 top">
                    <t t-call="point_of_sale.pos_orderline_receipt_information" />
                </td>
                <td t-if="not conditions['basic_receipt']" class="text-end w-30 text-large top price-incl font-monospace" t-out="line['price_subtotal_incl']" />
            </tr>
        </xpath>
    </template>
</odoo>
