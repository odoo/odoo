<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_orderline_receipt_inherit" inherit_id="point_of_sale.pos_orderline_receipt">
            <xpath expr="//tr[@name='standard-line']" position="attributes">
                <attribute name="t-if">not line['combo_parent_id'] and not line.get('is_deposit')</attribute>
            </xpath>
            <xpath expr="//tr[@name='combo-child-line']" position="before">
                <tr t-elif="line.get('is_deposit')" name="deposit-line" class="lines">
                    <td t-if="line.get('is_deposit_for_combo_child')" class="text-start w-10 top deposit-indent"/>
                    <td t-else="" class="text-start w-5 top deposit-indent"/>
                    <td class="text-start w-10 top">
                        <span class="qty text-large"><t t-out="line['qty']" /></span>
                    </td>
                    <td class="text-start w-50 top">
                        <t t-call="point_of_sale.pos_orderline_receipt_information" />
                    </td>
                    <td t-if="not conditions['basic_receipt']" class="text-end w-30 text-large top price-incl font-monospace" t-out="line['price_subtotal_incl']" />
                </tr>
            </xpath>
        </template>
    </data>
</odoo>
