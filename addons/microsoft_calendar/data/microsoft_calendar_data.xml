<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record forcecreate="True" id="ir_cron_sync_all_cals" model="ir.cron">
            <field name="name">Outlook: synchronization</field>
            <field name="model_id" ref="model_res_users"/>
            <field name="state">code</field>
            <field name="code">
model._sync_all_microsoft_calendar()
            </field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
        </record>

        <record forcecreate="True" id="ir_cron_sync_light_cals" model="ir.cron">
            <field name="name">Microsoft Calendar: light synchronization</field>
            <field name="model_id" ref="model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._sync_light_microsoft_calendar()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
