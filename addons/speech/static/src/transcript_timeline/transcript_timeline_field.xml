<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
        t-name="speech.TranscriptTimelineField"
        t-inherit="media.MediaTimelineField"
        t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_media_timeline_controls')]" position="after">
            <div t-if="this.cues.length" class="o_media_timeline_transcript">
                <div
                    t-foreach="this.cues"
                    t-as="cue"
                    t-key="cue_index"
                    class="o_media_timeline_cue"
                    t-att-class="{ 'fw-bold': this.isCueActive(cue) }"
                    t-on-click="() => this.onCueClick(cue)">
                    <span t-if="cue.speaker" class="text-muted me-1">
                        <t t-out="cue.speaker" />:
                    </span>
                    <t t-out="cue.text" />
                </div>
            </div>
        </xpath>
    </t>

</templates>
