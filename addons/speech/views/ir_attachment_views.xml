<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_attachment_view_form_speech" model="ir.ui.view">
        <field name="name">ir.attachment.view.form.speech</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group
                    string="Speech"
                    invisible="not can_transcribe and transcript_state == 'none'">
                    <field name="can_transcribe" invisible="1" />
                    <field name="transcript_state" />
                    <field
                        name="transcript_engine"
                        invisible="transcript_state != 'done'" />
                    <field
                        name="transcript_language"
                        invisible="transcript_state != 'done'" />
                    <field
                        name="transcript_error"
                        invisible="transcript_state != 'failed'" />
                    <field
                        name="transcript_text"
                        widget="text"
                        invisible="transcript_state != 'done'" />
                    <field name="speaker_ids" invisible="not speaker_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="label" readonly="1" />
                            <field name="partner_id" />
                            <field name="name" />
                            <field name="turns" />
                            <field name="talk_time_s" />
                        </list>
                    </field>
                </group>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_transcribe"
                        type="object"
                        string="Transcribe"
                        invisible="not can_transcribe or transcript_state in ('queued', 'running')"
                        class="btn-primary" />
                </header>
            </xpath>
        </field>
    </record>

</odoo>
