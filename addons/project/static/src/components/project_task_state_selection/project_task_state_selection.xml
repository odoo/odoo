<templates>
    <t t-name="project.ProjectTaskStateSelection" t-inherit="web.StateSelectionField" t-inherit-mode="primary">
        <!-- Waiting state & toggle mark as done button -->
        <xpath expr="//div[hasclass('o_state_selection_wrapper')]" position="before">
            <t t-set="isReadOnlyOrWaitingState" t-value="this.props.readonly or this.currentValue == '04_waiting_normal' and this.isView(['activity', 'card', 'list', 'calendar'])"/>
            <t t-set="isWaitingTooltip" t-value="this.props.showLabel ? '' : this.currentValue == '04_waiting_normal' ? 'This task is blocked by another unfinished task' : this.label"/>
            <button t-if="this.isToggleMode and this.currentValue == '01_in_progress'"
                class="o_state_selection_btn btn btn-secondary mw-100 rounded-pill lh-1 text-truncate opacity-trigger-hover"
                t-att-class="{
                    'o_has_not_label': !this.props.showLabel,
                    'btn-sm py-1 px-2': this.props.showLabel and this.props.viewType != 'form',
                }"
                data-available-offline=""
                t-att-data-tooltip="this.toggleTooltip"
                t-on-click.stop="this.toggleState"
                t-on-mouseenter="this.onMouseEnterStateButton"
                t-on-mouseleave="this.onMouseLeaveStateButton"
        >
                <i
                    class="o_status oi transition-base opacity-75 opacity-100-hover"
                    t-att-class="{ 'me-1': this.props.showLabel }"
                    t-attf-class="{{ this.stateIconClass(this.currentValue) }} {{this.statusColor(this.currentValue) }}"
                    t-att-data-icon="this.state.isStateButtonHighlighted ? 'check_circle' : this.stateIcon(this.currentValue)"
                />
                <span t-if="this.props.showLabel" class="o_status_label text-truncate">
                    <t t-if="this.state.isStateButtonHighlighted">
                        Mark as done
                    </t>
                    <t t-else="currentValue == '01_in_progress'">
                        In Progress
                    </t>
                </span>
            </button>
        </xpath>
        <xpath expr="//div[hasclass('o_state_selection_wrapper')]" position="attributes">
            <attribute name="t-att-class">isReadOnlyOrWaitingState ? '' : 'd-contents'</attribute>
            <attribute name="t-att-data-tooltip">isReadOnlyOrWaitingState ? isWaitingTooltip : ''</attribute>
            <attribute name="t-else">true</attribute>
        </xpath>
        <xpath expr="//Dropdown" position="attributes">
            <attribute name="disabled">isReadOnlyOrWaitingState</attribute>
        </xpath>
        <xpath expr="//Dropdown/button" position="attributes">
            <attribute name="t-att-disabled">isReadOnlyOrWaitingState</attribute>
            <attribute name="t-att-data-tooltip">isReadOnlyOrWaitingState ? '' : isWaitingTooltip</attribute>
            <attribute name="class" add="o_state_button" separator=" "/>
        </xpath>

        <!-- Tooltip for the dropdown toggler -->
        <xpath expr="//Dropdown" position="attributes">
            <attribute name="menuClass" separator=" + " add="' project_task_state_selection_menu'"></attribute>
        </xpath>

        <!-- Dropdown divider -->
        <xpath expr="//CheckboxItem" position="before">
            <div t-if="option[0] == '1_canceled' and (this.currentValue != '04_waiting_normal' or this.uiService.isSmall)" role="separator" class="dropdown-divider"/>
        </xpath>
    </t>
</templates>
