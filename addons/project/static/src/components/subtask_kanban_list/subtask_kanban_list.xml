<?xml version="1.0" encoding="utf-8"?>

<templates>

    <t t-name="project.SubtaskKanbanList">
        <t t-if="this.props.record.displaySubtasks">
            <div class="subtask_list d-flex flex-column gap-1 mt-2 border-top pt-2">
                <div t-foreach="this.closedList" t-as="record" t-key="record.id"  class="subtask_list_row d-flex gap-1 align-items-stretch">
                    <a t-attf-class="subtask_name_col d-flex align-items-center flex-grow-1 rounded ps-1 text-truncate small {{ ['1_done', '1_canceled'].includes(record.data.state) ? 'text-muted opacity-50' : '' }}"
                        t-att-title="record.data.display_name"
                        t-on-click.prevent="() => this.goToSubtask(record.resId)">
                        <span t-out="record.data.display_name" class="d-block text-truncate"/>
                    </a>
                    <Field
                        class="`o_field_many2many_avatar_user subtask_user_widget_col d-inline-flex align-items-center justify-content-end flex-shrink-0 ${['1_done', '1_canceled'].includes(record.data.state) ? 'opacity-50' : ''}`"
                        name="'user_ids'"
                        record="record"
                        readonly="false"
                        isEditable="true"
                        type="'card.many2many_avatar_user'"/>
                    <Field name="'state'"
                        class="`subtask_state_widget_col d-flex justify-content-center align-items-center`"
                        record="record"
                        type="'project_task_state_selection'"
                        fieldInfo="this.fieldInfo.state"/>
                </div>
                <div class="mt-2">
                    <SubtaskCreate
                        t-if="this.subtaskCreate.open"
                        name="this.subtaskCreate.name"
                        isReadonly="this.props.isReadonly"
                        onSubtaskCreateNameChanged.bind="this._onSubtaskCreateNameChanged"
                        onBlur.bind="this._onBlur"/>
                    <button t-else="" class="subtask_create btn btn-sm btn-secondary w-100" t-on-click.stop="(ev) => this.onSubTaskCreated(ev)"
                        t-on-keydown="(ev) => ev.code === 'Escape' ? this._onBlur(ev) : ()=>{}">
                        <i class="oi" data-icon="add"/> Add Sub-task
                    </button>
                </div>
            </div>
        </t>
    </t>

</templates>
