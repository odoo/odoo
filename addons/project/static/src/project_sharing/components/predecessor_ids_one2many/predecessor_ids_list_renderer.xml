<templates>
    <t t-name="project.PredecessorIdsListRowsRenderer" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary" owl="1">
        <xpath expr="//t[@t-foreach='this.getRowRecords(list)']" position="after">
        <tr t-if="this.nbHiddenRecords" class="o_data_row">
            <td t-att-colspan="this.nbCols" class="text-center">
                <i class="text-muted">
                    This task is currently blocked by <t t-out="this.nbHiddenRecords"/> (other) tasks to which you do not have access.
                </i>
            </td>
        </tr>
        </xpath>
    </t>
</templates>
