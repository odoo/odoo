<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="project.ProjectTemplateButtons">
        <div class="btn-group o_template_icon_group ms-auto d-flex ps-1">
            <i role="button" t-on-click.stop="this.onEditClick" class="oi oi-filled btn btn-link fs-3" data-icon="edit"></i>
            <i role="button" t-on-click.stop="this.onDeleteClick" class="oi oi-filled btn text-danger fs-3" data-icon="delete"></i>
        </div>
    </t>
</templates>
