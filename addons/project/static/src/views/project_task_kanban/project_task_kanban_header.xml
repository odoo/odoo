<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project.ProjectTaskKanbanHeader" t-inherit="mail.RottingKanbanHeader" t-inherit-mode="primary">
        <xpath expr="//span[@t-if='!this.progressBar and !this.props.list.model.useSampleModel']" position="replace">
            <span t-if="!this.progressBar and !this.props.list.model.useSampleModel"
                  class="o_column_task_count"
                  t-att-class="{ 'text-danger fw-bolder': this.isOverWipLimit }"
                  t-att-title="this.isOverWipLimit ? this.wipLimitTitle : undefined">
                <t t-if="this.wipLimit" t-out="'(' + this.group.count + ' / ' + this.wipLimit + ')'"/>
                <t t-else="" t-out="'(' + this.group.count + ')'"/>
            </span>
        </xpath>
    </t>

</templates>
