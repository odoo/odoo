<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project.ProjectTaskControlPanel" t-inherit="web.ControlPanel">
        <xpath expr="//button[@name='hub_tabs']" position="replace">
            <t t-if="this.showTaskOptions and !this.hasMobileHubItems">
                <Dropdown>
                    <button class="btn btn-secondary" t-att-title="this.taskOptionsTitle">
                        <i class="oi" data-icon="tune"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem onSelected="() => this.onClickShowSubtasks()" class="this.showSubtasks() ? 'selected' : ''">
                            Show Sub-Tasks
                        </DropdownItem>
                        <DropdownItem t-if="this.env.config.hub and !this.uiService.isSmall"
                            class="this.env.config.hub.showTabs() ? 'selected' : ''"
                            onSelected="() => this.toggleHubTabs()"
                        >
                            Show Hub Tabs
                        </DropdownItem>
                    </t>
                </Dropdown>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='web.HubItemsMobileDropdown']" position="replace">
            <t t-call="project.MobileCombinedActionsDropdown"/>
        </xpath>
    </t>

    <t t-name="project.MobileCombinedActionsDropdown">
        <t t-if="this.hasMobileHubItems and this.showTaskOptions">
            <Dropdown menuClass="'o_combined_mobile_dropdown'">
                <button t-att-aria-label="this.taskOptionsTitle" class="btn btn-secondary">
                    <i class="oi oi-fw" data-icon="tune" t-att-data-tooltip="this.taskOptionsTitle" />
                </button>
                <t t-set-slot="content">
                    <DropdownItem
                        onSelected="() => this.onClickShowSubtasks()"
                        class="this.showSubtasks() ? 'selected' : ''"
                    >
                        Show Sub-Tasks
                    </DropdownItem>
                    <div role="separator" class="dropdown-divider"/>
                    <t t-call="web.HubItemsMobileDropdownItems"/>
                </t>
            </Dropdown>
        </t>
        <t t-else="" t-call="web.HubItemsMobileDropdown"/>
    </t>

</templates>
