<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_format_date" name="Portal Formatted Date">
        <t t-if="date_record.year == datetime.date.today().year">
            <span t-out="date_record" t-options='{"widget": "date", "format": "MMM d"}'/>
        </t>
        <t t-else="">
            <span t-out="date_record" t-options='{"widget": "date", "format": "medium"}'/>
        </t>
    </template>

    <template id="portal_my_tasks_priority_widget_template" name="Priority Widget Template">
        <t t-set="priority_label" t-value="priority_labels.get(task.priority, priority_labels['0'])"/>
        <span t-attf-class="o_priority_star d-inline-block oi #{'oi-filled text-warning' if task.priority != '0' else 'opacity-75'} #{classes if classes else ''}" data-icon="star" t-att-title="priority_label"/>
        <span t-attf-class="o_priority_star d-inline-block oi #{'oi-filled text-warning' if task.priority in ['2', '3'] else 'opacity-75'} #{classes if classes else ''}" data-icon="star" t-att-title="priority_label"/>
        <span t-attf-class="o_priority_star d-inline-block oi #{'oi-filled text-warning' if task.priority == '3' else 'opacity-75'} #{classes if classes else ''}" data-icon="star" t-att-title="priority_label"/>
    </template>

    <template id="portal_my_tasks_state_widget_template" name="Status Widget Template">
        <span
            t-att-title="dict(task.fields_get(allfields=['state'])['state']['selection'])[task.state]"
            t-attf-class="#{'oi' if task.state in ['1_done','1_canceled','04_waiting_normal'] else 'o_status rounded-circle' } #{'oi-filled text-success' if task.state == '1_done' else 'oi-filled text-danger' if task.state == '1_canceled' else 'bg-warning' if task.state == '02_changes_requested' else 'bg-success' if task.state == '03_approved' else '' if task.state == '04_waiting_normal' else ''}"
            t-attf-data-icon="#{'check_circle' if task.state == '1_done' else 'cancel' if task.state == '1_canceled' else '' if task.state == '03_approved' else 'hourglass_empty' if task.state == '04_waiting_normal' else ''}"
        />
    </template>
    <template id="portal_my_tasks_badge_widget_template" name="badge Widget Template">
        <span class="badge rounded-pill bg-200 text-body" t-att-title="task.stage_id.name" t-out="task.stage_id.name"/>
    </template>

    <template id="portal_tasks_list" name="Tasks List">
        <t t-if="grouped_tasks">
            <t t-call="portal.portal_table">
                <thead>
                    <tr>
                        <t t-set="grouped_tasks_colspan" t-value="4 if multiple_projects and groupby != 'project_id' else 3"/>
                        <th>Name</th>
                        <th>Assignees</th>
                        <th name="deadline_col">Deadline</th>
                        <th t-if="groupby != 'project_id' and multiple_projects">Project</th>
                        <th t-if="groupby != 'stage_id'" class="text-end" name="stage_id_col">Stage</th>
                    </tr>
                </thead>
                <t t-foreach="grouped_tasks" t-as="tasks">
                    <tbody t-if="tasks and groupby != 'none'">
                        <tr name="grouped_tasks_groupby_columns" class="table-light">
                            <th name="groupby_name_col" t-att-colspan="grouped_tasks_colspan">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <t t-if="groupby == 'project_id' and multiple_projects">
                                        <div name="project_name" class="text-truncate">
                                            <span t-if="tasks[0].sudo().project_id" t-field="tasks[0].sudo().project_id.name"/>
                                            <span t-else="">No Project</span>
                                        </div>
                                    </t>
                                    <t t-elif="groupby == 'milestone_id'">
                                        <span t-if="tasks[0].sudo().milestone_id and tasks[0].sudo().allow_milestones"
                                            class="text-truncate"
                                            t-field="tasks[0].sudo().milestone_id.name"/>
                                        <span t-else="">No Milestone</span>
                                    </t>
                                    <t t-if="groupby == 'stage_id'">
                                        <div name="stage_name" class="text-truncate">
                                            <span t-field="tasks[0].sudo().stage_id.name"/>
                                        </div>
                                    </t>
                                    <t t-if="groupby == 'priority'">
                                        <span class="text-truncate" t-field="tasks[0].sudo().priority"/>
                                    </t>
                                    <t t-if="groupby == 'state'">
                                        <span class="text-truncate" t-field="tasks[0].sudo().state"/>
                                    </t>
                                    <t t-if="groupby == 'partner_id'">
                                        <span t-if="tasks[0].sudo().partner_id"
                                            class="text-truncate"
                                            t-field="tasks[0].sudo().partner_id.name"/>
                                        <span t-else="">No Customer</span>
                                    </t>
                                    <t t-if="groupby == 'parent_id'">
                                        <span t-if="tasks[0].sudo().parent_id"
                                            class="text-truncate"
                                            t-field="tasks[0].sudo().parent_id.name"/>
                                        <span t-else="">No Parent Task</span>
                                    </t>
                                    <span name="grouped_tasks_count" class="badge rounded-pill bg-200 text-body fw-medium" t-out="grouped_tasks_count(tasks)"/>
                                </div>
                            </th>
                            <th name="stage_id_col" t-if="groupby != 'stage_id'"/>
                        </tr>
                    </tbody>
                    <tbody t-if="tasks">
                        <t t-foreach="tasks" t-as="task">
                            <tr>
                                <td class="text-wrap">
                                    <a t-attf-href="/my/#{task_url}/#{task.id}?{{ keep_query() }}"><span t-att-title="task.name" t-field="task.name"/></a>
                                    <i t-if="task.priority != '0'" class="oi oi-filled text-warning ms-1" data-icon="star" role="img"
                                        t-att-title="priority_labels.get(task.priority)" t-att-aria-label="priority_labels.get(task.priority)"/>
                                </td>
                                <t t-set="assignees" t-value="task.sudo().user_ids"/>
                                <td>
                                    <div t-if="assignees" class="d-flex align-items-center gap-2">
                                        <t t-set="assignee" t-value="assignees[:1].partner_id"/>
                                        <t t-set="avatar_128_access_token" t-value="assignee._get_avatar_128_access_token()"/>
                                        <img class="o_avatar rounded" t-attf-src="/web/image/#{assignee._name}/#{assignee.id}/avatar_128?access_token=#{avatar_128_access_token}&amp;unique=#{assignee.avatar_128.checksum}" alt="User"/>
                                        <span t-att-title="'\n'.join(assignees.mapped('name'))">
                                            <span t-field="assignees[:1].name"/><span t-if="len(assignees) &gt; 1" class="badge ms-1 rounded-pill bg-200 text-body"> +<span t-out="len(assignees) - 1"/></span>
                                        </span>
                                    </div>
                                </td>
                                <td name="task_deadline" t-attf-class="text-nowrap #{'text-danger' if task.date_deadline and task.date_deadline &lt; datetime.datetime.now() and task.state not in ('1_done', '1_canceled') else ''}">
                                    <span t-if="task.date_deadline and task.date_deadline &lt; datetime.datetime.now() and task.state not in ('1_done', '1_canceled')" class="visually-hidden">Overdue</span>
                                    <t t-if="task.date_deadline" t-call="project.portal_format_date" date_record="task.date_deadline"/>
                                </td>
                                <td t-if="groupby != 'project_id' and multiple_projects" name="project_portal_project">
                                    <span title="Current project of the task" t-out="task.project_id.name" />
                                </td>
                                <td t-if="groupby != 'stage_id'" class="text-end lh-1">
                                    <t t-call="project.portal_my_tasks_badge_widget_template"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_tasks" name="My Tasks">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">

            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Tasks"/>
            <t t-if="not grouped_tasks">
                <div class="alert alert-warning" role="alert">
                    There are no tasks.
                </div>
            </t>
            <t t-call="project.portal_tasks_list"/>
        </t>
    </template>

    <template id="task_link_preview_front_end" inherit_id="portal.frontend_layout" primary="True">
        <xpath expr="//t[@t-if='not_uses_default_logo'][1]" position="before">
            <t t-if="preview_object.displayed_image_id">
                <meta property="og:image" t-attf-content="/web/image/{{ preview_object.displayed_image_id.id }}/300x200?access_token={{ preview_object.displayed_image_id.generate_access_token()[0] }}"/>
            </t>
        </xpath>
    </template>

    <template id="task_link_preview_portal_layout" inherit_id="portal.portal_layout" primary="True">
        <xpath expr="//t[@t-call='portal.frontend_layout']" position="attributes">
            <attribute name="t-call">project.task_link_preview_front_end</attribute>
        </xpath>
    </template>

    <template id="portal_my_task" name="My Task" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="attributes">
            <attribute name="t-call">project.task_link_preview_portal_layout</attribute>
        </xpath>
        <xpath expr="//t[@t-call='project.task_link_preview_portal_layout']" position="before">
            <t t-set="title" t-value="task.name"/>
            <t t-set="o_portal_fullwidth_alert" groups="project.group_project_user">
                <t t-call="portal.portal_back_in_edit_mode"
                    backend_url="'/odoo/action-project.action_view_my_task/%s' % (task.id)"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <div class="row o_project_portal_sidebar">
                <t t-set="sidebar_title" t-value="None"/>
                <t t-set="sidebar_subtitle" t-value="None"/>
                <t t-if="task.date_deadline">
                    <t t-set="sidebar_title">
                        <h2 class="mb-0"><t t-call="project.portal_format_date" date_record="task.date_deadline"/></h2>
                    </t>
                    <t t-set="sidebar_subtitle">
                        <t t-if="task.state in ('1_done', '1_canceled') or deadline_days is None">Deadline</t>
                        <t t-elif="deadline_days == 0">Due today</t>
                        <t t-elif="deadline_days &gt; 0">Due in <t t-out="deadline_days"/> days</t>
                        <span t-else="" class="text-danger"><t t-out="-deadline_days"/> days overdue</span>
                    </t>
                </t>
                <t t-set="entries">
                    <div class="d-none d-lg-flex flex-column mt-3">
                        <div id="task_sidebar_buttons" class="d-flex flex-column gap-2">
                            <a t-foreach="task_link_section" t-as="task_link" class="btn btn-light" role="button"
                                t-att-href="task_link['access_url']" t-att-target="task_link.get('target', '_self')" t-out="task_link['title']"/>
                        </div>
                        <div t-if="task.user_ids" id="task_assignees" class="d-flex flex-column gap-1">
                            <hr t-if="task.date_deadline or task_link_section"/>
                            <strong class="smaller text-uppercase text-muted">Assignees</strong>
                            <a t-foreach="task.user_ids" t-as="user" href="#discussion" class="d-flex align-items-center gap-2 py-1 text-reset text-decoration-none">
                                <img class="o_avatar rounded" t-att-src="image_data_uri(user.avatar_128)" alt="Contact"/>
                                <span class="small fw-semibold text-truncate" t-out="user.name"/>
                                <i class="oi ms-auto me-2" data-icon="mail" role="img" aria-label="Send Message"/>
                            </a>
                        </div>
                    </div>
                </t>
                <t t-call="portal.portal_record_sidebar"
                    classes.f="col-lg-4 col-xl-3 d-none d-lg-block d-print-none order-lg-first"
                    title="sidebar_title"
                    subtitle="sidebar_subtitle"
                    entries="entries"/>
                <div id="task_content" class="col-12 col-lg-8 col-xl-9 mt-0">
                    <t t-set="has_task_body" t-value="not is_html_empty(task.description) or task.attachment_ids"/>
                    <div id="card">
                        <div id="card_header" t-attf-class="p-3 p-lg-4 bg-100 border #{'rounded-top' if has_task_body else 'rounded'}" data-anchor="true">
                            <div class="d-flex flex-column flex-md-row align-items-md-start gap-2">
                                <div class="d-flex flex-column me-auto min-w-0">
                                    <small>
                                        <span class="text-muted">Task in</span>
                                        <a t-if="project_accessible" class="fw-bold" t-attf-href="/my/projects/#{task.project_id.id}" t-field="task.project_id"/>
                                        <b t-else="" t-field="task.project_id"/>
                                    </small>
                                    <h2 class="mb-0 text-break" t-field="task.name"/>
                                    <div class="d-flex align-items-center gap-1 text-muted small flex-wrap">
                                        <span>#<t t-out="task.id"/></span>
                                        <span>·</span>
                                        <span>Created <t t-call="project.portal_format_date" date_record="task.create_date"/></span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                    <t t-call="project.portal_my_tasks_state_widget_template"/>
                                    <t t-call="project.portal_my_tasks_badge_widget_template"/>
                                </div>
                            </div>
                            <hr class="my-3 my-lg-4 mx-n3 mx-lg-n4"/>
                            <div id="informations" class="row row-cols-2 row-cols-md-4 g-3 small">
                                <div t-if="task.milestone_id and task.allow_milestones" name="portal_my_task_milestone">
                                    <div class="text-muted">Milestone</div>
                                    <div class="fw-medium" t-field="task.milestone_id"/>
                                </div>
                                <div name="portal_my_task_priority">
                                    <div class="text-muted">Priority</div>
                                    <t t-call="project.portal_my_tasks_priority_widget_template"/>
                                </div>
                                <div t-if="task.date_deadline" name="portal_my_task_deadline">
                                    <div class="text-muted">Deadline</div>
                                    <div class="fw-medium">
                                        <t t-call="project.portal_format_date" date_record="task.date_deadline"/>,
                                        <span t-field="task.date_deadline" t-options='{"widget": "datetime", "time_only": True, "format": "short"}'/>
                                    </div>
                                </div>
                                <div t-if="task.allocated_hours > 0" name="portal_my_task_allocated_hours">
                                    <div class="text-muted">Allocated Time</div>
                                    <div class="fw-medium"><t t-call="project.portal_my_task_allocated_hours_template"/></div>
                                </div>
                                <div t-if="task.user_ids" class="d-lg-none" name="portal_my_task_assignees">
                                    <div class="text-muted">Assignees</div>
                                    <div t-foreach="task.user_ids" t-as="user" class="fw-medium" t-out="user.name"/>
                                </div>
                            </div>
                            <div t-if="task_link_section" id="task_mobile_buttons" class="d-flex d-lg-none flex-wrap gap-2 mt-3">
                                <a t-foreach="task_link_section" t-as="task_link" class="btn btn-light btn-sm" role="button"
                                    t-att-href="task_link['access_url']" t-att-target="task_link.get('target', '_self')" t-out="task_link['title']"/>
                            </div>
                        </div>
                        <div t-if="has_task_body" id="card_body" class="d-flex flex-column gap-4 p-3 p-lg-4 rounded-bottom border-start border-end border-bottom">
                            <div t-if="not is_html_empty(task.description)">
                                <strong class="d-block smaller text-uppercase text-muted mb-2">Description</strong>
                                <div class="overflow-auto" t-field="task.description"/>
                            </div>
                            <div t-if="task.attachment_ids" class="o_project_portal_attachments">
                                <strong class="d-block smaller text-uppercase text-muted mb-2">Attachments</strong>
                                <div class="oe_attachments d-flex flex-wrap gap-2">
                                    <a t-foreach="task.attachment_ids" t-as="attachment"
                                        t-attf-href="/web/content/#{attachment.id}?download=true&amp;access_token=#{attachment.access_token}"
                                        target="_blank" data-no-post-process=""
                                        class="d-flex align-items-center gap-2 mw-100 rounded bg-light p-2 pe-3 small text-reset text-decoration-none">
                                        <div class="oe_attachment_embedded o_image o_image_small flex-shrink-0"
                                            t-att-title="attachment.name" t-att-data-mimetype="attachment.mimetype"
                                            t-attf-data-src="/web/image/#{attachment.id}/50x40?access_token=#{attachment.access_token}"/>
                                        <div class="oe_attachment_name text-truncate" t-out="attachment.name"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <section t-if="task.partner_id" id="task_customer" class="p-3 p-lg-4 mt-4 rounded-3 border">
                        <div class="mb-2">
                            <span class="badge text-bg-info">Customer</span>
                        </div>
                        <div t-field="task.partner_id" t-options='{"widget": "contact", "fields": ["name", "email", "phone"]}'/>
                    </section>

                    <div id="task_chat" class="mt-4 p-3 p-lg-4 rounded-3 border" data-anchor="true">
                        <h4 class="pb-1">Communication History</h4>
                        <t t-call="portal.message_thread" token="task.access_token" hide_header="True"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_my_task_allocated_hours_template">
        <strong t-if="task.allocated_hours > 0" class="d-none">Allocated Time:</strong>
        <span t-out="task.env['account.analytic.line']._format_portal_hours(task.allocated_hours)"/>
    </template>
</odoo>
