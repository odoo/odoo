<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_phase_view_tree" model="ir.ui.view">
        <field name="name">project.phase.view.list</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <list editable="bottom" delete="0" sample="1">
                <field name="sequence" widget="handle" />
                <field name="name" placeholder="e.g. Planning" />
                <field
                    name="mail_template_id"
                    optional="hide"
                    context="{'default_model': 'project.project'}" />
                <field
                    name="company_id"
                    optional="hide"
                    options="{'no_create': True}"
                    groups="base.group_multi_company" />
                <field name="color" widget="color_picker" optional="hide" />
                <field name="fold" optional="show" />
            </list>
        </field>
    </record>

    <record id="project_phase_view_form_quick_create" model="ir.ui.view">
        <field name="name">project.phase.view.form.quick.create</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="e.g. Planning" />
                    <field name="mail_template_id" />
                    <field name="fold" />
                </group>
            </form>
        </field>
    </record>

    <record id="project_phase_view_form" model="ir.ui.view">
        <field name="name">project.phase.view.form</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <form delete="0">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <h1><field name="name" placeholder="e.g. Planning" /></h1>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field
                                name="mail_template_id"
                                context="{'default_model': 'project.project'}" />
                            <field name="color" widget="color_picker" />
                            <field name="sequence" groups="base.group_no_one" />
                        </group>
                        <group>
                            <field name="fold" />
                            <field
                                name="company_id"
                                placeholder="Visible to all"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_phase_view_kanban" model="ir.ui.view">
        <field name="name">project.phase.view.kanban</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <kanban
                sample="1"
                class="o_kanban_mobile"
                highlight_color="color"
                quick_create_view="project.project_phase_view_form_quick_create">
                <templates>
                    <t t-name="menu" t-if="!selection_mode" groups="base.group_user">
                        <field name="color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bolder mb-4" />
                        <field
                            name="mail_template_id"
                            invisible="not mail_template_id"
                            class="text-muted mb-2" />
                        <field
                            name="company_id"
                            groups="base.group_multi_company"
                            invisible="not company_id"
                            class="mb-2" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="project_phase_view_search" model="ir.ui.view">
        <field name="name">project.phase.view.search</field>
        <field name="model">project.phase</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="mail_template_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="project_phase_configure" model="ir.actions.act_window">
        <field name="name">Project Phases</field>
        <field name="res_model">project.phase</field>
        <field name="path">project-phases</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No phases found. Let's create one!
            </p><p>
                Define the lifecycle phases your projects move through from initiation to closure.
            </p>
        </field>
    </record>

    <record id="project_phase_configure_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_phase_view_tree" />
        <field name="act_window_id" ref="project_phase_configure" />
    </record>

    <record id="project_phase_configure_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="project_phase_view_kanban" />
        <field name="act_window_id" ref="project_phase_configure" />
    </record>

    <record id="project_phase_configure_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="project_phase_view_form" />
        <field name="act_window_id" ref="project_phase_configure" />
    </record>

    <record id="unlink_project_phase_action" model="ir.actions.server">
        <field name="name">Delete…</field>
        <field name="model_id" ref="project.model_project_phase" />
        <field name="binding_model_id" ref="project.model_project_phase" />
        <field name="binding_view_types">form,list,kanban</field>
        <field name="binding_icon">fa-regular fa-trash-can</field>
        <field name="state">code</field>
        <field
            name="code">action = records.action_open_delete_wizard(stage_view=True)</field>
    </record>

</odoo>
