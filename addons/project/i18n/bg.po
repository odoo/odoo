"info@yourcompany.com</a>\n"
"            </t>\n"
"            <t t-if=\"object.project_id.company_id.website\">\n"
"                | <a t-attf-href=\"{{ object.project_id.company_id.website }}"
"\" style=\"text-decoration:none; color: #454748;\" t-"
