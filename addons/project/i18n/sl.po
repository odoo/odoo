#. module: project
#: model:mail.template,body_html:project.project_done_email_template
#, fuzzy
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.partner_id.name or 'customer'\">Brandon Freeman</"
"t>,<br/>\n"
"    It is my pleasure to let you know that we have successfully completed "
"the project \"<strong t-out=\"object.name or ''\">Renovations</strong>\".\n"
"    <t t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></"
"div>\n"
"    </t>\n"
"</div>\n"
"<br/><span style=\"margin: 0px 0px 0px 0px; font-size: 12px; opacity: 0.5; "
"color: #454748;\" groups=\"project.group_project_stages\">You are receiving "
"this email because your project has been moved to the stage <b t-"
"out=\"object.stage_id.name or ''\">Done</b></span>\n"
"            "
msgstr ""
"<div>\n"
"    Spoštovani <t t-out=\"object.partner_id.name or 'customer'\">Brandon "
"Freeman</t>,<br/>\n"
"    Z veseljem vam sporočam, da smo uspešno zaključili projekt \"<strong t-"
"out=\"object.name or ''\">Renovations</strong>\".\n"
"    <t t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>"
"\n"
"    </t>\n"
"</div>\n"
"<br/><span style=\"margin: 0px 0px 0px 0px; font-size: 12px; opacity: 0.5; "
"color: #454748;\" groups=\"project.group_project_stages\">To e-pošto "
"prejemate, ker je bil vaš projekt premaknjen v fazo <b t-"
"out=\"object.stage_id.name or ''\">Končano</b></span>\n"
"            "

#. module: project
#: model:mail.template,body_html:project.mail_template_data_project_task
#, fuzzy
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.partner_id.name or 'customer'\">Brandon Freeman</"
"t>,<br/><br/>\n"
"    Thank you for contacting us. We appreciate your interest in our products/"
"services.<br/>\n"
"    Our team is currently reviewing your inquiry and will respond to your "
"email as soon as possible.<br/>\n"
"    If you have any further questions or concerns in the meantime, please do "
"not hesitate to let us know. We are here to help.<br/><br/>\n"
"    Thank you for your patience.<br/>\n"
"    Best regards,\n"
"    <t t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></"
"div>\n"
"    </t>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    Spoštovani <t t-out=\"object.partner_id.name or 'customer'\">Brandon "
"Freeman</t>,<br/><br/>\n"
"    Hvala, ker ste stopili v stik z nami. Cenimo vaše zanimanje za naše "
"izdelke/storitve.<br/>\n"
"    Naša ekipa trenutno pregleduje vaše povpraševanje in bo na vaše e-poštno "
"sporočilo odgovorila v najkrajšem možnem času.<br/>\n"
"    Če imate v tem času kakršna koli dodatna vprašanja ali pomisleke, nam to "
"brez oklevanja sporočite. Tukaj smo, da vam pomagamo.<br/><br/>\n"
"    Hvala za potrpežljivost.<br/>\n"
"    Lep pozdrav,\n"
"    <t t-if=\"user.signature\" data-o-mail-quote-container=\"1\">\n"
"        <br/>\n"
"        <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-"
"out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell Admin</t></div>"
"\n"
"    </t>\n"
"</div>\n"
"        "

