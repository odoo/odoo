<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_tutorial" model="web_tutorial.tutorial">
        <field name="name">project_tutorial</field>
        <field name="action_id" ref="open_view_project_all"/>
        <field name="title">Organize your projects</field>
        <field name="sequence">110</field>
        <field name="group_ids" eval="[Command.link(ref('group_project_manager'))]"/>
        <field name="rainbow_man_message">Congratulations, you are now a master of project management.</field>
    </record>

    <record id="project_tutorial_chapter_project_kanban" model="web_tutorial.chapter">
        <field name="tutorial_id" ref="project_tutorial"/>
        <field name="sequence">10</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="view_type">kanban</field>
    </record>

    <record id="project_tutorial_step_project_kanban_new" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_project_kanban"/>
        <field name="sequence">10</field>
        <field name="type">generic_button</field>
        <field name="name">New</field>
        <field name="content">Start a new project to organize your work.</field>
    </record>

    <record id="project_tutorial_chapter_project_form" model="web_tutorial.chapter">
        <field name="tutorial_id" ref="project_tutorial"/>
        <field name="sequence">20</field>
        <field name="model_id" ref="model_project_project"/>
        <field name="view_type">form</field>
    </record>

    <record id="project_tutorial_step_project_form_name" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_project_form"/>
        <field name="sequence">10</field>
        <field name="type">field</field>
        <field name="name">name</field>
        <field name="content">Give your project a name, e.g. Office move or Website redesign.</field>
    </record>

    <record id="project_tutorial_step_project_form_action_view_tasks" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_project_form"/>
        <field name="sequence">20</field>
        <field name="type">method</field>
        <field name="name">action_view_tasks</field>
        <field name="content">All set! Create your project and jump into its tasks.</field>
    </record>

    <record id="project_tutorial_chapter_task_kanban" model="web_tutorial.chapter">
        <field name="tutorial_id" ref="project_tutorial"/>
        <field name="sequence">30</field>
        <field name="model_id" ref="model_project_task"/>
        <field name="view_type">kanban</field>
    </record>

    <record id="project_tutorial_step_task_kanban_new" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_kanban"/>
        <field name="sequence">10</field>
        <field name="type">generic_button</field>
        <field name="name">New</field>
        <field name="content">Now, create your first task.</field>
    </record>

    <record id="project_tutorial_chapter_task_form" model="web_tutorial.chapter">
        <field name="tutorial_id" ref="project_tutorial"/>
        <field name="sequence">40</field>
        <field name="model_id" ref="model_project_task"/>
        <field name="view_type">form</field>
    </record>

    <record id="project_tutorial_step_task_form_name" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_form"/>
        <field name="sequence">10</field>
        <field name="type">field</field>
        <field name="name">name</field>
        <field name="content">What needs to be done? Describe the task in a few words.</field>
    </record>

    <record id="project_tutorial_step_task_form_user_ids" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_form"/>
        <field name="sequence">20</field>
        <field name="type">field</field>
        <field name="name">user_ids</field>
        <field name="content">Who's on it? Assign the task to yourself or a teammate.</field>
    </record>

    <record id="project_tutorial_step_task_form_priority" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_form"/>
        <field name="sequence">30</field>
        <field name="type">field</field>
        <field name="name">priority</field>
        <field name="content">Is it urgent? Star it so it stands out.</field>
    </record>

    <record id="project_tutorial_step_task_form_tag_ids" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_form"/>
        <field name="sequence">40</field>
        <field name="type">field</field>
        <field name="name">tag_ids</field>
        <field name="content">Add tags to find similar tasks at a glance (e.g. Design, Bug).</field>
    </record>

    <record id="project_tutorial_step_task_form_date_deadline" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_form"/>
        <field name="sequence">50</field>
        <field name="type">field</field>
        <field name="name">date_deadline</field>
        <field name="content">When should it be done? Set a deadline.</field>
    </record>

    <record id="project_tutorial_step_task_form_description" model="web_tutorial.step">
        <field name="chapter_id" ref="project_tutorial_chapter_task_form"/>
        <field name="sequence">60</field>
        <field name="type">field</field>
        <field name="name">description</field>
        <field name="content">Write down the details, so everyone knows what to do.</field>
    </record>
</odoo>
