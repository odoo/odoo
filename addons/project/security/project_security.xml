<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_project" model="res.groups.privilege">
        <field name="name">Project</field>
        <field name="sequence">3</field>
        <field name="category_id" ref="base.module_category_services" />
    </record>

    <record id="group_project_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_project" />
        <field
            name="comment">User: Can manage tasks in projects shared with them.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_project_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_project" />
        <field
            name="comment">Administrator: Can manage projects and stages, with access to reporting and configuration.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('project.group_project_user')), Command.link(ref('mail.group_mail_canned_response_admin'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

    <record id="group_project_stages" model="res.groups">
        <field name="name">Use Stages on Project</field>
    </record>

    <record id="group_project_recurring_tasks" model="res.groups">
        <field name="name">Use Recurring Tasks</field>
    </record>

    <record id="group_project_task_dependencies" model="res.groups">
        <field name="name">Use Task Dependencies</field>
    </record>

    <record id="group_project_milestone" model="res.groups">
        <field name="name">Use Milestones</field>
    </record>

</odoo>
