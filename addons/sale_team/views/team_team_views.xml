<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="team_view_search_sale" model="ir.ui.view">
            <field name="name">team.view.search.sale</field>
            <field name="model">team.team</field>
            <field name="inherit_id" ref="team.team_view_search" />
            <field name="arch" type="xml">
                <xpath expr="//separator[@name='usages']" position="before">
                    <filter
                        name="use_sale"
                        string="Sales"
                        domain="[('use_sale', '=', True)]" />
                </xpath>
            </field>
        </record>
        <record id="team_view_form_sale" model="ir.ui.view">
            <field name="name">team.view.form.sale</field>
            <field name="model">team.team</field>
            <field name="inherit_id" ref="team.team_view_form" />
            <field name="arch" type="xml">
                <div name="usages" position="inside">
                    <span class="d-inline-flex">
                        <field name="use_sale" />
                        <label for="use_sale" />
                    </span>
                </div>
                <field name="company_id" position="after">
                    <field name="currency_id" invisible="1" />
                </field>
            </field>
        </record>
        <record id="team_action_sales" model="ir.actions.act_window">
            <field name="name">Sales Teams</field>
            <field name="res_model">team.team</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="team.team_view_kanban_dashboard" />
            <field name="domain">[('use_sale', '=', True)]</field>
            <field
                name="context">{'in_sales_app': True, 'default_use_sale': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define a new sales team
                </p><p>
                    Use Sales Teams to organize your sales departments.
                    Each team will work with a separate pipeline.
                </p>
            </field>
        </record>
        <record id="team_action_pipeline" model="ir.actions.act_window">
            <field name="name">Teams</field>
            <field name="res_model">team.team</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="team.team_view_kanban_dashboard" />
            <field name="domain">[('use_sale', '=', True)]</field>
            <field name="context">{'default_use_sale': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define a new sales team
                </p><p>
                    Use Sales Teams to organize your sales departments.
                    Each team will work with a separate pipeline.
                </p>
            </field>
        </record>
        <record id="team_action_config" model="ir.actions.act_window">
            <field name="name">Sales Teams</field>
            <field name="res_model">team.team</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('use_sale', '=', True)]</field>
            <field name="context">{'default_use_sale': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Sales Team
                </p><p>
                    Use Sales Teams to organize your sales departments and draw up reports.
                </p>
            </field>
        </record>
        <record id="team_member_action_sales" model="ir.actions.act_window">
            <field name="name">Team Members</field>
            <field name="res_model">team.member</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('team_id.use_sale', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new salesman
                </p><p>
                    Link salespersons to sales teams.
                </p>
            </field>
        </record>
        <record id="action_quotations_salesteams" model="ir.actions.act_window">
            <field name="name">Quotations</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form,calendar,graph,kanban,pivot</field>
            <field name="view_id" ref="sale.view_sale_order_list_quotation" />
            <field name="search_view_id" ref="sale.view_sale_order_search_quotation" />
            <field name="domain">[]</field>
            <field
                name="context">{
                'search_default_team_id': [active_id],
                'default_team_id': active_id,
                'show_address': 1,
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new quotation, the first step of a new sale!
                </p>
                <p> Once the quotation is confirmed by the customer, it becomes a sales order.<br /> You
                    will be able to create an invoice and collect the payment. </p>
            </field>
        </record>
        <record id="action_quotation_form" model="ir.actions.act_window">
            <field name="name">New Quotation</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">form</field>
            <field name="search_view_id" ref="sale.view_sale_order_search_quotation" />
            <field
                name="context">{
                'search_default_team_id': [active_id],
                'default_team_id': active_id,
                'default_user_id': uid,
                }</field>
        </record>
        <record id="action_orders_salesteams" model="ir.actions.act_window">
            <field name="name">Sales Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form,calendar,graph,kanban,pivot</field>
            <field name="search_view_id" ref="sale.view_sale_order_search_2" />
            <field name="domain">[('state','not in',('draft','cancel'))]</field>
            <field
                name="context">{
                'search_default_team_id': [active_id],
                'default_team_id': active_id,
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new quotation, the first step of a new sale!
                </p>
                <p> Once the quotation is confirmed by the customer, it becomes a sales order.<br /> You
                    will be able to create an invoice and collect the payment. </p>
            </field>
        </record>
        <record id="action_orders_to_invoice_salesteams" model="ir.actions.act_window">
            <field name="name">Sales Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form,calendar,graph,kanban,pivot</field>
            <field name="search_view_id" ref="sale.view_sale_order_search_2" />
            <field name="domain">[('invoice_state','in',['to do','partial'])]</field>
            <field
                name="context">{
                'search_default_team_id': [active_id],
                'default_team_id': active_id,
                }</field>
        </record>
        <record id="crm_team_salesteams_view_form" model="ir.ui.view">
            <field name="name">team.team.form</field>
            <field name="model">team.team</field>
            <field name="inherit_id" ref="team.team_view_form" />
            <field name="priority">9</field>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <label for="invoiced_target" invisible="not use_sale" />
                    <div class="o_row" id="invoiced_target" invisible="not use_sale">
                        <field
                            name="invoiced_target"
                            widget="monetary"
                            options="{'currency_field': 'currency_id'}"
                            class="oe_inline" />
                        <span class="flex-grow-1">/ Month</span>
                    </div>
                </field>
            </field>
        </record>
        <record id="crm_team_view_kanban_dashboard" model="ir.ui.view">
            <field name="name">crm.team.view.kanban.dashboard.inherit.sale</field>
            <field name="model">team.team</field>
            <field name="inherit_id" ref="team.team_view_kanban_dashboard" />
            <field name="arch" type="xml">
                <xpath expr="//templates" position="before">
                    <field name="invoiced_target" />
                </xpath>
                <xpath expr="//div[@name='manage_view']" position="inside">
                    <div>
                        <a name="%(action_orders_salesteams)d" type="action">Sales Orders</a>
                    </div>
                    <div groups="account.group_account_invoice">
                        <a name="%(action_invoice_salesteams)d" type="action">Invoices</a>
                    </div>
                </xpath>
                <div name="o_team_kanban_report_separator" position="before">
                    <div name="sales_report">
                        <a name="%(action_sale_report_so_salesteam)d" type="action">Sales</a>
                    </div>
                    <div groups="account.group_account_invoice" name="invoices_report">
                        <a name="%(action_account_invoice_report_salesteam)d" type="action">Invoices</a>
                    </div>
                </div>
            </field>
        </record>
    </data>

</odoo>
