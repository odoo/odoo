<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale_team</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <block name="sale_app_setting_container" position="after">
                <block name="sales_team_setting_container" title="Sales Teams">
                    <setting help="Assign salespersons into multiple Sales Teams.">
                        <field name="is_membership_multi" />
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
