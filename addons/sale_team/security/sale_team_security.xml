<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!--
            A Sales Administrator creates, edits and deletes sales teams only.
            Reads stay with team's own rules, so perm_read is off: a team's name
            is rendered on invoices and orders read far outside Sales.
            Deleting a team another application also uses takes a Teams
            Administrator (team.team._unlink_except_foreign_usage).
        -->
        <record id="team_team_rule_sale_manager" model="ir.rule">
            <field name="name">Sales teams: Sales Administrators</field>
            <field name="model_id" ref="team.model_team_team" />
            <field name="domain_force">[('use_sale', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <record id="team_member_rule_sale_manager" model="ir.rule">
            <field name="name">Sales team members: Sales Administrators</field>
            <field name="model_id" ref="team.model_team_member" />
            <field name="domain_force">[('team_id.use_sale', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <!--
            team.member_rule_personal shows every internal user the rosters of the
            teams they lead or belong to; "All Documents" widens that to every
            sales team's roster, OR-ed over it.
        -->
        <record id="team_member_rule_sale_all" model="ir.rule">
            <field name="name">Sales team members: All Documents</field>
            <field name="model_id" ref="team.model_team_member" />
            <field name="domain_force">[('team_id.use_sale', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_all_leads'))]" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
        <record id="team_alias_rule_sale_manager" model="ir.rule">
            <field name="name">Sales team aliases: Sales Administrators</field>
            <field name="model_id" ref="team.model_team_alias" />
            <field name="domain_force">[('team_id.use_sale', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <record id="sale_order_team_rule" model="ir.rule">
            <field name="name">Team Orders</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field
                name="domain_force">['|', ('user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="sale_order_line_team_rule" model="ir.rule">
            <field name="name">Team Order Lines</field>
            <field name="model_id" ref="sale.model_sale_order_line" />
            <field
                name="domain_force">['|', ('user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="sale_order_report_team_rule" model="ir.rule">
            <field name="name">Team Orders Analysis</field>
            <field name="model_id" ref="sale.model_sale_report" />
            <field
                name="domain_force">['|', ('user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="account_invoice_report_rule_see_team" model="ir.rule">
            <field name="name">Team Customer Invoices Analysis</field>
            <field name="model_id" ref="account.model_account_invoice_report" />
            <field
                name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), '|', ('invoice_user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('invoice_user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="account_invoice_rule_see_team" model="ir.rule">
            <field name="name">Team Invoices</field>
            <field name="model_id" ref="account.model_account_move" />
            <field
                name="domain_force">[('move_type', 'in', ('out_invoice', 'out_refund')), '|', ('invoice_user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('invoice_user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="account_invoice_line_rule_see_team" model="ir.rule">
            <field name="name">Team Invoice Lines</field>
            <field name="model_id" ref="account.model_account_move_line" />
            <field
                name="domain_force">[('move_id.move_type', 'in', ('out_invoice', 'out_refund')), '|', ('move_id.invoice_user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('move_id.invoice_user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="account_invoice_send_single_rule_see_team" model="ir.rule">
            <field name="name">Team Invoice Send and Print (single mode)</field>
            <field name="model_id" ref="account.model_account_move_send_wizard" />
            <field
                name="domain_force">[('move_id.move_type', 'in', ('out_invoice', 'out_refund')), '|', ('move_id.invoice_user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('move_id.invoice_user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
        <record id="account_invoice_send_batch_rule_see_team" model="ir.rule">
            <field name="name">Team Invoice Send and Print (batch mode)</field>
            <field name="model_id" ref="account.model_account_move_send_batch_wizard" />
            <field
                name="domain_force">[('move_ids.move_type', 'in', ('out_invoice', 'out_refund')), '|', ('move_ids.invoice_user_id.sale_team_ids', 'in', user.sale_team_ids.ids), ('move_ids.invoice_user_id', '=', False)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sale.group_sale_salesman_team'))]" />
        </record>
    </data>

</odoo>
