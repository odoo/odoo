<odoo>
    <record id="dom-tom" model="res.country.group">
             <field name="name">DOM-TOM</field>
             <field name="country_ids" eval="[(6,0,[
                                                ref('base.yt'),
                                                ref('base.gp'),
                                                ref('base.mq'),
                                                ref('base.gf'),
                                                ref('base.re'),
                                                ref('base.pf'),
                                                ref('base.pm'),
                                                ref('base.mf'),
                                                ref('base.bl'),
                                                ref('base.nc')])]"/>
       </record>

        <!-- Not used anymore to remove in master -->
        <record id="fr_and_mc" model="res.country.group">
            <field name="name">France and Monaco</field>
            <field name="country_ids" eval="[Command.set([ref('base.fr'), ref('base.mc')])]"/>
        </record>

        <record id="fr_and_mc_and_drom" model="res.country.group">
            <field name="name">France and Monaco and Drom</field>
            <field name="country_ids" eval="[
                Command.set([
                    ref('base.fr'),
                    ref('base.mc'),
                    ref('base.gf'),
                    ref('base.gp'),
                    ref('base.mq'),
                    ref('base.re'),
                    ref('base.yt'),
                ])
            ]"/>
    </record>
</odoo>
