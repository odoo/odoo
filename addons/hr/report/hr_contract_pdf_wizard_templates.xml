<?xml version="1.0"?>
<odoo>
<template id="report_contract">
    <!-- contract_lang: the language printed, set by the caller -->
    <t t-set="o" t-value="o.with_context(lang=contract_lang.code)"/>
    <t t-call="web.external_layout">
        <div class="page">
            <h2 class="text-center mb-4">Employment Contract</h2>
            <p t-if="contract_lang != o.contract_lang_id" name="duplicate_notice" class="text-center fst-italic mb-4">
                Translation given for information: the <t t-out="o.contract_lang_id.name"/> version prevails.
            </p>

            <!-- Articles are numbered by the list, localizations can insert theirs with xpath on the article names -->
            <ol name="contract_articles" class="ps-3">
                <li name="article_parties" class="mb-3">
                    <h5>Parties</h5>
                    <p>
                        This employment contract is entered into between <strong t-field="o.company_id"/>,
                        hereinafter referred to as "the Employer", and <strong t-field="o.legal_name"/>, hereinafter referred to as "the Employee".
                    </p>
                </li>

                <li name="article_position" class="mb-3">
                    <h5>Position</h5>
                    <p>
                        The Employee is hired as <strong t-field="o.job_id"/>.
                        The Employee shall perform the duties related to this position, as well as any other task
                        reasonably assigned by the Employer in line with the Employee's qualifications.
                    </p>
                </li>

                <li name="article_duration" class="mb-3">
                    <h5>Duration</h5>
                    <p>
                        This contract takes effect on <strong t-field="o.contract_date_start"/>
                        <t t-if="o.contract_date_end">
                            and is concluded for a fixed term ending on <strong t-field="o.contract_date_end"/>.
                        </t>
                        <t t-else="">
                            and is concluded for an indefinite period.
                        </t>
                    </p>
                </li>

                <li name="article_work_location" class="mb-3">
                    <h5>Work Location</h5>
                    <p>
                        The Employee will primarily perform their duties at
                        <t t-if="o.work_location"><strong t-field="o.work_location"/>.</t>
                        <t t-else="">the premises of the Employer.</t>
                        The Employer may require the Employee to work at another location when the needs of the
                        business so require.
                    </p>
                </li>

                <li name="article_work_schedule" class="mb-3">
                    <h5>Work Schedule</h5>
                    <p>
                        <t t-if="o.working_hours">The working hours of the Employee are: <strong t-field="o.working_hours"/>.</t>
                        The working hours may be adapted by the Employer within the limits set by the applicable law.
                    </p>
                </li>

                <li name="article_remuneration" class="mb-3">
                    <h5>Remuneration</h5>
                    <p>
                        In consideration of their services, the Employee will receive a gross monthly wage of
                        <strong t-field="o.wage"/>, payable at the end of each month, subject to the deductions
                        required by law.
                    </p>
                    <t t-set="benefit_lines" t-value="o._get_contract_benefits()"/>
                    <p t-if="benefit_lines or o.benefits" name="benefits">
                        In addition, the Employee is entitled to the following benefits:<br/>
                        <t t-foreach="benefit_lines" t-as="benefit_line"><t t-out="benefit_line"/><br/></t>
                        <span t-if="o.benefits" t-field="o.benefits"/>
                    </p>
                </li>

                <li name="article_termination" class="mb-3">
                    <h5>Termination</h5>
                    <p>
                        Either party may terminate this contract by giving written notice to the other party, in
                        accordance with the notice periods and conditions provided by the applicable law.
                        The contract may be terminated without notice in case of serious misconduct.
                        <t t-if="o.contract_date_end">
                            Unless renewed, this contract ends automatically at the end of its term.
                        </t>
                    </p>
                </li>
            </ol>

            <div name="signatures" class="mt-5" style="page-break-inside: avoid;">
                <p>Done in two copies, each party acknowledging receipt of their own copy.</p>
                <table class="table table-borderless w-100" style="table-layout: fixed;">
                    <tr>
                        <td class="ps-0"><strong>For the Employer</strong></td>
                        <td class="ps-0"><strong>The Employee</strong></td>
                    </tr>
                    <tr>
                        <td class="ps-0"><span t-field="o.company_id"/></td>
                        <td class="ps-0"><span t-field="o.legal_name"/></td>
                    </tr>
                    <tr>
                        <td class="ps-0">Date:</td>
                        <td class="ps-0">Date:</td>
                    </tr>
                    <tr>
                        <td class="ps-0 pt-5">Signature</td>
                        <td class="ps-0 pt-5">Signature</td>
                    </tr>
                </table>
            </div>
        </div>
    </t>
</template>

<template id="report_contract_lang">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-foreach="o._get_contract_langs()" t-as="contract_lang">
                <t t-call="{{ o._get_contract_report_template(contract_lang) }}" t-lang="contract_lang.code"/>
            </t>
        </t>
    </t>
</template>
</odoo>
