<?xml version="1.0"?>
<templates xml:space="preserve">

    <t t-name="hr.VersionsTimeline" t-inherit="web.StatusBarField" t-inherit-mode="primary">
        <div t-ref="this.rootRef" position="after">
            <div class="o_arrow_button_wrapper">
                <button
                    t-ref="this.datetimePickerTargetRef"
                    title="New Employee Record"
                    t-on-click="this.onClickDateTimePickerBtn"
                    class="btn btn-primary">
                    <i class="oi" data-icon="add"/>
                </button>
            </div>
        </div>

        <t t-foreach="this.items.inline" position="replace">
            <t t-foreach="this.items.inline" t-as="item" t-key="item.value">
                <div class="o_arrow_button_wrap position-relative">
                    <button
                        type="button"
                        class="btn btn-secondary o_arrow_button"
                        t-att-class="{
                            o_first: item_first,
                            o_arrow_button_current: item.isSelected,
                            o_last: item_last,
                        }"
                        t-att-disabled="this.props.isDisabled || item.isSelected"
                        role="radio"
                        t-att-aria-checked="item.isSelected.toString()"
                        t-att-aria-current="item.isSelected and 'step'"
                        t-att-data-value="item.value"
                        t-on-click="() => this.selectItem(item)"
                        t-att-data-tooltip="item.toolTip">
                        <t t-out="item.label"/>
                    </button>
                    <span
                        t-if="this.displayContractLines()"
                        class="o_contract_line position-absolute start-0 end-0 d-block"
                        t-att-class="{
                            'border-top border-primary': item.isInContract and item.isCurrentContract,
                            o_contract_line_continued: this.isContractLineContinued(item_index),
                        }"/>
                </div>
            </t>
        </t>
    </t>
</templates>
