<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resource_calendar_form_view_inherit_hr" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit.hr</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_view_resource_calendar_employees)d" type="action"
                        icon="fa-users"
                        class="oe_stat_button"
                        groups="base.group_user">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">
                                <field name="employees_count" string="Employees" widget="statinfo"/>
                            </span>
                        </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning text-start o_form_header" 
                    role="alert" 
                    invisible="not is_duplicate_calendar">
                    <span>Some Working Schedules have the same calendar as this one → </span>
                    <button name="action_view_duplicate_working_schedules" 
                            type="object" 
                            class="btn btn-link p-0 align-baseline fw-bold" 
                            string="See Duplicate Working Schedules"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="resource_calendar_form_view_inherit_hr_js" model="ir.ui.view">
        <field name="inherit_id" ref="resource.resource_calendar_form" />
        <field name="model">resource.calendar</field>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="js_class">resource_calendar_form</attribute>
            </form>
        </field>
    </record>
</odoo>
