<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_users_view_form_simple_modif" model="ir.ui.view">
            <field name="name">res.users.preferences.form.simplified.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="string">Preferences</attribute>
                </form>
            </field>
        </record>
        <record id="view_users_form_simple_modif_resource" model="ir.ui.view">
            <field name="name">res.users.preferences.form.resource</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif" />
            <field name="arch" type="xml">
                <field name="tz" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
                <field name="tz" position="after">
                    <field name="is_system" invisible="1" />
                </field>
                <xpath
                    expr="//button[@name='%(base.action_view_base_language_install)d']"
                    position="attributes">
                    <attribute name="invisible">not is_system</attribute>
                </xpath>
            </field>
        </record>
        <record id="res_users_view_form_preferences" model="ir.ui.view">
            <field name="name">res.users.preferences.form.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="res_users_view_form_simple_modif" />
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="js_class">hr_user_preferences_form</attribute>
                </form>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="placeholder">Employee's Name</attribute>
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//h5[@name='h5_email']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//h5[@name='h5_phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]" position="inside">
                    <h5 class="d-flex align-items-baseline mb-0">
                        <i
                            class="fa-solid fa-envelope me-1 text-primary"
                            title="Work Email" />
                        <field
                            name="work_email"
                            string="Work Email"
                            placeholder="Work Email"
                            widget="email"
                            readonly="not is_hr_user"
                            class="w-75" />
                    </h5>
                    <h5 class="d-flex align-items-baseline mb-0">
                        <i
                            class="fa-solid fa-phone me-1 text-primary"
                            title="Work Phone" />
                        <field
                            name="phone_ids"
                            string="Work Phone"
                            placeholder="Work Phone"
                            widget="many2many_tags"
                            class="w-75" />
                    </h5>
                </xpath>
                <xpath expr="//group[@name='other_preferences']" position="inside">
                    <field
                        name="pin"
                        string="Attendance PIN"
                        readonly="not is_hr_user" />
                </xpath>
                <xpath
                    expr="//group[@name='other_calendar_preferences']"
                    position="inside">
                    <field
                        name="work_location_id"
                        string="Main Work Location"
                        options="{'no_create': True}"
                        readonly="not is_hr_user" />
                </xpath>
                <xpath expr="//page[@name='calendar']" position="after">
                    <page name="private_information" string="Private">
                        <div
                            class="alert alert-info"
                            role="status"
                            invisible="is_hr_user">
                            <span>Your personal information is maintained by HR. Ask for a change and an HR user will review it.</span>
                            <button
                                name="action_request_information_change"
                                type="object"
                                string="Request a change"
                                class="btn-link" />
                        </div>
                        <group>
                            <group string="Private Information">
                                <field name="employee_ids" invisible="1" />
                                <field name="is_hr_user" invisible="1" />
                                <label for="private_street" string="Private Address" />
                                <div class="o_address_format">
                                    <field
                                        name="private_street"
                                        placeholder="Street..."
                                        readonly="not is_hr_user"
                                        class="o_address_street" />
                                    <field
                                        name="private_street2"
                                        placeholder="Street 2..."
                                        readonly="not is_hr_user"
                                        class="o_address_street" />
                                    <field
                                        name="private_city"
                                        placeholder="City"
                                        readonly="not is_hr_user"
                                        class="o_address_city" />
                                    <field
                                        name="private_state_id"
                                        placeholder="State"
                                        context="{'default_country_id': private_country_id}"
                                        options="{'no_open': True, 'no_create': True}"
                                        readonly="not is_hr_user"
                                        class="o_address_state" />
                                    <field
                                        name="private_zip"
                                        placeholder="ZIP"
                                        readonly="not is_hr_user"
                                        class="o_address_zip" />
                                    <field
                                        name="private_country_id"
                                        placeholder="Country"
                                        options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"
                                        readonly="not is_hr_user"
                                        class="o_address_country" />
                                </div>
                                <field
                                    name="private_email"
                                    string="Private Email"
                                    readonly="not is_hr_user" />
                                <field
                                    name="private_phone_ids"
                                    string="Private Phone"
                                    widget="many2many_tags"
                                    readonly="not is_hr_user" />
                            </group>
                            <group string="Emergency Contact">
                                <field
                                    name="emergency_contact"
                                    string="Contact Name"
                                    placeholder="e.g. John Doe"
                                    readonly="not is_hr_user" />
                                <field
                                    name="emergency_phone_ids"
                                    string="Contact Phone"
                                    widget="many2many_tags"
                                    readonly="not is_hr_user" />
                            </group>
                            <group string="Personal Information">
                                <field name="legal_name" readonly="not is_hr_user" />
                                <field name="sex" readonly="not is_hr_user" />
                                <field name="birthday" readonly="not is_hr_user" />
                                <field
                                    name="birthday_public_display"
                                    readonly="not is_hr_user" />
                                <field
                                    name="place_of_birth"
                                    readonly="not is_hr_user" />
                                <field
                                    name="country_of_birth"
                                    options="{'no_create': True}"
                                    readonly="not is_hr_user" />
                                <field name="marital" readonly="not is_hr_user" />
                                <field
                                    name="spouse_complete_name"
                                    invisible="marital not in ['married', 'cohabitant']"
                                    readonly="not is_hr_user" />
                                <field
                                    name="spouse_birthdate"
                                    invisible="marital not in ['married', 'cohabitant']"
                                    readonly="not is_hr_user" />
                                <field name="children" readonly="not is_hr_user" />
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="view_users_simple_form_inherit_hr" model="ir.ui.view">
            <field name="name">view.users.simple.form.inherit.hr</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_employees"
                            type="object"
                            icon="fa-users"
                            context="{'active_test': False}"
                            invisible="employee_count == 0"
                            class="oe_stat_button">
                            <field
                                name="employee_count"
                                string="Employee"
                                widget="statinfo" />
                        </button>
                    </div>
                </xpath>
                <xpath expr="//group[@name='access_groups']" position="inside">
                    <field name="create_employee_id" force_save="1" invisible="1" />
                    <field
                        name="create_employee"
                        string="Create Employee"
                        force_save="1"
                        groups="hr.group_hr_user"
                        invisible="1" />
                </xpath>
            </field>
        </record>
        <record id="view_users_simple_form" model="ir.ui.view">
            <field name="name">view.users.simple.form.hr</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <sheet position="after">
                    <footer>
                        <button special="save" string="Save" class="btn btn-primary" />
                        <button
                            special="cancel"
                            string="Cancel"
                            class="btn btn-secondary" />
                    </footer>
                </sheet>
            </field>
        </record>
        <record id="res_users_action_my" model="ir.actions.act_window">
            <field name="name">Change my Preferences</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr.res_users_view_form_preferences" />
            <field name="target">new</field>
        </record>
        <record id="res_users_view_form" model="ir.ui.view">
            <field name="name">res.users.form.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <field name="share" invisible="1" />
                    <field name="employee_ids" invisible="1" />
                    <field name="employee_id" invisible="1" />
                    <button
                        name="action_create_employee"
                        type="object"
                        string="Create employee"
                        groups="hr.group_hr_user"
                        invisible="not id or share or employee_id" />
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                        name="action_view_employees"
                        type="object"
                        icon="fa-users"
                        context="{'active_test': False}"
                        invisible="employee_count == 0"
                        class="oe_stat_button">
                        <field
                            name="employee_count"
                            string="Employee"
                            widget="statinfo" />
                    </button>
                    <button
                        name="action_view_related_contact"
                        type="object"
                        help="Related Contact"
                        icon="fa-regular fa-address-card"
                        class="oe_stat_button">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Contact</span>
                        </div>
                    </button>
                </xpath>
                <field name="image_1920" position="attributes" widget="contact_image">
                    <attribute name="invisible">employee_id and work_email != login</attribute>
                </field>
                <field name="image_1920" position="after" widget="contact_image">
                    <field
                        name="image_1920"
                        widget="contact_image"
                        options="{'preview_image': 'avatar_128', 'img_class': 'rounded-4'}"
                        invisible="not employee_id or work_email == login"
                        class="o_contact_image_large" />
                </field>
                <xpath expr="//h5[@name='h5_email']" position="attributes">
                    <attribute name="invisible">employee_id</attribute>
                </xpath>
                <xpath expr="//h5[@name='h5_phone']" position="attributes">
                    <attribute name="invisible">employee_id</attribute>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]" position="inside">
                    <h5
                        class="d-flex flex-wrap align-items-baseline mb-0"
                        invisible="not employee_id">
                        <div class="w-100">
                            <i
                                class="fa-solid fa-envelope me-1 text-primary"
                                title="Login / Email"
                                invisible="login != work_email" />
                            <i
                                class="fa-solid fa-key me-1 text-primary"
                                title="Login"
                                invisible="login == work_email" />
                            <field name="login" placeholder="Login" class="w-75" /><br />
                        </div>

                        <i
                            class="fa-solid fa-envelope me-1 text-primary"
                            title="Work Email"
                            invisible="login == work_email" />
                        <field name="email_domain_placeholder" invisible="1" />
                        <field
                            name="work_email"
                            string="Work Email"
                            widget="email"
                            options="{'placeholder_field': 'email_domain_placeholder'}"
                            invisible="login == work_email"
                            class="w-75" />
                    </h5>
                    <h5
                        class="d-flex align-items-baseline mb-0"
                        invisible="not employee_id">
                        <i
                            class="fa-solid fa-phone me-1 text-primary"
                            title="Work Phone" />
                        <field
                            name="phone_ids"
                            string="Work Phone"
                            placeholder="Work Phone"
                            widget="many2many_tags"
                            class="w-75" />
                    </h5>
                </xpath>
                <xpath expr="//group[@name='other_preferences']" position="inside">
                    <field
                        name="pin"
                        string="Attendance PIN"
                        invisible="not employee_id" />
                </xpath>
                <xpath
                    expr="//group[@name='other_calendar_preferences']"
                    position="inside">
                    <field
                        name="work_location_id"
                        string="Main Work Location"
                        invisible="not employee_id or share" />
                </xpath>
                <xpath expr="//page[@name='calendar']" position="attributes">
                    <attribute name="groups">hr.group_hr_user</attribute>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
