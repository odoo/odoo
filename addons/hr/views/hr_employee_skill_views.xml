<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_skill_view_form" model="ir.ui.view">
        <field name="name">hr.employees.skill.form</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <form string="Skills" class="o_hr_skills_dialog_form">
                <sheet>
                    <group>
                        <field name="employee_id" widget="many2one_avatar_employee" invisible="not context.get('show_employee', False)"/>
                        <field name="skill_type_id" widget="badges_many2one" string="Category"/>
                        <field name="skill_id" widget="badges_many2one"
                            context="{'default_skill_type_id': skill_type_id}"
                            domain="[('skill_type_id', '=', skill_type_id)]"
                            invisible="not skill_type_id"/>
                        <field name="skill_level_id"
                            readonly="not skill_id" widget="badges_many2one"
                            invisible="levels_count &lt;= 1"
                            context="{'default_skill_type_id': skill_type_id}"/>
                        <label for="valid_from" string="Validity" class="me-1" invisible="not is_certification"/>
                        <div class="d-flex flex-row" invisible="not is_certification">
                            <field name="valid_from" nolabel="1" class="w-25" required="is_certification" default_focus="1"/>
                            <label for="valid_to" string="To" class="mx-1"/>
                            <field name="valid_to" placeholder="indefinite" nolabel="1" class="w-25"/>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="certificate_file" string="Certificate" invisible="not is_certification"/>
                            <field name="credential_url" widget="url" invisible="not is_certification"
                                placeholder="e.g. https://www.credly.com/badges/..."/>
                        </group>
                    </group>
                    <div class="alert alert-warning ps-3" role="alert" invisible="not display_warning_message">
                        The end date must be after the start date.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="employee_skill_view_inherit_certificate_form" model="ir.ui.view">
        <field name="name">hr.employees.skill.inherit.certificate.form</field>
        <field name="model">hr.employee.skill</field>
        <field name="inherit_id" ref="employee_skill_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="skill_type_id" position="attributes">
                <attribute name="domain">[('is_certification', '=', True)]</attribute>
                <attribute name="invisible">certification_skill_type_count &lt;= 1</attribute>
            </field>
        </field>
    </record>

    <record id="hr_employee_skill_view_kanban_certification" model="ir.ui.view">
        <field name="name">hr.employee.skill.view.kanban.certification</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <kanban class="o_hr_certification_kanban">
                <field name="valid_to"/>
                <field name="certificate_file"/>
                <field name="credential_url"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <t t-set="is_expired" t-value="record.valid_to.raw_value and luxon.DateTime.fromISO(record.valid_to.raw_value) &lt; luxon.DateTime.local().startOf('day')"/>
                        <main t-att-class="{'opacity-50': is_expired}">
                            <field name="skill_id" class="fw-bold fs-5"/>
                            <div>Valid from <field name="valid_from" widget="formatted_date" class="d-inline"/></div>
                            <div t-if="record.valid_to.raw_value">
                                Until <field name="valid_to" widget="formatted_date" class="d-inline" options="{
                                    'color': {
                                        'danger': 'valid_to and valid_to &lt;= (context_today() + relativedelta(days=7)).strftime(\'%Y-%m-%d\') and valid_to &gt;= context_today().strftime(\'%Y-%m-%d\')',
                                        'warning': 'valid_to and valid_to &lt;= (context_today() + relativedelta(months=3)).strftime(\'%Y-%m-%d\') and valid_to &gt; (context_today() + relativedelta(days=7)).strftime(\'%Y-%m-%d\')'
                                    }
                                }"/>
                                <span t-if="is_expired" class="badge rounded-pill text-bg-secondary ms-1">Expired</span>
                            </div>
                            <div t-else="">No end date</div>
                            <div t-if="record.credential_url.raw_value" class="mt-1">
                                <a t-att-href="record.credential_url.raw_value" target="_blank" rel="noopener noreferrer"
                                    class="badge rounded-pill text-bg-info">
                                    Credentials <i class="oi" data-icon="open_in_new" role="img" aria-hidden="true"/>
                                </a>
                            </div>
                        </main>
                        <aside name="certificate" class="ms-2" t-att-class="{'opacity-50': is_expired}">
                            <t t-if="record.certificate_file.raw_value">
                                <a t-if="record.id.raw_value" class="o_hr_certification_kanban_certificate"
                                    t-attf-href="/web/content/hr.employee.skill/#{record.id.raw_value}/certificate_file?download=true"
                                    data-tooltip="Download the certificate" aria-label="Download the certificate">
                                    <t t-call="certificate_image"/>
                                </a>
                                <span t-else="" class="o_hr_certification_kanban_certificate" role="img" aria-label="Certificate" title="Certificate">
                                    <t t-call="certificate_image"/>
                                </span>
                            </t>
                            <span t-else="" class="o_hr_certification_kanban_certificate o_hr_certification_kanban_placeholder text-muted">
                                <i class="oi" data-icon="add" role="img" aria-label="No certificate" title="No certificate"/>
                            </span>
                        </aside>
                    </t>
                    <t t-name="certificate_image">
                        <svg class="o_hr_certification_kanban_image" viewBox="0 0 64 64" aria-hidden="true">
                            <rect class="o_hr_certification_kanban_paper" x="4" y="10" width="56" height="42" rx="3"/>
                            <rect class="o_hr_certification_kanban_frame" x="8" y="14" width="48" height="34" rx="1.5"/>
                            <path class="o_hr_certification_kanban_lines" d="M14 22h36M14 29h22M14 36h16"/>
                            <path class="o_hr_certification_kanban_ribbon" d="M40 44l-3 13 5-3 3 4 2-12zM50 44l3 13-5-3-3 4-2-12z"/>
                            <circle class="o_hr_certification_kanban_medal" cx="45" cy="40" r="8"/>
                            <circle class="o_hr_certification_kanban_medal_center" cx="45" cy="40" r="3.5"/>
                        </svg>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_employee_skill_view_kanban_certification_public" model="ir.ui.view">
        <field name="name">hr.employee.skill.view.kanban.certification.public</field>
        <field name="model">hr.employee.skill</field>
        <field name="inherit_id" ref="hr_employee_skill_view_kanban_certification"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="can_open">0</attribute>
            </kanban>
            <!-- the certificate files are not shared with the other employees -->
            <field name="certificate_file" position="replace"/>
            <aside name="certificate" position="replace"/>
        </field>
    </record>

    <record id="action_hr_employee_new_certification" model="ir.actions.act_window">
        <field name="name">New Certification</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="target">new</field>
        <field name="context">{'show_employee': True, 'certificate_skill': True}</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="employee_skill_view_inherit_certificate_form"/>
    </record>

    <record id="hr_employee_skill_view_help" model="ir.ui.view">
        <field name="name">hr.employee.skill.help</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <help data_method="get_help_data">
                <t invisible="not data.get('has_certification_skill_type')">
                    <p class="o_view_nocontent_smiling_face">No Certified Employees. Register a Certification!</p>
                    <button name="%(hr.action_hr_employee_new_certification)d" type="action" class="btn-primary">New certification</button>
                </t>
                <t invisible="data.get('has_certification_skill_type')">
                    <t groups="hr.group_hr_manager">
                        <p class="o_view_nocontent_smiling_face">No Certifications available. Navigate to Skill types!</p>
                        <button name="%(hr.hr_skill_type_action)d" type="action" class="btn-primary">Show Skill Types</button>
                    </t>
                    <p groups="!hr.group_hr_manager" class="o_view_nocontent_smiling_face">No Certifications available!</p>
                </t>
            </help>
        </field>
    </record>

    <record id="hr_employee_skill_view_list" model="ir.ui.view">
        <field name="name">hr.employees.skill.list</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <list string="Certification"
                js_class="hr_employee_skill_certification_list"
                help_id="%(hr.hr_employee_skill_view_help)d"
                action="action_open_certification"
                type="object"
                create="0"
                expand="1"
                decoration-muted="valid_to and valid_to &lt; context_today().strftime('%Y-%m-%d')"
                decoration-danger="valid_to and valid_to &lt;= (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d') and valid_to &gt; context_today().strftime('%Y-%m-%d')"
                decoration-warning="valid_to and valid_to &lt;= (context_today() + relativedelta(months=3)).strftime('%Y-%m-%d') and valid_to &gt; (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d')">
                <header>
                    <!-- Visibility is decided live in CertificationListController, which hides
                         this button when there is no certification skill type yet. -->
                    <button name="%(hr.action_hr_employee_new_certification)d" string="New" type="action" class="btn-primary o_hr_new_certification" display="always"/>
                </header>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="skill_id" string="Certification"/>
                <field name="skill_level_id" optional="hide"/>
                <field name="skill_type_id" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="valid_from" string="From" widget="formatted_date" options="{'month_format': 'short'}" width="300"/>
                <field name="valid_to" string="To" widget="formatted_date" options="{'month_format': 'short'}" width="300"/>
                <field name="certificate_file" widget="binary" optional="hidden"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_skill_view_search" model="ir.ui.view">
        <field name="name">hr.employee.skill.view.search</field>
        <field name="model">hr.employee.skill</field>
        <field name="arch" type="xml">
            <search>
                <field string="Certification" name="skill_id"/>
                <field name="employee_id"/>
                <filter string="Valid certification" name="valid_certification"
                    domain="[
                        '|',
                            ('valid_to', '=', False),
                            ('valid_to', '&gt;', 'today')
                    ]"/>
                <filter string='Certification' name="group_by_certification"  context="{'group_by': 'skill_id'}"/>
                <filter string='Type' name="group_by_type"  context="{'group_by': 'skill_type_id'}"/>
                <filter string='Employee' name="group_by_employee" context="{'group_by': 'employee_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_skill_certification" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">hr.employee.skill</field>
        <field name="path">certifications</field>
        <field name="domain">[('is_certification', '=', True), ('company_id', 'in', allowed_company_ids), ('is_company_visible', '=', True)]</field>
        <field name="context">{'show_employee': True}</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Certifications available!</p>
        </field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': False}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('employee_skill_view_inherit_certificate_form')})]"/>
    </record>

</odoo>
