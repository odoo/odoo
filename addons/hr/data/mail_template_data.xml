<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_employee_contract" model="mail.template">
            <field name="name">Employee: Employment Contract</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Your Employment Contract</field>
            <field name="email_to" eval="False"/>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="lang">{{ object.lang }}</field>
            <field name="description">Sent to the employee with their generated employment contract</field>
            <field name="email_layout_xmlid">mail.mail_notification_light</field>
            <field name="body_html" type="html">
<div style="font-size: 13px; margin: 0px; padding: 0px;">
    Hello <t t-out="object.name or ''">Abigail Peterson</t>,<br/><br/>
    Please find attached your employment contract with
    <b><t t-out="object.company_id.name or ''">YourCompany</t></b>.
    <br/><br/>
    Do not hesitate to reply to this email if you have any questions.
    <br/><br/>
    Best regards,
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
