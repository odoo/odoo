<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_employee_change_request" model="approval.category">
        <field name="name">Employee Information Change</field>
        <field
            name="description">A person asking to change the private information held about them.</field>
        <field name="sequence_code">HRCHG</field>
        <field name="approval_minimum">1</field>
        <field name="allow_self_approval" eval="False" />
        <field name="privacy_visibility">private</field>
    </record>

    <record
        id="approval_category_step_employee_change_request"
        model="approval.category.step">
        <field name="name">HR Review</field>
        <field name="category_id" ref="approval_category_employee_change_request" />
        <field name="group_id" ref="hr.group_hr_user" />
        <field name="minimum" eval="1" />
        <field name="sequence" eval="10" />
    </record>

</odoo>
