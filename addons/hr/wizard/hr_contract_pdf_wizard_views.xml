<?xml version="1.0"?>
<odoo>
    <record id="hr_contract_pdf_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.contract.pdf.wizard.form</field>
        <field name="model">hr.contract.pdf.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Contract" js_class="hr_contract_pdf_wizard_form">
                <sheet>
                    <div class="row" name="contract_pdf_wizard_main">
                        <div class="col" name="contract_values">
                            <group>
                                <field name="version_id" invisible="1"/> <!-- needed for its context default to reach the onchange -->
                                <field name="currency_id" invisible="1"/> <!-- needed by the wage monetary widget -->
                                <field name="legal_name"/>
                                <field name="wage"/>
                                <field name="working_hours"/>
                                <label for="contract_date_start" string="Contract"/>
                                <div class="o_row" name="contract_dates">
                                    <field name="contract_date_start" class="o_hr_narrow_field me-3"/>
                                    <span>to</span>
                                    <field name="contract_date_end" placeholder="Indefinite" class="o_hr_narrow_field ms-3"
                                           widget="date_dynamic_min" options="{'min_date_field': 'contract_date_start'}"/>
                                </div>
                                <field name="job_id"/>
                                <field name="work_location"/>
                                <field name="contract_lang_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="duplicate_lang_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="benefits" placeholder="e.g. Company car, Meal vouchers"/>
                            </group>
                        </div>
                    </div>

                    <footer>
                        <button
                            name="action_generate_pdf"
                            string="Generate"
                            type="object"
                            class="btn btn-primary"
                        />
                        <button
                            name="action_send_pdf"
                            string="Send"
                            type="object"
                            class="btn btn-secondary"
                        />
                        <button
                            name="action_preview_pdf"
                            string="Preview"
                            type="object"
                            class="btn btn-secondary"
                        />
                        <button
                            string="Discard"
                            special="cancel"
                            class="btn btn-secondary"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
