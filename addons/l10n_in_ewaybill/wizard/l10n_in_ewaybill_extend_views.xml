<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ewaybill_extend_form" model="ir.ui.view">
            <field name="name">l10n.in.ewaybill.extension.form</field>
            <field name="model">l10n.in.ewaybill.extend</field>
            <field name="arch" type="xml">
                <form string="Extend E-Way Bill Validity">
                    <field name="l10n_in_ewaybill_id" invisible="1"/> <!-- Needed to prefill transport details via _compute_transport_details -->
                    <group>
                        <group string="Extension Details">
                            <field name="extension_reason_code"/>
                            <field name="extension_remarks"/>
                            <field name="remaining_distance"/>
                        </group>
                        <group string="Consignment Info">
                            <field name="consignment_status" widget="radio" options="{'horizontal': true}"/>
                            <field name="trans_mode" invisible="consignment_status == 'T'"/>
                            <field name="transit_type" invisible="consignment_status == 'M'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Transportation Details">
                            <field name="vehicle_no"
                                   invisible="not ((consignment_status == 'M' and trans_mode == '1') or (consignment_status == 'T' and transit_type == 'R'))"/>
                            <field name="trans_doc_no" invisible="consignment_status == 'M' and trans_mode == '1'"/>
                            <field name="trans_doc_date" invisible="consignment_status == 'M' and trans_mode == '1'"/>
                        </group>
                        <group string="Current Location">
                            <field name="from_pincode"/>
                            <field name="from_state_id" options="{'no_create': True}"/>
                            <field name="from_place"/>

                            <label for="address_line1" string="Address Lines" invisible="consignment_status != 'T'"/>
                            <div invisible="consignment_status != 'T'">
                                <field name="address_line1"
                                       placeholder="Address Line 1"
                                       required="consignment_status == 'T'"/>
                                <field name="address_line2"
                                       placeholder="Address Line 2"
                                       required="consignment_status == 'T'"/>
                                <field name="address_line3"
                                       placeholder="Address Line 3"
                                       required="consignment_status == 'T'"/>
                            </div>
                        </group>
                    </group>

                    <footer>
                        <button string="Extend E-waybill"
                                name="action_submit_extension"
                                type="object"
                                class="btn-primary"
                                data-hotkey="q"/>
                        <button string="Discard"
                                class="btn-secondary"
                                special="cancel"
                                data-hotkey="x"/>
                    </footer>
               </form>
            </field>
        </record>
    </data>
</odoo>
