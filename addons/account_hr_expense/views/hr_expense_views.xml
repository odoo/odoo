<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_expense_view_expenses_analysis_tree_inherit" model="ir.ui.view">
            <field name="name">hr.expense.view.list.inherit.account.hr.expense</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_has_cost']" position="after">
                    <field name="selectable_payment_method_line_ids" column_invisible="True"/> <!-- Domain of the payment method -->
                    <field name="can_edit_account" column_invisible="True"/> <!-- Readonly condition of the account -->
                </xpath>
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="account_id" optional="hide" groups="account.group_account_invoice"
                           readonly="not (is_editable or can_edit_account)"/>
                    <field name="journal_id" optional="hide" groups="account.group_account_invoice"
                           readonly="True"/>
                    <field name="payment_method_line_id" optional="hide" groups="account.group_account_invoice"
                           readonly="not is_editable"/>
                </xpath>
                <xpath expr="//field[@name='quantity']" position="after">
                    <field name="tax_ids" optional="hide" widget="many2many_tax_tags"
                           groups="account.group_account_invoice" readonly="not is_editable or not product_has_cost"/>
                    <field name="tax_amount" sum="Total Taxes" readonly="True" optional="hide" groups="account.group_account_invoice"/>
                </xpath>
            </field>
        </record>

        <record id="hr_expense_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.expense.view.form.inherit.account.hr.expense</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[hasclass('o_expense_pay_highlight')]" position="attributes">
                    <attribute name="groups">account.group_account_invoice</attribute>
                </xpath>
                <xpath expr="//button[hasclass('o_expense_pay')]" position="attributes">
                    <attribute name="groups">account.group_account_invoice</attribute>
                </xpath>
                <xpath expr="//button[hasclass('o_expense_refuse_manager')]" position="attributes">
                    <attribute name="invisible">state not in ('submitted', 'approved') or account_move_state == 'posted'</attribute>
                </xpath>
                <xpath expr="//button[hasclass('o_expense_reset_manager')]" position="attributes">
                    <attribute name="invisible">not can_reset or state in ('draft', 'in_payment', 'paid') or account_move_state == 'posted'</attribute>
                </xpath>
                <xpath expr="//button[hasclass('o_expense_reset_employee')]" position="after">
                    <button name="action_split_wizard" string="Split" type="object" invisible="state != 'draft' or product_has_cost"
                            groups="!hr_expense.group_hr_expense_team_approver,!account.group_account_invoice" class="o_expense_split_user"/>
                    <button name="action_split_wizard" string="Split" type="object" class="o_expense_split_manager"
                            invisible="state in ('in_payment', 'paid', 'refused') or product_has_cost or account_move_state == 'posted'"
                            groups="hr_expense.group_hr_expense_team_approver,account.group_account_invoice"/>
                </xpath>
                <xpath expr="//field[hasclass('o_expense_status_default')]" position="attributes">
                    <attribute name="invisible">state in ('submitted', 'in_payment', 'refused')</attribute>
                </xpath>
                <xpath expr="//field[hasclass('o_expense_status_refused')]" position="before">
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,in_payment,paid"
                           invisible="state != 'in_payment'" class="o_expense_status_in_payment"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_split_expense"
                        type="object"
                        class="oe_stat_button"
                        icon="article"
                        invisible="not split_expense_origin_id">
                        <field string="Related" name="split_expense_count" widget="statinfo"/>
                    </button>
                    <button name="action_open_account_move"
                        class="oe_stat_button"
                        icon="menu"
                        type="object"
                        invisible="not account_move_id or payment_mode != 'own_account'"
                        groups="account.group_account_invoice">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Journal Entry</span>
                        </div>
                    </button>
                    <button name="action_open_account_payment"
                        class="oe_stat_button"
                        icon="menu"
                        type="object"
                        invisible="not account_move_id or (payment_mode != 'company_account' and not has_existing_bill)"
                        groups="account.group_account_invoice">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Payment</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='product_has_cost']" position="after">
                    <field name="selectable_payment_method_line_ids" invisible="1"/> <!-- Domain of the payment method -->
                    <field name="can_edit_account" invisible="1"/> <!-- Readonly condition of the account -->
                </xpath>
                <xpath expr="//field[hasclass('o_expense_employee_field')]" position="before">
                    <label for="tax_ids"/>
                    <div class="o_row">
                        <field name="tax_ids" force_save="1" widget="many2many_tax_tags" readonly="not is_editable"
                               options="{'no_create': True}"/>
                        <field name="tax_amount_currency"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='vendor_id']" position="after">
                    <label for="has_existing_bill"/>
                    <div class="d-flex flex-column flex-lg-row">
                        <field name="has_existing_bill"
                               string="Existing Bill"
                               widget="boolean_radio"
                               options="{'no_label_element_id': 'direct_expense', 'yes_label_element_id': 'match_bill', 'first_element': false}"
                               readonly="not is_editable"
                               style="width: 60%"
                               groups="account.group_account_invoice"/>
                        <template id="direct_expense">No (Direct Expense)</template>
                        <template id="match_bill">Yes (Match to Bill)</template>
                    </div>
                </xpath>
                <xpath expr="//field[@name='analytic_distribution']" position="before">
                    <field name="account_id" options="{'no_create': True}"
                           domain = "
                                has_existing_bill and [
                                    ('account_type', '=', 'liability_payable'),
                                    ('company_ids', 'parent_of', company_id)
                                ]
                                or [
                                    ('account_type', 'not in', ('asset_receivable', 'liability_payable', 'asset_cash', 'liability_credit_card')),
                                    ('company_ids', 'parent_of', company_id)
                                ]
                           "
                           groups="account.group_account_invoice"
                           readonly="not (is_editable or can_edit_account)"
                           context="{'default_company_id': company_id}"/>
                    <field name="payment_method_line_id" options="{'no_open': True, 'no_create': True}" readonly="not is_editable"
                           required="payment_mode == 'company_account'"/>
                </xpath>
            </field>
        </record>

        <record id="hr_expense_view_expenses_analysis_kanban_inherit" model="ir.ui.view">
            <field name="name">hr.expense.kanban.inherit.account.hr.expense</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="decoration-success">state in ['approved', 'in_payment', 'paid']</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_expense_view_graph_inherit" model="ir.ui.view">
            <field name="name">hr.expense.graph.inherit.account.hr.expense</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_graph"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='total_amount']" position="after">
                    <field name="tax_amount"/>
                </xpath>
            </field>
        </record>

        <record id="hr_expense_view_search_inherit" model="ir.ui.view">
            <field name="name">hr.expense.view.search.inherit.account.hr.expense</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
            <field name="arch" type="xml">
                <!-- Invisible filters -->
                <xpath expr="//filter[@name='all_paid']" position="attributes">
                    <attribute name="domain">[('state', 'in', ['in_payment', 'paid']), ('payment_mode', '=', 'own_account')]</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_expense.hr_expense_actions_all" model="ir.actions.act_window">
            <field name="context">{ 'searchpanel_default_state': ["draft", "submitted", "approved", "in_payment", "paid"] }</field>
        </record>
    </data>
</odoo>
