<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="address_form_fields"
        inherit_id="portal.address_form_fields"
        name="Show l10n_it fields"
        customize_show="True"
    >
        <div id="div_vat" position="after">
            <t t-if="res_company.account_fiscal_country_id.code == 'IT'">
                <div class="w-100"/>
                <div class="col-lg-6 mb-3" id="div_l10n_it_codice_fiscale">
                    <div class="form-floating">
                        <input type="text"
                            name="l10n_it_codice_fiscale"
                            class="form-control text-uppercase"
                            t-att-value="partner_sudo.l10n_it_codice_fiscale" placeholder=" "/>
                        <label
                            class="col-form-label fw-normal label-optional"
                            for="l10n_it_codice_fiscale"
                        >
                            Codice Fiscale
                        </label>
                    </div>
                </div>
                <div class="col-lg-6 mb-3" id="div_l10n_it_pa_index">
                    <div class="form-floating">
                        <input type="text"
                            name="l10n_it_pa_index"
                            class="form-control text-uppercase"
                            t-att-value="partner_sudo.l10n_it_pa_index" placeholder=" "/>
                        <label
                            class="col-form-label fw-normal label-optional"
                            for="l10n_it_pa_index"
                        >
                            Destination Code (SDI)
                        </label>
                    </div>
                </div>
            </t>
        </div>
    </template>

</odoo>
