#. module: lunch
#: model:mail.template,body_html:lunch.lunch_order_mail_supplier
msgid ""
"<t>\n"
"<t t-set=\"lines\" t-value=\"ctx.get('lines', [])\"/>\n"
"<t t-set=\"order\" t-value=\"ctx.get('order', {})\"/>\n"
"<t t-set=\"currency\" t-"
"value=\"user.env['res.currency'].browse(order.get('currency_id'))\"/>\n"
"<p>\n"
"Dear <t t-out=\"order.get('supplier_name', '')\">Laurie Poiret</t>,\n"
"</p><p>\n"
"Here is, today orders for <t t-out=\"order.get('company_name', '')"
"\">LunchCompany</t>:\n"
"</p>\n"
"\n"
"<t t-if=\"sites\">\n"
"    <br/>\n"
"    <p>Location</p>\n"
"    <p t-foreach=\"site\" t-as=\"site\">\n"
"        <t t-out=\"site['name'] or ''\"/> : <t t-out=\"site['address'] or "
"''\"/>\n"
"    </p>\n"
"    <br/>\n"
"</t>\n"
"\n"
"<table>\n"
"    <thead>\n"
"        <tr style=\"background-color:rgb(233,232,233);\">\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;"
"\"><strong>Product</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;"
"\"><strong>Comments</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;"
"\"><strong>Person</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;"
"\"><strong>Site</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\" "
"align=\"center\"><strong>Qty</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\" "
"align=\"center\"><strong>Price</strong></th>\n"
"        </tr>\n"
"    </thead>\n"
"    <tbody>\n"
"        <tr t-foreach=\"lines\" t-as=\"line\">\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" t-"
"out=\"line['product'] or ''\">Sushi salmon</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\">\n"
"            <t t-if=\"line['toppings']\">\n"
"                <t t-out=\"line['toppings'] or ''\">Soy sauce</t>\n"
"            </t>\n"
"            <t t-if=\"line['note']\">\n"
"                <div style=\"color: rgb(173,181,189);\" t-out=\"line['note'] "
"or ''\">With wasabi.</div>\n"
"            </t>\n"
"            </td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" t-"
"out=\"line['username'] or ''\">lap</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" t-"
"out=\"line['site'] or ''\">Office 1</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" "
"align=\"right\" t-out=\"line['quantity'] or ''\">10</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" "
"align=\"right\" t-out=\"format_amount(line['price'], currency) or ''\">$ "
"1.00</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td/>\n"
"            <td/>\n"
"            <td/>\n"
"            <td/>\n"
"            <td style=\"width: 100%; font-size: 13px; border-top: 1px solid "
"black;\"><strong>Total</strong></td>\n"
"            <td style=\"width: 100%; font-size: 13px; border-top: 1px solid "
"black;\" align=\"right\"><strong t-out=\"order.get('amount_total') and "
"format_amount(order['amount_total'], currency) or ''\">$ 10.00</strong></"
"td>\n"
"        </tr>\n"
"    </tbody>\n"
"</table>\n"
"\n"
"<p>Do not hesitate to contact us if you have any questions.</p>\n"
"        </t>"
msgstr ""
"<t>\n"
"<t t-set=\"lines\" t-value=\"ctx.get('lines', [])\"/>\n"
"<t t-set=\"order\" t-value=\"ctx.get('order', {})\"/>\n"
"<t t-set=\"currency\" t-value=\"user.env['res.currency'].browse(order.get"
"('currency_id'))\"/>\n"
"<p>\n"
"ຮຽນ <t t-out=\"order.get('supplier_name', '')\">Laurie Poiret</t>,\n"
"</p><p>\n"
"ນີ້ແມ່ນລາຍການສັ່ງຊື້ປະຈຳວັນນີ້ສຳລັບ <t t-out=\"order.get('company_name', '')\">"
"LunchCompany</t>:\n"
"</p>\n"
"\n"
"<t t-if=\"sites\">\n"
"    <br/>\n"
"    <p>ສະຖານທີ່</p>\n"
"    <p t-foreach=\"site\" t-as=\"site\">\n"
"        <t t-out=\"site['name'] or ''\"/> : <t t-out=\"site['address'] or "
"''\"/>\n"
"    </p>\n"
"    <br/>\n"
"</t>\n"
"\n"
"<table>\n"
"    <thead>\n"
"        <tr style=\"background-color:rgb(233,232,233);\">\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\">"
"<strong>ລາຍການອາຫານ</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\">"
"<strong>ຄຳເຫັນ</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\">"
"<strong>ຊື່ຜູ້ສັ່ງ</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\">"
"<strong>ສະຖານທີ່</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\" "
"align=\"center\"><strong>ຈຳນວນ</strong></th>\n"
"            <th style=\"width: 100%; min-width: 96px; font-size: 13px;\" "
"align=\"center\"><strong>ລາຄາ</strong></th>\n"
"        </tr>\n"
"    </thead>\n"
"    <tbody>\n"
"        <tr t-foreach=\"lines\" t-as=\"line\">\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" t-"
"out=\"line['product'] or ''\">Sushi salmon</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\">\n"
"            <t t-if=\"line['toppings']\">\n"
"                <t t-out=\"line['toppings'] or ''\">Soy sauce</t>\n"
"            </t>\n"
"            <t t-if=\"line['note']\">\n"
"                <div style=\"color: rgb(173,181,189);\" t-out=\"line['note'] "
"or ''\">With wasabi.</div>\n"
"            </t>\n"
"            </td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" t-"
"out=\"line['username'] or ''\">lap</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" t-"
"out=\"line['site'] or ''\">Office 1</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" "
"align=\"right\" t-out=\"line['quantity'] or ''\">10</td>\n"
"            <td style=\"width: 100%; font-size: 13px;\" valign=\"top\" "
"align=\"right\" t-out=\"format_amount(line['price'], currency) or ''\">$ "
"1.00</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td/>\n"
"            <td/>\n"
"            <td/>\n"
"            <td/>\n"
"            <td style=\"width: 100%; font-size: 13px; border-top: 1px solid "
"black;\"><strong>ລວມທັງໝົດ</strong></td>\n"
"            <td style=\"width: 100%; font-size: 13px; border-top: 1px solid "
"black;\" align=\"right\"><strong t-out=\"order.get('amount_total') and "
"format_amount(order['amount_total'], currency) or ''\">$ 10.00</strong></td>"
"\n"
"        </tr>\n"
"    </tbody>\n"
"</table>\n"
"\n"
"<p>ຫາກທ່ານມີຂໍ້ສົງໄສໃດໆ ສາມາດຕິດຕໍ່ພວກເຮົາໄດ້ທຸກເວລາ.</p>\n"
"        </t>"

#. module: lunch
#: model_terms:ir.actions.act_window,help:lunch.lunch_cashmove_report_action_control_accounts
msgid ""
"A cashmove can either be an expense or a payment.<br>\n"
"            An expense is automatically created at the order receipt.<br>\n"
"            A payment represents the employee reimbursement to the company."
msgstr ""
"ການເຄື່ອນໄຫວເງິນສາມາດເປັນລາຍຈ່າຍ ຫຼື ການຊຳລະເງິນກໍໄດ້.<br>\n"
"            ລາຍຈ່າຍຈະຖືກສ້າງຂຶ້ນອັດຕະໂນມັດເມື່ອໄດ້ຮັບໃບບິນສັ່ງຊື້.<br>\n"
"            ການຊຳລະເງິນໝາຍເຖິງການທີ່ພະນັກງານຈ່າຍເງິນຄືນໃຫ້ແກ່ບໍລິສັດ."

