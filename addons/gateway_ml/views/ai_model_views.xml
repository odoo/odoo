<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_model_list" model="ir.ui.view">
        <field name="name">gateway.ml.model.list</field>
        <field name="model">gateway.ml.model</field>
        <field name="arch" type="xml">
            <list string="AI Models">
                <field name="sequence" widget="handle" />
                <field name="provider_id" />
                <field name="name" />
                <field name="code" />
                <field name="kind" />
                <field name="has_vision" widget="boolean_toggle" />
                <field name="cost_per_1m_input" string="Input Cost" />
                <field name="cost_per_1m_output" string="Output Cost" />
                <field name="accuracy_rating" widget="priority" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_ai_model_form" model="ir.ui.view">
        <field name="name">gateway.ml.model.form</field>
        <field name="model">gateway.ml.model</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Inactive"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <group>
                        <group name="identity">
                            <field name="provider_id" />
                            <field name="name" />
                            <field name="code" />
                            <field name="kind" />
                            <field name="sequence" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group name="limits" string="Limits">
                            <field name="max_context_window" />
                            <field name="max_output_tokens" />
                        </group>
                    </group>
                    <notebook>
                        <page name="request_shape" string="Request Shape">
                            <group>
                                <group string="Chat">
                                    <field name="max_tokens_param" />
                                    <field name="min_max_tokens" />
                                    <field name="sampling_params" />
                                    <field name="forced_tool_choice" />
                                </group>
                                <group string="Audio">
                                    <field name="language_form_key" />
                                    <field name="vocabulary_param" />
                                </group>
                            </group>
                        </page>
                        <page name="capabilities" string="Capabilities">
                            <group>
                                <group string="Features">
                                    <field name="has_vision" />
                                    <field name="has_timestamps" />
                                    <field name="supports_streaming" />
                                    <field name="supports_function_calling" />
                                </group>
                                <group string="Ratings (1-5)">
                                    <field name="accuracy_rating" widget="priority" />
                                    <field name="speed_rating" widget="priority" />
                                </group>
                            </group>
                        </page>
                        <page name="pricing" string="Pricing">
                            <group>
                                <group string="Cost per 1M Tokens/Units">
                                    <field name="cost_per_1m_input" />
                                    <field name="cost_per_1m_output" />
                                    <field name="cost_per_1m_image" />
                                    <field name="cost_per_audio_minute" />
                                </group>
                            </group>
                        </page>
                        <page name="fallback" string="Fallback">
                            <field name="fallback_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="fallback_id"
                                        domain="[('id', '!=', parent.id)]"
                                        options="{'no_create': True}" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_model_search" model="ir.ui.view">
        <field name="name">gateway.ml.model.search</field>
        <field name="model">gateway.ml.model</field>
        <field name="arch" type="xml">
            <search string="AI Models">
                <field name="name" />
                <field name="code" />
                <field name="provider_id" />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="filter_inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]" />
                <separator />
                <filter
                    name="filter_vision"
                    string="Vision"
                    domain="[('has_vision', '=', True)]" />
                <filter
                    name="filter_function_calling"
                    string="Function Calling"
                    domain="[('supports_function_calling', '=', True)]" />
                <group>
                    <filter
                        name="group_by_provider"
                        string="Provider"
                        context="{'group_by': 'provider_id'}" />
                    <filter
                        name="group_by_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_model" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">gateway.ml.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Model
            </p>
            <p>
                A model carries what its name decides: cost per token, context
                window, vision and the ratings a request is selected on. The
                provider carries what the API key decides.
            </p>
        </field>
    </record>

</odoo>
