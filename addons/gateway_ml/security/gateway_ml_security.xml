<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="access_integration_service_ml_provider_read" model="ir.access">
        <field
            name="name">Outbound Service: AI users read the services of AI providers</field>
        <field name="model_id" ref="integration.model_integration_service" />
        <field name="group_id" ref="group_ai_user" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
        <field name="domain">[('ml_provider_ids', '!=', False)]</field>
    </record>

    <record id="access_integration_service_ml_provider_edit" model="ir.access">
        <field
            name="name">Outbound Service: AI administrators edit the services of AI providers</field>
        <field name="model_id" ref="integration.model_integration_service" />
        <field name="group_id" ref="group_ai_admin" />
        <field name="kind">permission</field>
        <field name="operation">cud</field>
        <field name="domain">[('ml_provider_ids', '!=', False)]</field>
    </record>

    <record id="gateway_ml_config_rule_company" model="ir.rule">
        <field name="name">gateway_ml.config: the reader's companies</field>
        <field name="model_id" ref="model_gateway_ml_config" />
        <field name="global" eval="False" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[Command.set([ref('base.group_user'), ref('base.group_portal'), ref('base.group_public')])]" />
    </record>

    <record id="gateway_ml_config_rule_erp_manager" model="ir.rule">
        <field
            name="name">gateway_ml.config: every company for an access-rights manager</field>
        <field name="model_id" ref="model_gateway_ml_config" />
        <field name="global" eval="False" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('base.group_erp_manager')])]" />
    </record>

    <record id="gateway_ml_policy_rule_company" model="ir.rule">
        <field name="name">gateway.ml.policy: the reader's companies</field>
        <field name="model_id" ref="model_gateway_ml_policy" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
