        <field name="operation">transcribe</field>
        <field name="service_id" ref="service_google" />
        <field name="wire">gemini_native</field>
        <field name="path">/models/{model}:generateContent</field>
        <field name="model_id" ref="ai_model_gemini_flash_lite_latest" />
        <field name="timeout" eval="90" />
    </record>

