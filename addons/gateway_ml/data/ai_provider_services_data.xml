<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="provider_service_google_chat" model="gateway.ml.provider.service">
        <field name="provider_id" ref="ai_provider_google" />
        <field name="operation">chat</field>
        <field name="service_id" ref="service_google_openai" />
        <field name="wire">openai_compatible</field>
        <field name="path">/chat/completions</field>
        <field name="model_id" ref="ai_model_gemini_3_5_flash_lite" />
        <field name="timeout" eval="25" />
    </record>

