#. module: base_iban
#. odoo-python
#: code:addons/base_iban/models/res_partner_bank.py:0
msgid ""
"The IBAN does not seem to be correct. You should have entered something like "
"this %s\n"
"Where B = National bank code, S = Branch code, C = Account No, k = Check "
"digit"
msgstr ""
"IBAN-ul nu pare corect. Trebuia să introduceți o valoare de forma %s\n"
"Unde B = codul băncii naționale, S = codul sucursalei, C = numărul contului, "
"k = cifra de control"

#. module: base_iban
#. odoo-python
#: code:addons/base_iban/models/res_partner_bank.py:0
msgid "The IBAN is invalid, it should begin with the country code"
msgstr "Codul IBAN este nevalid, ar trebui să înceapă cu codul țării"

#. module: base_iban
#. odoo-python
#: code:addons/base_iban/models/res_partner_bank.py:0
msgid "There is no IBAN code."
msgstr "Nu există cod IBAN."

#. module: base_iban
#. odoo-python
#: code:addons/base_iban/models/res_partner_bank.py:0
msgid "This IBAN does not pass the validation check, please verify it."
msgstr "Acest IBAN nu trece verificarea de validare. Vă rugăm să îl verificați."
