<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_inherit_l10n_ge_withholding" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.l10n_ge_withholding</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_account_withholding_tax.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="is_withholding_tax" position="after">
                <field name="l10n_ge_wht_category_ids" widget="many2many_tags"
                       invisible="country_code != 'GE'"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
