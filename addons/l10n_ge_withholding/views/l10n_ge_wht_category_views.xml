<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ge_wht_category_view_list" model="ir.ui.view">
        <field name="name">l10n_ge.wht.category.list</field>
        <field name="model">l10n_ge.wht.category</field>
        <field name="arch" type="xml">
            <list string="Withholding Tax Categories" editable="bottom">
                <field name="l10n_ge_code"/>
                <field name="l10n_ge_name"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_ge_wht_category" model="ir.actions.act_window">
        <field name="name">Withholding Tax Categories</field>
        <field name="res_model">l10n_ge.wht.category</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="l10n_ge_wht_category_view_list"/>
    </record>

    <menuitem
        id="menu_l10n_ge_wht_category"
        action="action_l10n_ge_wht_category"
        parent="account.account_account_menu"
        sequence="10"/>
</odoo>
