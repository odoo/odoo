<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_replenishment_info_sale_stock_inherit" model="ir.ui.view">
        <field name="name">stock.replenishment.information.sale.stock.inherit</field>
        <field name="model">stock.replenishment.info</field>
        <field name="inherit_id" ref="stock.view_stock_replenishment_info"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='json_lead_days']" position="attributes">
                <attribute name="class">border-bottom</attribute>
            </xpath>
            <xpath expr="//field[@name='json_lead_days']" position="after">
                <label for="sale_delay"/>
                <div style="text-align: end;"><field string="Sales Availability Time" name="sale_delay" class="oe_inline text-end"/> days</div>
            </xpath>
        </field>
    </record>
</odoo>
