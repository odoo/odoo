<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale_stock" model="ir.ui.view">
        <field name="name">sale.order.form.sale.stock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <separator name="operations" position="before">
                <button
                    name="action_delivery_matching"
                    type="object"
                    string="Match Deliveries"
                    groups="stock.group_stock_user"
                    invisible="state != 'done' or transfer_state in ('no', 'done')" />
            </separator>
            <button name="action_view_invoice" position="before">
                <button
                    name="action_view_picking"
                    type="object"
                    icon="fa-truck"
                    groups="stock.group_stock_user"
                    invisible="count_transfer_outgoing == 0"
                    class="oe_stat_button">
                    <field
                        name="count_transfer_outgoing"
                        string="Delivery"
                        widget="statinfo" />
                </button>
            </button>
            <group name="sale_shipping" position="attributes">
                <attribute name="groups" />
                <attribute name="string">Delivery</attribute>
            </group>
            <label for="date_commitment" position="before">
                <field
                    name="warehouse_id"
                    force_save="1"
                    options="{'no_create': True}"
                    readonly="state == 'done'" />
                <field
                    name="incoterm_id"
                    options="{'no_open': True, 'no_create': True}" />
                <field name="incoterm_location" />
                <field
                    name="picking_policy"
                    readonly="state != 'draft'"
                    required="True" />
            </label>
            <span name="expected_date_span" position="attributes">
                <attribute name="invisible">date_effective and date_commitment</attribute>
            </span>
            <div name="date_commitment_div" position="replace">
                <div class="o_row">
                    <field name="date_commitment" />
                    <span
                        class="text-muted"
                        invisible="not date_planned or (date_effective and date_commitment)">
                        Expected: <field name="date_planned" class="oe_inline" /></span>
                </div>
                <field name="date_effective" invisible="not date_effective" />
                <field name="transfer_state" invisible="state != 'done'" />
            </div>
            <xpath
                expr="//page[@name='other_information']//field[@name='date_planned']"
                position="after">
                <field
                    name="json_popover"
                    string=" "
                    widget="stock_rescheduling_popover"
                    invisible="not show_json_popover" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//form//field[@name='analytic_distribution']"
                position="before">
                <field
                    name="route_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    groups="stock.group_adv_location" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//form//field[@name='product_uom_id']"
                position="after">
                <widget name="qty_at_date_widget" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='analytic_distribution']"
                position="after">
                <field
                    name="route_ids"
                    widget="many2many_tags"
                    optional="hide"
                    options="{'no_create': True}"
                    groups="stock.group_adv_location" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='qty_transferred']"
                position="after">
                <widget name="qty_at_date_widget" width="20px" />
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.sale.stock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_list" />
        <field name="arch" type="xml">
            <field name="has_upsell_opportunity" position="after">
                <field
                    name="warehouse_id"
                    optional="hide"
                    options="{'no_create': True}"
                    groups="stock.group_stock_multi_warehouses"
                    readonly="state == 'done'" />
            </field>
        </field>
    </record>

    <record id="view_sale_order_list_2" model="ir.ui.view">
        <field name="name">sale.order.list.2.inherit.sale.stock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_list_2" />
        <field name="arch" type="xml">
            <field name="date_commitment" position="attributes">
                <attribute name="decoration-danger">
                    (
                    transfer_state in ['to do', 'partial']
                    and date_commitment &lt; datetime.datetime.combine(
                    datetime.date.today(),
                    datetime.time(0,0,0)
                    ).to_utc().strftime('%Y-%m-%d %H:%M:%S')
                    )
                </attribute>
            </field>
            <field name="invoice_state" position="before">
                <field
                    name="transfer_state"
                    widget="badge"
                    optional="hide"
                    decoration-info="transfer_state in ['to do', 'partial']"
                    decoration-success="transfer_state == 'done'"
                    decoration-warning="transfer_state == 'partial'" />
            </field>
        </field>
    </record>

    <record id="sale_stock_sale_order_view_search_inherit" model="ir.ui.view">
        <field name="name">sale_stock.sale.order.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_search_2" />
        <field name="arch" type="xml">
            <filter name="order_date" position="after">
                <filter
                    name="late_availability"
                    string="Late Availability"
                    domain="[('late_availability', '=', True)]" />
            </filter>
        </field>
    </record>

</odoo>
