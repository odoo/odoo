<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_request_historic" model="ir.cron">
        <field name="name">Polish eInvoice: request past bills</field>
        <field name="model_id" ref="model_l10n_pl_edi_batch_download"/>
        <field name="state">code</field>
        <field name="code">model._cron_request_historic()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_check_status" model="ir.cron">
        <field name="name">Polish eInvoice: status check</field>
        <field name="model_id" ref="model_l10n_pl_edi_batch_download"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_status()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_download" model="ir.cron">
        <field name="name">Polish eInvoice: download parts</field>
        <field name="model_id" ref="model_l10n_pl_edi_batch_download"/>
        <field name="state">code</field>
        <field name="code">model._cron_download()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_import" model="ir.cron">
        <field name="name">Polish eInvoice: merge parts, import bills</field>
        <field name="model_id" ref="model_l10n_pl_edi_batch_download"/>
        <field name="state">code</field>
        <field name="code">model._cron_import()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="l10n_pl_edi.cron_l10n_pl_edi_ksef_download_bills" model="ir.cron">
        <field name="name">Polish eInvoice: request recent bills</field>
    </record>
</odoo>
