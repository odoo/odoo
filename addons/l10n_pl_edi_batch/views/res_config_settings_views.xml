<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_pl_edi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.pl.edi.batch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_pl_edi.res_config_settings_view_form_l10n_pl_edi"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='l10n_pl_edi_register']" position="after">
                <setting
                    id="l10n_pl_edi_batch_historic_date"
                    string="KSeF batch download"
                    help="Download the vendor bills from KSeF in batches, a whole timeframe at once, instead of one by one."
                    company_dependent="1"
                    invisible="not l10n_pl_edi_register">
                    <div class="mt-2">
                        Bills downloaded back to
                        <field name="l10n_pl_edi_batch_historic_date" class="oe_inline"/>
                        <div class="text-muted">Older bills are still to be downloaded.</div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
