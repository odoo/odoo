<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form-l10n_ar" model="ir.ui.view">
        <field name="name">account.tax.form.l10n_ar.inherit</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_account_withholding_tax.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="amount_type" position="attributes">
                <attribute name="invisible" separator="or" add="l10n_ar_withholding_tax_type == 'earnings_scale'"/>
            </field>
            <label for="amount" position="attributes">
                <attribute name="invisible" separator="or" add="l10n_ar_withholding_tax_type == 'earnings_scale'"/>
            </label>
            <xpath expr="//field[@name='amount']/.." position="attributes">
                <attribute name="invisible" separator="or" add="l10n_ar_withholding_tax_type == 'earnings_scale'"/>
            </xpath>
            <xpath expr="//page[@name='advanced_options']//field[@name='withholding_sequence_id']" position="attributes">
                <!-- Hide it from advanced options and show it in withholding options-->
                <attribute name="invisible" separator="or" add="country_code == 'AR'"/>
            </xpath>
            <page name="advanced_options" position="before">
                <page name="l10n_ar_withholding_options" string="Withholding Options" invisible="country_code != 'AR' or not is_withholding_tax">
                    <group>
                        <group name="l10n_ar_withholding_options_group_1">
                            <field name="l10n_ar_withholding_tax_type" string="Withholding Type"/>
                            <field name="l10n_ar_state_id" invisible="l10n_ar_withholding_tax_type not in ['iibb_untaxed', 'iibb_total']" required="l10n_ar_withholding_tax_type in ['iibb_untaxed', 'iibb_total']" options="{'no_create': True}"/>
                            <field name="l10n_ar_scale_id" invisible="l10n_ar_withholding_tax_type != 'earnings_scale'" required="l10n_ar_withholding_tax_type == 'earnings_scale'" options="{'no_create': True}"/>
                            <field name="withholding_sequence_id" context="{'default_name': name}" invisible="type_tax_use != 'purchase'"/>
                        </group>
                        <group>
                            <field name="l10n_ar_code" invisible="l10n_ar_withholding_tax_type not in ['earnings', 'earnings_scale'] or type_tax_use != 'purchase'" required="l10n_ar_withholding_tax_type in ['earnings', 'earnings_scale'] and type_tax_use == 'purchase'"/>
                            <field name="l10n_ar_non_taxable_amount" invisible="type_tax_use != 'purchase'"/>
                            <field name="l10n_ar_minimum_threshold" invisible="type_tax_use != 'purchase'"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="account_tax_view_search_inherit_l10n_ar_withholding" model="ir.ui.view">
        <field name="name">account.tax.search.inherit.l10n_ar_withholding</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_account_tax_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='tax_scope']" position="after">
                <filter string="Withhold Type" name="l10n_ar_withholding_tax_type" domain="[]" context="{'group_by': 'l10n_ar_withholding_tax_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
