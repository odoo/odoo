<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_view_form_inherit_project_purchase" model="ir.ui.view">
        <field name="name">project.view.form.inherit.project.purchase</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_project_purchase_orders" icon="credit_card"
                    groups="purchase.group_purchase_user" invisible="purchase_orders_count == 0">
                    <field string="Purchase Orders" name="purchase_orders_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="hub_item_purchase_orders" model="ir.hub.item">
        <field name="hub_id" ref="project.hub_project"/>
        <field name="sequence">70</field>
        <field name="name">Purchase Orders</field>
        <field name="python_method">action_open_project_purchase_orders</field>
        <field name="res_model">purchase.order</field>
        <field name="context">{'form_when_one': False}</field>
    </record>
</odoo>
