#: model_terms:ir.ui.view,arch_db:http_routing.400
#: model_terms:ir.ui.view,arch_db:http_routing.403
#: model_terms:ir.ui.view,arch_db:http_routing.415
#: model_terms:ir.ui.view,arch_db:http_routing.422
#: model_terms:ir.ui.view,arch_db:http_routing.4xx
msgid "Drag blocks here to add them above the error message"
msgstr "ລາກບລັອກມາວາງໄວ້ນີ້ ເພື່ອເພີ່ມໃສ່ທາງເທິງຂອງຂໍ້ຄວາມຜິດພາດ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.400
#: model_terms:ir.ui.view,arch_db:http_routing.403
#: model_terms:ir.ui.view,arch_db:http_routing.415
#: model_terms:ir.ui.view,arch_db:http_routing.422
#: model_terms:ir.ui.view,arch_db:http_routing.4xx
msgid "Drag blocks here to add them below the error message"
msgstr "ລາກບລັອກມາວາງໄວ້ນີ້ ເພື່ອເພີ່ມໃສ່ທາງລຸ່ມຂອງຂໍ້ຄວາມຜິດພາດ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "Error"
msgstr "ຂໍ້ຜິດພາດ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid "Error 404"
msgstr "ຂໍ້ຜິດພາດ 404"

#. module: http_routing
#: model:ir.model,name:http_routing.model_ir_http
msgid "HTTP Routing"
msgstr "ການກຳນົດເສັ້ນທາງ HTTP"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
#: model_terms:ir.ui.view,arch_db:http_routing.500
msgid "Home"
msgstr "ໜ້າຫຼັກ"

#. module: http_routing
#: model:ir.model.fields,field_description:http_routing.field_ir_http__id
#: model:ir.model.fields,field_description:http_routing.field_ir_qweb__id
#: model:ir.model.fields,field_description:http_routing.field_res_lang__id
msgid "ID"
msgstr "ID"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_415_layout_1
msgid ""
"It looks like the URL you are accessing doesn't support the format of the "
"request."
msgstr "ເບິ່ງຄືວ່າ URL ທີ່ທ່ານກຳລັງເຂົ້າເຖິງ ບໍ່ຮອງຮັບຮູບແບບຂອງຄຳຮ້ອງຂໍ."

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_422_layout_1
msgid ""
"It looks like the request you made could not be processed due to semantic "
"errors."
msgstr ""
"ເບິ່ງຄືວ່າ ຄຳຮ້ອງຂໍຂອງທ່ານບໍ່ສາມາດປະມວນຜົນໄດ້ ຍ້ອນມີຂໍ້ຜິດພາດທາງດ້ານຄວາມໝາຍ."

#. module: http_routing
#: model:ir.model,name:http_routing.model_res_lang
msgid "Language"
msgstr "ພາສາ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid "Maybe you were looking for one of these <b>popular pages?</b>"
msgstr "ບາງທີທ່ານອາດກຳລັງຊອກຫາໜຶ່ງໃນ <b>ໜ້າຍອດນິຍົມເຫຼົ່ານີ້?</b>"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_4xx_layout_1
msgid "Oops! Something went wrong."
msgstr "ໂອ້ຍ! ມີບາງຢ່າງຜິດພາດ."

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "QWeb"
msgstr "QWeb"

#. module: http_routing
#: model:ir.model,name:http_routing.model_ir_qweb
msgid "Qweb"
msgstr "Qweb"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "The error occurred while rendering the template"
msgstr "ເກີດມີຂໍ້ຜິດພາດຂຶ້ນໃນຂະນະທີ່ກຳລັງສະແດງຜົນແມ່ແບບ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_403_layout_1
msgid "The page you were looking for could not be authorized."
msgstr "ໜ້າທີ່ທ່ານກຳລັງຊອກຫາ ບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ເຂົ້າເຖິງ."

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_400_layout_1
msgid "The server couldn't understand the request."
msgstr "ເຊີບເວີບໍ່ສາມາດເຂົ້າໃຈຄຳຮ້ອງຂໍນີ້ໄດ້."

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "Traceback"
msgstr "ຮ່ອງຮອຍຂໍ້ຜິດພາດ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid "We couldn't find the page you're looking for!"
msgstr "ພວກເຮົາບໍ່ພົບໜ້າທີ່ທ່ານກຳລັງຊອກຫາ!"

#. module: http_routing
#: model:ir.module.module,shortdesc:base.module_http_routing
#: model:ir.module.module,summary:base.module_http_routing
msgid "Web Routing"
msgstr "ການກຳນົດເສັ້ນທາງເວັບ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.http_error_debug
msgid "and evaluating the following expression:"
msgstr "ແລະ ກຳລັງປະເມີນນິພົດຕໍ່ໄປນີ້:"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid "this page"
msgstr "ໜ້ານີ້"
