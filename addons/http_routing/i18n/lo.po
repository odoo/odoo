#. module: http_routing
#: model:ir.module.module,description:base.module_http_routing
msgid ""
"\n"
"Proposes advanced routing options not available in web or base to keep\n"
"base modules simple.\n"
msgstr ""
"\n"
"ສະເໜີຕົວເລືອກການກຳນົດເສັ້ນທາງຂັ້ນສູງທີ່ບໍ່ມີຢູ່ໃນ web ຫຼື base ເພື່ອຮັກສາໃຫ້\n"
"ໂມດູນພື້ນຖານລຽບງ່າຍ.\n"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_400_layout_1
msgid "400: Bad Request"
msgstr "400: ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_403_layout_1
msgid "403: Forbidden"
msgstr "403: ຖືກຫ້າມເຂົ້າເຖິງ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_415_layout_1
msgid "415: Unsupported Media Type"
msgstr "415: ປະເພດສື່ບໍ່ຮອງຮັບ"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.custom_oe_structure_422_layout_1
msgid "422: Unprocessable Entity"
msgstr "422: ຂໍ້ມູນບໍ່ສາມາດປະມວນຜົນໄດ້"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.404
msgid ""
"<b>Don't panic.</b> If you think it's our mistake, please send us a message "
"on"
msgstr ""
"<b>ບໍ່ຕ້ອງກັງວົນ.</b> ຖ້າທ່ານຄິດວ່າມັນແມ່ນຂໍ້ຜິດພາດຂອງພວກເຮົາ, ກະລຸນາສົ່ງຂໍ້ຄວາມຫາພວກເຮົາ ທີ່"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.error_message
msgid "<strong>Error message:</strong>"
msgstr "<strong>ຂໍ້ຄວາມຜິດພາດ:</strong>"

#. module: http_routing
#: model_terms:ir.ui.view,arch_db:http_routing.500
msgid "Back"
msgstr "ກັບຄືນ"

#. module: http_routing
#: model:ir.model.fields,field_description:http_routing.field_ir_http__display_name
#: model:ir.model.fields,field_description:http_routing.field_ir_qweb__display_name
#: model:ir.model.fields,field_description:http_routing.field_res_lang__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

