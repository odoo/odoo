<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_account_payment_promise_wizard" model="ir.actions.act_window">
        <field name="name">Record Promise</field>
        <field name="res_model">account.payment.promise.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_invoice_ids': [(4, active_id)]}</field>
    </record>

    <record id="action_account_payment_promise_wizard_customer" model="ir.actions.act_window">
        <field name="name">Record Promise</field>
        <field name="res_model">account.payment.promise.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>

    <record id="view_account_payment_promise_wizard_form" model="ir.ui.view">
        <field name="name">account.payment.promise.wizard.form</field>
        <field name="model">account.payment.promise.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Promise">
                <group>
                    <group>
                        <field name="invoice_ids" widget="many2many_tags"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_promised"/>
                        <field name="promise_method"/>
                    </group>
                </group>
                <group>
                    <field name="note" placeholder="Additional notes..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
