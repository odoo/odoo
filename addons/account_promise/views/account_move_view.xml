        <field name="name">account.move.view.form.inherit.account.payment.promise</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_account_payment_promise_wizard)d" type="action" string="Promises" class="oe_stat_button" />
            </xpath>
        </field>
    </record>
</odoo>
