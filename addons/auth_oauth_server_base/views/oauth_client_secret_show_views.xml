<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oauth_client_secret_show_view_form" model="ir.ui.view">
        <field name="name">oauth.client.secret.show.view.form</field>
        <field name="model">oauth.client.secret.show</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h3 class="fw-bold">Write down this client secret</h3>
                    <p class="alert alert-warning" role="alert">
                        <strong>Important:</strong>
                        The client secret cannot be retrieved later. It is very important to store it securely.
                    </p>
                    <group>
                        <field name="client_secret"/>
                    </group>
                </sheet>
                <footer>
                    <button special="cancel" string="Done!" class="btn-primary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
