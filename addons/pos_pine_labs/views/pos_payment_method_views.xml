<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_pine_labs" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos.pine.labs</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'pine_labs'">
                    <page name="settings" string="Pine Labs">
                        <group>
                            <group>
                                <field name="pine_labs_merchant" required="payment_provider == 'pine_labs'"/>
                                <field name="pine_labs_store" required="payment_provider == 'pine_labs'"/>
                                <field name="pine_labs_client" required="payment_provider == 'pine_labs'"/>
                                <field name="pine_labs_security_token" required="payment_provider == 'pine_labs'" password="True"/>
                                <field name="pine_labs_allowed_payment_mode" required="payment_provider == 'pine_labs'"/>
                                <field name="pine_labs_test_mode"/>
                            </group>
                            <group>
                                <div class="d-flex justify-content-end" colspan="2">
                                    <button name="action_pine_labs_test_creds" type="object" string="Test" class="btn-primary text-nowrap" groups="point_of_sale.group_pos_manager"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
