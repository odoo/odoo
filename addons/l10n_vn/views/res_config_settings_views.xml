<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_vn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices']" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'VN'"/>
            </xpath>
            <xpath expr="//setting[@id='qr_code_invoices']" position="after">
                <setting id="l10n_vn_qr_code_invoices" string="VietQR Code" company_dependent="1"
                    help="Add a QR-code to your invoices so that your customers can pay instantly with their mobile banking application."
                    invisible="country_code != 'VN'">
                    <field name="qr_code" class="oe_inline"/>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_inherit_l10n_vn" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n.vn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Vietnamese E-invoice" id="vn_localization" invisible="country_code != 'VN'">
                    <setting id="l10n_vn_edi_symbol_setting"
                             string="Set up Symbol"
                             help="Track E-invoice data."
                             company_dependent="1">
                        <div id="l10n_vn_edi_symbol_content" class="content-group mb-3">
                            <div id="l10n_vn_edi_default_symbol_row" class="row align-items-end" title="Used for all non-POS invoices unless a specific symbol is defined in each invoice journal.">
                                <label for="l10n_vn_default_invoice_symbol_id" class="col-3 col-lg-3 o_light_label"/>
                                <field name="l10n_vn_default_invoice_symbol_id"
                                       nolabel="1"
                                       context="{'default_company_id': company_id, 'default_usage': 'invoice'}"/>
                            </div>
                        </div>
                        <div id="l10n_vn_edi_symbol_actions" class="d-flex flex-wrap align-items-center gap-2">
                            <button string="View Invoice Symbol List"
                                    type="action"
                                    name="%(l10n_vn.action_l10n_vn_symbol)d"
                                    class="btn btn-link"
                                    icon="east"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
