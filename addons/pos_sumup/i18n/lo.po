#. module: pos_sumup
#: model:ir.model.fields,help:pos_sumup.field_pos_payment_method__sumup_pairing_code
msgid "Code displayed on the reader screen, used to pair it once."
msgstr "ລະຫັດທີ່ສະແດງຢູ່ໜ້າຈໍເຄື່ອງອ່ານ, ໃຊ້ສຳລັບການຈັບຄູ່ຄັ້ງດຽວ."

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "Could not pair the reader: %(error)s"
msgstr "ບໍ່ສາມາດຈັບຄູ່ເຄື່ອງອ່ານໄດ້: %(error)s"

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "Could not reach SumUp. Please try again in a moment."
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບ SumUp ໄດ້. ກະລຸນາລອງໃໝ່ອີກໃນຈັກໜ່ອຍ."

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "Could not reach SumUp. Please try again."
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບ SumUp ໄດ້. ກະລຸນາລອງໃໝ່ອີກ."

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "Couldn't find a transaction corresponding to this payment."
msgstr "ບໍ່ພົບທຸລະກຳທີ່ກົງກັບການຊຳລະເງິນນີ້."

#. module: pos_sumup
#: model:ir.model.fields,field_description:pos_sumup.field_pos_payment_method__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: pos_sumup
#: model:ir.model.fields,field_description:pos_sumup.field_pos_payment_method__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: pos_sumup
#: model:ir.module.module,summary:base.module_pos_sumup
msgid "Integrate your POS with a SumUp payment terminal"
msgstr "ເຊື່ອມຕໍ່ POS ຂອງທ່ານກັບເຄື່ອງຮັບຊຳລະເງິນ SumUp"

#. module: pos_sumup
#: model:ir.module.module,shortdesc:base.module_pos_sumup
msgid "POS SumUp"
msgstr "POS SumUp"

#. module: pos_sumup
#: model:ir.model.fields,field_description:pos_sumup.field_pos_payment_method__sumup_pairing_code
msgid "Pairing Code"
msgstr "ລະຫັດຈັບຄູ່"

#. module: pos_sumup
#. odoo-javascript
#: code:addons/pos_sumup/static/src/app/utils/payment/payment_sumup.js:0
msgid "Payment failed."
msgstr "ການຊຳລະເງິນບໍ່ສຳເລັດ."

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "Please set the SumUp merchant code first."
msgstr "ກະລຸນາກຳນົດລະຫັດຮ້ານຄ້າ SumUp ກ່ອນ."

#. module: pos_sumup
#: model:ir.model,name:pos_sumup.model_pos_payment_method
msgid "Point of Sale Payment Method"
msgstr "ວິທີການຊຳລະເງິນຈຸດຂາຍ"

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid ""
"Reader %(terminal)s is already used in company %(company)s on payment method"
" %(payment_method)s."
msgstr ""
"ເຄື່ອງອ່ານ %(terminal)s ຖືກນຳໃຊ້ແລ້ວໃນບໍລິສັດ %(company)s ສຳລັບວິທີການຊຳລະເງິນ %"
"(payment_method)s."

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid ""
"Reader %(terminal)s is already used on payment method %(payment_method)s."
msgstr ""
"ເຄື່ອງອ່ານ %(terminal)s ຖືກນຳໃຊ້ແລ້ວສຳລັບວິທີການຊຳລະເງິນ %(payment_method)s."

#. module: pos_sumup
#: model:ir.model.fields,field_description:pos_sumup.field_pos_payment_method__sumup_terminal_id
msgid "Reader ID"
msgstr "ລະຫັດເຄື່ອງອ່ານ"

#. module: pos_sumup
#: model:ir.model.fields,help:pos_sumup.field_pos_payment_method__sumup_merchant_code
msgid "Short unique identifier for the merchant (e.g. MK10CL2A)."
msgstr "ລະຫັດສະເພາະແບບສັ້ນສຳລັບຮ້ານຄ້າ (ຕົວຢ່າງ: MK10CL2A)."

#. module: pos_sumup
#: model_terms:ir.ui.view,arch_db:pos_sumup.pos_payment_method_view_form_inherit_pos_sumup
msgid "SumUp"
msgstr "SumUp"

#. module: pos_sumup
#: model:ir.model.fields,field_description:pos_sumup.field_pos_payment_method__sumup_api_key
msgid "SumUp API key"
msgstr "ຄີ API SumUp"

#. module: pos_sumup
#. odoo-javascript
#: code:addons/pos_sumup/static/src/app/utils/payment/payment_sumup.js:0
msgid "SumUp Error"
msgstr "ຂໍ້ຜິດພາດ SumUp"

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "SumUp can't refund a transaction not paid with SumUp."
msgstr "SumUp ບໍ່ສາມາດສົ່ງເງິນຄືນສຳລັບທຸລະກຳທີ່ບໍ່ໄດ້ຊຳລະຜ່ານ SumUp ໄດ້."

#. module: pos_sumup
#: model:ir.model.fields,help:pos_sumup.field_pos_payment_method__sumup_terminal_id
msgid "SumUp reader identifier (e.g. rdr_3MSAFM23CK82VSTT4BN6RWSQ65)."
msgstr "ລະຫັດລະບຸເຄື່ອງອ່ານ SumUp (ຕົວຢ່າງ: rdr_3MSAFM23CK82VSTT4BN6RWSQ65)."

#. module: pos_sumup
#: model:ir.model.fields,field_description:pos_sumup.field_pos_payment_method__sumup_merchant_code
msgid "Sumup Merchant Code"
msgstr "ລະຫັດຮ້ານຄ້າ SumUp"

#. module: pos_sumup
#: model:ir.model.fields,help:pos_sumup.field_pos_payment_method__sumup_api_key
msgid ""
"Used when connecting to SumUp: "
"https://developer.sumup.com/tools/authorization/api-keys#create-an-api-key"
msgstr ""
"ໃຊ້ເມື່ອເຊື່ອມຕໍ່ກັບ SumUp: https://developer.sumup.com/tools/authorization/api-"
"keys#create-an-api-key"

#. module: pos_sumup
#. odoo-python
#: code:addons/pos_sumup/models/pos_payment_method.py:0
msgid "You do not have the necessary permissions to make a SumUp payment."
msgstr "ທ່ານບໍ່ມີສິດອະນຸຍາດທີ່ຈຳເປັນໃນການດຳເນີນການຊຳລະເງິນ SumUp."
