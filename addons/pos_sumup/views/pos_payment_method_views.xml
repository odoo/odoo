<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_sumup" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.sumup</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'sumup'">
                    <page name="settings" string="SumUp">
                        <group>
                            <group>
                                <field name="sumup_api_key" required="payment_provider == 'sumup'" password="True"/>
                                <field name="sumup_merchant_code" required="payment_provider == 'sumup'"/>
                                <field name="sumup_terminal_id"/>
                                <field name="sumup_pairing_code" invisible="sumup_terminal_id"/>
                            </group>
                            <group>
                                <div class="d-flex justify-content-end" colspan="2">
                                    <button name="action_sumup_test_creds" type="object" string="Test" class="btn-primary text-nowrap"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
