#. module: cloud_storage
#. odoo-python
#: code:addons/cloud_storage/controllers/attachment.py:0
msgid "Cloud storage configuration has been changed. Please refresh the page."
msgstr "ການກຳນົດຄ່າບ່ອນເກັບຂໍ້ມູນຄລາວມີການປ່ຽນແປງ. ກະລຸນາໂຫຼດໜ້ານີ້ຄືນໃໝ່."

#. module: cloud_storage
#. odoo-javascript
#: code:addons/cloud_storage/static/src/core/public_web/attachment_upload_service_patch.js:0
