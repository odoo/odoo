msgstr "ຂະໜາດໄຟລ໌ຕໍ່າສຸດ"

#. module: cloud_storage
#: model:ir.model.fields,field_description:cloud_storage.field_res_config_settings__cloud_storage_min_file_size_mb
msgid "Minimum File Size (MB)"
msgstr "ຂະໜາດໄຟລ໌ຕໍ່າສຸດ (MB)"

#. module: cloud_storage
#: model:ir.model.fields,field_description:cloud_storage.field_res_config_settings__cloud_storage_min_file_size
msgid "Minimum File Size (bytes)"
msgstr "ຂະໜາດໄຟລ໌ຕໍ່າສຸດ (ໄບຕ໌)"

#. module: cloud_storage
#: model_terms:ir.ui.view,arch_db:cloud_storage.cloud_storage_config_settings_view_form
msgid "Minimum size for attachments to be stored in the cloud storage"
msgstr "ຂະໜາດຕໍ່າສຸດສຳລັບໄຟລ໌ຄັດຕິດທີ່ຈະບັນທຶກໄວ້ໃນບ່ອນເກັບຂໍ້ມູນຄລາວ"

#. module: cloud_storage
#. odoo-python
#: code:addons/cloud_storage/models/res_config_settings.py:0
msgid "Please configure the Cloud Storage before enabling it"
msgstr "ກະລຸນາກຳນົດຄ່າບ່ອນເກັບຂໍ້ມູນຄລາວກ່ອນເປີດໃຊ້ງານ"

#. module: cloud_storage
#: model_terms:ir.ui.view,arch_db:cloud_storage.cloud_storage_config_settings_view_form
msgid "Select the cloud storage provider to store new attachments."
msgstr "ເລືອກຜູ້ໃຫ້ບໍລິການບ່ອນເກັບຂໍ້ມູນຄລາວ ເພື່ອເກັບຮັກສາໄຟລ໌ຄັດຕິດໃໝ່."

#. module: cloud_storage
#: model:ir.module.module,summary:base.module_cloud_storage
msgid "Store chatter attachments in the cloud"
msgstr "ເກັບຮັກສາໄຟລ໌ຄັດຕິດຂອງຂໍ້ຄວາມສົນທະນາໄວ້ເທິງຄລາວ"

#. module: cloud_storage
#: model:ir.model.fields,field_description:cloud_storage.field_ir_attachment__type
msgid "Type"
msgstr "ປະເພດ"

#. module: cloud_storage
#: model:ir.model.fields,field_description:cloud_storage.field_res_config_settings__cloud_storage_upload_record_attachments
msgid "Upload Record Attachments"
msgstr "ອັບໂຫຼດໄຟລ໌ຄັດຕິດຂອງຂໍ້ມູນ"

#. module: cloud_storage
#: model_terms:ir.ui.view,arch_db:cloud_storage.cloud_storage_config_settings_view_form
msgid "Upload record attachments to the cloud storage"
msgstr "ອັບໂຫຼດໄຟລ໌ຄັດຕິດຂອງຂໍ້ມູນໄປຍັງບ່ອນເກັບຂໍ້ມູນຄລາວ"

#. module: cloud_storage
#. odoo-javascript
#: code:addons/cloud_storage/static/src/core/public_web/attachment_upload_service_patch.js:0
msgid "You are not allowed to upload file to the cloud storage"
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ອັບໂຫຼດໄຟລ໌ໄປຍັງບ່ອນເກັບຂໍ້ມູນຄລາວ"

#. module: cloud_storage
#: model:ir.model.fields,help:cloud_storage.field_ir_attachment__type
msgid ""
"You can either upload a file from your computer or copy/paste an internet "
"link to your file."
msgstr ""
"ທ່ານສາມາດອັບໂຫຼດໄຟລ໌ຈາກຄອມພິວເຕີຂອງທ່ານ ຫຼື ສຳເນົາ/ວາງ ລິ້ງອິນເຕີເນັດໃສ່ໄຟລ໌ຂອງທ່ານໄດ້."

#. module: cloud_storage
#: model:ir.model.fields,help:cloud_storage.field_res_config_settings__cloud_storage_min_file_size
msgid ""
"webclient can upload files larger than the minimum file size\n"
"        (in bytes) as url attachments to the server and then upload the file "
"to\n"
"        the cloud storage."
msgstr ""
"webclient ສາມາດອັບໂຫຼດໄຟລ໌ທີ່ມີຂະໜາດໃຫຍ່ກວ່າຂະໜາດໄຟລ໌ຕໍ່າສຸດ\n"
"        (ເປັນໄບຕ໌) ເປັນໄຟລ໌ຄັດຕິດແບບ url ໄປຍັງເຊີບເວີ ແລ້ວຈຶ່ງອັບໂຫຼດໄຟລ໌ດັ່ງກ່າວໄປ\n"
"        ຍັງບ່ອນເກັບຂໍ້ມູນຄລາວ."
