<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_sale_loyalty" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.sale.loyalty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_gift_cards"
                    class="oe_stat_button"
                    type="object"
                    icon="card_giftcard"
                    invisible="gift_card_count == 0"
                >
                    <field string="Gift Cards" name="gift_card_count" widget="statinfo"/>
                </button>
            </div>
            <button name="action_open_discount_wizard" position="before">
                <button
                    name="action_open_reward_wizard"
                    type="object"
                    class="btn btn-primary d-none d-md-block"
                    help="Update current promotional lines and select new rewards if applicable."
                    invisible="locked or state == 'cancel' or not claimable_reward_count"
                >
                    Codes and Rewards
                    <field
                        name="claimable_reward_count"
                        class="badge rounded-pill bg-o-color-3 text-o-color-1 ms-1"
                    />
                </button>
                <button
                    name="action_open_reward_wizard"
                    type="object"
                    class="btn btn-secondary d-none d-md-block"
                    help="Update current promotional lines and select new rewards if applicable."
                    invisible="locked or state == 'cancel' or claimable_reward_count"
                >
                    Codes and Rewards
                </button>
            </button>
            <xpath expr="//list//column[@name='sol_qty']" position="before">
                <field name="is_reward_line" column_invisible="True"/> <!-- used in the readonly attribute(s) this view sets on other fields -->
                <field name="reward_id" column_invisible="True" force_save="1"/> <!-- kept on save to identify the reward a line was generated from -->
                <field name="coupon_id" column_invisible="True" force_save="1"/> <!-- kept on save to identify the coupon a reward line was generated from -->
                <field name="reward_identifier_code" column_invisible="True"/> <!-- identifies the reward lines belonging to the same claimed reward -->
                <field name="points_cost" column_invisible="True"/> <!-- points spent by the reward line -->
            </xpath>
            <field name="order_line" position="before">
                <field name="disabled_auto_rewards" invisible="1"/> <!-- sent back to the server with the order so the auto-applied rewards the user removed stay disabled -->
                <field name="coupon_point_ids" invisible="1"> <!-- loaded with the order to be available client-side (e.g. gift card points) -->
                    <list>
                        <field name="coupon_id"/>
                        <field name="points"/>
                    </list>
                </field>
            </field>
            <xpath expr="//list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly" add="is_reward_line" separator=" or "/>
            </xpath>
            <xpath expr="//list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly" add="is_reward_line" separator=" or "/>
            </xpath>
            <xpath expr="//list//field[@name='tax_ids']" position="attributes">
                <attribute name="readonly" add="is_reward_line and state in ['draft', 'sent']" separator=" or "/>
            </xpath>
        </field>
    </record>

</odoo>
