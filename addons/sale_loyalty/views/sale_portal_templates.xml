<?xml version="1.0" ?>
<odoo>

    <template id="used_gift_card">
        <div class="d-md-block mb-2 small text-muted"
            t-if="line.coupon_id and line.order_id != line.coupon_id.order_id and not line.coupon_id.program_id.is_nominative">
            <span>
                Code:
                <t t-out="line.coupon_id.code[-4:].rjust(14, '⋆')"/>
            </span>
            <t t-if="line.coupon_id.expiration_date">
                <br/>
                <span>
                    Expired Date:
                    <t t-out="line.coupon_id.expiration_date"/>
                </span>
            </t>
        </div>
    </template>

    <template id="sale_purchased_gift_card">
        <t t-set="gift_cards" t-value="order.coupon_point_ids.filtered(lambda pe: pe.coupon_id.program_id.program_type == 'gift_card').coupon_id"/>
        <div class="card mt-3" t-if="gift_cards and order.state in ('sale', 'done')">
            <div class="card-body">
                <h6 t-if="not hide_intro" class="mb-3">
                    <t t-if="len(gift_cards) > 1">Your gift cards are ready to use</t>
                    <t t-else="">Your gift card is ready to use</t>
                </h6>
                <div class="row row-cols-2">
                    <t t-foreach="gift_cards" t-as="gift_card">
                        <small t-attf-class="col-12 mb-1 text-muted #{'mt-4' if not gift_card_first else ''}">
                            Gift card <t t-out="gift_card_index + 1"/>:
                            <span class="fw-bold" t-out="gift_card._format_points(order._get_real_points_for_coupon(gift_card, post_confirm=True))"/>
                        </small>
                        <div class="o_purchased_gift_card col-12 col-md-auto pe-md-0">
                            <div class="d-flex align-items-center justify-content-between border px-2 pe-0 rounded">
                                <span class="mb-0 fs-6 text-nowrap opacity-50" t-out="gift_card.code"/>
                                <button
                                    type="button"
                                    class="copy-to-clipboard btn m-1 border-0 p-0"
                                    t-att-data-clipboard-text="gift_card.code"
                                    title="Copy code"
                                    aria-label="Copy code"
                                >
                                    <i class="oi" data-icon="content_copy"/>
                                </button>
                            </div>
                        </div>
                        <form class="o_gift_card_send_form col-12 col-md mt-2 mt-md-0">
                            <input type="hidden" name="code" t-att-value="gift_card.code"/>
                            <div class="input-group h-100">
                                <input
                                    name="email"
                                    class="form-control"
                                    type="email"
                                    placeholder="Email Address"
                                    required="required"
                                />
                                <button type="submit" class="btn btn-primary text-nowrap">Send as gift</button>
                            </div>
                        </form>
                    </t>
                </div>
            </div>
        </div>
    </template>

    <template id="sale_order_portal_loyalty_content">
        <t t-set="has_issued" t-value="loyalty_data and loyalty_data['issued']"/>
        <t t-set="has_cost" t-value="loyalty_data and loyalty_data['cost']"/>
        <div t-if="has_issued or has_cost" class="d-flex flex-column gap-1">
            <t t-if="not hide_heading">
                <hr/>
                <strong class="smaller text-uppercase text-muted">Loyalty Card</strong>
            </t>
            <t t-if="has_issued and has_cost">
                <div class="d-flex justify-content-between align-items-baseline">
                    <small class="text-muted">Issued</small>
                    <small class="text-success">
                        +<t t-out="loyalty_data['issued']"/> <span class="text-muted" t-out="loyalty_data['point_name']"/>
                    </small>
                </div>
                <div class="d-flex justify-content-between align-items-baseline">
                    <small class="text-muted">Used</small>
                    <small class="text-danger">
                        −<t t-out="loyalty_data['cost']"/> <span class="text-muted" t-out="loyalty_data['point_name']"/>
                    </small>
                </div>
                <t t-set="net" t-value="round(loyalty_data['issued'] - loyalty_data['cost'], 2)"/>
                <div class="d-flex justify-content-between align-items-baseline">
                    <small class="fw-bold">Total</small>
                    <small t-attf-class="{{ 'text-success' if net >= 0 else 'text-danger' }}">
                        <t t-if="net > 0">+</t><t t-out="net"/> <span class="text-muted" t-out="loyalty_data['point_name']"/>
                    </small>
                </div>
            </t>
            <div t-else="" class="small">
                <span t-attf-class="fs-5 {{ 'text-success' if has_issued else 'text-danger' }}">
                    <t t-if="has_issued">+<t t-out="loyalty_data['issued']"/></t>
                    <t t-else="">−<t t-out="loyalty_data['cost']"/></t>
                </span>
                <span class="text-muted" t-out="loyalty_data['point_name']"/>
            </div>
        </div>
    </template>

    <template id="sale_order_portal_content_inherit"
              name="Gift Card Products Portal"
              inherit_id="sale.sale_order_portal_content">
        <xpath expr="//section[@id='details']//td[@name='td_product_name']/*[last()]" position="after">
            <t t-if="line.coupon_id and line.coupon_id.program_id.program_type == 'gift_card'"
               t-call="sale_loyalty.used_gift_card"/>
        </xpath>
        <xpath expr="//div[@id='total']" position="after">
            <t t-call="sale_loyalty.sale_purchased_gift_card" order="sale_order" hide_intro="1"/>
        </xpath>
    </template>

    <template id="sale_loyalty.sale_order_portal_template"
              name="Loyalty Points"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sidebar_loyalty_anchor']" position="after">
            <t t-if="loyalty_data" t-call="sale_loyalty.sale_order_portal_loyalty_content"/>
        </xpath>
        <xpath expr="//div[@id='provide_feedback']" position="before">
            <div t-if="loyalty_data and (loyalty_data['issued'] or loyalty_data['cost'])"
                 class="d-lg-none mt-4 p-3 rounded-3 border d-print-none">
                <h4>Loyalty Card</h4>
                <t t-call="sale_loyalty.sale_order_portal_loyalty_content" hide_heading="True"/>
            </div>
        </xpath>
    </template>

</odoo>
