<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_loyalty_reward_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.loyalty.reward.wizard.view.form</field>
        <field name="model">sale.loyalty.reward.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_id" invisible="1"/>
                        <field name="reward_ids" invisible="1"/>
                        <group>
                            <group>
                                <div class="o_input o_field_widget d-flex mb-2">
                                    <field
                                        name="coupon_code"
                                        class="w-100"
                                        nolabel="1"
                                        placeholder="Coupon or Gift Card"
                                    />
                                    <button
                                        type="object"
                                        name="action_verify_coupon"
                                        string="Verify"
                                        class="btn btn-link btn-link-inline text-nowrap"
                                    />
                                </div>
                            </group>
                        </group>
                        <group colspan="2">
                            <field name="reward_groups" invisible="1"/>
                            <field name="selected_product_ids" invisible="1"/>
                            <field
                                name="selected_reward_ids"
                                widget="sale_loyalty_reward_selection"
                                colspan="2"
                                nolabel="1"
                                invisible="not reward_ids"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        type="object"
                        name="action_apply"
                        string="Apply"
                        class="btn btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Discard"
                        type="object"
                        name="action_cancel"
                        class="btn btn-secondary"
                        data-hotkey="x"
                    />
                    <span invisible="not applied_reward_description">
                        <field name="applied_reward_description" nolabel="1" class="oe_inline"/>
                    </span>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_loyalty_reward_wizard_action" model="ir.actions.act_window">
        <field name="name">Codes &amp; Rewards</field>
        <field name="res_model">sale.loyalty.reward.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
