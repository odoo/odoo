<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="credential_credential_company_rule" model="ir.rule">
        <field name="name">Credential: Multi-company</field>
        <field name="model_id" ref="model_credential_credential" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="credential_credential_personal_rule" model="ir.rule">
        <field name="name">Credential: personal credentials are owner-only</field>
        <field name="model_id" ref="model_credential_credential" />
        <field name="global" eval="True" />
        <field
            name="domain_force">['|', ('owner_user_id', '=', False), ('owner_user_id', '=', user.id)]</field>
    </record>

    <record id="credential_access_log_company_rule" model="ir.rule">
        <field name="name">Credential Access Log: Multi-company</field>
        <field name="model_id" ref="model_credential_access_log" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="credential_use_company_rule" model="ir.rule">
        <field name="name">Secret Uses: Multi-company</field>
        <field name="model_id" ref="model_credential_use" />
        <field name="global" eval="True" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>
