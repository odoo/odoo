<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="credential.SecretFields">
        <div class="o_credential_secret_fields">
            <div t-if="!this.entries.length" class="text-muted">
                This category declares no stored fields.
            </div>
            <div t-foreach="this.entries" t-as="entry" t-key="entry.code" class="mb-2">
                <label class="o_form_label" t-att-for="'secret_' + entry.code">
                    <t t-out="entry.label" />
                    <span t-if="entry.required" class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <input
                        class="o_input"
                        t-att-id="'secret_' + entry.code"
                        t-att-type="entry.code in this.revealed ? 'text' : 'password'"
                        t-att-placeholder="this.placeholder(entry)"
                        t-att-value="this.displayValue(entry)"
                        t-att-readonly="this.props.readonly"
                        t-on-input="(ev) => this.onInput(entry, ev.target.value)"
                        autocomplete="new-password" />
                    <button
                        t-if="entry.filled &amp;&amp; !this.props.record.isNew"
                        class="btn btn-secondary"
                        type="button"
                        t-att-title="entry.code in this.revealed ? 'Hide' : 'Reveal'"
                        t-on-click="() => this.onReveal(entry)">
                        <i
                            class="fa"
                            t-att-class="entry.code in this.revealed ? 'fa-eye-slash' : 'fa-eye'" />
                    </button>
                </div>
                <small t-if="entry.help" class="text-muted" t-out="entry.help" />
            </div>
        </div>
    </t>

</templates>
