<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credential_use_list" model="ir.ui.view">
        <field name="name">credential.use.list</field>
        <field name="model">credential.use</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="day" />
                <field name="credential_id" />
                <field name="purpose" />
                <field name="use_count" sum="Total" />
                <field name="last_used_at" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_credential_use_search" model="ir.ui.view">
        <field name="name">credential.use.search</field>
        <field name="model">credential.use</field>
        <field name="arch" type="xml">
            <search>
                <field name="credential_id" />
                <field name="purpose" />
                <field name="day" />
                <group>
                    <filter
                        name="group_by_credential"
                        string="Credential"
                        context="{'group_by': 'credential_id'}" />
                    <filter
                        name="group_by_purpose"
                        string="Purpose"
                        context="{'group_by': 'purpose'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_credential_use" model="ir.actions.act_window">
        <field name="name">Secret Uses</field>
        <field name="res_model">credential.use</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No secret has been used yet</p>
            <p>Server code that places a secret on the wire, signs with it or hands it to
                a subprocess counts one use per credential, purpose and day here.</p>
        </field>
    </record>

</odoo>
