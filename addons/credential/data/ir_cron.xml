<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_validate_credentials" model="ir.cron">
        <field name="name">Credential Manager: Validate Credentials Health</field>
        <field name="model_id" ref="model_credential_credential" />
        <field name="state">code</field>
        <field name="code">model._cron_probe_credentials()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">hour</field>
        <field name="priority" eval="50" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_cleanup_access_logs" model="ir.cron">
        <field name="name">Credential Manager: Cleanup Old Access Logs</field>
        <field name="model_id" ref="model_credential_access_log" />
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_old_logs(retention_days=365)</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">week</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=7)).replace(hour=4, minute=0, second=0)" />
        <field name="priority" eval="70" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_check_expiring_credentials" model="ir.cron">
        <field name="name">Credential Manager: Check Expiring Credentials</field>
        <field name="model_id" ref="model_credential_credential" />
        <field name="state">code</field>
        <field name="code">model.cron_check_expiring_credentials()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field name="priority" eval="50" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_gc_credential_uses" model="ir.cron">
        <field name="name">Credential Manager: Cleanup Old Secret Use Counts</field>
        <field name="model_id" ref="model_credential_use" />
        <field name="state">code</field>
        <field name="code">model.cron_gc_uses(retention_days=400)</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">week</field>
        <field name="priority" eval="70" />
        <field name="active" eval="True" />
    </record>

</odoo>
