<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_layout" name="Portal layout: timesheet menu entry" inherit_id="portal.portal_breadcrumbs" priority="35">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'timesheet' or timesheet" t-attf-class="breadcrumb-item #{'active' if not timesheet else ''}">
                <t>Timesheets</t>
            </li>
        </xpath>
    </template>

    <template id="portal_my_timesheets" name="My Timesheets">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">

            <t t-call="portal.portal_searchbar" title.translate="Timesheets"/>
            <t t-call="portal.portal_list_table" classes.f="o_portal_timesheet_table">
                <div class="alert alert-warning" role="alert">
                    There are no timesheets.
                </div>
            </t>
        </t>
    </template>

    <!-- Own cell, as helpdesk_sale_timesheet appends the ticket to the task. -->
    <template id="portal_timesheet_cell_task" name="Portal Timesheet Task Cell">
        <td t-att-name="column['name']" class="text-wrap">
            <span t-field="record.task_id"/>
        </td>
    </template>

    <template id="portal_timesheet_cell_unit_amount" name="Portal Timesheet Time Spent Cell">
        <td t-att-name="column['name']" t-attf-class="#{column.get('class') or ''}">
            <span t-if="is_uom_day" t-out="record._get_timesheet_time_day()" t-options='{"widget": "timesheet_uom"}'/>
            <span t-else="" t-field="record.unit_amount" t-options='{"widget": "float_time"}'/>
        </td>
    </template>

    <template id="portal_timesheet_group_row" name="Portal Timesheets Group Row">
        <t t-set="total">
            <t t-if="is_uom_day">
                Total: <span t-out="group['records']._convert_hours_to_days(group['hours_spent'])" t-options='{"widget": "timesheet_uom"}'/>
            </t>
            <t t-else="">
                Total: <span t-out="group['hours_spent']" t-options='{"widget": "float_time"}'/>
            </t>
        </t>
        <t t-set="aggregates" t-value="{'unit_amount': total}"/>
        <t t-call="portal.portal_list_group_row"/>
    </template>

    <template id="portal_timesheet_table" name="Portal Timesheet Table">
        <table class="o_portal_my_doc_table table table-sm table-striped">
            <thead>
              <tr>
                <th>Date</th>
                <th>Employee</th>
                <th>Description</th>
                <th class="text-end" name="t_label">Time Spent</th>
              </tr>
            </thead>
            <tr t-foreach="timesheets" t-as="timesheet" valign="middle">
                <td><t t-out="timesheet.date" t-options='{"widget": "date"}'/></td>
                <td t-attf-title="#{timesheet.employee_id.name}"><t t-out="timesheet.employee_id.name"/></td>
                <td class="text-wrap"><t t-out="timesheet.name"/></td>
                <td class="text-end">
                    <span t-if="is_uom_day" t-out="timesheet._get_timesheet_time_day()" t-options='{"widget": "timesheet_uom"}'/>
                    <span t-else="" t-field="timesheet.unit_amount" t-options='{"widget": "float_time"}'/>
                </td>
            </tr>
        </table>
    </template>

    <template id="portal_timesheet_table_with_total" name="Portal Timesheet Table">
        <t t-call="hr_timesheet.portal_timesheet_table"/>
        <div class="container_subtotal">
            <div class="row justify-content-end">
                <div t-attf-class="{{'col-auto' if report_type != 'html' else 'col-sm-2'}}">
                    <table class="table table-sm">
                        <tr>
                            <td><strong>Total Time Spent: </strong></td>
                            <td class="text-end">
                                <span t-if="is_uom_day" t-out="timesheets._convert_hours_to_days(task.effective_hours)" t-options="{'widget': 'timesheet_uom'}"/>
                                <span t-else="" t-out="task.effective_hours" t-options='{"widget": "float_time"}'/>
                            </td>
                        </tr>
                        <tr>
                            <div t-if="task.subtask_effective_hours">
                                <td><strong>Time recorded on sub-tasks: </strong></td>
                                <td class="text-end">
                                    <span t-if="is_uom_day" t-out="timesheets._convert_hours_to_days(task.subtask_effective_hours)" t-options='{"widget": "timesheet_uom"}'/>
                                    <span t-else="" t-out="task.subtask_effective_hours" t-options='{"widget": "float_time"}'/>
                                </td>
                            </div>
                        </tr>
                        <tr>
                            <div t-if="task.total_hours_spent and task.subtask_effective_hours" name="total_time">
                                <t t-if="is_uom_day">
                                    <td><strong>Total Days: </strong></td>
                                    <td class="text-end">
                                        <span t-out="timesheets._convert_hours_to_days(task.total_hours_spent)" t-options='{"widget": "timesheet_uom"}'/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td><strong>Total Hours: </strong></td>
                                    <td class="text-end">
                                        <span t-out="task.total_hours_spent" t-options='{"widget": "float_time"}'/>
                                    </td>
                                </t>
                            </div>
                        </tr>
                        <tr t-attf-class="{{task.remaining_hours &lt; 0 and 'text-danger' or ''}}">
                            <div t-if="task.allocated_hours > 0" name="allocated_time">
                                <td><strong>Time Remaining: </strong></td>
                                <td class="text-end">
                                    <span t-if="is_uom_day" t-out="timesheets._convert_hours_to_days(task.remaining_hours)" t-options='{"widget": "timesheet_uom"}'/>
                                    <span t-else="" t-out="task.remaining_hours" t-options='{"widget": "float_time"}'/>
                                </td>
                            </div>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>
</odoo>
