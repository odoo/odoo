<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_task" inherit_id="project.portal_my_task" name="Portal: My Task with Timesheets">
        <xpath expr="//div[hasclass('o_project_portal_sidebar')]" position="before">
            <t t-set="show_portal_timesheets" t-value="timesheets and timesheets[0].env['account.analytic.line']._show_portal_timesheets()"/>
        </xpath>
        <xpath expr="//div[@id='task_sidebar_buttons']" position="inside">
            <a t-if="timesheets and allow_timesheets and show_portal_timesheets" class="btn btn-light o_print_btn o_project_timesheet_print" t-att-href="task.get_portal_url(report_type='pdf')" title="View Details" role="button" target="_blank">View Details</a>
        </xpath>
        <xpath expr="//div[@id='task_mobile_buttons']" position="attributes">
            <attribute name="t-if">task_link_section or (timesheets and allow_timesheets and show_portal_timesheets)</attribute>
        </xpath>
        <xpath expr="//div[@id='task_mobile_buttons']" position="inside">
            <a t-if="timesheets and allow_timesheets and show_portal_timesheets" class="btn btn-light btn-sm o_print_btn o_project_timesheet_print" t-att-href="task.get_portal_url(report_type='pdf')" title="View Details" role="button" target="_blank">View Details</a>
        </xpath>
        <xpath expr="//div[@id='card']" position="after">
            <section t-if="timesheets and allow_timesheets and show_portal_timesheets" id="task_timesheets" class="p-3 p-lg-4 mt-4 rounded-3 border" data-anchor="true">
                <h4 class="pb-1">Timesheets</h4>
                <t t-call="hr_timesheet.portal_timesheet_table_with_total"/>
            </section>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_allocated_hours']" position="attributes">
            <attribute name="t-if">allow_timesheets and task.allocated_hours > 0 and task.env['account.analytic.line']._show_portal_timesheets()</attribute>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_allocated_hours']" position="after">
            <div t-if="task.allocated_hours > 0 and allow_timesheets and show_portal_timesheets" name="portal_my_task_progress">
                <div class="text-muted">Progress</div>
                <div class="fw-medium"><span t-out="task.progress * 100" t-options='{"widget": "float", "precision": 0}'/>%</div>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='project.portal_my_task_allocated_hours_template']" position="replace">
            <t t-call="hr_timesheet.portal_my_task_allocated_hours_template"/>
        </xpath>
    </template>

    <template id="portal_my_task_allocated_hours_template">
        <t t-if="allow_timesheets and task.allocated_hours > 0">
            <t t-if="is_uom_day">
                <span t-out="timesheets._convert_hours_to_days(task.allocated_hours)" t-options='{"widget": "timesheet_uom"}'/>
            </t>
            <t t-else="" t-call="project.portal_my_task_allocated_hours_template"/>
        </t>
    </template>

    <template id="portal_tasks_list_inherit" inherit_id="project.portal_tasks_list" name="Portal: My Tasks with Timesheets">
        <xpath expr="//thead" position="before">
            <t t-set="allow_timesheets" t-value="any(task.allow_timesheets for group in grouped_tasks for task in group)"/>
            <t t-set="show_portal_timesheets" t-value="grouped_tasks[0][0].env['account.analytic.line']._show_portal_timesheets()"/>
        </xpath>
        <xpath expr="//t[@t-foreach='tasks']/tr" position="before">
            <t t-set="timesheet_ids" t-value="task.sudo().timesheet_ids"/>
            <t t-set="is_uom_day" t-value="timesheet_ids._is_timesheet_encode_uom_day()"/>
        </xpath>
        <xpath expr="//thead/tr/th[@name='stage_id_col']" position="before">
            <t t-if="(not project or project.allow_timesheets) and show_portal_timesheets">
                <th class="text-end">Time Spent</th>
            </t>
        </xpath>
        <xpath expr="//tr[@name='grouped_tasks_groupby_columns']//th[@name='stage_id_col']" position="before">
            <th t-if="(not project or project.allow_timesheets) and show_portal_timesheets" class="text-end text-muted fw-normal">
                <t t-set="total_hours_dict" t-value="tasks._get_portal_total_hours_dict()"/>
                <t t-if="total_hours_dict">
                    <t t-set="total_allocated_hours" t-value="tasks.project_id.allocated_hours if groupby == 'project_id' else total_hours_dict['allocated_hours']"/>
                    <t t-set="total_effective_hours" t-value="total_hours_dict['effective_hours']"/>
                    <span>
                        Total:
                        <t t-if="is_uom_day">
                            <t t-out="tasks._convert_hours_to_days(total_effective_hours)" t-options='{"widget": "timesheet_uom"}'/>
                            <t t-if="total_allocated_hours"> /
                                <t t-out="tasks._convert_hours_to_days(total_allocated_hours)" t-options='{"widget": "timesheet_uom"}'/>
                            </t>
                        </t>
                        <t t-else="">
                            <t t-if="total_effective_hours">
                                <t t-out="tasks.env['account.analytic.line']._format_portal_hours(total_effective_hours)"/>
                            </t>
                            <t t-else=""> 0h </t>
                            <t t-if="total_allocated_hours"> /
                                <t t-out="tasks.env['account.analytic.line']._format_portal_hours(total_allocated_hours)"/>
                            </t>
                        </t>
                    </span>
                </t>
            </th>
        </xpath>
        <xpath expr="//tbody/t/tr/td[@name='project_portal_project']" position="after">
            <td t-if="(not project or project.allow_timesheets) and show_portal_timesheets" class="text-end">
                <t t-if="task.allow_timesheets">
                    <t t-if="is_uom_day">
                        <t t-out="timesheet_ids._convert_hours_to_days(task.total_hours_spent)"/>
                        <span t-if="task.allocated_hours > 0"> / <t t-out="timesheet_ids._convert_hours_to_days(task.allocated_hours)"/></span>
                    </t>
                    <t t-else="">
                        <t t-if="task.total_hours_spent">
                            <span t-out="timesheet_ids._format_portal_hours(task.total_hours_spent)"/>
                        </t>
                        <t t-else=""> 0h </t>
                        <t t-if="task.allocated_hours > 0">
                            /
                            <span t-out="timesheet_ids._format_portal_hours(task.allocated_hours)"/>
                        </t>
                    </t>
                </t>
            </td>
        </xpath>
    </template>

</odoo>
