<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_task" inherit_id="project.portal_my_task" name="Portal: My Task with Timesheets">
        <xpath expr="//div[hasclass('o_project_portal_sidebar')]" position="before">
            <t t-set="show_portal_timesheets" t-value="timesheets and timesheets[0].env['account.analytic.line']._show_portal_timesheets()"/>
        </xpath>
        <xpath expr="//div[@id='task-nav']" position="before">
            <div t-if="timesheets and allow_timesheets and show_portal_timesheets" class="d-grid flex-grow-1" id='nav-report'>
                <a class="btn btn-light o_print_btn o_project_timesheet_print d-block" t-att-href="task.get_portal_url(report_type='pdf')" href="#" title="View Details" role="button" target="_blank"><i class="oi" data-icon="print"/> View Details</a>
            </div>
        </xpath>
        <xpath expr="//li[@id='nav-header']" position="after">
            <div t-if="timesheets and allow_timesheets and show_portal_timesheets" class="nav-item">
                <a class="nav-link p-0" href="#task_timesheets">
                    Timesheets
                </a>
            </div>
        </xpath>
        <xpath expr="//div[@id='card_body']" position="inside">
            <div class="container" t-if="timesheets and allow_timesheets and show_portal_timesheets">
                <h5 id="task_timesheets" class="mt-2 mb-2" data-anchor="true">Timesheets</h5>
                <t t-call="hr_timesheet.portal_timesheet_table_with_total"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_allocated_hours']" position="attributes">
            <attribute name="t-if">task.env['account.analytic.line']._show_portal_timesheets()</attribute>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_allocated_hours']" position="after">
            <div t-if="task.allocated_hours > 0 and allow_timesheets and show_portal_timesheets"><strong>Progress:</strong> <span t-out="task.progress * 100" t-options='{"widget": "float", "precision": 0}'/>%</div>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_allocated_hours']/t" position="replace">
            <t t-call="hr_timesheet.portal_my_task_allocated_hours_template"/>
        </xpath>
    </template>

    <template id="portal_my_task_allocated_hours_template">
        <t t-if="allow_timesheets and task.allocated_hours > 0">
            <t t-if="is_uom_day">
                <span t-out="timesheets._convert_hours_to_days(task.allocated_hours)" t-options='{"widget": "timesheet_uom"}'/>
            </t>
            <t t-else="" t-call="project.portal_my_task_allocated_hours_template"/>
        </t>
    </template>

    <template id="portal_task_cell_time_spent" name="Portal Task Time Spent Cell">
        <td t-att-name="column['name']" t-attf-class="#{column.get('class') or ''}">
            <t t-if="record.allow_timesheets">
                <t t-set="timesheet_ids" t-value="record.sudo().timesheet_ids"/>
                <t t-if="is_uom_day">
                    <t t-out="timesheet_ids._convert_hours_to_days(record.total_hours_spent)"/>
                    <span t-if="record.allocated_hours > 0"> / <t t-out="timesheet_ids._convert_hours_to_days(record.allocated_hours)"/></span>
                </t>
                <t t-else="">
                    <span t-field="record.total_hours_spent" t-options='{"widget": "float_time"}'/>
                    <t t-if="record.allocated_hours > 0">
                        /
                        <span t-field="record.allocated_hours" t-options='{"widget": "float_time"}'/>
                    </t>
                </t>
            </t>
        </td>
    </template>

    <template id="portal_task_group_row" name="Portal Tasks Group Row">
        <t t-set="tasks" t-value="group['records']"/>
        <t t-set="total">
            <span>
                Total:
                <t t-if="is_uom_day">
                    <t t-out="tasks._convert_hours_to_days(group['effective_hours'])" t-options='{"widget": "timesheet_uom"}'/>
                    <t t-if="group['allocated_hours']"> /
                        <t t-out="tasks._convert_hours_to_days(group['allocated_hours'])" t-options='{"widget": "timesheet_uom"}'/>
                    </t>
                </t>
                <t t-else="">
                    <t t-out="group['effective_hours']" t-options='{"widget": "float_time"}'/>
                    <t t-if="group['allocated_hours']"> /
                        <t t-out="group['allocated_hours']" t-options='{"widget": "float_time"}'/>
                    </t>
                </t>
            </span>
        </t>
        <t t-set="aggregates" t-value="{'time_spent': total}"/>
        <t t-call="portal.portal_list_group_row"/>
    </template>

</odoo>
