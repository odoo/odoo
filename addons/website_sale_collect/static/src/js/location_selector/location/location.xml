<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="delivery.locationSelector.location" t-inherit-mode="extension">
        <small name="location_opening_hours" position="before">
            <t t-if="this.props.additionalData and !!this.props.additionalData.in_store_stock_data">
                <t t-if="!!this.props.additionalData.in_store_stock_data.in_stock">
                    <t t-if="!!this.props.additionalData.in_store_stock_data.show_quantity">
                        <span class="text-warning">
                            <i class="fa-solid fa-circle"/>
                            Only <t t-out="this.props.additionalData.in_store_stock_data.quantity"/>
                            available
                        </span>
                    </t>
                    <t t-else="">
                        <span class="text-success">
                            <i class="fa-solid fa-circle"/> Available
                        </span>
                    </t>
                </t>
                <t t-else="">
                    <span class="text-danger">
                        <i class="fa-solid fa-times"/> Out of stock
                    </span>
                </t>
            </t>
        </small>
    </t>

</templates>
