<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="website_sale_collect.ClickAndCollectAvailability">
        <t t-set="inStoreAvailable" t-value="this.state.inStoreData.stock_data?.in_stock"/>
        <div
            class="o_wsale_collect_switch d-flex flex-column gap-1 w-100 bg-o-color-3"
            role="radiogroup"
            aria-label="Shipping method"
        >
            <label
                name="click_and_collect_availability"
                class="o_wsale_collect_option d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 gap-md-3 w-100 p-3 cursor-pointer"
            >
                <input
                    type="radio"
                    class="visually-hidden"
                    name="o_wsale_collect_mode"
                    t-att-checked="this.state.isInStoreSelected"
                    t-on-click="() => inStoreAvailable ? this.selectPickup() : null"/>
                <div class="small">
                    <strong>
                        <i class="oi oi-fw me-1" data-icon="storefront"/>
                        <t
                            t-if="this.state.selectedLocationData.id"
                            t-out="this.state.selectedLocationData.name"
                        />
                        <t t-else="">Select a Store</t>
                    </strong>
                    <a
                        t-if="inStoreAvailable and this.state.selectedLocationData.id"
                        role="button"
                        href="#"
                        class="text-primary ms-1"
                        t-att-title="this.props.showSelectStoreButton
                            ? 'Change store' : 'See the store on the map'"
                        t-on-click.prevent.stop="() => this.openLocationSelector()"
                    >
                        <i
                            class="oi oi-fw"
                            t-att-data-icon="this.props.showSelectStoreButton
                                ? 'edit_square' : 'location_on'"
                        />
                    </a>
                </div>
                <div class="flex-shrink-0 small text-nowrap">
                    <t t-if="this.availabilityFromLabel" t-set="pickupAvailableLabel">Pickup</t>
                    <t t-else="" t-set="pickupAvailableLabel">Pickup available</t>
                    <t t-call="website_sale_collect.StockAvailabilityMessage"
                        available="inStoreAvailable"
                        stockData="this.state.inStoreData.stock_data"
                        hasOutOfStockMessage="this.state.hasOutOfStockMessage"
                        outOfStockMessage="this.state.outOfStockMessage"
                        availabilityFromLabel="this.availabilityFromLabel"
                        availableLabel="pickupAvailableLabel"
                    />
                </div>
            </label>
            <label
                name="delivery_availability"
                t-if="Object.keys(this.state.deliveryData.stock_data || {}).length !== 0"
                class="o_wsale_collect_option d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 gap-md-3 w-100 p-3 cursor-pointer"
            >
                <input
                    type="radio"
                    class="visually-hidden"
                    name="o_wsale_collect_mode"
                    t-att-checked="!this.state.isInStoreSelected"
                    t-on-click="() => this.state.deliveryData.stock_data.in_stock ? this.selectStandardDelivery() : null"
                />
                <strong class="small">
                    <i class="oi oi-fw me-1" data-icon="local_shipping"/>
                    Shipping
                    <i
                        class="d-none d-sm-inline oi cursor-pointer ms-1"
                        data-icon="info"
                        data-tooltip="Restrictions may apply"
                        data-tooltip-delay="0"
                    />
                </strong>
                <div class="flex-shrink-0 small text-nowrap">
                    <t t-if="this.deliveryAvailabilityFromLabel" t-set="deliveryAvailableLabel">Delivery</t>
                    <t t-else="" t-set="deliveryAvailableLabel">Delivery available</t>
                    <t t-call="website_sale_collect.StockAvailabilityMessage"
                        available="this.state.deliveryData.stock_data.in_stock"
                        stockData="this.state.deliveryData.stock_data"
                        hasOutOfStockMessage="this.state.hasOutOfStockMessage"
                        outOfStockMessage="this.state.outOfStockMessage"
                        availabilityFromLabel="this.deliveryAvailabilityFromLabel"
                        availableLabel="deliveryAvailableLabel"
                    />
                </div>
            </label>
        </div>
    </t>

    <t t-name="website_sale_collect.StockAvailabilityMessage">
        <t t-if="available &amp;&amp; stockData.quantity > 0 &amp;&amp; stockData.show_quantity">
            <div class="text-warning">
                <t t-out="stockData.quantity"/> <t t-out="stockData.uom_name"/>
                in stock
            </div>
        </t>
        <div
            t-elif="hasOutOfStockMessage &amp;&amp; (!available || stockData.quantity &lt;= 0)"
            t-att-class="'text-wrap ' + (available ? 'text-success' : 'text-danger')"
        >
            <t t-out="outOfStockMessage"/>
        </div>
        <div t-elif="available" class="text-success">
            <t t-out="availableLabel"/>
            <t t-if="availabilityFromLabel"> <t t-out="availabilityFromLabel"/></t>
        </div>
        <div t-else="" class="text-danger">
            Not available
        </div>
    </t>

</templates>
