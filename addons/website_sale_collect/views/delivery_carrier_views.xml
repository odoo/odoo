<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="delivery_carrier_form" model="ir.ui.view">
        <field name="name">In-store Delivery Carrier Form</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="model">delivery.carrier</field>
        <field name="arch" type="xml">
            <field name="allow_cash_on_delivery" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </field>
            <field name="integration_level" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </field>
            <field name="invoice_policy" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </field>
            <field name="fixed_price" position="attributes">
                <attribute name="invisible">delivery_type not in ('in_house', 'in_store')</attribute>
            </field>
            <page name="pricing" position="attributes">
                <attribute name="invisible" add="delivery_type != 'in_store'" separator=" and "/>
            </page>
            <xpath expr="//field[@name='margin'][not(@groups)]" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='margin'][@groups]" position="attributes">
                <attribute name="invisible" add="delivery_type != 'in_store'" separator=" and "/>
            </xpath>
            <xpath expr="//field[@name='fixed_margin'][not(@groups)]" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='fixed_margin'][@groups]" position="attributes">
                <attribute name="invisible" add="delivery_type != 'in_store'" separator=" and "/>
            </xpath>
            <group name="country_details" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </group>
            <label for="max_weight" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </label>
            <div name="max_weight_row" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </div>
            <label for="max_volume" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </label>
            <div name="max_volume_row" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </div>
            <field name="enable_delivery_estimate" position="attributes">
                <attribute name="invisible" add="delivery_type != 'in_store'" separator=" and "/>
            </field>
            <div name="estimated_delivery_fields" position="attributes">
                <attribute name="invisible">not enable_delivery_estimate or delivery_type not in ['in_house', 'in_store']</attribute>
            </div>
            <page name="pricing" position="before">
                <page string="Stores" name="warehouses" invisible="delivery_type != 'in_store'">
                    <field name="warehouse_ids" class="o_delivery_carrier_list_no_header">
                        <list create="False">
                            <control>
                                <create string="Add a store"/>
                            </control>
                            <field name="name"/>
                        </list>
                    </field>
                </page>
            </page>
            <button name="toggle_debug" position="attributes">
                <attribute name="invisible" add="delivery_type == 'in_store'" separator=" or "/>
            </button>
        </field>
    </record>

</odoo>
