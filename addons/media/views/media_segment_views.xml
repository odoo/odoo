<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="media_segment_view_list" model="ir.ui.view">
        <field name="name">media.segment.view.list</field>
        <field name="model">media.segment</field>
        <field name="arch" type="xml">
            <list string="Media Segments">
                <field name="res_model" />
                <field name="res_id" />
                <field name="attachment_id" />
                <field name="start_ms" />
                <field name="end_ms" />
                <field name="duration_ms" />
            </list>
        </field>
    </record>

    <record id="media_segment_view_form" model="ir.ui.view">
        <field name="name">media.segment.view.form</field>
        <field name="model">media.segment</field>
        <field name="arch" type="xml">
            <form string="Media Segment">
                <sheet>
                    <group>
                        <group>
                            <field name="res_model" />
                            <field name="res_id" />
                            <field name="attachment_id" />
                            <field name="mimetype" />
                        </group>
                        <group>
                            <field name="start_ms" />
                            <field name="end_ms" />
                            <field name="duration_ms" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="media_segment_action" model="ir.actions.act_window">
        <field name="name">Media Segments</field>
        <field name="res_model">media.segment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
