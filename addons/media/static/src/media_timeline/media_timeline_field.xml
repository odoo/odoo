<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="media.MediaTimelineField">
        <div class="o_media_timeline d-flex flex-column gap-2">
            <t t-if="!segments.length">
                <div class="text-muted fst-italic" t-out="emptyMessage" />
            </t>
            <t t-else="">
                <div
                    t-if="isReleased"
                    class="text-muted fst-italic"
                    t-out="releasedMessage" />
                <video
                    t-elif="isVideo"
                    t-ref="player"
                    class="o_media_timeline_player w-100"
                    controls="1"
                    t-att-src="source"
                    t-on-timeupdate="onTimeUpdate"
                    t-on-ended="onEnded" />
                <audio
                    t-else=""
                    t-ref="player"
                    class="o_media_timeline_player w-100"
                    controls="1"
                    t-att-src="source"
                    t-on-timeupdate="onTimeUpdate"
                    t-on-ended="onEnded" />

                <div class="o_media_timeline_controls d-flex align-items-center gap-2">
                    <button
                        class="btn btn-sm btn-secondary"
                        type="button"
                        t-on-click="togglePlay">
                        <i t-att-class="state.playing ? 'fa fa-pause' : 'fa fa-play'" />
                    </button>
                    <span class="text-muted small" t-out="format(state.positionMs)" />
                    <div
                        class="o_media_timeline_bar position-relative flex-grow-1"
                        t-on-click="onBarClick">
                        <div
                            t-foreach="segments"
                            t-as="segment"
                            t-key="segment.id"
                            class="o_media_timeline_segment position-absolute"
                            t-att-style="barStyle(segment)" />
                        <div
                            class="o_media_timeline_head position-absolute"
                            t-att-style="headStyle" />
                    </div>
                    <span class="text-muted small" t-out="format(durationMs)" />
                    <button
                        class="btn btn-sm btn-link text-muted"
                        type="button"
                        t-on-click="cycleRate">
                        <t t-out="state.rate" />x
                    </button>
                </div>
            </t>
        </div>
    </t>

</templates>
