<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="service_custom_api" model="integration.service">
        <field name="name">Custom API Integration</field>
        <field name="code">custom_api</field>
        <field name="category">other</field>
        <field name="provider">Custom</field>
        <field name="endpoint_url">https://api.example.com</field>
        <field name="auth_type">bearer</field>
        <field name="health_check_enabled" eval="False" />
        <field name="description">Generic service for custom API integrations</field>
    </record>

    <record id="service_stripe" model="integration.service">
        <field name="name">Stripe Payment Gateway</field>
        <field name="code">stripe</field>
        <field name="category">payment</field>
        <field name="provider">Stripe, Inc.</field>
        <field name="website">https://stripe.com</field>
        <field name="documentation_url">https://stripe.com/docs/api</field>
        <field name="endpoint_url">https://api.stripe.com</field>
        <field name="endpoint_url_test">https://api.stripe.com</field>
        <field name="auth_type">bearer</field>
        <field name="rate_limit_requests">100</field>
        <field name="rate_limit_period">second</field>
    </record>

    <record id="service_twilio" model="integration.service">
        <field name="name">Twilio SMS</field>
        <field name="code">twilio</field>
        <field name="category">communication</field>
        <field name="provider">Twilio</field>
        <field name="website">https://www.twilio.com</field>
        <field name="documentation_url">https://www.twilio.com/docs/sms/api</field>
        <field name="endpoint_url">https://api.twilio.com</field>
        <field name="auth_type">basic</field>
    </record>

</odoo>
