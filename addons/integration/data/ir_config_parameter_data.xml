<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="config_retry_batch_size" model="ir.config_parameter">
        <field name="key">integration.retry_batch_size</field>
        <field name="value">100</field>
    </record>

    <record id="config_log_retention_days" model="ir.config_parameter">
        <field name="key">integration.log_retention_days</field>
        <field name="value">90</field>
    </record>

    <record id="config_max_cache_entries" model="ir.config_parameter">
        <field name="key">integration.max_cache_entries</field>
        <field name="value">10000</field>
    </record>

    <record id="config_max_payload_size_limit" model="ir.config_parameter">
        <field name="key">integration.max_payload_size_limit</field>
        <field name="value">104857600</field>
    </record>

    <record id="config_max_duplicate_window_seconds" model="ir.config_parameter">
        <field name="key">integration.max_duplicate_window_seconds</field>
        <field name="value">3600</field>
    </record>

    <record id="config_timestamp_future_tolerance" model="ir.config_parameter">
        <field name="key">integration.timestamp_future_tolerance</field>
        <field name="value">60</field>
    </record>

    <record id="config_allow_none_signature" model="ir.config_parameter">
        <field name="key">integration.allow_none_signature</field>
        <field name="value">False</field>
    </record>

</odoo>
