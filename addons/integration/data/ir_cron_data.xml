<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_retry_failed_events" model="ir.cron">
        <field name="name">API Communications: Retry Failed Events</field>
        <field name="model_id" ref="model_integration_exchange" />
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed_events()</field>
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">minute</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_health_check" model="ir.cron">
        <field name="name">API Communications: Service Health Check</field>
        <field name="model_id" ref="model_integration_service" />
        <field name="state">code</field>
        <field name="code">model.cron_health_check_all()</field>
        <field name="repeat_interval" eval="15" />
        <field name="repeat_unit">minute</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_reset_cache_errors" model="ir.cron">
        <field name="name">API Communications: Reset Cache Errors</field>
        <field name="model_id" ref="model_integration_service" />
        <field name="state">code</field>
        <field name="code">model.cron_reset_cache_errors()</field>
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_gc_inbound_access_logs" model="ir.cron">
        <field name="name">Credential Manager: Cleanup Old Inbound Access Logs</field>
        <field name="model_id" ref="model_inbound_access_log" />
        <field name="state">code</field>
        <field name="code">model.cron_gc_inbound_access_logs(retention_days=365)</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">week</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=7)).replace(hour=4, minute=30, second=0)" />
        <field name="priority" eval="70" />
        <field name="active" eval="True" />
    </record>

</odoo>
