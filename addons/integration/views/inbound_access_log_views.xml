<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_inbound_access_log_list" model="ir.ui.view">
        <field name="name">inbound.access.log.list</field>
        <field name="model">inbound.access.log</field>
        <field name="arch" type="xml">
            <list
                string="Inbound Access"
                create="false"
                edit="false"
                delete="false"
                decoration-bf="outcome == 'misconfigured'"
                decoration-danger="not allowed"
                decoration-warning="outcome == 'audit_accepted'">
                <field name="timestamp" />
                <field name="gate_name" />
                <field name="gate_model" optional="hide" />
                <field name="outcome" />
                <field name="source_ip" />
                <field name="attempt_count" sum="Requests" />
                <field name="status_code" optional="hide" />
                <field name="auth_type" optional="hide" />
                <field name="mode" optional="hide" />
                <field name="user_agent" optional="hide" />
                <field name="reason" optional="show" />
                <field name="last_seen_at" optional="hide" />
                <field name="allowed" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_inbound_access_log_search" model="ir.ui.view">
        <field name="name">inbound.access.log.search</field>
        <field name="model">inbound.access.log</field>
        <field name="arch" type="xml">
            <search string="Inbound Access">
                <field name="gate_name" />
                <field name="source_ip" />
                <field name="reason" />
                <filter
                    name="refused"
                    string="Refused"
                    domain="[('allowed', '=', False)]" />
                <filter
                    name="audit_accepted"
                    string="Accepted unauthenticated"
                    domain="[('outcome', '=', 'audit_accepted')]" />
                <filter
                    name="misconfigured"
                    string="Gate misconfigured"
                    help="Gates refusing every request because their own                           configuration is incomplete. Callers see a 401 and                           read it as their own credentials being wrong."
                    domain="[('outcome', '=', 'misconfigured')]" />
                <separator />
                <filter
                    name="last_day"
                    string="Last 24 hours"
                    domain="[('timestamp', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S'))]" />
                <group>
                    <filter
                        name="group_outcome"
                        string="Outcome"
                        context="{'group_by': 'outcome'}" />
                    <filter
                        name="group_source"
                        string="Source Address"
                        context="{'group_by': 'source_ip'}" />
                    <filter
                        name="group_gate"
                        string="Gate"
                        context="{'group_by': 'gate_name'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_inbound_access_log" model="ir.actions.act_window">
        <field name="name">Inbound Access</field>
        <field name="res_model">inbound.access.log</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_refused': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nothing has been refused</p>
            <p>
                Every inbound request the gate refuses is recorded here, whichever
                mechanism received it. Admitted requests appear only for endpoints
                that ask for them.
            </p>
        </field>
    </record>

</odoo>
