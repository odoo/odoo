<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_integration_exchange_search" model="ir.ui.view">
        <field name="name">integration.exchange.search</field>
        <field name="model">integration.exchange</field>
        <field name="arch" type="xml">
            <search>
                <field name="channel_name" />
                <field name="request_url" />
                <field name="trace_id" />
                <field name="error_message" />

                <filter
                    name="filter_inbound"
                    string="Inbound"
                    domain="[('direction', '=', 'inbound')]" />
                <filter
                    name="filter_outbound"
                    string="Outbound"
                    domain="[('direction', '=', 'outbound')]" />

                <separator />

                <filter
                    name="filter_success"
                    string="Success"
                    domain="[('state', '=', 'success')]" />
                <filter
                    name="filter_failed"
                    string="Failed"
                    domain="[('state', '=', 'failed')]" />
                <filter
                    name="filter_pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]" />

                <separator />

                <filter
                    name="filter_today"
                    string="Today"
                    domain="[('timestamp', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]" />
                <filter
                    name="filter_week"
                    string="This Week"
                    domain="[('timestamp', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]" />

                <group>
                    <filter
                        name="group_direction"
                        string="Direction"
                        context="{'group_by': 'direction'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_channel"
                        string="Channel"
                        context="{'group_by': 'channel_name'}" />
                    <filter
                        name="group_date"
                        string="Date"
                        context="{'group_by': 'timestamp:day'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_integration_exchange_list" model="ir.ui.view">
        <field name="name">integration.exchange.list</field>
        <field name="model">integration.exchange</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state == 'failed'"
                decoration-muted="state == 'duplicate'"
                decoration-success="state == 'success'"
                decoration-warning="state == 'pending'">
                <field name="timestamp" />
                <field name="direction" widget="badge" />
                <field name="channel_name" />
                <field name="request_method" optional="show" />
                <field name="request_endpoint" optional="show" />
                <field name="status_code" optional="show" />
                <field name="state" widget="badge" />
                <field name="duration_ms" optional="show" />
                <field name="retry_count" optional="hide" />
                <field name="error_type" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_integration_exchange_form" model="ir.ui.view">
        <field name="name">integration.exchange.form</field>
        <field name="model">integration.exchange</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_retry_now"
                        type="object"
                        string="Retry Now"
                        invisible="state not in ['failed', 'pending'] or direction != 'inbound'"
                        class="btn-primary" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,processing,success,failed" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_channel"
                            type="object"
                            icon="fa-link"
                            class="oe_stat_button">
                            <span>View Channel</span>
                        </button>
                        <button
                            name="action_view_related_events"
                            type="object"
                            icon="fa-chain"
                            invisible="not trace_id"
                            class="oe_stat_button">
                            <span>Related Events</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="direction" readonly="1" />
                            <field name="channel_id" readonly="1" />
                            <field name="channel_name" readonly="1" />
                            <field name="timestamp" readonly="1" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="1" />
                            <field name="user_id" readonly="1" />
                            <field name="credential_id" readonly="1" />
                            <field name="connection_id" readonly="1" />
                            <field
                                name="source_ip"
                                invisible="direction != 'inbound'"
                                readonly="1" />
                        </group>
                    </group>

                    <notebook>
                        <page name="request" string="Request">
                            <group invisible="direction != 'outbound'">
                                <group>
                                    <field name="request_method" readonly="1" />
                                    <field name="request_url" readonly="1" />
                                    <field name="request_endpoint" readonly="1" />
                                </group>
                                <group>
                                    <field name="request_payload_size" readonly="1" />
                                </group>
                            </group>
                            <group
                                string="Request Headers"
                                invisible="not request_headers">
                                <field
                                    name="request_headers"
                                    nolabel="1"
                                    readonly="1" />
                            </group>
                            <group string="Request Payload">
                                <field
                                    name="request_payload"
                                    nolabel="1"
                                    readonly="1" />
                            </group>
                        </page>

                        <page name="response" string="Response">
                            <group>
                                <group>
                                    <field name="status_code" readonly="1" />
                                    <field name="status_category" readonly="1" />
                                    <field name="is_success" readonly="1" />
                                </group>
                                <group>
                                    <field name="response_payload_size" readonly="1" />
                                    <field name="duration_ms" readonly="1" />
                                    <field name="performance_rating" readonly="1" />
                                </group>
                            </group>
                            <group
                                string="Response Headers"
                                invisible="not response_headers">
                                <field
                                    name="response_headers"
                                    nolabel="1"
                                    readonly="1" />
                            </group>
                            <group string="Response Payload">
                                <field
                                    name="response_payload"
                                    nolabel="1"
                                    readonly="1" />
                            </group>
                        </page>

                        <page name="error" string="Error" invisible="not error_message">
                            <group>
                                <field name="error_type" readonly="1" />
                                <field name="error_message" readonly="1" />
                            </group>
                        </page>

                        <page name="retry" string="Retry" invisible="retry_count == 0">
                            <group>
                                <field name="retry_count" readonly="1" />
                                <field name="date_next_retry" readonly="1" />
                            </group>
                        </page>

                        <page name="tracing" string="Tracing">
                            <group>
                                <group>
                                    <field name="trace_id" readonly="1" />
                                    <field name="cache_hit" readonly="1" />
                                    <field name="cache_key" readonly="1" />
                                </group>
                                <group>
                                    <field name="origin_model" readonly="1" />
                                    <field name="origin_record_id" readonly="1" />
                                    <field name="tags" readonly="1" />
                                </group>
                            </group>
                            <group>
                                <field name="date_completed" readonly="1" />
                                <field name="request_payload_hash" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_integration_exchange" model="ir.actions.act_window">
        <field name="name">Event Logs</field>
        <field name="res_model">integration.exchange</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_integration_exchange_search" />
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

</odoo>
