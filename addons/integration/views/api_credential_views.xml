<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_api_credential_search" model="ir.ui.view">
        <field name="name">credential.credential.api.search</field>
        <field name="model">credential.credential</field>
        <field name="arch" type="xml">
            <search string="Search API Credentials">
                <field name="name" />
                <field name="endpoint_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="expired"
                    string="Expired"
                    domain="[('is_expired', '=', True)]" />
                <filter
                    name="expiring_soon"
                    string="Expiring Soon"
                    domain="[('date_expiration', '&gt;', 'today'), ('date_expiration', '&lt;=', 'today +30d')]" />
                <separator />
                <filter
                    name="env_test"
                    string="Test"
                    domain="[('environment', '=', 'test')]" />
                <filter
                    name="env_staging"
                    string="Staging"
                    domain="[('environment', '=', 'staging')]" />
                <filter
                    name="env_production"
                    string="Production"
                    domain="[('environment', '=', 'production')]" />
                <group>
                    <filter
                        name="group_service"
                        string="Service"
                        context="{'group_by': 'endpoint_id'}" />
                    <filter
                        name="group_environment"
                        string="Environment"
                        context="{'group_by': 'environment'}" />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_api_credential_list" model="ir.ui.view">
        <field name="name">credential.credential.api.list</field>
        <field name="model">credential.credential</field>
        <field name="arch" type="xml">
            <list string="API Credentials">
                <field name="name" />
                <field name="endpoint_id" />
                <field name="environment" />
                <field name="last_used_at" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_api_credential_form" model="ir.ui.view">
        <field name="name">credential.credential.api.form</field>
        <field name="model">credential.credential</field>
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <form string="API Credential">
                <sheet>
                    <field name="category_code" invisible="1" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_id" />
                            <field name="category_id" required="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="environment" />
                            <field name="active" />
                        </group>
                    </group>

                    <notebook>
                        <page name="credentials_simple" string="Credentials">
                            <group>
                                <group
                                    name="group_api_auth"
                                    string="API Authentication"
                                    invisible="category_code in ('basic_auth', 'ehome', 'certificate')">
                                    <field name="api_key" password="True" />
                                    <field name="api_secret" password="True" />
                                    <field name="bearer_token" password="True" />
                                </group>
                                <group
                                    name="group_basic_auth"
                                    string="Basic Authentication"
                                    invisible="category_code in ('api_key', 'bearer_token', 'aws_iam', 'ehome', 'certificate')">
                                    <field name="username" />
                                    <field name="password" password="True" />
                                </group>
                            </group>
                            <group invisible="category_code != 'ehome'">
                                <group string="EHOME Connection">
                                    <field
                                        name="api_key"
                                        string="Device ID"
                                        placeholder="e.g. DSK1T341C001"
                                        required="category_code == 'ehome'" />
                                </group>
                                <group>
                                    <field
                                        name="api_secret"
                                        string="API URL"
                                        placeholder="http://localhost:8085"
                                        required="category_code == 'ehome'" />
                                </group>
                            </group>
                        </page>

                        <page
                            name="credentials_advanced"
                            string="Advanced (JSON)"
                            groups="credential.group_credential_admin">
                            <div
                                class="alert alert-info"
                                role="alert"
                                style="margin: 16px;">
                                <strong>Power User Mode:</strong> Edit credentials directly as JSON.
                                This provides maximum flexibility for complex credential structures.
                                Changes made here will automatically sync with the Simple tab
                                fields. </div>
                            <group>
                                <field
                                    name="credential_data"
                                    placeholder="{&quot;api_key&quot;: &quot;your-key-here&quot;, &quot;api_secret&quot;: &quot;your-secret-here&quot;, &quot;custom_field&quot;: &quot;any-value&quot;}"
                                    help="JSON format required. Example: {'api_key': 'value', 'api_secret': 'value'}" />
                            </group>
                            <div
                                style="margin: 16px; padding: 12px; background: #f8f9fa; border-left: 4px solid #007bff;">
                                <strong>Supported Fields:</strong>
                                <ul style="margin: 8px 0; padding-left: 20px;">
                                    <li><code>api_key</code> - API Key for authentication</li>
                                    <li><code>api_secret</code> - API Secret</li>
                                    <li><code>bearer</code> - Bearer Token</li>
                                    <li><code>username</code> - Username for Basic Auth</li>
                                    <li><code>password</code> - Password for Basic Auth</li>
                                    <li><code>oauth_access_token</code> - OAuth Access Token</li>
                                    <li><code>oauth_refresh_token</code> - OAuth Refresh Token</li>
                                    <li><code>oauth_client_id</code> - OAuth Client ID</li>
                                    <li><code>oauth_client_secret</code> - OAuth Client Secret</li>
                                    <li>Add any custom fields as needed</li>
                                </ul>
                            </div>
                        </page>

                        <page name="additional" string="Additional Settings">
                            <group>
                                <group string="Headers &amp; Metadata">
                                    <field
                                        name="custom_headers"
                                        placeholder="{&quot;X-Custom-Header&quot;: &quot;value&quot;, &quot;X-API-Version&quot;: &quot;v1&quot;}"
                                        help="Custom HTTP headers in JSON format" />
                                </group>
                                <group string="Expiration">
                                    <field name="date_expiration" />
                                    <field name="is_expired" />
                                    <field name="days_until_expiry" />
                                </group>
                            </group>
                        </page>

                        <page name="stats" string="Usage Statistics">
                            <group>
                                <group string="Usage Tracking">
                                    <field name="last_used_at" />
                                    <field name="last_validated" />
                                    <field name="usage_count" />
                                </group>
                                <group string="Performance">
                                    <field name="success_count" />
                                    <field name="error_count" />
                                    <field name="success_rate" widget="progressbar" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_credential_form_oauth" model="ir.ui.view">
        <field name="name">credential.credential.api.form.oauth</field>
        <field name="model">credential.credential</field>
        <field name="inherit_id" ref="view_api_credential_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_code']" position="after">
                <field name="endpoint_auth_type" invisible="1" />
            </xpath>

            <xpath expr="//form/sheet" position="before">
                <header groups="credential.group_credential_admin">
                    <button
                        name="action_oauth_authorize"
                        type="object"
                        string="Authorize with OAuth"
                        help="Initiate OAuth 2.0 authorization flow to obtain access tokens"
                        invisible="endpoint_auth_type != 'oauth2' or oauth_access_token"
                        class="btn-primary" />
                    <button
                        name="action_oauth_reauthorize"
                        type="object"
                        string="Re-authorize"
                        help="Clear existing tokens and restart OAuth authorization"
                        invisible="endpoint_auth_type != 'oauth2' or not oauth_access_token"
                        class="btn-secondary" />
                </header>
            </xpath>

            <xpath
                expr="//page[@name='credentials_simple']//group[@name='group_basic_auth']"
                position="after">
                <group string="OAuth 2.0" invisible="endpoint_auth_type != 'oauth2'">
                    <field
                        name="oauth_client_id"
                        help="OAuth client ID issued by the provider (optional if set on the service)" />
                    <field
                        name="oauth_client_secret"
                        help="OAuth client secret used during the token exchange"
                        password="True" />
                    <field
                        name="oauth_access_token"
                        help="OAuth access token obtained via authorization flow"
                        password="True"
                        readonly="True" />
                    <field
                        name="oauth_refresh_token"
                        help="OAuth refresh token for obtaining new access tokens"
                        password="True"
                        readonly="True" />
                    <field
                        name="oauth_token_date_expiration"
                        help="When the OAuth access token expires"
                        readonly="True" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_api_credential" model="ir.actions.act_window">
        <field name="name">API Credentials</field>
        <field name="res_model">credential.credential</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_api_credential_search" />
        <field name="domain">[('endpoint_id', '!=', False)]</field>
        <field name="context">{'default_environment': 'test'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first API credential
            </p>
            <p>
                API credentials provide secure authentication for external services.
                Link them to an API service to enable API calls.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'list', 'view_id': ref('view_api_credential_list')}), Command.create({'view_mode': 'form', 'view_id': ref('view_api_credential_form')})]" />
    </record>

</odoo>
