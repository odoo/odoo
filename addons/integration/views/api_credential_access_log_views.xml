<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_api_credential_access_log_search" model="ir.ui.view">
        <field name="name">credential.access.log.api.search</field>
        <field name="model">credential.access.log</field>
        <field name="arch" type="xml">
            <search string="Search Credential Access Logs">
                <field name="credential_id" />
                <field name="user_id" />
                <field name="service_name" />
                <field name="source_ip" />

                <filter
                    name="failed_access"
                    string="Failed Access"
                    domain="[('success', '=', False)]" />
                <filter
                    name="successful_access"
                    string="Successful Access"
                    domain="[('success', '=', True)]" />

                <separator />
                <filter
                    name="op_read"
                    string="Read"
                    domain="[('operation', '=', 'read')]" />
                <filter
                    name="op_write"
                    string="Write"
                    domain="[('operation', '=', 'write')]" />
                <filter
                    name="op_use"
                    string="Use"
                    domain="[('operation', '=', 'use')]" />
                <filter
                    name="op_validate"
                    string="Validate"
                    domain="[('operation', '=', 'validate')]" />

                <separator />
                <filter
                    name="today"
                    string="Today"
                    domain="[('timestamp', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),                              ('timestamp', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]" />
                <filter
                    name="last_7_days"
                    string="Last 7 Days"
                    domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]" />
                <filter
                    name="last_30_days"
                    string="Last 30 Days"
                    domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]" />

                <group>
                    <filter
                        name="group_credential"
                        string="Credential"
                        context="{'group_by': 'credential_id'}" />
                    <filter
                        name="group_user"
                        string="User"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="group_operation"
                        string="Operation"
                        context="{'group_by': 'operation'}" />
                    <filter
                        name="group_service"
                        string="Service"
                        context="{'group_by': 'service_name'}" />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                    <filter
                        name="group_date"
                        string="Access Date"
                        context="{'group_by': 'timestamp:day'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_api_credential_access_log_list" model="ir.ui.view">
        <field name="name">credential.access.log.api.list</field>
        <field name="model">credential.access.log</field>
        <field name="inherit_id" ref="credential.view_credential_access_log_list" />
        <field name="arch" type="xml">
            <field name="credential_id" position="after">
                <field name="service_name" optional="show" />
            </field>
            <field name="operation" position="after">
                <field name="field_accessed" optional="hide" />
                <field name="success" widget="boolean_toggle" />
            </field>
        </field>
    </record>

    <record id="view_api_credential_access_log_pivot" model="ir.ui.view">
        <field name="name">credential.access.log.api.pivot</field>
        <field name="model">credential.access.log</field>
        <field name="arch" type="xml">
            <pivot string="Credential Access Analysis">
                <field name="service_name" type="row" />
                <field name="operation" type="col" />
            </pivot>
        </field>
    </record>

    <record id="view_api_credential_access_log_graph" model="ir.ui.view">
        <field name="name">credential.access.log.api.graph</field>
        <field name="model">credential.access.log</field>
        <field name="arch" type="xml">
            <graph type="line" string="Credential Access Trends">
                <field name="timestamp" interval="day" />
            </graph>
        </field>
    </record>

    <record id="view_api_credential_access_log_form" model="ir.ui.view">
        <field name="name">credential.access.log.api.form</field>
        <field name="model">credential.access.log</field>
        <field name="arch" type="xml">
            <form string="Credential Access Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group name="credential_info" string="Credential Information">
                            <field name="credential_id" />
                            <field name="service_name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                        <group name="access_info" string="Access Information">
                            <field name="timestamp" widget="datetime" />
                            <field name="user_id" />
                            <field name="operation" />
                            <field name="field_accessed" />
                            <field name="success" />
                        </group>
                    </group>
                    <group name="context_info" string="Context Information">
                        <field name="source_ip" />
                    </group>
                    <group
                        name="failure_info"
                        string="Failure Information"
                        invisible="success">
                        <field name="failure_reason" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_credential_access_log" model="ir.actions.act_window">
        <field name="name">API Credential Access Logs</field>
        <field name="res_model">credential.access.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_api_credential_access_log_search" />
        <field name="domain">[('credential_id.endpoint_id', '!=', False)]</field>
        <field name="context">{'search_default_last_30_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credential access logs yet
            </p>
            <p>
                This view shows all access to API credentials for security auditing.
                Access logs are automatically created when credentials are viewed, edited, or used.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'list', 'view_id': ref('credential.view_credential_access_log_list')}), Command.create({'view_mode': 'form', 'view_id': ref('view_api_credential_access_log_form')}), Command.create({'view_mode': 'pivot', 'view_id': ref('view_api_credential_access_log_pivot')}), Command.create({'view_mode': 'graph', 'view_id': ref('view_api_credential_access_log_graph')})]" />
    </record>

    <record id="action_api_credential_security_report" model="ir.actions.act_window">
        <field name="name">API Credential Security Report</field>
        <field name="res_model">credential.access.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('credential_id.endpoint_id', '!=', False)]</field>
        <field
            name="context">{'search_default_last_30_days': 1, 'search_default_failed_access': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No suspicious access detected
            </p>
            <p>
                This report shows failed credential access attempts and suspicious patterns.
            </p>
        </field>
    </record>

</odoo>
