<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_integration_exchange_company" model="ir.rule">
        <field name="name">Event Log: Company isolation</field>
        <field name="model_id" ref="model_integration_exchange" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_api_transport_user'))]" />
    </record>

    <record id="rule_integration_service_read" model="ir.rule">
        <field name="name">Outbound Service: Global read</field>
        <field name="model_id" ref="model_integration_service" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_api_transport_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_integration_receiver_company" model="ir.rule">
        <field name="name">Receiver: Company isolation</field>
        <field name="model_id" ref="model_integration_receiver" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[Command.link(ref('group_api_transport_user'))]" />
    </record>

    <record id="rule_integration_connection_company" model="ir.rule">
        <field name="name">Connection: Company isolation</field>
        <field name="model_id" ref="model_integration_connection" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="groups" eval="[Command.link(ref('group_api_transport_user'))]" />
    </record>

    <record id="rule_integration_response_cache_company" model="ir.rule">
        <field name="name">Response Cache: Company isolation</field>
        <field name="model_id" ref="model_integration_response_cache" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_api_transport_user'))]" />
    </record>

</odoo>
