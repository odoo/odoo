<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- equiment.order: views -->
    <record id="maintenance_order_view_search" model="ir.ui.view">
        <field name="name">equipment.order.search</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <search string="Maintenance Order Search">
                <field name="name" string="Order" />
                <field name="user_id" />
                <field name="resource_ids" />
                <field name="asset_ids" />
                <field name="create_uid" string="Requested By" />
                <field name="state" />
                <field name="maintenance_team_id" />
                <filter
                    name="my_maintenances"
                    string="My Maintenances"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter
                    name="todo"
                    string="To Do"
                    domain="[('state', 'in', ('draft', 'confirmed', 'in_progress'))]" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <filter
                    name="progress"
                    string="In Progress"
                    domain="[('state', '=', 'in_progress')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <separator />
                <filter
                    name="kanban_state_block"
                    string="Blocked"
                    domain="[('state', 'in', ('draft', 'confirmed', 'in_progress')), ('kanban_state', '=', 'blocked')]" />
                <filter
                    name="ready"
                    string="Ready"
                    domain="[('state', 'in', ('draft', 'confirmed', 'in_progress')), ('kanban_state', '=', 'done')]" />
                <separator />
                <filter
                    name="high_priority"
                    string="High-priority"
                    domain="[('state', 'in', ('draft', 'confirmed', 'in_progress')), ('priority', '=', '3')]" />
                <separator />
                <filter
                    name="unscheduled"
                    string="Unscheduled"
                    domain="[('state', 'in', ('draft', 'confirmed', 'in_progress')), ('date_scheduled_start', '=', False)]" />
                <separator />
                <filter name="filter_date_confirmed" date="date_confirmed" />
                <filter
                    name="filter_date_scheduled_start"
                    date="date_scheduled_start" />
                <filter name="filter_date_done" date="date_done" />
                <separator />
                <filter
                    name="message_needaction"
                    string="Unread Messages"
                    domain="[('message_needaction', '=', True)]"
                    groups="mail.group_mail_notification_type_inbox" />
                <separator />
                <filter
                    name="filter_activities_my"
                    string="My Activities"
                    domain="[('activity_user_id', '=', uid)]"
                    invisible="1" />
                <separator invisible="1" />
                <filter
                    name="activities_overdue"
                    string="Late Activities"
                    help="Show all records whose next activity date is past"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                    invisible="1" />
                <filter
                    name="activities_today"
                    string="Today Activities"
                    domain="[('my_activity_date_deadline', '=', 'today')]"
                    invisible="1" />
                <filter
                    name="activities_upcoming_all"
                    string="Future Activities"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                    invisible="1" />
                <separator />
                <filter
                    name="active"
                    string="Not Cancelled"
                    domain="[('state', '!=', 'cancel')]" />
                <filter
                    name="inactive"
                    string="Cancelled"
                    domain="[('state', '=', 'cancel')]" />
                <group>
                    <filter
                        name="assigned"
                        string="Assigned to"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="states"
                        string="Status"
                        context="{'group_by' : 'state'}" />
                    <filter
                        name="created_by"
                        string="Created By"
                        context="{'group_by': 'create_uid'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="maintenance_order_view_activity" model="ir.ui.view">
        <field name="name">maintenance.order.view.activity</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <activity string="Maintenance Order">
                <field name="user_id" />
                <templates>
                    <div t-name="activity-box">
                        <field
                            name="user_id"
                            widget="many2one_avatar_user"
                            domain="[('share', '=', False)]" />
                        <div class="flex-grow-1 d-block">
                            <div class="d-flex justify-content-between">
                                <field
                                    name="name"
                                    display="full"
                                    class="o_text_block o_text_bold" />
                            </div>
                            <field
                                name="resource_ids"
                                widget="many2many_tags"
                                class="o_text_block"
                                muted="1" />
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="maintenance_order_view_form" model="ir.ui.view">
        <field name="name">equipment.order.form</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <form string="Maintenance Order">
                <field name="company_id" invisible="1" />
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        invisible="state != 'draft'"
                        class="btn-primary" />
                    <button
                        name="action_start"
                        type="object"
                        string="Start"
                        invisible="state != 'confirmed'"
                        class="btn-primary" />
                    <button
                        name="action_done"
                        type="object"
                        string="Done"
                        invisible="state not in ('confirmed', 'in_progress')"
                        class="btn-primary" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ('done', 'cancel')" />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state not in ('confirmed', 'cancel')" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,in_progress,done" />
                </header>
                <sheet>
                    <div invisible="state != 'cancel'">
                        <span class="badge text-bg-warning float-end">Cancelled</span>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_flagged_parts"
                            type="object"
                            icon="fa-flag"
                            invisible="not part_flagged_count"
                            class="oe_stat_button text-danger">
                            <field
                                name="part_flagged_count"
                                string="Flagged Parts"
                                widget="statinfo" />
                        </button>
                    </div>
                    <field name="kanban_state" widget="state_selection" />
                    <div class="oe_title">
                        <label for="name" string="Order" />
                        <h1>
                            <field name="name" placeholder="e.g. Screen not working" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="resource_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}" />
                            <field name="block_resource" invisible="not resource_ids" />
                            <field
                                name="schedule_overlap_count"
                                invisible="not resource_ids or not schedule_overlap_count" />
                            <field
                                name="date_confirmed"
                                invisible="not date_confirmed"
                                readonly="True" />
                            <field
                                name="date_done"
                                invisible="state != 'done'"
                                readonly="True" />
                            <field name="maintenance_type" widget="radio" />
                        </group>
                        <group>
                            <field
                                name="maintenance_team_id"
                                options="{'no_create': True, 'no_open': True}" />
                            <field name="user_id" string="Responsible" />
                            <field name="vendor_id" />
                            <field name="date_scheduled_start" />
                            <field name="date_scheduled_end" />
                            <field
                                name="plan_id"
                                invisible="maintenance_type == 'corrective'" />
                            <field name="date_plan_slot" invisible="not plan_id" />
                            <field name="priority" widget="priority" />
                            <field
                                name="email_cc"
                                string="Email cc"
                                groups="base.group_no_one" />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="description" placeholder="Internal Notes" />
                        </page>
                        <page name="parts" string="Parts">
                            <field name="asset_ids" invisible="1" />
                            <field
                                name="part_ids"
                                context="{'default_vendor_id': vendor_id, 'default_source': 'maintenance'}"
                                readonly="state in ('done', 'cancel')">
                                <list
                                    editable="bottom"
                                    decoration-danger="review_state == 'flagged'">
                                    <field
                                        name="asset_id"
                                        domain="[('id', 'in', parent.asset_ids)]"
                                        options="{'no_create': True}"
                                        readonly="state != 'draft'" />
                                    <field name="kind_id" column_invisible="True" />
                                    <field
                                        name="position_id"
                                        options="{'no_create': True}"
                                        readonly="state != 'draft'" />
                                    <field
                                        name="product_id"
                                        readonly="state != 'draft'" />
                                    <field name="serial" readonly="state != 'draft'" />
                                    <field name="removed_serial" />
                                    <field name="removed_returned" />
                                    <field
                                        name="vendor_id"
                                        optional="hide"
                                        readonly="state != 'draft'" />
                                    <field
                                        name="warranty_date"
                                        optional="hide"
                                        readonly="state != 'draft'" />
                                    <field
                                        name="warranty_meter"
                                        optional="hide"
                                        readonly="state != 'draft'" />
                                    <field
                                        name="amount"
                                        optional="show"
                                        readonly="state != 'draft'" />
                                    <field name="currency_id" column_invisible="True" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        optional="show" />
                                    <field
                                        name="review_state"
                                        widget="badge"
                                        decoration-danger="review_state == 'flagged'"
                                        decoration-success="review_state == 'cleared'" />
                                </list>
                            </field>
                        </page>
                        <page string="Instructions">
                            <group col="1">
                                <field
                                    name="instruction_type"
                                    widget="radio"
                                    nolabel="1" />
                                <field
                                    name="instruction_pdf"
                                    help="Upload your PDF file."
                                    widget="pdf_viewer"
                                    nolabel="1"
                                    invisible="instruction_type != 'pdf'"
                                    required="instruction_type == 'pdf'" />
                                <field
                                    name="instruction_google_slide"
                                    placeholder="Google Slide Link"
                                    widget="google_slide_viewer"
                                    nolabel="1"
                                    invisible="instruction_type != 'google_slide'"
                                    required="instruction_type == 'google_slide'" />
                                <field
                                    name="instruction_text"
                                    placeholder="Your instructions"
                                    nolabel="1"
                                    invisible="instruction_type != 'text'" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="maintenance_order_view_kanban" model="ir.ui.view">
        <field name="name">equipment.order.kanban</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                sample="1"
                highlight_color="color"
                records_draggable="0">
                <progressbar
                    field="kanban_state"
                    colors="{&quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}" />
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit...</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <field name="color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5" />
                        <span name="create_uid" t-if="record.create_uid.raw_value">Requested by: <field name="create_uid" /></span>
                        <field name="resource_ids" widget="many2many_tags" />
                        <field name="date_scheduled_start" />
                        <footer>
                            <div class="d-flex">
                                <field name="priority" widget="priority" />
                                <field
                                    name="activity_ids"
                                    widget="kanban_activity"
                                    class="ms-3" />
                            </div>
                            <div class="d-flex ms-auto align-items-center">
                                <div
                                    class="badge text-bg-warning float-end"
                                    invisible="state != 'cancel'">
                                    Cancelled
                                </div>
                                <field
                                    name="kanban_state"
                                    widget="state_selection"
                                    class="ms-1" />
                                <field
                                    name="user_id"
                                    widget="many2one_avatar_user"
                                    class="ms-1" />
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="maintenance_order_view_list" model="ir.ui.view">
        <field name="name">equipment.order.list</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <list string="Maintenance Order" multi_edit="1" sample="1">
                <field name="message_needaction" column_invisible="True" />
                <field name="name" />
                <field name="date_confirmed" groups="base.group_no_one" />
                <field name="create_uid" string="Requested By" />
                <field name="user_id" />
                <field name="resource_ids" widget="many2many_tags" optional="show" />
                <field name="state" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    readonly="1" />
                <field
                    name="activity_exception_decoration"
                    widget="activity_exception" />
            </list>
        </field>
    </record>

    <record id="maintenance_order_view_graph" model="ir.ui.view">
        <field name="name">equipment.order.graph</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Order" sample="1">
                <field name="user_id" />
                <field name="state" />
                <field name="duration" type="measure" />
                <field name="color" type="measure" invisible="1" />
            </graph>
        </field>
    </record>

    <record id="maintenance_order_view_pivot" model="ir.ui.view">
        <field name="name">equipment.order.pivot</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Order" sample="1">
                <field name="user_id" />
                <field name="state" />
                <field name="color" invisible="1" />
            </pivot>
        </field>
    </record>

    <record id="maintenance_order_view_calendar" model="ir.ui.view">
        <field name="name">equipment.order.calendar</field>
        <field name="model">maintenance.order</field>
        <field name="arch" type="xml">
            <calendar
                color="user_id"
                date_start="date_scheduled_start"
                date_stop="date_scheduled_end"
                event_limit="5"
                js_class="calendar_with_recurrence">
                <field name="user_id" filters="1" />
                <field name="priority" />
                <field name="maintenance_type" />
                <field name="plan_id" invisible="1" />
                <field name="state" invisible="1" />
                <field name="duration" invisible="1" />
            </calendar>
        </field>
    </record>

    <!-- equiment.order: actions -->
    <record id="maintenance_order_action" model="ir.actions.act_window">
        <field name="name">Maintenance Orders</field>
        <field name="res_model">maintenance.order</field>
        <field name="path">maintenance-orders</field>
        <field name="view_mode">kanban,list,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="maintenance_order_view_kanban" />
        <field
            name="context">{
            'search_default_active': True,
            'default_user_id': uid
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new maintenance order
            </p><p>
                Follow the process of the order and communicate with the collaborator.
            </p>
        </field>
    </record>

    <record id="maintenance_order_action_from_dashboard" model="ir.actions.act_window">
        <field name="name">Maintenance Orders</field>
        <field name="res_model">maintenance.order</field>
        <field name="view_mode">kanban,list,form,pivot,graph,calendar,activity</field>
        <field
            name="domain">[('maintenance_team_id', '=', active_id), ('maintenance_type', 'in', context.get('maintenance_type', ['preventive', 'corrective']))]</field>
        <field
            name="context">{
            'search_default_active': True,
            'search_default_maintenance_team_id': active_id,
            'default_maintenance_team_id': active_id,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new maintenance order
            </p><p>
                Follow the process of the order and communicate with the collaborator.
            </p>
        </field>
    </record>

    <record id="maintenance_order_action_cal" model="ir.actions.act_window">
        <field name="name">Maintenance Orders</field>
        <field name="res_model">maintenance.order</field>
        <field name="path">maintenance-calendar</field>
        <field name="view_mode">calendar,kanban,list,form,pivot,graph,activity</field>
        <field name="view_id" ref="maintenance_order_view_calendar" />
        <field
            name="context">{
            'search_default_active': True,
            'search_default_todo': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new maintenance order
            </p><p>
                Follow the process of the order and communicate with the collaborator.
            </p>
        </field>
    </record>

    <record id="maintenance_order_action_reports" model="ir.actions.act_window">
        <field name="name">Maintenance Orders Analysis</field>
        <field name="res_model">maintenance.order</field>
        <field name="path">maintenance-orders-analysis</field>
        <field name="view_mode">graph,pivot,kanban,list,form,calendar,activity</field>
        <field
            name="context">{
            'search_default_active': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new maintenance order
            </p><p>
                Follow the process of the order and communicate with the collaborator.
            </p>
        </field>
    </record>

    <record id="team_view_search_maintenance" model="ir.ui.view">
        <field name="name">team.team.view.search.maintenance</field>
        <field name="model">team.team</field>
        <field name="inherit_id" ref="team.team_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//separator[@name='usages']" position="before">
                <filter
                    name="use_maintenance"
                    string="Maintenance"
                    domain="[('use_maintenance', '=', True)]" />
            </xpath>
        </field>
    </record>

    <record id="team_view_form_maintenance" model="ir.ui.view">
        <field name="name">team.team.view.form.maintenance</field>
        <field name="model">team.team</field>
        <field name="inherit_id" ref="team.team_view_form" />
        <field name="arch" type="xml">
            <div name="usages" position="inside">
                <span class="d-inline-flex">
                    <field name="use_maintenance" />
                    <label for="use_maintenance" />
                </span>
            </div>
            <group name="left" position="inside">
                <label
                    for="maintenance_alias_name"
                    string="Maintenance Alias"
                    invisible="not use_maintenance" />
                <div name="maintenance_alias_def" invisible="not use_maintenance">
                    <field
                        name="maintenance_alias_id"
                        string="Maintenance Alias"
                        class="oe_read_only oe_inline" />
                    <div
                        class="oe_edit_only oe_inline"
                        name="edit_maintenance_alias"
                        dir="ltr">
                        <field name="maintenance_alias_name" placeholder="alias" class="oe_inline" />@
                        <field
                            name="maintenance_alias_domain_id"
                            placeholder="e.g. mycompany.com"
                            options="{'no_create': True, 'no_open': True}"
                            class="oe_inline" />
                    </div>
                </div>
            </group>
        </field>
    </record>

    <record id="maintenance_team_kanban" model="ir.ui.view">
        <field name="name">team.team.kanban.maintenance.dashboard</field>
        <field name="model">team.team</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <kanban
                create="0"
                class="o_maintenance_team_kanban"
                can_open="0"
                highlight_color="color">
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-6">
                                    <h5
                                        role="menuitem"
                                        class="o_kanban_card_manage_title">
                                        <span>Orders</span>
                                    </h5>
                                    <div role="menuitem">
                                        <a
                                            name="%(maintenance_order_action_from_dashboard)d"
                                            type="action">
                                            All
                                        </a>
                                    </div>
                                    <div role="menuitem">
                                        <a
                                            name="%(maintenance_order_action_from_dashboard)d"
                                            type="action"
                                            context="{'search_default_todo': 1}">
                                            To Do
                                        </a>
                                    </div>
                                    <div role="menuitem">
                                        <a
                                            name="%(maintenance_order_action_from_dashboard)d"
                                            type="action"
                                            context="{'search_default_progress': 1}">
                                            In Progress
                                        </a>
                                    </div>
                                    <div role="menuitem">
                                        <a
                                            name="%(maintenance_order_action_from_dashboard)d"
                                            type="action"
                                            context="{'search_default_done': 1}">
                                            Done
                                        </a>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <h5
                                        role="menuitem"
                                        class="o_kanban_card_manage_title">
                                        <span>Reporting</span>
                                    </h5>
                                    <div role="menuitem">
                                        <a
                                            name="%(maintenance_order_action_reports)d"
                                            type="action"
                                            context="{'search_default_maintenance_team_id': id}">
                                        Maintenance Orders
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div
                                t-if="widget.editable"
                                class="o_kanban_card_manage_settings row">
                                <div class="col-8" role="menuitem" aria-haspopup="true">
                                    <field name="color" widget="kanban_color_picker" />
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a type="open" class="dropdown-item">Configuration</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <a
                            name="%(maintenance_order_action_from_dashboard)d"
                            type="action">
                            <field name="name" class="fw-bold fs-4 ms-2" />
                        </a>
                        <div class="row g-0 mt-3 ms-2 pb-4">
                            <div class="col-6">
                                <button
                                    name="%(maintenance_order_action_from_dashboard)d"
                                    type="action"
                                    context="{'search_default_todo': 1}"
                                    class="btn btn-primary">
                                    <field name="maintenance_todo_order_count" /> To Do
                                </button>
                            </div>
                            <div class="col-6">
                                <a
                                    t-if="record.maintenance_todo_order_count_scheduled.raw_value &gt; 0"
                                    name="%(maintenance_order_action_cal)d"
                                    type="action"
                                    context="{'search_default_todo': 1, 'search_default_maintenance_team_id': id}"
                                    class="d-block">
                                    <field
                                        name="maintenance_todo_order_count_scheduled" />
                                    Scheduled
                                </a>
                                <a
                                    t-if="record.maintenance_todo_order_count_high_priority.raw_value &gt; 0"
                                    name="%(maintenance_order_action_from_dashboard)d"
                                    type="action"
                                    context="{'search_default_high_priority': 1}"
                                    class="d-block">
                                    <field
                                        name="maintenance_todo_order_count_high_priority" />
                                    Top Priorities
                                </a>
                                <a
                                    t-if="record.maintenance_todo_order_count_block.raw_value &gt; 0"
                                    name="%(maintenance_order_action_from_dashboard)d"
                                    type="action"
                                    context="{'search_default_kanban_state_block': 1}"
                                    class="d-block">
                                    <field name="maintenance_todo_order_count_block" />
                                    Blocked
                                </a>
                                <a
                                    t-if="record.maintenance_todo_order_count_unscheduled.raw_value &gt; 0"
                                    name="%(maintenance_order_action_from_dashboard)d"
                                    type="action"
                                    context="{'search_default_todo': 1, 'search_default_unscheduled': 1}"
                                    class="d-block">
                                    <field
                                        name="maintenance_todo_order_count_unscheduled" />
                                    Unscheduled
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="maintenance_team_action_settings" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">team.team</field>
        <field name="path">maintenance-teams</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('use_maintenance', '=', True)]</field>
        <field name="context">{'default_use_maintenance': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a team in the maintenance order
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'list', 'view_id': ref('team.team_view_tree')}), Command.create({'view_mode': 'kanban', 'view_id': ref('team.team_view_kanban')})]" />
    </record>

    <record id="maintenance_dashboard_action" model="ir.actions.act_window">
        <field name="name">Maintenance Teams</field>
        <field name="res_model">team.team</field>
        <field name="path">maintenance</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="maintenance_team_kanban" />
        <field name="domain">[('use_maintenance', '=', True)]</field>
        <field name="context">{'default_use_maintenance': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new maintenance team
            </p>
        </field>
    </record>

</odoo>
