<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='anchor_personal']" position="before">
                <page
                    name="personal_information_page"
                    string="Private Information"
                    groups="base.group_partner_manager"
                    invisible="is_company">
                    <group name="personal_information_columns">
                        <group name="personal_information_group">
                            <field name="gender" />
                            <field name="birthdate" />
                            <field name="age" invisible="not birthdate" />
                        </group>
                        <group name="personal_classification_group">
                            <field name="age_range_id" invisible="not birthdate" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.view.search.inherit.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <filter name="without_address" position="after">
                <filter
                    name="without_birthdate"
                    string="Without Birthdate"
                    domain="[('birthdate', '=', False)]" />
                <separator />
                <filter
                    name="birthday_today"
                    string="Birthday Today"
                    domain="[('birthdate.month_number', '=', context_today().month), ('birthdate.day_of_month', '=', context_today().day)]" />
                <filter
                    name="birthday_this_month"
                    string="Birthday This Month"
                    domain="[('birthdate.month_number', '=', context_today().month)]" />
            </filter>
            <filter name="group_country" position="after">
                <filter
                    name="group_age_range"
                    string="Age Range"
                    context="{'group_by': 'age_range_id'}" />
                <filter
                    name="group_birthday_month"
                    string="Birthday Month"
                    context="{'group_by': 'birthdate:month_number'}" />
            </filter>
            <field name="tag_ids" position="after">
                <field name="age" />
                <field name="age_range_id" />
            </field>
        </field>
    </record>

    <record id="action_partner" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">res.partner</field>
        <field name="path">contacts</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="base.view_res_partner_filter" />
        <field name="domain">[('is_bank', '=', False)]</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Contact in your address book
            </p><p>
                Odoo helps you track all activities related to your contacts.
            </p>
        </field>
    </record>

    <record id="action_partner_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="base.res_partner_kanban_view" />
        <field name="act_window_id" ref="action_partner" />
    </record>

    <record id="action_partner_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="0" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="base.view_partner_tree" />
        <field name="act_window_id" ref="action_partner" />
    </record>

    <record id="action_partner_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form" />
        <field name="act_window_id" ref="action_partner" />
    </record>

</odoo>
