<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="tax_report_vat" model="account.report">
        <field name="name">VAT Return (PR PDV-2)</field>
        <field name="name@sr@latin">Prijava za obračun PDV (PR PDV-2)</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.me"/>
        <field name="allow_foreign_vat" eval="True"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="tax_report_vat_balance" model="account.report.column">
                <field name="name">Amount</field>
                <field name="name@sr@latin">Iznos</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="tax_report_line_10" model="account.report.line">
                <field name="name">10 - Taxable supplies at 21%</field>
                <field name="name@sr@latin">10 - Oporezivi promet po stopi od 21%</field>
                <field name="code">ME_10</field>
                <field name="expression_ids">
                    <record id="tax_report_line_10_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-10</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_11" model="account.report.line">
                <field name="name">11 - Taxable supplies at 15%</field>
                <field name="name@sr@latin">11 - Oporezivi promet po stopi od 15%</field>
                <field name="code">ME_11</field>
                <field name="expression_ids">
                    <record id="tax_report_line_11_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-11</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_12" model="account.report.line">
                <field name="name">12 - Taxable supplies at 7%</field>
                <field name="name@sr@latin">12 - Oporezivi promet po stopi od 7%</field>
                <field name="code">ME_12</field>
                <field name="expression_ids">
                    <record id="tax_report_line_12_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-12</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_13" model="account.report.line">
                <field name="name">13 - Taxable supplies at 0%</field>
                <field name="name@sr@latin">13 - Oporezivi promet po stopi od 0%</field>
                <field name="code">ME_13</field>
                <field name="expression_ids">
                    <record id="tax_report_line_13_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-13</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_14" model="account.report.line">
                <field name="name">14 - Exempt supplies</field>
                <field name="name@sr@latin">14 - Promet oslobođen plaćanja PDV</field>
                <field name="code">ME_14</field>
                <field name="expression_ids">
                    <record id="tax_report_line_14_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-14</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_15" model="account.report.line">
                <field name="name">15 - Supplies of natural gas, electricity, heating or cooling under reverse charge</field>
                <field name="name@sr@latin">15 - Promet prirodnog gasa, električne energije, energije za grijanje ili hlađenje po osnovu prenosa poreske obaveze</field>
                <field name="code">ME_15</field>
                <field name="expression_ids">
                    <record id="tax_report_line_15_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-15</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_16" model="account.report.line">
                <field name="name">16 - VAT on domestic supplies at 21%</field>
                <field name="name@sr@latin">16 - PDV na promet u zemlji po stopi od 21%</field>
                <field name="code">ME_16</field>
                <field name="expression_ids">
                    <record id="tax_report_line_16_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-16</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_17" model="account.report.line">
                <field name="name">17 - VAT on domestic supplies at 15%</field>
                <field name="name@sr@latin">17 - PDV na promet u zemlji po stopi od 15%</field>
                <field name="code">ME_17</field>
                <field name="expression_ids">
                    <record id="tax_report_line_17_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-17</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_18" model="account.report.line">
                <field name="name">18 - VAT on domestic supplies at 7%</field>
                <field name="name@sr@latin">18 - PDV na promet u zemlji po stopi od 7%</field>
                <field name="code">ME_18</field>
                <field name="expression_ids">
                    <record id="tax_report_line_18_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-18</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_19" model="account.report.line">
                <field name="name">19 - Input VAT on domestic purchases</field>
                <field name="name@sr@latin">19 - Ulazni PDV na nabavke u zemlji</field>
                <field name="code">ME_19</field>
                <field name="expression_ids">
                    <record id="tax_report_line_19_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">19</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_20" model="account.report.line">
                <field name="name">20 - VAT paid on imports</field>
                <field name="name@sr@latin">20 - PDV plaćen pri uvozu</field>
                <field name="code">ME_20</field>
                <field name="expression_ids">
                    <record id="tax_report_line_20_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">20</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_21" model="account.report.line">
                <field name="name">21 - VAT on services of foreign persons</field>
                <field name="name@sr@latin">21 - PDV na usluge inostranih lica</field>
                <field name="code">ME_21</field>
                <field name="expression_ids">
                    <record id="tax_report_line_21_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">21</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_22" model="account.report.line">
                <field name="name">22 - Flat-rate compensation paid to farmers at 8%</field>
                <field name="name@sr@latin">22 - Paušalna nadoknada isplaćena poljoprivrednicima po stopi od 8%</field>
                <field name="code">ME_22</field>
                <field name="expression_ids">
                    <record id="tax_report_line_22_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">22</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_23" model="account.report.line">
                <field name="name">23 - VAT on natural gas, electricity, heating or cooling under reverse charge</field>
                <field name="name@sr@latin">23 - PDV na prirodni gas, električnu energiju, energiju za grijanje ili hlađenje po osnovu prenosa poreske obaveze</field>
                <field name="code">ME_23</field>
                <field name="expression_ids">
                    <record id="tax_report_line_23_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">23</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_24" model="account.report.line">
                <field name="name">24 - Total output VAT</field>
                <field name="name@sr@latin">24 - Ukupan izlazni PDV</field>
                <field name="code">ME_24</field>
                <field name="expression_ids">
                    <record id="tax_report_line_24_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ME_16.balance + ME_17.balance + ME_18.balance + ME_21.balance</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_25" model="account.report.line">
                <field name="name">25 - Total input VAT</field>
                <field name="name@sr@latin">25 - Ukupan ulazni PDV</field>
                <field name="code">ME_25</field>
                <field name="expression_ids">
                    <record id="tax_report_line_25_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ME_19.balance + ME_20.balance + ME_21.balance + ME_22.balance</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_26" model="account.report.line">
                <field name="name">26 - Input VAT without the right to deduct</field>
                <field name="name@sr@latin">26 - Ulazni PDV bez prava na odbitak</field>
                <field name="code">ME_26</field>
                <field name="expression_ids">
                    <record id="tax_report_line_26_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">26</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_27" model="account.report.line">
                <field name="name">27 - Input VAT with the right to deduct</field>
                <field name="name@sr@latin">27 - Ulazni PDV sa pravom na odbitak</field>
                <field name="code">ME_27</field>
                <field name="expression_ids">
                    <record id="tax_report_line_27_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ME_25.balance - ME_26.balance</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_28" model="account.report.line">
                <field name="name">28 - VAT due</field>
                <field name="name@sr@latin">28 - PDV za plaćanje</field>
                <field name="code">ME_28</field>
                <field name="expression_ids">
                    <record id="tax_report_line_28_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ME_24.balance - ME_27.balance</field>
                        <field name="subformula">if_above(EUR(0))</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_line_29" model="account.report.line">
                <field name="name">29 - VAT credit</field>
                <field name="name@sr@latin">29 - Višak ulaznog PDV</field>
                <field name="code">ME_29</field>
                <field name="expression_ids">
                    <record id="tax_report_line_29_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ME_27.balance - ME_24.balance</field>
                        <field name="subformula">if_above(EUR(0))</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
