<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_inherit_debit_note" inherit_id="account.report_invoice_document">

            <xpath expr="//t[@name='invoice_title']" position="before">
                <t t-if="o.debit_origin_id" name="debit_note_title">Debit Note</t>
            </xpath>
            <xpath expr="//t[@name='invoice_title']" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
            </xpath>

            <xpath expr="//t[@name='draft_invoice_title']" position="before">
                <t t-if="o.debit_origin_id" name="draft_debit_note_title">Draft Debit Note</t>
            </xpath>
            <xpath expr="//t[@name='draft_invoice_title']" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
             </xpath>

            <xpath expr="//t[@name='cancelled_invoice_title']" position="before">
                <t t-if="o.debit_origin_id" name="cancelled_debit_note_title">Cancelled Debit Note</t>
            </xpath>
            <xpath expr="//t[@name='cancelled_invoice_title']" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
            </xpath>

            <xpath expr="//t[@name='proforma_invoice_title']" position="before">
                <t t-if="o.debit_origin_id" name="proforma_debit_note_title">Proforma Debit Note</t>
            </xpath>
            <xpath expr="//t[@name='proforma_invoice_title']" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
            </xpath>

            <xpath expr="//t[@name='draft_proforma_invoice_title']" position="before">
                <t t-if="o.debit_origin_id" name="draft_proforma_debit_note_title">Draft Proforma Debit Note</t>
            </xpath>
            <xpath expr="//t[@name='draft_proforma_invoice_title']" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
            </xpath>

            <xpath expr="//t[@name='cancelled_proforma_invoice_title']" position="before">
                <t t-if="o.debit_origin_id" name="cancelled_proforma_debit_note_title">Cancelled Proforma Debit Note</t>
            </xpath>
            <xpath expr="//t[@name='cancelled_proforma_invoice_title']" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
            </xpath>

            <xpath expr="//div[@name='invoice_date']/t[@t-if=&quot;o.move_type == 'out_invoice'&quot;]" position="after">
                <t t-elif="o.move_type == 'out_invoice' and o.debit_origin_id"><strong>Debit Note Date</strong></t>
            </xpath>
            <xpath expr="//div[@name='invoice_date']/t[@t-if=&quot;o.move_type == 'out_invoice'&quot;]" position="attributes">
                <attribute name="t-if" add="not o.debit_origin_id" separator="and"/>
            </xpath>

        </template>
    </data>
</odoo>
