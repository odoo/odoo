<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_form_asset" model="ir.ui.view">
        <field name="name">account.account.form.product.asset</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="asset_log_type" />
            </xpath>
        </field>
    </record>

    <record id="view_account_list_asset" model="ir.ui.view">
        <field name="name">account.account.list.product.asset</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list" />
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="asset_log_type" optional="hide" />
            </field>
        </field>
    </record>

</odoo>
