#. module: payment_paypal
#: model_terms:ir.ui.view,arch_db:payment_paypal.payment_provider_form
msgid ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Restricted\"/>\n"
"                    <strong>Attention:</strong> Please confirm your email "
"address on PayPal to\n"
"                    receive payments."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Eingeschränkt\"/>\n"
"                    <strong>Achtung:</strong> Bitte bestätigen Sie Ihre E-"
"Mail-Adresse bei PayPal, um\n"
"                    Zahlungen zu erhalten."

#. module: payment_paypal
#: model_terms:ir.ui.view,arch_db:payment_paypal.payment_provider_form
msgid ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Restricted\"/>\n"
"                    <strong>Attention:</strong> You currently cannot receive "
"payments due to a\n"
"                    possible restriction on your PayPal account. Please "
"reach out to PayPal Customer\n"
"                    Support."
msgstr ""
"<i class=\"oi me-2\" data-icon=\"block\" title=\"Eingeschränkt\"/>\n"
"                    <strong>Achtung:</strong> Sie können derzeit keine "
"Zahlungen empfangen, da möglicherweise\n"
"                    eine Einschränkung für Ihr PayPal-Konto besteht. Bitte "
"wenden Sie sich an den PayPal-Kundendienst\n"
"                    ."

