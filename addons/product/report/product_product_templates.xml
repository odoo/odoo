                                             class="o_label_reference o_label_secondary_text"
                                             t-out="label['secondary_text']"/>
                                    </div>
                                </div>
                                <t t-if="label['primary_value']" t-call="product.report_label_value_block"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <template id="report_productlabel_pdf">
            <t t-call="web.html_container">
                <t t-foreach="label_pages" t-as="page_rows">
                    <div class="o_label_sheet" style="padding: 14mm 3mm">
                        <table class="my-0 table table-sm table-borderless">
                            <t t-foreach="page_rows" t-as="label_row">
                                <tr>
                                    <t t-foreach="label_row" t-as="label">
                                        <t t-call="{{ label_template }}"/>
                                    </t>
                                </tr>
                            </t>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <template id="report_productlabel_dymo">
            <t t-call="web.html_container">
                <t t-foreach="labels" t-as="label">
                    <t t-call="{{ label_template }}"/>
                </t>
            </t>
        </template>

