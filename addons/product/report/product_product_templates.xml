        <template id="barcode_dymo_label">
            <t t-set="page_padding" t-value="'padding: 2mm'"/>

            <div class="o_label_sheet o_label_dymo" t-att-style="page_padding">
                <div class="o_label_full">
                    <div class="o_label_centering_table">
                        <div class="o_label_centered_content">
                            <div class="o_label_name" t-out="label['name']"/>

                            <div class="o_label_content">
                                <div class="o_label_barcode_block">
                                    <t t-call="product.report_label_barcode" barcode_size="'width:100%;height:9mm'"/>
                                    <div class="o_label_barcode_text">
                                        <t t-if="label['barcode_value']" t-out="label['barcode_text']"/>
                                        <t t-else="">&amp;nbsp;</t>
                                    </div>
                                </div>

                                <div t-if="label['primary_value'] and not label['secondary_value']" class="o_label_no_secondary_value_spacer">&amp;nbsp;</div>

                                <div class="o_label_table">
                                    <div class="o_label_reference_block">
                                        <div class="o_label_reference" t-out="label['reference']"/>
                                        <div t-if="label['primary_value'] and label.get('secondary_text')"
                                             class="o_label_reference o_label_secondary_text"
                                             t-out="label['secondary_text']"/>
                                    </div>

                                    <t t-if="label['primary_value']" t-call="product.report_label_value_block"/>
                                    <div t-elif="label.get('secondary_text')"
                                         class="o_label_meta_block">
                                        <div class="o_label_meta_line o_secondary_meta_line"
                                             t-out="label['secondary_text']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

