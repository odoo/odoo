<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_label_contour_marks">
            <div class="o_label_contour_mark o_label_contour_mark_top_left">
                <div class="o_label_contour_mark_horizontal">&amp;nbsp;</div>
                <div class="o_label_contour_mark_vertical">&amp;nbsp;</div>
            </div>
            <div class="o_label_contour_mark o_label_contour_mark_top_right">
                <div class="o_label_contour_mark_horizontal">&amp;nbsp;</div>
                <div class="o_label_contour_mark_vertical">&amp;nbsp;</div>
            </div>
            <div class="o_label_contour_mark o_label_contour_mark_bottom_left">
                <div class="o_label_contour_mark_horizontal">&amp;nbsp;</div>
                <div class="o_label_contour_mark_vertical">&amp;nbsp;</div>
            </div>
            <div class="o_label_contour_mark o_label_contour_mark_bottom_right">
                <div class="o_label_contour_mark_horizontal">&amp;nbsp;</div>
                <div class="o_label_contour_mark_vertical">&amp;nbsp;</div>
            </div>
        </template>

        <template id="report_label_barcode">
            <t t-set="symbology" t-value="'auto' if symbology is None else symbology"/>
            <div t-if="label['barcode_value']"
                 class="o_label_barcode"
                 t-out="label['barcode_value']"
                 t-options="{
                     'widget': 'barcode',
                     'quiet': 0,
                     'symbology': symbology,
                     'img_style': barcode_size
                 }"/>
            <div t-else="" class="o_label_barcode" t-att-style="barcode_size">&amp;nbsp;</div>
        </template>

        <template id="report_label_value_block">
            <div class="o_label_meta_block">
                <strong class="o_label_primary_value"
                        t-out="label['primary_value']"/>
                <div t-if="label['secondary_value']" class="o_label_meta_line">
                    <t t-out="label['secondary_value']"/>
                    <t t-out="label['secondary_value_suffix']"/>
                </div>
            </div>
        </template>

        <template id="barcode_2x7_label">
            <td t-att-style="label['invisible'] and 'visibility:hidden;'">
                <div class="o_label_full o_label_2x7">
                    <t t-if="not label.get('invisible')">
                    <t t-call="product.report_label_contour_marks"/>
                    <div class="o_label_table">
                        <div class="o_label_barcode_side">
                            <div class="o_label_barcode_block" t-if="label['barcode_value']">
                                <t t-call="product.report_label_barcode" barcode_size="'width:100%;height:29mm'"/>
                                <div class="o_label_barcode_text" t-out="label['barcode_text']"/>
                            </div>
                        </div>

                        <div class="o_label_info_side">
                            <div class="o_label_info_frame">
                                <div class="o_label_info_top">
                                    <div class="o_label_name" t-out="label['name']"/>

                                    <div class="o_label_reference_block">
                                        <div class="o_label_reference" t-out="label['reference']"/>
                                        <div t-if="label.get('secondary_text')"
                                             class="o_label_reference o_label_secondary_text"
                                             t-out="label['secondary_text']"/>
                                    </div>

                                    <div t-att-class="'o_label_extra_content%s' % (' o_label_extra_content_single_line' if label.get('secondary_text') else '')">
                                        <t t-if="label['extra_content']" t-out="label['extra_content']"/>
                                        <t t-else="">&amp;nbsp;</t>
                                    </div>
                                </div>

                                <t t-if="label['primary_value']" t-call="product.report_label_value_block"/>
                            </div>
                        </div>
                    </div>
                    </t>
                </div>
            </td>
        </template>

        <template id="qr_2x7_label">
            <td t-att-style="label['invisible'] and 'visibility:hidden;'">
                <div class="o_label_full o_label_2x7 o_label_2x7_qr">
                    <t t-if="not label.get('invisible')">
                    <t t-call="product.report_label_contour_marks"/>
                    <div class="o_label_table">
                        <div class="o_label_barcode_side">
                            <div class="o_label_barcode_block" t-if="label['barcode_value']">
                                <t t-call="product.report_label_barcode"
                                   barcode_size="'width:29mm;height:29mm'"
                                   symbology="'ECC200DataMatrix'"/>
                                <div class="o_label_barcode_text" t-out="label['barcode_text']"/>
                            </div>
                        </div>

                        <div class="o_label_info_side">
                            <div class="o_label_info_frame">
                                <div class="o_label_info_top">
                                    <div class="o_label_name" t-out="label['name']"/>

                                    <div class="o_label_reference_block">
                                        <div class="o_label_reference" t-out="label['reference']"/>
                                        <div t-if="label.get('secondary_text')"
                                             class="o_label_reference o_label_secondary_text"
                                             t-out="label['secondary_text']"/>
                                    </div>

                                    <div t-att-class="'o_label_extra_content%s' % (' o_label_extra_content_single_line' if label.get('secondary_text') else '')">
                                        <t t-if="label['extra_content']" t-out="label['extra_content']"/>
                                        <t t-else="">&amp;nbsp;</t>
                                    </div>
                                </div>

                                <t t-if="label['primary_value']" t-call="product.report_label_value_block"/>
                            </div>
                        </div>
                    </div>
                    </t>
                </div>
            </td>
        </template>

        <template id="barcode_4x7_label">
            <td t-att-style="label['invisible'] and 'visibility:hidden;'">
                <div class="o_label_full o_label_4x7">
                    <t t-if="not label.get('invisible')">
