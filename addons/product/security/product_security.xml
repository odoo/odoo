<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_product" model="res.groups.privilege">
        <field name="name">Products</field>
        <field name="description">Helps you manage your product catalog.</field>
        <field name="placeholder">View</field>
        <field name="category_id" ref="base.module_category_master_data" />
        <field name="sequence">9</field>
    </record>

    <record id="group_product_pricelist" model="res.groups">
        <field name="name">Basic Pricelists</field>
    </record>

    <record id="group_product_variant" model="res.groups">
        <field name="name">Manage Product Variants</field>
    </record>

    <record id="group_product_manager" model="res.groups">
        <field name="name">Create</field>
        <field name="privilege_id" ref="res_groups_privilege_product" />
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]" />
        <field name="user_ids" eval="[Command.link(ref('base.user_root'))]" />
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[Command.link(ref('group_product_manager'))]" />
    </record>

    <record id="res_groups_privilege_product_cost" model="res.groups.privilege">
        <field name="name">Product Cost</field>
        <field name="category_id" ref="base.module_category_master_data" />
    </record>

    <record id="group_product_cost_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_product_cost" />
    </record>

    <record id="group_product_cost_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_product_cost" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_product_cost_readonly'))]" />
    </record>

    <record id="res_groups_privilege_product_price" model="res.groups.privilege">
        <field name="name">Product Price</field>
        <field name="category_id" ref="base.module_category_master_data" />
    </record>

    <record id="group_product_price_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_product_price" />
    </record>

</odoo>
