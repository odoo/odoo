<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_loyalty.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_customer_display_total')]" position="after">
            <t t-if="lines.length and orderData.state == 'draft' and this.order.loyaltyPrograms?.length gt 0">
                <div class="border-top px-4 py-2 bg-view">
                    <t t-foreach="this.order.loyaltyPrograms" t-as="program" t-key="program.id">
                        <div
                            t-if="program.won or program.spent"
                            class="d-flex justify-content-between align-items-center py-1 flex-wrap"
                        >
                            <div class="loyalty-points-title fs-4 fw-semibold" t-out="program.name"/>

                            <div class="d-flex align-items-center gap-1 fw-bold fs-4 flex-nowrap text-end">
                                <span t-if="program.balance" class="loyalty-points-balance" t-out="program.balance"/>
                                <span t-if="program.won" class="loyalty-points-won text-success">
                                    <span t-if="program.won > 0" class="text-success">+ <t t-out="program.won"/></span>
                                    <span t-else="" class="text-danger"><t t-out="program.won"/></span>
                                </span>
                                <span t-if="program.spent" class="loyalty-points-spent text-danger">
                                    - <t t-out="program.spent"/>
                                </span>
                                <span class="text-muted mx-1">=</span>
                                <span class="loyalty-points-total fw-bolder" t-out="program.total"/>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
