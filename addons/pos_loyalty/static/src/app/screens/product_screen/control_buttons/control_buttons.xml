<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_loyalty.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath
            expr="//t[@t-if='this.props.showRemainingButtons']/div/t[@name='o_pricelist_button']"
            position="before">
            <t t-if="this.pos.models['loyalty.program'].some((p) => p.program_type == 'ewallet')">
                <t t-set="_orderTotal" t-value="this.pos.getOrder().priceIncl" />
                <t t-set="_eWalletRewards" t-value="this._getEWalletRewards(this.pos.getOrder()).length" />
                <t t-call="point_of_sale.controlButton"
                    btnClasses="'btn-secondary highlight'"
                    icon="'credit_card'"
                    btnText.translate="eWallet Refund"
                    onClick="() => this.onClickWalletRefund()"
                    t-if="_orderTotal lt 0">
                </t>
                <t t-call="point_of_sale.controlButton"
                    btnClasses="'btn-secondary highlight'"
                    icon="'credit_card'"
                    btnText.translate="eWallet Pay"
                    onClick="() => this.onClickWalletPay()"
                    t-if="_orderTotal gt 0 and _eWalletRewards gte 1">
                </t>
                <t t-call="point_of_sale.controlButton"
                    btnClasses="'btn-secondary disabled'"
                    icon="'credit_card'"
                    btnText.translate="eWallet"
                    t-if="_orderTotal == 0 or (_orderTotal gte 0 and _eWalletRewards lt 1)">
                </t>
            </t>
            <t t-if="this.pos.models['loyalty.program'].some((p) => ['coupons', 'promotion', 'gift_card', 'promo_code', 'next_order_coupons'].includes(p.program_type))" t-call="point_of_sale.controlButton"
                icon="'percent'"
                btnText.translate="Enter Code"
                btnClasses="'btn-secondary '"
                onClick="() => this.clickPromoCode()">
            </t>
            <t t-if="this.pos.models['loyalty.program'].length and this.pos.cashier._role !== 'minimal'" t-call="point_of_sale.controlButton"
                icon="'star'"
                iconClasses="'oi-filled'"
                btnText.translate="Reward"
                btnClasses="'btn-secondary ' + (this.nbrRewards() ? ' highlight' : 'disabled')"
                disabled="!this.nbrRewards()"
                onClick="() => this.clickRewards()">
            </t>
        </xpath>
        <xpath expr="//button[hasclass('more-btn')]" position="attributes">
            <attribute name="t-attf-class">{{ this.nbrRewards() ? 'active text-action' : '' }}</attribute>
        </xpath>
    </t>
</templates>
