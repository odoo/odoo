#: model_terms:ir.ui.view,arch_db:account.view_move_form
msgid "You have"
msgstr "Sie haben"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move_line.py:0
msgid ""
"You have to configure the 'Exchange Gain or Loss Journal' in your company "
