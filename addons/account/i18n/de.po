#. odoo-python
#: code:addons/account/models/account_move.py:0
msgid "You cannot validate a document with an inactive currency: %s"
msgstr ""
"Sie können ein Dokument mit einer inaktiven Währung nicht validieren: %s"

#. module: account
#. odoo-python
#: code:addons/account/models/account_move.py:0
