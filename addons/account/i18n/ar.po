#. module: account_reports
#: model:mail.template,body_html:account_reports.email_template_tax_return_deadline
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    Hi <span t-out=\"ctx.get('partner') and ctx['partner'].name\"/>,<br/><br/>\n"
"                    The deadline to submit <strong t-out=\"object.name\"/> is <strong t-out=\"object.date_deadline\"/>.<br/>\n"
"                    To avoid any potential fine, please ensure all remaining documents are sent over as soon as possible.<br/>\n"
"                    If you've already submitted everything but still received this email, it's likely the tax return hasn't been marked as submitted in Odoo.<br/>\n"
"                    Should you have any question or need assistance, feel free to get in touch.<br/><br/>\n"
"                    Best regards,<br/>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px;\">\n"
"                    مرحبًا <span t-out=\"ctx.get('partner') and ctx['partner'].name\"/> ،<br/><br/>\n"
"                    الموعد النهائي لتقديم <strong t-out=\"object.name\"/> هو <strong t-out=\"object.date_deadline\"/>.<br/>\n"
"                    لتجنب أي غرامة محتملة، يرجى التأكد من إرسال جميع المستندات المتبقية في أقرب وقت ممكن.<br/>\n"
"                    إذا كنت قد قدمت كل شيء بالفعل ولكنك لا تزال تتلقى هذا البريد الإلكتروني، فمن المحتمل أن الإقرار الضريبي لم يتم تعيينه كـ \"تم إرساله في أودو.<br/>\n"
"                    إذا كان لديك أي سؤال أو كنت بحاجة إلى المساعدة، فلا تتردد في الاتصال بنا.<br/><br/>\n"
"                    مع أطيب التحيات،<br/>\n"
"                </p>\n"
"           </div> \n"
"        "

#. module: account_reports
#: model:mail.template,body_html:account_reports.email_template_generic_tax_instructions
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    Dear <t t-out=\"object.company_id.name\">YourCompany</t>,\n"
"                </p>\n"
"                <p>\n"
"                    Based on the documents and information received, the VAT return of <t t-out=\"object.company_id.name\">YourCompany</t>\n"
"                    for period <t t-out=\"object.type_id._get_period_name(object.company_id, object.date_from, object.date_to)\"/> has been submitted.\n"
"                </p>\n"
"                <p>\n"
"                    It has been determined that an amount of <t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/> remains payable.\n"
"                </p>\n"
"                <table style=\"border:1px solid black; padding:20px; text-align:left; border-spacing: 16px;\">\n"
"                    <tr>\n"
"                        <td>Amount to Pay</td>\n"
"                        <td><t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>Due By</td>\n"
"                        <td><t t-out=\"format_date(object.date_deadline)\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>Kind regards,</p>\n"
"                <p><t t-out=\"user.name\">Mitchell Admin</t></p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>\n"
"                    عزيزنا <t t-out=\"object.company_id.name\">YourCompany</t>،\n"
"                </p>\n"
"                <p>\n"
"                    بناءً على الوثائق والمعلومات الواردة، فإن إقرار ضريبة القيمة المضافة لـ <t t-out=\"object.company_id.name\">YourCompany</t>\n"
"                    للفترة <t t-out=\"object.type_id._get_period_name(object.company_id, object.date_from, object.date_to)\"/> قد تم تقديمه.\n"
"                </p>\n"
"                <p>\n"
"                    لقد تبين أنه يوجد مبلغ قيمته <t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/> مستحق الدفع.\n"
"                </p>\n"
"                <table style=\"border:1px solid black; padding:20px; text-align:left; border-spacing: 16px;\">\n"
"                    <tr>\n"
"                        <td>المبلغ المطلوب دفعه</td>\n"
"                        <td><t t-out=\"format_amount(object.total_amount_to_pay, object.amount_to_pay_currency_id)\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td>مستحق بتاريخ</td>\n"
"                        <td><t t-out=\"format_date(object.date_deadline)\"/></td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>مع وافر الشكر والتقدير</p>\n"
"                <p><t t-out=\"user.name\">ميتشل آدمن</t></p>\n"
"            </div>\n"
"        "

