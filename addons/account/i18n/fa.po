"        عزیز\n"
"            </t>\n"
"            <t t-else=\"\">\n"
"                <t t-out=\"object.partner_id.parent_id.name or ''\">آژور اینتریور</t>,\n"
"            </t>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"object.partner_id.name or ''\">براندون فریمن</t>,\n"
"        </t>\n"
"        <br/><br/>\n"
"        این صورت‌حساب فاکتور شما است\n"
"        <t t-if=\"object.name\">\n"
"            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">INV/2021/05/0005</span>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            صورت‌حساب فاکتور\n"
"        </t>\n"
"        <t t-if=\"object.invoice_origin\">\n"
"            (با مرجع: <t t-out=\"object.invoice_origin or ''\">SUB003</t>)\n"
"        </t>\n"
"        به مبلغ <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00</span>\n"
"        از <t t-out=\"object.company_id.name or ''\">شرکت شما</t>.\n"
"        <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"            این صورت‌حساب فاکتور قبلاً پرداخت شده است.\n"
"        </t>\n"
"        <t t-if=\"hasattr(object, 'timesheet_count') and object.timesheet_count\">\n"
"            <br/><br/>\n"
"            نکته: می‌توانید برگه‌های زمان خود را <a t-att-href=\"'/my/timesheets?search_in=invoice&amp;search=%s' % object.name\">از پرتال بررسی کنید.</a>\n"
"        </t>\n"
"        <br/><br/>\n"
"        در صورت داشتن هرگونه سؤال، در تماس با ما تردید نکنید.\n"
"        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"            <br/><br/>\n"
"            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"object.invoice_user_id.signature or ''\" data-o-mail-quote=\"1\">میچل ادمین</t></div>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"            "

