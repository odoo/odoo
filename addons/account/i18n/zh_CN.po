"                    <!-- 正文 -->\n"
"                    <tr>\n"
"                        <td align=\"center\">\n"
"                            <table width=\"590\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding: 16px 32px; background-color: white; border-collapse:separate;\">\n"
"                                <tr>\n"
"                                    <td style=\"font-size: 14px;\">\n"
"                                        <h3 style=\"font-size: 20px; margin-bottom: 20px;\">\n"
"                                            <t t-if=\"object.company_id.name\">\n"
"                                                您好，<t t-out=\"object.company_id.name\"/>！\n"
"                                            </t>\n"
"                                            <t t-else=\"\">\n"
"                                                您好！\n"
"                                            </t>\n"
"                                        </h3>\n"
"                                        <p style=\"margin-top: 12px;\">\n"
"                                            您已收到<t t-if=\"invoice_count > 1\">新的电子发票</t><t t-else=\"\">一张新的电子发票</t>！\n"
"                                        </p>\n"
"                                        <t t-set=\"MAX_INVOICES_TO_DISPLAY\" t-value=\"5\"/>\n"
"                                        <t t-foreach=\"invoices[:MAX_INVOICES_TO_DISPLAY]\" t-as=\"inv\">\n"
"                                            <t t-if=\"not inv_first\">\n"
"                                                <div style=\"background-color:#EEEEEE; height:1px; width: 60%; margin: 16px auto; border:none;\"/>\n"
"                                            </t>\n"
"                                            <p style=\"line-height: 1.7em; padding-top: 16px;\">\n"
"                                                <t t-if=\"inv.name or inv.ref\">\n"
"                                                    <span style=\"font-weight:bold;\">发票参考：</span> <t t-out=\"inv.name or inv.ref\"/><br/>\n"
"                                                </t>\n"
"                                                <t t-if=\"inv.partner_id.name\">\n"
"                                                    <span style=\"font-weight:bold;\">供应商：</span> <t t-out=\"inv.partner_id.name\"/><br/>\n"
"                                                </t>\n"
"                                                <t t-if=\"inv.amount_total\">\n"
"                                                    <span style=\"font-weight:bold;\">金额：</span> <t t-out=\"inv.amount_total\" t-options=\"{'widget': 'monetary', 'display_currency': inv.currency_id or object.company_id.currency_id}\"/><br/>\n"
"                                                </t>\n"
"                                                <t t-if=\"inv.invoice_date_due\">\n"
"                                                    <span style=\"font-weight:bold;\">到期日：</span> <t t-out=\"inv.invoice_date_due\"/>\n"
"                                                </t>\n"
"                                            </p>\n"
"                                        </t>\n"
"\n"
"                                        <div style=\"text-align: center; padding-top: 24px;\">\n"
"                                            <a t-if=\"invoice_count != 1\" t-attf-href=\"/odoo/accounting/action-account.action_account_moves_email_preview?active_ids={{ invoice_preview_ids }}\" target=\"_blank\" t-attf-style=\"padding: 12px 24px; font-size: 14px; font-weight: bold; color: #FFFFFF; text-decoration: none !important; background-color: #008384; border-radius:3px; display: inline-block;\">\n"
