"                                                                    </div>\n"
"                                                                    <t t-if=\"object.ref\">\n"
"                                                                        <div style=\"margin-top:6px; color:#7f6c84;\">Ref: <t t-out=\"object.ref\"/></div>\n"
"                                                                    </t>\n"
"                                                                </td>\n"
