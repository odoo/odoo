#: model_terms:ir.ui.view,arch_db:account.bill_preview
msgid "[FURN_8220] Four Person Desk"
msgstr "[FURN_8220] Bàn cho bốn người"

#. module: account
#: model_terms:ir.ui.view,arch_db:account.bill_preview
