<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_accrued_orders_wizard" model="ir.ui.view">
        <field name="name">account.accrued.orders.wizard.view</field>
        <field name="model">account.accrued.orders.wizard</field>
        <field name="arch" type="xml">
            <form string="Make Accrual Entries">
                <field name="company_id" invisible="1"/> <!-- scopes the check_company=True domains of journal_id/account_id below -->
                <field name="accrual_type" invisible="1"/> <!-- dependency of the preview_data compute, set from the action context -->
                <group>
                    <div class="alert alert-warning" colspan="4" role="alert" invisible="not duplicate_entry_id">
                      <span>An accrual entry of </span>
                      <button name="open_duplicate"
                              type="object"
                              class="btn btn-link p-0 align-baseline">
                        <field name="currency_id" invisible="1"/> <!-- currency of the duplicate_price_total monetary widget next to it -->
                        <field name="duplicate_price_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                      </button>
                      <span> already exists for this period. Posting this entry will replace it.</span>
                    </div>
                    <div class="alert alert-info" colspan="4" role="alert" invisible="not display_amount">
                      There doesn't appear to be anything to invoice for the selected order. However, you can use the amount field to force an accrual entry.
                    </div>
                  <group>
                    <field name="journal_id"/>
                    <field name="account_id"/>
                    <field name="amount" invisible="not display_amount"/>
                    <field name="display_amount" invisible="1"/> <!-- drives invisible="not display_amount" on the info alert and the amount field -->
                  </group>
                  <group>
                    <field name="date"/>
                    <field name="reversal_date"/>
                  </group>
                </group>
                <field name="preview_data" widget="grouped_view_widget" class="w-100"/>
                <footer>
                    <button string='Create Entry' name="create_entries" type="object" class="btn-primary"/>
                    <button class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
