<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_fiscal_year" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.account.accountant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting position="replace" id="fiscalyear">
                <setting id="fiscalyear" string="Fiscal Year">
                    <div class="content-group">
                        <div class="d-flex mt16 align-items-baseline">
                            <label
                                for="fiscalyear_last_month"
                                string="Last Day"
                                class="col-lg-3 o_light_label pe-2 pe-lg-0" />
                            <div class="col-lg-9">
                                <field name="fiscalyear_last_month" class="pe-2" />
                                <field name="fiscalyear_last_day" />
                            </div>
                        </div>
                    </div>
                </setting>
                <setting
                    help="All entries created by Invoicing before that date will be ignored in Accounting."
                    groups="account.group_account_manager">
                    <field name="invoicing_switch_threshold" />
                </setting>
                <setting help="Define fiscal years of more or less than one year">
                    <field name="group_fiscal_year" />
                    <div class="mt16">
                        <button
                            name="%(account.actions_account_fiscal_year)d"
                            type="action"
                            string="Fiscal Years"
                            icon="oi-arrow-right"
                            invisible="not group_fiscal_year"
                            class="btn-link" />
                    </div>
                </setting>
            </setting>
            <block position="inside" id="bank_cash">
                <setting
                    help="Enable Auto Transfers "
                    groups="account.group_account_manager"
                    invisible="1">
                    <field
                        name="module_account_auto_transfer"
                        widget="upgrade_boolean" />
                </setting>
            </block>
            <block position="inside" id="invoicing_settings">
                <setting
                    help="To enhance authenticity, add a signature to your invoices"
                    company_dependent="1">
                    <field name="sign_invoice" />
                    <label
                        for="signing_user"
                        string="Legal signatory"
                        invisible="not sign_invoice"
                        class="col-lg-5 o_light_label" />
                    <field name="signing_user" invisible="not sign_invoice" />
                </setting>
            </block>
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting
                    string="Predict vendor bill product"
                    help="The system will try to predict the product on vendor bill lines based on the label of the line">
                    <field name="predict_bill_product" />
                </setting>
            </xpath>

            <setting position="after" id="post_bank_transactions_and_payments_setting">
                <setting
                    string="Deferred expense entries:"
                    company_dependent="1"
                    documentation="/applications/finance/accounting/vendor_bills/deferred_expenses.html">
                    <div class="content-group">
                        <div class="row mt8">
                            <label
                                for="deferred_expense_journal_id"
                                string="Journal"
                                class="col-lg-5 o_light_label" />
                            <field
                                name="deferred_expense_journal_id"
                                domain="[('type', '=', 'general'), ('active', '=', True)]" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="deferred_expense_account_id"
                                string="Deferred expense"
                                class="col-lg-5 o_light_label" />
                            <field
                                name="deferred_expense_account_id"
                                domain="[('account_type', '=', 'asset_current')]" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="generate_deferred_expense_entries_method"
                                string="Generate Entries"
                                class="col-lg-5 o_light_label" />
                            <field name="generate_deferred_expense_entries_method" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="deferred_expense_amount_computation_method"
                                string="Based on"
                                class="col-lg-5 o_light_label" />
                            <field name="deferred_expense_amount_computation_method" />
                        </div>
                    </div>
                </setting>
                <setting
                    string="Deferred revenue entries:"
                    company_dependent="1"
                    documentation="/applications/finance/accounting/customer_invoices/deferred_revenues.html">
                    <div class="content-group">
                        <div class="row mt8">
                            <label
                                for="deferred_revenue_journal_id"
                                string="Journal"
                                class="col-lg-5 o_light_label" />
                            <field
                                name="deferred_revenue_journal_id"
                                domain="[('type', '=', 'general'), ('active', '=', True)]" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="deferred_revenue_account_id"
                                string="Deferred revenue"
                                class="col-lg-5 o_light_label" />
                            <field
                                name="deferred_revenue_account_id"
                                domain="[('account_type', '=', 'liability_current')]" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="generate_deferred_revenue_entries_method"
                                string="Generate Entries"
                                class="col-lg-5 o_light_label" />
                            <field name="generate_deferred_revenue_entries_method" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="deferred_revenue_amount_computation_method"
                                string="Based on"
                                class="col-lg-5 o_light_label" />
                            <field name="deferred_revenue_amount_computation_method" />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
