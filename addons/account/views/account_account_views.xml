<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.account</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account_coa.view_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_related_taxes"
                    type="object"
                    icon="fa-bars"
                    invisible="related_taxes_amount == 0"
                    class="oe_stat_button">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="related_taxes_amount" />
                        </span>
                        <span class="o_stat_text">
                            Taxes
                        </span>
                    </div>
                </button>
                <button
                    name="account.action_move_line_select"
                    type="action"
                    icon="fa-bars"
                    class="oe_stat_button">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="current_balance" />
                        </span>
                        <span class="o_stat_text">
                            Balance
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='account_type']" position="after">
                <field
                    name="tax_ids"
                    widget="many2many_tax_tags"
                    options="{'no_quick_create': True}"
                    invisible="account_type == 'off_balance'" />
            </xpath>
            <xpath expr="//field[@name='active']" position="after">
                <field name="group_id" groups="base.group_no_one" />
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter />
            </xpath>
        </field>
    </record>

    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.account</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account_coa.view_account_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="group_id" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="tax_ids" widget="many2many_tax_tags" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_account_search" model="ir.ui.view">
        <field name="name">account.account.search.account</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account_coa.view_account_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactiveacc']" position="before">
                <filter
                    name="used"
                    string="Account with Entries"
                    domain="[('used', '=', True)]" />
            </xpath>
        </field>
    </record>

    <record id="action_unmerge_accounts" model="ir.actions.server">
        <field name="name">Unmerge Account</field>
        <field name="model_id" ref="account_coa.model_account_account" />
        <field name="binding_model_id" ref="account_coa.model_account_account" />
        <field name="binding_view_types">form,list,kanban</field>
        <field name="binding_icon">fa-solid fa-code-fork</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('account.group_account_manager'))]" />
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_unmerge()</field>
    </record>

</odoo>
