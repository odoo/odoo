<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="open_account_charts_modules" model="ir.actions.act_window">
        <field name="name">Chart Templates</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_module_filter_inherit_account" />
        <field
            name="context"
            eval="{                 'search_default_category_id': ref('base.module_category_accounting_localizations_account_charts'),                 'searchpanel_default_category_id': ref('base.module_category_accounting_localizations_account_charts'),             }" />
    </record>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="40" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field
                    name="country_code"
                    groups="account.group_account_manager"
                    invisible="1" />
                <app
                    name="account"
                    string="Invoicing"
                    groups="account.group_account_manager"
                    data-string="Invoicing">
                    <field name="has_chart_of_accounts" invisible="1" />
                    <field name="has_accounting_entries" invisible="1" />
                    <block
                        name="fiscal_localization_setting_container"
                        title="Fiscal Localization"
                        invisible="not is_root_company">
                        <setting
                            string="Fiscal Localization"
                            help="Taxes, fiscal positions, chart of accounts &amp; legal statements for your country"
                            company_dependent="1"
                            documentation="/applications/finance/fiscal_localizations.html">
                            <div class="content-group">
                                <div class="mt16">
                                    <div>
                                        <label
                                            for="chart_template"
                                            string="Package"
                                            class="col-2 o_light_label" />
                                        <field
                                            name="chart_template"
                                            readonly="has_accounting_entries"
                                            required="chart_template" />
                                    </div>
                                    <div class="mt16">
                                        <button
                                            name="reload_template"
                                            type="object"
                                            string="Reload"
                                            title="Reload accounting data (taxes, accounts, ...) if you notice inconsistencies. This action is irreversible."
                                            icon="fa-refresh"
                                            invisible="not has_accounting_entries or not chart_template"
                                            class="btn-secondary ps-2 w-100" />
                                    </div>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block name="default_taxes_setting_container" title="Taxes">
                        <setting
                            id="default_taxes"
                            string="Default Taxes"
                            help="Default taxes applied when creating new products."
                            company_dependent="1"
                            documentation="/applications/finance/accounting/taxation/taxes/default_taxes.html">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="sale_tax_id"
                                        string="Sales Tax"
                                        class="col-lg-3 o_light_label" />
                                    <field
                                        name="sale_tax_id"
                                        domain="[('type_tax_use', 'in', ('sale', 'all'))]" />
                                </div>
                                <div class="row">
                                    <label
                                        for="purchase_tax_id"
                                        string="Purchase Tax"
                                        class="col-lg-3 o_light_label" />
                                    <field
                                        name="purchase_tax_id"
                                        domain="[('type_tax_use', 'in', ('purchase', 'all'))]" />
                                </div>
                                <div class="row">
                                    <div class="col-lg-3">
                                        <label
                                            for="account_price_include"
                                            string="Prices"
                                            class="o_light_label" />
                                        <div
                                            class="fa-solid fa-question-circle"
                                            title="This setting locks once a journal entry is created." />
                                    </div>
                                    <field
                                        name="account_price_include"
                                        readonly="has_accounting_entries" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="rounding_method"
                            string="Rounding Method"
                            title="A rounding per line is advised if your prices are tax-included. That way, the sum of line subtotals equals the total with taxes."
                            help="How total tax amount is computed in orders and invoices"
                            company_dependent="1">
                            <field
                                name="tax_calculation_rounding_method"
                                widget="radio"
                                class="o_light_label mt16" />
                        </setting>
                        <setting
                            id="eu_service"
                            string="EU Intra-community Distance Selling"
                            title="If you sell goods and services to customers in a                                 foreign EU country, you must charge VAT based on the delivery address.                                 This rule applies regardless of where you are located."
                            help="Apply VAT of the EU country to which goods and services are delivered."
                            invisible="not('EU' in company_country_group_codes or company_country_code in ('CH', 'UK'))"
                            documentation="/applications/finance/accounting/taxation/taxes/eu_distance_selling.html">
                            <button
                                name="action_eu_oss_tax_mapping"
                                type="object"
                                string="OSS Tax mapping"
                                icon="fa-refresh"
                                class="btn-link" />
                        </setting>
                        <setting
                            id="tax_exigibility"
                            title="Select this if the taxes should use cash basis, which will create an entry for such taxes on a given account during reconciliation."
                            help="Allow to configure taxes using cash basis"
                            company_dependent="1"
                            documentation="/applications/finance/accounting/taxation/taxes/cash_basis_taxes.html">
                            <field name="tax_exigibility" />
                            <div
                                class="content-group"
                                invisible="not tax_exigibility"
                                groups="account.group_account_user">
                                <div class="row mt16">
                                    <label
                                        for="tax_cash_basis_journal_id"
                                        class="col-lg-3 o_light_label" />
                                    <field name="tax_cash_basis_journal_id" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="account_cash_basis_base_account_id"
                                        class="col-lg-3 o_light_label" />
                                    <field name="account_cash_basis_base_account_id" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="tax_fiscal_country_234"
                            string="Fiscal Country"
                            help="Domestic country of your accounting"
                            company_dependent="1">
                            <field
                                name="account_fiscal_country_id"
                                options="{'no_create': True, 'no_open': True}" />
                        </setting>
                    </block>
                    <block name="main_currency_setting_container" title="Currencies">
                        <setting
                            id="main_currency"
                            string="Main Currency"
                            help="Main currency of your company"
                            company_dependent="1"
                            documentation="/applications/finance/accounting/others/multi_currency.html">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="currency_id"
                                        class="col-lg-3 o_light_label" />
                                    <field
                                        name="currency_id"
                                        context="{'active_test': False}"
                                        options="{'no_create_edit': True, 'no_open': True}" />
                                    <field name="group_multi_currency" invisible="1" />
                                </div>
                                <div class="mt8">
                                    <button
                                        name="%(base.action_currency_form)d"
                                        type="action"
                                        string="Currencies"
                                        icon="oi-arrow-right"
                                        class="btn-link" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="update_exchange_rates"
                            help="Update exchange rates automatically"
                            invisible="not group_multi_currency"
                            documentation="/applications/finance/accounting/others/multi_currency.html">
                            <field
                                name="module_currency_rate_live"
                                widget="upgrade_boolean" />
                        </setting>
                    </block>
                    <block id="invoicing_settings" title="Customer Invoices">
                        <setting
                            id="send_invoices_followups"
                            help="Send invoices and payment follow-ups by post"
                            documentation="/applications/finance/accounting/receivables/customer_invoices/snailmail.html">
                            <field name="module_snailmail_account" />
                        </setting>
                        <setting
                            id="invoice_delivery_addresses"
                            help="Select specific invoice and delivery addresses"
                            documentation="/applications/sales/sales/send_quotations/different_addresses.html">
                            <field name="group_sale_delivery_address" />
                        </setting>
                        <setting
                            id="smallest_coinage_currency"
                            help="Define the smallest coinage of the currency used to pay by cash"
                            documentation="/applications/finance/accounting/receivables/customer_invoices/cash_rounding.html">
                            <field name="group_cash_rounding" />
                            <div class="mt8">
                                <button
                                    name="%(account.rounding_list_action)d"
                                    type="action"
                                    string="Cash Roundings"
                                    icon="oi-arrow-right"
                                    invisible="not group_cash_rounding"
                                    class="btn-link" />
                            </div>
                        </setting>
                        <setting
                            id="intrastat_statistics"
                            help="Collect information and produce statistics on the trade in goods in Europe with intrastat"
                            invisible="'INTRASTAT' not in company_country_group_codes"
                            documentation="/applications/finance/accounting/reporting/declarations/intrastat.html">
                            <field
                                name="module_account_intrastat"
                                widget="upgrade_boolean" />
                        </setting>
                        <setting
                            id="default_incoterm"
                            string="Default Incoterm"
                            help="Default Incoterm of your company">
                            <field name="incoterm_id" />
                        </setting>
                        <setting
                            id="show_sale_receipts"
                            help="Activate to create sale receipt">
                            <field name="show_sale_receipts" />
                        </setting>
                        <setting
                            id="use_invoice_terms"
                            help="Add your terms &amp; conditions at the bottom of invoices/orders/quotations"
                            company_dependent="1">
                            <field name="use_invoice_terms" />
                            <div
                                class="content-group"
                                invisible="not use_invoice_terms">
                                <div class="mt16">
                                    <field
                                        name="terms_type"
                                        widget="radio"
                                        class="o_light_label" />
                                    <div>
                                        <field
                                            name="invoice_terms"
                                            placeholder="Insert your terms &amp; conditions here..."
                                            invisible="terms_type == 'html'"
                                            class="oe_account_terms mt-5 w-100" />
                                    </div>
                                    <div class="mt8" invisible="terms_type != 'html'">
                                        <button
                                            name="action_update_terms"
                                            type="object"
                                            string="Update Terms"
                                            icon="oi-arrow-right"
                                            class="btn-link" />
                                    </div>
                                    <field name="preview_ready" invisible="1" />
                                    <div class="mt4 ms-1" invisible="not preview_ready">
                                        <a class="btn-link" href="/terms" role="button">
                                            <i class="oi oi-arrow-right" /> Preview </a>
                                    </div>
                                </div>
                            </div>
                        </setting>
                        <setting
                            help="Trigger alerts when creating Invoices and Sales Orders for Partners with a Total Receivable amount exceeding a limit.                                      Set a value greater than 0.0 to activate a credit limit check"
                            company_dependent="1">
                            <field name="account_use_credit_limit" />
                            <div
                                class="content-group mt-2"
                                invisible="not account_use_credit_limit">
                                <div class="row">
                                    <label
                                        for="account_default_credit_limit"
                                        class="col-lg-4 o_light_label" />
                                    <field name="account_default_credit_limit" />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="total_amount_words"
                            help="Display the total amount of an invoice in letters"
                            company_dependent="1">
                            <field name="display_invoice_amount_total_words" />
                        </setting>
                        <setting
                            id="display_invoice_tax_company_currency"
                            help="Taxes are also displayed in local currency on invoices"
                            company_dependent="1">
                            <field name="display_invoice_tax_company_currency" />
                        </setting>
                    </block>
                    <block title="Units &amp; Packagings">
                        <setting
                            id="account_uom"
                            help="Sell and purchase products in different units of measure or packagings">
                            <field name="group_uom" />
                            <div class="content-group" invisible="not group_uom">
                                <button
                                    name="%(uom.action_uom_uom)d"
                                    type="action"
                                    string="Units &amp; Packagings"
                                    icon="oi-arrow-right"
                                    class="btn-link" />
                            </div>
                        </setting>
                    </block>
                    <block
                        id="pay_invoice_online_setting_container"
                        title="Customer Payments">
                        <setting
                            help="Let your customers pay their invoices online"
                            documentation="/applications/finance/accounting/receivables/customer_payments/online_payment.html">
                            <field name="module_account_payment_provider" />
                            <div
                                class="mt-3 d-flex"
                                invisible="not module_account_payment_provider">
                                <field
                                    name="link_qr_code"
                                    string="Add QR-code link on PDF" />
                                <div>
                                    <label for="link_qr_code" />
                                    <br />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="account_batch_payment"
                            string="Batch Payments"
                            help="Group payments into a single batch to ease the reconciliation process"
                            documentation="/applications/finance/accounting/receivables/customer_payments/batch.html">
                            <field
                                name="module_account_batch_payment"
                                widget="upgrade_boolean" />
                        </setting>
                        <setting
                            id="collect_customer_payment"
                            string="SEPA Direct Debit (SDD)"
                            title="If you check this box, you will be able to collect payments using SEPA Direct Debit mandates."
                            help="Collect customer payments in one-click using Euro SEPA Service"
                            invisible="'SEPA' not in company_country_group_codes"
                            company_dependent="1"
                            documentation="/applications/finance/accounting/receivables/customer_payments/batch_sdd.html">
                            <field
                                name="module_account_sepa_direct_debit"
                                widget="upgrade_boolean"
                                class="oe_inline" />
                            <div
                                class="content-group"
                                invisible="not module_account_sepa_direct_debit">
                                <div class="text-warning mt16 mb4">
                                    Save this page and come back here to set up the feature.
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="qr_code_invoices"
                            string="QR Codes"
                            title="Add a QR-code to your invoices so that your customers can pay instantly with their mobile banking application."
                            help="Add a payment QR-code to your invoices"
                            company_dependent="1"
                            documentation="/applications/finance/accounting/receivables/customer_invoices/epc_qr_code.html">
                            <field name="qr_code" class="oe_inline" />
                        </setting>
                    </block>
                    <block id="account_vendor_bills" title="Vendor Bills">
                        <setting
                            id="autopost_bills"
                            help="Propose to validate bills automatically when AI accuracy is right 3 times in a row for a vendor.">
                            <field name="autopost_bills" />
                        </setting>
                    </block>
                    <block
                        id="print_vendor_checks_setting_container"
                        title="Vendor Payments">
                        <setting
                            id="print_checks"
                            string="Checks"
                            help="Print checks to pay your vendors"
                            groups="account.group_account_user"
                            company_dependent="1"
                            documentation="/applications/finance/accounting/payables/pay/check.html">
                            <field name="module_account_check_printing" />
                        </setting>
                        <setting
                            id="sepa_payments"
                            title="If you check this box, you will be able to register your payment using SEPA / ISO20022."
                            help="Pay your bills in one-click using Euro SEPA Service / ISO20022"
                            company_dependent="1"
                            documentation="/applications/finance/accounting/payables/pay/sepa.html">
                            <field
                                name="module_account_iso20022"
                                widget="upgrade_boolean" />
                        </setting>
                    </block>

                    <block id="account_digitalization" title="Digitization">
                        <setting
                            id="account_invoice_ocr_settings"
                            help="Read a bill's fields off its PDF or scan"
                            documentation="/applications/finance/accounting/payables/supplier_bills/invoice_digitization.html">
                            <field name="module_extract_account" />
                        </setting>
                        <setting
                            id="account_bank_statement_ocr_settings"
                            help="Read a scanned bank statement's balances and transactions">
                            <field
                                name="module_extract_account_bank_statement"
                                widget="upgrade_boolean" />
                        </setting>
                    </block>

                    <t groups="account.group_account_user">
                        <block id="default_accounts" title="Default Accounts">
                            <setting
                                string="Exchange difference entries:"
                                invisible="not group_multi_currency">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label
                                            for="currency_exchange_journal_id"
                                            string="Journal"
                                            class="col-lg-4 o_light_label" />
                                        <field name="currency_exchange_journal_id" />
                                    </div>
                                    <div class="row mt8">
                                        <label
                                            for="income_currency_exchange_account_id"
                                            string="Gain"
                                            class="col-lg-4 o_light_label" />
                                        <field
                                            name="income_currency_exchange_account_id" />
                                    </div>
                                    <div class="row mt8">
                                        <label
                                            for="expense_currency_exchange_account_id"
                                            string="Loss"
                                            class="col-lg-4 o_light_label" />
                                        <field
                                            name="expense_currency_exchange_account_id" />
                                    </div>
                                </div>
                            </setting>
                            <setting
                                id="post_bank_transactions_and_payments_setting"
                                string="Bank transactions and payments:">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label
                                            for="account_journal_suspense_account_id"
                                            class="col-lg-5 o_light_label" />
                                        <field
                                            name="account_journal_suspense_account_id" />
                                    </div>
                                    <div class="row mt8">
                                        <label
                                            for="transfer_account_id"
                                            class="col-lg-5 o_light_label" />
                                        <field name="transfer_account_id" />
                                    </div>
                                </div>
                            </setting>
                            <setting
                                string="Invoice line discounts:"
                                title="If empty, the discount will be discounted directly on the income/expense account. If set, discount on invoices will be realized in separate accounts.">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label
                                            for="account_discount_expense_allocation_id"
                                            string="Customer Invoices"
                                            class="col-lg-5 o_light_label" />
                                        <field
                                            name="account_discount_expense_allocation_id"
                                            placeholder="Same Account as product" />
                                    </div>
                                    <div
                                        class="row mt8"
                                        id="account_discount_income_allocation">
                                        <label
                                            for="account_discount_income_allocation_id"
                                            string="Vendor Bills"
                                            class="col-lg-5 o_light_label" />
                                        <field
                                            name="account_discount_income_allocation_id"
                                            placeholder="Same Account as product" />
                                    </div>
                                </div>
                            </setting>
                            <setting string="Early payment discounts:">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label
                                            for="account_journal_early_pay_discount_gain_account_id"
                                            class="col-lg-5 o_light_label" />
                                        <field
                                            name="account_journal_early_pay_discount_gain_account_id" />
                                    </div>
                                    <div class="row mt8">
                                        <label
                                            for="account_journal_early_pay_discount_loss_account_id"
                                            class="col-lg-5 o_light_label" />
                                        <field
                                            name="account_journal_early_pay_discount_loss_account_id" />
                                    </div>
                                </div>
                            </setting>
                            <setting id="product_accounts" string="Product Accounts:">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label
                                            for="income_account_id"
                                            class="col-lg-5 o_light_label" />
                                        <field name="income_account_id" />
                                    </div>
                                    <div class="row mt8">
                                        <label
                                            for="expense_account_id"
                                            class="col-lg-5 o_light_label" />
                                        <field name="expense_account_id" />
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </t>

                    <t groups="account.group_account_user">
                        <block id="bank_cash" title="Bank &amp; Cash">
                            <setting
                                string="QIF Import"
                                title="Once installed, set 'Bank Feeds' to 'File Import' in bank account settings.This adds a button to import from the Accounting dashboard."
                                help="Import your bank statements in QIF">
                                <field
                                    name="module_account_bank_statement_import_qif"
                                    widget="upgrade_boolean" />
                            </setting>
                        </block>
                    </t>

                    <t groups="account.group_account_user">
                        <block id="accounting_reports" title="Fiscal Periods">
                            <setting
                                id="fiscalyear"
                                groups="account.group_account_user"
                                invisible="1" />
                        </block>
                    </t>
                    <block
                        id="analytic"
                        title="Analytics"
                        groups="account.group_account_user">
                        <setting
                            id="track_costs_revenues"
                            title="Allows you to use the analytic accounting."
                            help="Track costs &amp; revenues by project, department, etc"
                            groups="account.group_account_user"
                            documentation="/applications/finance/accounting/others/analytic_accounting.html">
                            <field name="group_analytic_accounting" />
                        </setting>
                        <setting
                            id="account_budget"
                            title="This allows accountants to manage analytic and crossovered budgets. Once the master budgets and the budgets are defined, the project managers can set the planned amount on each analytic account."
                            help="Use budgets to compare actual with expected revenues and costs"
                            groups="account.group_account_user"
                            documentation="/applications/finance/accounting/others/adviser/budget.html">
                            <field
                                name="module_account_budget"
                                widget="upgrade_boolean" />
                        </setting>
                        <setting
                            id="monitor_product_margins"
                            string="Margin Analysis"
                            help="Monitor your product margins from invoices"
                            groups="account.group_account_user">
                            <field name="module_product_margin" />
                        </setting>
                    </block>
                    <block
                        id="account_reports_settings"
                        title="Reporting"
                        groups="account.group_account_user">
                        <setting
                            string="Restrictive Audit Trail"
                            help="Log changes to posted journal entries immutably"
                            invisible="force_restrictive_audit_trail"
                            company_dependent="1">
                            <field name="restrictive_audit_trail" />
                        </setting>
                    </block>
                    <field name="is_account_peppol_eligible" invisible="1" />
                    <block
                        id="peppol"
                        title="PEPPOL Electronic Invoicing"
                        invisible="not is_account_peppol_eligible">
                        <div
                            id="account_peppol_install"
                            class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="module_account_peppol" readonly="False" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label
                                    for="module_account_peppol"
                                    string="Enable PEPPOL" />
                                <div class="text-muted">
                                    Allow sending and receiving invoices through the PEPPOL network
                                </div>
                            </div>
                        </div>
                    </block>
                    <block
                        id="storno"
                        title="Storno Accounting"
                        groups="account.group_account_user"
                        invisible="not display_account_storno">
                        <setting
                            id="enable_storno_accounting"
                            help="Use negative numbers to reverse original entries"
                            company_dependent="1">
                            <field name="account_storno" />
                        </setting>
                    </block>
                    <block id="quick_edit_mode" title="Accounting Firms mode">
                        <div class="text-muted">
                            <p style="margin-bottom: 0">Accounting firm mode will change
                                invoice/bill encoding:</p>
                            <p style="margin-bottom: 0"> - The document's sequence becomes editable
                                on all documents.</p>
                            <p style="margin-bottom: 0"> - A new field « Total (tax inc.) » to speed
                                up and control the encoding by automating line creation with the
                                right account &amp; tax.</p>
                        </div>
                        <setting company_dependent="1">
                            <field name="quick_edit_mode" placeholder="Disabled" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_account_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'account', 'bin_size': False}</field>
    </record>

    <record id="res_config_settings_view_form_base_setup" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="web.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='%(web.action_base_document_layout_configurator)d']"
                position="attributes">
                <attribute name="name">%(account.action_base_document_layout_configurator)d</attribute>
                <attribute name="context">{'default_from_invoice': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
