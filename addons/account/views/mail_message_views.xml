<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_message_tree_audit_log" model="ir.ui.view">
        <field name="name">mail.message.list.inherit.audit.log</field>
        <field name="model">mail.message</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list
                type="object"
                create="0"
                edit="0"
                delete="0"
                action="action_view_document">
                <field name="date" />
                <field name="author_id" widget="many2one_avatar" />
                <field name="res_id" string="Name" />
                <field name="account_audit_log_preview" />
            </list>
        </field>
    </record>

    <record id="view_message_tree_audit_log_search" model="ir.ui.view">
        <field name="name">mail.message.search</field>
        <field name="model">mail.message</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Messages Search">
                <field name="account_audit_log_move_id" />
                <field name="account_audit_log_account_id" />
                <field name="account_audit_log_tax_id" />
                <field name="account_audit_log_partner_id" />
                <field name="account_audit_log_company_id" />
                <field name="author_id" />
                <field name="date" />
                <filter
                    name="account_move"
                    string="Journal Entry"
                    domain="[('model', '=', 'account.move')]" />
                <filter
                    name="account_account"
                    string="Account"
                    domain="[('model', '=', 'account.account')]" />
                <filter
                    name="account_tax"
                    string="Taxes"
                    domain="[('model', '=', 'account.tax')]" />
                <filter
                    name="res_partner"
                    string="Partners"
                    domain="[('model', '=', 'res.partner')]" />
                <filter
                    name="res_company"
                    string="Company"
                    domain="[('model', 'in', ('res.company', 'account.config'))]" />
                <separator />
                <field
                    name="tracking_value_ids"
                    string="Field Value"
                    filter_domain="[                     '|', ('tracking_value_ids.old_value_char', 'ilike', self),                     '|', ('tracking_value_ids.new_value_char', 'ilike', self),                     '|', ('tracking_value_ids.old_value_text', 'ilike', self),                          ('tracking_value_ids.new_value_text', 'ilike', self),                 ]" />
                <field
                    name="tracking_value_ids"
                    string="Field"
                    filter_domain="[('tracking_value_ids.field_id', 'ilike', self)]" />
                <separator />
                <filter
                    name="update_only"
                    string="Update"
                    domain="[('tracking_value_ids', '!=', False)]"
                    groups="base.group_system" />
                <filter
                    name="create_only"
                    string="Create"
                    domain="[('tracking_value_ids', '=', False)]"
                    groups="base.group_system" />
                <filter
                    name="restricted_by_audit_trail"
                    string="Restricted"
                    domain="[('account_audit_log_restricted', '=', True)]" />
                <separator />
                <filter name="date" string="Date" date="date" />
                <group>
                    <filter
                        name="group_by_date"
                        string="Date"
                        context="{'group_by': 'date'}" />
                    <filter
                        name="group_by_res_id"
                        string="Updated Data"
                        context="{'group_by': 'res_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_audit_trail_report" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">mail.message</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_message_tree_audit_log" />
        <field name="search_view_id" ref="view_message_tree_audit_log_search" />
        <field
            name="domain">[
            ('message_type', '=', 'notification'),
            ('model', 'in', ('account.move', 'account.account', 'account.tax', 'res.partner',
            'res.company', 'account.config')),
            ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">This is the Audit Trail Report</p>
        </field>
    </record>

</odoo>
