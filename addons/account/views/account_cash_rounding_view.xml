<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action -->
        <record id="rounding_list_action" model="ir.actions.act_window">
            <field name="name">Rounding Methods</field>
            <field name="res_model">account.cash.rounding</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first rounding method</p>
            </field>
        </record>

        <!-- Views -->
        <record id="rounding_form_view" model="ir.ui.view">
            <field name="name">account.cash.rounding.form</field>
            <field name="model">account.cash.rounding</field>
            <field name="arch" type="xml">
                <form string="Rounding Form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1 class="o_outlined">
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Rounding">
                                <field name="rounding"/>
                                <field name="rounding_method"/>
                                <field name="strategy"/>
                                <field name="profit_account_id" options="{'no_create': True}"
                                    context="{'search_default_incomeacc': 1}"
                                    invisible="strategy != 'add_invoice_line'" required="strategy == 'add_invoice_line'"
                                    groups="account.group_account_invoice,account.group_account_readonly"/>
                                <field name="loss_account_id" options="{'no_create': True}"
                                    context="{'search_default_expensesacc': 1}"
                                    invisible="strategy != 'add_invoice_line'" required="strategy == 'add_invoice_line'"
                                    groups="account.group_account_invoice,account.group_account_readonly"/>
                            </group>
                            <group string="Conditions">
                                <field name="currency_ids" widget="many2many_tags"/>
                                <field name="partner_category_ids" widget="many2many_tags"/>
                                <field name="payment_method_line_ids" widget="many2many_tags"/>
                                <field name="company_id" groups="base.group_multi_company" placeholder="Visible to all"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rounding_search_view" model="ir.ui.view">
            <field name="name">account.cash.rounding.search</field>
            <field name="model">account.cash.rounding</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="rounding_tree_view" model="ir.ui.view">
            <field name="name">account.cash.rounding.list</field>
            <field name="model">account.cash.rounding</field>
            <field name="arch" type="xml">
                <list string="Rounding List" editable="bottom" open_form_view="True">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="rounding"/>
                    <field name="strategy"/>
                    <field name="rounding_method"/>
                    <field name="currency_ids" widget="many2many_tags" optional="hide"/>
                    <field name="partner_category_ids" widget="many2many_tags" optional="hide"/>
                    <field name="payment_method_line_ids" widget="many2many_tags" optional="hide"/>
                </list>
            </field>
        </record>

    </data>
</odoo>
