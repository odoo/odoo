<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <record id="res_groups_privilege_accounting" model="res.groups.privilege">
            <field name="name">Accounting</field>
            <field name="category_id" ref="base.module_category_accounting" />
            <field name="sequence">7</field>
        </record>
        <record id="group_delivery_invoice_address" model="res.groups">
            <field name="name">Delivery Address</field>
        </record>
        <record id="group_account_readonly" model="res.groups">
            <field name="name">Read-only</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_accounting" />
            <field
                name="comment">Access to all Accounting data, journal entries, configuration and reports included, but in read-only mode, no actions allowed.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_account_invoice" model="res.groups">
            <field name="name">Invoicing</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_accounting" />
            <field
                name="comment">Invoices, payments and basic invoice reporting.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('base.group_user')), Command.link(ref('group_account_readonly'))]" />
        </record>
        <record id="group_account_basic" model="res.groups">
            <field name="name">Invoicing &amp; Banks</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_accounting" />
            <field
                name="comment">adds the accounting dashboard, bank management and follow-up reports.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_account_invoice')), Command.unlink(ref('group_account_readonly'))]" />
        </record>
        <record id="group_account_user" model="res.groups">
            <field name="name">Show Full Accounting Features</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_account_basic'))]" />
        </record>
        <record id="group_fiscal_year" model="res.groups">
            <field
                name="name">Allow to define fiscal years of more or less than a year</field>
        </record>
        <record id="group_account_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="res_groups_privilege_accounting" />
            <field name="comment">Full access, including configuration rights.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_account_invoice')), Command.link(ref('group_account_basic'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
        <record id="group_account_secured" model="res.groups">
            <field name="name">Show Inalterability Features</field>
        </record>
        <record id="group_cash_rounding" model="res.groups">
            <field name="name">Allow the cash rounding management</field>
        </record>
        <record id="group_partial_purchase_deductibility" model="res.groups">
            <field name="name">Partial Purchase Deductibility</field>
        </record>
        <record id="res_group_privilege_accounting_bank" model="res.groups.privilege">
            <field name="name">Bank</field>
            <field name="sequence">50</field>
            <field name="category_id" ref="base.module_category_accounting" />
        </record>
        <record id="group_validate_bank_account" model="res.groups">
            <field name="name">Validate bank account</field>
            <field name="privilege_id" ref="res_group_privilege_accounting_bank" />
            <field
                name="implied_by_ids"
                eval="[Command.link(ref('base.group_system'))]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="access_res_partner_bank_account_company_manager" model="ir.access">
            <field
                name="name">Accounting: managers set up their companies' bank accounts</field>
            <field name="model_id" ref="base.model_res_partner_bank_account" />
            <field name="group_id" ref="account.group_account_manager" />
            <field name="kind">permission</field>
            <field name="operation">cu</field>
            <field
                name="domain">[('partner_id', 'in', user.company_ids.partner_id.ids)]</field>
        </record>
    </data>

</odoo>
