<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_bank_auto_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">account.bank.auto.reconcile.wizard.form</field>
        <field name="model">account.bank.auto.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Run auto-reconciliation">
                <field name="company_id" invisible="1" />
                <group>
                    <field
                        name="journal_id"
                        options="{'no_create': True, 'no_open': True}" />
                    <field name="from_date" />
                    <field name="to_date" />
                </group>
                <footer>
                    <button
                        name="action_auto_reconcile"
                        type="object"
                        string="Reconcile"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button string="Discard" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_bank_auto_reconcile_wizard" model="ir.actions.act_window">
        <field name="name">Run auto-reconciliation</field>
        <field name="res_model">account.bank.auto.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_bank_statement_line" />
        <field name="binding_view_types">list</field>
    </record>

</odoo>
