<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_split_journal_item_wizard_form" model="ir.ui.view">
        <field name="name">account.split.journal.item.wizard.form</field>
        <field name="model">account.split.journal.item.wizard</field>
        <field name="arch" type="xml">
            <form string="Split">
                <field name="line_ids" invisible="1" />
                <field name="line_currency_id" invisible="1" />
                <field name="show_simple_wizard" invisible="1" />
                <group>
                    <field name="quantity" />
                    <field name="amount" invisible="show_simple_wizard" />
                    <field
                        name="account_id"
                        invisible="show_simple_wizard"
                        options="{'no_create': True}" />
                </group>
                <footer>
                    <button
                        name="split"
                        type="object"
                        string="Split"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button string="Discard" special="cancel" data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
