<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_tax_merge_wizard_form" model="ir.ui.view">
        <field name="name">account.tax.merge.wizard.form</field>
        <field name="model">account.tax.merge.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="disable_merge_button" invisible="1" />
                <group>
                    <field name="wizard_line_ids" colspan="4" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field
                                name="is_selected"
                                nolabel="1"
                                invisible="display_type == 'line_section'" />
                            <field name="tax_id" force_save="1" />
                            <field name="company_ids" widget="many2many_tags" />
                            <field
                                name="info"
                                decoration-danger="display_type == 'tax'" />
                            <field name="sequence" column_invisible="1" />
                            <field name="grouping_key" column_invisible="1" />
                            <field name="display_type" column_invisible="1" />
                            <field name="tax_has_hashed_entries" column_invisible="1" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_merge"
                        type="object"
                        string="Merge"
                        invisible="disable_merge_button"
                        class="oe_highlight"
                        data-hotkey="q" />
                    <button
                        name="action_merge"
                        type="object"
                        string="Merge"
                        invisible="not disable_merge_button"
                        class="oe_highlight disabled"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="account_tax_merge_wizard_action" model="ir.actions.act_window">
        <field name="name">Merge Taxes…</field>
        <field name="res_model">account.tax.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" eval="ref('account.account_tax_merge_wizard_form')" />
        <field name="target">new</field>
        <field name="binding_model_id" ref="account_tax.model_account_tax" />
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="binding_icon">fa-solid fa-code-merge</field>
        <field
            name="group_ids"
            eval="[Command.set([ref('account.group_account_manager')])]" />
    </record>

    <record id="action_unmerge_taxes" model="ir.actions.server">
        <field name="name">Unmerge Tax</field>
        <field name="model_id" ref="account_tax.model_account_tax" />
        <field name="binding_model_id" ref="account_tax.model_account_tax" />
        <field name="binding_view_types">form,list</field>
        <field name="binding_icon">fa-solid fa-code-fork</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('account.group_account_manager'))]" />
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_unmerge()</field>
    </record>

</odoo>
