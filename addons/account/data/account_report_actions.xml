            <field name="model_id" ref="account.model_report_formula" />
            <field name="binding_model_id" ref="account.model_report_formula" />
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field
                name="code">if records:
    action = records._create_menu_item_for_report()</field>
        </record>
        <record id="action_account_report_tree" model="ir.actions.act_window">
