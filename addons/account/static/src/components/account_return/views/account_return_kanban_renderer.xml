<?xml version="1.0" encoding="utf-8"?>

<templates>
    <t t-name="account.account_return_kanban_renderer">

        <div class="o_kanban_renderer o_renderer o_account-return-kanban">
            <t t-if="this.groups">
                <t t-foreach="this.groups" t-as="group" t-key="group.key">
                    <t t-if="group.count > 0">
                        <span class="return-group-header">
                            <t t-out="group.displayName"/>
                        </span>
                        <t t-call="account.return_list" list="group.list"/>
                    </t>
                </t>
            </t>
            <t t-else="" t-call="account.return_list" list="this.props.list"/>
        </div>
    </t>

    <t t-name="account.return_list">
        <t t-foreach="list.records" t-as="record" t-key="record.id">
            <AccountReturnKanbanRecord
                record="record"
                archInfo="this.props.archInfo"
                Compiler="this.props.Compiler"
                readonly="false"
                forceGlobalClick="false"
                canResequence="false"
                deleteRecord.bind="this.deleteRecord"
                openRecord.bind="this.openRecord"
            />
        </t>
    </t>
</templates>
