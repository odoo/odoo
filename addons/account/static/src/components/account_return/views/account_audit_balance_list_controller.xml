<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="account.account_audit_balance_list_controller" t-inherit="web.ListView">
        <xpath expr="//ViewLayout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button
                    data-tooltip="Chatter"
                    class="btn btn-secondary o_switch_view o_kanban active"
                    t-att-class="{
                        'd-none': !this.chatterService.chatterState.res_id,
                        'd-md-inline': this.chatterService.chatterState.res_id,
                    }">
                        <i t-attf-class="fa-solid fa-xmark mt-1"/>
                </button>
            </t>
        </xpath>

        <xpath expr="//SelectionBox" position="before">
            <div t-if="this.model.root.selection.length &gt; 1" t-on-click="this.openJournalItems">
                <button class="btn btn-secondary">
                    <i class="fa-solid fa-list me-1"></i>
                    <span>Journal Items</span>
                </button>
            </div>
        </xpath>
    </t>
</templates>
