<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account.AccountReturnSelectionBadgeField">
        <t t-if="this.editableOptions.includes(this.value)">
            <Dropdown>
                <button t-attf-class="btn {{ this.getDropdownButtonDecoration(this.value) }} d-flex justify-content-center align-items-center rounded-pill o_account_return_selection_badge_button {{ this.additionalClassName }}">
                    <div t-out="this.display || '&#8203;'"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem
                        class="'account-return-selection-badge-dropdown-item'"
                        t-if="!this.required || !this.value"
                        t-out="this.props.placeholder || ''"
                        onSelected="() => this.onChange(false)"
                    />
                    <t t-foreach="this.options" t-as="option" t-key="option[0]">
                        <t t-if="this.editableOptions.includes(option[0])">
                            <DropdownItem
                                class="'d-flex text-black align-items-center account-return-selection-badge-dropdown-item'"
                                onSelected="() => this.onChange(option[0])"
                            >
                                <div class="rounded-circle me-2" style="width: 10px; height: 10px;" t-att-class="this.getDropdownItemDecoration(option[0])"/>
                                <span t-out="option[1]"/>
                            </DropdownItem>
                        </t>
                    </t>
                </t>
            </Dropdown>
        </t>
        <t t-else="">
            <div
                class="cursor-default"
                t-on-click="(ev) => ev.stopPropagation()"
            >
                <button
                    t-attf-class="btn {{ this.getDropdownButtonDecoration(this.value) }} d-flex justify-content-center align-items-center rounded-pill o_account_return_selection_badge_button {{ this.additionalClassName }}"
                    t-att-disabled="true"
                >
                    <div t-out="this.display || '&#8203;'"/>
                </button>
            </div>
        </t>
    </t>

</templates>
