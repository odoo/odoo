<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account.tax_tag_popover_template">
        <div class="bg-view rounded-0 mw-100">

            <div class="p-2 border-bottom bg-light d-flex justify-content-between align-items-center">
                <span class="fw-bold">Tax Distribution</span>
                <button type="button" class="btn-close" t-on-click="props.close" tabindex="-1"/>
            </div>

            <div class="p-2 o_invoice_tax_summary">

                <span t-if="props.description" class="text-capitalize d-block fs-6" t-out="props.description"/>

                <div class="mt-2 fs-6 o_tax_distribution_grid">
                    <t t-call="account.tax_tag_popover_row">
                        <t t-set="label">Invoice</t>
                        <t t-set="lines" t-value="props.invoiceLines"/>
                    </t>
                    <t t-call="account.tax_tag_popover_row">
                        <t t-set="label">Credit Note</t>
                        <t t-set="lines" t-value="props.refundLines"/>
                    </t>
                </div>

            </div>
        </div>
    </t>

    <t t-name="account.tax_tag_popover_row">
        <t t-if="lines.length">
            <div class="fw-bold text-nowrap" t-out="label"/>
            <div>
                <span class="text-muted me-1">Base</span>
                <span class="font-monospace text-dark" t-out="formatTags(lines, 'base')"/>
            </div>
            <div>
                <span class="text-muted me-1">Tax</span>
                <span class="font-monospace text-dark" t-out="formatTags(lines, 'tax')"/>
            </div>
        </t>
    </t>

</templates>
