<templates>
    <t t-name="account.SectionRow">
        <li
            class="list-group-item border-0 o_section px-0"
            t-attf-class="{{this.isSubsection &amp;&amp; !this.env.isSmall ? 'o_treeEntry' : ''}}"
            t-att-data-id="this.props.id"
        >

            <div
                t-attf-class="o_section_row list-group-item list-group-item-action d-flex align-items-center gap-1 border-0 cursor-pointer
                    {{this.isSubsection ? 'o_subsection_row' : ''}} {{this.isSelected &amp;&amp; !this.props.editing ? 'o_selected_section' : ''}}
                "
                t-on-click="() => this.env.setSelectedSection(this.props.id)"
            >
                <button
                    class="o_toggle_fold btn border-0 rounded-end-0 px-0 bg-transparent"
                    t-att-class="this.hasChildren ? '' : 'opacity-0 pe-none'"
                    t-att-data-icon="this.props.isOpen ? 'arrow_drop_down' : 'arrow_right'"
                    t-att-tabindex="this.hasChildren ? '0' : '-1'"
                    t-on-click.stop="() => this.env.toggleSection(this.props.id)"
                />

                <input
                    t-if="this.props.editing"
                    class="o_section_input"
                    type="text"
                    t-att-value="this.props.name"
                    t-on-keydown="(ev) => this.env.onSectionInputKeydown(ev, this.props.id)"
                    t-on-blur="(ev) => this.env.renameSection(this.props.id, ev.target.value)"
                    t-ref="this.InputRef"
                />

                <div
                    t-else=""
                    tabindex="0"
                    class="o_search_panel_label d-flex align-items-center w-100 overflow-hidden"
                    t-on-keydown="(ev) => this.onSectionLabelKeydown(ev)"
                    t-att-title="this.props.name"
                >
                    <span
                        t-attf-class="o_search_panel_label_title d-flex align-items-center flex-grow-1 {{this.isSelected ? 'fw-bold' : ''}}"
                    >
                        <span
                            class="text-truncate me-1"
                            t-att-style="'max-width: ' + (this.env.isSmall ? '200px' : '130px')"
                            t-out="this.props.name"
                        />
                        <span
                            t-if="this.env.showSectionAmounts"
                            class="ms-auto text-muted o_section_subtotal"
                            t-out="this.env.formatAmount(this.props.subtotal)"
                        />
                        <div
                            t-if="this.isSelected"
                            class="ms-auto align-items-center o_section_toggle"
                        >
                            <span class="me-2">Filter</span>
                            <div class="form-check form-switch mb-0 small py-0">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    role="switch"
                                    t-att-checked="this.isFiltered"
                                    t-on-click="() => this.env.toggleSectionFilter()"
                                />
                            </div>
                        </div>
                    </span>
                </div>
                <Dropdown noClasses="true">
                    <button
                        t-attf-class="o_section_dropdown_button btn border-0 bg-transparent rounded-start-0 px-2 {{this.props.id ? '' : 'opacity-0 pe-none'}}"
                        t-att-tabindex="this.props.id ? '0' : '-1'"
                    >
                        <i class="oi text-muted" data-icon="more_vert"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem
                            t-if="this.isSection"
                            closingMode="'closest'"
                            onSelected="() => this.env.enableSectionInput(this.props.id)"
                        >
                            <i class="me-1 oi oi-fw" data-icon="subdirectory_arrow_right"/><span>Add a subsection</span>
                        </DropdownItem>
                        <DropdownItem
                            closingMode="'closest'"
                            onSelected="() => this.env.enableRenameSectionInput(this.props.id)"
                        >
                            <i class="me-1 oi oi-fw oi-filled" data-icon="edit"/><span>Rename</span>
                        </DropdownItem>
                        <DropdownItem
                            closingMode="'closest'"
                            onSelected="() => this.env.duplicateSection(this.props.id)"
                        >
                            <i class="me-1 oi oi-fw" data-icon="content_copy"/><span>Duplicate</span>
                        </DropdownItem>
                        <DropdownItem
                            closingMode="'closest'"
                            class="'text-danger'"
                            onSelected="() => this.env.deleteSection(this.props.id)"
                        >
                            <i class="me-1 oi oi-fw oi-filled" data-icon="delete"/><span>Delete</span>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>

            <ul t-if="this.props.isOpen" class="list-group border-0">
                <t t-foreach="this.props.children" t-as="child" t-key="child.id">
                    <SectionRow t-props="child"/>
                </t>
            </ul>
        </li>
    </t>
</templates>
