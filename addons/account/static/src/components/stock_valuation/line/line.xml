<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account.StockValuationReport.InventoryValuationLine">
        <tr t-att-class="this.cssClass">
            <td class="line_name w-50" t-on-click="this.onClick">
                <div class="wrapper">
                    <t t-if="this.label">
                        <a t-if="this.props.onClickMethod" href="#" style="white-space: pre-line" t-out="this.label"/>
                        <span t-else="" style="white-space: pre-line" t-out="this.label"/>
                    </t>
                </div>
            </td>
            <td class="w-25">
                <div t-if="this.formattedValue" t-out="this.formattedValue"/>
                <div t-elif="this.debit" t-out="this.debit"/>
            </td>
            <td class="w-25">
                <div t-if="this.credit" t-out="this.credit"/>
            </td>
            <td t-on-click="this.onClickToggle">
                <button t-attf-class="btn btn_foldable#{this.props.sublines ? '' : '_empty'}"
                        t-att-tabindex="this.props.lines ? 0 : -1">
                    <i t-if="this.hasSublines"
                        class="oi"
                        t-att-data-icon="this.state.displaySublines ? 'folder_open' : 'folder'"/>
                </button>
            </td>
        </tr>
        <t t-if="this.state.displaySublines &amp;&amp; this.hasSublines">
            <t t-foreach="this.props.sublines" t-as="line" t-key="line_index">
                <StockValuationReportLine
                    label="line.display_name || line.label"
                    line="line"
                    sublines="line.lines"
                    level="this.props.level + 2"
                    onClickMethod="line.method"
                    value="line.value"/>
            </t>
        </t>
    </t>
</templates>
