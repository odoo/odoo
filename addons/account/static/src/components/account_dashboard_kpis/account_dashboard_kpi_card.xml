<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account.AccountDashboardKpiCard">
        <button
            type="button"
            class="o_card o_account_dashboard_kpi_card btn text-start"
            t-att-class="{'o_account_dashboard_kpi_invoice_layout_card': this.props.card.is_invoice_layout_card}"
            t-att-disabled="!this.props.card.action_id"
            t-on-click="this.onClick"
        >
            <span class="o_account_dashboard_kpi_content">
                <span class="o_account_dashboard_kpi_header">
                    <span class="o_account_dashboard_kpi_name" t-out="this.props.card.name"/>
                    <span
                        t-if="this.props.card.period"
                        class="o_account_dashboard_kpi_period"
                        t-out="this.props.card.period"
                    />
                </span>
                <span
                    t-if="this.props.card.has_total"
                    class="o_account_dashboard_kpi_value"
                    t-out="this.props.card.value"
                />
            </span>

            <img
                t-if="this.props.card.image"
                class="o_account_dashboard_kpi_image"
                t-att-src="this.props.card.image"
                alt=""
            />

            <span t-if="this.props.card.values" class="o_account_dashboard_kpi_values">
                <span
                    t-foreach="this.props.card.values"
                    t-as="value"
                    t-key="value.label"
                    class="o_account_dashboard_kpi_value_item"
                >
                    <span class="o_account_dashboard_kpi_value_label" t-out="value.label"/>
                    <span class="o_account_dashboard_kpi_value_amount" t-out="value.value"/>
                </span>
            </span>
        </button>
    </t>

</templates>
