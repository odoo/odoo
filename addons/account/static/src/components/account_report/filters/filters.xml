<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account.AccountReportFilters">
        <t t-call="{{ env.template('AccountReportFilters') }}"/>
    </t>

    <t t-name="account.AccountReportFiltersCustomizable">
        <!-- Date filter -->
        <t t-if="'date' in controller.cachedFilterOptions">
            <div id="filter_date" class="filter_date">
                <t t-call="account.AccountReportFilterDate"/>
            </div>
        </t>

        <!-- Comparison filter -->
        <t t-if="controller.filters.show_period_comparison">
            <div id="filter_comparison" class="filter_comparison">
                <t t-call="account.AccountReportFilterComparison"/>
            </div>
        </t>

        <!-- Partner filter -->
        <t t-if="'partner' in controller.cachedFilterOptions">
            <div id="filter_partner" class="filter_partner">
                <t t-call="account.AccountReportFilterPartner"/>
            </div>
        </t>

        <!-- Extra cachedFilterOptions filter -->
        <t t-if="hasExtraOptionsFilter">
            <div id="filter_extra_options">
                <t t-call="account.AccountReportFilterExtraOptions"/>
            </div>
        </t>

        <!-- Variant filter -->
        <t t-if="controller.cachedFilterOptions.available_variants.length > 1">
            <div id="filter_variant">
                <t t-call="account.AccountReportFilterVariant"/>
            </div>
        </t>

        <div id="filter_rounding_unit">
            <t t-call="account.AccountReportFilterRoundingUnit"/>
        </div>

        <t t-if="env.debug">
            <div id="filter_configuration" class="o-dropdown dropdown o-dropdown--no-caret">
                <button
                    class="btn btn-secondary"
                    t-on-click="(ev) => this.controller.reportAction(ev, 'action_view_report_form', {}, true)"
                >
                    <i class="fa-solid fa-cogs me-1"/>
                </button>
            </div>
        </t>
    </t>
</templates>
