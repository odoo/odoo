<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="account.MatchingLink">
        <t t-if="this.props.record.context.is_matched_view">
            <span t-out="this.props.record.data[this.props.name]" t-attf-class="o_tag o_badge badge rounded-pill {{'o_tag_color_' + this.colorCode}}"/>
        </t>
        <t t-elif="this.props.record.data[this.props.name]">
            <a href='#' t-on-click.prevent="this.viewMatch" t-attf-class="o_tag o_badge badge rounded-pill {{'o_tag_color_' + this.colorCode}}">
                <span t-out="this.props.record.data[this.props.name]"/>
            </a>
        </t>
    </t>

</templates>
