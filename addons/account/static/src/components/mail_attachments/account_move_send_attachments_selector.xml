<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="account.AccountMoveSendAttachmentsSelector">
        <FileUploader multiUpload="true" onUploaded.bind="this.onFileUploaded">
            <t t-set-slot="toggler">
                <span class="d-none" t-ref="this.fileUploadTriggerRef"/>
            </t>
            <Dropdown menuClass="'account-move-send-attachments-selector-dropdown d-flex flex-column'" disabled="this.dropdownAttachments.length == 0">
                <button class="btn btn-light w-auto position-relative mx-2" data-hotkey="a"
                    title="Add Attachment"
                    t-on-click="() => this.triggerFileUpload(this.dropdownAttachments.length == 0)">
                    <i class="oi oi-fw" data-icon="attach_file" />
                    <span t-if="this.availableAttachmentsCount"
                        class="badge rounded-pill text-bg-danger position-absolute top-0 start-100 translate-middle">
                        <t t-out="this.availableAttachmentsCount" />
                    </span>
                </button>
                <t t-set-slot="content">
                    <div class="overflow-y-auto">
                        <t t-foreach="this.dropdownAttachments" t-as="attachment" t-key="attachment_index">
                            <DropdownItem class="'text-truncate px-3'" onSelected="() => this.deleteSkip(attachment)">
                                <t t-out="attachment.name"/>
                            </DropdownItem>
                        </t>
                        <DropdownItem class="'px-3'" onSelected="() => this.triggerFileUpload()">
                            <a href="#">Add...</a>
                        </DropdownItem>
                    </div>
                </t>
            </Dropdown>
        </FileUploader>
    </t>
</templates>
