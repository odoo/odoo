<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="account.BankRecoKanbanController" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//ViewLayout" position="attributes">
            <attribute name="contentClassName">'o_bank_reconciliation_container d-flex'</attribute>
        </xpath>

        <xpath expr="//ViewLayout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <button
                    t-on-click="() => this.bankReconciliation.toggleChatter()"
                    data-tooltip="Chatter"
                    class="btn btn-secondary o_switch_view o_kanban d-none d-md-inline bank-chatter-btn"
                    t-att-class="{'active': this.bankReconciliation.chatterState.visible}">
                    <i t-attf-class="fa-fw {{ this.bankReconciliation.chatterState.visible ? 'fa-solid fa-xmark' : 'fa-regular fa-comments' }} mt-1"/>
                </button>
            </t>
        </xpath>
    </t>
</templates>
