<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="account.AgedPartnerBalanceLineName" t-inherit="report_formula.AccountReportLineNameCustomizable">
        <xpath expr="//td[@data-id='line_name']" position="attributes">
            <t t-if="this.props.line.unfoldable">
                <attribute name="class" add="more" separator=" "/>
            </t>
        </xpath>

        <xpath expr="//t[@data-id='line_buttons']" position="inside">
            <t t-if="this.props.line.unfoldable and this.modelName === 'res.partner'">
                <button
                    class="btn btn_action"
                    t-on-click="(ev) => this.controller.reportAction(ev, 'caret_option_open_record_form', { line_id: this.props.line.id })"
                >
                    Partner
                </button>

                <button
                    class="btn btn_action"
                    t-on-click="(ev) => this.controller.reportAction(ev, 'open_customer_statement', { line_id: this.props.line.id })"
                >
                    Statement
                </button>
            </t>
        </xpath>

        <xpath expr="//button[@data-id='btn_foldable']" position="after">
            <t t-if="this.props.line.trust === 'good'">
                <i class="fa-solid fa-circle text-success partner_trust" title="Partner is good"/>
            </t>
            <t t-elif="this.props.line.trust === 'bad'">
                <i class="fa-solid fa-circle text-danger partner_trust" title="Partner is bad"/>
            </t>
        </xpath>

    </t>
</templates>
