<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="account.AccountReportLineNameCustomizable" t-inherit-mode="extension">
        <xpath expr="//div[@data-id='content']/t[@t-component]" position="after">
                        <AccountReturnSelectionBadge
                            t-if="this.accountStatus.record"
                            options="this.accountStatusBadgeOptions"
                            record="this.accountStatus.record"
                            readonly="false"
                            name="'status'"
                            class="'ms-2'"
                            size="'small'"
                            />
        </xpath>
    </t>
</templates>
