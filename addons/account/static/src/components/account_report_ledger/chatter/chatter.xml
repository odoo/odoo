<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="report_formula.AccountReportCustomizable" t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='root']" position="attributes">
            <attribute name="t-on-keydown">onKeydown</attribute>
            <attribute name="t-on-click">onClick</attribute>
        </xpath>
        <xpath expr="//ControlPanel" position="inside">
                <t t-set-slot="control-panel-navigation-additional" t-if="controller.chatterState.lineId">
                    <button
                        t-on-click="() => controller.closeChatter()"
                        data-tooltip="Chatter"
                        class="btn btn-secondary o_switch_view o_kanban d-inline"
                        t-att-class="{'active': controller.chatterState.model}">
                            <i t-attf-class="fa-fw {{ controller.chatterState.model ? 'fa-solid fa-xmark' : 'fa-regular fa-comments' }} mt-1"/>
                    </button>
                </t>
        </xpath>
        <xpath expr="//div[hasclass('o_content')]/div[1]" position="inside">
                    <t t-if="ui.isSmall"> <!-- Spacer to avoid chatter overlapping content on small devices due to the fixed position of the chatter -->
                        <div
                            style="transition: height 0.2s ease-in-out;"
                            t-att-style="controller.chatterState.id ? 'height: 60vh;' : 'height: 0;'"
                        />
                    </t>
        </xpath>
        <xpath expr="//div[hasclass('o_content')]" position="inside">
                <div t-att-class="{
                        'o_account_report_chatter o-mail-ChatterContainer h-100 o-aside d-flex flex-column': !ui.isSmall,
                        'o_account_report_chatter_hidden': !ui.isSmall &amp;&amp; !controller.chatterState.id,
                        'o_account_report_mobile_chatter': ui.isSmall,
                        'o_account_report_mobile_chatter_hidden': ui.isSmall &amp;&amp; !controller.chatterState.id,
                    }"
                >
                    <t t-if="controller.chatterState.model">
                        <AccountReportChatter
                            threadModel="controller.chatterState.model"
                            threadId="controller.chatterState.id"
                            isChatterAside="!ui.isSmall"
                            reportController="controller"
                            date_to="controller.options.date.date_to"
                        />
                    </t>
                </div>
        </xpath>
    </t>

    <t t-inherit="report_formula.AccountReportLineNameCustomizable" t-inherit-mode="extension">
        <xpath expr="//t[@data-id='line_buttons']" position="before">
                        <button
                            tabindex="-1"
                            class="btn btn_annotation"
                            t-on-click="openChatter"
                            t-if="this.props.line.chatter"
                            t-att-class="{
                                'o_account_report_chatter_selected': isChatterSelected,
                                'o_account_report_chatter_annoted': isChatterAnnotated,
                            }">
                            <i class="fa-solid fa-comment-dots" t-if="isChatterSelected || isChatterAnnotated"/>
                            <i class="fa-regular fa-comment-dots" t-else=""/>
                        </button>
        </xpath>
    </t>
</templates>
