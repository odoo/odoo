<templates>

    <t t-name="account.DashboardKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='this.rootRef']" position="before">
            <div t-if="this.coaState.showBanner" class="alert alert-info alert-dismissible d-flex align-items-center p-3 m-3" role="alert">
                <span>
                    You have updates in <strong><t t-out="this.coaState.coaName"/></strong>.
                    <button type="button" class="btn btn-link p-0 align-baseline mx-2" t-on-click="this.reloadCoa">Reload COA</button>
                </span>
                <button type="button" class="btn-close" t-on-click="this.skipCoa" aria-label="Close"></button>
            </div>
        </xpath>
        <xpath expr="//div[@t-ref='this.rootRef']" position="attributes">
            <attribute name="t-on-dragenter.prevent">this.kanbanDragEnter</attribute>
            <attribute name="t-on-dragleave">this.kanbanDragLeave</attribute>
            <attribute name="t-on-drop.prevent">this.kanbanDragDrop</attribute>
            <attribute name="t-on-dragover.prevent">() => {}</attribute>
        </xpath>

        <xpath expr="//div[@t-ref='this.rootRef']/t[1]" position="before">
            <AccountDashboardKpis/>
        </xpath>
    </t>

</templates>
