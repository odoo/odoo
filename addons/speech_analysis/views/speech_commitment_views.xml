<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="speech_commitment_view_list" model="ir.ui.view">
        <field name="name">speech.commitment.view.list</field>
        <field name="model">speech.commitment</field>
        <field name="arch" type="xml">
            <list string="Commitments" create="0">
                <field name="name" />
                <field name="speaker_id" />
                <field name="partner_id" optional="show" />
                <field name="done" widget="boolean_toggle" />
                <field name="due_date" />
                <field name="at_s" optional="hide" />
                <field name="res_model" optional="hide" />
                <field name="res_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="speech_commitment_view_search" model="ir.ui.view">
        <field name="name">speech.commitment.view.search</field>
        <field name="model">speech.commitment</field>
        <field name="arch" type="xml">
            <search string="Commitments">
                <field name="name" />
                <field name="partner_id" />
                <filter name="open" string="Open" domain="[('done', '=', False)]" />
                <filter
                    name="mine"
                    string="Mine"
                    domain="[('partner_id.user_ids', 'in', [uid])]" />
            </search>
        </field>
    </record>

    <record id="speech_commitment_action" model="ir.actions.act_window">
        <field name="name">Commitments</field>
        <field name="res_model">speech.commitment</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
