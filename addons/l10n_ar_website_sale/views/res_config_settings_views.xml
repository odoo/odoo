<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='res_config_settings_view_form' model='ir.ui.view'>
        <field name='name'>res.config.settings.view.form.inherit.website.sale</field>
        <field name='model'>res.config.settings</field>
        <field name='inherit_id' ref='website_sale.res_config_settings_view_form'/>
        <field name='arch' type='xml'>
            <setting id='website_tax_inclusion_setting' position='inside'>
                <div invisible='country_code != "AR" or show_line_subtotals_tax_selection != "tax_included"'>
                    <field name='l10n_ar_website_sale_show_both_prices'/>
                    <label for='l10n_ar_website_sale_show_both_prices'/>
                </div>
            </setting>
            <setting id='website_tax_inclusion_setting' position='after'>
                <setting
                    id='l10n_ar_final_consumer_limit_setting'
                    string='Final Consumer Max Amount'
                    help='Above this amount, Final Consumers must provide a DNI at checkout.'
                    invisible='country_code != "AR"'
                >
                    <field name='l10n_ar_final_consumer_limit'/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
