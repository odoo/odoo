<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="l10n_ar_website_sale_product_price_inherit" inherit_id="website_sale.product_price">
        <del name="editable_compare_list_price" position="after">
            <small
                name="l10n_ar_price_tax_excluded"
                t-attf-class="
                    o_l10n_ar_price_tax_excluded {{_l10n_ar_price_tax_excluded_classes or 'h6 mb-0'}}
                    {{not price_info.get('l10n_ar_price_tax_excluded') and 'd-none'}}
                "
            >
                Precio s/Imp. Nac.:
                <span
                    class="bidi-isolate"
                    t-out="price_info.get('l10n_ar_price_tax_excluded', 0)"
                    t-options="{'widget': 'monetary', 'display_currency': price_info['currency']}"
                />
            </small>
        </del>
    </template>

    <template id="l10n_ar_website_sale_products_item_inherit" inherit_id="website_sale.products_item">
        <xpath expr="//t[@name='product_base_price']" position="after">
            <small
                name="l10n_ar_price_tax_excluded"
                t-attf-class="
                    o_l10n_ar_price_tax_excluded text-muted
                    {{not template_price_vals.get('l10n_ar_price_tax_excluded') and 'd-none' or 'd-block'}}
                "
            >
                Precio s/Imp. Nac.:
                <span
                    class="bidi-isolate"
                    t-out="template_price_vals.get('l10n_ar_price_tax_excluded', 0)"
                    t-options="{'widget': 'monetary', 'display_currency': template_price_vals['currency']}"
                />
            </small>
        </xpath>
    </template>

</odoo>
