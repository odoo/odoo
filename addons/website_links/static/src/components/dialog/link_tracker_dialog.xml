<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="website_links.LinkTrackerDialogButtons" t-inherit="web.FormViewDialog.ToOne.buttons">
        <xpath expr="//button[hasclass('o_form_button_save')]" position="replace">
            <button class="btn btn-primary o_form_button_save" t-on-click="this.saveButtonClicked" data-hotkey="c">Create &amp; Copy</button>
        </xpath>
        <xpath expr="." position="inside">
            <button class="btn btn-link o_website_links_manage ms-auto align-self-center" t-on-click="this.manageTrackedLinks">Manage tracked links</button>
        </xpath>
    </t>

</templates>
