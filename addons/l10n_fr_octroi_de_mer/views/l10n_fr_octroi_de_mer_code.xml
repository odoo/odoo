<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_fr_om_code_list" model="ir.ui.view">
            <field name="name">l10n_fr.om.code.list</field>
            <field name="model">l10n_fr.octroi.de.mer.code</field>
            <field name="arch" type="xml">
                <list string="Octroi de mer code" duplicate="0">
                    <field name="code"/>
                    <field name="om_rate_id"/>
                    <field name="omr_rate_id"/>
                </list>
            </field>
        </record>

        <record id="l10n_fr_om_code_form" model="ir.ui.view">
            <field name="name">l10n_fr.om.code.form</field>
            <field name="model">l10n_fr.octroi.de.mer.code</field>
            <field name="arch" type="xml">
                <form string="Octroi de Mer Code" duplicate="0">
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="om_rate_id"/>
                            <field name="omr_rate_id"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_om_codes" model="ir.actions.act_window">
            <field name="name">Octroi de Mer codes</field>
            <field name="res_model">l10n_fr.octroi.de.mer.code</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem action="action_om_codes" id="menu_om_codes"
                  parent="account.account_invoicing_menu" sequence="6" groups="account.group_account_manager"/>
    </data>
</odoo>
