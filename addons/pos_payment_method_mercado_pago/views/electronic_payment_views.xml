<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_electronic_payment_view_form_mercado_pago" model="ir.ui.view">
        <field name="name">pos.electronic.payment.form.inherit.mercado_pago</field>
        <field name="model">pos.electronic.payment</field>
        <field name="inherit_id" ref="pos_payment_method.pos_electronic_payment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'mercado_pago'">
                    <page name="settings" string="Mercado Pago">
                        <group>
                            <field name="mp_bearer_token" placeholder="APP_USR-..." invisible="payment_provider != 'mercado_pago'" required="payment_provider == 'mercado_pago'"/>
                            <field name="mp_webhook_secret_key" placeholder="c2f3662..." invisible="payment_provider != 'mercado_pago'" required="payment_provider == 'mercado_pago'"/>
                            <field name="mp_id_point_smart" placeholder="1494126963" invisible="payment_provider != 'mercado_pago'" required="payment_provider == 'mercado_pago'"/>
                            <field name="mp_webhook_endpoint" string="Webhook Endpoint" invisible="payment_provider != 'mercado_pago' or not id" required="payment_provider == 'mercado_pago'" widget="CopyClipboardChar"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
