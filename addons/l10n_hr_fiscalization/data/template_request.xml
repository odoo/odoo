                                            <tns:IznosN t-out="fee['amount']" />
                                        </tns:Naknada>
                                    </t>
                                </tns:Naknade>
                            </t>
                            <tns:IznosUkupno t-out="amount_total" />
                            <tns:NacinPlac t-out="payment_method" />
                            <tns:OibOper t-out="operator_oib" />
                            <tns:ZastKod t-out="zki" />
                            <tns:NakDost t-out="is_subsequent_delivery" />
                            <tns:PromijenjeniNacinPlac t-out="changed_payment_method" />
                            <t t-if="change_oib">
                                <t t-if="changed_recipient_oib">
                                    <tns:PromijenjeniOibPrimatelja t-out="changed_recipient_oib" />
                                </t>
                                <t t-else="">
                                    <tns:PromijenjeniOibPrimatelja />
                                </t>
                            </t>
                        </tns:Racun>
                    </tns:PromijeniNacPlacZahtjev>
                </soapenv:Body>
            </soapenv:Envelope>
        </template>

