<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_cleanup_old_buckets" model="ir.cron">
        <field name="name">Rate Limit: Cleanup Old Buckets</field>
        <field name="model_id" ref="model_rate_limit_bucket" />
        <field name="state">code</field>
        <field name="code">model.cron_gc_old_buckets()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=1)).replace(hour=3, minute=0, second=0)" />
        <field name="priority" eval="50" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_cleanup_rate_limiter" model="ir.cron">
        <field name="name">Rate Limit: Cleanup In-Memory Caller Limiter</field>
        <field name="model_id" ref="model_rate_limit_bucket" />
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_caller_rate_limiter()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="4" />
        <field name="repeat_unit">hour</field>
        <field name="priority" eval="60" />
        <field name="active" eval="True" />
    </record>

</odoo>
