#: model:ir.model.fields,field_description:pos_mollie.field_pos_payment_method__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "Failed to initiate payment: %s"
msgstr "ບໍ່ສາມາດເລີ່ມຕົ້ນການຊໍາລະເງິນໄດ້: %s"

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "Failed to initiate refund: %s"
msgstr "ບໍ່ສາມາດເລີ່ມຕົ້ນການສົ່ງເງິນຄືນໄດ້: %s"

#. module: pos_mollie
#: model:ir.model.fields,field_description:pos_mollie.field_pos_payment_method__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: pos_mollie
#: model:ir.module.module,summary:base.module_pos_mollie
msgid "Integrate your POS with a Mollie payment terminal"
msgstr "ເຊື່ອມຕໍ່ລະບົບ POS ຂອງທ່ານກັບເຄື່ອງຮັບຊໍາລະເງິນ Mollie"

#. module: pos_mollie
#: model_terms:ir.ui.view,arch_db:pos_mollie.pos_payment_method_view_form_inherit_pos_mollie
msgid "Mollie"
msgstr "Mollie"

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "Mollie Error"
msgstr "ຂໍ້ຜິດພາດຈາກ Mollie"

#. module: pos_mollie
#: model:ir.model.fields,field_description:pos_mollie.field_pos_payment_method__mollie_payment_provider_id
msgid "Mollie Payment Provider"
msgstr "ຜູ້ໃຫ້ບໍລິການຊໍາລະເງິນ Mollie"

#. module: pos_mollie
#: model:ir.model.fields,field_description:pos_mollie.field_pos_payment_method__mollie_terminal_id
msgid "Mollie Terminal ID"
msgstr "ລະຫັດເຄື່ອງ Mollie Terminal"

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "No internet connection. Waiting for recovery to confirm the payment..."
msgstr ""
"ບໍ່ມີການເຊື່ອມຕໍ່ອິນເຕີເນັດ. ກຳລັງລໍຖ້າການເຊື່ອມຕໍ່ຄືນໃໝ່ເພື່ອຢືນຢັນການຊໍາລະເງິນ..."

#. module: pos_mollie
#: model:ir.module.module,shortdesc:base.module_pos_mollie
msgid "POS Mollie"
msgstr "POS Mollie"

#. module: pos_mollie
#. odoo-python
#: code:addons/pos_mollie/models/pos_payment_method.py:0
msgid ""
"Please set the API key on the Mollie payment provider before making a "
"payment."
msgstr ""
"ກະລຸນາກຳນົດຄ່າ API key ຢູ່ຜູ້ໃຫ້ບໍລິການຊໍາລະເງິນ Mollie ກ່ອນດຳເນີນການຊໍາລະເງິນ."

#. module: pos_mollie
#: model:ir.model,name:pos_mollie.model_pos_payment_method
msgid "Point of Sale Payment Method"
msgstr "ວິທີການຊໍາລະເງິນຈຸດຂາຍໜ້າຮ້ານ (POS)"

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "The payment failed for an unknown reason."
msgstr "ການຊໍາລະເງິນບໍ່ສຳເລັດ ຍ້ອນສາເຫດທີ່ບໍ່ຮູ້ແຈ້ງ."

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "The payment has timed out."
msgstr "ການຊໍາລະເງິນໝົດເວລາແລ້ວ."

#. module: pos_mollie
#. odoo-javascript
#: code:addons/pos_mollie/static/src/payment_mollie.js:0
msgid "You can only refund an order that was paid for with Mollie."
msgstr ""
"ທ່ານສາມາດສົ່ງເງິນຄືນໄດ້ສະເພາະລາຍການສັ່ງຊື້ທີ່ຊໍາລະຜ່ານ Mollie ເທົ່ານັ້ນ."

#. module: pos_mollie
#. odoo-python
#: code:addons/pos_mollie/models/pos_payment_method.py:0
msgid "You do not have the necessary permissions to access this payment."
msgstr "ທ່ານບໍ່ມີສິດອະນຸຍາດທີ່ຈຳເປັນໃນການເຂົ້າເຖິງການຊໍາລະເງິນນີ້."
