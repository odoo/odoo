<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_mollie" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.mollie</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'mollie'">
                    <page name="settings" string="Mollie">
                        <group invisible="payment_provider != 'mollie'">
                            <group>
                                <field name="mollie_payment_provider_id" required="payment_provider == 'mollie'"/>
                                <field name="mollie_api_key" password="True" groups="point_of_sale.group_pos_manager" invisible="not mollie_payment_provider_id"/>
                                <field name="mollie_terminal_id" placeholder="Use 'Connect Terminal' button to find one"/>
                            </group>
                            <group>
                                <div class="d-flex justify-content-end" colspan="2" groups="point_of_sale.group_pos_manager">
                                    <button name="action_mollie_connect_terminal" type="object" string="Connect Terminal" class="btn-primary text-nowrap" invisible="not mollie_api_key"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
