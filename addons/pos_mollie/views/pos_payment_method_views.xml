<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_mollie" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.mollie</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'mollie'">
                    <page name="settings" string="Mollie">
                        <group>
                            <group>
                                <field name="mollie_terminal_id" required="payment_provider == 'mollie'"/>
                                <div colspan="2" class="mt16" groups="base.group_system">
                                    <button name="action_mollie_open_provider" type="object" icon="east" string="Don't forget to set the API key on the Mollie payment provider before using this payment method." class="btn-link"/>
                                </div>
                            </group>
                            <group>
                                <div class="d-flex justify-content-end" colspan="2">
                                    <button name="action_mollie_test" type="object" string="Test" class="btn-primary text-nowrap" groups="point_of_sale.group_pos_manager"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
