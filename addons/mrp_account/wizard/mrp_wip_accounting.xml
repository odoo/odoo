<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wip_accounting_form" model="ir.ui.view">
            <field name="name">Post WIP Accounting Entry</field>
            <field name="model">mrp.account.wip.accounting</field>
            <field name="arch" type="xml">
                <form string="Post Manufacturing WIP">
                    <group>
                        <group>
                            <field name="journal_id"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="reversal_date"/>
                        </group>
                    </group>
                    <field name="mo_ids" invisible="1"/> <!-- manufacturing orders the entry is posted for, filled from the active_ids of the context -->
                    <field name="line_ids" mode="list,kanban">
                        <list editable="bottom">
                            <field name="account_id"/>
                            <field name="label"/>
                            <field name="debit" sum="Total Debit"/>
                            <field name="credit" sum="Total Credit"/>
                            <field name="currency_id" column_invisible="True"/> <!-- currency of the debit/credit monetary columns -->
                        </list>
                        <form string="Accounting Line">
                            <field name="wip_accounting_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <group>
                                <field name="account_id"/>
                                <field name="label"/>
                                <field name="debit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="credit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </form>
                        <kanban class="o_kanban_mobile">
                            <field name="account_id"/>
                            <field name="label"/>
                            <field name="debit"/>
                            <field name="credit"/>
                            <field name="currency_id"/>
                            <templates>
                                <t t-name="card">
                                    <field name="account_id" class="fw-bold"/>
                                    <field name="label" class="text-muted" invisible="not label"/>
                                    <div class="text-muted mt-2">Debit: <field name="debit" class="fw-bold"/></div>
                                    <div class="text-muted">Credit: <field name="credit" class="fw-bold"/></div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                    <footer>
                        <button name="confirm" string="Post WIP" data-hotkey="q" colspan="1" type="object" class="btn-primary"/>
                        <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wip_accounting" model="ir.actions.act_window">
            <field name="name">Post WIP Accounting Entry</field>
            <field name="res_model">mrp.account.wip.accounting</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
