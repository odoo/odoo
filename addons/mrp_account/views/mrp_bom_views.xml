<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_account_inherits_mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp_account.bom.form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='continuous']" position="after">
                <label for="extra_cost" invisible="type != 'normal'"/>
                <div class="o_row" invisible="type != 'normal'">
                    <field name="currency_id" invisible="1"/>
                    <field name="extra_cost" widget="monetary" string="Extra Cost"/>
                    <span groups="uom.group_uom">/</span>
                    <field name="uom_id" groups="uom.group_uom" widget="many2one_uom" options="{'no_open': True}" readonly="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
