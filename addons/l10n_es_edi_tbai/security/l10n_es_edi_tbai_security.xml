<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="tbai_document_comp_rule" model="ir.rule">
        <field name="name">TicketBAI Document multi-company</field>
        <field name="model_id" ref="model_l10n_es_edi_tbai_document" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_es_edi_tbai_config_rule_company" model="ir.rule">
        <field name="name">l10n_es_edi_tbai.config: the reader's companies</field>
        <field name="model_id" ref="model_l10n_es_edi_tbai_config" />
        <field name="global" eval="False" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field
            name="groups"
            eval="[Command.set([ref('base.group_user'), ref('base.group_portal'), ref('base.group_public')])]" />
    </record>

    <record id="l10n_es_edi_tbai_config_rule_erp_manager" model="ir.rule">
        <field
            name="name">l10n_es_edi_tbai.config: every company for an access-rights manager</field>
        <field name="model_id" ref="model_l10n_es_edi_tbai_config" />
        <field name="global" eval="False" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('base.group_erp_manager')])]" />
    </record>

</odoo>
