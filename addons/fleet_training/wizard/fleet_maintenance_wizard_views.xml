<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_training_maintenance_wizard_view_form" model="ir.ui.view">
        <field name="name">fleet_training.maintenance.wizard.form</field>
        <field name="model">fleet_training.maintenance.wizard</field>
        <field name="arch" type="xml">
            <form string="Log Maintenance">
                <group>
                    <field name="vehicle_id"/>
                    <field name="date"/>
                    <field name="maintenance_type"/>
                    <field name="odometer"/>
                    <field name="cost"/>
                    <field name="currency_id" invisible="1"/>  <!-- Needed for cost's Monetary widget -->
                </group>
                <group string="Description">
                    <field name="description" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Log Maintenance" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fleet_training_maintenance_wizard" model="ir.actions.act_window">
        <field name="name">Log Maintenance</field>
        <field name="res_model">fleet_training.maintenance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
