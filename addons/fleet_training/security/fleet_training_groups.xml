<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fleet_training" model="ir.module.category">
        <field name="name">Fleet Training</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_fleet_training" model="res.groups.privilege">
        <field name="name">Fleet Training</field>
        <field name="category_id" ref="module_category_fleet_training"/>
    </record>

    <record id="group_fleet_user" model="res.groups">
        <field name="name">Fleet User</field>
        <field name="privilege_id" ref="privilege_fleet_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can register and update vehicles, but not delete them.</field>
    </record>

    <record id="group_fleet_manager" model="res.groups">
        <field name="name">Fleet Manager</field>
        <field name="privilege_id" ref="privilege_fleet_training"/>
        <field name="implied_ids" eval="[(4, ref('group_fleet_user'))]"/>
        <field name="comment">Full control over the fleet: vehicles, drivers and deletions.</field>
    </record>
</odoo>
