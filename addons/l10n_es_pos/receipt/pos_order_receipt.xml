<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_es_pos.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <tr name="ticket_waiter" position="after">
                <tr>
                    <td colspan="2" t-if="order.get('is_l10n_es_simplified_invoice')">
                        Simplified invoice
                        <t t-out="extra_data['invoice_name']"/>
                    </td>
                </tr>
            </tr>
            <div name="partner_info" position="attributes">
                <attribute name="t-if" separator="and" add="(not config.get('is_spanish') or not config.get('simplified_partner_id'))"/>
            </div>
        </template>
    </data>
</odoo>
