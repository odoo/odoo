<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mitid</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_dk_nemhandel.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='nemhandel_edi_identification']/.." position="after">
                <field name="mitid_kyc_status" invisible="1"/>
                <div class="alert alert-warning mt-3" role="alert"
                     invisible="l10n_dk_nemhandel_proxy_state != 'receiver' or mitid_kyc_status == 'success'">
                    Your company has not been authenticated yet. A person authorized to sign on behalf of the company must authenticate it with MitID Erhverv.
                    <div>
                        <button name="action_open_nemhandel_form"
                                type="object"
                                string="Authenticate with MitID"
                                class="btn-link px-0"
                                icon="oi-arrow-right"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
