<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_l10n_cn_edi_red_form_status" model="ir.cron">
        <field name="name">E-Fapiao: Check Pending Red Forms</field>
        <field name="model_id" ref="model_l10n_cn_edi_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_red_form_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_l10n_cn_edi_poll_invoices" model="ir.cron">
        <field name="name">E-Fapiao: Fetch Pending Fapiao</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_cn_edi_poll_invoices()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
