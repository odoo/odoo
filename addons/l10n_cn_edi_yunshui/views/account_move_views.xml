<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_cn_edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible">not show_reset_to_draft_button or l10n_cn_edi_state in ('sent', 'issued')</attribute>
            </xpath>

            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_cn_edi_date_warning">
                    <field name="l10n_cn_edi_date_warning"/>
                </div>

                <div class="alert alert-warning mb-0 d-flex justify-content-between align-items-center" role="alert"
                    invisible="l10n_cn_edi_state != 'waiting_login'">
                    <span>The tax bureau wants the drawer to log in before this e-Fapiao can be issued.</span>
                    <button name="action_l10n_cn_edi_login" string="Log In" type="object" class="btn btn-primary btn-sm"/>
                </div>

                <div class="alert alert-info mb-3 d-flex justify-content-between align-items-center" role="alert"
                    invisible="move_type not in ('in_invoice', 'out_invoice') or l10n_cn_edi_red_form_status != 'red_form_pending' or l10n_cn_edi_red_form_bureau_state not in ('02', '03')">
                    <div>
                        <strong>Red Form <field name="l10n_cn_edi_red_form_number" readonly="1" class="oe_inline"/> received</strong><br/> Credit price (tax exclusive): <field name="l10n_cn_edi_red_form_amount_untaxed" readonly="1" class="oe_inline"/><br/> Credit tax: <field name="l10n_cn_edi_red_form_amount_tax" readonly="1" class="oe_inline"/>
                    </div>
                    <div>
                        <button name="action_l10n_cn_edi_approve_inbound_red_form" string="01 - Confirm" type="object" class="btn btn-success btn-sm"/>
                        <button name="action_l10n_cn_edi_reject_inbound_red_form" string="02 - Reject" type="object" class="btn btn-danger btn-sm ms-2"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//widget[@name='web_ribbon']" position="before">
                <widget name="web_ribbon" title="Red Form Rejected" bg_color="text-bg-warning"
                    invisible="move_type != 'out_refund' or l10n_cn_edi_state != 'failed'"/>
            </xpath>

            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_l10n_cn_edi_request_red_form"
                    string="Send Red Form"
                    type="object"
                    class="oe_highlight"
                    invisible="state != 'draft' or move_type != 'out_refund' or not l10n_cn_edi_red_form_required or l10n_cn_edi_state in ('sent', 'issued')"/>
            </xpath>

            <xpath expr="//field[@name='fapiao']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='fapiao']" position="after">
                <field name="l10n_cn_edi_invoice_type_code"
                    invisible="country_code != 'CN' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                    readonly="l10n_cn_edi_state in ('sent', 'issued') or l10n_cn_edi_red_form_status in ('red_form_pending', 'red_form_confirmed')"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="E-Fapiao" name="china_e_fapiao" invisible="country_code != 'CN' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <group>
                        <group string="E-Fapiao Details">
                            <field name="l10n_cn_edi_fapiao_no" readonly="l10n_cn_edi_state in ('sent', 'issued')"/>
                            <field name="l10n_cn_edi_fapiao_date" readonly="l10n_cn_edi_state in ('sent', 'issued')"/>
                            <field name="l10n_cn_edi_state" widget="badge"
                                decoration-success="l10n_cn_edi_state == 'issued'"
                                decoration-warning="l10n_cn_edi_state in ('sent', 'waiting_login')"
                                decoration-danger="l10n_cn_edi_state == 'failed'"/>
                        </group>

                        <group string="Red Form Requests" invisible="not l10n_cn_edi_red_form_uuid and move_type != 'out_refund'">
                            <field name="l10n_cn_edi_red_form_reason" readonly="l10n_cn_edi_red_form_status in ('red_form_pending', 'red_form_confirmed')"/>
                            <field name="l10n_cn_edi_red_form_number"/>
                            <field name="l10n_cn_edi_red_form_amount_untaxed" invisible="move_type not in ('in_invoice', 'out_invoice') or not l10n_cn_edi_red_form_uuid"/>
                            <field name="l10n_cn_edi_red_form_amount_tax" invisible="move_type not in ('in_invoice', 'out_invoice') or not l10n_cn_edi_red_form_uuid"/>
                            <field name="l10n_cn_edi_red_form_status" widget="badge"
                                decoration-success="l10n_cn_edi_red_form_status == 'red_form_confirmed'"
                                decoration-warning="l10n_cn_edi_red_form_status == 'red_form_pending'"
                                decoration-danger="l10n_cn_edi_red_form_status in ('failed', 'cancelled')"/>

                            <field name="l10n_cn_edi_red_form_uuid"/>
                        </group>
                    </group>
                    <field name="l10n_cn_edi_document_ids" readonly="1" invisible="not l10n_cn_edi_document_ids">
                        <list>
                            <field name="create_date" string="Created On"/>
                            <field name="kind"/>
                            <field name="serial_no"/>
                            <field name="fapiao_no"/>
                            <field name="red_form_number" optional="hide"/>
                            <field name="sent_data_id" optional="hide"/>
                            <field name="state" widget="badge"
                                decoration-success="state in ('issued', 'red_form_confirmed')"
                                decoration-warning="state in ('sent', 'red_form_pending')"
                                decoration-danger="state in ('failed', 'cancelled')"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//page[@name='other_info']//field[@name='partner_bank_id']" position="before">
                <field name="l10n_cn_buyer_bank_id"
                    invisible="country_code != 'CN'"
                    options="{'no_create': True, 'no_open': True}"
                    placeholder="Select customer bank account..."/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/column[@name='product_and_description']" position="after">
                <field name="l10n_cn_tax_category_id" optional="show" column_invisible="parent.country_code != 'CN'"/>
            </xpath>
        </field>
    </record>

    <record id="action_l10n_cn_edi_fetch_fapiao_files" model="ir.actions.server">
        <field name="name">Download e-Fapiao Files</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_l10n_cn_edi_fetch_fapiao_files()
        </field>
    </record>
</odoo>
