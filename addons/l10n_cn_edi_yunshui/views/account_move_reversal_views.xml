<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_reversal" model="ir.ui.view">
        <field name="name">account.move.reversal.form.inherit.l10n_cn_edi</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reason']" position="attributes">
                <attribute name="invisible">l10n_cn_edi_use_red_form_reason</attribute>
            </xpath>
            <xpath expr="//field[@name='reason']" position="after">
                <field name="l10n_cn_edi_red_form_reason"
                       invisible="not l10n_cn_edi_use_red_form_reason"
                       required="l10n_cn_edi_use_red_form_reason"/>
            </xpath>
        </field>
    </record>
</odoo>
