<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="website_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">website.res.config.settings.simplified.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <div class="mt16">
                    <label for="simplified_invoice_journal_id" class="o_light_label me-2"/>
                    <field name="simplified_invoice_journal_id" class="oe_inline"/>
                </div>
                <div class="mt16">
                    <label for="l10n_es_simplified_invoice_limit" class="o_light_label me-2"/>
                    <field name="l10n_es_simplified_invoice_limit" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
