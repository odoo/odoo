<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="address_form_l10n_es_id_type" inherit_id="portal.address_form_fields" name="Address Form: Spain ID Type">
        <div id="company_name_div" position="attributes">
            <attribute name="class"/>
            <attribute name="t-att-class">
                'col-lg-4 mb-2' if is_used_as_billing and l10n_es_id_type_metadata else 'col-lg-6 mb-2'
            </attribute>
        </div>
        <div id="div_vat" position="attributes">
            <attribute name="t-if">not l10n_es_id_type_metadata</attribute>
        </div>
        <div id="company_name_div" position="after">
            <t t-if="is_used_as_billing and l10n_es_id_type_metadata">
                <div class="col-lg-3 mb-2">
                    <label
                        class="col-form-label fw-normal label-optional"
                        t-att-for="None if commercial_fields_warning or vat_warning else 'l10n_es_id_type_select'"
                    >
                        ID Type
                    </label>
                    <select
                        id="l10n_es_id_type_select"
                        name="l10n_es_id_type"
                        t-att-class="'form-select o_l10n_es_id_type_select'
                            + (' pe-none opacity-50' if commercial_fields_warning or vat_warning else '')"
                        t-att-tabindex="'-1' if commercial_fields_warning or vat_warning else None"
                    >
                        <t t-foreach="l10n_es_id_type_metadata.items()" t-as="entry">
                            <option
                                t-att-value="entry[0]"
                                t-att-selected="entry[0] == l10n_es_id_type_current_key"
                                t-out="entry[1]['label']"
                            />
                        </t>
                    </select>
                </div>
                <div class="col-lg-5 mb-2">
                    <label
                        class="col-form-label fw-normal label-optional o_l10n_es_id_value_label"
                        id="l10n_es_id_value_label"
                        for="l10n_es_id_value_input"
                        t-out="(l10n_es_id_type_metadata.get(l10n_es_id_type_current_key) or {}).get('label')"
                    />
                    <t t-call="portal.address_warning_icon" warning="commercial_fields_warning or vat_warning"/>
                    <input
                        type="text"
                        id="l10n_es_id_value_input"
                        class="form-control o_l10n_es_id_value_input"
                        t-att-name="l10n_es_id_type_current_key"
                        t-att-value="l10n_es_id_type_current_value"
                        t-att-readonly="'1' if commercial_fields_warning or vat_warning else None"
                    />
                </div>
            </t>
        </div>
    </template>
</odoo>
