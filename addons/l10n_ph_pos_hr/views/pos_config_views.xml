<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_config_list_inherit_l10n_ph_pos_hr" model="ir.ui.view">
        <field name="name">pos.config.view.list.inherit.l10n_ph_pos_hr</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='current_cash_register_balance']" position="after">
                <field name="l10n_ph_void_counter" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
