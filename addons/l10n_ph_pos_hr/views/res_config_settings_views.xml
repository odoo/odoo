<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ph_pos_hr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='l10n_ph_pos_audit_metrics_setting']/div" position="inside">
                <div class="row mt16">
                    <label for="pos_l10n_ph_void_counter" string="Void Counter" class="col-lg-4 o_light_label"/>
                    <field name="pos_l10n_ph_void_counter" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
