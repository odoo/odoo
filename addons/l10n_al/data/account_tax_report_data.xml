                    <record id="l10n_al_tax_report_09" model="account.report.line">
                        <field name="name">[9] Exempt sales</field>
                        <field name="name@sq">[9] Shitje të përjashtuara</field>
                        <field name="code">AL_09</field>
                        <field name="hierarchy_level">1</field>
                        <field name="expression_ids">
                            <record id="l10n_al_tax_report_09_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-9</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_al_tax_report_10" model="account.report.line">
                        <field name="name">[10] Sales without VAT</field>
