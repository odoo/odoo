<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <!-- Deklarata e TVSH-së (DTVSH), as annexed to Instruction No. 6 of 24.2.2025 of the Minister of Finance.
         Box 8 (no transactions in the month) is a checkbox of the form, not an amount.
         Boxes that no tax fills (19-20, 23-24, 28-29, 50-53) are tax grids set by hand on journal entries. -->
    <record id="l10n_al_tax_report" model="account.report">
        <field name="name">VAT Return (DTVSH)</field>
        <field name="name@sq">Deklarata e TVSH-së (DTVSH)</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.al"/>
        <field name="filter_multi_company">tax_units</field>
        <field name="allow_foreign_vat" eval="True"/>
        <field name="default_opening_date_filter">previous_return_period</field>
        <field name="only_tax_exigible" eval="True"/>
        <field name="column_ids">
            <record id="l10n_al_tax_report_column_base" model="account.report.column">
                <field name="name">Taxable value</field>
                <field name="name@sq">Vlera e tatueshme</field>
                <field name="expression_label">base</field>
            </record>
            <record id="l10n_al_tax_report_column_tax" model="account.report.column">
                <field name="name">VAT</field>
                <field name="name@sq">TVSH</field>
                <field name="expression_label">tax</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_al_tax_report_section_a" model="account.report.line">
                <field name="name">VAT calculated for the month</field>
                <field name="name@sq">TVSH e llogaritur për muajin</field>
