<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_demo_company_al" model="res.partner">
        <field name="name">AL Company</field>
        <field name="vat">J91402501L</field>
        <field name="street">Rruga e Durrësit</field>
        <field name="city">Tirana</field>
        <field name="zip">1001</field>
        <field name="country_id" ref="base.al"/>
        <field name="phone">+355 4 223 4567</field>
        <field name="email">info@company.alexample.com</field>
        <field name="website">www.alexample.com</field>
    </record>
    <record id="demo_company_al" model="res.company">
        <field name="name">AL Company</field>
        <field name="partner_id" ref="partner_demo_company_al"/>
    </record>
    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('l10n_al.demo_company_al')]"/>
    </function>
    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(Command.link(ref('l10n_al.demo_company_al')))]}"/>
    </function>
    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>al</value>
        <value model="res.company" eval="obj().env.ref('l10n_al.demo_company_al')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
