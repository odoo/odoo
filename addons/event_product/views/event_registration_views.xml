<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_event_registration_ticket_tree" model="ir.ui.view">
        <field name="name">event.registration.list.inherit</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="sale_status" optional="show" widget="badge"
                    decoration-success="sale_status == 'sold'"
                    decoration-danger="sale_status == 'to_pay'"
                    invisible="not sale_status" />
            </field>
        </field>
    </record>

    <record id="event_registration_view_graph" model="ir.ui.view">
        <field name="name">event.registration.graph.inherit.event.sale</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_graph"/>
        <field name="arch" type="xml">
            <field name="event_id" position="after">
                <field name="sale_status" />
            </field>
        </field>
    </record>

    <record id="event_registration_ticket_view_form" model="ir.ui.view">
        <field name="name">event.registration.form.inherit</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_form" />
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <widget name="web_ribbon" title="Sold" bg_color="text-bg-success"
                    invisible="sale_status != 'sold'"/>
                <widget name="web_ribbon" title="Not Sold" bg_color="text-bg-info"
                    invisible="not sale_status or sale_status in ('sold', 'free') or not id"/>
            </xpath>
        </field>
    </record>


    <record id="view_event_registration_form_ticket_option" model="ir.ui.view">
        <field name="name">event.registration.form.inherit.ticket.option</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_form"/>
        <field name="arch" type="xml">
            <field name="event_ticket_id" position="after">
                <field name="ticket_optional_product_ids" invisible="1"/>
                <field name="ticket_option_product_ids" widget="many2many_checkboxes"
                    domain="[('id', 'in', ticket_optional_product_ids)]"
                    invisible="not ticket_optional_product_ids and not ticket_option_product_ids"/>
            </field>
        </field>
    </record>

    <record id="view_event_registration_tree_ticket_option" model="ir.ui.view">
        <field name="name">event.registration.list.inherit.ticket.option</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_tree"/>
        <field name="arch" type="xml">
            <field name="event_ticket_id" position="after">
                <field name="ticket_option_product_ids" widget="many2many_tags" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_registration_search_ticket_option" model="ir.ui.view">
        <field name="name">event.registration.search.inherit.ticket.option</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_registration_search"/>
        <field name="arch" type="xml">
            <field name="event_ticket_id" position="after">
                <field name="ticket_option_product_ids"/>
            </field>
        </field>
    </record>

</data></odoo>
