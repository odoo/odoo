<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_team" model="ir.ui.view">
        <field name="name">mrp.production.form.team</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field
                    name="team_id"
                    options="{'no_create': True}"
                    readonly="state in ['cancel', 'done']" />
            </field>
        </field>
    </record>

    <record id="mrp_production_tree_view_team" model="ir.ui.view">
        <field name="name">mrp.production.list.team</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="team_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_mrp_production_filter_team" model="ir.ui.view">
        <field name="name">mrp.production.select.team</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="team_id" />
                <filter
                    name="my_teams_productions"
                    string="My Teams' Orders"
                    domain="[('team_id.member_ids', 'in', uid)]" />
            </field>
        </field>
    </record>

</odoo>
