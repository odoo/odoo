#. module: board
#: model:ir.module.module,description:base.module_board
msgid ""
"\n"
"Lets the user create a custom dashboard.\n"
"========================================\n"
"\n"
"Allows users to create custom dashboard.\n"
msgstr ""
"\n"
"ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ສ້າງແຜງຄວບຄຸມແບບກຳນົດເອງ.\n"
"========================================\n"
"\n"
"ອະນຸຍາດໃຫ້ຜູ້ໃຊ້ສ້າງແຜງຄວບຄຸມແບບກຳນົດເອງ.\n"

#. module: board
#. odoo-javascript
#: code:addons/board/static/src/board_controller.xml:0
msgid ""
"\"Add to\n"
"                  Dashboard\""
msgstr ""
"\"ເພີ່ມໃສ່\n"
"                  ແຜງຄວບຄຸມ\""

#. module: board
#. odoo-javascript
#: code:addons/board/static/src/add_to_board/add_to_board.xml:0
msgid "Add"
msgstr "ເພີ່ມ"

#. module: board
#. odoo-javascript
#: code:addons/board/static/src/add_to_board/add_to_board.xml:0
msgid "Add to my dashboard"
msgstr "ເພີ່ມໃສ່ແຜງຄວບຄຸມຂອງຂ້ອຍ"

#. module: board
#. odoo-javascript
#: code:addons/board/static/src/board_controller.js:0
msgid "Are you sure that you want to remove this item?"
msgstr "ທ່ານແນ່ໃຈບໍ່ວ່າຕ້ອງການລຶບລາຍການນີ້ອອກ?"

#. module: board
#: model:ir.model,name:board.model_board_board
msgid "Board"
msgstr "ກະດານ"

#. module: board
#: model:ir.module.module,summary:base.module_board
