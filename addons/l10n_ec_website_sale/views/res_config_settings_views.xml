<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='res_config_settings_view_form' model='ir.ui.view'>
        <field name='name'>res.config.settings.view.form.inherit.website.sale</field>
        <field name='model'>res.config.settings</field>
        <field name='inherit_id' ref='website_sale.res_config_settings_view_form'/>
        <field name='arch' type='xml'>
            <setting id='website_tax_inclusion_setting' position='after'>
                <setting
                    id='l10n_ec_final_consumer_limit_setting'
                    string='Final Consumer Max Amount'
                    help='Above it, a buyer without a RUC must provide a Cédula at checkout.'
                    invisible='country_code != "EC"'
                >
                    <field name='l10n_ec_final_consumer_limit'/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
