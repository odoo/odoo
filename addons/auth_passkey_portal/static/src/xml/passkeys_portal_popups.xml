<templates>
    <t t-name="auth_passkey_portal.create">
        <form string="Key Create">
            <label for="passkey_create_name" class="form-label">Name your key</label>
            <input type="text" id="passkey_create_name" class="form-control" name="keyname" required="required" placeholder="Name"/>
        </form>
    </t>
    <t t-name="auth_passkey_portal.rename">
        <form string="Key Rename">
            <label for="passkey_rename_name" class="form-label">Rename your key</label>
            <input type="text" id="passkey_rename_name" class="form-control" name="keyname" required="required" t-attf-value="{{oldname}}" placeholder="Name"/>
        </form>
    </t>
</templates>
