<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="delivery_provider_module_list" model="ir.ui.view">
        <field name="name">Delivery Provider Module List</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_tree"/>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="default_order">sequence, name</attribute>
            </list>
            <field name="name" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="author" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="website" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="installed_version" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="delivery_provider_module_kanban" model="ir.ui.view">
        <field name="name">Delivery Provider Module Kanban</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban"/>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="default_order">sequence, name</attribute>
                <attribute name="action">action_view_delivery_methods</attribute>
                <attribute name="type">object</attribute>
            </kanban>
            <xpath expr="//h2/field[@name='shortdesc']" position="replace">
                <t t-if="record.name.raw_value == 'delivery'">In-house Delivery</t>
                <t t-elif="record.name.raw_value == 'website_sale_collect'">Pick up in store</t>
                <field t-else="" name="shortdesc"/>
            </xpath>
            <xpath expr="//small/field[@name='summary']" position="replace">
                <t t-if="record.name.raw_value == 'delivery'">
                    Deliver orders with your own drivers.
                </t>
                <t t-elif="record.name.raw_value == 'website_sale_collect'">
                    Let customers collect their online orders in your stores.
                </t>
                <field t-else="" groups="!base.group_no_one" name="summary"/>
            </xpath>
            <a id="module_info" position="replace"/>
        </field>
    </record>

    <record id="delivery_provider_module_search" model="ir.ui.view">
        <field name="name">Delivery Provider Module Search</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter"/>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <filter name="not_installed" position="after">
                <separator/>
                <filter
                    name="archived"
                    string="Archived"
                    domain="[]"
                    context="{'legacy_delivery_providers': True}"
                />
            </filter>
            <searchpanel position="replace"/>
        </field>
    </record>

    <record id="action_delivery_provider_modules" model="ir.actions.server">
        <field name="name">Delivery Providers</field>
        <field name="model_id" ref="model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">action = model.install_more_provider()</field>
    </record>

    <menuitem
        id="sale_menu_action_delivery_carrier_form"
        name="Deliveries"
        action="action_delivery_provider_modules"
        parent="sale.menu_sale_config"
        sequence="25"
    />

</odoo>
