<odoo>
    <template id="loyalty_buttons" inherit_id="portal.side_content">
        <xpath expr="." position="inside">
            <t t-set="member_barcode" t-value="user_id.partner_id.barcode"/>
            <t t-set="loyalty_count" t-value="bool(member_barcode) + sum(len(cards) for cards in (cards_per_programs or {}).values())"/>
            <t t-set="in_header" t-value="placement == 'header'"/>
            <!-- A lone tile goes beside the contact, several above the cards; three share a row from 992px, four from 1400px -->
            <div t-if="loyalty_count and in_header == (loyalty_count == 1)"
                t-attf-class="o_loyalty_container #{'w-100' if in_header else 'row row-cols-1 %s g-3 mb-4' % ('row-cols-sm-2' if loyalty_count == 2 else 'row-cols-lg-3' if loyalty_count == 3 else 'row-cols-sm-2 row-cols-xxl-4')}">
                <div t-if="member_barcode" t-att-class="None if in_header else 'col'">
                    <div t-attf-class="d-flex align-items-center gap-2 w-100 h-100 rounded-3 #{'p-2 pe-3' if in_header else 'p-2'} bg-light">
                        <span class="o_portal_icon d-flex align-items-center justify-content-center flex-shrink-0 border rounded-3 bg-white text-primary">
                            <i class="oi" data-icon="badge" aria-hidden="true"/>
                        </span>
                        <span class="d-flex flex-column min-w-0 lh-sm">
                            <span class="small text-muted">Member card</span>
                            <small class="fw-semibold text-truncate" t-out="member_barcode"/>
                        </span>
                    </div>
                </div>
                <t t-foreach="cards_per_programs or {}" t-as="program">
                    <div t-foreach="cards_per_programs[program]" t-as="card" t-att-class="None if in_header else 'col'">
                        <button
                            type="button"
                            t-att-data-card_id="card.id"
                            t-attf-class="o_loyalty_card d-flex align-items-center gap-2 w-100 h-100 border-0 rounded-3 #{'p-2 pe-3' if in_header else 'p-2'} bg-light text-start text-reset"
                        >
                            <span class="o_portal_icon d-flex align-items-center justify-content-center flex-shrink-0 border rounded-3 bg-white text-primary">
                                <i class="oi" t-att-data-icon="'payments' if program.program_type == 'ewallet' else 'star'" aria-hidden="true"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1 min-w-0 lh-sm">
                                <span class="small text-muted text-truncate" t-out="program.display_name"/>
                                <small class="fw-semibold text-truncate" t-out="card.points_display"/>
                            </span>
                            <i t-if="not in_header" class="oi opacity-50" data-icon="chevron_forward" aria-hidden="true"/>
                        </button>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="loyalty_card_history_template" name="My Loyalty History">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Loyalty Transaction"/>
            <t t-if="not history_lines">
                <p class="alert alert-warning">
                    There are currently no transaction lines for this card.
                </p>
            </t>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Description</th>
                        <th>Order</th>
                        <th>Date</th>
                        <th t-if="card.program_type == 'loyalty'">Expiration</th>
                        <th>Issued</th>
                        <th>Used</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="history_lines" t-as="line">
                        <td><span t-out="line.description"/></td>
                        <td t-if="line.order_id">
                            <t t-set="order_portal_url" t-value="line._get_order_portal_url()"/>
                            <t t-set="order_description" t-value="line._get_order_description()"/>
                            <a t-if="order_portal_url" t-att-href="order_portal_url">
                                <t t-out="order_description"/>
                            </a>
                            <t t-else="">
                                <t t-out="order_description"/>
                            </t>
                        </td>
                        <td t-else=""/>
                        <td><t t-out="line.points_changed_date" t-options='{"widget": "datetime", "format": "short"}'/></td>
                        <td t-if="card.program_type == 'loyalty'">
                            <t t-out="line.expiration_date" t-options='{"widget": "date"}'/>
                        </td>
                        <td><span t-out="line.card_id._format_points(line.issued)"/></td>
                        <td><span t-out="line.card_id._format_points(line.used)"/></td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template
        id="portal_loyalty_history_breadcrumbs"
        name="Portal layout : Loyalty History Lines"
        inherit_id="portal.portal_breadcrumbs"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li class="breadcrumb-item active" t-if="page_name == 'loyalty_history'">
                <span>History</span>
            </li>
        </xpath>
    </template>

</odoo>
