<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.loyalty</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="is_loyalty_payment" invisible="1"/>
                <field name="payment_method_code" invisible="1"/>
                <field name="commercial_partner_id" invisible="1"/>
                <field
                    name="loyalty_card_id"
                    invisible="not show_loyalty_card_id"
                    required="is_loyalty_payment"
                    readonly="state != 'draft'"
                    options="{'no_create': True}"
                />
                <field
                    name="loyalty_card_balance"
                    invisible="not loyalty_card_id or state != 'draft'"
                />
            </field>
        </field>
    </record>

    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form.loyalty</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="is_loyalty_payment" invisible="1"/>
                <field name="payment_method_code" invisible="1"/>
                <field
                    name="loyalty_card_id"
                    invisible="not show_loyalty_card_id"
                    required="is_loyalty_payment"
                    options="{'no_create': True}"
                />
                <field name="loyalty_card_balance" invisible="not loyalty_card_id"/>
            </field>
        </field>
    </record>

</odoo>
