<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.l10n_jp_sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-danger">l10n_jp_missed_closing</attribute>
                <attribute name="decoration-warning">l10n_jp_closing_date and invoice_status == 'to invoice' and (delivery_status in ['pending', 'started', 'partial'] or amount_invoiced)</attribute>
            </list>
            <field name="date_order" position="after">
                <field name="l10n_jp_closing_date" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_sale" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.l10n_jp_sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <filter name="to_invoice" position="after">
                <filter string="To Invoice at Closing"
                        name="l10n_jp_to_invoice_at_closing"
                        domain="[('invoice_status', '=', 'to invoice'), ('l10n_jp_closing_date', '&lt;=', 'today')]"/>
            </filter>
        </field>
    </record>
</odoo>
