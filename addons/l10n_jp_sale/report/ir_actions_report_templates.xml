<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_price_digits" t-value="doc.env['decimal.precision'].precision_get('Product Price')"/>
            <t t-set="jp_hide_zero_decimals" t-value="doc.currency_id.decimal_places == 0 and all(round((1 - min(line.discount, 0) / 100.0) * line.price_unit, jp_price_digits).is_integer() for line in doc._get_order_lines_to_report())"/>
            <t t-set="jp_document_date" t-value="doc.date_order"/>
        </xpath>

        <!-- The recipient's name heads the address with its honorific. -->
        <xpath expr="//div[@t-field='doc.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "jp_honorific": True}</attribute>
        </xpath>

        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'min_precision': 0} if jp_hide_zero_decimals else {}</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']/span[@t-out]" position="attributes">
            <attribute name="t-options">{"widget": "float", "decimal_precision": "Product Price", "min_precision": 0 if jp_hide_zero_decimals else jp_price_digits}</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_raw" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="attributes">
            <attribute name="t-if" add="doc.country_code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="after">
            <t t-elif="doc.country_code == 'JP'" t-call="l10n_jp_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

    <template id="report_saleorder_pro_forma" inherit_id="sale.report_saleorder_pro_forma">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="attributes">
            <attribute name="t-if" add="doc.country_code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="after">
            <t t-elif="doc.country_code == 'JP'" t-call="l10n_jp_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

    <template id="report_invoice_document" inherit_id="l10n_jp.report_invoice_document">
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="display_sale_orders" t-value="len(o.invoice_line_ids.sale_line_ids.order_id) &gt; 1"/>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_sale_order" t-if="display_sale_orders" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Sales Order</span></th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_sale_order" t-if="display_sale_orders" t-attf-class="text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-out="', '.join(line.sale_line_ids.order_id.mapped('name'))">S00001</span>
            </td>
        </xpath>
        <!-- Section rows and collapsed lines span the new column. -->
        <xpath expr="(//t[@t-set='line_colspan'])[1]" position="attributes">
            <attribute name="t-value" add="(1 if display_sale_orders else 0)" separator=" + "/>
        </xpath>
        <xpath expr="(//t[@t-set='line_colspan'])[2]" position="attributes">
            <attribute name="t-value" add="(1 if display_sale_orders else 0)" separator=" + "/>
        </xpath>
        <xpath expr="(//t[@t-set='line_colspan'])[3]" position="attributes">
            <attribute name="t-value" add="(1 if display_sale_orders else 0)" separator=" + "/>
        </xpath>
    </template>
</odoo>
