<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_hide_zero_decimals" t-value="all(line.price_unit.is_integer() for line in doc._get_order_lines_to_report())"/>
            <t t-set="jp_document_date" t-value="doc.date_order"/>
        </xpath>

        <!-- The recipient's name heads the address with its honorific. -->
        <xpath expr="//div[@t-field='doc.partner_id']" position="before">
            <t t-call="l10n_jp.recipient_name" partner="doc.partner_id"/>
        </xpath>
        <xpath expr="//div[@t-field='doc.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address"], "no_marker": True}</attribute>
        </xpath>

        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'min_precision': 0} if jp_hide_zero_decimals else {}</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_raw" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="attributes">
            <attribute name="t-if" add="doc.country_code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="after">
            <t t-elif="doc.country_code == 'JP'" t-call="l10n_jp_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>

    <template id="report_saleorder_pro_forma" inherit_id="sale.report_saleorder_pro_forma">
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="attributes">
            <attribute name="t-if" add="doc.country_code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='sale.report_saleorder_document']" position="after">
            <t t-elif="doc.country_code == 'JP'" t-call="l10n_jp_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
        </xpath>
    </template>
</odoo>
