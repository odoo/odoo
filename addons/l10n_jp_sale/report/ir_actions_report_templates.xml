<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" priority="10">
        <xpath expr="//t[@t-set='address']" position="before">
            <t t-set="jp_layout" t-value="doc.company_id.external_report_layout_id.sudo().key == 'l10n_jp.external_layout_jp_standard'"/>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_hide_zero_decimals"
               t-value="doc.company_id.account_fiscal_country_id.code == 'JP'
                        and all(line.price_unit.is_integer() and line.discount &gt;= 0 for line in doc._get_order_lines_to_report())"/>
            <t t-set="jp_document_date" t-value="doc.date_order"/>
        </xpath>

        <!-- The Japanese Business layout heads the address with the recipient's name and honorific. -->
        <xpath expr="//div[@t-field='doc.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address"] if jp_layout else ["address", "name"], "no_marker": True}</attribute>
        </xpath>

        <xpath expr="//td[@name='td_product_priceunit']/span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'min_precision': 0} if jp_hide_zero_decimals else {}</attribute>
        </xpath>
    </template>
</odoo>
