<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_pl_res_company_form_view" model="ir.ui.view">
            <field name="name">l10n_pl.res.company.form.view</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='identifiers']" position="after">
                    <field name="l10n_pl_reports_tax_office_id" invisible="country_id != %(base.pl)d"/>
                    <field name="l10n_pl_birthdate" invisible="country_id != %(base.pl)d"/>
                </xpath>
            </field>
        </record>

        <record id="l10n_pl_res_company_form_view_onboarding" model="ir.ui.view">
            <field name="name">l10n_pl.res.company.form.view.onboarding</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="account.res_company_form_view_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="l10n_pl_reports_tax_office_id" invisible="country_id != %(base.pl)d"/>
                    <field name="l10n_pl_birthdate" invisible="country_id != %(base.pl)d"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
