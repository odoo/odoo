<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_eg_edi_pos.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <div name="logo" position="after">
                <div name="l10n_eg_edi_pos_qr" class="text-center mt-1 mb-3" t-if="extra_data.get('l10n_eg_edi_pos_qr')">
                    <img t-att-src="extra_data['l10n_eg_edi_pos_qr']" alt="ETA QR Code" class="pos-receipt-qrcode" style="width: 65%"/>
                </div>
            </div>
            <div name="ticket_reference" position="after">
                <t t-if="config['l10n_eg_edi_pos_enable'] and extra_data.get('l10n_eg_edi_pos_refunded_order_ref')">
                    <div name="l10n_eg_edi_pos_reversal_of">
                        Reversal of: <t t-out="extra_data['l10n_eg_edi_pos_refunded_order_ref']"/>
                    </div>
                    <div name="l10n_eg_edi_pos_refund_reason" t-if="order.get('l10n_eg_edi_pos_refund_reason')">
                        Reason: <t t-out="order['l10n_eg_edi_pos_refund_reason']"/>
                    </div>
                </t>
            </div>
            <div name="header" position="before">
                <div name="l10n_eg_edi_pos_not_legal" class="text-center mt-3" t-if="config['l10n_eg_edi_pos_enable'] and order['l10n_eg_edi_pos_state'] != 'sent' and order['l10n_eg_edi_pos_state'] != 'sent_test'">
                    <div class="text-bold">THIS IS NOT A LEGAL DOCUMENT</div>
                    <div class="text-bold">هذا المستند ليس مستندا قانونيا</div>
                </div>
            </div>
        </template>
    </data>
</odoo>
