<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="sale_stock_product_expiry_report_invoice_document" inherit_id="stock_account.stock_account_report_invoice_document">
        <xpath expr="//td[@name='lot']" position="inside">
            <span t-if="snln_line['lot_expiration_date'] and env.user.has_group('sale_stock_product_expiry.group_exp_date_on_invoice')"> - <t t-out="snln_line['lot_expiration_date']" t-options='{"widget": "date"}'/></span>
        </xpath>
    </template>
</odoo>
