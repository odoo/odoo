<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock.account.product.expiry</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock_account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <setting id='group_lot_on_invoice'>
                    <div class="row mt-2" invisible="not group_lot_on_invoice or not module_product_expiry">
                        <field name="group_exp_date_on_invoice" class="col flex-grow-0 ml16 mr0 pe-2"/>
                        <div class="col ps-0">
                            <label for="group_exp_date_on_invoice"/>
                            <div class="text-muted">
                                Expiration dates will appear on the invoice
                            </div>
                        </div>
                    </div>
                </setting>
            </field>
        </record>
    </data>
</odoo>
