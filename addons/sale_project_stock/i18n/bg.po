msgid "Project"
msgstr "Проект"

#. module: sale_project_stock
#: model:ir.model,name:sale_project_stock.model_sale_order_line
msgid "Sales Order Line"
msgstr "Ред на поръчка за продажби"

#. module: sale_project_stock
