<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_automation_search" model="ir.ui.view">
        <field name="name">automation.rule.search</field>
        <field name="model">automation.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="model_id" />
                <separator />
                <filter
                    name="inactive"
                    string="Include Archived"
                    domain="[('active', 'in', [False, True])]" />
            </search>
        </field>
    </record>

    <record id="view_automation_tree" model="ir.ui.view">
        <field name="name">automation.rule.list</field>
        <field name="model">automation.rule</field>
        <field name="arch" type="xml">
            <list string="Automation Rules">
                <field name="name" />
                <field name="trigger" />
                <field name="model_id" />
                <field name="step_count" optional="show" />
                <field name="edge_count" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_automation_kanban" model="ir.ui.view">
        <field name="name">automation.rule.kanban</field>
        <field name="model">automation.rule</field>
        <field name="arch" type="xml">
            <kanban
                string="Automation Rules"
                class="o_automation_kanban_view"
                group_create="false"
                group_delete="false"
                group_edit="false"
                groups_draggable="false"
                quick_create="false"
                records_draggable="false">
                <field name="active" />
                <templates>
                    <t t-name="card" class="flex-md-row">
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            invisible="active"
                            bg_color="text-bg-danger" />
                        <div
                            class="d-flex align-items-center w-100 w-md-25 o_automation_base_info">
                            <div class="d-flex flex-column">
                                <field name="name" class="fs-2 fw-bold" />
                                <field
                                    name="model_id"
                                    invisible="context.get('default_model_id')" />
                                <div
                                    class="d-flex align-items-center gap-1"
                                    invisible="trigger in ['on_time', 'on_time_created', 'on_time_updated']">
                                    <field name="trigger" />
                                    <field
                                        name="on_change_field_ids"
                                        invisible="trigger != 'on_change'"
                                        class="my-1" />
                                    <field
                                        name="trg_selection_field_id"
                                        invisible="trigger not in ['on_state_set', 'on_priority_set']"
                                        class="o_tag o_tag_color_0 rounded-pill p-1 px-2" />
                                    <field
                                        name="trg_field_ref"
                                        invisible="trigger not in ['on_stage_set', 'on_tag_set']"
                                        class="o_tag o_tag_color_0 rounded-pill p-1 px-2" />
                                    <field
                                        name="trigger_field_ids"
                                        invisible="trigger not in ['on_create_or_write']"
                                        class="my-1" />
                                </div>
                                <div
                                    class="d-flex align-items-center gap-1"
                                    invisible="trigger != 'on_time'">
                                    <field name="trg_date_range" />
                                    <field
                                        name="trg_date_range_type"
                                        class="text-lowercase text-nowrap" />
                                    <field
                                        name="trg_date_range_mode"
                                        class="text-lowercase text-nowrap" />
                                    <span class="flex-shrink-0"> based on <field name="trg_date_id" invisible="trigger != 'on_time'" class="o_tag o_tag_color_0 rounded-pill p-1 px-2" />
                                    </span>
                                </div>
                                <div
                                    class="d-flex align-items-center gap-1"
                                    invisible="trigger not in ['on_time_created', 'on_time_updated']">
                                    <field name="trg_date_range" />
                                    <field
                                        name="trg_date_range_type"
                                        class="text-lowercase" />
                                    <field name="trigger" class="text-lowercase" />
                                    <field
                                        name="trg_date_id"
                                        invisible="trigger != 'on_time'"
                                        class="o_tag o_tag_color_0 rounded-pill p-1 px-2" />
                                </div>
                                <field
                                    name="trg_date_calendar_id"
                                    invisible="not trg_date_id or trg_date_range_type != 'day'" />
                            </div>
                        </div>
                        <div
                            class="d-none d-md-flex flex-grow-1 align-items-center gap-3 o_automation_actions"
                            data-name="more-info">
                            <i
                                class="fa-solid fa-arrow-right fa-2x text-primary"
                                title="Actions" />
                            <field
                                name="action_server_ids"
                                widget="automation_actions_one2many"
                                class="align-self-center w-100 me-md-3" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_automation_form" model="ir.ui.view">
        <field name="name">Automations</field>
        <field name="model">automation.rule</field>
        <field name="arch" type="xml">
            <form string="Automation Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <field name="active" invisible="1" />
                    <field name="model_name" force_save="True" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="bg-danger" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Set an explicit name" />
                        </h1>
                    </div>
                    <group
                        groups="!base.group_no_one"
                        invisible="context.get('default_model_id')">
                        <group>
                            <field name="model_id" options="{'no_create': True}" />
                        </group>
                    </group>
                    <group groups="base.group_no_one">
                        <group>
                            <field name="model_id" options="{'no_create': True}" />
                        </group>
                    </group>
                    <group invisible="not model_id">
                        <group>
                            <label for="trigger" />
                            <div>
                                <div class="d-flex flex-row">
                                    <field
                                        name="trigger"
                                        widget="automation_trigger_selection" />
                                    <field
                                        name="trg_date_id"
                                        placeholder="Select a date field..."
                                        context="{'hide_model': 1}"
                                        options="{'no_open': True, 'no_create': True}"
                                        invisible="trigger != 'on_time'"
                                        required="trigger == 'on_time'"
                                        class="oe_inline" />
                                    <field
                                        name="trg_selection_field_id"
                                        placeholder="Select a value..."
                                        options="{'no_open': True, 'no_create': True}"
                                        invisible="trigger not in ['on_state_set', 'on_priority_set']"
                                        required="trigger in ['on_state_set', 'on_priority_set']"
                                        class="oe_inline" />
                                    <field
                                        name="trg_field_ref"
                                        placeholder="Select a value..."
                                        options="{'no_open': True, 'no_create': True}"
                                        invisible="trigger not in ['on_stage_set', 'on_tag_set']"
                                        required="trigger in ['on_stage_set', 'on_tag_set']"
                                        class="oe_inline" />
                                    <field
                                        name="trg_field_ref_model_name"
                                        invisible="1" />
                                </div>
                                <div class="text-muted" invisible="trigger != 'on_change'"><i class="fa-solid fa-triangle-exclamation" title="Warning" /> Automation rules triggered by UI
                                    changes will be executed <em>every time</em> the watched fields
                                    change, <em>whether you save or not</em>.</div>
                            </div>
                            <label
                                for="trg_date_range"
                                invisible="trigger not in ['on_time', 'on_time_created', 'on_time_updated']" />
                            <div
                                class="d-flex flex-row gap-2"
                                invisible="trigger not in ['on_time', 'on_time_created', 'on_time_updated']">
                                <field
                                    name="trg_date_range"
                                    required="trigger in ['on_time', 'on_time_created', 'on_time_updated']"
                                    class="oe_inline o_input_3ch" />
                                <field
                                    name="trg_date_range_type"
                                    required="trigger in ['on_time', 'on_time_created', 'on_time_updated']"
                                    class="oe_inline" />
                                <field
                                    name="trg_date_range_mode"
                                    invisible="trigger in ['on_time_created', 'on_time_updated']"
                                    required="trigger == 'on_time'"
                                    class="oe_inline" />
                                <button
                                    name="action_view_scheduled_action"
                                    type="object"
                                    string="Scheduled action"
                                    icon="oi-arrow-right"
                                    groups="base.group_no_one"
                                    class="oe_inline btn-link mt-n1" />
                            </div>
                            <field
                                name="trg_date_calendar_id"
                                options="{'no_open': True, 'no_create': True}"
                                invisible="not trg_date_id or trg_date_range_type != 'day'"
                                class="oe_inline" />
                            <label
                                for="last_run"
                                invisible="trigger not in ['on_time', 'on_time_created', 'on_time_updated']" />
                            <div
                                invisible="trigger not in ['on_time', 'on_time_created', 'on_time_updated']">
                                <field name="last_run" class="oe_inline" />
                                <div class="text-muted small mt-1" invisible="last_run">
                                    <i
                                        class="fa-solid fa-triangle-exclamation"
                                        title="Warning" />
                                    Empty: the first run covers the entire history and processes
                                    every record that already matches. Set a date to scope it.
                                </div>
                            </div>
                            <field
                                name="filter_pre_domain"
                                widget="domain"
                                options="{'model': 'model_name', 'in_dialog': True, 'allow_expressions':True}"
                                groups="base.group_no_one"
                                invisible="trigger in [                                     'on_create',                                     'on_unlink',                                     'on_change',                                     'on_webhook',                                     'on_time',                                     'on_time_created',                                     'on_time_updated'                                 ]" />
                            <field name="previous_domain" invisible="1" />
                            <field
                                name="filter_domain"
                                widget="domain"
                                options="{'model': 'model_name', 'in_dialog': True, 'allow_expressions':True}"
                                groups="base.group_no_one"
                                invisible="trigger in ['on_webhook']" />
                            <field
                                name="filter_domain"
                                widget="domain"
                                options="{'model': 'model_name', 'in_dialog': False, 'foldable': True, 'allow_expressions':True}"
                                groups="!base.group_no_one"
                                invisible="trigger not in ['on_create', 'on_create_or_write', 'on_change', 'on_unlink', 'on_time', 'on_time_created', 'on_time_updated']" />
                            <field
                                name="trigger_field_ids"
                                string="When updating"
                                placeholder="Select fields..."
                                widget="many2many_tags"
                                domain="[('model_id', '=', model_id),('store','=',True)]"
                                context="{'hide_model': 1}"
                                options="{'no_open': True, 'no_create': True}"
                                invisible="trigger != 'on_create_or_write'" />
                            <field
                                name="on_change_field_ids"
                                string="When updating"
                                placeholder="Select fields..."
                                widget="many2many_tags"
                                domain="[('model_id', '=', model_id)]"
                                context="{'hide_model': 1}"
                                options="{'no_open': True, 'no_create': True}"
                                invisible="trigger != 'on_change'" />
                        </group>
                        <group name="trigger_target">
                        </group>
                    </group>
                    <notebook invisible="not model_id">
                        <page name="actions" string="Actions To Do">
                            <field
                                name="action_server_ids"
                                widget="one2many"
                                mode="kanban"
                                context="{'default_model_id': model_id, 'is_modal': 1}" />
                        </page>
                        <page name="notes" string="Notes">
                            <field
                                name="description"
                                placeholder="Keep track of what this automation does and why it exists..." />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="automation_act" model="ir.actions.act_window">
        <field name="name">Automation Rules</field>
        <field name="res_model">automation.rule</field>
        <field name="path">automations</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_automation_kanban" />
        <field name="context">{'search_default_inactive': 1}</field>
        <field name="help" type="html">
            <img class="w-100 w-md-75" src="/automation/static/img/automation.svg" />
            <p> Automate <em>everything</em> with Automation Rules </p>
            <p>
                Send an email when an object changes state, archive records
                after a month of inactivity or remind yourself to follow-up on
                tasks when a specific tag is added.
            </p>
            <p>With Automation Rules, you can automate <em>any</em> workflow. </p>
        </field>
    </record>

</odoo>
