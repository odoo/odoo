<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Chatter templates -->
<template id="event_track_template_new" technical_usage="mail_post_source">
    <p>
        <span>New track proposal</span>
        <t t-out="track._get_html_link(title=track.name)"/>
    </p>
    <ul>
        <li t-foreach="track.speaker_ids" t-as="speaker">
            <b>Speaker</b>: <span t-out="speaker.display_name"/>
            <ul>
                <li t-if="speaker.email">
                    <b>Mail</b>: <a t-attf-href="mailto:#{speaker.email}" t-out="speaker.email"></a>
                </li>
                <li t-if="speaker.phone">
                    <b>Phone</b>: <span t-out="speaker.phone"/>
                </li>
                <li t-if="not is_html_empty(speaker.biography)">
                    <b>Speaker Biography</b>: <div t-field="speaker.biography"/>
                </li>
            </ul>
        </li>
        <li t-if="track.partner_id">
            <b>Proposed By</b>: <span t-out="track.partner_id.name"/>
        </li>
        <li t-if="track.contact_email">
            <b>Contact Mail</b>: <a t-attf-href="mailto:#{track.contact_email}" t-out="track.contact_email"></a>
        </li>
        <li t-if="track.contact_phone">
            <b>Contact Phone</b>: <span t-out="track.contact_phone"/>
        </li>
        <li t-if="not is_html_empty(track.description)">
            <b>Talk Introduction</b>: <div t-field="track.description"/>
        </li>
    </ul>
</template>

</odoo>
