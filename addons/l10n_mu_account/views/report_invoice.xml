<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//div[@id='informations']" position="before">
            <t t-set="forced_vat" t-value="o.company_id.vat"/>
        </xpath>

        <xpath expr="//t[@name='address_not_same_as_shipping']" position="inside">
            <span t-out="o.partner_id._get_additional_identifier('MU_BRN')"/>
        </xpath>
        <xpath expr="//t[@name='address_same_as_shipping']" position="inside">
            <span t-out="o.partner_id._get_additional_identifier('MU_BRN')"/>
        </xpath>
        <xpath expr="//t[@name='no_shipping']" position="inside">
            <span t-out="o.partner_id._get_additional_identifier('MU_BRN')"/>
        </xpath>

        <xpath expr="//div[@id='total']" position="after">
            <div t-if="o.currency_id.id != o.company_id.currency_id.id" class="ms-1">
                <strong>Exchange Rate</strong>: 1 <span t-out="o.company_id.currency_id.name"/> = <span t-out="round(o.invoice_currency_rate, 8)"/> <span t-out="o.currency_id.name"/>
            </div>
        </xpath>
    </template>

    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'l10n_mu_account.report_invoice_document'"
               t-call="l10n_mu_account.report_invoice_document"
               t-lang="lang"/>
        </xpath>
    </template>
</odoo>
