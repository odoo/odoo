<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_room" model="res.groups.privilege">
        <field name="name">Room</field>
        <field name="sequence">3</field>
        <field name="category_id" ref="base.module_category_productivity" />
    </record>

    <record id="group_room_manager" model="res.groups">
        <field name="name">Manage Rooms</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_room" />
        <field
            name="comment">Enable the user to manage meeting rooms available for booking</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

    <record id="resource_asset_rule_room_manager" model="ir.rule">
        <field name="name">resource.asset: room managers manage rooms</field>
        <field name="model_id" ref="resource_asset.model_resource_asset" />
        <field name="domain_force">[('kind_id.code', '=', 'room')]</field>
        <field name="groups" eval="[Command.link(ref('group_room_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="resource_resource_rule_room_manager_create" model="ir.rule">
        <field
            name="name">resource.resource: room managers create the resource a room is made of</field>
        <field name="model_id" ref="resource.model_resource_resource" />
        <field name="domain_force">[('resource_type', '=', 'material')]</field>
        <field name="groups" eval="[Command.link(ref('group_room_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="resource_resource_rule_room_manager_write" model="ir.rule">
        <field
            name="name">resource.resource: room managers write and unlink the resources of rooms only</field>
        <field name="model_id" ref="resource.model_resource_resource" />
        <field name="domain_force">[('asset_id.kind_id.code', '=', 'room')]</field>
        <field name="groups" eval="[Command.link(ref('group_room_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="appointment_booking_line_rule_room_employee" model="ir.rule">
        <field
            name="name">appointment.booking.line: employees book rooms for their own meetings</field>
        <field name="model_id" ref="calendar.model_appointment_booking_line" />
        <field
            name="domain_force">[('resource_id.asset_id.kind_id.code', '=', 'room'), ('calendar_event_id.user_id', 'in', [user.id, False])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="appointment_booking_line_rule_room_manager" model="ir.rule">
        <field
            name="name">appointment.booking.line: room managers manage every room booking</field>
        <field name="model_id" ref="calendar.model_appointment_booking_line" />
        <field
            name="domain_force">[('resource_id.asset_id.kind_id.code', '=', 'room')]</field>
        <field name="groups" eval="[Command.link(ref('group_room_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

</odoo>
