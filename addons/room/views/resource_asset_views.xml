<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_view_search_room" model="ir.ui.view">
        <field name="name">resource.asset.search.room</field>
        <field name="model">resource.asset</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="Room">
                <field name="name" string="Room" />
                <field name="address_id" string="Office" />
                <field name="asset_properties" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <filter
                    name="group_by_address_id"
                    string="Office"
                    context="{'group_by': 'address_id'}" />
                <filter
                    name="group_by_company_id"
                    context="{'group_by': 'company_id'}"
                    groups="base.group_multi_company" />
                <searchpanel>
                    <field name="company_id" />
                    <field
                        name="address_id"
                        string="Office"
                        icon="fa-building"
                        enable_counters="1"
                        select="multi" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="resource_asset_view_kanban_room" model="ir.ui.view">
        <field name="name">resource.asset.kanban.room</field>
        <field name="model">resource.asset</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="room_is_available" />
                <field name="room_next_booking_start" />
                <field name="active" />
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside
                            invisible="not room_background_image"
                            class="o_kanban_aside_full">
                            <field
                                name="room_background_image"
                                widget="image"
                                options="{'size': [150,100]}" />
                        </aside>
                        <main class="ml8">
                            <field name="name" class="fw-bolder fs-5" />
                            <field name="address_id" />
                            <field name="asset_properties" widget="properties" />
                            <footer class="pt-0">
                                <div
                                    t-if="record.active.raw_value"
                                    t-attf-class="py-1 px-2 text-bg-#{record.room_is_available.raw_value ? 'success' : 'danger'}">
                                    <t t-if="record.room_is_available.raw_value">Available</t>
                                    <t t-else="">Busy</t>
                                    <t t-if="record.room_next_booking_start.value">
                                        <t
                                            t-set="start_datetime"
                                            t-value="luxon.DateTime.fromISO(record.room_next_booking_start.raw_value)" />
                                        Until
                                        <t
                                            t-if="start_datetime.hasSame(luxon.DateTime.now(), 'day')"
                                            t-out="start_datetime.toLocaleString(luxon.DateTime.TIME_SIMPLE)" />
                                        <t
                                            t-else=""
                                            t-out="start_datetime.toLocaleString(luxon.DateTime.DATE_SHORT)" />
                                    </t>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="resource_asset_view_list_room" model="ir.ui.view">
        <field name="name">resource.asset.list.room</field>
        <field name="model">resource.asset</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" />
                <field name="address_id" string="Office" />
                <field name="room_is_available" string="Is Currently Available" />
                <field name="room_next_booking_start" />
                <field name="asset_properties" />
            </list>
        </field>
    </record>

    <record id="resource_asset_view_form_room" model="ir.ui.view">
        <field name="name">resource.asset.form.room</field>
        <field name="model">resource.asset</field>
        <field name="inherit_id" ref="resource_asset.resource_asset_view_form" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <button
                    name="action_view_room_booking_view"
                    type="object"
                    string="Open Room Display"
                    invisible="kind_code != 'room' or not active or not room_short_code" />
            </field>
            <notebook position="inside">
                <page
                    name="room"
                    string="Room"
                    invisible="kind_code != 'room' or not id">
                    <group>
                        <group>
                            <field name="room_short_code" />
                            <field
                                name="room_booking_url"
                                widget="CopyClipboardChar"
                                invisible="not active" />
                            <field name="room_next_booking_start" />
                            <button
                                name="action_view_room_bookings"
                                type="object"
                                string="View Bookings"
                                class="btn-link ps-0" />
                        </group>
                        <group>
                            <field
                                name="room_bookable_background_color"
                                widget="color" />
                            <field name="room_booked_background_color" widget="color" />
                            <field name="room_background_image" widget="image" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="room_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">resource.asset</field>
        <field name="path">meeting-rooms</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="resource_asset_view_search_room" />
        <field name="domain">[('kind_id.code', '=', 'room')]</field>
        <field
            name="context"
            eval="{'default_kind_id': ref('room.kind_room'), 'default_state': 'in_service'}" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Rooms
            </p>
            <p>
                They can then be booked for meetings from a Tablet or the back-end.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[                 Command.clear(),                 Command.create({'view_mode': 'kanban', 'view_id': ref('resource_asset_view_kanban_room')}),                 Command.create({'view_mode': 'list', 'view_id': ref('resource_asset_view_list_room')}),             ]" />
    </record>

</odoo>
