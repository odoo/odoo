<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="room_office_main_office" model="res.partner">
        <field name="name">Main Office</field>
        <field name="type">other</field>
        <field name="parent_id" ref="base.main_partner" />
        <field name="company_id" ref="base.main_company" />
    </record>

    <record id="room_office_head_office" model="res.partner">
        <field name="name">Head Office</field>
        <field name="type">other</field>
        <field name="parent_id" ref="base.main_partner" />
        <field name="company_id" ref="base.main_company" />
    </record>

    <record id="room_room_main_office_room_1_resource" model="resource.resource">
        <field name="name">Big Meeting Room</field>
        <field name="resource_type">material</field>
        <field name="short_code">room1</field>
    </record>

    <record id="room_room_main_office_room_1" model="resource.asset">
        <field name="name">Big Meeting Room</field>
        <field name="kind_id" ref="kind_room" />
        <field name="state">in_service</field>
        <field name="address_id" ref="room_office_main_office" />
        <field name="description">Projector, whiteboard</field>
        <field name="resource_id" ref="room_room_main_office_room_1_resource" />
    </record>

    <record id="room_room_main_office_room_2_resource" model="resource.resource">
        <field name="name">Medium Meeting Room</field>
        <field name="resource_type">material</field>
        <field name="short_code">room2</field>
    </record>

