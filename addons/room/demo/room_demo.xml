    <record id="room_booking_room_1_booking_1" model="calendar.event">
        <field name="name">Daily Followup</field>
        <field name="start" eval="time.strftime('%Y-%m-%d 09:00:00')" />
        <field name="stop" eval="time.strftime('%Y-%m-%d 10:00:00')" />
        <field name="user_id" ref="base.user_demo" />
        <field name="appointment_type_id" ref="appointment_type_room" />
        <field
            name="booking_line_ids"
            eval="[Command.create({'resource_id': ref('room_room_main_office_room_1_resource'), 'capacity_reserved': 1})]" />
    </record>

