        <field name="kind_id" ref="kind_room" />
        <field name="state">in_service</field>
        <field name="address_id" ref="room_office_main_office" />
        <field name="description">Capacity: 6 people</field>
        <field name="resource_id" ref="room_room_main_office_room_3_resource" />
    </record>

    <record id="room_room_head_office_room_1_resource" model="resource.resource">
        <field name="name">First Floor's Room</field>
        <field name="resource_type">material</field>
        <field name="short_code">floor1</field>
    </record>

    <record id="room_room_head_office_room_1" model="resource.asset">
        <field name="name">First Floor's Room</field>
        <field name="kind_id" ref="kind_room" />
        <field name="state">in_service</field>
