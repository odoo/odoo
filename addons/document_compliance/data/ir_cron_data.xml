<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_document_expiration_notifications" model="ir.cron">
        <field name="name">Document Expiration Notifications</field>
        <field name="model_id" ref="model_document_document" />
        <field name="state">code</field>
        <field name="code">model.cron_document_notifications()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
    </record>

    <!--
        The dashboard is a materialized view, so it is only as current as its
        last refresh. Thirty minutes keeps a newly filed or edited document
        visible quickly while costing one full pass over the entity universe.
        It also re-reads compliance_state after the daily
        "Find and set documents expired" run, which is what moves a document
        into expired or expiring_soon in the first place.
    -->
    <record id="ir_cron_refresh_compliance_report" model="ir.cron">
        <field name="name">Compliance Dashboard: refresh</field>
        <field name="model_id" ref="model_document_compliance_report" />
        <field name="state">code</field>
        <field name="code">model._cron_refresh_materialized_view()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="30" />
        <field name="repeat_unit">minute</field>
    </record>

</odoo>
