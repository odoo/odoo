<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="website.ResourceEditor">
        <div class="o_resource_editor w-100 h-100">
            <div class="o_resource_editor_title">
                <div class="btn-group o_resource_editor_type_switcher">
                    <Dropdown>
                        <button class="btn btn-info"><t t-out="this.types[this.state.type]"/><span class="o_caret_down"/></button>
                        <t t-set-slot="content">
                            <t t-foreach="Object.keys(this.types)" t-as="type" t-key="type">
                                <DropdownItem onSelected="() => this.onFileTypeChange(type)">
                                    <t t-out="this.types[type]"/>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>
                </div>
                <SelectMenu t-props="this.selectMenuProps" class="'o_resource_editor_resource_list'">
                    <t t-set="resource" t-value="this.state.currentResource"/>
                    <t t-call="website.ResourceEditor.ResourceLabel"
                        resource="resource"
                        label="this.state.type === 'xml' ? resource.name : resource.label"/>
                    <t t-set-slot="choice" t-slot-scope="scope">
                        <t t-call="website.ResourceEditor.ResourceLabel"
                            resource="this.state.resources[this.state.type][scope.data.value]"
                            label="scope.data.label"/>
                    </t>
                </SelectMenu>
                <label t-if="this.state.type === 'xml' and this.debugMode.isActive()" class="o_resource_editor_filter">
                    <div class="btn-group o_resource_editor_type_switcher">
                        <Dropdown>
                            <button class="btn btn-primary">Filter</button>
                            <t t-set-slot="content">
                                <t t-foreach="Object.keys(this.xmlFilters)" t-as="filter" t-key="filter">
                                    <CheckboxItem class="{ selected: this.state.xmlFilter === filter }" checked="this.state.xmlFilter === filter" onSelected="() => this.onFilterChange('xml', filter)">
                                        <t t-out="this.xmlFilters[filter]"/>
                                    </CheckboxItem>
                                </t>
                            </t>
                        </Dropdown>
                    </div>
                </label>
                <label t-if="this.state.type === 'scss' and this.debugMode.isActive()" class="o_resource_editor_filter">
                    <div class="btn-group o_resource_editor_type_switcher">
                        <Dropdown>
                            <button class="btn btn-primary">Filter</button>
                            <t t-set-slot="content">
                                <t t-foreach="Object.keys(this.scssFilters)" t-as="filter" t-key="filter">
                                    <CheckboxItem class="{ selected: this.state.scssFilter === filter }" checked="this.state.scssFilter === filter" onSelected="() => this.onFilterChange('scss', filter)">
                                        <t t-out="this.scssFilters[filter]"/>
                                    </CheckboxItem>
                                </t>
                            </t>
                        </Dropdown>
                    </div>
                </label>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-att-disabled="!this.hasUnsavedChanges()" t-on-click="this.onSave"><i t-if="this.state.saving" class="oi oi-spin mr8" data-icon="autorenew" role="img" aria-hidden="true"/>Save</button>
                    <button class="btn btn-secondary" t-on-click="this.props.close">Close</button>
                </div>
            </div>
            <div t-if="this.state.currentResource" id="resource-editor-id" class="d-flex align-items-center">
                <span class="o_resource_editor_resource_info text-truncate" t-att-data-tooltip="this.resourceInfo" t-out="this.resourceInfo"/>
                <a t-if="this.state.type === 'xml'"
                    t-att-href="'/odoo/action-base.action_ui_view/' + this.state.currentResource.id"
                    target="_blank" class="ms-1" data-tooltip="Open the view record in a new tab"
                    aria-label="Open the view record in a new tab">
                    <i class="oi" data-icon="open_in_new" role="img" aria-hidden="true"/>
                </a>
                <t t-set="websiteStatusInfo" t-value="this.getWebsiteStatusInfo()"/>
                <span t-if="websiteStatusInfo"
                    class="o_resource_editor_website_status ms-2 small opacity-75 text-nowrap"
                    t-att-data-tooltip="websiteStatusInfo.tooltip"
                    t-out="websiteStatusInfo.label"/>
                <Dropdown t-if="this.incomingOperations().length">
                    <button type="button"
                        class="btn btn-sm btn-link p-0 border-0 text-nowrap o_resource_editor_modified_by">
                        <t t-out="this.getModifiedByLabel()"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.getIncomingViews()" t-as="incomingView" t-key="incomingView.view.id">
                            <DropdownItem class="'d-flex align-items-baseline justify-content-between gap-3'"
                                onSelected="() => this.openView(incomingView.view.id, incomingView.operations[0].index)">
                                <span>
                                    <t t-call="website.ResourceEditor.ResourceLabel"
                                        resource="incomingView.view"
                                        label="incomingView.view.name"/>
                                </span>
                                <small class="text-muted text-nowrap" t-out="this.getOperationRowsLabel(incomingView.operations)"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
                <div class="d-flex flex-shrink-0 ms-auto ps-2">
                    <button t-if="this.state.type !== 'xml' and this.isCustomResource(this.state.currentResource.url)" type="button" class="btn btn-sm btn-danger" t-on-click="this.onReset">
                        <i class="oi" data-icon="undo" role="img" aria-hidden="true"/>
                        Reset
                    </button>
                    <button type="button" class="btn btn-sm btn-link" t-on-click="this.openSearch">Search</button>
                    <button t-if="this.state.type === 'xml'" type="button" class="btn btn-sm btn-link" t-on-click="this.onFormat">Format</button>
                </div>
            </div>
            <div t-if="this.state.currentResource" id="resource-editor" t-ref="this.editorRef">
                <CodeEditorWithGutterMarkers
                    class="'h-100'"
                    value="this.state.currentResource.arch"
                    sessionId="this.state.currentResource.id"
                    mode="this.typeToCodeEditorModeMap[this.state.type]"
                    theme="'monokai'"
                    onChange.bind="this.onEditorChange"
                    markers="this.codeEditorMarkers()"
                    onMarkerClick.bind="this.onMarkerClick"
                    revealRow="this.revealRow()"
                    onEditorReady.bind="this.onEditorReady"/>
            </div>
        </div>
        <ResourceEditorWarningOverlay/>
    </t>

    <t t-name="website.ResourceEditor.ResourceLabel">
        <i t-if="resource.customized or resource.dirty" t-att-class="{ 'oi mr8': true, 'text-warning': resource.dirty, 'text-success': resource.customized }" data-icon="save" role="img" aria-hidden="true"/>
        <t t-out="label"/>
    </t>

    <t t-name="website.ResourceOperationsPopover">
        <div class="py-2">
            <t t-if="this.props.modifiedBy.length">
                <div class="px-3 pb-1 small text-muted" t-out="this.getModifiedByTitle()"/>
                <t t-foreach="this.props.modifiedBy" t-as="item" t-key="item_index">
                    <t t-call="website.ResourceOperationsPopover.Item"/>
                </t>
            </t>
            <t t-if="this.props.modifies.length">
                <div class="px-3 pb-1 small text-muted"
                    t-att-class="{ 'pt-2': this.props.modifiedBy.length }"
                    t-out="this.getModifiesTitle()"/>
                <t t-foreach="this.props.modifies" t-as="item" t-key="item_index">
                    <t t-call="website.ResourceOperationsPopover.Item"/>
                </t>
            </t>
        </div>
    </t>

    <t t-name="website.ResourceOperationsPopover.Item">
        <button type="button" class="dropdown-item px-3" t-on-click="item.onSelect">
            <t t-call="website.ResourceEditor.ResourceLabel"
                resource="item.view"
                label="item.view.name"/>
            <small t-if="item.row" class="ms-1 text-muted">(:<t t-out="item.row"/>)</small>
        </button>
    </t>

</templates>
