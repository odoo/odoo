<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website.UrlAutoComplete">
        <AutoCompleteWithPages
            input="this.inputRef"
            onInput.bind="this.onInput"
            menuCssClass="this.dropdownClass"
            menuPositionOptions="this.dropdownOptions"
            sources="this.sources"
            targetDropdown="this.props.targetDropdown"
        >
            <t t-set-slot="option" t-slot-scope="optionScope">
                <div>
                    <t t-out="optionScope.label"/>
                </div>
            </t>
        </AutoCompleteWithPages>
    </t>
</templates>
