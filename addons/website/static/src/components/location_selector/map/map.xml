<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website.locationSelector.map">
        <div class="o_location_selector_map w-100 flex-grow-1" t-ref="this.mapRef"/>
    </t>

    <t t-name="website.locationSelector.map.marker">
        <t t-call="website.locationSelector.map.pinIndicator" number="this.number"/>
    </t>

    <t t-name="website.locationSelector.map.tooltip">
        <strong t-out="location.name"/><br/>
        <t t-out="location.street"/><br/>
        <t t-out="location.zip_code"/> <t t-out="location.city"/>
        <t t-if="showPhone and location.phone">
            <br/><i class="oi oi-fw me-1" data-icon="phone" role="img" aria-hidden="true"/> <t t-out="location.phone"/>
        </t>
        <t t-if="showEmail and location.email">
            <br/><i class="oi oi-fw me-1" data-icon="mail" role="img" aria-hidden="true"/> <t t-out="location.email"/>
        </t>
        <t t-if="showWebsite and location.website">
            <br/><i class="oi oi-fw me-1" data-icon="link" role="img" aria-hidden="true"/> <a t-attf-href="{{location.website}}" target="_blank"><t t-out="location.website"/></a>
        </t>
    </t>

</templates>
