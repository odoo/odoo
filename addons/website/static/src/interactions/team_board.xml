<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website.SendMessageModal">
        <Dialog size="'lg'" modalRef="this.modalRef" contentClass="'o_team_board_modal'">
            <div class="o_team_board_modal_card d-flex align-items-start">
                <figure class="o_card_img_wrapper">
                    <img class="o_card_img card-img-top" t-att-src="this.props.imageSrc" alt=""/>
                </figure>
                <div class="card-body">
                    <h3 class="card-title o_card_title" t-out="this.props.name"/>
                    <p class="text-muted mb-3 o_job_position" t-out="this.props.jobPosition"/>
                    <p class="o_card_infos" t-out="this.props.infos"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="this.sendMessage" t-att-disabled="this.sending()">
                    Send a Message
                </button>
                
                <t t-foreach="this.contactMethods" t-as="entry" t-key="entry[0]">
                    <button type="button" class="btn btn-secondary" t-on-click="() => this.onContactMethodClick(entry[1])" t-out="entry[1].label"/>
                </t>
            </t>
        </Dialog>
    </t>

</templates>
