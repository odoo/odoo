<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="website.Configurator.SkipButton">
        <div t-attf-class="{{this.props.className || 'container-fluid py-2 pb-md-3 text-end pe-lg-5'}}">
            <button class="btn btn-link btn-lg px-0" t-on-click="this.props.skip">Skip and start from scratch</button>
        </div>
    </t>

<!-- Industry image showcase (DescriptionScreen, desktop only) -->
<t t-name="website.Configurator.IndustryImageShowcase">
    <div class="o_configurator_industry_showcase pe-none overflow-visible d-none d-lg-block" aria-hidden="true">
        <div class="d-flex align-items-start justify-content-center gap-4 w-100"
             style="transform:translateY(50%)">

            <div class="flex-shrink-0" style="width:8vw">
                <t t-if="this.previewImages[0]">
                    <div class="o_configurator_showcase_item o_configurator_showcase_slot_0">
                        <img class="o_configurator_showcase_img h-auto d-block w-100 shadow rounded" t-att-src="this.previewImages[0].url"/>
                    </div>
                </t>
            </div>

            <div class="d-flex flex-column align-items-end gap-4 mt-3 flex-shrink-0" style="width:8vw">
                <t t-if="this.previewImages[1]">
                    <div class="o_configurator_showcase_item o_configurator_showcase_slot_1">
                        <img class="o_configurator_showcase_img h-auto d-block w-100 shadow rounded" t-att-src="this.previewImages[1].url"/>
                    </div>
                </t>
                <div class="flex-shrink-0" style="width:17vw">
                    <t t-if="this.previewImages[6]">
                        <div class="o_configurator_showcase_item o_configurator_showcase_slot_6">
                            <img class="o_configurator_showcase_img h-auto d-block w-100 shadow-lg rounded-3" t-att-src="this.previewImages[6].url"/>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Col 3: main stack + absolute overlay -->
            <div class="d-flex align-items-center flex-column gap-4 flex-shrink-0 position-relative">

                <div class="flex-shrink-0" style="width:12vw">
                    <t t-if="this.previewImages[2]">
                        <div class="o_configurator_showcase_item o_configurator_showcase_slot_2">
                            <img class="o_configurator_showcase_img h-auto d-block w-100 shadow-lg rounded-3" t-att-src="this.previewImages[2].url"/>
                        </div>
                    </t>
                </div>

                <div class="flex-shrink-0" style="width:8vw">
                    <t t-if="this.previewImages[3]">
                        <div class="o_configurator_showcase_item o_configurator_showcase_slot_3">
                            <img class="o_configurator_showcase_img h-auto d-block w-100 shadow rounded" t-att-src="this.previewImages[3].url"/>
                        </div>
                    </t>
                </div>

                <!-- absolute overlay above col-3 (slots 4 & 5) -->
                <div class="position-absolute bottom-100 end-0 d-flex align-items-end gap-4 gap-xxl-5 mb-4">

                    <div class="flex-shrink-0 mb-3 mb-xxl-4 me-xxl-4" style="width:15vw">
                        <t t-if="this.previewImages[4]">
                            <div class="o_configurator_showcase_item o_configurator_showcase_slot_4">
                                <img class="o_configurator_showcase_img h-auto d-block w-100 shadow-lg rounded-3" t-att-src="this.previewImages[4].url"/>
                            </div>
                        </t>
                    </div>

                    <div class="flex-shrink-0" style="width:16vw">
                        <t t-if="this.previewImages[5]">
                            <div class="o_configurator_showcase_item o_configurator_showcase_slot_5">
                                <img class="o_configurator_showcase_img h-auto d-block w-100 shadow rounded" t-att-src="this.previewImages[5].url"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Col 4: three stacked, offset upward -->
            <div class="d-flex flex-column gap-4 gap-xxl-5 flex-shrink-0 justify-content-start"
                 style="transform:translateY(-50%)">

                <div class="flex-shrink-0" style="width:17vw">
                    <t t-if="this.previewImages[7]">
                        <div class="o_configurator_showcase_item o_configurator_showcase_slot_7">
                            <img class="o_configurator_showcase_img h-auto d-block w-100 shadow rounded" t-att-src="this.previewImages[7].url"/>
                        </div>
                    </t>
                </div>

                <div class="flex-shrink-0" style="width:9vw">
                    <t t-if="this.previewImages[8]">
                        <div class="o_configurator_showcase_item o_configurator_showcase_slot_8">
                            <img class="o_configurator_showcase_img h-auto d-block w-100 shadow rounded" t-att-src="this.previewImages[8].url"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.DescriptionScreen">
    <div class="o_configurator_background position-absolute top-0 start-0 end-0 bottom-0">
        <span class="o_configurator_background_inner position-absolute top-0 start-0 end-0 bottom-0 pe-none"/>
    </div>
    <div class="o_configurator_screen overflow-x-hidden h-100 d-flex flex-row-reverse justify-content-around position-relative px-3 px-xxl-0">
        <div class="o_description_screen_image_preview position-relative d-none d-lg-flex flex-column w-50 h-100">
            <div class="d-flex flex-grow-1 align-items-center justify-content-center">
                <t t-if="this.previewImages.length" t-call="website.Configurator.IndustryImageShowcase"/>
            </div>
            <SkipButton skip="this.props.skip" className="'py-2 pb-md-3 text-end mt-auto z-1'"/>
        </div>
        <div class="d-flex flex-column o_configurator_screen o_description_screen px-2 position-relative"
            t-on-focusin="this.onConfiguratorScreenFocusin">
            <div class="o_configurator_screen_content position-relative d-flex h-100 flex-grow-1">
                <div class="container align-self-center p-0">
                    <div class="o_configurator_typing_text d-inline d-md-block mb-md-2 mb-lg-4 o_configurator_show">
                        <span>I want </span>
                        <div t-attf-class="dropdown o_configurator_type_dd d-inline-block {{this.state.selectedType ? 'o_step_completed' : 'o_step_todo show'}}"
                            t-on-focusout="this.onDropdownFocusout">
                            <button id="selectTypeToggle"
                                    class="o_btn_reset w-100 px-2"
                                    data-bs-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="true"
                                    aria-label="What type of website?"
                                    aria-controls="selectTypeMenu">
                                <span class="d-flex align-items-center">
                                    <i class="text-primary" t-if="this.state.selectedType">
                                        <t t-out="this.state.getSelectedType(this.state.selectedType).label"/>
                                    </i>
                                    <i class="oi ms-auto ps-2" data-icon="keyboard_arrow_down" role="img"/>
                                </span>
                            </button>
                            <div id="selectTypeMenu"
                                t-attf-class="dropdown-menu border-0 shadow-lg {{this.state.selectedType ? 'o_step_completed' : 'o_step_todo show'}}"
                                role="menu"
                                aria-labelledby="selectTypeToggle">
                                <t t-foreach="this.state.getWebsiteTypes()" t-as="type" t-key="type.name">
                                    <button t-att-title="type.name"
                                            t-on-click="() => this.selectWebsiteType(type.id)"
                                            class="dropdown-item o_change_website_type"
                                            role="menuitem"
                                            t-ref="type.id === 1 ? this.autofocusRef : this.scratchTypeRef">
                                        <t t-out="type.label"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                        <span t-if="this.state.selectedType" class="me-2 o_configurator_show"> for my</span>
                    </div>
                    <div t-att-class="this.state.selectedType ? '' : 'opacity-0'" class="o_configurator_typing_text d-inline d-md-flex align-items-center o_configurator_industry mb-md-2 mb-lg-4 o_configurator_show">
                        <!-- Use t-set in order to be able to translate, if put in the attribute directly then export POT file will not exist this text-->
                        <label class="o_configurator_industry_wrapper me-2" t-ref="this.industrySelection">
                            <AutoComplete
                                placeholder.translate="Restaurant, Hair Salon, Clothing Store,..."
                                value="this.state.selectedIndustry?.label ?? ''"
                                sources="this.sources"
                                onInput.bind="this.onAutocompleteInput"
                                inputDebounceDelay="100"
                                menuPositionOptions="{ position: 'bottom-fit' }"
                                menuCssClass="'custom-ui-autocomplete shadow-lg border-0 o_configurator_show_fast o_configurator_industry_dropdown'"
                                selectOnBlur="true"
                                autoSelect="true"
                            />
                        </label>
                        <span> business</span>
                        <span t-if="this.state.selectedIndustry" class="o_configurator_show">,</span>
                    </div>
                    <div t-att-class="this.state.selectedType and this.state.selectedIndustry ? '' : 'opacity-0'" class="o_configurator_typing_text d-inline d-md-block mb-md-2 mb-lg-4 o_configurator_show">
                        <span>with a </span>
                        <div t-attf-class="dropdown d-inline-block o_configurator_purpose_dd {{this.state.selectedPositioning ? 'o_step_completed' : 'o_step_todo'}}"
                            t-on-focusout="this.onDropdownFocusout">
                            <button id="selectPurposeToggle"
                                    t-ref="this.positioningDropdownRef"
                                    class="o_btn_reset w-100 px-2"
                                    data-bs-toggle="dropdown"
                                    aria-haspopup="true"
                                    aria-expanded="true"
                                    aria-label="What positioning?"
                                    aria-controls="selectPurposeMenu">
                                <span class="d-flex align-items-center">
                                    <t t-if="this.state.selectedPositioning" t-out="this.state.selectedPositioning"/>
                                    <i class="oi ms-auto ps-2" data-icon="keyboard_arrow_down" role="img"/>
                                </span>
                            </button>
                            <div id="selectPurposeMenu" class="dropdown-menu border-0 shadow-lg show" role="menu" aria-labelledby="selectPurposeToggle">
                                <t t-if="this.state.positioningsLoading">
                                    <div class="dropdown-item text-muted"><i class="oi oi-spin me-2" data-icon="progress_activity" role="img"/>Analyzing trends...</div>
                                </t>
                                <t t-else="" t-foreach="this.state.positionings" t-as="positioning" t-key="positioning_index">
                                    <button t-on-click="() => this.selectPositioning(positioning)"
                                            class="dropdown-item o_change_website_purpose"
                                            role="menuitem"
                                            t-ref="positioning_first ? this.purposeSelectionRef : this.scratchPositioningRef">
                                        <t t-out="positioning"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                        <span> positioning</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.PaletteSelectionScreen">
    <div class="o_configurator_screen o_palette_selection_screen bg-view min-vh-100 d-flex">
        <div class="o_configurator_screen_content container d-flex flex-column flex-grow-1 justify-content-between">
            <div class="px-2 px-lg-5 pb-3 pb-lg-0 o_palette_selection_intro d-flex flex-column flex-grow-1 mb-auto">
                <input type="file" class="logo_selection_input d-none" t-on-change="this.changeLogo" name="logo_selection" t-ref="this.logoInputRef" accept="image/*"/>
                <div class="row g-3 align-items-start pt-3">
                    <div class="col-12 col-lg text-center text-lg-start">
                        <h1 class="mb-2 mb-xxl-3 o_configurator_typing_text">Choose your <b class="text-info">Color Palette</b></h1>
                        <div class="o_palette_selection_recommendation lead pe-2">
                            <t t-if="this.state.styleRecommendation" t-out="this.state.styleRecommendation"/>
                            <div t-else="">
                                <span class="pulsing-text">Thinking...</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-auto o_palette_selection_logo_area o_configurator_show_fast d-flex justify-content-center justify-content-lg-end mt-lg-4">
                        <t t-if="this.state.logo">
                            <div class="o_palette_selection_logo_row d-flex align-items-center gap-2 mt-3">
                                <div class="h-100 position-relative opacity-trigger-hover">
                                    <button type="button"
                                            class="o_palette_selection_logo_preview o_btn_reset h-100 rounded border position-relative overflow-hidden cursor-pointer"
                                            title="Replace Logo"
                                            t-on-click="this.uploadLogo">
                                        <img t-att-src="this.state.logo" alt="Logo" class="o_palette_selection_logo px-2 py-1"/>
                                        <span class="position-absolute opacity-0 opacity-100-hover d-flex align-items-center justify-content-center top-0 start-0 w-100 h-100 bg-white-75">
                                            <small class="fw-bolder">Replace</small>
                                        </span>
                                    </button>
                                    <button type="button"
                                            class="small opacity-0 opacity-100-hover btn bg-white text-black border position-absolute top-0 start-100 rounded-circle px-2 py-1 translate-middle transition-base"
                                            title="Remove Logo"
                                            t-on-click.stop="this.removeLogo">
                                        <i class="oi" data-icon="close_small" role="presentation"/>
                                    </button>
                                </div>
                                <t t-if="this.state.recommendedPalette">
                                    <i class="oi fs-4 text-muted me-1" data-icon="east" aria-hidden="true"/>
                                    <t t-set="logoPalette" t-value="this.state.recommendedPalette"/>
                                    <button t-attf-class="palette_card o_palette_selection_logo_palette o_btn_reset cursor-pointer d-flex align-items-center gap-2 h-100 w-auto position-relative flex-shrink-0 px-3 py-2 rounded border {{this.state.getSelectedPaletteName() === 'recommendedPalette' ? 'selected' : ''}}"
                                            t-attf-style="background-color: {{logoPalette.color3}}; color: {{logoPalette.color5}};"
                                            title="Logo colors"
                                            t-on-click="() => this.selectPalette('recommendedPalette', true)">
                                        <span class="flex-grow-1 overflow-hidden text-start text-truncate fw-semibold">Logo</span>
                                        <span class="d-flex gap-1 flex-shrink-0" aria-hidden="true">
                                            <span class="o_palette_card_swatch rounded-1" t-attf-style="background-color: {{logoPalette.color1}};"/>
                                            <span class="o_palette_card_swatch rounded-1" t-attf-style="background-color: {{logoPalette.color2}};"/>
                                        </span>
                                    </button>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <button type="button" class="o_palette_selection_logo_upload btn btn-light border d-flex gap-2 align-items-center justify-content-center text-start mt-3 py-2 px-3" t-on-click="this.uploadLogo">
                                <i class="oi oi-filled fs-1 flex-shrink-0 me-1" data-icon="cloud_upload"/>
                                <span class="lh-sm">Upload your <b>Logo</b></span>
                            </button>
                        </t>
                    </div>
                </div>
                <div class="flex-grow-1 pt-4">
                    <div class="o_palette_selection_grid row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
                        <t t-foreach="Object.values(this.state.palettes)" t-as="palette" t-key="palette.name">
                            <t t-set="isAiRecommended" t-value="this.state.aiRecommendedPalette === palette.name"/>
                            <div class="col">
                                <button t-attf-class="palette_card o_btn_reset position-relative cursor-pointer d-flex align-items-center gap-2 h-100 w-100 px-3 py-2 rounded border {{this.state.getSelectedPaletteName() === palette.name ? 'selected' : ''}}"
                                        t-attf-style="background-color: {{palette.isDark ? palette.color4 : palette.color3}}; color: {{palette.color5}};"
                                        t-on-click="() => this.selectPalette(palette.name, true)">
                                    <span class="flex-grow-1 overflow-hidden text-start text-truncate fw-semibold" t-out="palette.label"/>
                                    <span t-if="isAiRecommended" class="o_palette_card_recommendation_icon bg-success text-white position-absolute top-0 start-100 translate-middle rounded-circle d-flex align-items-center justify-content-center" data-tooltip="AI recommended" data-tooltip-position="top" role="img" aria-label="AI recommended">
                                        <i class="oi" data-icon="check"/>
                                    </span>
                                    <span class="d-flex gap-1 flex-shrink-0" aria-hidden="true">
                                        <span class="o_palette_card_swatch rounded-1" t-attf-style="background-color: {{palette.color1}};"/>
                                        <span class="o_palette_card_swatch rounded-1" t-attf-style="background-color: {{palette.color2}};"/>
                                    </span>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <div class="o_configurator_nav d-flex justify-content-end align-items-center py-2 pb-md-3 px-2 px-lg-5 position-sticky bottom-0 bg-view bg-opacity-75">
                <SkipButton skip="this.props.skip" className="'p-0 text-end w-auto'"/>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.FeatureSelection">
    <div class="o_configurator_screen h-100 d-flex flex-column o_feature_selection_screen">
        <div class="o_configurator_screen_content container d-flex flex-grow-1 align-items-center">
            <div class="m-auto d-flex mh-100 flex-column">
                <div class="o_configurator_typing_text o_configurator_show_fast">Add <b class="text-info">Pages</b> and <b class="text-warning">Features</b></div>
                <h2 class="o_configurator_show_fast text-muted pb-lg-3">You'll be able to create your pages later on.</h2>
                <div class="page_feature_selection o_configurator_show mt-lg-3 mx-n2">
                    <div class="w-100 page_feature_selection d-flex flex-wrap">
                        <t t-foreach="this.state.getFeatures()" t-as="feature" t-key="feature_index">
                            <t t-set='isInstalled' t-value="feature.module_state == 'installed'"/>
                            <div class="o_feature_card_container p-2 w-25" t-if="feature.type != 'empty'">
                                <div t-attf-class="card h-100 {{isInstalled ? 'card_installed' : (feature.selected ? 'border-success' : '')}}"
                                     t-on-click="() => this.state.toggleFeature(feature.id)"
                                     t-on-keydown="this.onKeydown"
                                     tabindex="0"
                                     role="button">
                                    <div class="h3 card-body py-3 px-4 mb-0">
                                        <t t-if="isInstalled">
                                            <i t-attf-class="oi oi-filled o_configurator_feature_status text-success" data-icon="check_circle" title="Already installed"/>
                                        </t>
                                        <t t-else="">
                                            <i t-attf-class="oi o_configurator_feature_status {{feature.selected ? 'text-success' : 'text-300'}}"  t-attf-data-icon="{{feature.selected ? 'check_circle' : 'circle'}}"/>
                                        </t>
                                        <div t-attf-class="h2 mb-0 card-title d-flex align-items-center {{isInstalled ? 'text-muted' : ''}}">
                                            <i t-attf-class="me-2 oi {{isInstalled ? 'text-muted' : (feature.type == 'page' ? 'text-info' : 'text-warning')}} {{feature.icon_class}}" t-attf-data-icon="{{feature.icon}}"/>
                                            <h3 class="m-1">
                                                <t t-out="feature.name"/>
                                            </h3>
                                        </div>
                                        <p class="small card-text text-muted" t-out="feature.description"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="pt-2">
                    <button class="btn btn-primary btn-lg" t-on-click="this.buildWebsite">Build my website</button>
                </div>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.ThemePreviewCard">
    <div class="o_theme_selection_col g-col-12 g-col-sm-6 g-col-xl-4">
        <t t-if="previewTheme and previewTheme.name">
            <div class="theme_preview border rounded-3 position-relative overflow-hidden w-100 o_configurator_show_fast" t-att-data-theme-name="previewTheme.name">
                <h6 class="theme_preview_tip position-absolute pe-none text-center text-muted border border-dark lh-1">Select</h6>
                <div class="theme_svg_container rounded overflow-hidden" dir="ltr">
                    <div class="o_configurator_theme_preview_loader position-absolute top-0 start-0 end-0 bottom-0 d-flex align-items-center justify-content-center pe-none">
                        <span class="spinner-border" role="status"/>
                    </div>
                    <iframe class="o_configurator_theme_preview_iframe position-absolute top-0 start-0 d-block border-0 pe-none" t-att-src="this.getThemePreviewUrl(previewTheme)" t-on-load="this.onPreviewIframeLoad" title="Theme preview" loading="lazy" scrolling="no" tabindex="-1"/>
                </div>
                <button class="o_btn_reset button_area" t-on-click="() => this.chooseTheme(previewTheme.name)"/>
            </div>
        </t>
    </div>
</t>

<t t-name="website.Configurator.ThemeSelectionScreen">
    <div class="o_configurator_screen h-100 d-flex flex-column o_theme_selection_screen pb-0">
        <div class="o_configurator_screen_content d-flex flex-column flex-grow-1 align-items-center">
            <div class="o_theme_selection_container mw-100 px-2 px-lg-5">
                <t t-if="!this.state.themesLoading">
                    <div class="o_theme_selection_fit d-xl-flex flex-xl-column h-xl-100">
                        <h1 class="mb-2 mb-xxl-3 pt-3 text-center o_configurator_typing_text">
                            Choose your favorite <b class="text-info">Layout</b>
                        </h1>
                        <div class="o_theme_selection_grid gap-4 grid mt-2">
                            <t t-foreach="this.state.themes" t-as="theme" t-key="theme_index">
                                <t t-call="website.Configurator.ThemePreviewCard" previewTheme="theme"/>
                            </t>
                        </div>
                    </div>
                    <t t-if="!this.showViewMoreThemesButton and this.state.extraThemes.length">
                        <div class="o_theme_selection_extra_grid grid gap-4 pt-4 pb-4">
                            <t t-foreach="this.state.extraThemes" t-as="extraTheme" t-key="extraTheme.name">
                                <t t-call="website.Configurator.ThemePreviewCard" previewTheme="extraTheme"/>
                            </t>
                        </div>
                    </t>
                </t>
            </div>
            <div
                t-if="this.showViewMoreThemesButton"
                class="d-flex justify-content-center align-items-center w-100 mb-3 position-absolute bottom-0 z-3"
            >
                <button
                    class="btn btn-secondary btn-lg px-4 py-2"
                    t-on-click="this.getMoreThemes">
                    Generate more
                </button>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.Configurator">
    <div class="o_configurator_container">
        <t t-component="this.currentComponent" t-props="this.componentProps"/>
    </div>
</t>

</templates>
