<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.WebsiteBuilder">
    <Builder t-props="this.builderProps">
        <t t-set-slot="extraActions">
            <div class="o-website-discard-save-buttons d-flex"
                t-att-class="{ 'o-website-draft-actions': this.websiteService.isDraftPreview }">
                <button type="button" t-on-click="this.discard"
                    class="o-hb-btn btn" data-action="cancel"
                    data-tooltip="Tip: Esc to preview" accesskey="j">
                    <span class="d-inline-block mw-100 align-bottom"
                        data-text-truncate-tooltip="">Discard</span>
                </button>
                <t t-if="this.websiteService.isDraftPreview">
                    <button type="button" t-on-click="this.deleteDraft" class="o-hb-btn o-website-draft-btn btn btn-danger" data-action="remove" title="Delete draft" aria-label="Delete draft">
                        <i class="oi oi-fw oi-filled" data-icon="delete"/>
                    </button>
                    <button type="button" t-on-click="this.publishDraft" class="o-hb-btn o-website-draft-btn btn btn-primary" data-action="publish" title="Publish draft" aria-label="Publish draft">
                        <i class="oi oi-fw" data-icon="cloud_upload"/>
                    </button>
                </t>
                <button type="button" t-on-click="this.save"
                    class="o-hb-btn btn btn-success" data-action="save"
                    t-att-class="this.websiteService.isDraftPreview ? 'px-2' : 'px-3'"
                    accesskey="s">
                    <span class="d-inline-block mw-100 align-bottom"
                        data-text-truncate-tooltip="">Save</span>
                </button>
            </div>
        </t>
    </Builder>
</t>

</templates>
