<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ShowOnOption">
    <BuilderRow label.translate="Show on" t-if="this.availableShowOnScopes.length">
        <BuilderSelect action="'moveBlock'">
            <t t-foreach="this.availableShowOnScopes" t-as="scope" t-key="scope.containerSelector">
                <BuilderSelectItem actionParam="{ selector: scope.containerSelector, isThisPage: scope.isThisPage }" t-out="scope.label"/>
            </t>
        </BuilderSelect>
    </BuilderRow>
</t>

</templates>
