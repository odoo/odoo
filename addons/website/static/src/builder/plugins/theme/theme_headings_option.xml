<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeHeadingsOption">
    <BuilderContext preview="false">
        <t t-set="heading_label">Heading</t>
        <t t-set="display_label">Display</t>
        <!-- We don't use `display-font-sizes.5` and `display-font-sizes.6` -->
        <t t-set="used_display_font_sizes" t-value="[1, 2, 3, 4]"/>
        <BuilderRow label.translate="Font Family" tooltip.translate="All headings. Expand to set a level apart.">
            <ThemeFontFamilyOption
                cssVariable="'headings-font'"
                buttonIcon="'delete'"
                buttonIconClass="'oi-filled'"
                buttonTitle.translate="Reset to Default Font Family"/>
            <t t-set-slot="collapse">
                <t t-foreach="[2, 3, 4, 5, 6]" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="heading_label + ' ' + depth">
                        <ThemeFontFamilyOption
                            cssVariable="'h' + depth + '-font'"
                            buttonIcon="'close'"
                            buttonTitle.translate="Reset to Headings Font Family"/>
                    </BuilderRow>
                </t>
                <t t-foreach="used_display_font_sizes" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="display_label + ' ' + depth">
                        <ThemeFontFamilyOption
                            cssVariable="'display-' + depth + '-font'"
                            buttonIcon="'close'"
                            buttonTitle.translate="Reset to Headings Font Family"/>
                    </BuilderRow>
                </t>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Heading 1" tooltip.translate="Font size. Expand for the other levels." action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'h1-font-size'" unit="'px'" saveUnit="'rem'" min="16" max="120" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['h1-font-size', 'h2-font-size', 'h3-font-size', 'h4-font-size', 'h5-font-size', 'h6-font-size', 'display-1-font-size', 'display-2-font-size', 'display-3-font-size', 'display-4-font-size']"/>
            <t t-set-slot="collapse">
                <t t-foreach="[2, 3, 4, 5, 6]" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="heading_label + ' ' + depth">
                        <BuilderRange actionParam="'h' + depth + '-font-size'" unit="'px'" saveUnit="'rem'" min="10" max="96" withNumberInput="true"/>
                    </BuilderRow>
                </t>
                <t t-foreach="used_display_font_sizes" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="display_label + ' ' + depth">
                        <BuilderRange actionParam="'display-' + depth + '-font-size'" unit="'px'" saveUnit="'rem'" min="24" max="144" withNumberInput="true"/>
                    </BuilderRow>
                </t>
            </t>
        </BuilderRow>
        <ThemeFontWeightOption
            regularVariables="['headings-font-weight', 'display-font-weight']"
            boldVariables="['headings-font-weight-bold', 'display-font-weight-bold']"
            fontVariable="'headings-font'"
        />
        <BuilderRow label.translate="Line Height" tooltip.translate="All headings. Expand to set a level apart." action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'headings-line-height'" unit="'✕'" saveUnit="''" min="0.8" max="2.5" step="0.05" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['headings-line-height', 'h2-line-height', 'h3-line-height', 'h4-line-height', 'h5-line-height', 'h6-line-height', 'display-1-line-height', 'display-2-line-height', 'display-3-line-height', 'display-4-line-height']"/>
            <t t-set-slot="collapse">
                <t t-foreach="[2, 3, 4, 5, 6]" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="heading_label + ' ' + depth">
                        <BuilderRange actionParam="'h' + depth + '-line-height'" unit="'✕'" saveUnit="''" min="0.8" max="2.5" step="0.05" withNumberInput="true"/>
                    </BuilderRow>
                </t>
                <t t-foreach="used_display_font_sizes" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="display_label + ' ' + depth">
                        <BuilderRange actionParam="'display-' + depth + '-line-height'" unit="'✕'" saveUnit="''" min="0.8" max="2.5" step="0.05" withNumberInput="true"/>
                    </BuilderRow>
                </t>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Space Above" tooltip.translate="All headings. Expand to set a level apart." action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'headings-margin-top'" unit="'px'" saveUnit="'px'" min="0" max="96" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['headings-margin-top', 'h2-margin-top', 'h3-margin-top', 'h4-margin-top', 'h5-margin-top', 'h6-margin-top', 'display-1-margin-top', 'display-2-margin-top', 'display-3-margin-top', 'display-4-margin-top']"/>
            <t t-set-slot="collapse">
                <t t-foreach="[2, 3, 4, 5, 6]" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="heading_label + ' ' + depth">
                        <BuilderRange actionParam="'h' + depth + '-margin-top'" unit="'px'" saveUnit="'px'" min="0" max="96" withNumberInput="true"/>
                    </BuilderRow>
                </t>
                <t t-foreach="used_display_font_sizes" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="display_label + ' ' + depth">
                        <BuilderRange actionParam="'display-' + depth + '-margin-top'" unit="'px'" saveUnit="'px'" min="0" max="96" withNumberInput="true"/>
                    </BuilderRow>
                </t>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Space Below" tooltip.translate="All headings. Expand to set a level apart." action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'headings-margin-bottom'" unit="'px'" saveUnit="'px'" min="0" max="96" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['headings-margin-bottom', 'h2-margin-bottom', 'h3-margin-bottom', 'h4-margin-bottom', 'h5-margin-bottom', 'h6-margin-bottom', 'display-1-margin-bottom', 'display-2-margin-bottom', 'display-3-margin-bottom', 'display-4-margin-bottom']"/>
            <t t-set-slot="collapse">
                <t t-foreach="[2, 3, 4, 5, 6]" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="heading_label + ' ' + depth">
                        <BuilderRange actionParam="'h' + depth + '-margin-bottom'" unit="'px'" saveUnit="'px'" min="0" max="96" withNumberInput="true"/>
                    </BuilderRow>
                </t>
                <t t-foreach="used_display_font_sizes" t-as="depth" t-key="depth">
                    <BuilderRow level="1" label="display_label + ' ' + depth">
                        <BuilderRange actionParam="'display-' + depth + '-margin-bottom'" unit="'px'" saveUnit="'px'" min="0" max="96" withNumberInput="true"/>
                    </BuilderRow>
                </t>
            </t>
        </BuilderRow>
    </BuilderContext>
</t>

</templates>
