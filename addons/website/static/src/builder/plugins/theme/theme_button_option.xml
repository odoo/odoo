<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeButtonOption">
    <BuilderContext preview="false">
        <BuilderRow label.translate="Primary Style">
            <BuilderSelect action="'previewButtonStyle'" actionParam="'primary'" preview="true">
                <BuilderSelectItem actionValue="'fill'">Fill</BuilderSelectItem>
                <BuilderSelectItem actionValue="'outline'" id="'btn_primary_outline_opt'">Outline</BuilderSelectItem>
                <BuilderSelectItem actionValue="'flat'">Flat</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow t-if="this.isActiveItem('btn_primary_outline_opt')"
            level="1" label.translate="Border Width"
            action="'previewWebsiteVariable'" preview="true"
        >
            <BuilderRange actionParam="'btn-primary-outline-border-width'" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['btn-primary-outline-border-width']"/>
        </BuilderRow>
        <BuilderRow label.translate="Secondary Style">
            <BuilderSelect action="'previewButtonStyle'" actionParam="'secondary'" preview="true">
                <BuilderSelectItem actionValue="'fill'">Fill</BuilderSelectItem>
                <BuilderSelectItem actionValue="'outline'" id="'btn_secondary_outline_opt'">Outline</BuilderSelectItem>
                <BuilderSelectItem actionValue="'flat'">Flat</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow t-if="this.isActiveItem('btn_secondary_outline_opt')"
            level="1" label.translate="Border Width"
            action="'previewWebsiteVariable'" preview="true"
        >
            <BuilderRange actionParam="'btn-secondary-outline-border-width'" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['btn-secondary-outline-border-width']"/>
        </BuilderRow>
        <BuilderRow label.translate="Font Family">
            <ThemeFontFamilyOption
                cssVariable="'buttons-font'"
                buttonIcon="'delete'"
                buttonIconClass="'oi-filled'"
                buttonTitle.translate="Reset to Default Font Family"/>
        </BuilderRow>
        <BuilderRow label.translate="Font Size" action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'btn-font-size'" unit="'px'" saveUnit="'rem'" min="10" max="32" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['btn-font-size', 'btn-font-size-sm', 'btn-font-size-lg']"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderRange actionParam="'btn-font-size-sm'" unit="'px'" saveUnit="'rem'" min="8" max="28" withNumberInput="true"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderRange actionParam="'btn-font-size-lg'" unit="'px'" saveUnit="'rem'" min="12" max="40" withNumberInput="true"/>
                </BuilderRow>
            </t>
        </BuilderRow>
        <ThemeFontWeightOption
            regularVariables="['btn-font-weight']"
            boldVariables="['btn-font-weight-bold']"
            fontVariable="'buttons-font'"
        />
        <BuilderRow label.translate="Vertical Padding" action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'btn-padding-y'" unit="'px'" saveUnit="'rem'" min="0" max="40" withNumberInput="true" prefixIcon="'height'"/>
            <t t-call="website.ThemeResetButton" resetParam="['btn-padding-y', 'btn-padding-y-sm', 'btn-padding-y-lg']"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderRange actionParam="'btn-padding-y-sm'" unit="'px'" saveUnit="'rem'" min="0" max="40" withNumberInput="true" prefixIcon="'height'"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderRange actionParam="'btn-padding-y-lg'" unit="'px'" saveUnit="'rem'" min="0" max="40" withNumberInput="true" prefixIcon="'height'"/>
                </BuilderRow>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Horizontal Padding" action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'btn-padding-x'" unit="'px'" saveUnit="'rem'" min="0" max="80" withNumberInput="true" prefixIcon="'arrow_range'"/>
            <t t-call="website.ThemeResetButton" resetParam="['btn-padding-x', 'btn-padding-x-sm', 'btn-padding-x-lg']"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderRange actionParam="'btn-padding-x-sm'" unit="'px'" saveUnit="'rem'" min="0" max="80" withNumberInput="true" prefixIcon="'arrow_range'"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderRange actionParam="'btn-padding-x-lg'" unit="'px'" saveUnit="'rem'" min="0" max="80" withNumberInput="true" prefixIcon="'arrow_range'"/>
                </BuilderRow>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Round Corners" action="'previewWebsiteVariable'" preview="true">
            <BuilderRange actionParam="'btn-border-radius'" unit="'px'" saveUnit="'rem'" min="0" max="100" withNumberInput="true"/>
            <t t-call="website.ThemeResetButton" resetParam="['btn-border-radius', 'btn-border-radius-sm', 'btn-border-radius-lg']"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderRange actionParam="'btn-border-radius-sm'" unit="'px'" saveUnit="'rem'" min="0" max="100" withNumberInput="true"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderRange actionParam="'btn-border-radius-lg'" unit="'px'" saveUnit="'rem'" min="0" max="100" withNumberInput="true"/>
                </BuilderRow>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="On Click Effect">
            <BuilderSelect action="'previewWebsiteConfig'">
                <!-- TODO implicit removal of assets -->
                <BuilderSelectItem actionParam="{vars: {'btn-ripple': 'false'}, assets: []}">None</BuilderSelectItem>
                <BuilderSelectItem
                    actionParam="{vars: {'btn-ripple': 'true'}, assets: ['website.ripple_effect_scss', 'website.ripple_effect_js']}"
                >Ripple</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </BuilderContext>
</t>

</templates>
