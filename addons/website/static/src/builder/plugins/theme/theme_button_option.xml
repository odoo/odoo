<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeButtonOption">
    <BuilderRow label.translate="Primary Style">
        <BuilderSelect action="'previewButtonStyle'" actionParam="'primary'">
            <BuilderSelectItem actionValue="'fill'">Fill</BuilderSelectItem>
            <BuilderSelectItem actionValue="'outline'" id="'btn_primary_outline_opt'">Outline</BuilderSelectItem>
            <BuilderSelectItem actionValue="'flat'">Flat</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow t-if="this.isActiveItem('btn_primary_outline_opt')"
        level="1" label.translate="Border Width"
        action="'previewWebsiteVariable'"
    >
        <BuilderRange actionParam="'btn-primary-outline-border-width'" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['btn-primary-outline-border-width']"/>
    </BuilderRow>
    <BuilderRow label.translate="Secondary Style">
        <BuilderSelect action="'previewButtonStyle'" actionParam="'secondary'">
            <BuilderSelectItem actionValue="'fill'">Fill</BuilderSelectItem>
            <BuilderSelectItem actionValue="'outline'" id="'btn_secondary_outline_opt'">Outline</BuilderSelectItem>
            <BuilderSelectItem actionValue="'flat'">Flat</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow t-if="this.isActiveItem('btn_secondary_outline_opt')"
        level="1" label.translate="Border Width"
        action="'previewWebsiteVariable'"
    >
        <BuilderRange actionParam="'btn-secondary-outline-border-width'" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['btn-secondary-outline-border-width']"/>
    </BuilderRow>
    <BuilderRow label.translate="Font Family">
        <ThemeFontFamilyOption
            cssVariable="'buttons-font'"
            buttonIcon="'delete'"
            buttonIconClass="'oi-filled'"
            buttonTitle.translate="Reset to Default Font Family"/>
    </BuilderRow>
    <t t-set="font_size_label">Font Size</t>
    <t t-call="website.ThemeSizeRow" label="font_size_label" variable="'btn-font-size'" min="10" max="32" smallMin="8" smallMax="28" largeMin="12" largeMax="40"/>
    <ThemeFontWeightOption
        regularVariables="['btn-font-weight']"
        boldVariables="['btn-font-weight-bold']"
        fontVariable="'buttons-font'"
    />
    <t t-set="vertical_padding_label">Vertical Padding</t>
    <t t-call="website.ThemeSizeRow" label="vertical_padding_label" variable="'btn-padding-y'" min="0" max="40" prefixIcon="'height'"/>
    <t t-set="horizontal_padding_label">Horizontal Padding</t>
    <t t-call="website.ThemeSizeRow" label="horizontal_padding_label" variable="'btn-padding-x'" min="0" max="80" prefixIcon="'arrow_range'"/>
    <t t-set="round_corners_label">Round Corners</t>
    <t t-call="website.ThemeSizeRow" label="round_corners_label" variable="'btn-border-radius'" min="0" max="100"/>
    <BuilderRow label.translate="On Click Effect">
        <BuilderSelect action="'previewWebsiteConfig'">
            <!-- TODO implicit removal of assets -->
            <BuilderSelectItem actionParam="{vars: {'btn-ripple': 'false'}, assets: []}">None</BuilderSelectItem>
            <BuilderSelectItem
                actionParam="{vars: {'btn-ripple': 'true'}, assets: ['website.ripple_effect_scss', 'website.ripple_effect_js']}"
            >Ripple</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
</t>

</templates>
