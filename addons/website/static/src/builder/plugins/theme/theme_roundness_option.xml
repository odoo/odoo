<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeRoundnessOption">
    <BuilderRow label.translate="Roundness" initialExpandAnim="['border-radius-sm', 'border-radius-lg'].includes(this.env.targetRowId)">
        <BuilderRange action="'customizeBorderRadiusVariable'" min="0" max="24" step="1" unit="'px'" saveUnit="'rem'" withNumberInput="true"/>
        <t t-set-slot="collapse">
            <BuilderRow label.translate="Small" level="1">
                <BuilderNumberInput action="'customizeWebsiteVariable'" actionParam="'border-radius-sm'" default="null" unit="'px'" saveUnit="'rem'" step="0.1"/>
                <BuilderButton t-if="this.state.isCustomized['border-radius-sm']" action="'resetBorderRadius'" actionParam="'border-radius-sm'" className="'btn-danger-color-hover'" icon="'fa-remove'" title.translate="Reset"/>
            </BuilderRow>
            <BuilderRow label.translate="Large" level="1">
                <BuilderNumberInput action="'customizeWebsiteVariable'" actionParam="'border-radius-lg'" default="null" unit="'px'" saveUnit="'rem'" step="0.1"/>
                <BuilderButton t-if="this.state.isCustomized['border-radius-lg']" action="'resetBorderRadius'" actionParam="'border-radius-lg'" className="'btn-danger-color-hover'" icon="'fa-remove'" title.translate="Reset"/>
            </BuilderRow>
        </t>
    </BuilderRow>
</t>

</templates>
