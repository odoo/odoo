<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeRoundnessOption">
    <BuilderRow label.translate="Roundness">
        <BuilderRange action="'customizeWebsiteVariable'" actionParam="'border-radius'" max="24" unit="'px'" saveUnit="'rem'" withNumberInput="true"/>
        <t t-set-slot="collapse">
            <BuilderRow label.translate="Small" level="1">
                <t t-call="website.ThemeBorderRadiusOption"
                    variable="'border-radius-sm'"
                    resetVisibility="this.state.customized"
                    min="0"
                    step="0.1"
                />
            </BuilderRow>
            <BuilderRow label.translate="Large" level="1">
                <t t-call="website.ThemeBorderRadiusOption"
                    variable="'border-radius-lg'"
                    resetVisibility="this.state.customized"
                    min="0"
                    step="0.1"
                />
            </BuilderRow>
        </t>
    </BuilderRow>
</t>

</templates>
