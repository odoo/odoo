<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeShadowOption">
    <BuilderContext action="'customizeWebsiteVariable'">
        <BuilderRow label.translate="Small" initialExpandAnim="this.env.targetRowId === 'shadow-sm'" tooltip.translate="Vertical and Horizontal offset">
            <BuilderNumberInput actionParam="'box-shadow-sm-offset-y'" unit="'px'" saveUnit="'rem'" tooltip.translate="Vertical offset" prefixIcon="'height'"/>
            <BuilderNumberInput actionParam="'box-shadow-sm-offset-x'" unit="'px'" saveUnit="'rem'" tooltip.translate="Horizontal offset" prefixIcon="'arrow_range'"/>
            <t t-set-slot="collapse">
                <BuilderContext level="true">
                    <BuilderRow label.translate="Color">
                        <BuilderColorPicker actionParam="'box-shadow-sm-color'" enabledTabs="['solid', 'custom']"/>
                    </BuilderRow>
                    <BuilderRow label.translate="Blur">
                        <BuilderNumberInput actionParam="'box-shadow-sm-blur-radius'" unit="'px'" saveUnit="'rem'"/>
                    </BuilderRow>
                    <BuilderRow label.translate="Spread">
                        <BuilderNumberInput actionParam="'box-shadow-sm-spread-radius'" unit="'px'" saveUnit="'rem'"/>
                    </BuilderRow>
                </BuilderContext>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Normal" initialExpandAnim="this.env.targetRowId === 'shadow'" tooltip.translate="Vertical and Horizontal offset">
            <BuilderNumberInput actionParam="'box-shadow-offset-y'" unit="'px'" saveUnit="'rem'" tooltip.translate="Vertical offset" prefixIcon="'height'"/>
            <BuilderNumberInput actionParam="'box-shadow-offset-x'" unit="'px'" saveUnit="'rem'" tooltip.translate="Horizontal offset" prefixIcon="'arrow_range'"/>
            <t t-set-slot="collapse">
                <BuilderContext level="true">
                    <BuilderRow label.translate="Color">
                        <BuilderColorPicker actionParam="'box-shadow-color'" enabledTabs="['solid', 'custom']"/>
                    </BuilderRow>
                    <BuilderRow label.translate="Blur">
                        <BuilderNumberInput actionParam="'box-shadow-blur-radius'" unit="'px'" saveUnit="'rem'"/>
                    </BuilderRow>
                    <BuilderRow label.translate="Spread">
                        <BuilderNumberInput actionParam="'box-shadow-spread-radius'" unit="'px'" saveUnit="'rem'"/>
                    </BuilderRow>
                </BuilderContext>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Large" initialExpandAnim="this.env.targetRowId === 'shadow-lg'" tooltip.translate="Vertical and Horizontal offset">
            <BuilderNumberInput actionParam="'box-shadow-lg-offset-y'" unit="'px'" saveUnit="'rem'" tooltip.translate="Vertical offset" prefixIcon="'height'"/>
            <BuilderNumberInput actionParam="'box-shadow-lg-offset-x'" unit="'px'" saveUnit="'rem'" tooltip.translate="Horizontal offset" prefixIcon="'arrow_range'"/>
            <t t-set-slot="collapse">
                <BuilderContext level="true">
                    <BuilderRow label.translate="Color">
                        <BuilderColorPicker actionParam="'box-shadow-lg-color'" enabledTabs="['solid', 'custom']"/>
                    </BuilderRow>
                    <BuilderRow label.translate="Blur">
                        <BuilderNumberInput actionParam="'box-shadow-lg-blur-radius'" unit="'px'" saveUnit="'rem'"/>
                    </BuilderRow>
                    <BuilderRow label.translate="Spread">
                        <BuilderNumberInput actionParam="'box-shadow-lg-spread-radius'" unit="'px'" saveUnit="'rem'"/>
                    </BuilderRow>
                </BuilderContext>
            </t>
        </BuilderRow>
    </BuilderContext>
</t>

</templates>
