<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeFontFamilyOption">
    <BuilderFontFamilyPicker
        action="this.props.action"
        preview="true"
        actionParam="this.props.cssVariable"
        valueParamName="'actionValue'"/>
    <BuilderButton
        t-if="this.state.isFontSpecified"
        action="this.props.action"
        actionParam="this.props.cssVariable"
        preview="false"
        className="'btn-danger-color-hover'"
        icon="this.props.buttonIcon"
        iconClass="this.props.buttonIconClass"
        title="this.props.buttonTitle"/>
</t>

</templates>
