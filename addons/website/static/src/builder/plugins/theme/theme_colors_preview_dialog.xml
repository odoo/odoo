<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeColorsPreviewDialog">
    <Dialog title.translate="Colors Preview" footer="false" withBodyPadding="false"
        contentClass="'o_theme_colors_preview_dialog h-100'">
        <iframe class="d-block h-100 w-100" src="/website/theme_colors_preview"
            t-on-load="this.onIframeLoad"/>
    </Dialog>
</t>

<t t-name="website.ContrastWarningPopover">
    <div class="p-3" style="max-width: 300px;">
        <p class="mb-2 fw-bold" t-out="this.contrastText"/>
        <p class="mb-2">This element with low contrast is difficult for many users to read. You can either change the background color or the element color.</p>
        <a href="https://dequeuniversity.com/rules/axe/4.11/color-contrast" target="_blank" rel="noreferrer noopener">Learn more about contrast</a>
    </div>
</t>

</templates>
