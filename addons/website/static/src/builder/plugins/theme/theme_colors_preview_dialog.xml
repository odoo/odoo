<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeColorsPreviewDialog">
    <Dialog title.translate="Colors Preview" footer="false" withBodyPadding="false"
        contentClass="'o_theme_colors_preview_dialog h-100'" bodyClass="'d-flex flex-column'">
        <div t-if="this.hasLowContrast()" class="alert alert-warning d-flex align-items-center gap-2 rounded-0 mb-0" role="alert">
            <i class="oi" data-icon="warning" aria-hidden="true"/>
            <span>Some texts have low contrast, which many users find hard to read. Hover a flagged text to see its contrast ratio.</span>
            <a class="alert-link text-decoration-underline text-nowrap ms-auto" href="https://dequeuniversity.com/rules/axe/4.11/color-contrast" target="_blank" rel="noreferrer noopener">Learn more <i class="oi oi-sm" data-icon="open_in_new" role="img" aria-hidden="true"/></a>
        </div>
        <iframe class="d-block flex-grow-1 w-100" src="/website/theme_colors_preview" t-on-load="this.onIframeLoad"/>
    </Dialog>
</t>

</templates>
