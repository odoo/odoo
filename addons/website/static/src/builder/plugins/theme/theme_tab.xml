<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeTab">
    <div class="o_theme_tab h-100" role="tabpanel" aria-labelledby="theme-tab">
        <div t-ref="this.contentRef" class="d-flex flex-column h-100">
            <t t-foreach="this.optionsContainers" t-as="optionsContainer" t-key="optionsContainer.id">
                <!-- TODO Define a more basic kind of options container -->
                <OptionsContainer
                    highlight="this.props.targetContainerId === optionsContainer.id"
                    editingElement="optionsContainer.element"
                    options="optionsContainer.options"
                    containerTitle="optionsContainer.containerTitle"
                    headerMiddleButtons="optionsContainer.headerMiddleButtons"
                    isRemovable="optionsContainer.isRemovable"
                    isClonable="optionsContainer.isClonable"
                    containerTopButtons="optionsContainer.optionsContainerTopButtons"/>
            </t>
        </div>
    </div>
</t>
<t t-name="website.ThemeWebsiteSettingsOption">
    <BuilderContext preview="false">
        <BuilderRow label.translate="Theme">
            <BuilderButton action="'switchTheme'" type="'global'">Switch Theme</BuilderButton>
        </BuilderRow>
        <BuilderRow label.translate="Language">
            <BuilderButton action="'addLanguage'">Add a Language</BuilderButton>
        </BuilderRow>
        <BuilderRow label.translate="Page Layout">
            <BuilderSelect action="'previewWebsiteVariable'" actionParam="'layout'" preview="true">
                <BuilderSelectItem actionValue="'full'" id="'layout_full_opt'" label.translate="Full">
                    <Image attrs="{ style: 'margin-top: 10px !important;' }"
                         src="'/website/static/src/img/snippets_options/page_layout_full.svg'"/>
                    <span>Full</span>
                </BuilderSelectItem>
                <BuilderSelectItem actionValue="'boxed'" label.translate="Boxed">
                    <Image attrs="{ style: 'margin-top: 10px !important;' }"
                         src="'/website/static/src/img/snippets_options/page_layout_boxed.svg'"/>
                    <span>Boxed</span>
                </BuilderSelectItem>
                <BuilderSelectItem actionValue="'framed'" label.translate="Framed">
                    <Image attrs="{ style: 'margin-top: 10px !important;' }"
                         src="'/website/static/src/img/snippets_options/page_layout_framed.svg'"/>
                    <span>Framed</span>
                </BuilderSelectItem>
                <BuilderSelectItem actionValue="'postcard'" label.translate="Postcard">
                    <Image attrs="{ style: 'margin-top: 10px !important;' }"
                         src="'/website/static/src/img/snippets_options/page_layout_postcard.svg'"/>
                    <span>Postcard</span>
                </BuilderSelectItem>
            </BuilderSelect>
            <BuilderButton
                action="'toggleBodyBgImage'"
                id="'body_bg_image_opt'"
                title.translate="Image"
                preview="false"
                className="'ms-auto px-2'"
                icon="'photo_camera'"
                iconClass="'oi-fw'"
            />
        </BuilderRow>
        <BuilderRow label.translate="Background" level="1" t-if="!this.isActiveItem('layout_full_opt')">
            <BuilderColorPicker enabledTabs="['solid', 'custom']"
                action="'previewWebsiteColor'"
                preview="true"
                actionParam="'body'"/>
        </BuilderRow>
        <BuilderRow label.translate="Image" level="1" t-if="this.isActiveItem('body_bg_image_opt')">
            <BuilderButton action="'replaceBodyBgImage'" title.translate="Replace Image" preview="false" type="'global'">
                Replace
            </BuilderButton>
            <BuilderButton action="'removeBodyBgImage'" preview="false" icon="'close_small'" className="'btn-danger-color-hover'"/>
            <ImageSize/>
        </BuilderRow>
        <BuilderRow label.translate="Position" level="1" t-if="this.isActiveItem('body_bg_image_opt')">
            <BuilderSelect action="'previewBodyImage'" actionParam="'body-image-type'" preview="false">
                <BuilderSelectItem actionValue="'image'">Cover</BuilderSelectItem>
                <BuilderSelectItem actionValue="'pattern'" id="'body_bg_repeat_opt'">Repeat pattern</BuilderSelectItem>
            </BuilderSelect>
            <BuilderButton icon="'my_location'" title.translate="Background Position" preview="false" action="'bodyBgPositionOverlay'"/>
        </BuilderRow>
        <BuilderContext t-if="this.isActiveItem('body_bg_repeat_opt')" action="'previewBodyImage'">
            <BuilderRow label.translate="Width" level="2">
                <BuilderNumberInput actionParam="'body-image-pattern-width'" placeholder.translate="auto" unit="'px'" min="1" default="null"/>
            </BuilderRow>
            <BuilderRow label.translate="Height" level="2">
                <BuilderNumberInput actionParam="'body-image-pattern-height'" placeholder.translate="auto" unit="'px'" min="1" default="null"/>
            </BuilderRow>
        </BuilderContext>
    </BuilderContext>
</t>

<t t-name="website.ThemeResetButton">
    <BuilderButton
        action="'resetWebsiteVariables'"
        actionParam="resetParam"
        preview="false"
        icon="'close_small'"
        className="'o_we_theme_reset btn-danger-color-hover'"
        title.translate="Reset to default"/>
</t>

<!-- A size (`variable`) and its small and large ones, expanded. -->
<t t-name="website.ThemeSizeRow">
    <t t-set="small_label">Small</t>
    <t t-set="large_label">Large</t>
    <BuilderRow label="label" action="'previewWebsiteVariable'">
        <BuilderRange actionParam="variable" unit="'px'" saveUnit="'rem'" min="min" max="max" withNumberInput="true" prefixIcon="prefixIcon"/>
        <t t-call="website.ThemeResetButton" resetParam="[variable, variable + '-sm', variable + '-lg']"/>
        <t t-set-slot="collapse">
            <BuilderRow label="small_label" level="1">
                <BuilderRange actionParam="variable + '-sm'" unit="'px'" saveUnit="'rem'" min="smallMin || min" max="smallMax || max" withNumberInput="true" prefixIcon="prefixIcon"/>
            </BuilderRow>
            <BuilderRow label="large_label" level="1">
                <BuilderRange actionParam="variable + '-lg'" unit="'px'" saveUnit="'rem'" min="largeMin || min" max="largeMax || max" withNumberInput="true" prefixIcon="prefixIcon"/>
            </BuilderRow>
        </t>
    </BuilderRow>
</t>

<t t-name="website.ThemeParagraphOption">
    <BuilderRow label.translate="Font Family">
        <BuilderFontFamilyPicker
            action="'previewWebsiteFontFamily'"
            actionParam="'font'"
            valueParamName="'actionValue'"/>
    </BuilderRow>
    <BuilderRow label.translate="Font Size" action="'previewWebsiteVariable'">
        <BuilderRange actionParam="'font-size-base'" unit="'px'" saveUnit="'rem'" min="10" max="32" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['font-size-base']"/>
        <t t-set-slot="collapse">
            <BuilderRow label.translate="Small" level="1">
                <BuilderRange actionParam="'small-font-size'" unit="'px'" saveUnit="'rem'" min="8" max="24" withNumberInput="true"/>
                <t t-call="website.ThemeResetButton" resetParam="['small-font-size']"/>
            </BuilderRow>
        </t>
    </BuilderRow>
    <ThemeFontWeightOption
        regularVariables="['font-weight-normal']"
        lightVariables="['lead-font-weight']"
        boldVariables="['font-weight-bolder']"
        fontVariable="'font'"/>
    <BuilderRow label.translate="Line Height" action="'previewWebsiteVariable'">
        <!-- "×": ×  -->
        <BuilderRange actionParam="'body-line-height'" unit="'✕'" saveUnit="''" min="1" max="2.5" step="0.05" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['body-line-height']"/>
    </BuilderRow>
    <BuilderRow label.translate="Space Above" action="'previewWebsiteVariable'">
        <BuilderRange actionParam="'paragraph-margin-top'" unit="'px'" saveUnit="'px'" min="0" max="64" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['paragraph-margin-top']"/>
    </BuilderRow>
    <BuilderRow label.translate="Space Below" action="'previewWebsiteVariable'">
        <BuilderRange actionParam="'paragraph-margin-bottom'" unit="'px'" saveUnit="'px'" min="0" max="64" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['paragraph-margin-bottom']"/>
    </BuilderRow>
</t>

<t t-name="website.ThemeLinkOption">
    <BuilderRow label.translate="Link Style">
        <BuilderSelect action="'previewLinkStyle'" actionParam="'link-underline'">
            <BuilderSelectItem actionValue="'never'">No Underline</BuilderSelectItem>
            <BuilderSelectItem actionValue="'hover'">Underline On Hover</BuilderSelectItem>
            <BuilderSelectItem actionValue="'always'">Always Underline</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
</t>

<t t-name="website.ThemeInputOption">
    <t t-set="font_size_label">Font Size</t>
    <t t-call="website.ThemeSizeRow" label="font_size_label" variable="'input-font-size'" min="10" max="32" smallMin="8" smallMax="28" largeMax="40"/>
    <t t-set="vertical_padding_label">Vertical Padding</t>
    <t t-call="website.ThemeSizeRow" label="vertical_padding_label" variable="'input-padding-y'" min="0" max="32" prefixIcon="'height'"/>
    <t t-set="horizontal_padding_label">Horizontal Padding</t>
    <t t-call="website.ThemeSizeRow" label="horizontal_padding_label" variable="'input-padding-x'" min="0" max="48" prefixIcon="'arrow_range'"/>
    <t t-set="subVariablesConfig" t-value="{'input-border-width': ['input-border-top-width', 'input-border-right-width', 'input-border-bottom-width', 'input-border-left-width']}"/>
    <BuilderRow label.translate="Border Width" action="'previewWebsiteSubVariables'">
        <BuilderRange actionParam="{mainParam: 'input-border-width', subVariablesConfig}" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
        <t t-call="website.ThemeResetButton" resetParam="['input-border-width', 'input-border-top-width', 'input-border-right-width', 'input-border-bottom-width', 'input-border-left-width']"/>
        <t t-set-slot="collapse">
            <BuilderRow label.translate="Top" level="1">
                <BuilderRange actionParam="{mainParam: 'input-border-top-width', subVariablesConfig}" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
            </BuilderRow>
            <BuilderRow label.translate="Right" level="1">
                <BuilderRange actionParam="{mainParam: 'input-border-right-width', subVariablesConfig}" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
            </BuilderRow>
            <BuilderRow label.translate="Bottom" level="1">
                <BuilderRange actionParam="{mainParam: 'input-border-bottom-width', subVariablesConfig}" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
            </BuilderRow>
            <BuilderRow label.translate="Left" level="1">
                <BuilderRange actionParam="{mainParam: 'input-border-left-width', subVariablesConfig}" unit="'px'" saveUnit="'rem'" min="0" max="10" withNumberInput="true"/>
            </BuilderRow>
        </t>
    </BuilderRow>
    <t t-set="round_corners_label">Round Corners</t>
    <t t-call="website.ThemeSizeRow" label="round_corners_label" variable="'input-border-radius'" min="0" max="50"/>
    <BuilderRow label.translate="Background">
        <BuilderColorPicker noTransparency="true"
            enabledTabs="['solid', 'custom']"
            action="'previewWebsiteColor'"
            actionParam="'input'"
        />
    </BuilderRow>
</t>

</templates>
