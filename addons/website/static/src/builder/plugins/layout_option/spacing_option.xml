<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.SpacingOption">
    <BuilderRow label.translate="Spacing" tooltip.translate="Vertical and Horizontal spacing" level="this.props.level" applyTo="this.props.applyTo">
        <BuilderNumberInput action="'setGridSpacing'" actionParam="'row-gap'" unit="'px'" default="0" tooltip.translate="Vertical spacing" prefixIcon="'height'"/>
        <BuilderNumberInput action="'setGridSpacing'" actionParam="'column-gap'" unit="'px'" default="0" max="60" tooltip.translate="Horizontal spacing" prefixIcon="'arrow_range'"/>
    </BuilderRow>
</t>

</templates>
