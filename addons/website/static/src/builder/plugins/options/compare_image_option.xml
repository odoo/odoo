<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.CompareImage">
    <BuilderRow label.translate="Orientation">
        <BuilderButtonGroup>
            <BuilderButton classAction="''" title.translate="Vertical divider, images side by side">Vertical</BuilderButton>
            <BuilderButton id="'compare_image_horizontal_opt'" classAction="'s_compare_image_horizontal'" title.translate="Horizontal divider, images stacked">Horizontal</BuilderButton>
        </BuilderButtonGroup>
    </BuilderRow>

    <BuilderRow label.translate="Labels">
        <!-- Both orientations drive the same "align-items" classes; only the
             wording differs, since the cross axis is vertical in the vertical
             variant and horizontal in the horizontal one. -->
        <BuilderButtonGroup applyTo="'.s_compare_image_labels'">
            <t t-if="this.isActiveItem('compare_image_horizontal_opt')">
                <BuilderButton classAction="''" title.translate="Left">Left</BuilderButton>
                <BuilderButton classAction="'s_compare_image_labels_center'" title.translate="Center">Center</BuilderButton>
                <BuilderButton classAction="'s_compare_image_labels_end'" title.translate="Right">Right</BuilderButton>
            </t>
            <t t-else="">
                <BuilderButton classAction="''" title.translate="Top">Top</BuilderButton>
                <BuilderButton classAction="'s_compare_image_labels_center'" title.translate="Center">Center</BuilderButton>
                <BuilderButton classAction="'s_compare_image_labels_end'" title.translate="Bottom">Bottom</BuilderButton>
            </t>
        </BuilderButtonGroup>
    </BuilderRow>

    <BuilderRow label.translate="Initial position"
        tooltip.translate="Where the divider sits when the page loads.">
        <BuilderRange styleAction="'--compare-pos'" min="0" max="100" step="1"
            default="50" unit="'%'" withNumberInput="true"/>
    </BuilderRow>

    <!-- The image contexts are split around the size row so the panel keeps the
         stock order (Media, Size, then the rest of the image tools). The size
         row cannot simply live inside them: it targets the frame, and "applyTo"
         only ever resolves downwards (querySelectorAll on the current editing
         element), so from an <img> there is no way back up to its parent. -->
    <BuilderOptionsSection title.translate="Before">
        <BuilderContext applyTo="'.s_compare_image_before'">
            <ReplaceMediaOption/>
        </BuilderContext>
        <!-- Scoped to the frame, not the image: both images span the frame, so
             resizing it resizes them together and keeps the divider aligned. -->
        <BuilderContext applyTo="'.s_compare_image_frame'">
            <MediaSizeOption level="1"/>
        </BuilderContext>
        <BuilderContext applyTo="'.s_compare_image_before'">
            <CompareImageToolOption/>
        </BuilderContext>
    </BuilderOptionsSection>

    <BuilderOptionsSection title.translate="After">
        <BuilderContext applyTo="'.s_compare_image_after'">
            <ReplaceMediaOption/>
        </BuilderContext>
        <BuilderRow label.translate="Size" level="1"
            tooltip.translate="The size belongs to the frame, which both images span. Set it from the Before section.">
            <span class="fst-italic">Inherited</span>
        </BuilderRow>
        <BuilderContext applyTo="'.s_compare_image_after'">
            <CompareImageToolOption/>
        </BuilderContext>
    </BuilderOptionsSection>
</t>

<!-- Both sections share this: no shape selector, and no per-image size row
     (the size lives on the frame and is rendered separately). -->
<t t-name="website.CompareImageToolOption" t-inherit="html_builder.ImageToolOption" t-inherit-mode="primary">
    <xpath expr="//ImageShapeOption" position="replace"/>
    <xpath expr="//MediaSizeOption" position="replace"/>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <compare_image_option template="website.CompareImage" selector=".s_compare_image"/>
    </xpath>
</t>
</templates>
