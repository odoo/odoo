<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.CompareImageOption">
    <BuilderRow label.translate="Orientation">
        <BuilderButtonGroup>
            <BuilderButton classAction="''">Vertical</BuilderButton>
            <BuilderButton id="'compare_image_horizontal_opt'" classAction="'s_compare_image_horizontal'">Horizontal</BuilderButton>
        </BuilderButtonGroup>
    </BuilderRow>

    <BuilderContext applyTo="'.s_compare_image_labels'">
        <BuilderRow label.translate="Labels">
            <BuilderCheckbox id="'compare_image_labels_opt'" classAction="'d-none'" inverseAction="true"/>
        </BuilderRow>
        <BuilderRow label.translate="Alignment" level="1" t-if="this.isActiveItem('compare_image_labels_opt')">
            <BuilderButtonGroup>
                <t t-if="this.isActiveItem('compare_image_horizontal_opt')">
                    <BuilderButton ltrRtlMapping="'left-right'" classAction="''">Left</BuilderButton>
                    <BuilderButton classAction="'align-items-center'">Center</BuilderButton>
                    <BuilderButton ltrRtlMapping="'left-right'" classAction="'align-items-end'">Right</BuilderButton>
                </t>
                <t t-else="">
                    <BuilderButton classAction="''">Top</BuilderButton>
                    <BuilderButton classAction="'align-items-center'">Center</BuilderButton>
                    <BuilderButton classAction="'align-items-end'">Bottom</BuilderButton>
                </t>
            </BuilderButtonGroup>
        </BuilderRow>
    </BuilderContext>

    <BuilderRow label.translate="Initial position"
        tooltip.translate="Where the divider sits when the page loads.">
        <BuilderRange styleAction="'--s_compare_image-position'" default="50" unit="'%'" withNumberInput="true"/>
    </BuilderRow>

    <BuilderContext applyTo="'.s_compare_image_frame'">
        <MediaSizeOption/>
    </BuilderContext>

    <BuilderOptionsSection title.translate="Before">
        <BuilderContext applyTo="'.s_compare_image_before'">
            <CompareImageToolOption/>
        </BuilderContext>
    </BuilderOptionsSection>

    <BuilderOptionsSection title.translate="After">
        <BuilderContext applyTo="'.s_compare_image_after'">
            <CompareImageToolOption/>
        </BuilderContext>
    </BuilderOptionsSection>
</t>

<t t-name="website.CompareImageToolOption" t-inherit="html_builder.ImageToolOption" t-inherit-mode="primary">
    <xpath expr="//t[MediaSizeOption]" position="replace">
        <ReplaceMediaOption/>
    </xpath>
    <xpath expr="//ImageShapeOption" position="replace"/>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <compare_image_option selector=".s_compare_image"/>
    </xpath>
</t>

</templates>
