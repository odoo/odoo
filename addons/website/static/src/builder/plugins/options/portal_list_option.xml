<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website.PortalListColumnsOption">
        <BuilderRow label.translate="Display Empty Message">
            <BuilderCheckbox action="'toggleEmptyMessage'"/>
        </BuilderRow>
        <BuilderList
            action="'updatePortalListColumns'"
            applyTo="'table[data-list-ref]'"
            records="this.state.columnChoices"
            itemShape="{ id: 'text', display_name: 'text' }"
            hiddenProperties="['id']"
            addItemTitle.translate="Add a column"
            withScrollbar="false"/>
    </t>

    <t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//t[@id='snippet_specific_options']" position="after">
            <portal_list_columns_option
                selector="main:has(table[data-list-ref])"
                editableOnly="false"
                reloadTarget="true"
                groups='["website.group_website_designer"]'/>
        </xpath>
    </t>
</templates>
