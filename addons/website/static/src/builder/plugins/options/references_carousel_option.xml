<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ReferencesCarouselOption">
    <BuilderRow label.translate="Direction">
        <BuilderSelect>
            <BuilderSelectItem ltrRtlMapping="'left-right'" classAction="'s_references_carousel_direction_left'">
                Left
            </BuilderSelectItem>
            <BuilderSelectItem ltrRtlMapping="'left-right'" classAction="'s_references_carousel_direction_right'">
                Right
            </BuilderSelectItem>
            <BuilderSelectItem id="'references_carousel_direction_none_opt'"
                    classAction="'s_references_carousel_direction_none'">
                None
            </BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <t t-if="!this.isActiveItem('references_carousel_direction_none_opt')">
        <BuilderRow level="1" label.translate="Scroll Speed">
            <BuilderRange styleAction="'--marquee-animation-speed'"
                min="1"
                max="10"
                step="1"
                unit="'s'"/>
        </BuilderRow>
        <BuilderRow label.translate="Hover effect">
            <BuilderSelect>
                <BuilderSelectItem classAction="''">None</BuilderSelectItem>
                <BuilderSelectItem classAction="'s_references_carousel_hover_pause'">Pause</BuilderSelectItem>
                <BuilderSelectItem classAction="'s_references_carousel_hover_slow'">Slowdown</BuilderSelectItem>
                <BuilderSelectItem classAction="'s_references_carousel_hover_direction'">Swap Direction</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>
    <BuilderRow label.translate="Parallax">
        <BuilderCheckbox classAction="'s_references_carousel_parallax'"/>
    </BuilderRow>
    <BuilderRow label.translate="Logo Size">
        <BuilderRange styleAction="'--references-carousel-logo-height'"
            min="24"
            max="120"
            step="8"
            unit="'px'"/>
    </BuilderRow>
    <BuilderRow label.translate="Gap">
        <BuilderRange styleAction="'--references-carousel-gap'"
            min="0"
            max="64"
            step="4"
            unit="'px'"/>
    </BuilderRow>
</t>

<t t-name="website.ReferencesCarouselItemOption">
    <WebsiteBackgroundOption
        withColors="true"
        withImages="false"
        withColorCombinations="true"
    />
    <!-- `withShapes` is only rendered when `withImages` is set, hence the
         explicit shape option here. -->
    <BackgroundShapeOption/>
</t>

<t t-name="website.ReferencesCarouselHeaderMiddleButtons">
    <button class="btn btn-success-color-hover ms-0 py-0 px-1 me-1"
            title="Add Reference"
            aria-label="Add Reference"
            t-on-click="this.addItem">
        <span class="oi oi-fw" data-icon="add"/>
    </button>
    <button class="btn btn-danger-color-hover py-0 px-1"
            t-att-disabled="this.state.disableRemoveButton"
            title="Remove Reference"
            aria-label="Remove Reference"
            t-on-click="this.removeItem">
        <span class="oi oi-fw" data-icon="remove"/>
    </button>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <references_carousel_option
            template="website.ReferencesCarouselOption"
            selector="section.s_references_carousel"/>
        <references_carousel_item_option
            selector=".s_references_carousel_item"
            title="Reference"/>
    </xpath>

    <!-- Images use o_snippet_not_selectable so global img options never target
         them; bind replace + image tools on the item with applyTo instead.
         REVIEW (JS): options with no `exclude` still match these imgs today
         (`grid_image_option`). Confirm whether to fix checkElement or the
         option XML before relying on this. -->
    <xpath expr="//t[@id='image_options']" position="inside">
        <replace_media_option selector=".s_references_carousel_item" applyTo="img"/>
        <image_tool_option selector=".s_references_carousel_item" applyTo="img"/>
    </xpath>
</t>

</templates>
