<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ReferencesCarouselOption">
    <BuilderRow label.translate="Title">
        <BuilderCheckbox classAction="'d-none'" applyTo="'.s_references_carousel_title'" inverseAction="true"/>
    </BuilderRow>
    <t t-call="website.MarqueeOptions" prefix="'s_references_carousel'"/>
    <BuilderRow label.translate="Logo Size">
        <BuilderRange styleAction="'--references-carousel-logo-height'"
            min="24"
            max="120"
            step="8"
            unit="'px'"/>
    </BuilderRow>
    <BuilderRow label.translate="Gap">
        <BuilderRange styleAction="'--references-carousel-gap'"
            min="0"
            max="64"
            step="4"
            unit="'px'"/>
    </BuilderRow>
</t>

<t t-name="website.ReferencesCarouselItemOption">
    <WebsiteBackgroundOption
        withColors="true"
        withImages="false"
        withColorCombinations="true"
    />
    <!-- `withShapes` is only rendered when `withImages` is set, hence the
         explicit shape option here. -->
    <BackgroundShapeOption/>
</t>

<t t-name="website.ReferencesCarouselHeaderMiddleButtons">
    <button class="btn btn-success-color-hover ms-0 py-0 px-1 me-1"
            title="Add Reference"
            aria-label="Add Reference"
            t-on-click="this.addItem">
        <span class="oi oi-fw" data-icon="add" role="img" aria-hidden="true"/>
    </button>
    <button class="btn btn-danger-color-hover py-0 px-1"
            t-att-disabled="this.state.disableRemoveButton"
            title="Remove Reference"
            aria-label="Remove Reference"
            t-on-click="this.removeItem">
        <span class="oi oi-fw" data-icon="remove" role="img" aria-hidden="true"/>
    </button>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <references_carousel_option
            template="website.ReferencesCarouselOption"
            selector="section.s_references_carousel"/>
        <references_carousel_item_option
            selector=".s_references_carousel_item"
            title="Reference"/>
    </xpath>
    <!-- A logo is sized by its cell (see the "Logo Size" option): a percentage
         width would only leave a hole in it. -->
    <xpath expr="//image_tool_option[@selector='img']" position="after">
        <image_tool_option selector=".s_references_carousel_item img" props='{ "withSize": false }'/>
    </xpath>
</t>

</templates>
