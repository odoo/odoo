<templates xml:space="preserve">
    <t t-name="website_builder.AnimateSection">
        <div class="o_animate_text_section" data-prevent-closing-overlay="true">
            <AnimateOption t-if="this.state.hasAnimation" dropdownClass="''" onScrollRow="true"/>
            <!-- Same row as the option's "Animation" select, set to None -->
            <div t-else="" class="o_hb_row d-flex position-relative" data-label="Animation">
                <div class="o_hb_row_label d-flex align-items-center">
                    <span class="text-nowrap text-truncate">Animation</span>
                </div>
                <div class="o_hb_row_content d-flex">
                    <Dropdown>
                        <button class="o_hb_select_toggle o_hb_btn btn btn-secondary text-start o-dropdown-caret w-100"
                                t-att-disabled="this.props.isDisabled() ? 'disabled' : undefined">None</button>
                        <t t-set-slot="content">
                            <div data-prevent-closing-overlay="true">
                                <DropdownItem onSelected="() => this.addAnimation()">On Appearance</DropdownItem>
                                <DropdownItem onSelected="() => this.addAnimation(true)">On Scroll</DropdownItem>
                            </div>
                        </t>
                    </Dropdown>
                </div>
            </div>
        </div>
    </t>
</templates>
