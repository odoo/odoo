<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ClickableElementOption">
    <BuilderRow label.translate="Make it clickable" tooltip.translate="Make the entire element clickable. Inner links will not be accessible by the user.">
        <BuilderCheckbox id="'is_clickable_opt'" action="'setElementClickable'" preview="false"/>
    </BuilderRow>

    <BuilderContext t-if="this.isActiveItem('is_clickable_opt')" level="true">
        <BuilderRow label.translate="Your URL">
            <BuilderUrlPicker action="'setElementAnchorUrl'" placeholder.translate="e.g. /page or URL" preview="false"/>
        </BuilderRow>

        <BuilderRow t-if="this.state.hasHref" label.translate="Open in New Tab" tooltip.translate="Enable this to open the link in a new browser tab">
            <BuilderCheckbox applyTo="':scope > .stretched-link, :scope > .slide-link'" attributeAction="'target'" attributeActionValue="'_blank'" preview="false"/>
        </BuilderRow>
    </BuilderContext>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//animate_option" position="before">
        <clickable_element_option
            selector=".s_card"
            t-att-exclude="this.specialCardSelector + ', *:has(> .stretched-link) *'"/>
        <clickable_element_option
            t-att-selector="this.cardParentHandlers"
            exclude=".s_carousel_cards_item, *:has(> .stretched-link) *"
            applyTo=":scope > .s_card"/>
    </xpath>
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <clickable_element_option
            selector=".carousel .carousel-item"
            exclude=".s_image_gallery .carousel-item, *:has(> .stretched-link) *"/>
    </xpath>
</t>
</templates>
