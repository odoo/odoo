<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.NavTabsHeaderMiddleButtons">
    <button class="oi oi-fw o_hb_btn btn btn-success-color-hover ms-0 me-1"
            data-icon="add"
            title="Add Tab"
            aria-label="Add Tab"
            t-on-click="this.addItem"/>
    <button class="oi oi-fw o_hb_btn btn btn-danger-color-hover"
            data-icon="remove"
            t-att-disabled="this.state.tabEls.length lte 2"
            title="Remove Tab"
            aria-label="Remove Tab"
            t-on-click="this.removeItem"/>
</t>

</templates>
