<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.EmphasizeAnimatedContent">
    <label t-if="this.state.hasAnimatedContent" for="emphasize_animated_content_checkbox" style="width: 100%">
        <div class="o_panel_header d-flex justify-content-between">
            <span>Highlight animated content</span>
            <CheckBox className="'form-switch o-hb-checkbox'" id="'emphasize_animated_content_checkbox'"
                value="this.state.animatedContentEmphasized" onChange.bind="this.toggleEmphasizeAnimatedContent"/>
        </div>
    </label>
</t>

</templates>
