<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="website.TeamBoardOption">
        <BuilderRow label.translate="Card Density">
            <BuilderButtonGroup>
                <BuilderButton classAction="'s_team_board_comfortable'">Comfortable</BuilderButton>
                <BuilderButton classAction="'s_team_board_compact'">Compact</BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>
        <BuilderRow label.translate="Card Layout">
            <BuilderSelect>
                <BuilderSelectItem classAction="'s_team_board_grid'">Grid</BuilderSelectItem>
                <BuilderSelectItem classAction="'s_team_board_list'">List</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>

    <t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//t[@id='snippet_specific_options']" position="after">
            <team_board_option
                template="website.TeamBoardOption"
                selector=".s_team_board"/>
        </xpath>
    </t>
</templates>
