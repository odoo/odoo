<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ConfidenceCollageOption">
    <BuilderRow label.translate="Scroll Speed">
        <BuilderRange styleAction="'--confidence-scroll-speed'"
            min="1"
            max="10"
            step="1"
            unit="'s'"/>
    </BuilderRow>
    <BuilderRow level="1" label.translate="Direction">
        <BuilderSelect>
            <BuilderSelectItem classAction="''">Default</BuilderSelectItem>
            <BuilderSelectItem classAction="'s_confidence_reverse'">Reverse</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <confidence_collage_option
            template="website.ConfidenceCollageOption"
            selector=".s_confidence_collage_col"/>
    </xpath>
</t>

</templates>
