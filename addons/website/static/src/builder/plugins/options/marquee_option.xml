<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Animation options shared by the infinite marquees (s_announcement_scroll,
     s_references_carousel, ...). `prefix` is the snippet class prefix, the
     same one given to the `Marquee` interaction and the `o-marquee-animation`
     mixin. -->
<t t-name="website.MarqueeOptions">
    <BuilderRow label.translate="Direction">
        <BuilderSelect>
            <BuilderSelectItem ltrRtlMapping="'left-right'" classAction="prefix + '_direction_left'">
                Left
            </BuilderSelectItem>
            <BuilderSelectItem ltrRtlMapping="'left-right'" classAction="prefix + '_direction_right'">
                Right
            </BuilderSelectItem>
            <BuilderSelectItem id="prefix + '_direction_none_opt'"
                    classAction="prefix + '_direction_none'">
                None
            </BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <t t-if="!this.isActiveItem(prefix + '_direction_none_opt')">
        <BuilderRow level="1" label.translate="Scroll Speed">
            <BuilderRange styleAction="'--marquee-animation-speed'"
                min="1"
                max="10"
                step="1"
                unit="'s'"/>
        </BuilderRow>
        <BuilderRow label.translate="Hover effect">
            <BuilderSelect>
                <BuilderSelectItem classAction="''">None</BuilderSelectItem>
                <BuilderSelectItem classAction="prefix + '_hover_pause'">Pause</BuilderSelectItem>
                <BuilderSelectItem classAction="prefix + '_hover_slow'">Slowdown</BuilderSelectItem>
                <BuilderSelectItem classAction="prefix + '_hover_direction'">Swap Direction</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
    </t>
    <BuilderRow label.translate="Parallax">
        <BuilderCheckbox classAction="prefix + '_parallax'"/>
    </BuilderRow>
</t>

</templates>
