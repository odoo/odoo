<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ReferencesCarouselLogos">
    <t t-set="items" t-value="this.domState.items"/>
    <BuilderRow label.translate="Logos">
        <BuilderButton action="'referencesCarouselAddItem'" icon="'add'" iconClass="'oi-fw'" preview="false">
            Add
        </BuilderButton>
    </BuilderRow>
    <div t-ref="this.rootRef" class="o_references_carousel_logos px-2 pb-2">
        <div t-foreach="items" t-as="item" t-key="item.key"
                class="o_references_carousel_logo d-flex align-items-center gap-1 py-1"
                t-att-data-position="item.position">
            <button class="btn o_drag_handle px-1" title="Drag to reorder" aria-label="Drag to reorder">
                <i class="oi" data-icon="drag_indicator" role="img" aria-hidden="true"/>
            </button>
            <span class="o_references_carousel_logo_preview d-flex flex-grow-1 align-items-center justify-content-center rounded bg-white p-1">
                <img t-att-src="item.src" alt=""/>
            </span>
            <BuilderButton
                action="'replaceMedia'"
                applyTo="`.s_references_carousel_item:nth-child(${item.position}) img`"
                icon="'image'"
                iconClass="'oi-fw'"
                title.translate="Replace logo"
                preview="false"/>
            <BuilderButton
                action="'referencesCarouselRemoveItem'"
                applyTo="`.s_references_carousel_item:nth-child(${item.position})`"
                icon="'delete'"
                iconClass="'oi-fw'"
                className="`btn-danger-color-hover ${items.length === 1 ? 'disabled' : ''}`"
                title.translate="Remove logo"
                preview="false"/>
        </div>
    </div>
</t>

</templates>
