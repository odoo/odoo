<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="website.team_board.member_card">
        <div class="o_team_board_card col-6 col-lg-3" data-name="Team Member">
            <div class="card border-0 o_cc o_cc1" data-snippet="s_card">
                <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                    <img class="card-img-top o_card_img" src="/web/image/website.set_avatars_square_md_2"/>
                </figure>
                <div class="card-body">
                    <h3 class="card-title h5-fs">Mich Stark</h3>
                    <h6 class="card-subtitle text-secondary mb-2">Chief Technical Officer</h6>
                    <p class="card-text">Tony leads the tech strategy and innovation efforts at the company.</p>
                </div>
            </div>
        </div>
    </t>
</templates>
