<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.IconOption" t-inherit="html_builder.IconOption">
    <xpath expr="//BuilderRow[@id=&quot;'color_opt'&quot;]/BuilderColorPicker" position="attributes">
        <attribute name="enabledTabs">['solid', 'custom', 'gradient']</attribute>
    </xpath>
    <xpath expr="//BuilderRow[@id=&quot;'background_color_opt'&quot;]/BuilderColorPicker" position="attributes">
        <attribute name="enabledTabs">['solid', 'custom', 'gradient']</attribute>
    </xpath>
    <xpath expr="//BuilderRow[@id=&quot;'background_color_opt'&quot;]" position="attributes">
        <attribute name="t-if">!this.state.isInSocialSnippet</attribute>
    </xpath>
    <xpath expr="//BuilderRow[@id=&quot;'font_size_opt'&quot;]" position="attributes">
        <attribute name="t-if">!this.state.isInSocialSnippet</attribute>
    </xpath>
    <xpath expr="//BuilderRow[@id=&quot;'font_size_opt'&quot;]/BuilderButtonGroup" position="attributes">
        <attribute name="action">'iconResize'</attribute>
    </xpath>
    <xpath expr="//BuilderRow[@id=&quot;'font_size_opt'&quot;]" position="after">
        <BorderConfigurator label.translate="Border" withRoundCorner="false" t-if="!this.state.isInSocialSnippet"/>
    </xpath>
</t>

</templates>
