<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.highlightPicker">
    <div t-ref="this.rootRef" class="o_highlight_picker" role="menu">
        <button t-if="this.props.removeHighlight" type="button" role="menuitemradio"
                class="o_highlight_none dropdown-item d-flex align-items-center gap-2"
                t-att-class="{ active: !this.props.currentHighlightId }"
                t-att-aria-checked="!this.props.currentHighlightId ? 'true' : 'false'"
                t-on-click="() => this.props.removeHighlight()">
            <span class="o-we-highlight-sample"><i class="oi text-muted" data-icon="block" role="img" aria-hidden="true"/></span>
            <span>None</span>
        </button>
        <t t-foreach="this.getHighlightFactory()" t-as="highlight" t-key="highlight">
            <t t-set="isCurrent" t-value="highlight === this.props.currentHighlightId"/>
            <button type="button" role="menuitemradio"
                    class="dropdown-item d-flex align-items-center gap-2"
                    t-att-class="{ active: isCurrent }"
                    t-att-aria-checked="isCurrent ? 'true' : 'false'"
                    t-att-data-highlight="highlight"
                    t-on-click="() => this.props.selectHighlight(highlight)"
                    t-on-mouseenter="() => this.props.previewHighlight(highlight)"
                    t-on-mouseleave="() => this.props.revertHighlight()">
                <span class="o-we-highlight-sample">
                    <span t-att-style="this.props.style" t-attf-class="o_text_highlight o_text_highlight_{{highlight}}">Text</span>
                </span>
                <span class="text-truncate" t-out="this.highlightIdToName[highlight] or highlight"/>
            </button>
        </t>
    </div>
</t>
</templates>
