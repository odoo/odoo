<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_website" model="res.groups.privilege">
        <field name="name">Website</field>
        <field name="sequence">23</field>
        <field name="category_id" ref="base.module_category_website" />
    </record>

    <record id="group_website_restricted_editor" model="res.groups">
        <field name="name">Restricted Editor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_website" />
    </record>

    <record id="group_website_designer" model="res.groups">
        <field name="name">Editor and Designer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_website" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_website_restricted_editor')), Command.link(ref('base.group_sanitize_override'))]" />
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

    <data noupdate="1">
        <record id="website_menu" model="ir.rule">
            <field name="name">Website menu: group_ids</field>
            <field name="model_id" ref="model_website_menu" />
            <field
                name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        </record>
        <record id="website_designer_edit_qweb" model="ir.rule">
            <field name="name">website_designer: Manage Website and qWeb view</field>
            <field name="model_id" ref="base.model_ir_ui_view" />
            <field name="domain_force">[('type', '=', 'qweb')]</field>
            <field name="groups" eval="[Command.link(ref('group_website_designer'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>
        <record id="website_designer_view" model="ir.rule">
            <field name="name">website_designer: global view</field>
            <field name="model_id" ref="base.model_ir_ui_view" />
            <field name="domain_force">[('type', '!=', 'qweb')]</field>
            <field name="groups" eval="[Command.link(ref('group_website_designer'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
        <record id="website_group_system_edit_all_views" model="ir.rule">
            <field name="name">Administration Settings: Manage all views</field>
            <field name="model_id" ref="base.model_ir_ui_view" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_system'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
        </record>
        <record id="website_page_rule_public" model="ir.rule">
            <field name="name">website.page: portal/public: read published pages</field>
            <field name="model_id" ref="website.model_website_page" />
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('base.group_portal')), Command.link(ref('base.group_public'))]" />
        </record>
        <record id="view_rule_visibility_public" model="ir.rule">
            <field name="name">Website View Visibility Public</field>
            <field name="model_id" ref="base.model_ir_ui_view" />
            <field
                name="domain_force">['|', ('type', '!=', 'qweb'), ('visibility', 'in', ('public', False))]</field>
            <field name="groups" eval="[Command.link(ref('base.group_public'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
        <record id="view_rule_visibility_connected" model="ir.rule">
            <field name="name">Website View Visibility Connected</field>
            <field name="model_id" ref="base.model_ir_ui_view" />
            <field
                name="domain_force">['|', ('type', '!=', 'qweb'), ('visibility', 'in', ('public', 'connected', False))]</field>
            <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
    </data>

    <record id="website_page_controller_expose" model="res.groups">
        <field name="name">Public access to arbitrary exposed model</field>
    </record>

    <record id="base.group_public" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('website.website_page_controller_expose'))]" />
    </record>

    <record id="base.group_portal" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('website.website_page_controller_expose'))]" />
    </record>

    <record id="website_page_controller_rule_public" model="ir.rule">
        <field
            name="name">website.controller.page: portal/public: read published pages</field>
        <field name="model_id" ref="website.model_website_controller_page" />
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('website.website_page_controller_expose'))]" />
    </record>

    <record id="access_ir_ui_view_controller_page_public" model="ir.access">
        <field
            name="name">Website: visitors read the visible views of exposed pages</field>
        <field name="model_id" ref="base.model_ir_ui_view" />
        <field name="group_id" ref="base.group_public" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
        <field
            name="domain">[('controller_page_ids', '!=', False), '|', ('type', '!=', 'qweb'), ('visibility', 'in', ('public', False))]</field>
    </record>

    <record id="access_ir_ui_view_controller_page_portal" model="ir.access">
        <field
            name="name">Website: portal users read the visible views of exposed pages</field>
        <field name="model_id" ref="base.model_ir_ui_view" />
        <field name="group_id" ref="base.group_portal" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
        <field
            name="domain">[('controller_page_ids', '!=', False), '|', ('type', '!=', 'qweb'), ('visibility', 'in', ('public', 'connected', False))]</field>
    </record>

</odoo>
