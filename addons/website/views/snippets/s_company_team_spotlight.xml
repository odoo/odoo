<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_company_team_spotlight" name="Team Spotlight">
    <section class="s_company_team_spotlight o_colored_level o_cc o_cc1 pt48 pb48">
        <div class="container">
            <h2 style="text-align: center;">Our Team</h2>
            <p><br/></p>
            <div class="row">
                <div data-name="Team Member" class="col-6 col-lg-3" data-jsonld-type="Person">
                    <div class="s_card o_card_img_top card o_cc o_cc1" data-vxml="001" data-snippet="s_card" data-name="Card">
                        <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                            <img class="o_card_img card-img-top" src="/web/image/website.set_avatars_square_md_1" data-jsonld-prop="image"/>
                        </figure>
                        <div class="card-body">
                            <h3 class="card-title h5-fs" data-jsonld-prop="name">Tony Fred</h3>
                            <p class="card-text" data-jsonld-prop="jobTitle">Chief Executive Officer</p>
                        </div>
                    </div>
                </div>
                <div data-name="Team Member" class="col-6 col-lg-3" data-jsonld-type="Person">
                    <div class="s_card o_card_img_top card o_cc o_cc1" data-vxml="001" data-snippet="s_card" data-name="Card">
                        <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                            <img class="o_card_img card-img-top" src="/web/image/website.set_avatars_square_md_2" data-jsonld-prop="image"/>
                        </figure>
                        <div class="card-body">
                            <h3 class="card-title h5-fs" data-jsonld-prop="name">Mich Stark</h3>
                            <p class="card-text" data-jsonld-prop="jobTitle">Chief Technical Manager</p>
