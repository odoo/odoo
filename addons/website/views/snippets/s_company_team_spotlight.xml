                            <img class="o_card_img card-img-top" src="/web/image/website.set_avatars_square_md_4" data-jsonld-prop="image"/>
                        </figure>
                        <div class="card-body">
                            <h3 class="card-title h5-fs" data-jsonld-prop="name">Iris Joe</h3>
