<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_hero_404_ghost" name="Hero 404 Error Ghost">
    <section class="s_hero_404_ghost o_three_quarter_height pt80 pb80">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <img class="img img-fluid mx-auto d-block" src="/html_editor/shape/http_routing/404.svg?c1=%23D1D1D1&amp;c4=o-color-4&amp;c5=o-color-5" alt=""/>
                </div>
                <div class="col-lg-8 d-lg-block d-none o_snippet_mobile_invisible">
                    <h1 class="h2-fs">We couldn't find the page you're looking for!</h1>
                    <p class="lead"><b>Don't panic.</b> If you think it's our mistake, please send us a message on <a href="/contactus" style="font-weight: bolder;">this page</a>.</p>
                </div>
                <div class="col-lg-12 d-lg-none o_snippet_desktop_invisible pt32">
                    <h2 style="text-align: center;">We couldn't find the page you're looking for!</h2>
                    <p><br/></p>
                    <p class="lead" style="text-align: center;"><b>Don't panic.</b> If you think it's our mistake, please send us a message on <a href="/contactus" style="font-weight: bolder;">this page</a>.</p>
                </div>
                <div class="col-lg-12">
                    <div class="s_hr pt32 pb48" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-color: var(--400);"/>
                    </div>
                    <p style="text-align: center;">Maybe you were looking for one of these <b>popular pages?</b></p>
                    <p style="text-align: center;">
                        <a class="btn btn-primary mb-2 o_translate_inline" href="/">Home</a>
                        <a class="btn btn-primary mb-2 o_translate_inline" href="/contactus">Contact Us</a>
                    </p>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
