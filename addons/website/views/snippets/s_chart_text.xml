                    <svg class="s_dialog_preview d-block mx-auto" width="450" height="230" viewBox="0 0 100 55" xmlns="http://www.w3.org/2000/svg">
                        <g stroke="var(--o-color-1)" stroke-width="0.4" opacity="0.25">
                            <line x1="5" y1="45" x2="95" y2="45"/>
                            <line x1="5" y1="37" x2="95" y2="37"/>
                            <line x1="5" y1="29" x2="95" y2="29"/>
                            <line x1="5" y1="21" x2="95" y2="21"/>
                            <line x1="5" y1="13" x2="95" y2="13"/>
                            <line x1="5" y1="5" x2="95" y2="5"/>
                            <line x1="5" y1="5" x2="5" y2="45"/>
                            <line x1="27.5" y1="5" x2="27.5" y2="45"/>
                            <line x1="50" y1="5" x2="50" y2="45"/>
                            <line x1="72.5" y1="5" x2="72.5" y2="45"/>
                            <line x1="95" y1="5" x2="95" y2="45"/>
                        </g>
                        <polyline points="5,35.4 27.5,25.8 50,30.6 72.5,19.4 95,9.8" fill="none" stroke="var(--o-color-1)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
