<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_references_carousel" name="References Carousel">
    <section class="s_references_carousel s_references_carousel_direction_left s_references_carousel_parallax s_references_carousel_hover_pause o_cc o_cc1 pt48 pb48"
            style="--marquee-animation-speed: 5s; --references-carousel-logo-height: 72px; --references-carousel-gap: 32px;">
        <div class="s_references_carousel_title container oe_unremovable text-center mb-4">
            <h2>Trusted references</h2>
        </div>
        <!-- The title container locks the section: o_editable_media keeps the logos replaceable. -->
        <div class="s_references_carousel_marquee_container d-flex align-items-center"
                role="marquee"
                aria-label="Reference logos">
            <div class="s_references_carousel_marquee_item d-flex align-items-center">
                <div class="s_references_carousel_item o_cc o_cc2" data-name="Reference">
                    <img src="/web/image/website.s_reference_demo_image_1" class="img img-fluid o_editable_media" alt=""/>
                </div>
                <div class="s_references_carousel_item o_cc o_cc2" data-name="Reference">
                    <img src="/web/image/website.s_reference_demo_image_2" class="img img-fluid o_editable_media" alt=""/>
                </div>
                <div class="s_references_carousel_item o_cc o_cc2" data-name="Reference">
                    <img src="/web/image/website.s_reference_demo_image_3" class="img img-fluid o_editable_media" alt=""/>
                </div>
                <div class="s_references_carousel_item o_cc o_cc2" data-name="Reference">
                    <img src="/web/image/website.s_reference_demo_image_4" class="img img-fluid o_editable_media" alt=""/>
                </div>
                <div class="s_references_carousel_item o_cc o_cc2" data-name="Reference">
                    <img src="/web/image/website.s_reference_demo_image_5" class="img img-fluid o_editable_media" alt=""/>
                </div>
                <div class="s_references_carousel_item o_cc o_cc2" data-name="Reference">
                    <img src="/web/image/website.s_reference_default_image_6" class="img img-fluid o_editable_media" alt=""/>
                </div>
            </div>
        </div>
    </section>
</template>

<asset id="website.s_references_carousel_000_scss" name="References Carousel 000 SCSS">
    <bundle>web.assets_frontend</bundle>
    <path>website/static/src/snippets/s_references_carousel/000.scss</path>
</asset>

</odoo>
