<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_references_carousel" name="References Carousel">
    <section class="s_references_carousel s_references_carousel_direction_left s_references_carousel_parallax s_references_carousel_hover_pause o_marquee_pause_btn_hidden o_cc o_cc1 pt48 pb48"
            style="--marquee-animation-speed: 5s;">
        <div class="container-fluid d-flex flex-wrap align-items-center">
            <div class="s_references_carousel_title oe_unremovable text-break col-12 text-center mb-4">
                <h2>Trusted references</h2>
            </div>
            <div class="s_references_carousel_marquee_wrapper position-relative col">
                <button class="o_marquee_pause o_snippet_not_selectable o_not_editable o_btn_reset z-2" title="Pause animation">
                    <span class="o_marquee_pause_icon oi oi-filled" data-icon="pause" role="img" aria-hidden="true"/>
                    <span class="visually-hidden">Pause animation</span>
                </button>
                <div class="s_references_carousel_marquee_container d-flex align-items-center"
                        role="marquee"
                        aria-label="Reference logos">
                    <div class="s_references_carousel_marquee_item">
                        <div class="s_references_carousel_item d-flex flex-shrink-0 align-items-center justify-content-center overflow-hidden" data-name="Reference">
                            <img src="/web/image/website.s_reference_demo_image_1" class="img img-fluid o_editable_media" alt=""/>
                        </div>
                        <div class="s_references_carousel_item d-flex flex-shrink-0 align-items-center justify-content-center overflow-hidden" data-name="Reference">
                            <img src="/web/image/website.s_reference_demo_image_2" class="img img-fluid o_editable_media" alt=""/>
                        </div>
                        <div class="s_references_carousel_item d-flex flex-shrink-0 align-items-center justify-content-center overflow-hidden" data-name="Reference">
                            <img src="/web/image/website.s_reference_demo_image_3" class="img img-fluid o_editable_media" alt=""/>
                        </div>
                        <div class="s_references_carousel_item d-flex flex-shrink-0 align-items-center justify-content-center overflow-hidden" data-name="Reference">
                            <img src="/web/image/website.s_reference_demo_image_4" class="img img-fluid o_editable_media" alt=""/>
                        </div>
                        <div class="s_references_carousel_item d-flex flex-shrink-0 align-items-center justify-content-center overflow-hidden" data-name="Reference">
                            <img src="/web/image/website.s_reference_demo_image_5" class="img img-fluid o_editable_media" alt=""/>
                        </div>
                        <div class="s_references_carousel_item d-flex flex-shrink-0 align-items-center justify-content-center overflow-hidden" data-name="Reference">
                            <img src="/web/image/website.s_reference_default_image_6" class="img img-fluid o_editable_media" alt=""/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<asset id="website.s_references_carousel_000_css" name="References Carousel 000 CSS">
    <bundle>web.assets_frontend</bundle>
    <path>website/static/src/snippets/s_references_carousel/000.css</path>
</asset>

</odoo>
