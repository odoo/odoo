<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_team_board" name="Team Board">
        <section class="s_team_board pt48 pb48">
            <div class="container">
                <h2 class="text-start">Meet Our Team</h2>
                <p class="text-start text-muted">The people building the experience you rely on every day.</p>

                <div class="row">
                    <div class="col-lg-3 col-6 pb48">
                        <div data-name="Card" class= "s_card o_card_img_top s_team_board_card card">
                            <figure class="o_card_img_wrapper mb-0">
                                <img class="o_card_img img-fluid" src="/web/image/website.set_avatars_square_md_1" style="width: 100% !important; height: auto;"/>
                            </figure>
                            <div class="card-body">
                                <h3>Ahmed Gamal</h3>
                                <p class="text-muted mb-3">Chief Executive Officer</p>
                                <p>Tony shapes products strategy and keeps execution aligned across teams.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6 pb48">
                        <div data-name="Card" class= "s_card o_card_img_top s_team_board_card card">
                            <figure class="o_card_img_wrapper mb-0">
                                <img class="o_card_img img-fluid" src="/web/image/website.set_avatars_square_md_2" style="width: 100% !important; height: auto;"/>
                            </figure>
                            <div class="card-body">
                                <h3>Mich Stark</h3>
                                <p class="text-muted mb-3">Chief Commercial Officer</p>
                                <p>Tony shapes products strategy and keeps execution aligned across teams.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6 pb48">
                        <div data-name="Card" class= "s_card o_card_img_top s_team_board_card card">
                            <figure class="o_card_img_wrapper mb-0">
                                <img class="o_card_img img-fluid" src="/web/image/website.set_avatars_square_md_3" style="width: 100% !important; height: auto;"/>
                            </figure>
                            <div class="card-body">
                                <h3>Aline Turner</h3>
                                <p class="text-muted mb-3">Cheif Technical Officer</p>
                                <p>Tony shapes products strategy and keeps execution aligned across teams.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </section>
    </template>

    <asset id="website.s_team_board_000_scss" name="Team Board 000 SCSS">
        <bundle>web.assets_frontend</bundle>
        <path>website/static/src/snippets/s_team_board/000.scss</path>
    </asset>

</odoo>
