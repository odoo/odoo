<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_team_board" name="Team Board">
        <section class="o_cc o_cc1 pt96 pb64">
            <div class="container">
                <h2 class="h3-fs" style="text-align: center;">Meet Our Team</h2>
                <div class="row">
                    <div class="col-lg-3 col-6 pb32 text-center">
                        <img class="img-fluid rounded-4 me-auto"
                             src="/web/image/website.set_avatars_square_md_1"
                             alt="Mitchell"/>
                        <div>
                            <h3 class="card-title h5">Mitchell</h3>
                            <p class="text-muted fw-bold">Chief Executive Officer</p>
                            <p class="card-text">Short bio about Mitchell: his background, his passions and what she brings to the team.</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6 pb32 text-center">
                        <img class="img-fluid rounded-4 me-auto"
                             src="/web/image/website.set_avatars_square_md_2"
                             alt="John"/>
                        <div>
                            <h3 class="card-title h5">John</h3>
                            <p class="text-muted fw-bold">Chief Technical Officer</p>
                            <p class="card-text">Short bio about John: his background, his passions and what he brings to the team.</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6 pb32 text-center">
                        <img class="img-fluid rounded-4 me-auto"
                             src="/web/image/website.set_avatars_square_md_3"
                             alt="Alice"/>
                        <div>
                            <h3 class="card-title h5">Alice</h3>
                            <p class="text-muted fw-bold">Marketing Manager</p>
                            <p class="card-text">Short bio about Alice: her background, her passions and what she brings to the team.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
