<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_team_board" name="Card Team">
    <section class="s_team_board o_colored_level o_cc o_cc2 pt48 pb48">
        <div class="container">

            <h2>Meet Our Team</h2>
            <p style="text-align: left;">The people building the experience you rely on every day.</p>

            <div class="row">
                <div data-name="Team Member" class="col-6 col-lg-3">
                    <div class="s_card o_card_img_top card o_cc o_cc1" data-name="Card" data-snippet="s_card" data-vxml="001" style="border-width: 0px !important;">
                        <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                            <img class="o_card_img card-img-top " src="/web/image/website.set_avatars_square_md_1"/>
                        </figure>
                        <div class="card-body">
                            <h3 class="card-title h5-fs">James Mitchell</h3>
                            <p class="card-text text-secondary">Chief Technical Officer<br/><br/></p>
                            <p class="card-text">James leads the tech strategy and innovation efforts at the company.</p>
                        </div>
                    </div>
                </div>
                <div data-name="Team Member" class="col-6 col-lg-3">
                    <div class="s_card o_card_img_top card o_cc o_cc1" data-name="Card" data-snippet="s_card" data-vxml="001" style="border-width: 0px !important;">
                        <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                            <img class="o_card_img card-img-top " src="/web/image/website.set_avatars_square_md_4"/>
                        </figure>
                        <div class="card-body">
                            <h3 class="card-title h5-fs">Sophia Benett</h3>
                            <p class="card-text text-secondary">Financial Analyst<br/><br/></p>
                            <p class="card-text">Sophia evaluates financial data and provides strategic insights.</p>
                        </div>
                    </div>
                </div>
                <div data-name="Team Member" class="col-6 col-lg-3">
                    <div class="s_card o_card_img_top card o_cc o_cc1" data-name="Card" data-snippet="s_card" data-vxml="001" style="border-width: 0px !important;">
                        <figure class="o_card_img_wrapper ratio ratio-1x1 mb-0">
                            <img class="o_card_img card-img-top " src="/web/image/website.set_avatars_square_md_3"/>
                        </figure>
                        <div class="card-body">
                            <h3 class="card-title h5-fs ">Olivia Reed</h3>
                            <p class="card-text text-secondary">Product Manager<br/><br/></p>
                            <p class="card-text">Olivia oversees product development from concept to launch.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
