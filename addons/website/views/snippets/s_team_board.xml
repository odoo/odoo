                        <p class="text-muted mb-3">Chief Executive Officer</p>
                        <p>Tony shapes products strategy and keeps execution aligned across teams.</p>
                    </div>
                    <div data-name="Card" class="col-lg-3 col-6 pb48">
                        <img class="o_editable_media img-fluid me-auto float-start" src="/web/image/website.set_avatars_square_md_2" style="width: 100% !important; height: auto;"/>
                        <h3>Mich Stark</h3>
                        <p class="text-muted mb-3">Chief Commercial Officer</p>
                        <p>Tony shapes products strategy and keeps execution aligned across teams.</p>
                    </div>
                    <div data-name="Card" class="col-lg-3 col-6 pb48">
                        <img class="o_editable_media img-fluid me-auto float-start" src="/web/image/website.set_avatars_square_md_3" style="width: 100% !important; height: auto;"/>
                        <h3>Aline Turner</h3>
                        <p class="text-muted mb-3">Cheif Technical Officer</p>
                        <p>Tony shapes products strategy and keeps execution aligned across teams.</p>
                    </div>
                </div>
            </div>
            
        </section>
