<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_hero_404" name="Hero 404 Error">
    <section class="s_hero_404 o_full_screen_height pt80 pb80">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 pb24">
                    <img src="/html_editor/shape/website/s_hero_404.svg?c1=%233AAADA&amp;c2=%23653358&amp;c3=%23200C51&amp;c4=o-color-4&amp;c5=o-color-5" alt="" class="img img-fluid mx-auto d-block"/>
                    <p><br/></p>
                    <h1 class="display-4" style="text-align: center;"><strong>Oops! Page not found</strong></h1>
                    <p style="text-align: center;" class="lead">The page you are looking for might have been removed or is temporarily unavailable.</p>
                </div>
                <div class="col-lg-8 offset-lg-2 o_cc o_cc2 pt24 pb24 rounded-3">
                    <p style="text-align: center;" class="lead" >Maybe you were looking for one of these popular pages?</p>
                    <p style="text-align: center;"><a class="btn btn-primary mb-2" href="/">Homepage</a>&amp;nbsp;&amp;nbsp;<a class="btn btn-primary mb-2" href="/contactus">Contact Us</a>&amp;nbsp;&amp;nbsp;<a class="btn btn-primary mb-2" href="/#">About Us</a></p>
                </div>
            </div>
        </div>
    </section>
</template>
<template id="s_hero_404_default" name="Hero 404 Error">
    <section class="s_hero_404_default o_full_screen_height pt80 pb80">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 pb32">
                    <img class="img img-fluid mx-auto" src="/html_editor/shape/http_routing/404.svg?c1=%23D1D1D1&amp;c4=o-color-4&amp;c5=o-color-5" alt=""/>
                </div>
                <div class="col-lg-8 text-lg-start text-center my-auto">
                    <h1 class="visually-hidden">Error 404</h1>
                    <h2>We couldn't find the page you're looking for!</h2>
                    <p></p>
                    <p><b>Don't panic.</b> If you think it's our mistake, please send us a message on <a href="/contactus">this page</a>.</p>
                </div>
                <div class="col-lg-12">
                    <div class="s_hr pt32 pb48" data-snippet="s_hr" data-name="Separator">
                        <hr class="w-100 mx-auto" style="border-top-width: 1px; border-top-style: solid; border-top-color: var(--400);"/>
                    </div>
                </div>
                <div class="col-lg-12">
                    <p class="text-center">Maybe you were looking for one of these <b>popular pages?</b></p>
                    <ul class="list-inline text-center">
                        <li class="list-inline-item mb-2"><a href="/" class="btn btn-primary">Home</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
