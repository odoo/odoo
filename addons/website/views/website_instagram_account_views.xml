<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Accounts are connected from the options of the Instagram Carousel
    block, which checks their access token. -->
    <record id="website_instagram_account_action" model="ir.actions.act_window">
        <field name="name">Instagram Accounts</field>
        <field name="res_model">website.instagram.account</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Instagram account connected yet</p>
            <p>Connect one from the options of an Instagram Carousel block.</p>
        </field>
    </record>

    <menuitem name="Instagram Accounts"
        id="menu_website_instagram_account"
        action="website_instagram_account_action"
        parent="menu_website_global_configuration"
        sequence="35"/>

</odoo>
