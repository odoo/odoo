<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="theme_colors_preview" inherit_id="web.layout" primary="True">
    <xpath expr="//head/link[last()]" position="after">
        <t t-call="website.font_links"/>
        <t t-call-assets="web.assets_frontend" t-js="false"/>
        <t t-call-assets="website.assets_wysiwyg" t-js="false"/>
        <t t-call-assets="website.assets_theme_colors_preview"/>
    </xpath>
    <xpath expr="//body" position="inside">
        <section class="o_colored_level d-flex align-items-center min-vh-100">
            <div class="container py-4 mb-5">
                <div class="row g-3">
                    <t t-foreach="range(1, 6)" t-as="preset_id">
                        <div class="col-lg-4">
                            <span class="badge o_website_theme_colors_preview_label mb-2" style="--badge-border-color: #cccccc; --badge-bg: white; --badge-color: black;">
                                Color preset #<t t-out="preset_id"/>
                            </span>
                            <div t-attf-class="o_colored_level o_cc o_cc#{preset_id} p-4 pb-3 border rounded-1 shadow-sm">
                                <h4>Title</h4>
                                <p>This is how text and <a href="#">links</a> will look with this color preset.</p>
                                <p class="mb-0">
                                    <a class="btn btn-primary mb-2" href="#">Primary</a>
                                    <a class="btn btn-secondary mb-2" href="#">Secondary</a>
                                </p>
                                <p class="mb-0">
                                    <a class="btn btn-outline-primary mb-2" href="#">Primary</a>
                                    <a class="btn btn-outline-secondary mb-2" href="#">Secondary</a>
                                </p>
                            </div>
                        </div>
                    </t>
                    <div class="col-lg-4 d-flex flex-column">
                        <span class="badge o_website_theme_colors_preview_label align-self-start mb-2" style="--badge-border-color: #cccccc; --badge-bg: white; --badge-color: black;">
                            UI elements
                        </span>
                        <div class="d-flex flex-column align-items-center h-100 p-4 pb-2 border rounded-1 shadow-sm">
                            <div class="d-flex justify-content-center align-items-center gap-2 w-100 mb-3">
                                <a class="btn btn-light oi align-content-center h-100" data-icon="home" href="#"/>
                                <div class="input-group">
                                    <input type="search" name="search" class="form-control border-0 bg-light" placeholder="Search..."/>
                                    <button type="submit" aria-label="Search" title="Search" class="btn btn-light">
                                        <i class="oi" data-icon="search"></i>
                                    </button>
                                </div>
                            </div>
                            <input type="text" class="form-control mb-3" placeholder="Text Input"/>
                            <div class="d-flex w-100">
                                <div style="flex: 1;">
                                    <div class="d-flex gap-1">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"/>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"/>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="demo_radio"/>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" checked=""/>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" checked=""/>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="demo_radio" checked=""/>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap justify-content-end align-self-start gap-2" style="flex: 1;">
                                    <span class="badge text-bg-success">Success</span>
                                    <span class="badge text-bg-info">Info</span>
                                    <span class="badge text-bg-warning">Warning</span>
                                    <span class="badge text-bg-danger">Error</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </xpath>
</template>

</odoo>
