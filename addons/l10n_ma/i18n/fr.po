#: model_terms:ir.ui.view,arch_db:l10n_ma.address_form_fields
msgid ""
"<small class=\"form-text text-muted\">\n"
"                        Modifying the ICE number is not allowed once "
"documents have\n"
"                        been issued for your account. Please contact us "
"directly if that's what you intend to do.\n"
"                    </small>"
