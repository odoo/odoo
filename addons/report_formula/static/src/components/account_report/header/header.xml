<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="report_formula.AccountReportHeader">
        <t t-call="{{ this.env.template('AccountReportHeader') }}"/>
    </t>

    <t t-name="report_formula.AccountReportHeaderCustomizable">
        <thead id="table_header" class="sticky">
            <!-- Headers -->
            <t t-foreach="this.columnHeaders" t-as="columnHeader" t-key="columnHeader_index">
                <tr data-id="column_headers_row">
                    <!-- First empty column -->
                    <th>
                        <t t-if="columnHeader_first and this.controller.options.companies.length > 1">
                            <span class="companies_header" t-out="this.controller.options.companies.map(company => company.name).join(', ')"/>
                        </t>
                    </th>

                    <!-- Other columns -->
                    <t t-foreach="columnHeader" t-as="header" t-key="header_index">
                        <th
                            class="column_header"
                            t-att-colspan="this.columnHeadersColspan(columnHeader_index, header)"
                            t-att-rowspan="this.columnHeadersRowspan(header)"
                        >
                            <t t-out="header.name"/>
                        </th>
                    </t>

                    <t t-if="this.controller.options.show_horizontal_group_total">
                        <t t-if="!columnHeader_first">
                            <th class="column_header">
                                <t t-out="this.controller.options.available_horizontal_groups.find(group => group.id === this.controller.options.selected_horizontal_group_id)?.name"/>
                            </th>
                        </t>
                    </t>

                    <!-- Growth comparison column -->
                    <t t-if="this.controller.needsColumnPercentComparison">
                        <!-- We only want to display it once on the first row -->
                        <t t-if="columnHeader_first">
                            <th class="column_percent_comparison_header">
                                <i class="fa-solid fa-percent"/>
                            </th>
                        </t>
                    </t>

                    <!-- Analytic coverage column -->
                    <t t-if="this.controller.needsAnalyticCoverageColumn">
                        <t t-if="columnHeader_index == 1">
                            <th>
                                <t>Analytic coverage</t>
                            </th>
                        </t>
                    </t>

                    <!-- Debug column -->
                    <t t-if="this.controller.hasDebugColumn">
                        <!-- We only want to display it once on the first row -->
                        <t t-if="columnHeader_first">
                            <th class="debug_header">
                                <i class="fa-solid fa-bug"/>
                            </th>
                        </t>
                    </t>
                </tr>
            </t>

            <!-- Custom subheaders -->
            <t t-if="this.controller.hasCustomSubheaders">
                <tr data-id="column_custom_subheaders_row">
                    <!-- First empty column -->
                    <th/>

                    <!-- Other columns -->
                    <t t-foreach="this.customSubheaders" t-as="customSubheader" t-key="customSubheader_index">
                        <th
                            t-att-colspan="customSubheader.colspan || 1"
                            t-att-data-expression_label="customSubheader.expression_label"
                        >
                            <t t-out="customSubheader.name"/>
                        </th>
                    </t>

                    <!-- Debug column -->
                    <t t-if="this.controller.hasDebugColumn">
                        <!-- Empty to prevent a gap beneath the debug label -->
                        <th/>
                    </t>
                </tr>
            </t>

            <!-- Subheaders -->
            <tr data-id="column_subheaders_row">
                <!-- First empty column -->
                <th/>

                <!-- Other columns -->
                <t t-foreach="this.subheaders" t-as="subheader" t-key="subheader_index">
                    <th
                        t-att-colspan="subheader.colspan || 1"
                        t-att-class="subheader.class"
                        t-att-data-expression_label="subheader.expression_label"
                    >
                        <!-- Sortable -->
                        <t t-if="subheader.sortable">
                            <button
                                class="btn btn_sortable"
                                t-on-click="() => this.sortLinesByColumn(subheader_index, subheader)"
                            >
                                <i t-att-class="this.sortableClasses(subheader_index)"/>
                            </button>
                        </t>

                        <t t-if="subheader.template">
                            <t t-call="{{ subheader.template }}"/>
                        </t>
                        <t t-else="">
                            <t t-out="subheader.name"/>
                        </t>
                    </th>
                </t>

                <!-- Debug column -->
                <t t-if="this.controller.hasDebugColumn">
                    <!-- Empty to prevent a gap beneath the debug label -->
                    <th/>
                </t>

                <t t-if="this.controller.options.show_horizontal_group_total">
                    <th>
                        <!-- Since we have only one column possible with horizontal group totals taking the first element is ok -->
                        <t t-out="this.subheaders[0].name"/>
                    </th>
                </t>
            </tr>
        </thead>
    </t>
</templates>
