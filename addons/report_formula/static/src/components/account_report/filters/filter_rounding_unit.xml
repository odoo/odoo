<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="report_formula.AccountReportFilterRoundingUnit">
        <Dropdown>
            <button class="btn btn-secondary">
                <t t-out="this.roundingUnitName(this.controller.cachedFilterOptions['rounding_unit'])"/>
            </button>

            <t t-set-slot="content">
                <t t-foreach="this.controller.cachedFilterOptions.rounding_unit_names" t-as="roundingUnitValue" t-key="roundingUnitValue_index">
                    <DropdownItem
                        class="{ 'selected': (this.controller.cachedFilterOptions.rounding_unit == roundingUnitValue) }"
                        onSelected="() => this.filterRoundingUnit(roundingUnitValue)"
                    >
                        <t t-out="this.roundingUnitName(roundingUnitValue)"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
