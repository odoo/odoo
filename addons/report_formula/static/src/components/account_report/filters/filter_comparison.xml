<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="report_formula.AccountReportComparisonPeriod">
        <div t-att-class="(this.controller.cachedFilterOptions.comparison.filter !== filter) ? 'invisible' : ''">
            <input
                min="1"
                type="number"
                t-att-value="this.controller.cachedFilterOptions.comparison.number_period"
                t-on-change="(ev) => this.setNumberPeriods(ev)"
            />
            <label>
                <t t-out="this.periodLabel"/>
            </label>
        </div>
    </t>

    <t t-name="report_formula.AccountReportFilterComparison">
        <Dropdown
            menuClass="'account_report_filter comparison'"
            navigationOptions="this.dropdownProps"
        >
            <button class="btn btn-secondary">
                <i class="fa-solid fa-percent me-1"/>
                <span>Comparison</span>
                <t t-if="this.controller.cachedFilterOptions.comparison.string">
                    <span>: </span>
                    <t t-if="this.controller.cachedFilterOptions.comparison.filter === 'previous_period'">
                        <t t-if="this.controller.cachedFilterOptions.comparison.number_period === 1">
                            <span>Previous Period</span>
                        </t>
                        <t t-elif="this.controller.cachedFilterOptions.comparison.number_period > 1">
                            <t t-out="`${ this.controller.cachedFilterOptions.comparison.number_period } `"/>
                            <span>Previous Periods</span>
                        </t>
                    </t>
                    <t t-elif="this.controller.cachedFilterOptions.comparison.filter === 'same_last_year'">
                        <t t-if="this.controller.cachedFilterOptions.comparison.number_period === 1">
                            <span>Previous Year</span>
                        </t>
                        <t t-elif="this.controller.cachedFilterOptions.comparison.number_period > 1">
                            <t t-out="`${ this.controller.cachedFilterOptions.comparison.number_period } `"/>
                            <span>Previous Years</span>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-out="`${ this.controller.cachedFilterOptions.comparison.string }`"/>
                    </t>
                </t>
            </button>

            <t t-set-slot="content">
                <DropdownItem
                    class="{ 'selected': (this.controller.cachedFilterOptions.comparison.filter === 'no_comparison') }"
                    onSelected="() => this.filterClicked({ optionKey: 'comparison.filter', optionValue: 'no_comparison', reload: true})"
                    closingMode="'none'"
                >
                    No Comparison
                </DropdownItem>

                <DropdownItem
                    class="{ 'selected': this.controller.cachedFilterOptions.comparison.filter === 'previous_period', 'dropdown-item': true, 'period': true }"
                    onSelected="() => this.filterClicked({ optionKey: 'comparison.filter', optionValue: 'previous_period', reload: true})"
                    closingMode="'none'"
                >
                    <label class="d-flex align-items-center">
                        Previous Period
                    </label>

                    <t t-call="report_formula.AccountReportComparisonPeriod" filter="'previous_period'"/>
                </DropdownItem>

                <DropdownItem
                    class="{ 'selected': this.controller.cachedFilterOptions.comparison.filter === 'same_last_year', 'dropdown-item': true, 'period': true }"
                    attrs="{ 'name': 'filter_comparison_same_period_last_year' }"
                    onSelected="() => this.filterClicked({ optionKey: 'comparison.filter', optionValue: 'same_last_year', reload: true})"
                    closingMode="'none'"
                >
                    <label class="d-flex align-items-center">
                        Same Period Last Year
                    </label>

                    <t t-call="report_formula.AccountReportComparisonPeriod" filter="'same_last_year'"/>
                </DropdownItem>

                <t t-if="this.controller.cachedFilterOptions.date.mode === 'range'">
                    <DropdownItem
                        class="{ 'selected': this.controller.cachedFilterOptions.comparison.filter === 'custom', 'dropdown-item': true, 'date': true }"
                        attrs="{ 'name': 'filter_comparison_custom' }"
                        onSelected="() => this.filterClicked({ optionKey: 'comparison.filter', optionValue: 'custom'})"
                        closingMode="'none'"
                    >
                        <label class="d-flex align-items-center">
                            Custom Dates
                        </label>

                        <div class="d-flex flex-row"
                             t-att-class="(this.controller.cachedFilterOptions.comparison.filter !== 'custom') ? 'invisible' : ''">
                            <DateTimeInput
                                type="'date'"
                                value="this.dateFrom('comparison')"
                                onChange="(dateFrom) => this.setDateFrom('comparison', dateFrom)"
                            />
                            <label class="d-flex align-items-center">
                                to
                            </label>
                            <DateTimeInput
                                type="'date'"
                                value="this.dateTo('comparison')"
                                onChange="(dateTo) => this.setDateTo('comparison', dateTo)"
                            />
                        </div>
                    </DropdownItem>
                </t>

                <t t-if="this.controller.cachedFilterOptions.date.mode === 'single'">
                    <DropdownItem
                        class="{ 'selected': this.controller.cachedFilterOptions.comparison.filter === 'custom', 'dropdown-item': true, 'date': true }"
                        onSelected="() => this.filterClicked({ optionKey: 'comparison.filter', optionValue: 'custom'})"
                        closingMode="'none'"
                    >
                        <label class="d-flex align-items-center">
                            Specific Date
                        </label>

                        <div t-att-class="(this.controller.cachedFilterOptions.comparison.filter !== 'custom') ? 'invisible' : ''">
                            <DateTimeInput
                                type="'date'"
                                value="this.dateTo('comparison')"
                                onChange="(dateTo) => this.setDateTo('comparison', dateTo)"
                            />
                        </div>
                    </DropdownItem>
                </t>

                <t t-if="!this.controller.cachedFilterOptions.comparison.hide_period_order_filter">

                    <div class="dropdown-divider"/>

                    <div class="dropdown-item period order">
                        <label class="d-flex align-items-center pe-none">
                            Period order
                        </label>

                        <div>
                            <select name="select_order"
                                    class="o_input pe-3"
                                    t-on-change="(ev) => this.filterClicked({ optionKey: 'comparison.period_order', optionValue: ev.target.value, reload: true})">
                                <option t-foreach="this.availablePeriodOrder"
                                        t-as="order"
                                        t-key="order_index"
                                        t-att-value="order"
                                        t-att-selected="this.availablePeriodOrder[order] === this.periodOrder"
                                        t-out="this.availablePeriodOrder[order]"
                                />
                            </select>
                        </div>
                    </div>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
