<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_pl_edi_qr_code.OfflineActions">
        <DropdownItem t-if="isAvailable" class="'o_l10n_pl_offline_action'" onSelected.bind="executeAction">
            <t t-if="isCancellation">
                <i class="fa fa-fw fa-ban me-1"/>Cancel Offline24
            </t>
            <t t-else="">
                <i class="fa fa-fw fa-cloud-upload me-1"/>Prepare Offline24
            </t>
        </DropdownItem>
    </t>
</templates>
