<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_th</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices']" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'TH'"/>
            </xpath>
            <xpath expr="//setting[@id='qr_code_invoices']" position="after">
                <setting id="l10n_th_qr_code_invoices" string="PromptPay QR Code" company_dependent="1"
                    help="Add a QR-code to your invoices so that your customers can pay instantly with their mobile banking or e-wallet application."
                    invisible="country_code != 'TH'">
                    <field name="qr_code" class="oe_inline"/>
                </setting>
            </xpath>
            <xpath expr="//block[@id='peppol']" position="after">
                <block title="Thailand e-Tax Invoice" id="l10n_th_edi" invisible="country_code != 'TH'">
                    <setting id="l10n_th_edi_activate_setting"
                             string="e-Tax Invoice"
                             help="Issue e-Tax invoices and submit them to the Revenue Department through INET."
                             documentation="/applications/finance/fiscal_localizations/thailand.html"
                             invisible="module_l10n_th_edi_inet">
                        <button string="Activate INET"
                                type="object"
                                name="action_l10n_th_activate_edi_inet"
                                class="btn btn-primary mt-2"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
