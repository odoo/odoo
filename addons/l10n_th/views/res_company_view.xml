<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_inherit_l10n_th" model="ir.ui.view">
        <field name="model">res.company</field>
        <field name="name">res.company.form.inherit.l10n_th</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <div name="identifiers" position="after">
                <field name="l10n_th_is_vat_registered" string="VAT Registered" invisible="account_fiscal_country_id != %(base.th)d"/>
            </div>
        </field>
    </record>
</odoo>
