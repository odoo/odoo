<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_th_inherit" model="ir.ui.view">
        <field name="name">account.move.form.th.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']" position="after">
               <page id="tax_invoice_tab" string="Tax Invoice" name="tax_invoice"
                     invisible="move_type not in ('out_invoice', 'out_receipt') or country_code != 'TH' or not l10n_th_is_vat_registered or not l10n_th_tax_invoice_ids">
                    <field name="l10n_th_tax_invoice_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="tax_invoice_number"/>
                            <field name="reference"/>
                            <field name="total_amount" sum="Total Amount"/>
                            <field name="vat_amount" sum="Total VAT Amount"/>
                            <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-danger="state == 'cancel'" decoration-info="state == 'draft'" />
                            <button
                                name="action_print_tax_invoice_pdf"
                                type="object"
                                string="Print Tax Invoice"
                                class="btn-link"/>
                        </list>
                    </field>
               </page>
            </xpath>
        </field>
    </record>
</odoo>
