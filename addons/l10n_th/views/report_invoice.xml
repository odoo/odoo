<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//t[@name='address_not_same_as_shipping']//span[@t-field='o.partner_id.vat']" position="after">
            <span t-out="o.partner_id.l10n_th_branch_name"/>
        </xpath>

        <xpath expr="//t[@name='address_same_as_shipping']//span[@t-field='o.partner_id.vat']" position="after">
            <span t-out="o.partner_id.l10n_th_branch_name"/>
        </xpath>
        <xpath expr="//t[@name='no_shipping']//span[@t-field='o.partner_id.vat']" position="after">
            <span t-out="o.partner_id.l10n_th_branch_name"/>
        </xpath>

        <xpath expr="//t[@t-call='account.document_tax_totals']" position="before">
            <t t-foreach="o._l10n_th_get_credit_debit_note_amounts()" t-as="amount_info">
                <tr>
                    <td><span t-out="amount_info['label']"/></td>
                    <td class="text-end">
                        <span
                            t-out="amount_info['amount']"
                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>

    </template>

    <template id="report_tax_invoice_document" inherit_id="l10n_th.report_invoice_document" primary="True">
        <xpath expr="//t[@t-set='layout_document_title']" position="after">
            <t t-set="layout_document_title">
                <t t-out="ti._get_tax_invoice_document_title()"/>
            </t>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <t t-set="lines_to_report" t-value="ti.tax_invoice_lines"/>
            <t t-set="display_discount" t-value="any(l.get('discount') for l in lines_to_report)"/>
            <t t-set="display_taxes" t-value="True"/>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']//tbody" position="replace">
            <tbody class="invoice_tbody">
                <t t-foreach="lines_to_report" t-as="line">
                    <tr>
                        <td class="w-100" name="account_invoice_line_name">
                            <span t-if="line.get('name')"
                                t-out="line.get('name')"/>
                        </td>

                        <td name="td_quantity" class="o_td_quantity text-end">
                            <span t-out="line.get('quantity')"
                                class="text-nowrap"/>
                            <span t-out="line.get('product_uom')"
                                groups="uom.group_uom"/>
                        </td>

                        <td name="td_price_unit"
                            t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span t-out="line.get('price_unit')"
                                class="text-nowrap"/>
                        </td>

                        <td name="td_discount"
                            t-if="display_discount"
                            t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span t-out="line.get('discount')"
                                class="text-nowrap"/>
                        </td>

                        <td name="td_taxes"
                            t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span t-out="line.get('taxes')"/>
                        </td>

                        <td name="td_subtotal" class="text-end o_price_total">
                            <span t-out="line.get('total_amount')"
                                class="text-nowrap"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </xpath>

        <xpath expr="//div[@t-field='o.invoice_date']" position="replace">
            <t t-if="ti.date">
                <div t-out="ti.date" t-options='{"widget": "date"}'/>
            </t>
        </xpath>

        <xpath expr="//div[@name='due_date']" position="attributes">
            <attribute name="t-if">o.invoice_date_due and ti.state == 'posted'</attribute>
        </xpath>

        <xpath expr="//t[@t-call='account.document_tax_totals']" position="replace">
            <t t-set="print_with_payments" t-value="False"/>
            <t t-call="l10n_th.tax_invoice_document_tax_totals"
                currency="o.currency_id"/>
        </xpath>

        <!--
            The invoice template is reused for tax invoices. These sections are not
            required on tax invoices, so they are replaced with an empty div.
        -->
        <xpath expr="//t[@t-call='account.document_tax_totals_company_currency_template']" position="replace">
            <div class="oe_structure"/>
        </xpath>
        <xpath expr="//p[@t-if='o.company_id.display_invoice_amount_total_words']" position="replace">
            <div class="oe_structure"/>
        </xpath>
        <xpath expr="//span[@id='payment_terms_note_id']" position="replace">
            <t t-set="payment_term_details" t-value="False"/>
        </xpath>
        <xpath expr="//div[@id='qrcode']" position="replace">
            <div class="oe_structure"/>
        </xpath>
        <xpath expr="//div[@id='payment_link_qrcode']" position="replace">
            <div class="oe_structure"/>
        </xpath>
    </template>

    <template id="tax_invoice_document_tax_totals">
        <tr class="o_total" t-if="ti.reference">
            <td>
                <i class="oe_form_field text-end oe_payment_label">
                    Paid on
                    <t t-out="ti.date" t-options='{"widget": "date"}'/>
                </i>
            </td>
            <td class="text-end">
                <span
                    t-out="ti.total_amount"
                    t-options='{"widget": "monetary", "display_currency": currency}'
                />
            </td>
        </tr>

        <tr class="o_subtotal">
            <td>Untaxed Amount</td>
            <td class="text-end">
                <span
                    t-out="ti.total_amount - ti.vat_amount"
                    t-options='{"widget": "monetary", "display_currency": currency}'
                />
            </td>
        </tr>

        <t t-foreach="ti.tax_group_amounts" t-as="tax_group">
            <tr class="o_taxes">
                <td>
                    <span t-out="tax_group['group_name']"/>
                </td>
                <td class="text-end">
                    <span
                        t-out="tax_group['amount']"
                        t-options='{"widget": "monetary", "display_currency": currency}'
                    />
                </td>
            </tr>
        </t>

        <tr class="fw-bold o_total">
            <td class="pt-3">
                <t t-out="'Amount Due' if ti.reference else 'Total'"/>
            </td>
            <td class="text-end pt-3">
                <span
                    t-out="ti.amount_residual if ti.reference else ti.total_amount"
                    t-options='{"widget": "monetary", "display_currency": currency}'
                />
            </td>
        </tr>
    </template>

    <template id="company_address_list" inherit_id="web.company_address_list">
        <xpath expr="//li[.//span[@t-field='company.country_id.vat_label']]" position="inside">
            <span t-out="company.partner_id.l10n_th_branch_name" 
                  t-if="company.partner_id.l10n_th_branch_name and company.account_fiscal_country_id.code == 'TH'"/>
        </xpath>
    </template>

    <template id="report_tax_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="ti">
                <t t-set="o" t-value="ti.invoice_move_id"/>
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="l10n_th.report_tax_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_tax_invoice" model="ir.actions.report">
        <field name="name">Tax Invoice</field>
        <field name="model">l10n_th.tax.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_th.report_tax_invoice</field>
        <field name="print_report_name">(object._get_tax_invoice_document_title())</field>
    </record>

    <!-- Workaround for Studio reports, see odoo/odoo#60660 -->
    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'l10n_th.report_invoice_document'"
               t-call="l10n_th.report_invoice_document"
               t-lang="lang"/>
        </xpath>
    </template>
</odoo>
