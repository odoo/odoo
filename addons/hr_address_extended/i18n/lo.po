#. module: hr_address_extended
#: model:ir.module.module,summary:base.module_hr_address_extended
msgid "Centralize employee information"
msgstr "ລວມສູນຂໍ້ມູນພະນັກງານ"

#. module: hr_address_extended
#: model:ir.model.fields,help:hr_address_extended.field_hr_employee__private_country_enforce_cities
#: model:ir.model.fields,help:hr_address_extended.field_hr_version__private_country_enforce_cities
msgid ""
"Check this box to ensure every address created in that country has a 'City' "
"chosen in the list of the country's cities."
msgstr ""
"ໝາຍຕິກໃສ່ຫ້ອງນີ້ ເພື່ອຮັບປະກັນວ່າ ທຸກໆທີ່ຢູ່ທີ່ສ້າງຂຶ້ນໃນປະເທດນັ້ນ ຕ້ອງມີ 'ເມືອງ' ທີ່ຖືກເລືອກຈາກລາຍການເມືອງ"
"ຂອງປະເທດດັ່ງກ່າວ."

#. module: hr_address_extended
#: model_terms:ir.ui.view,arch_db:hr_address_extended.view_employee_form_inherit_address
