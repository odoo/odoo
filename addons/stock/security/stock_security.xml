<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <record id="res_groups_privilege_inventory" model="res.groups.privilege">
            <field name="name">Inventory</field>
            <field name="category_id" ref="base.module_category_supply_chain" />
        </record>
        <record id="group_stock_readonly" model="res.groups">
            <field name="name">Read-only</field>
            <field name="sequence">5</field>
            <field name="privilege_id" ref="res_groups_privilege_inventory" />
            <field
                name="comment">Access to all Inventory data but in read-only mode, no actions allowed.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_stock_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_inventory" />
            <field
                name="implied_ids"
                eval="[Command.link(ref('base.group_user')), Command.link(ref('group_stock_readonly'))]" />
        </record>
        <record id="group_stock_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_inventory" />
            <field name="implied_ids" eval="[Command.link(ref('group_stock_user'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
        <record id="group_stock_multi_locations" model="res.groups">
            <field name="name">Manage Multiple Stock Locations</field>
        </record>
        <record id="group_stock_multi_warehouses" model="res.groups">
            <field name="name">Manage Multiple Warehouses</field>
        </record>
        <record id="group_production_lot" model="res.groups">
            <field name="name">Manage Lots / Serial Numbers</field>
        </record>
        <record id="group_stock_lot_print_gs1" model="res.groups">
            <field name="name">Print GS1 Barcodes for Lot &amp; Serial Numbers</field>
        </record>
        <record id="group_lot_on_delivery_slip" model="res.groups">
            <field name="name">Display Serial &amp; Lot Number in Delivery Slips</field>
        </record>
        <record id="group_tracking_lot" model="res.groups">
            <field name="name">Manage Packages</field>
        </record>
        <record id="group_adv_location" model="res.groups">
            <field name="name">Manage Push and Pull inventory flows</field>
        </record>
        <record id="group_tracking_owner" model="res.groups">
            <field name="name">Manage Different Stock Owners</field>
        </record>
        <record id="group_warning_stock" model="res.groups">
            <field name="name">A warning can be set on a partner (Stock)</field>
        </record>
        <record id="group_stock_sign_delivery" model="res.groups">
            <field name="name">Require a signature on your delivery orders</field>
        </record>
        <record id="group_reception_report" model="res.groups">
            <field name="name">Use Reception Report</field>
        </record>
        <record id="res_groups_privilege_blocked_location" model="res.groups.privilege">
            <field name="name">Unlock Locations</field>
            <field name="category_id" ref="base.module_category_supply_chain" />
        </record>
        <record id="group_force_blocked_location_in" model="res.groups">
            <field name="name">Soft In</field>
            <field name="privilege_id" ref="res_groups_privilege_blocked_location" />
            <field
                name="comment">Allows adding stock to soft-blocked incoming locations (e.g., maintenance areas)</field>
        </record>
        <record id="group_force_blocked_location_out" model="res.groups">
            <field name="name">Soft Out</field>
            <field name="privilege_id" ref="res_groups_privilege_blocked_location" />
            <field
                name="comment">Allows removing stock from soft-blocked outgoing locations (e.g., quarantine, quality hold)</field>
        </record>
        <record id="group_force_blocked_location_both" model="res.groups">
            <field name="name">Soft Both</field>
            <field name="privilege_id" ref="res_groups_privilege_blocked_location" />
            <field
                name="comment">Allows operations on soft-blocked locations in both directions</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_force_blocked_location_in')), Command.link(ref('group_force_blocked_location_out'))]" />
        </record>
        <record id="group_override_hard_block" model="res.groups">
            <field name="name">All (Hard)</field>
            <field name="privilege_id" ref="res_groups_privilege_blocked_location" />
            <field
                name="comment">Allows ALL operations on hard-blocked locations (inventory counts, audits, legal holds). Requires highest authorization level.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_force_blocked_location_both'))]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="stock_picking_rule" model="ir.rule">
            <field name="name">stock_picking multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.picking')]" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_picking_type_rule" model="ir.rule">
            <field name="name">Stock Operation Type multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.picking.type')]" />
            <field name="domain_force">[('company_id','in', company_ids)]</field>
        </record>
        <record id="stock_picking_batch_rule" model="ir.rule">
            <field name="name">Stock Picking Batch multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.picking.batch')]" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_putaway_rule_rule" model="ir.rule">
            <field name="name">Putaway Rule multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.putaway.rule')]" />
            <field name="domain_force">[('company_id','in', company_ids)]</field>
        </record>
        <record id="stock_production_lot_rule" model="ir.rule">
            <field name="name">Stock Production Lot multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.lot')]" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_warehouse_comp_rule" model="ir.rule">
            <field name="name">Warehouse multi-company</field>
            <field name="model_id" ref="model_stock_warehouse" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_location_comp_rule" model="ir.rule">
            <field name="name">Location multi-company</field>
            <field name="model_id" ref="model_stock_location" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_move_rule" model="ir.rule">
            <field name="name">stock_move multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.move')]" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_move_line_rule" model="ir.rule">
            <field name="name">stock_move_line multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.move.line')]" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_reference_comp_rule" model="ir.rule">
            <field name="name">stock_reference multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.reference')]" />
            <field
                name="domain_force">['|', ('move_ids', '=', False), ('move_ids.company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_quant_rule" model="ir.rule">
            <field name="name">stock_quant multi-company</field>
            <field name="model_id" ref="model_stock_quant" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_warehouse_orderpoint_rule" model="ir.rule">
            <field name="name">stock_warehouse.orderpoint multi-company</field>
            <field
                name="model_id"
                model="ir.model"
                search="[('model','=','stock.warehouse.orderpoint')]" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="product_pulled_flow_comp_rule" model="ir.rule">
            <field name="name">product_pulled_flow multi-company</field>
            <field name="model_id" ref="model_stock_rule" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_location_route_comp_rule" model="ir.rule">
            <field name="name">stock_route multi-company</field>
            <field name="model_id" ref="model_stock_route" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_package_comp_rule" model="ir.rule">
            <field name="name">stock_package multi-company</field>
            <field name="model_id" ref="model_stock_package" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_package_history_comp_rule" model="ir.rule">
            <field name="name">stock_package_history multi-company</field>
            <field name="model_id" ref="model_stock_package_history" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_scrap_company_rule" model="ir.rule">
            <field name="name">stock_scrap_company multi-company</field>
            <field name="model_id" ref="model_stock_scrap" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!--
            Lost in 114e90fadbd3, which moved stock.picking.batch into this
            module: that commit carried the model's ACL line across and left
            its multi-company rule behind in the deleted
            stock_picking_batch/security/stock_picking_batch_security.xml.
            Measured before restoring it: a stock user of company A could
            search and read company B's batch transfers, while the same query
            for stock.picking was correctly filtered.
        -->
        <record id="stock_picking_batch_comp_rule" model="ir.rule">
            <field name="name">stock_picking_batch multi-company</field>
            <field name="model_id" ref="model_stock_picking_batch" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="report_stock_quantity_flow_comp_rule" model="ir.rule">
            <field name="name">report_stock_quantity_flow multi-company</field>
            <field name="model_id" ref="model_report_stock_quantity" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_storage_category_rule" model="ir.rule">
            <field name="name">stock_storage_category multi-company</field>
            <field name="model_id" ref="model_stock_storage_category" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_package_type_comp_rule" model="ir.rule">
            <field name="name">stock_package_type multi-company</field>
            <field name="model_id" ref="model_stock_package_type" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="stock_storage_category_capacity_comp_rule" model="ir.rule">
            <field name="name">stock_storage_category_capacity multi-company</field>
            <field name="model_id" ref="model_stock_storage_category_capacity" />
            <field
                name="domain_force">[('storage_category_id.company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>

</odoo>
