<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <div t-name="stock.Forecasted" class="o_action o_stock_forecast">
        <ControlPanel>
            <t t-set-slot="control-panel-buttons">
                <ForecastedButtons action="this.props.action" reloadReport.bind="this.reloadReport" resModel="this.resModel"/>
            </t>
            <t t-set-slot="control-panel-navigation-additional">
                <Dropdown t-if="this.docs.multiple_product" items="this.variantItems">
                    <button class="btn btn-secondary text-truncate" style="max-width: 30ch">
                        <span class="oi" data-icon="account_tree" /> Variant: <t
                            t-out="this.activeVariantName" />
                    </button>
                </Dropdown>
                <Dropdown t-if="this.docs.multiple_warehouses" items="this.warehousesItems">
                    <button class="btn btn-secondary text-truncate" style="max-width: 30ch">
                        <span class="oi" data-icon="home" /> Warehouse: <t t-out="this.activeWarehouseName"/>
                    </button>
                </Dropdown>
            </t>
        </ControlPanel>
        <div class="o-content pt-3 container-fluid overflow-auto o_stock_forecasted_page">
            <ForecastedHeader docs="this.filteredDocs" openView.bind="this.openView"/>
            <View type="'graph'"
                viewId="this.stock_report_view_graph"
                resModel="'report.stock.quantity'"
                domain="this.graphDomain"
                display="{controlPanel: false}"
                context="{fill_temporal: false}"
                info="this.graphInfo"
                useSampleModel="true"/>
            <ForecastedDetails docs="this.filteredDocs" openView.bind="this.openView"
                reloadReport.bind="this.reloadReport"/>
        </div>
    </div>
</templates>
