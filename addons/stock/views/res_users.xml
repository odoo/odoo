<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_warehouse" model="ir.ui.view">
        <field name="name">res.users.form.inherit.warehouse</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='odoobot_state']" position="after">
                <field name="allowed_picking_type_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>