<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_orderpoint_suggest_form" model="ir.ui.view">
        <field name="name">Suggest Min-Max</field>
        <field name="model">stock.orderpoint.suggest</field>
        <field name="arch" type="xml">
            <form string="Suggest Min-Max">
                <h5>Based on average daily demands from</h5>
                <group>
                    <div class="mb8">
                        <field name="based_on" class="oe_inline" widget="time_period_selection"/> X
                        <field name="percent_factor" class="text-end oe_inline"/> %
                    </div>
                </group>
                <div class="alert alert-info" role="alert">Minimum days of coverage and order frequency to be achieved by Min and Max stock levels must first be defined for each product.</div>
                <footer>
                    <button name="action_apply" string="Update" type="object" class="btn-primary" data-hotkey="q"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_orderpoint_suggest" model="ir.actions.act_window">
        <field name="name">Suggest Min-Max</field>
        <field name="res_model">stock.orderpoint.suggest</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
