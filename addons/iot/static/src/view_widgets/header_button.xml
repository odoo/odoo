<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="iot.HeaderButton">
        <button type="button"
                t-att-class="'btn btn-' + this.props.btn_class"
                t-att-data-tooltip="this.props.btn_name"
                t-att-aria-label="this.props.btn_name"
                t-on-click.stop="this.onClick">
            <t t-out='this.props.btn_name'/>
        </button>
    </t>

</templates>
