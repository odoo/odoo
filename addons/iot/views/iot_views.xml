<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Actions -->
    <record id="action_iot_delete_linked_devices_menu" model="ir.actions.client">
        <field name="name">reset.linked.printers</field>
        <field name="tag">iot_delete_linked_devices_action</field>
    </record>

    <record id="action_discover_iot_boxes" model="ir.actions.client">
        <field name="name">Discover IoT boxes</field>
        <field name="tag">discover_iot_boxes</field>
    </record>

    <!-- IoT Boxes -->
    <record id="iot_box_view_form" model="ir.ui.view">
        <field name="name">iot.box.view.form</field>
        <field name="model">iot.box</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <widget
                        name="test_iot_box"
                        invisible="not version or 'W' in version"
                        btn_class="primary"
                        btn_name="Test" />
                    <button
                        name="open_homepage"
                        type="object"
                        string="Homepage"
                        class="btn btn-secondary" />
                    <t groups="base.group_no_one">
                        <widget
                            name="iot_download_logs"
                            btn_class="secondary"
                            btn_name="Download Logs" />
                        <widget
                            name="iot_restart_odoo"
                            btn_class="secondary"
                            btn_name="Restart Odoo" />
                        <widget
                            name="iot_reset_password"
                            groups="iot.group_iot_admin"
                            invisible="not version or 'W' in version"
                            btn_class="secondary"
                            btn_name="Reset Password" />
                        <widget
                            name="iot_remote_debug"
                            groups="iot.group_iot_admin"
                            invisible="not version or 'W' in version"
                            btn_class="secondary"
                            btn_name="Remote Debug" />
                    </t>
                </header>
                <sheet>
                    <div
                        class="alert alert-warning d-flex align-items-center"
                        role="alert"
                        invisible="not must_install_fdm_module">
                        <span>
                            A fiscal data module has been connected. To use it,
                            <a class="alert-link text-decoration-underline" type="object" name="install_fdm_module">install the Fiscal Data Module</a>
                            app.
                        </span>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="identifier" readonly="True" />
                            <field
                                name="company_id"
                                placeholder="Visible to all"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page name="devices" string="Devices">
                            <field
                                name="device_ids"
                                widget="device_list_field"
                                readonly="False">
                                <list default_order="connection, name">
                                    <field name="name" />
                                    <field name="identifier" />
                                    <field name="type" />
                                    <field name="connection" />
                                    <field name="connected_status" string="Status" />
                                </list>
                            </field>
                        </page>
                        <page string="Technical Information" groups="base.group_no_one">
                            <group>
                                <field name="ip" />
                                <field
                                    name="version_commit_url"
                                    string="Image Version" />
                                <field name="drivers_auto_update" />
                                <field
                                    name="ssl_certificate_end_date"
                                    invisible="not ssl_certificate_end_date" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="iot_box_view_kanban" model="ir.ui.view">
        <field name="name">iot.box.view.kanban</field>
        <field name="model">iot.box</field>
        <field name="arch" type="xml">
            <kanban create="false">
                <header>
                    <button
                        name="iot.action_discover_iot_boxes"
                        type="action"
                        string="Connect"
                        display="always"
                        groups="iot.group_iot_admin"
                        class="btn-primary o-kanban-button-new" />
                </header>
                <templates>
                    <t t-name="card" class="p-0">
                        <div
                            id="card"
                            class="p-3 d-flex flex-column justify-content-between">
                            <div
                                class="text-truncate fw-bold d-flex align-items-center justify-content-between"
                                t-att-title="record.name.raw_value">
                                <field name="name" />
                                <span class="float-end"><field name="device_count" /> <i t-attf-class="fa-solid fa-plug" title="device-icon" /></span>
                            </div>
                            <field
                                name="create_date"
                                widget="datetime"
                                options="{'show_time': false}"
                                class="fs-6 pb-2" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="iot_box_view_list" model="ir.ui.view">
        <field name="name">iot.box.view.list</field>
        <field name="model">iot.box</field>
        <field name="arch" type="xml">
            <list create="false">
                <header>
                    <button
                        name="iot.action_discover_iot_boxes"
                        type="action"
                        string="Connect"
                        display="always"
                        groups="iot.group_iot_admin"
                        class="btn-primary" />
                </header>
                <field name="name" />
                <field name="identifier" />
            </list>
        </field>
    </record>

    <record id="iot_box_action" model="ir.actions.act_window">
        <field name="name">IoT Boxes</field>
        <field name="res_model">iot.box</field>
        <field name="path">iot</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No IoT Box found!
            </p><p>
                Click on the 
                <a name="connect_iot_box" type="object" tabindex="-1">connect</a>
                    to add an IoT Box.
            </p>
        </field>
    </record>

    <!-- IoT Devices -->
    <record id="iot_device_view_form" model="ir.ui.view">
        <field name="name">iot.device.view.form</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <form create="false" js_class="iot_device_form">
                <header>
                    <button
                        name="test_device"
                        string="Test"
                        invisible="type not in ['printer', 'fiscal_data_module']"
                        class="btn btn-primary" />
                    <field name="connected_status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group name="iot_device_details">
                        <group>
                            <field name="iot_id" readonly="True" />
                            <field name="identifier" readonly="True" />
                            <field name="connection" />
                            <field
                                name="is_scanner"
                                widget="boolean_toggle"
                                invisible="type not in ['keyboard', 'scanner']" />
                            <field name="manufacturer" invisible="manufacturer == ''" />
                            <field
                                name="keyboard_layout"
                                invisible="type not in ['keyboard', 'scanner']" />
                            <field name="display_url" invisible="type != 'display'" />
                        </group>
                        <group>
                            <field name="type" />
                            <field name="subtype" invisible="type != 'printer'" />
                        </group>
                    </group>
                    <notebook>
                        <page
                            name="reports"
                            string="Reports to Auto-Print"
                            invisible="type != 'printer'">
                            <field
                                name="report_ids"
                                widget="many2many"
                                context="{'list_view_ref': 'iot.act_report_xml_view_tree_iot'}" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="iot_device_view_kanban" model="ir.ui.view">
        <field name="name">iot.device.view.kanban</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <kanban
                default_order="type"
                default_group_by="iot_id"
                create="false"
                sample="1"
                group_create="false">
                <field name="type" />
                <field name="connection" />
                <field name="connected_status" />
                <templates>
                    <t t-name="card" class="row g-0 p-0">
                        <aside class="col-3 text-center align-self-center">
                            <t
                                t-set="types"
                                t-value="{'camera': 'camera', 'printer': 'printer', 'device': 'rulers', 'payment': 'payment-terminal', 'scale': 'scales', 'keyboard': 'keyboard', 'scanner': 'barcode-scanner', 'display': 'desktop', 'fiscal_data_module': 'fdm', 'unsupported': 'unsupported'}" />
                            <img
                                t-attf-src="/iot/static/src/img/#{types[record.type.raw_value]}.svg"
                                t-attf-alt="Device type is #{record.type.raw_value}"
                                class="w-50" />
                        </aside>
                        <main class="col p-2 border-start">
                            <div
                                class="text-truncate fw-bold d-flex align-items-center justify-content-between"
                                t-att-title="record.name.raw_value">
                                <field name="name" class="text-truncate" />
                                <i
                                    class="fa-solid fa-circle text-success"
                                    t-if="record.connected_status.raw_value == 'connected'" />
                                <i class="fa-solid fa-circle text-danger" t-else="" />
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <t
                                    t-set="connections"
                                    t-value="{'network': 'fa-solid fa-wifi', 'direct': 'fa-brands fa-usb', 'bluetooth': 'fa-brands fa-bluetooth-b', 'serial': 'fa-brands fa-usb', 'hdmi': 'fa-brands fa-usb'}" />
                                <i
                                    t-attf-class="#{connections[record.connection.raw_value]} fa-fw"
                                    title="connection_type" />
                                <field
                                    name="iot_id"
                                    readonly="1"
                                    class="text-truncate" />
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="iot_device_view_list" model="ir.ui.view">
        <field name="name">iot.device.view.list</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <list default_order="type" create="false">
                <field name="name" />
                <field name="iot_id" />
                <field name="identifier" />
                <field name="connected_status" />
            </list>
        </field>
    </record>

    <record id="iot_device_search" model="ir.ui.view">
        <field name="name">iot.device.view.search</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <search string="IoT Device">
                <field name="name" />
                <field name="type" />
                <field name="iot_id" />
                <group>
                    <filter
                        name="group_by_connection"
                        string="Connection"
                        context="{'group_by':'connection'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="iot_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">iot.device</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_iot_id': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                There is no device connected to your IoT Boxes
            </p>
        </field>
    </record>

    <!-- ir.action.report add the device -->
    <record id="act_report_xml_view_iot" model="ir.ui.view">
        <field name="name">ir.actions.report.iot</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <field name="report_type" position="after">
                <field name="device_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="act_report_xml_view_tree_iot" model="ir.ui.view">
        <field name="name">ir.actions.report.list.iot</field>
        <field name="model">ir.actions.report</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Report xml">
                <field name="name" />
                <field name="model" />
                <field name="report_type" />
            </list>
        </field>
    </record>

</odoo>
