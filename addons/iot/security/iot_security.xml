<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_iot" model="res.groups.privilege">
        <field name="name">IoT</field>
        <field name="description">Configure IoT boxes and devices.</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_productivity" />
    </record>

    <record id="group_iot_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_iot" />
    </record>

    <record id="group_iot_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_iot" />
        <field name="implied_ids" eval="[Command.link(ref('group_iot_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
