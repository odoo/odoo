<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_link_wizard_view_form" model="ir.ui.view">
        <field name="name">payment.link.wizard.form</field>
        <field name="model">payment.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payment Link">
                <div name="no_partner_email"
                     class="alert alert-warning fw-bold"
                     role="alert"
                     invisible="partner_email">
                     This partner has no email, which may cause issues with some payment providers.
                     Setting an email for this partner is advised.
                </div>
                <div name="payment_link_warning_information"
                     class="alert alert-warning fw-bold"
                     role="alert"
                     invisible="warning_message == ''">
                    <field name="warning_message"/>
                </div>
                <group>
                    <group name="payment_info">
                        <field name="res_id" invisible="1"/> <!-- Required technical field feeding the link/company/warning computes; set from context in default_get -->
                        <field name="res_model" invisible="1"/> <!-- Required technical field feeding the link/company/warning computes; set from context in default_get -->
                        <field name="partner_id" invisible="1"/> <!-- Drives the partner_email related field and is a dependency of the _compute_link -->
                        <field name="partner_email" invisible="1"/> <!-- Related to partner_id; drives the no_partner_email warning banner modifier above -->
                        <field name="amount"/>
                        <field name="warning_message" invisible="1"/> <!-- Shown via the warning banner div above; also drives the link button disabled modifier -->
                        <field name="currency_id" invisible="1"/> <!-- currency_field for the monetary amount; needed to render its currency -->
                    </group>
                </group>
                <footer>
                    <field name="link"
                           string="Generate and Copy Payment Link"
                           readonly="1"
                           disabled="not amount or bool(warning_message)"
                           widget="PaymentWizardCopyClipboardButtonField"
                           data-hotkey="q"/>
                    <button string="Close"
                            class="btn btn-secondary rounded-2"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
