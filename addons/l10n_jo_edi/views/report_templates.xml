<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every layout gets the hook, so the watermark keeps its place next to the logo whichever one the company picks -->
    <template id="l10n_jo_edi_external_layout_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//img" position="after">
            <t t-if="custom_header_jo" t-out="custom_header_jo"/>
        </xpath>
    </template>
