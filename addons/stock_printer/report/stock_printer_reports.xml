<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- These reports print the attachments the carriers save in the chatter
         of the transfers: they have no template. -->
    <record id="action_report_shipping_labels" model="ir.actions.report">
        <field name="name">Shipping Labels</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_printer.report_shipping_labels</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_shipping_documents" model="ir.actions.report">
        <field name="name">Shipping Documents</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_printer.report_shipping_documents</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
