<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_partner_score_recompute" model="ir.actions.server">
        <field name="name">Recompute Partner Score</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">list,form</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('partner_scoring.group_partner_scoring_manager'))]" />
        <field name="state">code</field>
        <field name="code">action = records.action_score_refresh()</field>
    </record>

</odoo>
