<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_inherit_scoring" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.partner.scoring</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='anchor_intelligence']" position="before">
                <page name="partner_scoring" string="Scoring">
                    <field name="commercial_partner_id" invisible="1" />
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="commercial_partner_id == id">
                        Scoring is managed on the commercial entity:
                        <field
                            name="commercial_partner_id"
                            nolabel="1"
                            readonly="1"
                            class="oe_inline" />
                    </div>
                    <div invisible="commercial_partner_id != id">
                        <group name="scoring_columns">
                            <group
                                name="scoring_classification"
                                string="Commercial Classification">
                                <field name="tier_id" readonly="1" />
                                <field name="factor" readonly="1" />
                                <field name="score_line_count" invisible="1" />
                                <label for="score" />
                                <div class="o_row">
                                    <field
                                        name="score"
                                        readonly="1"
                                        class="oe_inline"
                                        style="max-width: 7rem;" />
                                    <button
                                        name="%(partner_scoring.action_partner_score_line_from_partner)d"
                                        type="action"
                                        string="View breakdown"
                                        icon="fa-bar-chart"
                                        invisible="not score_line_count"
                                        class="btn btn-link p-0" />
                                </div>
                            </group>
                        </group>
                        <div
                            class="mb-2"
                            groups="partner_scoring.group_partner_scoring_manager">
                            <div class="d-flex align-items-center gap-2">
                                <label
                                    for="score_date"
                                    string="Last calculated on"
                                    class="text-muted" />
                                <field
                                    name="score_date"
                                    nolabel="1"
                                    readonly="1"
                                    class="oe_inline" />
                                <button
                                    name="action_score_refresh"
                                    type="object"
                                    string="Recompute now"
                                    icon="fa-refresh"
                                    class="btn btn-link p-0" />
                            </div>
                            <div
                                class="text-muted fst-italic"
                                style="font-size: 0.85em;">
                                Catalog weight changes are applied asynchronously — click
                                "Recompute now" for an immediate refresh.
                            </div>
                        </div>
                        <group name="scoring_intelligence" />
                        <separator
                            name="scoring_attributes_separator"
                            string="Profile Attributes" />
                        <field name="attribute_line_ids">
                            <list editable="bottom">
                                <field name="attribute_id" />
                                <field
                                    name="value_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color', 'no_create': True}" />
                            </list>
                        </field>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
