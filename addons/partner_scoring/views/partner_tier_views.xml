<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_tier_view_search" model="ir.ui.view">
        <field name="name">partner.tier.search</field>
        <field name="model">partner.tier</field>
        <field name="arch" type="xml">
            <search string="Search Commercial Tier">
                <field name="name" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="inactive"
                    string="Inactive"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by': 'company_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="partner_tier_view_list" model="ir.ui.view">
        <field name="name">partner.tier.list</field>
        <field name="model">partner.tier</field>
        <field name="arch" type="xml">
            <list string="Commercial Tiers" multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="min_value" />
                <field name="max_value" />
                <field name="factor" widget="percentage" />
                <field name="active" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="partner_tier_view_form" model="ir.ui.view">
        <field name="name">partner.tier.form</field>
        <field name="model">partner.tier</field>
        <field name="arch" type="xml">
            <form string="Commercial Tier">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tier Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Score range (%)">
                            <field name="min_value" />
                            <field name="max_value" />
                            <field
                                name="factor"
                                help="Multiplier applied to sale.target metas for partners in this tier."
                                widget="percentage" />
                        </group>
                        <group string="Settings">
                            <field name="sequence" />
                            <field name="active" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_tier_action" model="ir.actions.act_window">
        <field name="name">Commercial Tiers</field>
        <field name="res_model">partner.tier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="partner_tier_view_search" />
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new commercial tier
            </p>
            <p>
                Tiers classify customers by their normalized score percentage
                and apply a factor to expected revenues and commercial targets.
            </p>
        </field>
    </record>

</odoo>
