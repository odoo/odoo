<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_score_line_view_list" model="ir.ui.view">
        <field name="name">partner.score.line.list</field>
        <field name="model">partner.score.line</field>
        <field name="arch" type="xml">
            <list string="Score Breakdown" create="0" edit="0" delete="0">
                <field name="dimension_id" />
                <field name="value" optional="hide" />
                <field name="source_ref" />
                <field name="points" sum="Total" />
                <field name="max_points" sum="Total" />
                <field name="applied" />
                <field name="applicable" optional="hide" />
                <field name="note" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_partner_score_line_from_partner" model="ir.actions.act_window">
        <field name="name">Score Breakdown</field>
        <field name="res_model">partner.score.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="partner_score_line_view_list" />
        <field name="domain">[('subject_id', '=', active_id)]</field>
        <field name="context">{'default_subject_id': active_id}</field>
    </record>

</odoo>
