<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_pt_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Add tax exemption reason codes to each line with an exempt tax -->
        <xpath expr="//Orderline" position="inside">
            <t t-out="line.l10nPtTaxExemptionCodes()"/>
        </xpath>
        <!-- Add summary of tax exemption reasons below order total -->
        <xpath expr="//div[hasclass('paymentlines')]" position="after">
            <t t-if="order.isPortugueseCompany()">
                <t t-set="pt_tax_exemption_mentions" t-value="order.l10nPtTaxExemptionMentions()"/>
                <t t-if="pt_tax_exemption_mentions.length">
                    <div class="pos-receipt-center-align">--------------------------------</div>
                    <div class="rounded-3 bg-white overflow-hidden pb-2">
                        <span class="fw-bolder text-nowrap mw-100">Motivos de isenção de IVA:</span>
                        <t t-foreach="pt_tax_exemption_mentions" t-as="mention" t-key="mention_index">
                            <div t-out="mention"/>
                        </t>
                    </div>
                </t>
            </t>
        </xpath>
        <!-- A PT till sale is invoiced before its receipt prints: the receipt is the invoice, which the
             customer cannot have reissued from the portal, and the AT's QR code is the only one -->
        <!-- Wrap rather than rewrite the block's t-if: other localisations locate it by that t-if -->
        <xpath expr="//div[hasclass('pos-receipt-qr')]" position="replace">
            <t t-if="!order.isPortugueseCompany()">$0</t>
        </xpath>
        <!-- Add Portuguese disclaimers and information mandatory for the certification (software number, QR code, ATCUD) -->
        <xpath expr="//div[hasclass('before-footer')]" position="inside">
            <div t-if="order.isPortugueseCompany()" class="pos-receipt-center-align mt-2">
                <t t-if="order.l10nPtPosInalterableHashShort">
                    <div t-if="order.l10nPtIsReprint" class="pos-receipt-order-data">2ª Via</div>
                    <div t-else="" class="pos-receipt-order-data">Original</div>
                </t>
                <div t-if="order.l10nPtTrainingMode" class="pos-receipt-order-data">
                    Documento emitido para fins de Formação
                </div>
                <t t-if="!order.l10nPtPosInalterableHashShort">
                    <div class="pos-receipt-order-data">
                        Este documento não serve de fatura
                    </div>
                    <div class="pos-receipt-order-data">
                        Emitido por programa certificado n.º <t t-out="order.session._l10n_pt_certification_number"/>/AT
                    </div>
                </t>
                <t t-else="">
                    <div class="pos-receipt-order-data">
                        ATCUD:<t t-out="order.l10nPtPosAtcud"/>
                    </div>
                    <!-- 60% of an 80 mm roll's printable width: a code of 30 mm or more, as the AT asks -->
                    <img t-att-src="order.l10nPtPosQrCodeImage" class="d-block mx-auto my-2" style="width: 60%;"/>
                    <div class="pos-receipt-order-data">
                        <t t-out="order.l10nPtPosInalterableHashShort"/>-Processado por programa certificado n.º <t t-out="order.session._l10n_pt_certification_number"/>/AT
                    </div>
                </t>
            </div>
        </xpath>
        <!-- In training mode, show the software developer (Odoo) data instead of the company's -->
        <xpath expr="//div[hasclass('d-flex') and hasclass('gap-2') and hasclass('pt-3')][.//div[hasclass('pos-config-name')]]" position="replace">
            <t t-if="order.l10nPtTrainingMode">
                <div class="text-start" style="font-size: 75%;">
                    <div>Odoo</div>
                    <div>Chaussée de Namur 40</div>
                    <div>1367 Ramillies</div>
                    <div>Belgium</div>
                </div>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
