<?xml version="1.0" encoding="UTF-8" ?>
<odoo><data>

    <record id="chatbot_script_view_form" model="ir.ui.view">
        <field name="name">chatbot.script.view.form.inherit.website.livechat</field>
        <field name="model">chatbot.script</field>
        <field name="inherit_id" ref="im_livechat.chatbot_script_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_test_script" type="object" class="btn btn-secondary" string="Test"
                    invisible="not active or not script_step_ids"/>
            </xpath>
        </field>
    </record>

    <record id="chatbot_script_step_view_form" model="ir.ui.view">
        <field name="name">chatbot.script.step.view.form.inherit.website.livechat</field>
        <field name="model">chatbot.script.step</field>
        <field name="inherit_id" ref="im_livechat.chatbot_script_step_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='answer_ids']/list/field[@name='redirect_link']" position="attributes">
                <attribute name="invisible">redirect_record_ref</attribute>
            </xpath>
            <xpath expr="//field[@name='answer_ids']/list/field[@name='redirect_link']" position="after">
                <field name="redirect_record_ref" string="Optional Page" invisible="redirect_link" width="[300px]"/>
            </xpath>
        </field>
    </record>

    <record id="chatbot_script_answer_view_tree" model="ir.ui.view">
        <field name="name">chatbot.script.answer.view.list.inherit.website.livechat</field>
        <field name="model">chatbot.script.answer</field>
        <field name="inherit_id" ref="im_livechat.chatbot_script_answer_view_tree"/>
        <field name="arch" type="xml">
            <field name="redirect_link" position="attributes">
                <attribute name="invisible">redirect_record_ref</attribute>
            </field>
            <field name="redirect_link" position="after">
                <field name="redirect_record_ref" string="Optional Page" invisible="redirect_link" width="[300px]"/>
            </field>
        </field>
    </record>

</data></odoo>
