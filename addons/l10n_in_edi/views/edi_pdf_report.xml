<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="l10n_in_einvoice_report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <t t-set="l10n_in_einvoice_json" t-value="o._get_l10n_in_edi_response_json()"/>
            <div class="col" t-if="l10n_in_einvoice_json" name="ack_no">
                <strong>Acknowledgement</strong>
                <div t-out="l10n_in_einvoice_json['AckNo']"/>
                <div t-out="l10n_in_einvoice_json['AckDt']"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="l10n_in_einvoice_json" t-value="o._get_l10n_in_edi_response_json()"/>
            <div name="l10n_in_einvoice_details" class="row border p-2 mb-3 avoid-page-break-inside" t-if="l10n_in_einvoice_json">
                <div class="col-9 align-self-center">
                    <strong class="d-block mb-1">Invoice Reference Number (IRN)</strong>
                    <span style="word-break: break-all; font-size: 11px;" t-out="l10n_in_einvoice_json['Irn']"/>
                </div>
                <div class="col-3 text-end">
                    <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' %('QR', l10n_in_einvoice_json['SignedQRCode'], 500, 500, 0)" style="width: 90px; height: 90px;" alt="E-invoice QR code"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
