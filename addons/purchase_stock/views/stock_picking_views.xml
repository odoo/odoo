<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="purchase_help_message_template" inherit_id="stock.help_message_template">
        <xpath expr="//p[@name='top_help_message']/t[@name='receipt_message']" position="replace">
            <t t-if="picking_type_code == 'incoming'">
                No receipt yet! Automate them with purchase orders.
            </t>
        </xpath>
        <xpath expr="//p[@name='bottom_help_message']" position="after">
            <a t-if="picking_type_code == 'incoming'" class="btn btn-secondary" name="purchase.purchase_form_action" type="action" groups="purchase.group_purchase_user">Purchase Orders</a>
        </xpath>
    </template>
    <record model="ir.ui.view" id="view_picking_form">
        <field name="name">purchase.stock.view.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_return']" position="attributes">
                <attribute name="invisible">not show_return or not (state == 'done' or purchase_id)</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_request_freight_quotation" model="ir.actions.server">
        <field name="name">Request Freight Quotation</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_request_freight_quotation()
        </field>
    </record>
</odoo>
