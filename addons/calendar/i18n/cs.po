"                    <t t-if=\"not object.allday\"> <t t-out=\"format_time(time=object.start, tz=mail_tz, time_format='short', lang_code=object.env.lang) or ''\"> 8:00</t>\n"
"                        <t t-if=\"not object.appointment_type_id.hide_timezone and mail_tz\"> <span style=\"font-size: 11px; font-weight: normal;\"> (<t t-out=\"mail_tz\"/>)\n"
"                           </span>\n"
"                        </t> \n"
"                   </t>\n"
"                </td> \n"
"           </tr>\n"
"            <tr t-if=\"recurrent\"> \n"
"               <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\"> Kdy</td>\n"
"                <td style=\"padding-top: 6px;\"><t t-out=\"object.recurrence_id.name or ''\"> Každý 1 týden, pro 3 události</t></td> </tr>\n"
"            <tr t-if=\"not object.appointment_type_id.hide_duration and not object.allday and object.duration\" style=\"padding-top: 6px;\"> <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\"> Doba trvání</td>\n"
