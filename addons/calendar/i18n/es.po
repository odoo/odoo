"        <a t-attf-href=\"/odoo/calendar.event/{{ object.id }}\" t-attf-style=\"display: inline-block; margin-left: 12px; padding: 7px 14px; color: #111827; text-decoration: none; background-color: #E7E9ED; border-radius: 3px;\">\n"
"            Ver</a>\n"
"    </div>\n"
"    <div style=\"margin: 16px 0 0;\">\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Información</h2>\n"
"        <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size: 13px; color: #374151;\">\n"
"            <tr>\n"
"                <td style=\"width: 100px; color: #676F7B;\">Fecha y hora</td>\n"
"                <td style=\"font-weight: bold;\">\n"
"                    <t t-out=\"format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='EEEE', lang_code=object.env.lang) or ''\">miércoles</t>\n"
"                    <t t-out=\"format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='d', lang_code=object.env.lang) or ''\">1</t>\n"
"                    <t t-out=\"format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='MMMM y', lang_code=object.env.lang) or ''\">de enero de 2020</t>\n"
"                    <t t-if=\"not object.allday\">\n"
"                        <t t-out=\"format_time(time=object.start, tz=mail_tz, time_format='short', lang_code=object.env.lang) or ''\">8:00 h</t>\n"
"                        <t t-if=\"not object.appointment_type_id.hide_timezone and mail_tz\">\n"
"                            <span style=\"font-size: 11px; font-weight: normal;\">\n"
"                                (<t t-out=\"mail_tz\"/>)\n"
"                            </span>\n"
"                        </t>\n"
"                    </t>\n"
"                </td>\n"
"            </tr>\n"
"            <tr t-if=\"recurrent\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">Cuándo</td>\n"
"                <td style=\"padding-top: 6px;\"><t t-out=\"object.recurrence_id.name or ''\">semanalmente, 3 eventos</t></td>\n"
"            </tr>\n"
"            <tr t-if=\"not object.appointment_type_id.hide_duration and not object.allday and object.duration\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">Duración</td>\n"
"                <td style=\"padding-top: 6px;\"><t t-out=\"('%dH%02d' % (object.duration,round(object.duration*60)%60)) or ''\">0 h 30 minutos</t></td>\n"
"            </tr>\n"
"            <tr t-if=\"object.location\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B; vertical-align: top;\">Ubicación</td>\n"
"                <td style=\"padding-top: 6px;\">\n"
"                    <t t-out=\"object.location or ''\">Bruselas</t>\n"
"                    <a target=\"_blank\" t-if=\"object.location != object.appointment_type_id.location_id.name\" t-attf-href=\"http://maps.google.com/maps?oi=map&amp;q={{ object.location }}\" style=\"margin-left: 12px; font-size: 12px; color: #008f8c; text-decoration: underline;\">Ver en el mapa</a>\n"
"                </td>\n"
"            </tr>\n"
"            <tr t-if=\"object.appointment_type_id.manage_capacity\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">Para</td>\n"
"                <td style=\"padding-top: 6px;\"><t t-out=\"object.total_capacity_reserved\"/> personas</td>\n"
"            </tr>\n"
"            <tr t-if=\"not object.appointment_type_id.is_auto_assign and object.appointment_resource_ids\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B; vertical-align: top;\">Recursos</td>\n"
"                <td style=\"padding-top: 6px;\">\n"
"                    <ul style=\"padding: 0 15px;\">\n"
"                        <li t-foreach=\"object.appointment_resource_ids\" t-as=\"resource\">\n"
"                            <span style=\"margin-left:5px\" t-out=\"resource.name or ''\">Mesa 1</span>\n"
"                        </li>\n"
"                    </ul>\n"
"                </td>\n"
"            </tr>\n"
"            <tr t-if=\"object.videocall_redirection\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">\n"
"                    <t t-if=\"object.videocall_source == 'discuss'\">Unirse con</t>\n"
"                    <t t-else=\"\">Unirse</t>\n"
"                </td>\n"
"                <td style=\"padding-top: 6px;\">\n"
"                    <a t-attf-href=\"{{ object.videocall_redirection }}\" target=\"_blank\" style=\"color: #008f8c;\">\n"
"                        <t t-if=\"object.videocall_source == 'discuss'\">Conversaciones de Odoo</t>\n"
"                        <t t-else=\"\">Videollamada</t>\n"
"                    </a>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"    </div>\n"
"    <div style=\"margin: 32px 0 0;\">\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Participantes</h2>\n"
"        <div t-foreach=\"object.attendee_ids\" t-as=\"attendee\" style=\"margin-bottom: 5px;\">\n"
"            <img t-if=\"attendee.state\" t-attf-src=\"/calendar/static/src/img/state_{{ attendee.state }}.png\" style=\"border:0; width: 15px; height: 15px; vertical-align: text-bottom;\"/>\n"
"            <t t-if=\"attendee.common_name\">\n"
"                <span style=\"margin-left: 5px\" t-out=\"attendee.common_name or ''\">Mitchell Admin</span>\n"
"            </t>\n"
"            <t t-else=\"\">\n"
"                <span style=\"margin-left:5px\">Usted</span>\n"
"            </t>\n"
"        </div>\n"
"    </div>\n"
"    <div t-if=\"not is_html_empty(object.description)\" style=\"margin: 32px 0 0;\">\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Descripción del evento</h2>\n"
"        <div t-out=\"object.description\"/>\n"
"    </div>\n"
"    <t t-set=\"upcoming_appointments\" t-value=\"(object.appointment_booker_id.upcoming_appointment_ids - object).sorted('start')\"/>\n"
"    <div t-if=\"upcoming_appointments\" style=\"margin: 32px 0 0;\">\n"
"        <t t-set=\"appointment_booker_id\" t-value=\"object.appointment_booker_id.id\"/>\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Sus próximas reuniones</h2>\n"
"        <ul style=\"margin: 6px 0 0; padding: 0 18px;\">\n"
"            <li style=\"margin-top: 6px;\" t-foreach=\"upcoming_appointments\" t-as=\"upcoming_appointment\">\n"
"                <span t-out=\"upcoming_appointment.appointment_type_id.name or ''\">Demo técnica</span>\n"
"                <span style=\"margin: 0 10px;\">-</span>\n"
"                <span t-out=\"upcoming_appointment.start or ''\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;format&quot;: &quot;medium&quot;, &quot;tz_name&quot;: mail_tz}\" style=\"font-weight: bold;\">20 de junio a las 15:00 h</span>\n"
"                <a t-attf-href=\"/calendar/view/#{upcoming_appointment.access_token}?partner_id=#{appointment_booker_id}\" target=\"_blank\" style=\"margin-left: 10px; font-size: 12px; color: #008f8c; text-decoration: underline;\">Ver detalles</a>\n"
"            </li>\n"
"        </ul>\n"
"    </div>\n"
"</div>\n"
"            "

