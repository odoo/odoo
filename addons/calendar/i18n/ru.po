"                <span style=\"margin: 0 10px;\">-</span>\n"
"                <span t-out=\"upcoming_appointment.start or ''\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;format&quot;: &quot;medium&quot;, &quot;tz_name&quot;: mail_tz}\" style=\"font-weight: bold;\">June 20th, 15:00</span>\n"
