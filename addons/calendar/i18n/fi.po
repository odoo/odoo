"    <h1 style=\"font-size: 18px; font-weight: bold; color: #374151;\">\n"
"        <t t-if=\"not object.appointment_type_id.is_always_confirm and object.appointment_status == 'request'\">Appointment requested</t>\n"
"        <t t-else=\"\">\n"
"            Booking confirmed\n"
"            <img src=\"/calendar/static/src/img/check-circle.png\" style=\"border:0; width: 24px; height: 24px; margin-left: 10px; text-decoration:none; vertical-align: bottom;\"/>\n"
"        </t>\n"
"    </h1>\n"
"    <p style=\"margin: 0;\">\n"
"        <span style=\"display: block; margin-top: 8px;\">\n"
"            <t t-out=\"appointment_booker_name or ''\">John Booker</t>\n"
"            <t t-if=\"not object.appointment_type_id.is_always_confirm and object.appointment_status == 'request'\"> has requested </t>\n"
"            <t t-else=\"\"> has booked </t>\n"
"            an appointment: <t t-out=\"object.appointment_type_id.name or ''\">Technical Demo</t>\n"
"            <t t-if=\"object.appointment_type_id.category not in ['custom', 'anytime'] and object.appointment_type_id.schedule_based_on == 'users' and object.partner_id\">\n"
