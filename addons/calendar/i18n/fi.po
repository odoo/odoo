msgstr ""
"<div style=\"font-size: 13px; color: #374151;\">\n"
"    <t t-set=\"is_online\" t-value=\"'appointment_type_id' in object and object.appointment_type_id\"/>\n"
"    <t t-set=\"recurrent\" t-value=\"object.recurrence_id and not ctx.get('calendar_template_ignore_recurrence')\"/>\n"
"    <t t-set=\"mail_tz\" t-value=\"object._get_mail_tz() or ctx.get('mail_tz')\"/>\n"
"    <h1 style=\"font-size: 18px; font-weight: bold; color: #374151; margin-bottom: 28px;\">\n"
"        Tapahtuma päivitetty\n"
"        <img src=\"/calendar/static/src/img/sync.png\" style=\"border:0; width: 24px; height: 24px; margin-left: 10px; text-decoration:none; vertical-align: bottom;\"/>\n"
"    </h1>\n"
"    <p style=\"margin: 0;\">\n"
"        <span style=\"display: block; margin-bottom: 8px;\">Hei,</span>\n"
"        Tämä tapaaminen on päivitetty.\n"
"    </p>\n"
"    <div style=\"margin: 32px 0 0;\">\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Lisätiedot</h2>\n"
"        <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size: 13px; color: #374151;\">\n"
"            <tr>\n"
"                <td style=\"width: 100px; color: #676F7B;\">Päivä &amp; aika</td>\n"
"                <td style=\"font-weight: bold;\">\n"
"                    <t t-out=\"format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='EEEE', lang_code=object.env.lang)\">Tiistai</t>\n"
"                    <t t-out=\"format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='d', lang_code=object.env.lang)\">4.</t>\n"
"                    <t t-out=\"format_datetime(dt=object.start, tz=mail_tz if not object.allday else None, dt_format='MMMM y', lang_code=object.env.lang)\">toukokuuta 2021</t>\n"
"                    <t t-if=\"not object.allday\">\n"
"                        <t t-out=\"format_time(time=object.start, tz=mail_tz, time_format='short', lang_code=object.env.lang)\">kello 11:00</t>\n"
"                        <t t-if=\"mail_tz\">\n"
"                            <span style=\"font-size: 11px; font-weight: normal;\">\n"
"                                (<t t-out=\"mail_tz or ''\">Eurooppa/Bryssel</t>)\n"
"                            </span>\n"
"                        </t>\n"
"                    </t>\n"
"                </td>\n"
"            </tr>\n"
"            <tr t-if=\"recurrent\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">Milloin</td>\n"
"                <td style=\"padding-top: 6px;\"><t t-out=\"object.recurrence_id.get_recurrence_name() or ''\">Kolme tapahtumaa viikoittain</t></td>\n"
"            </tr>\n"
"            <tr t-if=\"not object.allday and object.duration\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">Kesto</td>\n"
"                <td style=\"padding-top: 6px;\"><t t-out=\"('%dH%02d' % (object.duration,round(object.duration*60)%60))\">0h 30min</t></td>\n"
"            </tr>\n"
"            <tr t-if=\"object.location\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">Sijainti</td>\n"
"                <td style=\"padding-top: 6px;\">\n"
"                    <t t-out=\"object.location or ''\">Bryssel</t>\n"
"                    <a target=\"_blank\" t-if=\"not is_online or is_online and object.location != object.appointment_type_id.location_id.name\" t-attf-href=\"http://maps.google.com/maps?oi=map&amp;q={{object.location}}\" style=\"margin-left: 12px; font-size: 12px; color: #008f8c; text-decoration: underline;\">Katso kartalla</a>\n"
"                </td>\n"
"            </tr>\n"
"            <tr t-if=\"object.videocall_location\">\n"
"                <td style=\"width: 100px; padding-top: 6px; color: #676F7B;\">\n"
"                    <t t-if=\"object.videocall_source == 'discuss'\">Liity mukaan</t>\n"
"                    <t t-else=\"\">Liity</t>\n"
"                </td>\n"
"                <td style=\"padding-top: 6px;\">\n"
"                    <a t-att-href=\"object.videocall_location\" target=\"_blank\" style=\"color: #008f8c;\">\n"
"                        <t t-if=\"object.videocall_source == 'discuss'\">Odoo Viestintä</t>\n"
"                        <t t-else=\"\">Videopuhelu</t>\n"
"                    </a>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"    </div>\n"
"    <div style=\"margin: 32px 0 0;\">\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Osallistujat</h2>\n"
"        <div t-foreach=\"object.attendee_ids\" t-as=\"attendee\" style=\"margin-bottom: 5px;\">\n"
"            <img t-if=\"attendee.state\" t-attf-src=\"/calendar/static/src/img/state_{{ attendee.state }}.png\" style=\"border:0; width: 15px; height: 15px; vertical-align: text-bottom;\"/>\n"
"            <t t-if=\"attendee.common_name\">\n"
"                <span style=\"margin-left: 5px\" t-out=\"attendee.common_name or ''\">Mitchell Admin</span>\n"
"            </t>\n"
"            <t t-else=\"\">\n"
"                <span style=\"margin-left: 5px;\">Sinä</span>\n"
"            </t>\n"
"        </div>\n"
"    </div>\n"
"    <div t-if=\"not is_html_empty(object.description)\" style=\"margin: 32px 0 0;\">\n"
