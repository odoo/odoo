"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Muut tulevat tapaamisesi</h2>\n"
"        <ul style=\"margin: 6px 0 0; padding: 0 18px;\">\n"
"            <li style=\"margin-top: 6px;\" t-foreach=\"upcoming_appointments\" t-as=\"upcoming_appointment\">\n"
"                <span t-out=\"upcoming_appointment.appointment_type_id.name or ''\">Tekninen Demo</span>\n"
"                <span style=\"margin: 0 10px;\">-</span>\n"
"                <span t-out=\"upcoming_appointment.start or ''\" t-options=\"{&quot;widget&quot;: &quot;datetime&quot;, &quot;format&quot;: &quot;medium&quot;, &quot;tz_name&quot;: object.mail_tz}\" style=\"font-weight: bold;\">20. kesäkuuta kello 15:00</span>\n"
"                <a t-attf-href=\"/calendar/view/#{upcoming_appointment.access_token}?partner_id=#{appointment_booker_id}\" target=\"_blank\" style=\"margin-left: 10px; font-size: 12px; color: #008f8c; text-decoration: underline;\">Katso yksityiskohdat</a>\n"
"            </li>\n"
"        </ul>\n"
"    </div>\n"
"    <p style=\"margin: 32px 0 0;\">\n"
"        Kiitos!\n"
"        <t t-if=\"object.event_id.user_id.signature\">\n"
"            <span style=\"display: block; margin-top: 8px;\"><t t-out=\"object.event_id.user_id.signature or ''\">Mitchell Admin</t></span>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: calendar
#: model:mail.template,body_html:calendar.appointment_canceled_mail_template
msgid ""
"<div style=\"font-size: 13px; color: #374151;\">\n"
"    <t t-set=\"recurrent\" t-value=\"object.recurrence_id and not ctx.get('calendar_template_ignore_recurrence')\"/>\n"
"    <t t-set=\"mail_tz\" t-value=\"object._get_mail_tz() or ctx.get('mail_tz')\"/>\n"
