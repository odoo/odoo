"            <t t-if=\"attendee.common_name\">\n"
"                <span style=\"margin-left: 5px\" t-out=\"attendee.common_name or ''\">Mitchell Admin</span>\n"
"            </t>\n"
"            <t t-else=\"\">\n"
"                <span style=\"margin-left:5px\">Sinä</span>\n"
"            </t>\n"
"        </div>\n"
"    </div>\n"
"    <div t-if=\"not is_html_empty(object.description)\" style=\"margin: 32px 0 0;\">\n"
"        <h2 t-attf-style=\"margin-bottom: 12px; font-size: 14px; font-weight: bold; color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Tapahtuman kuvaus</h2>\n"
"        <div t-out=\"object.description\"/>\n"
"    </div>\n"
"</div>\n"
