<?xml version="1.0"?>
<odoo>
    <record id="calendar_user_view_form" model="ir.ui.view">
        <field name="name">calendar.user.view.form</field>
        <field name="model">calendar.user</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" string="Name"/>
                    <field name="filter_color" widget="color_picker"/>
                    <field name="calendar_owner_id" widget="many2one_avatar_user" invisible="not calendar_owner_id"/>
                    <field name="calendar_share_user_ids" widget="many2many_avatar_user"/>
                    <field name="access_role"/>
                </group>
            </form>
        </field>
    </record>
</odoo>
