<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="discuss.ChannelMember" t-inherit-mode="extension">
        <xpath expr="//*[@t-ref='this.displayNameRef']" position="inside">
            <span t-if="this.member().partner_id?.inMeetingEndText" class="text-success smaller ms-2 text-truncate fw-bold opacity-75" t-out="this.member().partner_id.inMeetingEndText"/>
        </xpath>
    </t>
</templates>
