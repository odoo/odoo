<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="calendar.booking.CalendarController" t-inherit="calendar.AttendeeCalendarController" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_calendar_button_today')]" position="before">
            <button
            t-if="this.isAppointmentManager and this.isResourceView"
            class="btn btn-primary"
            t-att-class="{'btn-sm btn-link p-1': this.env.isSmall}"
            t-on-click="this.onClickAddLeave">Add Closing Day(s)</button>
        </xpath>
        <xpath expr="//div[hasclass('o_calendar_header')]" position="inside">
            <div class="o_appointment_scheduling_box position-fixed position-md-static start-0 bottom-0 d-flex align-items-center justify-content-center gap-2 order-last order-lg-0"
                 t-att-class="{ 'flex-lg-row flex-column' : this.appointmentState.lastAppointment.id || this.hasSlotEvents() }">
                <t t-if="this.env.calendarState.mode === 'slots-creation' || this.appointmentState.lastAppointment.url">
                    <span t-if="this.appointmentState.lastAppointment.url and !this.appointmentState.lastAppointment.waitingCopyLinkCustomType" class="text-center">
                        <i class="fa-solid fa-check text-success" role="img" aria-label="Link copied to your clipboard!"/> Link copied to your clipboard!
                    </span>
                    <b t-else="">
                        Pick your availabilities
                    </b>
                    <div class="d-flex align-items-center gap-1 flex-wrap">
                        <button class="o_appointment_get_link btn btn-primary flex-fill text-nowrap"
                                t-att-class="{ 'd-none': !this.appointmentState.lastAppointment.id and !this.hasSlotEvents() }"
                                title="Get Share Link"
                                aria-label="Get Share Link"
                                t-on-click="this.onClickGetShareLink"
                                t-ref="copyLinkRef">
                            <i class="fa-solid fa-paste me-1" role="img" aria-label="Copy Link"/>Copy Link
                        </button>
                        <button class="o_appointment_open_form btn btn-secondary flex-fill text-nowrap"
                                t-att-class="{ 'd-none': !this.appointmentState.lastAppointment.id and !this.hasSlotEvents() }"
                                aria-label="Configure"
                                t-on-click="this.onClickOpenForm">
                            <i class="fa-solid fa-cog me-1" role="img" aria-label="Configure"/>Configure
                        </button>
                        <button class="o_appointment_discard_slots btn btn-light flex-fill"
                                aria-label="Discard"
                                t-on-click="this.onClickDiscard">
                                <i class="oi oi-close" role="img" aria-label="Discard"/>
                        </button>
                    </div>
                </t>
                <div t-else="" class="btn-group w-100 w-sm-auto mx-2 mx-sm-0 px-0">
                    <t t-set="appointments" t-value="this.appointmentState.data.appointment_types_info"/>
                    <div class="btn-group">
                        <Dropdown t-if="this.isAppointmentUser or (!this.isAppointmentUser and appointments.length)">
                            <button t-if="this.isAppointmentUser" class="btn btn-secondary dropdownAppointmentLink o-dropdown-caret">Share</button>
                            <button t-else="" class="btn btn-secondary dropdownAppointmentLink">Share Appointment Link</button>
                            <t t-set-slot="content">
                                <button t-if="this.isAppointmentUser" t-on-click="this.onClickSearchCreateAnytimeAppointment"
                                    class="o_appointment_button_link o_appointment_search_create_anytime_appointment dropdown-item">
                                    <span class="align-bottom">My Calendar</span>
                                </button>
                                <button t-if="this.isAppointmentUser" t-on-click="this.onClickSelectAvailabilities" class="o_appointment_select_slots dropdown-item">
                                    <span class="align-bottom">Specific Slots</span>
                                </button>
                                <button t-on-click="this.onClickCustomLink" class="dropdown-item">
                                    <span class="align-bottom">Custom Link</span>
                                </button>
                                <div t-if="appointments.length > 0" role="separator" class="dropdown-divider"/>
                                <t t-foreach="appointments" t-as="appointment" t-key="appointment.id">
                                    <button t-att-title="appointment.name" t-on-click.stop.prevent="() => this.onClickGetAppointmentUrl(appointment.id)"
                                        class="o_appointment_button_link o_appointment_appointment_link_clipboard dropdown-item text-truncate">
                                        <span class="align-bottom" t-out="appointment.name"/>
                                    </button>
                                </t>
                            </t>
                        </Dropdown>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
