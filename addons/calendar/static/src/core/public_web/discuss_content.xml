<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.DiscussContent" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-DiscussContent-localDateTime')]" position="after">
            <span t-if="this.inMeetingEndText" class="d-block text-success smaller fw-bold opacity-75 text-truncate ms-1">
                <i class="oi oi-filled me-1" data-icon="calendar_today"/>
                <t t-out="this.inMeetingEndText"/>
            </span>
        </xpath>
    </t>
</templates>
