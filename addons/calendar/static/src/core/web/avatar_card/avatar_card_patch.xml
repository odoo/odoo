<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AvatarCard" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o-mail-avatar-card-name')]" position="after">
            <span t-if="this.partner?.inMeetingEndText" class="text-success me-1 smaller fw-bold opacity-75" t-out="this.partner.inMeetingEndText"/>
        </xpath>
    </t>
</templates>
