<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="mail.Activity" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Activity-note')]" position="attributes">
            <attribute name="t-if">!this.activity().calendar_event_id</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Activity-note')]" position="after">
            <div t-if="this.meeting" class="mt-1">
                <t t-set="startToday" t-value="this.isToday(this.meeting.start)"/>
                <t t-set="stopToday" t-value="this.isToday(this.meeting.stop)"/>
                <ul class="mb-0 ms-1 ps-3">
                    <li t-if="!startToday || !stopToday">
                        <t t-if="startToday">Today</t>
                        <t t-else="" t-out="this.meeting.start.toLocaleString(this.dateFormat)"/>
                        <t t-if="this.meeting.stop > this.meeting.start.startOf('day').plus({days: 1})">
                            -
                            <t t-if="stopToday">Today</t>
                            <t t-else="" t-out="this.meeting.stop.toLocaleString(this.dateFormat)"/>
                        </t>
                    </li>
                    <li>
                        <t t-out="this.meeting.start.toLocaleString(this.timeFormat)"/> - <t t-out="this.meeting.stop.toLocaleString(this.timeFormat)"/>
                    </li>
                    <li t-if="this.attendeeNames" t-att-title="this.attendeeNames">
                        <t t-out="this.truncatedAttendeeNames"/>
                    </li>
                    <li t-if="this.meeting.location">
                        <t t-out="this.meeting.location"/>
                    </li>
                    <li t-else="">
                        <i class="oi oi-filled me-1" data-icon="videocam"/>
                        Online
                    </li>
                </ul>
            </div>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Activity-edit')]" position="attributes">
            <attribute name="t-if">!this.meeting</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Activity-markDone')]" position="before">
            <button t-if="this.meeting" class="btn btn-secondary btn-sm" t-on-click="this.onClickReschedule">
                <i class="oi oi-filled" data-icon="visibility"/> View
            </button>
            <a t-if="this.meeting?.videocall_location" class="btn btn-secondary btn-sm" type="button" t-att-href="this.meeting.videocall_location">
                <i class="oi" data-icon="videocam"/> Join Meeting
            </a>
        </xpath>
        <xpath expr="//t[@t-set='isMainAction']" position="attributes">
            <attribute name="t-value" add="and !this.meeting" separator=" "/>
        </xpath>
    </t>

</templates>
