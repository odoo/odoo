<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ChatWindow.headerContent" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-ChatWindow-nameBox')]" position="inside">
            <span t-if="this.inMeetingEndText" class="text-success smaller fw-bold opacity-75 text-truncate">
                <i class="oi oi-filled me-1" data-icon="calendar_today"/>
                <t t-out="this.inMeetingEndText"/>
            </span>
        </xpath>
    </t>
</templates>
