<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="calendar.AttendeeCalendarController" t-inherit="web.CalendarController" t-inherit-mode="primary">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-buttons">
                <button class="btn btn-primary o-calendar-button-new" t-on-click="this.onClickAddButton" data-hotkey="c">New</button>
            </t>
        </xpath>
        <!-- Remove the ms-auto from the sidebar section so that the synchronization buttons can be right-aligned -->
        <xpath expr="//div[hasclass('o_calendar_sidebar_controller')]" position="attributes">
            <attribute name="class" remove="ms-auto" separator=" "/>
        </xpath>
        <!-- Add header div to be filled with synchronization buttons in synchronization modules. -->
        <xpath expr="//Layout//div[hasclass('o_calendar_container')]//h5[hasclass('d-inline-flex')]" position="after">
            <div id="header_synchronization_settings" class="me-auto me-sm-2 ms-sm-auto d-flex flex-wrap align-items-end">
                <div t-if="
                    (this.model.syncStatus.google_calendar === 'sync_active' and this.model.state?.googlePendingSync and this.model.googleSyncTimedOut)
                    or (this.model.syncStatus.microsoft_calendar === 'sync_active' and this.model.state?.microsoftPendingSync and this.model.microsoftSyncTimedOut)"
                    class="text-center me-2">
                    <i class="oi oi-spin" data-icon="progress_activity"/>
                    <span class="ms-1">Syncing</span>
                </div>
                <div t-elif="this.model.state?.googleSyncError">
                    <button class="btn btn-link text-nowrap py-0"
                        t-on-click="this.model.syncStatus.google_calendar === 'sync_active' ? this.onRetryGoogleSync : this.onRetryMicrosoftSync">
                        <div class="flex-col text-end">
                            <i class="oi o_text_orange mt-1" data-icon="warning"/>
                            <span class="o-xsmaller o_text_orange"> Sync unsuccessful</span>
                            <div class="o-xsmaller">Try again</div>
                        </div>
                    </button>
                </div>
                <t t-elif="(this.model.credentialStatus.google_calendar or this.model.credentialStatus.microsoft_calendar)
                and (!this.model.syncStatus.google_calendar or ['sync_stopped', 'missing_credentials'].includes(this.model.syncStatus.google_calendar))
                and (!this.model.syncStatus.microsoft_calendar or ['sync_stopped', 'missing_credentials'].includes(this.model.syncStatus.microsoft_calendar))">
                    <h5 id="synchronize_with" class="d-none d-sm-inline-flex my-auto">Synchronize with</h5>
                </t>
                <t t-elif="(this.model.googleCredentialsSet and this.model.syncStatus.google_calendar === 'sync_active')
                or (this.model.microsoftCredentialsSet and this.model.syncStatus.microsoft_calendar === 'sync_active')">
                    <div id="google_calendar_sync" class="o_calendar_sync mx-1 d-inline-flex">
                        <button class="btn text-nowrap py-0"
                        t-on-click="this.model.syncStatus.google_calendar === 'sync_active' ? this.onStopGoogleSynchronization : this.onStopMicrosoftSynchronization">
                            <div>
                                <i id="check_symbol" class='oi px-1 o_text_green o_calendar_check' data-icon='check'/>
                                <span id="check_text" class='o_calendar_check'>
                                    <t t-if="this.model.syncStatus.google_calendar === 'sync_active'">Google</t>
                                    <t t-else="">Outlook</t>
                                </span>
                                <div class="o_calendar_stop o-xsmaller flex-col text-end">
                                    <i id="stop_symbol" class="oi oi-filled px-1 o_text_red" data-icon="square"/>
                                    <span id="stop_text" class="o_text_red">Stop Sync</span>
                                    <div t-if="this.model.syncEmail" t-out="this.model.syncEmail"/>
                                </div>
                            </div>
                        </button>
                    </div>
                </t>
                <t t-elif="this.model.syncStatus.google_calendar === 'sync_paused' or this.model.syncStatus.microsoft_calendar === 'sync_paused'">
                    <button class="btn text-nowrap" t-on-click="this.model.syncStatus.google_calendar === 'sync_paused' ? this.onUnpauseGoogleSynchronization : this.onUnpauseMicrosoftSynchronization">
                        <div>
                            <i id="pause_symbol" class='oi px-1 o_text_orange o_calendar_pause' data-icon='pause'/>
                            <i id="stop_symbol" class='oi oi-filled px-1 o_text_red o_calendar_stop' data-icon='square'/>
                            <span id="pause_text" class='o_text_orange o_calendar_pause'>Sync is paused</span>
                            <span id="stop_text" class="o_text_red o_calendar_stop">Stop Sync</span>
                        </div>
                    </button>
                </t>
            </div>
        </xpath>
        <xpath expr="//t[@t-elif]//span[hasclass('o_current_week')]" position="attributes">
            <attribute name="t-if" add="!this.uiService.isSmall" separator="and"/>
        </xpath>
    </t>
</templates>
