<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="calendar.AttendeeCalendarSidePanel" t-inherit="web.CalendarSidePanel" t-inherit-mode="primary">
        <!-- Alternative to this, handle all distinctions between calendar and other filters in the js file? -->
        <xpath expr="//t[@t-foreach='this.sortedFilterSections']" position="replace">
            <t t-foreach="this.sortedFilterSections" t-as="section" t-key="section.fieldName">
                <t t-if="section.fieldName === 'calendar_id'">
                    <AttendeeCalendarCalendarFilterSection model="this.props.model" section="section" placeholder="'+ Add a calendar'"/>
                </t>
                <t t-else="">
                    <FilterSection model="this.props.model" section="section" placeholder="'+ Add participants'"/>
                </t>
            </t>
        </xpath>
    </t>
</templates>
