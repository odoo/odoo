<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="calendar_event_multi_unlink_wizard_view_form" model="ir.ui.view">
        <field name="name">calendar_event_multi_unlink_wizard_view_form</field>
        <field name="model">calendar.event.multi.unlink.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Events">
                <p class="alert alert-warning" role="alert">Are you sure you want to delete these events?</p>
                <span>Notify attendees that the event was canceled?</span>
                <footer>
                    <button string="Send and delete" name="action_send_mails_and_unlink" type="object" class="btn-primary"/>
                    <button string="Delete" name="action_unlink" type="object" class="btn-primary"/>
                    <button special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
