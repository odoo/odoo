<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="calendar_event_multi_archive_or_unlink_wizard_view_form" model="ir.ui.view">
        <field name="name">calendar_event_multi_archive_or_unlink_wizard_view_form</field>
        <field name="model">calendar.event.multi.archive.or.unlink.wizard</field>
        <field name="arch" type="xml">
            <form string="Archive or Delete Events">
                <div class="alert alert-warning d-flex flex-column gap-3" role="alert">
                    <span invisible="requested_action != 'unlink'">Are you sure you want to delete these events ?</span>
                    <span invisible="requested_action != 'archive'">Are you sure you want to archive these events ?</span>
                    <span invisible="not has_recurrent_events or requested_action != 'unlink'">
                        Some events containing recurrence are selected, only this occurrence will be unlinked.
                    </span>
                    <span invisible="not has_recurrent_events or requested_action != 'archive'">
                        Some events containing recurrence are selected, only this occurrence will be archived.
                    </span>
                </div>
                <span invisible="block_mail">Notify attendees that the event was canceled ?</span>
                <footer>
                    <button invisible="block_mail or requested_action != 'unlink'"
                            string="Send and delete"
                            name="action_send_mails_and_unlink"
                            type="object"
                            class="btn-primary"/>
                    <button invisible="requested_action != 'unlink'"
                            string="Delete"
                            name="action_unlink"
                            type="object"
                            class="btn-primary"/>
                    <button invisible="block_mail or requested_action != 'archive'"
                            string="Send and archive"
                            name="action_send_mails_and_archive"
                            type="object"
                            class="btn-primary"/>
                    <button invisible="requested_action != 'archive'"
                            string="Archive"
                            name="action_archive"
                            type="object"
                            class="btn-primary"/>
                    <button special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
