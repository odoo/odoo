<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="calendar_event_multi_archive_or_unlink_wizard_view_form" model="ir.ui.view">
        <field name="name">calendar_event_multi_archive_or_unlink_wizard_view_form</field>
        <field name="model">calendar.event.multi.archive.or.unlink.wizard</field>
        <field name="arch" type="xml">
            <form string="Archive or Delete Events">
                <p class="alert alert-warning" role="alert">
                    <span invisible="requested_action != 'unlink'">Are you sure you want to delete these events?</span>
                    <span invisible="requested_action != 'archive'">Are you sure you want to archive these events?</span>
                </p>
                <span>Notify attendees that the event was canceled?</span>
                <footer>
                    <button string="Send and delete" name="action_send_mails_and_unlink" type="object" class="btn-primary" invisible="requested_action != 'unlink'"/>
                    <button string="Delete" name="action_unlink" type="object" class="btn-primary" invisible="requested_action != 'unlink'"/>
                    <button string="Send and archive" name="action_send_mails_and_archive" type="object" class="btn-primary" invisible="requested_action != 'archive'"/>
                    <button string="Archive" name="action_archive" type="object" class="btn-primary" invisible="requested_action != 'archive'"/>
                    <button special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
