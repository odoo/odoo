<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="calendar_event_archive_or_unlink_wizard_view_form" model="ir.ui.view">
        <field name="name">calendar.event.archive.or.unlink.wizard.view.form</field>
        <field name="model">calendar.event.archive.or.unlink.wizard</field>
        <field name="arch" type="xml">
            <form string="Archive or Delete Event">
                <field name="calendar_event_id" invisible="1"/>
                <div col="2" class="alert alert-warning" role="alert">
                    <span invisible="requested_action != 'unlink'">Are you sure you want to delete this event ?</span>
                    <span invisible="requested_action != 'archive'">Are you sure you want to archive this event ?</span>
                </div>
                <div invisible="not recurrency" class="mb-2">
                    <label for="recurrence_choice" class="me-2" string="Archive" invisible="requested_action != 'archive'"/>
                    <label for="recurrence_choice" class="me-2" string="Delete" invisible="requested_action != 'unlink'"/>
                    <field name="recurrence_choice"
                           widget="radio"
                           options="{'horizontal': True}"/>
                </div>
                <group invisible="block_mail" col="2">
                    <field name="recipient_ids"
                           widget="many2many_tags_email"
                           context="{'force_email': True,' show_email': True, 'no_create_edit': True}"
                    />
                </group>
                <group invisible="block_mail" col="2">
                    <field name="subject" placeholder="Subject"/>
                </group>
                <field invisible="block_mail"
                       name="body"
                       class="oe-bordered-editor"
                       options="{'style-inline': true}"/>
                <footer>
                    <button invisible="block_mail or requested_action != 'unlink'"
                            string="Send and delete"
                            name="action_send_mail_and_unlink"
                            type="object"
                            class="btn-primary o_cw_send_notify_delete"/>
                    <button invisible="requested_action != 'unlink'"
                            string="Delete"
                            name="action_unlink"
                            type="object"
                            class="btn-primary mx-1"/>
                    <button invisible="block_mail or requested_action != 'archive'"
                            string="Send and archive"
                            name="action_send_mail_and_archive"
                            type="object"
                            class="btn-primary"/>
                    <button invisible="requested_action != 'archive'"
                            string="Archive"
                            name="action_archive"
                            type="object"
                            class="btn-primary mx-1"/>
                    <button class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
