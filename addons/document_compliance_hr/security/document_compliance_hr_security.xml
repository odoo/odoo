<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="document_compliance_report_rule_not_employee" model="ir.rule">
        <field name="name">Compliance Report: employee rows are for HR officers</field>
        <field
            name="model_id"
            ref="document_compliance.model_document_compliance_report" />
        <field name="domain_force">[('entity_type', '!=', 'hr.employee')]</field>
        <field
            name="groups"
            eval="[Command.link(ref('document.group_documents_manager'))]" />
    </record>

    <record id="document_compliance_report_rule_hr_officer" model="ir.rule">
        <field name="name">Compliance Report: every entity for HR officers</field>
        <field
            name="model_id"
            ref="document_compliance.model_document_compliance_report" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('hr.group_hr_user'))]" />
    </record>

</odoo>
