<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_product_fbr_service_fee" model="product.product">
        <field name="name">FBR Service Fee</field>
        <field name="type">service</field>
        <field name="categ_id" eval="ref('product.product_category_services', raise_if_not_found=False)"/>
        <field name="default_code">FBR_SERVICE_FEE</field>
        <field name="list_price">1.0</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="available_in_pos" eval="False"/>
        <field name="taxes_id" eval="[Command.clear()]"/>
        <field name="supplier_taxes_id" eval="[Command.clear()]"/>
    </record>
</odoo>
