<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.l10n.pk.edi.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']" position="inside">
                <field name="l10n_pk_is_fbr_3rd_schedule" invisible="'PK' not in fiscal_country_codes"/>
            </xpath>
        </field>
    </record>
</odoo>
