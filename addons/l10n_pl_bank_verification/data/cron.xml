<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.cron" id="ir_cron_l10n_pl_bank_verification_error">
        <field name="name">Poland: check pending bank verifications</field>
        <field name="model_id" ref="model_l10n_pl_bank_account_verification"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_pending_verification()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
