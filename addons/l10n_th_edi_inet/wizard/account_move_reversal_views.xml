<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_reversal_inherit_l10n_th_edi_inet" model="ir.ui.view">
        <field name="name">account.move.reversal.form.inherit.l10n_th_edi_inet</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <field name="reason" position="attributes">
                <attribute name="invisible" separator="or" add="l10n_th_edi_available_reasons"/>
            </field>
            <field name="reason" position="after">
                <field name="l10n_th_edi_credit_note_reason"
                       widget="filterable_selection"
                       options="{'whitelist_fname': 'l10n_th_edi_available_reasons'}"
                       invisible="not l10n_th_edi_available_reasons"
                       required="l10n_th_edi_available_reasons"/>
                <field name="l10n_th_edi_other_reason"
                       invisible="l10n_th_edi_credit_note_reason not in ('CDNG99', 'CDNS99')"
                       required="l10n_th_edi_credit_note_reason in ('CDNG99', 'CDNS99')"/>
            </field>
        </field>
    </record>
</odoo>
