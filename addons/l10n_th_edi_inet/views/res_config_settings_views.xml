<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_th_edi_inet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_th.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='l10n_th_edi']" position="inside">
                <setting id="l10n_th_edi_address_setting"
                         string="Company Address Code"
                         help="e-Tax documents give the company's sub-district, district and province codes."
                         company_dependent="1">
                    <div class="content-group">
                        <div class="row">
                            <label for="l10n_th_edi_subdistrict_code" class="col-lg-4 o_light_label"/>
                            <field name="l10n_th_edi_subdistrict_code" class="w-50" placeholder="101702"/>
                        </div>
                    </div>
                </setting>
                <setting id="l10n_th_edi_inet_setting"
                         string="Set up INET"
                         help="Sign e-Tax documents and submit them to the Revenue Department through INET."
                         company_dependent="1">
                    <div class="content-group">
                        <div class="row">
                            <label for="l10n_th_edi_inet_staging_mode" string="Staging Mode" class="col-lg-4 o_light_label"/>
                            <field name="l10n_th_edi_inet_staging_mode" class="w-50"/>
                        </div>
                        <div class="row">
                            <label for="l10n_th_edi_inet_api_key" string="API Key" class="col-lg-4 o_light_label"/>
                            <field name="l10n_th_edi_inet_api_key" class="w-50" password="True"/>
                        </div>
                        <div class="row">
                            <label for="l10n_th_edi_inet_authorization_code" string="Authorization Code" class="col-lg-4 o_light_label"/>
                            <field name="l10n_th_edi_inet_authorization_code" class="w-50" password="True"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
