#. module: website_sale_mass_mailing
#: model:ir.module.module,description:base.module_website_sale_mass_mailing
msgid ""
"\n"
"Allows anonymous shoppers of your eCommerce to sign up for a newsletter "
"during the checkout\n"
"process.\n"
msgstr ""
"\n"
"ອະນຸຍາດໃຫ້ຜູ້ຊື້ສິນຄ້າທົ່ວໄປໃນ eCommerce ຂອງທ່ານ ສາມາດສະໝັກຮັບຈົດໝາຍຂ່າວ ໃນລະຫວ່າງຂັ້ນຕອນ\n"
"ການຊຳລະເງິນ.\n"

#. module: website_sale_mass_mailing
#: model:ir.module.module,shortdesc:base.module_website_sale_mass_mailing
msgid "Checkout Newsletter"
msgstr "ຈົດໝາຍຂ່າວຕອນຊຳລະເງິນ"

#. module: website_sale_mass_mailing
#: model:ir.model,name:website_sale_mass_mailing.model_res_config_settings
msgid "Config Settings"
msgstr "ການຕັ້ງຄ່າ"

#. module: website_sale_mass_mailing
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_res_config_settings__display_name
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_website__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: website_sale_mass_mailing
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_res_config_settings__id
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_website__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: website_sale_mass_mailing
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_res_config_settings__is_newsletter_enabled
msgid "Is Newsletter Enabled"
msgstr "ເປີດນຳໃຊ້ຈົດໝາຍຂ່າວແລ້ວ"

#. module: website_sale_mass_mailing
#: model:ir.module.module,summary:base.module_website_sale_mass_mailing
msgid "Let new customers sign up for a newsletter during checkout"
msgstr "ອະນຸຍາດໃຫ້ລູກຄ້າໃໝ່ສະໝັກຮັບຈົດໝາຍຂ່າວໃນລະຫວ່າງການຊຳລະເງິນ"

#. module: website_sale_mass_mailing
#: model_terms:ir.ui.view,arch_db:website_sale_mass_mailing.res_config_settings_view_form
msgid "Newsletter"
msgstr "ຈົດໝາຍຂ່າວ"

#. module: website_sale_mass_mailing
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_res_config_settings__newsletter_id
#: model:ir.model.fields,field_description:website_sale_mass_mailing.field_website__newsletter_id
msgid "Newsletter List"
msgstr "ລາຍຊື່ຈົດໝາຍຂ່າວ"

#. module: website_sale_mass_mailing
#: model_terms:ir.ui.view,arch_db:website_sale_mass_mailing.res_config_settings_view_form
msgid "Show a checkbox to sign up for the selected newsletter to guest users"
msgstr "ສະແດງຫ້ອງໝາຍຕິກ ເພື່ອໃຫ້ຜູ້ໃຊ້ທົ່ວໄປສະໝັກຮັບຈົດໝາຍຂ່າວທີ່ເລືອກໄວ້"

#. module: website_sale_mass_mailing
#: model_terms:ir.ui.view,arch_db:website_sale_mass_mailing.newsletter
msgid "Subscribe to our newsletter for updates and exclusive offers."
msgstr ""
"ສະໝັກຮັບຈົດໝາຍຂ່າວຂອງພວກເຮົາ ເພື່ອຕິດຕາມຂ່າວສານໃໝ່ໆ ແລະ ຂໍ້ສະເໜີພິເສດສຸດ."

