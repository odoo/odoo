<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_l10n_gt" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_gt</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <div name="identifiers" position="after">
                <field name="l10n_gt_isr_withholding_agent" invisible="country_code != 'GT'"/>
                <field name="l10n_gt_vat_withholding_type" invisible="country_code != 'GT'"/>
            </div>
        </field>
    </record>

</odoo>
