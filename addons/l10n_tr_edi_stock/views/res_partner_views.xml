<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_tr_edi_stock</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zip']" position="after">
                <field name="fiscal_country_codes" invisible="1"/>
                <field name="l10n_tr_edi_edispatch_customs_zip" placeholder="Customs ZIP" invisible="'TR' not in fiscal_country_codes or country_code == 'TR'"/>
            </xpath>
            <xpath expr="//notebook/page[@name='contact_addresses']/field[@name='child_ids']/form/sheet//field[@name='zip']" position="after">
                <field name="country_code" invisible="1"/>
                <field name="fiscal_country_codes" invisible="1"/>
                <field name="l10n_tr_edi_edispatch_customs_zip" placeholder="Customs ZIP" invisible="'TR' not in fiscal_country_codes or country_code == 'TR'"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.l10n_tr_edi_stock</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_tr_edi.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="l10n_tr_edi_einvoice_alias_id" position="after">
                <field name="l10n_tr_edi_edispatch_alias_id" invisible="invoice_edi_format != 'ubl_tr' or l10n_tr_edi_customer_status != 'einvoice'"/>
            </field>
        </field>
    </record>
</odoo>
