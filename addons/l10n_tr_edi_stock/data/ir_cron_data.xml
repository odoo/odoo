<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_l10n_tr_edi_fetch_received_dispatches" model="ir.cron">
        <field name="name">TR EDI: retrieve received e-Dispatches</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_tr_edi_fetch_received_dispatches()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=12)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="ir_cron_l10n_tr_edi_fetch_purchase_response_status" model="ir.cron">
        <field name="name">TR EDI: Update e-Dispatch Response Status</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_tr_edi_fetch_purchase_response_status()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_l10n_tr_edi_fetch_sale_response_status" model="ir.cron">
        <field name="name">TR EDI: Update e-Dispatch Delivery Response Status</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_tr_edi_fetch_sale_response_status()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
