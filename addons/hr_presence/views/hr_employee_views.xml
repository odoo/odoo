<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_search" model="ir.ui.view">
        <field name="name">hr.employee.view.search</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter" />
        <field name="arch" type="xml">
            <filter name="at_work" position="after">
                <filter
                    name="absent"
                    string="Absent"
                    domain="[('hr_presence_state_display', '=', 'absent')]" />
                <filter
                    name="out_of_working_hours"
                    string="Off-Hours"
                    domain="[('hr_presence_state_display', '=', 'out_of_working_hour')]" />
            </filter>
            <filter name="group_birthday" position="before">
                <filter
                    name="group_hr_presence_state"
                    string="Presence/Absence"
                    context="{'group_by':'hr_presence_state_display'}"
                    groups="hr.group_hr_manager" />
            </filter>
        </field>
    </record>

    <record id="action_hr_employee_presence_present" model="ir.actions.server">
        <field name="name">Set Present</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list,kanban,form</field>
        <field name="binding_sequence">10</field>
        <field name="state">code</field>
        <field name="code">action = records.action_set_present()</field>
        <field name="hr_presence_section">state</field>
    </record>

    <record id="action_hr_employee_presence_absent" model="ir.actions.server">
        <field name="name">Set Absent</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list,kanban,form</field>
        <field name="binding_sequence">11</field>
        <field name="state">code</field>
        <field name="code">action = records.action_set_absent()</field>
        <field name="hr_presence_section">state</field>
    </record>

    <record id="action_hr_employee_presence_log" model="ir.actions.server">
        <field name="name">Add a Log Note</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list,kanban,form</field>
        <field name="binding_sequence">20</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_log()</field>
        <field name="hr_presence_section">follow_up</field>
    </record>

    <record id="action_hr_employee_presence_email" model="ir.actions.server">
        <field name="name">Send Email…</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list,kanban,form</field>
        <field name="binding_sequence">21</field>
        <field name="binding_icon">fa-solid fa-envelope</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_email()</field>
        <field name="hr_presence_section">follow_up</field>
    </record>

    <record id="action_hr_employee_presence_sms" model="ir.actions.server">
        <field name="name">Send SMS…</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list,kanban,form</field>
        <field name="binding_sequence">22</field>
        <field name="binding_icon">fa-solid fa-comment-sms</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_sms()</field>
        <field name="hr_presence_section">follow_up</field>
    </record>

    <record id="action_hr_employee_presence_time_off" model="ir.actions.server">
        <field name="name">Create a Time Off</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list,kanban,form</field>
        <field name="binding_sequence">23</field>
        <field name="state">code</field>
        <field name="code">action = records.action_view_leave_request()</field>
        <field name="hr_presence_section">follow_up</field>
    </record>

</odoo>
