<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="report_approval_request_document_fields"
        inherit_id="approval.report_approval_request_document">
        <xpath expr="//tr[@name='request_contact']" position="after">
            <tr t-if="o.location">
                <td class="fw-bold">Location</td>
                <td><span t-field="o.location" /></td>
            </tr>
            <tr t-if="o.reference">
                <td class="fw-bold">Reference</td>
                <td><span t-field="o.reference" /></td>
            </tr>
            <tr t-if="o.template_id">
                <td class="fw-bold">Template</td>
                <td><span t-field="o.template_id" /></td>
            </tr>
        </xpath>
    </template>

</odoo>
