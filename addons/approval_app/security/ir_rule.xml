<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_template_rule" model="ir.rule">
        <field name="name">Approval Template: multi-company</field>
        <field
            name="model_id"
            model="ir.model"
            search="[('model','=','approval.template')]" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>
