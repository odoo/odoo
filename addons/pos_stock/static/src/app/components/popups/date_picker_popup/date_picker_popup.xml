<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_stock.DatePickerPopup">
        <Dialog title="this.props.title" size="'sm'">
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-secondary btn-lg flex-fill"
                    t-att-class="{ 'border-primary text-primary-emphasis bg-primary-subtle': !this.state.pickupLater }"
                    t-on-click="() => this.state.pickupLater = false">Ship later</button>
                <button class="btn btn-secondary btn-lg flex-fill"
                    t-att-class="{ 'border-primary text-primary-emphasis bg-primary-subtle': this.state.pickupLater }"
                    t-on-click="() => this.state.pickupLater = true">Pick up later</button>
            </div>
            <div class="mb-3 w-100 d-flex flex-column flex-sm-row align-items-center">
                <div class="flex-grow-1 w-100 shipping-date-selector">
                    <DateTimeInput
                        type="'date'"
                        value="this.state.shippingDate"
                        onChange.bind="this.onDateChange"
                        minDate="'today'"
                    />
                </div>
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary w-100"
                    t-on-click="this.confirm"
                    t-out="this.props.confirmLabel"
                />
            </t>
        </Dialog>
    </t>
</templates>
