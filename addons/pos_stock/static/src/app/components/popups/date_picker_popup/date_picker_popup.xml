<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_stock.DatePickerPopup">
        <Dialog title="this.props.title" size="'sm'">
            <div class="d-flex gap-2 mb-3 ">
                <button class="btn flex-fill py-2 fs-3 border"
                        t-att-class="this.state.scheduleType === 'ship' ? 'bg-primary-subtle text-primary border-primary' : 'btn-light'"
                        t-on-click="() => this.state.scheduleType = 'ship'">Ship later</button>
                <button class="btn flex-fill py-2 fs-3 border"
                        t-att-class="this.state.scheduleType === 'pickup' ? 'bg-primary-subtle text-primary border-primary' : 'btn-light'"
                        t-on-click="() => this.state.scheduleType = 'pickup'">Pick up later</button>
            </div>
            <div class="mb-2 w-100 d-flex flex-column flex-sm-row align-items-center">
                <div class="flex-grow-1 w-100 shipping-date-selector">
                    <DateTimeInput
                        type="'date'"
                        value="this.state.shippingDate"
                        onChange.bind="this.onDateChange"
                        minDate="'today'"
                    />
                </div>
            </div>
            <t t-set-slot="footer">
                <button
                    class="btn btn-primary w-100"
                    t-on-click="this.confirm"
                    t-out="this.props.confirmLabel"
                />
            </t>
        </Dialog>
    </t>
</templates>
