<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block" position="after">
                <block title="Spanish Localization" name="spain_localization" invisible="country_code != 'ES'">
                    <setting string="Simplified Invoice Limit" title="">
                        <div class="text-muted">
                            Above this limit the simplified invoice won't be made
                        </div>
                        <field name="l10n_es_simplified_invoice_limit"/>
                    </setting>
                    <setting string="Special VAT Regimes" title="">
                        <div class="text-muted">
                            Special VAT Regimes for Spain
                        </div>
                        <field name="l10n_es_special_vat_regime"/>
                    </setting>
                    <setting>
                        <div>
                            <field name="module_l10n_es_edi_verifactu"/>
                            <label name="module_l10n_es_edi_verifactu_label" for="module_l10n_es_edi_verifactu" string="Veri*Factu"/> 
                        </div>
                        <div>
                            <field name="module_l10n_es_edi_sii"/>
                            <label name="module_l10n_es_edi_sii_label" for="module_l10n_es_edi_sii" string="SII"/> 
                        </div>
                        <div>
                            <field name="module_l10n_es_edi_tbai"/>
                            <label name="module_l10n_es_edi_tbai_label" for="module_l10n_es_edi_tbai" string="TicketBai"/> 
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
