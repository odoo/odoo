#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"&amp;#128075; <br/>\n"
"    Welcome to the To-do app!"
msgstr ""
"&amp;#128075; <br/>\n"
"    به ماژول لیست کار خوش آمدید!"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"                    Add a checklist\n"
"                    (/<span style=\"font-style: italic;\">checklist</span>)\n"
"                </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"                    با این دستور چک لیست اضافه کنید\n"
"                    (/<span style=\"font-style: italic;\">چک لیست</span>)\n"
"                </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"                    Add a separator\n"
"                    (/<span style=\"font-style: italic;\">separator</span>)\n"
"                </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"                    با این دستور جداکننده اضافه کنید\n"
"                    (/<span style=\"font-style: italic;\">جداکننده</span>)\n"
"                </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"                    Use\n"
"                    /<span style=\"font-style: italic;\">heading</span>\n"
"                    to convert a text into a title\n"
"                </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"                    با دستور\n"
"                    /<span style=\"font-style: italic;\">تیتر</span>\n"
"                    متن را به تیتر تبدیل کنید\n"
"                </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"            Below this list, try\n"
"            <span style=\"font-weight: bolder;\">commands</span>\n"
"            by\n"
"            <span style=\"font-weight: bolder;\">\n"
"                <font style=\"color: #017E84\">typing</font>\n"
"            </span>\n"
"            \"<span style=\"font-weight: bolder;\">/</span>\"\n"
"        </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"            در ادامه این لیست از\n"
"            <span style=\"font-weight: bolder;\">دستورات استفاده کنید.</span>"
"\n"
"            برای این کار\n"
"            \"<span style=\"font-weight: bolder;\">/</span>\"\n"
"        را تایپ کنید.</span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"            Select text to\n"
"            <font style=\"background-color: #017E84; color: "
"white\">Highlight</font>,\n"
"            <span style=\"text-decoration-line: line-through;"
"\">strikethrough</span>\n"
"            or\n"
"            <span style=\"font-weight: bolder;\">style</span>\n"
"            <span style=\"font-style: italic; text-decoration-line: "
"underline;\">it</span>\n"
"        </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"            متن انتخابی را to\n"
"            <font style=\"background-color: #017E84; color: white\">هایلایت</"
"font>,\n"
"            <span style=\"text-decoration-line: line-through;\">خط‌دار کنید</"
"span>\n"
"            یا\n"
"            <span style=\"font-weight: bolder;\">استایل</span>\n"
"            <span style=\"font-style: italic; text-decoration-line: "
"underline;\">دهید</span>\n"
"        </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Access your personal pipeline with your to-dos and assigned tasks by "
"going to the Project app and clicking\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">My "
"Tasks</font>.\n"
"        </span>\n"
"    </span>\n"
"    <br/>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">\n"
"        There, your to-dos are listed as\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">private tasks.</font>\n"
"        </span>\n"
"        Any task you create privately will also be included in your to-dos. "
"Essentially, they are interchangeable.\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        برای دسترسی به جریان کاری شخصی خود شامل کارهای روزانه و وظایف محول "
"شده، به ماژول پروژه بروید و روی\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">"
"وظایف من</font>\n"
"        </span>\n"
"        کلیک کنید.\n"
"    </span>\n"
"    <br/>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">\n"
"        در این منو، کارهای روزانه شما به‌عنوان\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">وظایف خصوصی</font>\n"
"        </span>\n"
"        لیست می‌شوند. هر وظیفه‌ای که به‌صورت خصوصی ایجاد کنید نیز در فهرست "
"کارهای روزانه شما قرار خواهد گرفت و به‌طور کلی از هر دو مسیر می‌توانید دسترسی "
"داشته باشید.\n"
"    </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        By default, to-dos are only visible to you. You can share them with "
"other users by adding them as\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-"
"color-2\">assignees</font>.\n"
"        </span>\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        به‌طور پیش‌فرض، کارهای روزانه فقط برای شما قابل مشاهده هستند. ولی "
"می‌توانید با افزودن سایر کاربران به‌عنوان\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">"
"مسئول</font>\n"
"        </span>\n"
"        آنها را به اشتراک بگذارید.\n"
"    </span>\n"
"    <br/>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Customize the stages from the\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">Kanban view</font>\n"
"        </span>\n"
"        to reflect your preferred workflow.\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        مراحل را از طریق\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">نمای کانبان</font>\n"
"        </span>\n"
"        مطابق با جریان کاری دلخواه خود سفارشی‌سازی کنید.\n"
"    </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        If you want to assign your to-do to a specific project, open the ⚙️ "
"menu and click\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-"
"color-2\">Convert to Task</font>.\n"
"        </span>\n"
"        This action will make it visible to other users.\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        اگر می‌خواهید کار روزانه خود را به یک پروژه مشخص اختصاص دهید، منوی ⚙️ "
"را باز کرده و روی گزینه\n"
"        <span>\n"
"            <font style=\"font-weight: bolder;\" class=\"text-o-color-2\">"
"تبدیل به وظیفه</font>\n"
"        </span>\n"
"        کلیک کنید. با انجام این کار، وظیفه برای سایر کاربران نیز قابل مشاهده "
"خواهد شد.\n"
"    </span>\n"
"    <br/>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Use it to manage your work, take notes on the go, and create tasks "
"based on them.\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        از این ماژول می‌توانید برای مدیریت کارهای خود، یادداشت‌برداری سریع و "
"ایجاد وظایف بر اساس آنها استفاده کنید.\n"
"    </span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">\n"
"        Wherever you are, use the magic keyboard shortcut to add yourself a "
"reminder &amp;#128161;\n"
"    </span>\n"
"    <br/>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        هر کجا که هستید، از میانبر جادویی صفحه کلید برای اضافه کردن یک "
"یادآوری به خود استفاده کنید &amp;#128161;\n"
"    </span>\n"
"    <br/>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">Check this box to indicate it's done</span>"
msgstr ""
"<span style=\"font-size: 14px;\">با علامت زدن باکس مشخص کنید که این کار انجام "
"شد</span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">Click anywhere, and just start typing</span>"
msgstr ""
"<span style=\"font-size: 14px;\">هر جایی که دوست دارید کلیک و شروع به تایپ "
"کنید</span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">Press Ctrl+Z/⌘+Z to undo any change</span>"
msgstr ""
"<span style=\"font-size: 14px;\">برای لغو هرگونه تغییر Ctrl+Z/⌘+Z را فشار "
"دهید</span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-size: 14px;\">This private to-do is for you to play "
"around with.</span>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">Ready to give it a spin?</span>"
msgstr ""
"<span style=\"font-size: 14px;\">این صفحه، یک کار خصوصی برای تمرین شماست.</"
"span>\n"
"    <br/>\n"
"    <span style=\"font-size: 14px;\">می‌خواهید آن را تست کنید؟</span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid "<span style=\"font-size: 14px;\">Try the following</span>"
msgstr "<span style=\"font-size: 14px;\">موارد زیر را امتحان کنید:</span>"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">Alt + Shift + T</font>\n"
"            </span>\n"
"            (Windows/Linux)"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">Alt + Shift + T</font>\n"
"            </span>\n"
"            (ویندوز/لینوکس)"

#. module: project_todo
#: model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
msgid ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">Ctrl + Shift + T</font>\n"
"            </span>\n"
"            (MacOs)"
msgstr ""
"<span style=\"font-weight: bolder;\">\n"
"                <font class=\"text-o-color-2\">Ctrl + Shift + T</font>\n"
"            </span>\n"
"            (سیستم عامل Mac)"

