<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ImStatus" t-inherit-mode="extension">
        <xpath expr="//*[@name='icon']" position="replace">
            <i t-if="workLocation" t-attf-class="{{workLocation.icon}} {{workLocation.color}}" t-att-title="workLocation.title" role="img" t-att-aria-label="workLocation.title"/>
            <t t-else="">$0</t>
        </xpath>
    </t>

    <t t-inherit="mail.ThreadIcon" t-inherit-mode="extension">
        <xpath expr="//*[@name='chat_static']" position="replace">
            <i t-if="workLocation" t-attf-class="{{workLocation.icon}} {{workLocation.color}}" t-att-title="workLocation.title" role="img" t-att-aria-label="workLocation.title"/>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
