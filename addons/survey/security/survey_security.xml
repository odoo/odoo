<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="res_groups_privilege_surveys" model="res.groups.privilege">
        <field name="name">Surveys</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>

    <!-- Survey users -->
    <record id="group_survey_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_surveys" />
    </record>

    <!-- Survey managers -->
    <record id="group_survey_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_surveys" />
        <field name="implied_ids" eval="[Command.link(ref('group_survey_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

    <!-- SURVEY: SURVEY, PAGE, STAGE, QUESTION, LABEL -->
    <record id="survey_survey_rule_survey_manager" model="ir.rule">
        <field name="name">Survey: manager: all</field>
        <field name="model_id" ref="survey.model_survey_survey" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_survey_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey: officer: unrestricted survey or in restricted users</field>
        <field name="model_id" ref="survey.model_survey_survey" />
        <field
            name="domain_force">[
            '|', ('restrict_user_ids', 'in', user.id), ('restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_question_rule_survey_manager" model="ir.rule">
        <field name="name">Survey question: manager: all</field>
        <field name="model_id" ref="survey.model_survey_question" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_question_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey question: officer: unrestricted survey or in restricted users</field>
        <field name="model_id" ref="survey.model_survey_question" />
        <field
            name="domain_force">[
            '|', ('survey_id.restrict_user_ids', 'in', user.id), ('survey_id.restrict_user_ids',
            '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_question_answer_rule_survey_manager" model="ir.rule">
        <field name="name">Survey question answer: manager: all</field>
        <field name="model_id" ref="survey.model_survey_question_answer" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_question_answer_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey question answer: officer: unrestricted survey or in restricted
            users</field>
        <field name="model_id" ref="survey.model_survey_question_answer" />
        <field
            name="domain_force">[
            '|',
            '|', ('question_id.survey_id.restrict_user_ids', 'in', user.id),
            ('matrix_question_id.survey_id.restrict_user_ids', 'in', user.id),
            '|', ('question_id.survey_id.restrict_user_ids', '=', False),
            ('matrix_question_id.survey_id.restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- SURVEY: USER_INPUT, USER_INPUT_LINE -->
    <record id="survey_user_input_rule_survey_manager" model="ir.rule">
        <field
            name="name">Survey user input: manager: all non specialized surveys</field>
        <field name="model_id" ref="survey.model_survey_user_input" />
        <field
            name="domain_force">[('survey_id.survey_type', 'in', ('assessment', 'custom',
            'live_session', 'survey'))]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_user_input_line_rule_survey_manager" model="ir.rule">
        <field
            name="name">Survey user input line: manager: all non specialized surveys</field>
        <field name="model_id" ref="survey.model_survey_user_input_line" />
        <field
            name="domain_force">[('survey_id.survey_type', 'in', ('assessment', 'custom',
            'live_session', 'survey'))]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_user_input_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey user input: officer: unrestricted survey or in restricted users</field>
        <field name="model_id" ref="survey.model_survey_user_input" />
        <field
            name="domain_force">[
            '&amp;', ('survey_id.survey_type', 'in', ('assessment', 'custom', 'live_session',
            'survey')),
            '|', ('survey_id.restrict_user_ids', 'in', user.id),
            ('survey_id.restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_user_input_line_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey user input line: officer: unrestricted survey or in restricted
            users</field>
        <field name="model_id" ref="survey.model_survey_user_input_line" />
        <field
            name="domain_force">[
            '&amp;', ('survey_id.survey_type', 'in', ('assessment', 'custom', 'live_session',
            'survey')),
            '|', ('survey_id.restrict_user_ids', 'in', user.id),
            ('survey_id.restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- SURVEY: QUOTA, FOLLOW-UP RULE -->
    <!--
        These two hang off a survey exactly as its questions do, so they
        follow the same restrict_user_ids rule. Without it an officer kept
        out of a survey could still read and rewrite its quotas and its
        follow-up rules, including re-pointing a rule at any mail template.
    -->
    <record id="survey_quota_rule_survey_manager" model="ir.rule">
        <field name="name">Survey quota: manager: all</field>
        <field name="model_id" ref="survey.model_survey_quota" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_quota_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey quota: officer: unrestricted survey or in restricted users</field>
        <field name="model_id" ref="survey.model_survey_quota" />
        <field
            name="domain_force">[
            '|', ('survey_id.restrict_user_ids', 'in', user.id),
            ('survey_id.restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_followup_rule_rule_survey_manager" model="ir.rule">
        <field name="name">Survey follow-up rule: manager: all</field>
        <field name="model_id" ref="survey.model_survey_followup_rule" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <record id="survey_followup_rule_rule_survey_user" model="ir.rule">
        <field
            name="name">Survey follow-up rule: officer: unrestricted survey or in restricted
            users</field>
        <field name="model_id" ref="survey.model_survey_followup_rule" />
        <field
            name="domain_force">[
            '|', ('survey_id.restrict_user_ids', 'in', user.id),
            ('survey_id.restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

    <!-- SURVEY: INVITE -->
    <record id="survey_invite_survey_user" model="ir.rule">
        <field
            name="name">Survey invite: officer: unrestricted or in restricted users</field>
        <field name="model_id" ref="survey.model_survey_invite" />
        <field
            name="domain_force">['|', ('survey_id.restrict_user_ids', 'in', user.id),
            ('survey_id.restrict_user_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="survey_invite_survey_manager" model="ir.rule">
        <field name="name">Survey invite: manager: all</field>
        <field name="model_id" ref="survey.model_survey_invite" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_manager'))]" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="survey_user_input_rule_detached_owner" model="ir.rule">
        <field name="name">Detached response: owner</field>
        <field name="model_id" ref="model_survey_user_input" />
        <field
            name="domain_force">[('survey_id', '=', False), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
    </record>

    <record id="survey_user_input_line_rule_detached_owner" model="ir.rule">
        <field name="name">Detached response: owner</field>
        <field name="model_id" ref="model_survey_user_input_line" />
        <field
            name="domain_force">[('user_input_id.survey_id', '=', False), ('user_input_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
    </record>

    <!-- GAMIFICATION BADGE: a survey user edits certification badges and unused ones -->
    <record id="gamification_badge_rule_survey_user_edit" model="ir.rule">
        <field name="name">Badge: survey user: certification or unused badges</field>
        <field name="model_id" ref="gamification.model_gamification_badge" />
        <field
            name="domain_force">['|', ('survey_ids', '!=', False), '&amp;', ('challenge_ids', '=', False), ('owner_ids', '=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_survey_user'))]" />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

</odoo>
