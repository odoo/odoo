<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_form_matrix" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.matrix</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='product_id']" position="attributes">
                <attribute name="optional">hide</attribute>
                <attribute name="string">Product Variant</attribute>
            </xpath>
            <xpath expr="//list//field[@name='product_id']" position="before">
                <!-- optional="show" allows name (description) to be editable -->
                <field name="product_template_id"
                    string="Product"
                    readonly="state in ('purchase', 'to approve', 'cancel')"
                    required="not display_type"
                    optional="show"
                    context="{'partner_id': parent.partner_id}"
                    widget="pol_product_many2one"
                    invisible="display_type"
                    placeholder="Select a Product"
                />
            </xpath>
            <column name="product_and_description" position="after">
                <field name="product_template_attribute_value_ids" column_invisible="1"/> <!-- written by the product matrix configurator, must be in the view to be saved -->
                <field name="product_no_variant_attribute_value_ids" column_invisible="1"/> <!-- written by the product matrix configurator, must be in the view to be saved -->
                <field name="is_configurable_product" column_invisible="1"/> <!-- read by the purchase_product_field widget to open the matrix -->
            </column>
            <field name="partner_id" position="after">
                <field name="grid" invisible="1"/> <!-- serialized matrix exchanged with the product matrix dialog -->
                <field name="grid_product_tmpl_id" invisible="1"/> <!-- product template the matrix dialog was opened for -->
                <field name="grid_update" invisible="1"/> <!-- flag telling the server the matrix dialog returned a new grid -->
            </field>
        </field>
    </record>

</odoo>
