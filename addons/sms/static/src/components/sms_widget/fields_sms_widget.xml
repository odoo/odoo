<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="sms.SmsWidget" t-inherit="mail.EmojisTextField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_field_input_buttons')]/button[@data-icon='wand_stars']" position="replace"/>
        <xpath expr="//div[hasclass('o_field_input_buttons')]" position="inside">
            <div class="d-inline-flex align-items-center justify-content-center">
                <button t-if="this.props.dynamicPlaceholder and !this.props.readonly"
                    class="btn btn-link end-0 bottom-0"
                    title="Insert Field"
                    t-on-click="this.onDynamicPlaceholderOpen">
                    <span class="oi oi-fw me-1" data-icon="wand_stars"/>
                </button>
            </div>
        </xpath>
    </t>
    <t t-name="sms.SmsCharCounter">
        <div t-if="this.nbrChar > 0" class="ms-auto text-muted d-flex align-items-center fs-6">
            <t t-out="this.nbrChar"/>/<t t-out="this.maxChar"/> <t t-out="this.nbrCharExplanation"/> | <t t-out="this.nbrSMS"/> SMS (<t t-out="this.encoding"/>)
            <a href="https://iap-services.odoo.com/iap/sms/pricing" target="_blank"
               title="SMS Pricing" aria-label="SMS Pricing" class="oi oi-lg align-middle ms-1" data-icon="info"/>
        </div>
    </t>
</templates>
