<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_view_form_inherit_hr" model="ir.ui.view">
        <field name="name">resource.asset.form.fleet.hr</field>
        <field name="model">resource.asset.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <field name="operator_id" position="after">
                <field
                    name="operator_employee_id"
                    widget="many2one_avatar_employee"
                    invisible="not operator_employee_id" />
                <field name="mobility_card" invisible="not mobility_card" />
            </field>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_inherit_hr" model="ir.ui.view">
        <field name="name">resource.asset.search.fleet.hr</field>
        <field name="model">resource.asset.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search" />
        <field name="arch" type="xml">
            <field name="operator_id" position="after">
                <field name="operator_employee_id" />
            </field>
        </field>
    </record>

    <record id="fleet_vehicle_view_tree_inherit_hr" model="ir.ui.view">
        <field name="name">resource.asset.list.fleet.hr</field>
        <field name="model">resource.asset.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree" />
        <field name="arch" type="xml">
            <field name="operator_id" position="after">
                <field
                    name="operator_employee_id"
                    widget="many2one_avatar_employee"
                    optional="hide" />
            </field>
        </field>
    </record>

</odoo>
