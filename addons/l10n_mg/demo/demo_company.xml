<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_demo_company_mg" model="res.partner" forcecreate="1">
        <field name="name">MG Company</field>
        <field name="vat">4001234567</field>
        <field name="additional_identifiers" eval="{'MG_NIF': '4001234567', 'MG_STAT': '46101112010000123'}"/>
        <field name="street">Rue Rainitovo, Antsahavola</field>
        <field name="city">Antananarivo</field>
        <field name="country_id" ref="base.mg"/>
        <field name="zip">101</field>
        <field name="phone">+261 20 22 123 45</field>
        <field name="email">info@company.mgexample.com</field>
        <field name="website">www.mgexample.com</field>
    </record>

    <record id="base.demo_company_mg" model="res.company" forcecreate="1">
        <field name="name">MG Company</field>
        <field name="partner_id" ref="base.partner_demo_company_mg"/>
    </record>

    <!-- Second company under the Impôt Synthétique (IS) tax regime, to show the returns of both tax regimes -->
    <record id="partner_demo_company_mg_is" model="res.partner">
        <field name="name">MG Company (IS)</field>
        <field name="vat">4009876543</field>
        <field name="additional_identifiers" eval="{'MG_NIF': '4009876543', 'MG_STAT': '47111112010000456'}"/>
        <field name="street">Avenue de l'Indépendance, Analakely</field>
        <field name="city">Antananarivo</field>
        <field name="country_id" ref="base.mg"/>
        <field name="zip">101</field>
        <field name="phone">+261 20 22 654 32</field>
        <field name="email">info@company-is.mgexample.com</field>
        <field name="website">www.is.mgexample.com</field>
    </record>

    <record id="demo_company_mg_is" model="res.company">
        <field name="name">MG Company (IS)</field>
        <field name="partner_id" ref="partner_demo_company_mg_is"/>
        <field name="l10n_mg_tax_regime">is</field>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('base.demo_company_mg'), ref('demo_company_mg_is')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('base.demo_company_mg')), (4, ref('demo_company_mg_is'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>mg</value>
        <value model="res.company" eval="obj().env.ref('base.demo_company_mg')"/>
        <value name="install_demo" eval="True"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>mg</value>
        <value model="res.company" eval="obj().env.ref('l10n_mg.demo_company_mg_is')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
