<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_mg</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="l10n_mg_tax_regime" invisible="country_code != 'MG'"/>
            </xpath>
        </field>
    </record>
</odoo>
