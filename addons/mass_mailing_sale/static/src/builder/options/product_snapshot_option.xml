<templates>
    <t t-inherit="mass_mailing.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//record_snapshot_option" position="after">
            <product_snapshot_option selector=".s_record_snapshot:has(.s_product_snapshot_price)"/>
        </xpath>
    </t>
    <t t-name="mass_mailing_sale.productSnapshotOption">
        <BuilderRow t-if="this.state.domain !== false" label.translate="Pricelist">
            <BuilderMany2One
                action="'selectPricelistAction'"
                model="'product.pricelist.item'"
                fields="['name', 'display_name', 'price_markup', 'price_discount', 'fixed_price', 'currency_id', 'pricelist_id', 'price', 'compute_price']"
                preview="true"
                allowUnselect="true"
                domain="this.state.domain"
                actionParam="{
                    model: 'product.pricelist.item',
                }"/>
        </BuilderRow>
    </t>
</templates>
