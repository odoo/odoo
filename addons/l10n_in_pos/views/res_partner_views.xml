<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pos_ui_inherit_l10n_in_pos" model="ir.ui.view">
        <field name="name">res.partner.form.pos.ui.inherit.l10n_in_pos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="point_of_sale.view_partner_form_pos_ui"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='identifiers']" position="before">
                <field name="l10n_in_gst_treatment" invisible="'IN' not in fiscal_country_codes or not l10n_in_is_gst_registered_enabled" readonly="parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
