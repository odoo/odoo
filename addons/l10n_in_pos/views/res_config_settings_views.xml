<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_in_pos_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_in_pos.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='payment_methods_new']" position="before">
                <div class="o_notification_alert alert alert-warning" role="alert" invisible="not use_kiosk_mode or country_code != 'IN'">
                    <span>Please note that the kiosk for INR currency only works with Razorpay terminal</span>
                </div>
            </xpath>
            <block id="pos_accounting_section" position="inside">
                <setting id="l10n_in_pos_b2c_invoice_sequence"
                    string="B2C Invoice Sequence"
                    help="Invoice and refund invoice numbers of the B2C orders, e.g. P26/07/000000007 and R26/07/000000004."
                    invisible="country_code != 'IN'">
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="pos_l10n_in_b2c_sequence_prefix" class="col-lg-4 o_light_label"/>
                            <field name="pos_l10n_in_b2c_sequence_prefix" readonly="pos_has_active_session"/>
                        </div>
                        <div class="row">
                            <label for="pos_l10n_in_b2c_refund_sequence_prefix" class="col-lg-4 o_light_label"/>
                            <field name="pos_l10n_in_b2c_refund_sequence_prefix" readonly="pos_has_active_session"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
