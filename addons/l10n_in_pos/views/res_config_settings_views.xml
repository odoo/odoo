<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_in_pos_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_in_pos.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='payment_methods_new']" position="before">
                <div class="o_notification_alert alert alert-warning" role="alert" invisible="not use_kiosk_mode or country_code != 'IN'">
                    <span>Please note that the kiosk for INR currency only works with Razorpay terminal</span>
                </div>
            </xpath>
            <xpath expr="//setting[@id='pos_download_invoice']" position="after">
                <setting id="pos_l10n_in_b2c_invoice_prefix" string="B2C Invoice Sequence" invisible="country_code != 'IN'"
                         help="Number and invoice each paid B2C order individually. Orders invoiced on request (B2B) keep the regular invoice numbers.">
                    <label for="pos_l10n_in_b2c_invoice_prefix" string="Prefix"/>
                    <field name="pos_l10n_in_b2c_invoice_prefix" class="oe_inline ps-2" placeholder="P"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
