msgid ""
"<span class=\"text-muted\">\n"
"                            Recommended for extra security.\n"
"                        </span>"
msgstr ""
"<span class=\"text-muted\">\n"
"                            ແນະນຳເພື່ອຄວາມປອດໄພເພີ່ມເຕີມ.\n"
"                        </span>"

