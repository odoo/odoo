<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_tax_form_inherit_l10n_id" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.l10n_id</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']" position="inside">
                <group>
                    <group string="E-Bupot" name="ebupot" invisible="country_code != 'ID' or type_tax_use != 'purchase' or not is_withholding_tax">
                        <field name="l10n_id_ebupot_code" invisible="l10n_id_ebupot_facility not in (False, 'N/A')"/>
                        <field name="l10n_id_ebupot_facility"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
