<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_move_form_l10n_id" model="ir.ui.view">
            <field name="name">account.move.form.l10n_id</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='other_tab_group']" position="inside">
                    <group id="l10n_id_electronic_tax" string="Electronic Tax" invisible="country_code != 'ID' or move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund', 'out_receipt')">
                        <field name="l10n_id_kode_transaksi" readonly="state == 'posted'" required="country_code == 'ID' and move_type in ('out_invoice', 'out_refund')"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="action_fetch_qris_status" model="ir.actions.server">
            <field name="name">Check QRIS Payment Status</field>
            <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list,kanban,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_l10n_id_update_payment_status()
            </field>
        </record>
</odoo>
