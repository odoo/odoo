<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_id</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices']" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'ID'"/>
            </xpath>
            <xpath expr="//setting[@id='qr_code_invoices']" position="after">
                <setting id="l10n_id_qr_code_invoices" string="QRIS Code" company_dependent="1"
                    help="Add a QR-code to your invoices so that your customers can pay instantly with their mobile banking or e-wallet application."
                    invisible="country_code != 'ID'">
                    <field name="qr_code" class="oe_inline"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
