#. module: pos_viva_com
#. odoo-javascript
#: code:addons/pos_viva_com/static/src/app/utils/error_messages.js:0
msgid ""
"Viva.com charged %s, which does not match the total for this order (%s). The "
"customer may have been charged; refund the transaction on the Viva terminal "
"before retrying."
msgstr ""
"Viva.com a încasat %s, sumă diferită de totalul comenzii (%s). Este posibil "
"ca clientul să fi fost taxat; rambursați tranzacția pe terminalul Viva "
"înainte de a reîncerca."

#. module: pos_viva_com
#. odoo-javascript
#: code:addons/pos_viva_com/static/src/app/utils/error_messages.js:0
