<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pt" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pt</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[.//field[@name='name']]" position="after">
                <div class="text-muted" invisible="not l10n_pt_product_name">
                    <span>Name on Portuguese documents: </span>
                    <field name="l10n_pt_product_name" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
