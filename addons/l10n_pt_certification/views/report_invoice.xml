<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- No customer, a customer without a NIF, or one with the generic 999999990 (kept for the SAF-T
         only), is printed as "Consumidor final" (Despacho 8632/2014 2.2.5, FAQ 4730). -->
    <template id="l10n_pt_partner_vat">
        <div t-if="not (o.partner_id and o.partner_id._l10n_pt_has_nif())">
            <t t-out="'Consumidor final'"/>
        </div>
    </template>

    <!-- Only rendered for the documents a PT company issues (`account.move._get_name_invoice_report`). -->
    <template id="report_invoice_document" inherit_id="account.report_invoice_document" primary="True">
        <!-- The exemption codes on each line, and their mentions before the legal notes. -->
        <xpath expr="//td[@name='td_taxes']" position="inside">
            <span t-out="line._l10n_pt_get_line_vat_exemptions_reasons()"/>
        </xpath>
        <xpath expr="//p[@name='taxes_legal_notes']" position="before">
            <t t-set="pt_tax_exemption_reasons" t-value="o._l10n_pt_get_vat_exemptions_reasons()"/>
            <t t-if="pt_tax_exemption_reasons">
                <div><strong>Motivos de isenção de IVA:</strong></div>
                <t t-foreach="pt_tax_exemption_reasons" t-as="reason">
                    <div><t t-out="reason"/></div>
                </t>
                <br/>
            </t>
        </xpath>

        <!-- A customer without a NIF is printed as 'Consumidor final', never with the generic NIF. -->
        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="attributes">
            <attribute name="t-if">o.partner_id and o.partner_id._l10n_pt_has_nif()</attribute>
        </xpath>
        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="attributes">
            <attribute name="t-if">o.partner_id and o.partner_id._l10n_pt_has_nif()</attribute>
        </xpath>
        <xpath expr="//div[@id='partner_vat_no_shipping']" position="attributes">
            <attribute name="t-if">o.partner_id and o.partner_id._l10n_pt_has_nif()</attribute>
        </xpath>
        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="after">
            <t t-call="l10n_pt_certification.l10n_pt_partner_vat"/>
        </xpath>
        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="after">
            <t t-call="l10n_pt_certification.l10n_pt_partner_vat"/>
        </xpath>
        <xpath expr="//div[@id='partner_vat_no_shipping']" position="after">
            <t t-call="l10n_pt_certification.l10n_pt_partner_vat"/>
        </xpath>

        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="proforma">PROFORMA</span>
                <span t-if="o.l10n_pt_document_number" t-field="o.l10n_pt_document_number">FS 2023/0001</span>
                <span>-</span>
                <span t-out="o._l10n_pt_get_document_type_designation()"/>
            </t>
        </xpath>

        <!-- Dates are printed as DD-MM-AAAA (Despacho 8632/2014 2.2.4) -->
        <xpath expr="//div[@t-field='o.invoice_date']" position="attributes">
            <attribute name="t-options">{'widget': 'date', 'format': 'dd-MM-yyyy'}</attribute>
        </xpath>
        <xpath expr="//div[@t-field='o.invoice_date_due']" position="attributes">
            <attribute name="t-options">{'widget': 'date', 'format': 'dd-MM-yyyy'}</attribute>
        </xpath>
        <xpath expr="//div[@t-field='o.delivery_date']" position="attributes">
            <attribute name="t-options">{'widget': 'date', 'format': 'dd-MM-yyyy'}</attribute>
        </xpath>
        <xpath expr="//t[@t-out=&quot;payment_vals['date']&quot;]" position="attributes">
            <attribute name="t-options">{'widget': 'date', 'format': 'dd-MM-yyyy'}</attribute>
        </xpath>

        <!-- An invoice that is the transport document states the places of loading and unloading, referred
             to as such, and the date and time the transport starts (RBC art. 4(4)) -->
        <xpath expr="//div[@id='informations']" position="after">
            <div t-if="o.l10n_pt_is_transport_document" name="l10n_pt_transport" class="row mb-4">
                <div class="col-4" name="l10n_pt_loading_place">
                    <strong>Local de carga</strong>
                    <div t-out="o.l10n_pt_loading_partner_id"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </div>
                <div class="col-4" name="l10n_pt_unloading_place">
                    <strong>Local de descarga</strong>
                    <div t-out="o._l10n_pt_get_unloading_partner()"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </div>
                <div class="col-4" name="l10n_pt_transport_start">
                    <strong>Início do transporte</strong>
                    <div t-field="o.l10n_pt_start_transport_date"
                         t-options="{'widget': 'datetime', 'format': 'dd-MM-yyyy HH:mm', 'tz_name': o.company_id._l10n_pt_get_legal_tz()}"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@id='qrcode']" position="after">
            <t t-if="o.l10n_pt_qr_code_str">
                <div>
                    ATCUD:<t t-out="o.l10n_pt_atcud"/>
                </div>
                <img style="margin: 0.25cm;"
                     t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;barLevel=%s'%('QR', quote_plus(o.l10n_pt_qr_code_str), 125, 125, 'M')"
                />
            </t>
        </xpath>

        <!-- Running total of the product lines, for the Accumulated column of long invoices. -->
        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="l10n_pt_show_accumulated" t-value="len(o.invoice_line_ids) &gt; 5 and report_type == 'pdf'"/>
        </xpath>
        <xpath expr="//t[@t-foreach='lines_to_report']" position="before">
            <t t-set="l10n_pt_accumulated" t-value="0"/>
        </xpath>
        <xpath expr="//t[@t-set='is_product']" position="after">
            <t t-if="is_product" t-set="l10n_pt_accumulated"
               t-value="l10n_pt_accumulated + (line.price_total if o.company_price_include == 'tax_included' else line.price_subtotal)"/>
        </xpath>

        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th t-if="l10n_pt_show_accumulated" name="th_subtotal_accumulated" class="text-end">
                <span>Accumulated</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="after">
            <td t-if="l10n_pt_show_accumulated" name="td_subtotal_accumulated" class="text-end">
                <span class="text-nowrap"
                      t-out="l10n_pt_accumulated"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                />
            </td>
        </xpath>

        <!-- No per-section subtotal, and the table kept aligned with the accumulated column -->
        <xpath expr="//td[@name='td_section_subtotal']/span[@t-out='section_subtotal']" position="replace"/>
        <xpath expr="//td[@name='td_section_subtotal']" position="after">
            <td t-if="l10n_pt_show_accumulated" class="text-end"/>
        </xpath>
        <xpath expr="//td[@name='td_subtotal_grouped']" position="after">
            <td t-if="l10n_pt_show_accumulated" class="text-end"/>
        </xpath>

        <!-- Before the reference, which can be long (a credit note's reversal reason): wkhtmltopdf leaves
             no gutter between these columns, so a long value runs into the column after it. -->
        <xpath expr="//div[@name='reference']" position="before">
            <div class="col" t-if="o.name and o.name != '/'" name="internal_number">
                <strong>Internal Number</strong>
                <div t-field="o.name">INV/2023/00001</div>
            </div>
        </xpath>

        <!-- PT lines show their own discount, without the global one. -->
        <xpath expr="//td[@name='td_discount']/span[@t-field='line.discount']" position="attributes">
            <attribute name="t-field">line.l10n_pt_line_discount</attribute>
        </xpath>

        <xpath expr="//div[@id='total']" position="before">
            <div t-if="o.l10n_pt_global_discount" class="pb-4">
                Global Discount: <span t-field="o.l10n_pt_global_discount"/> %
            </div>
        </xpath>
    </template>

    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
            <t t-elif="o._get_name_invoice_report() == 'l10n_pt_certification.report_invoice_document'"
               t-call="l10n_pt_certification.report_invoice_document"
               t-lang="lang"/>
        </xpath>
    </template>
</odoo>
