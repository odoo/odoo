<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_pt" model="ir.ui.view">
            <field name="name">account.move.form.inherit.pt</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('alert')]" position="after">
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not l10n_pt_show_future_date_warning">
                        Setting the invoice date in the future will prevent new documents with an invoice date before
                        <field name="invoice_date" readonly="1"/> from being posted.
                    </div>
                    <!-- Alert to the data the SAF-T (PT) will need while drafting (Despacho 8632/2014 3.4.1) -->
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not l10n_pt_saft_missing_data">
                        <strong>Missing for the SAF-T (PT):</strong>
                        <field name="l10n_pt_saft_missing_data" readonly="1"/>
                    </div>
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not l10n_pt_at_series_missing_at_code">
                        The AT Series <field name="l10n_pt_at_series_id" readonly="1"/> is missing its validation code.
                        Register it with the Autoridade Tributária before sending or printing.
                    </div>
                </xpath>
                <!-- Hide Cancel button for PT moves and instead show a Cancel button calling the cancellation wizard.
                     Core has two button_cancel, told apart only by their condition: this is the invoices' one. -->
                <xpath expr="//button[@name='button_cancel'][contains(@invisible, &quot;move_type == &apos;entry&apos;&quot;)]" position="attributes">
                    <attribute name="invisible">not id or state != 'draft' or move_type == 'entry' or (country_code == 'PT' and (l10n_pt_document_number or (posted_before and l10n_pt_at_series_id)))</attribute>
                </xpath>
                <xpath expr="//button[@name='button_cancel'][contains(@invisible, &quot;move_type == &apos;entry&apos;&quot;)]" position="after">
                    <button name="%(l10n_pt_certification.action_l10n_pt_cancel)d"
                            string="Cancel"
                            type="action"
                            groups="account.group_account_invoice"
                            data-hotkey="x"
                            invisible="not id or state == 'cancel' or not (l10n_pt_document_number or (posted_before and l10n_pt_at_series_id)) or move_type == 'entry' or country_code != 'PT'"/>
                </xpath>
                <!-- PT requirement: a fully rectified document cannot be credited again. -->
                <xpath expr="//button[@name='action_reverse']" position="attributes">
                    <attribute name="invisible">move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or (country_code == 'PT' and payment_state == 'reversed')</attribute>
                </xpath>
                <!-- The series decides the number; once posted, the title is the number. -->
                <xpath expr="//group[@id='header_left_group']" position="inside">
                    <field name="l10n_pt_at_series_id"
                           invisible="country_code != 'PT' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')"
                           readonly="state in ['cancel', 'posted'] or posted_before"
                           domain="[('active', '=', True), ('journal_id', '=', journal_id), ('document_type', '=', l10n_pt_document_type)]"/>
                </xpath>
                <xpath expr="//group[@id='header_right_group']" position="inside">
                    <field name="l10n_pt_global_discount"
                           invisible="country_code != 'PT' or move_type not in ('out_invoice', 'out_receipt', 'out_refund')"
                           readonly="state != 'draft'"/>
                </xpath>
                <!-- PT lines edit their own discount, `discount` being computed from it and the global one. -->
                <xpath expr="//field[@name='discount']" position="attributes">
                    <attribute name="column_invisible">parent.country_code == 'PT'</attribute>
                </xpath>
                <xpath expr="//field[@name='discount']" position="after">
                   <field name="l10n_pt_line_discount" string="Disc.%" optional="hide" column_invisible="parent.country_code != 'PT'"/>
                </xpath>
                <!-- What issuing records, in the same tab and order on every PT document -->
                <xpath expr="//page[@id='other_tab']" position="after">
                    <page id="l10n_pt_info_tab"
                          name="l10n_pt_info"
                          string="Portugal"
                          invisible="country_code != 'PT' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')">
                        <group name="l10n_pt_info_group">
                            <group string="Document" name="l10n_pt_document_group">
                                <field name="l10n_pt_document_type"/>
                                <field name="l10n_pt_document_number"/>
                                <field name="l10n_pt_at_series_id" readonly="1"/>
                                <field name="l10n_pt_atcud"/>
                            </group>
                            <group string="Issue" name="l10n_pt_issue_group" invisible="not l10n_pt_document_number">
                                <field name="l10n_pt_issued_on"/>
                                <field name="l10n_pt_issue_user_id" widget="many2one_avatar_user"/>
                            </group>
                            <group string="Cancellation" name="l10n_pt_cancel_group" invisible="state != 'cancel'">
                                <field name="l10n_pt_cancel_date"/>
                                <field name="l10n_pt_cancel_user_id" widget="many2one_avatar_user"/>
                                <field name="l10n_pt_cancel_reason"
                                       required="state == 'cancel' and l10n_pt_document_number"/>
                            </group>
                            <!-- An invoice may be the document its goods travel with -->
                            <group string="Transport Document" name="l10n_pt_transport_group" invisible="move_type != 'out_invoice'">
                                <field name="l10n_pt_is_transport_document" readonly="state != 'draft'"/>
                                <field name="l10n_pt_start_transport_date"
                                       invisible="not l10n_pt_is_transport_document"
                                       required="l10n_pt_is_transport_document and state == 'draft'"
                                       readonly="state != 'draft'"/>
                                <field name="l10n_pt_loading_partner_id"
                                       invisible="not l10n_pt_is_transport_document"
                                       required="l10n_pt_is_transport_document and state == 'draft'"
                                       readonly="state != 'draft'"/>
                                <field name="partner_shipping_id"
                                       string="Unloading Place"
                                       invisible="not l10n_pt_is_transport_document"
                                       required="l10n_pt_is_transport_document and state == 'draft'"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group string="Signature" name="l10n_pt_signature_group" groups="base.group_no_one" invisible="not inalterable_hash">
                                <field name="inalterable_hash"/>
                                <field name="l10n_pt_hashed_on"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <!-- A PT credit note references the invoice it rectifies. -->
                <xpath expr="//page[@id='other_tab']//field[@name='ref']" position="after">
                    <field name="reversed_entry_id"
                           invisible="country_code != 'PT'"
                           required="move_type == 'out_refund' and country_code == 'PT' and payment_state != 'reversed'"
                           readonly="False"
                           options="{'no_quick_create':True,'no_create_edit':True}"
                           domain="[('move_type', 'in', ('out_invoice', 'out_receipt')), ('state', '=', 'posted')]"/>
                </xpath>
                <xpath expr="//page[@id='other_tab']//field[@name='ref']" position="attributes">
                    <attribute name="required">move_type == 'out_refund' and country_code == 'PT'</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_out_invoice_tree_inherit_pt" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.pt</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                   <field name="l10n_pt_document_number" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
