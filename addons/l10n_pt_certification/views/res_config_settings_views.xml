<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='quick_edit_mode']" position="after">
                <block title="Portuguese Localization" id="portugal_localization" invisible="country_code != 'PT'">
                    <setting>
                        <div class="content-group">
                            <div class="mt16">
                                <div class="d-flex mt4 align-items-center">
                                    <button
                                        name="%(l10n_pt_certification.action_open_l10n_pt_at_series_series_list_view)d"
                                        icon="oi-arrow-right" type="action"
                                        string="View Autoridade Tributária (AT) Series" class="btn-link p-1"
                                    />
                                </div>
                            </div>
                        </div>
                    </setting>
                    <separator/>
                    <setting
                        string="AT Series Webservice Configuration"
                        company_dependent="1"
                        help="Production: connect to the live AT webservice. Test: connect to the AT test server. Offline: no connection, AT codes must be entered manually."
                    >
                        <field name="l10n_pt_at_ws_env" widget="radio"/>
                        <div class="text-muted" invisible="l10n_pt_at_ws_env != 'offline'">
                            No connection to AT. Series AT codes must be entered manually.
                        </div>
                        <div class="text-muted" invisible="l10n_pt_at_ws_env != 'test'">
                            Connected to AT test servers. Series registration is not official.
                            <strong>Switch to Production</strong> when ready to communicate live series.
                        </div>
                        <div class="text-muted" invisible="l10n_pt_at_ws_env != 'prod'">
                            Connected to live AT production servers. All series registrations are official.
                        </div>
                        <br/>
                        <div invisible="l10n_pt_at_ws_env == 'offline'">
                            <div class="content-group">
                                <div class="mt16">
                                    <div class="o_row">
                                        <label for="l10n_pt_at_ws_username" class="o_light_label"/>
                                        <field name="l10n_pt_at_ws_username"/>
                                    </div>
                                    <div class="o_row mt16">
                                        <label for="l10n_pt_at_ws_password" class="o_light_label"/>
                                        <field name="l10n_pt_at_ws_password" password="True"/>
                                    </div>
                                    <div class="o_row mt16">
                                        <label for="l10n_pt_at_ws_public_cert_id" class="o_light_label"
                                               string="AT Public Key Certificate"/>
                                        <field name="l10n_pt_at_ws_public_cert_id"/>
                                    </div>
                                    <div class="text-muted">
                                        The AT public key certificate used to encrypt the webservice password.
                                    </div>
                                    <br/>
                                    <field name="l10n_pt_at_ws_ssl_certificate_ids" invisible="1"/>
                                    <button
                                        name="%(l10n_pt_certification.l10n_pt_at_ws_certificate_action)d"
                                        icon="oi-arrow-right" type="action"
                                        string="Manage certificates (AT Series)" class="btn-link p-1"
                                    />
                                    <div class="text-muted">
                                        The SSL client certificate used to authenticate with the AT webservice.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
            <!-- Disable editing the layout to ensure PT requirements are not removed -->
            <xpath expr="//button[@name='edit_external_header']" position="attributes">
                <attribute name="invisible">country_code == 'PT'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
