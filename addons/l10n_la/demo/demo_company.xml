<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_demo_company_la" model="res.partner">
        <field name="name">LA Company</field>
        <field name="street">Lane Xang Avenue</field>
        <field name="city">Vientiane</field>
        <field name="country_id" ref="base.la"/>
        <field name="phone">+856 21 234 567</field>
        <field name="email">info@company.laexample.com</field>
        <field name="website">www.laexample.com</field>
    </record>
    <record id="demo_company_la" model="res.company">
        <field name="name">LA Company</field>
        <field name="partner_id" ref="partner_demo_company_la"/>
    </record>
    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('l10n_la.demo_company_la')]"/>
    </function>
    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(Command.link(ref('l10n_la.demo_company_la')))]}"/>
    </function>
    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>la</value>
        <value model="res.company" eval="obj().env.ref('l10n_la.demo_company_la')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
