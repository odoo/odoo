<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_partner_autocomplete" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.web.partner.autocomplete</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='additional_identifiers' and @widget='additional_identifiers_list']" position="attributes">
                <attribute name="widget">additional_identifiers_list_partner_autocomplete</attribute>
            </xpath>
        </field>
    </record>

    <record id="model_res_partner_enrich" model="ir.actions.server">
        <field name="name">Enrich</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_enrich_partner()
        </field>
    </record>
</odoo>
