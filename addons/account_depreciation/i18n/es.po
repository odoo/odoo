msgstr "No puede volver a evaluar el activo antes de la fecha de bloqueo."

#. module: account_depreciation
#. odoo-python
#: code:addons/account_depreciation/models/account_asset.py:0
msgid ""
"You cannot add or remove bills when the asset is already running or closed."
msgstr ""
"No puede añadir o eliminar facturas cuando el activo ya está en proceso o "
"cerrado."

#. module: account_depreciation
#. odoo-python
#: code:addons/account_depreciation/models/account_asset.py:0
msgid "You cannot archive a record that is not closed"
msgstr "No puedes archivar un registro que no está cerrado"

#. module: account_depreciation
#. odoo-python
#: code:addons/account_depreciation/models/account_asset.py:0
#: code:addons/account_depreciation/wizard/asset_modify.py:0
msgid ""
"You cannot automate the journal entry for an asset that has a running gross "
"increase. Please use 'Dispose' on the increase(s)."
msgstr ""
"No puede automatizar el asiento contable para un activo que tiene un aumento "
"bruto en proceso. Utilice \"Enajenar\" en los aumentos."

#. module: account_depreciation
#. odoo-python
#: code:addons/account_depreciation/models/account_asset.py:0
msgid ""
"You cannot create an asset from lines containing credit and debit on the "
"account or with a null amount"
msgstr ""
"No puede crear un activo a partir de líneas que contienen crédito y débito "
"en la cuenta o con un importe nulo"

#. module: account_depreciation
#. odoo-python
#: code:addons/account_depreciation/models/account_asset.py:0
