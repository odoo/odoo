#. odoo-python
#: code:addons/account_depreciation/models/account_asset.py:0
msgid ""
"A non deductible tax value of %(tax_value)s was added to %(name)s's initial "
"value of %(purchase_value)s"
msgstr ""
"ມູນຄ່າພາສີທີ່ຫັກບໍ່ໄດ້ຈຳນວນ %(tax_value)s ໄດ້ຖືກເພີ່ມເຂົ້າໃນມູນຄ່າເລີ່ມຕົ້ນຂອງ %(name)s ທີ່ມີມູນຄ່າ %"
"(purchase_value)s"

