<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field
                    name="depreciation_board_id"
                    groups="account.group_account_readonly,account.group_account_invoice"
                    invisible="1" />
                <field
                    name="capitalised_board_ids"
                    groups="account.group_account_readonly,account.group_account_invoice"
                    invisible="1" />
                <field
                    name="count_capitalised_asset"
                    groups="account.group_account_readonly,account.group_account_invoice"
                    invisible="1" />
                <field
                    name="draft_asset_exists"
                    groups="account.group_account_readonly,account.group_account_invoice"
                    invisible="1" />
                <button
                    name="open_asset_view"
                    type="object"
                    string="Asset"
                    icon="fa-cube"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not depreciation_board_id"
                    class="oe_stat_button" />
                <button
                    name="action_view_capitalised_asset_ids"
                    type="object"
                    icon="fa-id-card-o"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="count_capitalised_asset == 0 or draft_asset_exists"
                    class="oe_stat_button">
                    <field
                        name="count_capitalised_asset"
                        string="Asset(s)"
                        widget="statinfo" />
                </button>
                <button
                    name="action_view_capitalised_asset_ids"
                    type="object"
                    icon="fa-id-card-o"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="count_capitalised_asset == 0 or not draft_asset_exists"
                    class="oe_stat_button text-danger">
                    <field
                        name="count_capitalised_asset"
                        string="Asset(s)"
                        widget="statinfo" />
                </button>
            </xpath>
            <xpath
                expr="//page[@id='other_tab']//group[@name='accounting_info_group']"
                position="inside">
                <field
                    name="asset_move_type"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not depreciation_board_id and not capitalised_board_ids"
                    readonly="0" />
            </xpath>
            <xpath
                expr="//page[@id='other_tab_entry']//group[@id='other_tab_entry_group']//group[@name='misc_group']"
                position="inside">
                <field
                    name="asset_move_type"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not depreciation_board_id and not capitalised_board_ids"
                    readonly="0" />
            </xpath>
        </field>
    </record>

    <record id="view_account_move_line_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.move.line.form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_form" />
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <group
                    string="Related Assets"
                    groups="account.group_account_invoice,account.group_account_readonly"
                    invisible="not capitalised_board_ids">
                    <field name="capitalised_board_ids" nolabel="1" />
                </group>
            </field>
        </field>
    </record>

    <record id="action_account_aml_to_asset" model="ir.actions.server">
        <field name="name">Create Asset</field>
        <field name="model_id" ref="account.model_account_move_line" />
        <field name="binding_model_id" ref="account.model_account_move_line" />
        <field
            name="group_ids"
            eval="[Command.link(ref('account.group_account_user'))]" />
        <field name="state">code</field>
        <field name="code">if records:
    action = records.turn_as_asset()</field>
    </record>

</odoo>
