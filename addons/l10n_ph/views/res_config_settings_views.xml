<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ph" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ph</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting
                        id="l10n_ph_discount_privileges_setting"
                        string="Discount Privileges"
                        help="Apply statutory discounts on customer invoices and credit notes."
                        documentation="/applications/finance/fiscal_localizations/philippines.html"
                        invisible="account_fiscal_country_id != %(base.ph)d"
                >
                    <field name="module_l10n_ph_invoice" widget="upgrade_boolean"/>
                </setting>
                <setting
                        id="l10n_ph_discount_privileges_sale_setting"
                        string="Discount Privileges on Sale Orders"
                        help="Apply statutory discounts on quotations and sale orders."
                        documentation="/applications/finance/fiscal_localizations/philippines.html"
                        invisible="account_fiscal_country_id != %(base.ph)d"
                >
                    <field name="module_l10n_ph_sale" widget="upgrade_boolean"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
