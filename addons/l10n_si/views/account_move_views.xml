<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_si</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='payment_reference']" position="after">
                <field name="l10n_si_upn_qr_purpose_code"
                       invisible="not l10n_si_show_upn_qr_purpose_code"
                       required="l10n_si_show_upn_qr_purpose_code"/>
            </xpath>
        </field>
    </record>

</odoo>
