<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_si</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices_sepa']" position="attributes">
                <attribute name="invisible" separator="or" add="country_code == 'SI'"/>
            </xpath>
            <xpath expr="//setting[@id='qr_code_invoices_sepa']" position="after">
                <setting id="l10n_si_qr_code_invoices" string="Payment QR Codes" company_dependent="1"
                    help="Add a payment QR code to your invoices: UPN for Slovenian customers, SEPA for others"
                    invisible="country_code != 'SI'">
                    <field name="qr_code" class="oe_inline"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
