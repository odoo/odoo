<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- A vehicle is a record of its own model, so the kind says which. -->
    <record id="resource_asset.kind_vehicle" model="resource.asset.kind">
        <field name="model_name">resource.asset.vehicle</field>
    </record>

    <record id="product_category_vehicle_services" model="product.category">
        <field name="name">Vehicle Services</field>
        <field name="log_type">service</field>
    </record>

    <record id="product_product_vehicle_service" model="product.product">
        <field name="name">Vehicle Service</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_vehicle_services" />
        <field name="sale_ok" eval="False" />
    </record>

</odoo>
