<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_fleet" model="ir.ui.view">
        <field name="name">product.template.form.fleet</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_form" />
        <field name="arch" type="xml">
            <page name="general_information" position="after">
                <page
                    name="vehicle"
                    string="Vehicle"
                    invisible="asset_kind_code != 'vehicle'">
                    <field name="asset_kind_code" invisible="1" />
                    <group>
                        <group name="vehicle_body" string="Model">
                            <field name="vehicle_model_year" />
                            <field name="vehicle_color" />
                            <field name="seats" />
                            <field name="doors" />
                            <field name="trailer_hook" />
                        </group>
                        <group name="vehicle_engine" string="Engine">
                            <field name="fuel_type" />
                            <field name="transmission" />
                            <field name="drive_type" />
                            <label for="power" />
                            <div class="o_row">
                                <field name="power" class="oe_inline" />
                                <field name="power_unit" class="oe_inline" />
                            </div>
                            <field name="horsepower" />
                            <label for="vehicle_range" />
                            <div class="o_row">
                                <field name="vehicle_range" class="oe_inline" />
                                <field name="range_unit" class="oe_inline" />
                            </div>
                            <label for="co2" />
                            <div class="o_row">
                                <field name="co2" class="oe_inline" />
                                <field name="co2_emission_unit" class="oe_inline" />
                            </div>
                        </group>
                        <group name="vehicle_fuel" string="Fuel">
                            <field name="fuel_tank_capacity" />
                            <label for="fuel_efficiency_theoretical" />
                            <div class="o_row">
                                <field
                                    name="fuel_efficiency_theoretical"
                                    class="oe_inline" />
                                <field
                                    name="fuel_efficiency_uom_name"
                                    readonly="1"
                                    class="oe_inline" />
                            </div>
                            <field name="fuel_efficiency_min" />
                            <field name="fuel_efficiency_max" />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="fleet_vehicle_model_action" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('asset_kind_id.code', '=', 'vehicle')]</field>
        <field
            name="context"
            eval="{'default_asset_kind_id': ref('resource_asset.kind_vehicle'), 'default_type': 'consu', 'default_sale_ok': False}" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new vehicle model
            </p>
            <p>
                A model is a product whose units are vehicles: it carries the manufacturer and the specifications every vehicle of the model shares.
            </p>
        </field>
    </record>

</odoo>
