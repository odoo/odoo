<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_account_deletion" model="approval.category">
        <field name="name">Account Deletion</field>
        <field
            name="description">A portal user asking for their account and personal data to be deleted.</field>
        <field name="sequence_code">ACCDEL</field>
        <field name="company_id" eval="False" />
        <field name="approval_minimum">1</field>
        <field name="allow_self_approval" eval="False" />
        <field name="privacy_visibility">private</field>
    </record>

    <record id="approval_category_step_account_deletion" model="approval.category.step">
        <field name="name">Administrator</field>
        <field name="category_id" ref="approval_category_account_deletion" />
        <field name="group_id" ref="base.group_system" />
        <field name="minimum" eval="1" />
        <field name="sequence" eval="10" />
    </record>

    <!--
        Self-service deletions go through as before; archive this rule to have
        an administrator review each request.
    -->
    <record id="approval_rule_account_deletion_self_service" model="approval.rule">
        <field name="name">Self-service deletion</field>
        <field name="category_id" ref="approval_category_account_deletion" />
        <field name="condition_type">domain</field>
        <field name="subject_model_id" ref="base.model_res_users_deletion" />
        <field name="subject_domain">[("id", "!=", False)]</field>
        <field name="action_type">auto_approve</field>
    </record>

</odoo>
