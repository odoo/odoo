<templates xml:space="preserve">
    <t t-name="html_editor.TableMenu">
        <Dropdown menuClass="'m-0'" position="this.props.type === 'column' ? 'bottom' : 'right'" state="this.props.dropdownState" bottomSheet="false">
            <button type="button" t-on-pointerdown.prevent="() => {}" t-att-data-type="this.props.type" class="o-we-table-menu oi" t-attf-class="oi-ellipsis-{{this.props.type === 'column' ? 'h w-100' : 'v h-100 px-0'}}" t-ref="dropdown"/>
            <t t-set-slot="content">
                <div t-on-pointerdown.stop="() => {}">
                    <t t-foreach="this.items" t-as="item" t-key="item_index">
                        <DropdownItem onSelected="() => this.onSelected(item)">
                            <div class="user-select-none" t-att-name="item.name">
                                <span t-if="item.icon" class="me-2 fa" t-att-class="item.icon"/>
                                <span t-out="item.text"/>
                            </div>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
