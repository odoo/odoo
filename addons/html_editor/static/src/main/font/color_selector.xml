<templates xml:space="preserve">

<t t-name="html_editor.ColorSelector">
    <button t-ref="root" class="btn btn-light" t-attf-class="o-select-color-{{props.type}} {{colorSelectorState.isOpen ? 'active' : ''}}" t-att-title="props.title" t-att-disabled="props.isDisabled">
        <t t-if="props.type === 'foreground'">
            <i class="fa-solid fa-font py-1" t-att-style="this.getSelectedColorStyle()"/>
        </t>
        <t t-elif="props.type === 'custom'">
            <i class="fa-solid py-1" t-attf-class="{{props.customIconClass}}" t-att-style="this.getSelectedColorStyle()"/>
        </t>
        <t t-else="">
            <i class="fa-solid fa-paint-brush py-1" t-att-style="this.getSelectedColorStyle()"/>
        </t>
    </button>
</t>

</templates>
