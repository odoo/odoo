<templates xml:space="preserve">

<t t-name="html_editor.ColorSelector">
    <button type="button" t-ref="this.colorSelectorBtn" class="btn btn-light"
        t-attf-class="o-select-color-{{this.props.type}} {{this.colorSelectorState.isOpen ? 'active' : ''}}"
        t-att-title="this.props.title"
        t-att-aria-label="this.props.title"
        t-att-disabled="this.props.isDisabled"
        aria-haspopup="dialog"
        t-att-aria-expanded="this.colorSelectorState.isOpen ? 'true' : 'false'"
        t-att-aria-controls="this.colorSelectorState.isOpen ? this.colorPickerId : false"
    >
        <t t-if="this.props.type === 'foreground'">
            <i class="oi oi-fw py-1" data-icon="A" aria-hidden="true" t-attf-style="--icon-font-family: Arial, sans-serif; {{this.getSelectedColorStyle()}}"/>
        </t>
        <t t-elif="this.props.type === 'custom'">
            <i class="oi oi-fw py-1" t-att-data-icon="this.props.customIcon" aria-hidden="true" t-att-style="this.getSelectedColorStyle()"/>
        </t>
        <t t-else="">
            <i class="oi oi-fw py-1" data-icon="colors" aria-hidden="true" t-att-style="this.getSelectedColorStyle()"/>
        </t>
    </button>
</t>

</templates>
