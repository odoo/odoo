<templates xml:space="preserve">
    <t t-name="html_editor.ImageAlignSelector">
        <Dropdown navigationOptions="this.preview.navigationOptions" state="this.dropdown" menuClass="'o-we-toolbar-dropdown'" menuRef="this.menuRef" focusToggleOnClosed="false">
            <button t-ref="this.imageAlignSelector" class="btn btn-light" t-att-title="this.props.title" name="image_align">
                <span class="oi" t-att-data-icon="this.state.displayIcon"/>
            </button>
            <t t-set-slot="content">
                <div data-prevent-closing-overlay="true" t-on-mouseleave="this.onItemHoverOut">
                    <t t-foreach="this.props.items" t-as="item" t-key="item_index">
                        <DropdownItem
                            tag="'button'"
                            attrs="{ title: item.title, 'data-icon': item.icon, 'data-preview-index': item_index }"
                            class="{
                                'dropdown-item_active_noarrow btn btn-light oi': true,
                                active: item.icon === this.state.displayIcon
                            }"
                            t-on-pointerdown.prevent="() => {}"
                            onSelected="() => this.onSelected(item)"
                        />
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
