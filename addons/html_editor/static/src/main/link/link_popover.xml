<templates id="template" xml:space="preserve">

    <t t-name="html_editor.linkPopover">
        <div class="o-we-linkpopover d-flex overflow-auto" t-on-keydown="this.onKeydown" role="dialog" aria-modal="true" aria-label="Link Popover">
            <div t-if="this.state.editing" class="d-flex p-2" t-ref="this.editingWrapper">
                <div t-if="this.state.isImage" class="o_link_popover_container d-flex align-items-center gap-1">
                    <div class="o_we_link_field flex-grow-1">
                        <label for="o_linkpopover_url_img" class="o_we_input_label" title="URL">
                            <span class="oi" data-icon="link"></span>
                        </label>
                        <input id="o_linkpopover_url_img" name="o_linkpopover_url_img" t-ref="this.urlRef" class="o_we_href_input_link border-dark-subtle form-control form-control-sm" t-model.proxy="this.state.url" title="URL" placeholder="Type your URL"
                            t-on-keydown="this.onKeydownEnter"/>
                    </div>
                    <button class="o_we_apply_link btn btn-sm btn-primary" t-on-click="this.onClickApply">Apply</button>
                </div>
                <div t-else="" class="d-flex">
                    <t t-if="this.state.showAdvancedOptions">
                        <div class="o_advance_option_panel">
                            <div class="o_advance_options_grid" style="width: 200px;">
                                <button class="oi btn btn-secondary border-10" data-icon="keyboard_arrow_left" t-on-click="this.toggleAdvancedOptions"/>
                                <t t-foreach="Object.values(this.state.advancedAttributeOptions)" t-as="opt" t-key="opt.label">
                                    <t t-if="!opt.requires or this.state.advancedAttributeOptions[opt.requires].isChecked">
                                        <div class="o_seo_option_row d-flex justify-content-between align-items-center py-1 gap-2">
                                            <span t-att-title="opt.description"><t t-out="opt.label"/></span>
                                            <CheckBox value="opt.isChecked" onChange="this.toggleAdvancedAttr.bind(this, opt.id)"/>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </t>
                <t t-else="">
                    <div class="o_link_popover_container d-flex flex-column gap-2">
                        <div class="o_we_link_field" t-att-class="{'d-none': !this.state.showLabel}">
                            <label for="o_we_label_link" class="o_we_input_label" title="Label">
                                <span class="oi" data-icon="text_fields"></span>
                            </label>
                            <input t-ref="this.labelRef"
                                id="o_we_label_link"
                                class="o_we_label_link border-dark-subtle form-control form-control-sm"
                                t-model.proxy="this.state.label"
                                title="Label"
                                placeholder="Add a label for your link"
                                t-on-input="this.onChange"/>
                        </div>
                        <div class="o_we_link_field">
                            <label for="o_linkpopover_url" class="o_we_input_label" title="URL">
                                <span class="oi" data-icon="link"></span>
                            </label>
                            <input t-ref="this.urlRef"
                                id="o_linkpopover_url"
                                name="o_linkpopover_url"
                                class="o_we_href_input_link border-dark-subtle form-control form-control-sm"
                                t-model.proxy="this.state.url"
                                title="URL"
                                placeholder="e.g. https://www.odoo.com"
                                t-on-keydown="this.onKeydownEnter"
                                t-on-input="this.onChange"/>
                        </div>
                        <div t-if="this.props.canUpload" class="o_we_upload_link_row d-flex align-items-center gap-1">
                            <span>or</span>
                            <button type="button" class="o_we_upload_link btn btn-link btn-sm d-flex align-items-center gap-1" t-on-click="this.uploadFile">
                                <i class="oi" data-icon="upload"/>
                                <span>Upload a file</span>
                            </button>
                        </div>
                        <div t-if="this.props.includeStyling" class="o_we_link_type btn-group" role="group" aria-label="Link style">
                            <button t-foreach="this.linkTypeItems" t-as="typeData" t-key="typeData.type"
                                    type="button" class="btn btn-sm btn-secondary"
                                    t-att-class="{ active: this.state.type === typeData.type }"
                                    t-att-data-link-type="typeData.type"
                                    t-att-aria-pressed="this.state.type === typeData.type ? 'true' : 'false'"
                                    t-att-title="typeData.label"
                                    t-on-click="() => this.onSelectedLinkType(typeData.type)"
                                    t-out="typeData.shortLabel"/>
                        </div>
                        <div t-if="this.props.includeStyling and this.state.type !== 'link'" class="input-group">
                            <select name="link_style_size" class="form-select form-select-sm border-dark-subtle" t-model.proxy="this.state.buttonSize" t-on-change="this.onChange" aria-label="Select button size">
                                <option t-foreach="this.buttonSizesData" t-as="buttonSizesData" t-key="buttonSizesData.size" t-att-value="buttonSizesData.size"
                                    t-att-selected="this.state.buttonSize === buttonSizesData.size" t-out="buttonSizesData.label"/>
                            </select>
                            <select name="link_style_shape" class="form-select form-select-sm link-style border-dark-subtle" t-model.proxy="this.state.buttonShape" t-on-change="this.onChange" aria-label="Select button shape">
                                <option t-foreach="this.buttonShapesData" t-as="buttonShapeData" t-key="buttonShapeData.shape" t-att-value="buttonShapeData.shape"
                                    t-att-selected="this.state.buttonShape === buttonShapeData.shape" t-out="buttonShapeData.label"/>
                            </select>
                        </div>

                        <t t-if="this.props.allowTargetBlank">
                            <t t-if="this.state.isDocument">
                                <CheckBox
                                    value="this.state.directDownload"
                                    onChange="this.onClickDirectDownload.bind(this)"
                                    className="'direct-download-option'">
                                    Direct download
                                </CheckBox>
                            </t>
                        </t>
                        <t t-if="this.props.allowStripDomain and this.isAbsoluteURLInCurrentDomain()">
                            <CheckBox
                                value="this.state.stripDomain"
                                onChange="this.onClickStripDomain.bind(this)"
                                className="'strip-domain-option'">
                                Autoconvert to relative link
                            </CheckBox>
                        </t>
                        <div class="d-flex align-items-center gap-1">
                            <button class="o_we_apply_link btn btn-sm btn-primary" t-att-disabled="!this.state.url" t-on-click="this.onClickApply">Apply</button>
                            <button class="o_we_discard_link btn btn-sm btn-secondary" t-on-click="this.discard">Discard</button>
                            <button t-if="this.props.canRemove and this.state.url" type="button" class="o_we_remove_link btn btn-sm btn-light ms-auto"
                                    t-on-click="this.onClickRemove" title="Remove Link" aria-label="Remove Link">
                                <i class="oi" data-icon="link_off"></i>
                            </button>
                            <button t-if="Object.keys(this.state.advancedAttributeOptions).length"
                                class="btn btn-sm btn-light"
                                t-att-class="{ 'ms-auto': !(this.props.canRemove and this.state.url) }"
                                title="Advanced mode"
                                aria-label="Advanced mode"
                                t-att-disabled="!this.state.url"
                                t-on-click="this.toggleAdvancedOptions">
                                <i class="oi" data-icon="settings"/>
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
            <div t-else="" class="o_we_link_preview" data-prevent-closing-overlay="true">
                <div class="o_we_link_preview_body">
                    <div class="o_we_link_preview_site d-flex align-items-center gap-1">
                        <span class="o_we_preview_favicon flex-shrink-0">
                            <img t-if="this.state.previewIcon.type === 'imgSrc'" t-att-src="this.state.previewIcon.value" class="align-content-center"/>
                            <span t-elif="this.state.previewIcon.type === 'mimetype'" class="o_image" t-att-data-mimetype="this.state.previewIcon.value"/>
                            <i t-else="" class="oi oi-fw" t-att-class="this.state.previewIcon.class" t-att-data-icon="this.state.previewIcon.value"></i>
                        </span>
                        <span class="o_we_link_preview_host text-truncate" t-out="this.previewHost"/>
                    </div>
                    <div class="o_we_link_preview_text d-flex flex-column">
                        <a
                            href="#"
                            t-att-target="this.linkPreviewTarget"
                            t-attf-href="{{ this.state.url }}"
                            class="o_we_url_link text-truncate"
                            t-attf-title="{{ this.state.urlTitle }}"
                        >
                            <t t-out="this.state.urlTitle"/>
                        </a>
                        <span t-if="this.showUrl" class="o_we_full_url text-muted text-truncate" t-attf-title="{{this.state.url}}">
                            <t t-if="this.state.url" t-out="this.state.url"/>
                            <t t-else="">No URL specified</t>
                        </span>
                    </div>
                    <span t-if="this.state.urlDescription" class="o_we_description_link_preview o_line_clamp" t-attf-title="{{this.state.urlDescription}}">
                        <t t-out="this.state.urlDescription"/>
                    </span>
                    <div t-if="this.state.imgSrc" class="o_extra_info_card">
                        <a href="#" target="_blank" t-attf-href="{{this.state.url}}" title="Open in a new tab">
                            <img t-att-src="this.state.imgSrc" class="img-fluid" t-on-error="() => this.state.imgSrc = ''"/>
                        </a>
                    </div>
                    <div class="o_we_link_preview_actions d-flex align-items-center gap-1">
                        <a href="#" class="o_we_replace_title_btn btn btn-sm btn-light"
                            t-if="this.state.canReplaceTitle and this.state.urlTitle and this.state.label === '' and !this.state.showReplaceTitleBanner"
                            t-on-click="this.onClickReplaceTitle"
                            title="Replace URL with its title" aria-label="Replace URL with its title"
                        >
                            <i class="oi oi-fw" data-icon="wand_stars"></i>
                        </a>
                        <a t-if="this.props.canEdit" href="#" class="o_we_edit_link btn btn-sm btn-light" t-on-click="this.onClickEdit" title="Edit Link">
                            <i class="oi" data-icon="edit"/>
                            <span>Edit</span>
                        </a>
                        <a t-if="this.props.canRemove" href="#" class="o_we_remove_link btn btn-sm btn-light" t-on-click.prevent="this.onClickRemove" title="Remove Link" aria-label="Remove Link">
                            <i class="oi oi-fw" data-icon="link_off"/>
                        </a>
                    </div>
                </div>
                <div t-if="this.state.canReplaceTitle and this.state.urlTitle and this.state.label === '' and this.state.showReplaceTitleBanner" class="d-flex align-items-baseline" style="background-color: var(--primary);">
                    <i class="oi oi-fw m-1" data-icon="wand_stars" style="color: var(--o-cc1-btn-primary-text);"></i>
                    <span class="me-2 flex-grow-1" style="color: var(--o-cc1-btn-primary-text);font-size: smaller;">Replace URL with its title?</span>
                    <button class=" btn btn-sm btn-primary o_we_replace_title_btn" style="margin: 1px;font-size: smaller;" t-on-click="this.onClickReplaceTitle">Yes</button>
                </div>
            </div>
        </div>
    </t>

</templates>
