<templates xml:space="preserve">
    <t t-name="html_editor.Toolbar">
        <div t-ref="this.toolbarEl" role="toolbar" aria-label="Editor toolbar"
            class="o-we-toolbar d-flex m-0 p-1 overflow-x-auto overflow-y-hidden"
            t-att-class="this.props.class"
                t-att-data-namespace="this.state.namespace" data-prevent-closing-overlay="true" t-on-keydown="this.onKeyDown">
            <t t-foreach="this.state.buttonGroups" t-as="buttonGroup" t-key="buttonGroup.id">
                <div t-if="!buttonGroup_first" class="vr my-2"/>
                <div class="o-we-toolbar-group d-flex" role="group" t-att-name="buttonGroup.id">
                    <t t-foreach="buttonGroup.buttons" t-as="button" t-key="button.id">
                            <ToolbarMenu t-if="button.isMenu"
                                id="button.id"
                                title="button.description"
                                icon="button.icon"
                                isActive="button.isActive"
                                isDisabled="button.isDisabled"
                                items="button.items"
                                getSelection.bind="this.props.getSelection"
                                onItemSelected.bind="this.onButtonClick"/>
                            <t t-elif="button.Component">
                                <t t-component="button.Component"
                                    t-props="button.props"
                                    title="button.description"
                                    getSelection.bind="this.props.getSelection"
                                    isDisabled="'isDisabled' in button.props ? button.props.isDisabled : !!button.isDisabled"/>
                            </t>
                            <button t-else=""
                                class="btn btn-light"
                                t-att-class="{
                                    active: button.isActive,
                                    disabled: button.isDisabled,
                                }"
                                t-att-disabled="button.isDisabled"
                                t-att-title="button.description"
                                t-att-name="button.id"
                                t-on-click="() => this.onButtonClick(button)"
                            >
                                <t t-if="button.icon">
                                    <t t-if="button.icon.includes('.')" t-call="{{ button.icon }}"/>
                                    <span t-else="" t-attf-class="oi oi-fw {{button.iconClass || ''}}" t-att-data-icon="button.icon"/>
                                </t>
                                <span t-if="button.text" t-out="button.text"/>
                            </button>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
