<templates xml:space="preserve">
    <t t-name="html_editor.ToolbarMenu">
        <Dropdown state="this.dropdown" menuClass="'o-we-toolbar-menu'" menuRef="this.menuRef" focusToggleOnClosed="false">
            <button t-ref="this.toggleRef" class="btn btn-light" t-att-class="{ active: this.props.isActive }"
                t-att-title="this.props.title" t-att-name="this.props.id" t-att-disabled="this.props.isDisabled">
                <i class="oi oi-fw" t-att-data-icon="this.props.icon or 'more_horiz'"/>
            </button>
            <t t-set-slot="content">
                <div data-prevent-closing-overlay="true">
                    <t t-foreach="this.props.items" t-as="item" t-key="item.id">
                        <t t-if="item.Component">
                            <t t-component="item.Component" t-props="item.props" title="item.description" getSelection="this.props.getSelection" isDisabled="!!item.isDisabled"/>
                        </t>
                        <DropdownItem t-else=""
                            tag="'button'"
                            class="{ 'dropdown-item_active_noarrow d-flex align-items-center gap-2': true, disabled: item.isDisabled }"
                            attrs="{ name: item.id, title: item.description, disabled: item.isDisabled, 'aria-checked': item.isActive ? 'true' : undefined }"
                            onSelected="() => this.onSelected(item)"
                            t-on-pointerdown.prevent="() => {}">
                            <t t-if="item.icon">
                                <t t-if="item.icon.includes('.')" t-call="{{ item.icon }}"/>
                                <i t-else="" t-attf-class="oi oi-fw {{ item.iconClass or '' }}" t-att-data-icon="item.icon"/>
                            </t>
                            <span t-out="item.label or item.text or item.description"/>
                            <span t-if="item.shortcut" class="ms-auto ps-4 text-muted small" t-out="item.shortcut"/>
                            <i t-if="item.isActive" class="o-we-toolbar-menu-check oi oi-fw" t-att-class="{ 'ms-auto': !item.shortcut }" data-icon="check"/>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
