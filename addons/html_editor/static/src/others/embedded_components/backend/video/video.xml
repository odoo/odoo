<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- video settings template -->
    <t t-name="html_editor.VideoSettings">
        <!-- A bar like the toolbar of the other media. -->
        <div t-ref="this.menuRef" class="o-we-toolbar d-flex my-2 p-1" role="toolbar">
            <button class="btn btn-light video-replace-button" t-on-click="this.props.replaceVideo">Replace</button>
            <button class="btn btn-light video-delete-button" title="Remove" t-on-click="this.props.removeVideo">
                <i class="oi oi-fw oi-filled text-danger" data-icon="delete"/>
            </button>
        </div>
    </t>
</templates>
