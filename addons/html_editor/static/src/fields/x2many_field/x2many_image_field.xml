<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="html_editor.ImageField" t-inherit="web.ImageField" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('position-relative')]//div" position="replace">
            <div t-if="!this.env.isParentReadonly()" class="o_image_uploader_container" t-att-class="this.containerClass" aria-atomic="true" t-att-style="this.sizeStyle">
                <button
                    t-if="this.props.record.data[this.props.name] and this.state.isValid"
                    class="o_select_file_button btn btn-secondary o_btn_circle"
                    data-tooltip="Edit"
                    aria-label="Edit"
                    t-on-click.prevent.stop="this.onFileEdit">
                    <i class="oi oi-fw oi-filled" data-icon="edit"/>
                </button>
                <button
                    t-if="this.props.record.data[this.props.name] and this.state.isValid"
                    class="o_clear_file_button btn btn-secondary o_btn_circle"
                    data-tooltip="Clear"
                    aria-label="Clear"
                    t-on-click.prevent.stop="this.onFileRemove">
                    <i class="oi oi-fw" data-icon="delete"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
