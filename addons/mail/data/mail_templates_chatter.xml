<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Discuss utility templates for notifications -->
        <template id="message_user_assigned" technical_usage="mail_post_source">
    <span>Dear <t t-out="object.user_id.sudo().name"/>,</span>
    <br/><br/>
    <span style="margin-top: 8px;">You have been assigned to the <t t-out="model_description or 'document'"/> <t t-out="object.display_name"/>.</span>
    <br/>
        </template>

        <template id="message_activity_done" technical_usage="mail_post_source">
<div>
    <p class="o_mail_activity_title mb-1">
        <span t-attf-class="oi oi-fw oi-filled" t-att-data-icon="activity.activity_type_id.icon"/>
        <span t-if="activity.summary" t-field="activity.summary"/>
        <t t-if="display_assignee"> (originally assigned to <span t-field="activity.user_id.name"/>)</t>
    </p>
    <div t-if="activity.note and not is_html_empty(activity.note)" class="o_mail_activity_note pb-2">
        <div t-field="activity.note" class="fst-italic"/>
    </div>
    <div t-if="feedback">
        <t t-foreach="feedback.split('\n')" t-as="feedback_line">
            <t t-out="feedback_line"/>
            <br t-if="not feedback_line_last"/>
        </t>
    </div>
</div>
        </template>

        <template id="message_activity_assigned" technical_usage="mail_post_source">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <!-- All activities must be assigned to the same user (activities.user_id). -->
    Dear <span t-field="activities.user_id.name"/>,
    <br/><br/>
    <p>
        <span t-field="author.name"/>
        <t t-if="len(activities) == 1">has just assigned you the following activity on document</t>
        <t t-else="">has just assigned you the following activities on document</t>
        "<t t-out="activities[0].res_name"/>"<t t-if="model_description"> (<t t-out="model_description"/>)</t>:
        <ul>
            <li t-foreach="activities" t-as="activity">
                <span t-if="activity.summary" t-field="activity.summary"/>
                <span t-else="" t-field="activity.activity_type_id.name"/>
                - deadline: <span t-field="activity.date_deadline"/>
            </li>
        </ul>
    </p>
</div>
        </template>

        <template id="message_origin_link" technical_usage="mail_post_source">
            <p>
                <t t-if="edit">This <t t-out="self.env['ir.model']._get(self._name).name.lower()"/> has been modified from:</t>
                <t t-else="">This <t t-out="self.env['ir.model']._get(self._name).name.lower()"/> has been created from:</t>
                <t t-foreach="origin" t-as="o">
                    <a href="#" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"> <t t-out="o.display_name"/></a><span t-if="origin.ids[-1:] != o.ids">, </span>
                </t>
            </p>
        </template>

        <template id="discuss_channel_invitation_template">
            <div style="padding: 16px; background-color: #F1F1F1; font-family: Verdana, Arial, sans-serif; color: #454748; width: 100%; display: flex; justify-content: center;">
                <div style="max-width: 590px; width: 100%; background-color: #ffffff; border-radius: 8px; padding: 20px; display: flex; flex-direction: column; align-items: center;">
                    <div style="width: 100%; font-size: 14px; line-height: 1.5; text-align: left;">
                        <t t-out="mail_body"/>
                        <p style="text-align: center; margin: 24px 0;">
                            <a t-attf-href="{{base_url}}{{invitation_url}}"
                               t-attf-style="background-color: {{user.company_id.email_secondary_color or '#875A7B'}}; color: {{user.company_id.email_primary_color or '#FFFFFF'}}; text-decoration: none; padding: 8px 12px; border-radius: 4px; display: inline-block; font-weight: bold;"
                            >
                                Join Channel
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </template>

        <!-- Format tracking values in a minimal blob. No left indent is intended. -->
        <template id="mail_tracking_template">
<div t-if="trackingValues">
    <t t-foreach="trackingValues" t-as="val">
        <em t-if="val.get('company_name')" t-out="val['company_name'] + ': '"/><t t-out="val['old_value']" t-if="val['old_value']"/> → <b t-out="val['new_value']"/> <i>(<t t-out="val['field_label']"/>)</i><br t-if="val_index &lt; len(trackingValues) - 1"/>
    </t>
</div></template>

        <template id="group_change_template">
<div class="o_mail_group_log">
    <t t-if="added">
        <span>Added groups:</span>
        <ul>
            <t t-foreach="added" t-as="group">
                <li><a href="#" data-oe-model="res.groups" t-att-data-oe-id="group.id" t-out="group.display_name"/></li>
            </t>
        </ul>
    </t>
    <t t-if="removed">
        <span>Removed groups:</span>
        <ul>
            <t t-foreach="removed" t-as="group">
                <li><a href="#" data-oe-model="res.groups" t-att-data-oe-id="group.id" t-out="group.display_name"/></li>
            </t>
        </ul>
    </t>
</div>
        </template>
    </data>
</odoo>
