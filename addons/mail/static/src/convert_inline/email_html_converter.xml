<templates>
    <!-- srcdoc is set to force the document in no-quirks mode -->
    <t t-name="mail.EmailHtmlConverterReferenceIframe">
        <iframe t-att-sandbox="this.isBrowserSafari() ? 'allow-same-origin allow-scripts' : 'allow-same-origin'"
            srcdoc="" aria-hidden="true"
            t-attf-style="
                {{ this.isVisible ? `` :
                    `visibility: hidden !important;
                    pointer-events: none !important;
                    position: absolute !important;
                    top: 0 !important;
                    left: -9999px !important;`
                }}
            "/>
    </t>
    <t t-name="mail.EmailHtmlConverterReference">
        <div/>
    </t>
    <t t-name="mail.EmailHtmlConverterHead">
        <meta http-equiv="Content-Security-Policy" content="script-src 'none';"/>
        <meta name="referrer" content="same-origin"/>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
    </t>
</templates>
