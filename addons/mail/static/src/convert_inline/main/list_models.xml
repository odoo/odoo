<templates>
    <t t-name="mail.FakeListContainer">
        <div t-att="this.model.renderAttributes()">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0"
                t-att="this.model.renderAttributes('table')">
                <t t-call="mail.NodePositionManager"
                    t-call-context="this.nodePositionManager.renderContext({ renderPositionedNodes: this.renderPositionedNodes })"/>
            </table>
        </div>
    </t>
    <t t-name="mail.FakeListItem">
        <tr t-att="this.model.renderAttributes()">
            <td t-att="this.model.renderAttributes('cell')">
                <div t-att="this.model.renderAttributes('div')">
                    <t t-call="mail.NodePositionManager"
                        t-call-context="this.nodePositionManager.renderContext({ renderPositionedNodes: this.renderPositionedNodes })"/>
                </div>
            </td>
        </tr>
    </t>
</templates>
