<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.Discuss">
    <div class="o-mail-Discuss d-flex h-100 flex-grow-1" t-att-class="{ 'flex-column align-items-center': this.ui.isSmall(), 'gap-2 p-2': !this.ui.isSmall() and !this.props.hasSidebar, 'pt-2 pe-3 pb-3': !this.ui.isSmall() and this.props.hasSidebar }" t-att-data-active="this.store.discuss.isActive" t-ref="this.root">
        <ResizablePanel
            t-if="!this.ui.isSmall() and this.props.hasSidebar"
            class="'o-mail-DiscussApp-sidebar h-100 z-1 d-print-none'"
            handleSide="'end'"
            initialWidth="this.getSidebarInitialWidth()"
            minWidth="300"
            maxWidthRatio="0.35"
            onResize="(width) => this.store.discuss.sidebarWidth = width"
            foldable="this.store.discuss.canCollapseSidebar()"
            initialFolded="this.getSidebarInitialFolded()"
            onToggle="(folded) => this.store.discuss.isSidebarCollapseEnabled = folded"
            foldInPlace="true"
            hasToggle="false"
            t-slot-scope="panel"
        >
            <MessagingMenu t-if="this.store.discuss.hasRestoredThread" state="this.menuState" onToggleSidebar="panel.toggleFold" folded="panel.folded"/>
        </ResizablePanel>
        <MessagingMenu t-if="this.ui.isSmall()" state="this.menuState"/>
        <DiscussContent t-else="" channel="this.props.channel"/>
    </div>
</t>

</templates>
