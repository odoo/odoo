<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.Discuss">
    <div class="o-mail-Discuss d-flex h-100 flex-grow-1" t-att-class="{ 'flex-column align-items-center': this.ui.isSmall, 'gap-2 p-2': !this.ui.isSmall }" t-att-data-active="this.store.discuss.isActive" t-ref="this.root">
        <ResizablePanel t-if="!this.ui.isSmall and this.props.hasSidebar" class="'o-mail-DiscussApp-sidebar d-flex flex-column h-100 z-1 d-print-none'" handleSide="'end'" initialWidth="this.store.discuss.sidebarWidth" minWidth="300" onResize="(width) => this.store.discuss.sidebarWidth = width">
            <MessagingMenu t-if="this.store.discuss.hasRestoredThread" state="this.menuState"/>
        </ResizablePanel>
        <MessagingMenu t-if="this.ui.isSmall" state="this.menuState"/>
        <div t-else="" class="d-flex flex-row flex-grow-1 gap-1">
            <DiscussContent channel="this.channel"/>
            <t t-set="sideChannel" t-value="this.store.discuss.sideChannel"/>
            <div t-if="sideChannel" class="o-mail-DiscussSideChannel rounded-4 border d-print-none" t-on-keydown="this.onKeydownSideChannel">
                <ChannelPanel channel="sideChannel" close.bind="this.closeSideChannel" title="sideChannel.displayName">
                    <t t-set-slot="header-extra">
                        <button title="Open in Full View" class="btn opacity-75 opacity-100-hover p-1 position-relative" t-on-click="() => sideChannel.setAsDiscussThread()">
                            <i class="oi" data-icon="expand_content"/>
                        </button>
                    </t>
                </ChannelPanel>
            </div>
        </div>
    </div>
</t>

</templates>
