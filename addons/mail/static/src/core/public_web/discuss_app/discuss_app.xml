<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.Discuss">
    <div class="o-mail-Discuss d-flex h-100 flex-grow-1" t-att-class="{ 'flex-column align-items-center': this.ui.isSmall, 'border-top border-dark o-border-opacity-7_5': !this.ui.isSmall }" t-att-data-active="this.store.discuss.isActive" t-ref="this.root">
        <t t-if="!this.ui.isSmall and this.props.hasSidebar">
            <t t-set="sidebarClass" t-value="'o-mail-DiscussApp-sidebar d-flex flex-column h-100 border-end border-dark o-border-opacity-7_5 z-1 o-mail-DiscussApp-sidebarBgColor d-print-none'"/>
            <ResizablePanel t-if="this.menuState().activeTab" class="sidebarClass" handleSide="'end'" initialWidth="this.store.discuss.sidebarWidth" minWidth="300" onResize="(width) => this.store.discuss.sidebarWidth = width">
                <MessagingMenu t-if="this.store.discuss.hasRestoredThread" state="this.menuState"/>
            </ResizablePanel>
            <div t-else="" t-att-class="sidebarClass">
                <MessagingMenu t-if="this.store.discuss.hasRestoredThread" state="this.menuState"/>
            </div>
        </t>
        <MessagingMenu t-if="this.ui.isSmall" state="this.menuState"/>
        <DiscussContent t-else="" thread="this.props.thread"/>
    </div>
</t>

<t t-name="mail.Discuss.loading">
    <div t-if="this.store.channels.status === 'fetching'" class="position-absolute top-0 start-0 d-flex align-items-center justify-content-center h-100 w-100 pe-none">
        <h4 class="text-muted opacity-50 o-visible-short-delay"><b><i class="oi oi-spin o-mail-Discuss-mobileLoading" data-icon="autorenew"/></b></h4>
    </div>
</t>

</templates>
