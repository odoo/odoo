<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.DiscussContent">
    <t t-set="partitionedActions" t-value="this.threadActions.partition"/>
    <div class="o-mail-DiscussContent d-flex flex-column h-100 flex-grow-1 overflow-auto o-scrollbar-thin" t-ref="this.rootRef">
        <div t-if="this.thread" class="o-mail-DiscussContent-header d-flex flex-shrink-0 align-items-center gap-1 z-1 flex-grow-0">
            <div class="o-mail-DiscussContent-headerInfo position-relative flex-grow-1 min-w-0 d-flex" t-ref="this.headerInfoRef">
                <div class="o-mail-DiscussContent-headerBox rounded-4 border position-absolute top-0 start-0 h-100 pe-none" t-att-style="this.headerBoxStyle()"/>
                <div class="position-relative d-flex flex-grow-1 min-w-0 ps-3 pe-2 align-items-center" t-att-class="{ 'py-1': !this.correspondentLocalDateTimeFormatted() }">
                    <div t-if="this.showThreadAvatar" class="o-mail-DiscussContent-threadAvatar position-relative align-self-center align-items-center bg-inherit" t-att-class="this.threadAvatarAttClass" t-ref="this.threadAvatarRef">
                        <DiscussAvatar record="this.thread" size="26"/>
                        <FileUploader t-if="this.isThreadAvatarEditable" acceptedFileExtensions="'.bmp, .jpg, .jpeg, .png, .svg'" showUploadingText="false" multiUpload="false" onUploaded.bind="(data) => this.onFileUploaded(data)">
                            <t t-set-slot="toggler">
                                <a href="#" class="position-absolute z-1 h-100 w-100 rounded-2 start-0 bottom-0" title="Change Picture">
                                    <i class="oi oi-filled position-absolute top-50 start-50 oi-sm text-white" data-icon="edit"/>
                                </a>
                            </t>
                        </FileUploader>
                    </div>
                    <t t-else="">
                        <ThreadIcon className="'align-self-center fs-3 my-2 opacity-75'" size="'large'" thread="this.thread"/>
                    </t>
                    <div class="flex-grow-1 min-w-0 align-self-center align-items-center h-100 py-1" t-att-class="{ 'lh-sm': this.showsChatLocalDateTime }">
                        <div class="d-flex">
                            <div t-if="this.thread.channel?.parent_channel_id" class="d-flex align-items-center gap-1 o-ms-1_5">
                                <span class="fw-bold cursor-pointer opacity-75 opacity-100-hover o-hover-text-underline" t-out="this.thread.channel.parent_channel_id.displayName" t-on-click="() => this.thread?.channel?.parent_channel_id?.open({ focus: true })"/>
                                <i class="oi o-xsmaller o-ms-0_5" data-icon="chevron_forward"/>
                            </div>
                            <AutoresizeInput
                                className="'o-mail-DiscussContent-threadName fw-bold flex-shrink-1 py-0 ' + (this.showsChatLocalDateTime ? 'fs-5' : 'fs-4')"
                                enabled="!!this.thread.channel?.isAllowedToRename"
                                inputRef="this.threadNameInputRef"
                                onValidate.bind="this.renameThread"
                                value="this.threadDisplayName"
                            />
                            <t t-if="this.thread.channel?.allowDescription and (this.thread.channel?.allowEditDescription or this.thread.description)">
                                <t t-set="autogrowDescriptionPlaceholder">Add a description</t>
                                <AutoresizeInput
                                    className="'o-mail-DiscussContent-threadDescription flex-shrink-1 small ms-2'"
                                    enabled="this.thread.channel?.allowEditDescription"
                                    inputRef="this.threadDescriptionInputRef"
                                    onValidate.bind="this.updateThreadDescription"
                                    placeholder="this.thread.channel?.allowEditDescription ? autogrowDescriptionPlaceholder : ''"
                                    value="this.threadDescription"
                                />
                            </t>
                        </div>
                        <div t-if="this.showsChatLocalDateTime" class="text-muted smaller ms-1" t-out="this.correspondentLocalDateTimeFormatted()"/>
                    </div>
                </div>
            </div>
            <div class="pe-1 flex-shrink-0 ms-auto d-print-none">
                <ActionList actions="this.headerActionsList" inline="true" odooControlPanelSwitchStyle="true"/>
            </div>
            <div t-if="this.store.inPublicPage and !this.ui.isSmall" class="d-flex align-items-center">
                <img class="o-mail-DiscussContent-selfAvatar me-1 rounded-3 object-fit-cover flex-shrink-0 smaller" alt="Avatar" t-att-src="this.store.self.avatarUrl"/>
                <div t-if="this.store.self_user" class="text-nowrap px-1 me-2" t-out="this.store.self_user.name"/>
                <AutoresizeInput t-else="" className="'py-1'" onValidate.bind="this.renameGuest" value="this.selfGuestName"/>
            </div>
        </div>
        <div class="o-mail-DiscussContent-main d-flex overflow-hidden flex-grow-1 gap-2" t-att-class="{ 'position-relative': this.ui.isSmall }">
            <t t-if="this.ui.isSmall" t-call="mail.Discuss.loading"/>
            <t t-set="hasActivePanel" t-value="this.threadActions.activeAction?.actionPanelComponentCondition"/>
            <div class="o-mail-DiscussContent-core overflow-auto o-scrollbar-thin d-flex flex-grow-1 w-100 gap-2" t-att-class="{ 'me-1': hasActivePanel, 'me-2': !hasActivePanel }">
                <t name="core-content">
                    <t t-if="this.thread">
                        <div t-if="!this.ui.isSmall or !hasActivePanel" class="d-flex flex-column flex-grow-1 bg-inherit min-w-0 mt-1">
                            <t name="thread"><Thread thread="this.thread" t-key="this.thread.localId" jumpPresent="this.state.jumpThreadPresent" autofocus="this.thread.channel?.composerHidden"/></t>
                            <Composer t-if="!this.thread.channel?.composerHidden" t-key="this.thread.localId" composer="this.thread.composer" autofocus="true" onDiscardCallback="() => (this.thread.composer.replyToMessage = undefined)" onPostCallback.bind="() => this.state.jumpThreadPresent++" dropzoneRef="this.rootRef" type="this.thread.composer.replyToMessage ? (this.thread.composer.replyToMessage.isNote ? 'note' : 'message') : undefined"/>
                            <span t-if="this.thread.channel?.composerHidden and this.thread.channel?.composerHiddenText" class="bg-200 py-1 text-center fst-italic fw-bold text-muted" t-out="this.thread.channel?.composerHiddenText"/>
                        </div>
                        <div t-if="hasActivePanel" t-attf-class="{{ this.threadActions.activeAction.actionPanelOuterClass }}" class="o-mail-DiscussContent-panelContainer rounded-4 border mt-1 flex-shrink-0 d-print-none" t-att-class="{ 'w-100': this.ui.isSmall }">
                            <t t-component="this.threadActions.activeAction.actionPanelComponent" t-props="this.threadActions.activeAction.actionPanelComponentProps"/>
                        </div>
                    </t>
                    <div t-elif="(!this.ui.isSmall or this.isNotificationTabActive) and this.store.discuss.hasRestoredThread" class="d-flex flex-grow-1 align-items-center justify-content-center w-100">
                        <h4 class="text-muted"><b><i>No conversation selected.</i></b></h4>
                    </div>
                </t>
            </div>
        </div>
    </div>
</t>

</templates>
