<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.MessagingMenuItemContextMenu">
    <Dropdown state="this.props.dropdownState" manual="true" menuClass="this.store.discussDropdownMenuClass(this)" position="'right-start'" noClasses="true">
        <span class="d-flex position-fixed z-1" t-ref="this.anchorRef"/>
        <t t-set-slot="content">
            <ActionList actions="this.actionsList" dropdown="true"/>
        </t>
    </Dropdown>
</t>

</templates>
