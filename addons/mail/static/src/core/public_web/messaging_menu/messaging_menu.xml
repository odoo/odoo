<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.MessagingMenu">
    <div class="o-mail-MessagingMenu-container d-flex flex-grow-1 min-h-0 min-w-0 h-100"
        t-att-class="{
            'gap-2 w-100': !this.isCollapsible(),
            'ps-3': this.isCollapsible() and !this.visibleTabs.length,
            'overflow-hidden': !this.peek.isOpen(),
            'o-peek': this.peek.isOpen(),
        }"
        t-ref="this.containerRef"
    >
        <t t-call="mail.MessagingMenu-navigation"/>
        <!-- Peeking, the list floats `m-1` inset; its padding and corners shrink as much. -->
        <div class="o-mail-MessagingMenu d-flex flex-column flex-grow-1 overflow-hidden min-h-0 min-w-0"
            t-att-class="{
                'border': this.ancestors.inDiscussApp or this.ui.isSmall(),
                'rounded-4': this.ui.isSmall(),
                'rounded-start-4': this.isCollapsible() and !this.peek.isOpen(),
                'rounded-0 border-start': !this.ancestors.inDiscussApp and !this.ui.isSmall(),
                'rounded-3 shadow-lg m-1': this.peek.isOpen(),
            }">
            <div class="o-mail-MessagingMenu-searchContainer d-flex flex-column gap-2" t-att-class="{ 'px-2 o-py-2_5': !this.peek.isOpen(), 'px-1 pt-2 o-pb-2_5': this.peek.isOpen() }">
                <div class="o-mail-MessagingMenu-searchRow d-flex align-items-stretch gap-1">
                    <t t-foreach="this.activeTab().actions" t-as="action" t-key="action.id">
                        <div t-if="action.subActions?.length" class="flex-shrink-0">
                            <IsolatedDropdown
                                items="action.subActions.map(subAction => ({ id: subAction.id, label: subAction.text, onSelected: () => this.onClickAction(subAction) }))"
                                menuClass="'o-mail-MessagingMenu-dropdownMenu'"
                                onOpened="() => this.focusSearchInput()"
                            >
                                <t t-call="mail.MessagingMenu-action"/>
                            </IsolatedDropdown>
                        </div>
                        <t t-else="" t-call="mail.MessagingMenu-action"/>
                    </t>
                    <DiscussSearch autofocus="this.searchInputAutofocus" class="'flex-grow-1 min-w-0'" messagingMenuUiState="this.state"/>
                </div>
                <div t-if="this.activeTab().filters.length" class="o-mail-MessagingMenu-filters d-flex align-items-center flex-nowrap gap-1" role="tablist">
                    <button
                        class="o-mail-MessagingMenu-filter btn btn-sm rounded-pill o-px-2_5 o-py-0_5 flex-shrink-0"
                        t-att-class="{ 'o-active': !this.state().selectedFilter, 'text-muted': this.state().selectedFilter }"
                        t-att-aria-pressed="!this.state().selectedFilter"
                        t-on-click="() => this.state().selectedFilter = undefined"
                        data-available-offline=""
                    >All</button>
                    <button
                        t-foreach="this.activeTab().sortedFilters"
                        t-as="filter"
                        t-key="filter.id"
                        class="o-mail-MessagingMenu-filter btn btn-sm rounded-pill o-px-2_5 o-py-0_5 flex-shrink-0"
                        t-att-class="{ 'o-active': this.state().selectedFilter?.id === filter.id, 'text-muted': this.state().selectedFilter?.id !== filter.id }"
                        t-att-aria-pressed="this.state().selectedFilter?.id === filter.id"
                        t-on-click="() => this.state().selectedFilter = filter"
                        data-available-offline=""
                        t-out="filter.text"
                    />
                </div>
            </div>
            <div t-ref="this.tabContentRef" class="o-mail-MessagingMenu-tabContent d-flex flex-column overflow-auto o-scrollbar-thin flex-grow-1 o-gap-0_5" t-att-class="{ 'o-px-1_5': !this.peek.isOpen(), 'o-px-0_5': this.peek.isOpen() }">
                <NotificationItem
                    t-if="this.showPushPermissionRequest"
                    className="'bg-info o-my-0_5'"
                    important="1"
                    onClick="() => this.notification.requestPermission()"
                    persona="this.notificationRequest.partner"
                >
                    <t t-set-slot="body" t-out="this.notificationRequest.body"/>
                    <t t-set-slot="name"><t t-out="this.notificationRequest.displayName"/></t>
                    <t t-set-slot="sideContent">
                        <div class="d-flex align-items-center justify-content-center o-gap-1_5">
                            <a class="btn btn-info btn-sm rounded-pill px-2 py-0">Enable</a>
                            <span t-if="!this.hasTouch()" t-on-click.stop="() => this.store.isNotificationPermissionDismissed = true" class="oi text-dark bg-transparent opacity-50 opacity-100-hover" data-icon="close_small" title="Dismiss"></span>
                        </div>
                    </t>
                </NotificationItem>
                <t name="messagingMenuExtraItems"/>
                <MessagingMenuItem
                    t-foreach="this.messages()" t-as="message" t-key="message.localId"
                    message="message"
                    activeTab="this.activeTab"
                    onClick="this.onClickMessage"
                />
                <t t-if="this.isEmpty">
                    <MessagingMenuEmpty t-if="this.noSearchResultText" title="this.noSearchResultText"/>
                    <t t-elif="this.activeTab().getLoadStatus(this.state().selectedFilter, this.state().activePluginFilters) === 'loaded'">
                        <MessagingMenuEmpty t-if="(this.state().selectedFilter and !this.state().selectedFilter.isDefault) or this.state().activePluginFilters.length" title="this.noFilterResultText"/>
                        <t t-elif="this.activeTab().emptyState">
                            <t t-set="emptyState" t-value="this.activeTab().emptyState"/>
                            <t t-if="emptyState.component" t-component="emptyState.component" tab="this.activeTab()" title="emptyState.title" subtitle="emptyState.subtitle" close="this.close"/>
                            <MessagingMenuEmpty t-else="" title="emptyState.title" subtitle="emptyState.subtitle" action="emptyState.action"/>
                        </t>
                    </t>
                </t>
            </div>
        </div>
    </div>
</t>

<t t-name="mail.MessagingMenu-action">
    <t t-set="togglesDropdown" t-value="action.subActions?.length"/>
    <button
        class="btn btn-sm btn-primary rounded-3 py-1 o-my-0_5 d-flex align-items-center justify-content-center"
        t-att-class="togglesDropdown ? 'w-100 position-relative pe-4' : 'flex-shrink-0'"
        t-att-disabled="action.isDisabled?.()"
        t-att-title="action.title"
        t-on-click="() => togglesDropdown ? undefined : this.onClickAction(action)"
    >
        <span t-if="action.icon" class="d-flex align-items-center flex-shrink-0" t-att-class="{'me-1': action.text}">
            <i class="oi oi-fw" t-att-class="action.iconClass" t-att-data-icon="action.icon"/>
        </span>
        <span t-if="action.text" class="text-truncate" t-out="action.text"/>
        <span t-if="togglesDropdown" class="oi oi-fw position-absolute end-0 me-1" data-icon="keyboard_arrow_down" aria-hidden="true"/>
    </button>
</t>

<t t-name="mail.MessagingMenu-navigation">
    <nav t-if="this.visibleTabs.length" class="o-mail-MessagingMenu-navbar d-flex flex-column flex-shrink-0 px-1 o-py-2_5 gap-2 overflow-auto h-100 o-scrollbar-thin">
        <t t-if="this.isCollapsible() and this.store.discuss.canCollapseSidebar()">
            <button
                class="o-mail-MessagingMenu-toggleSidebar btn btn-secondary align-self-center flex-shrink-0"
                t-att-aria-expanded="!this.store.discuss.isSidebarCollapsed"
                t-att-aria-label="this.toggleSidebarTitle()"
                t-att-title="this.toggleSidebarTitle()"
                t-on-click="() => this.onClickToggleSidebar()"
            >
                <i class="oi opacity-75" t-att-data-icon="this.store.discuss.isSidebarCollapsed ? 'left_panel_open' : 'left_panel_close'"/>
            </button>
        </t>
        <button
            t-foreach="this.visibleTabs" t-key="tab.localId" t-as="tab"
            class="o-mail-MessagingMenu-tab btn d-flex flex-column align-items-center w-100 flex-shrink-0 p-1 bg-transparent position-relative border-0"
            t-att-class="{
                'active': this.selectedTab().eq(tab),
                'o-peeked': this.activeTab().eq(tab) and this.selectedTab().notEq(tab),
                'pb-4': this.isIosPwa,
                'pb-2': !this.isIosPwa,
            }"
            t-on-click="(ev) => this.onClickTab(ev, tab)"
            t-on-focus="(ev) => this.onFocusTab(ev, tab)"
            t-on-pointerenter="(ev) => this.onPointerenterTab(ev, tab)"
            t-att-aria-label="tab.label"
            t-att-data-id="tab.id"
            data-available-offline=""
        >
            <i t-attf-class="oi o-mail-MessagingMenu-tabIcon {{tab.iconClass}} rounded-pill mx-auto p-2 fs-5" t-att-data-icon="this.selectedTab().eq(tab) and tab.activeIcon ? tab.activeIcon : tab.icon"/>
            <span class="o-mail-MessagingMenu-tabLabel o-xsmaller text-center lh-1 mt-1" t-out="tab.label"/>
            <span t-if="this.getTabCounter(tab)" t-attf-class="badge o-discuss-badge rounded-pill position-absolute o-mail-MessagingMenu-tabCounter overflow-visible d-inline-block {{ tab.important ? '' : 'o-muted' }}" t-out="this.getTabCounter(tab)"/>
        </button>
        <div t-if="this.store.inPublicPage and this.isCollapsible()" class="o-mail-MessagingMenu-self d-flex justify-content-center mt-auto flex-shrink-0">
            <div t-if="this.store.self_user" class="d-flex flex-column align-items-center gap-1 p-1 mw-100" t-att-title="this.store.self.name">
                <t t-call="mail.MessagingMenu.self"/>
            </div>
            <button t-else="" class="o-mail-MessagingMenu-selfToggler btn d-flex flex-column align-items-center gap-1 p-1 rounded-3 mw-100" title="Change your name" t-on-click="(ev) => this.onClickSelf(ev)">
                <t t-call="mail.MessagingMenu.self"/>
            </button>
        </div>
    </nav>
</t>

<t t-name="mail.MessagingMenu.self">
    <img class="o-mail-MessagingMenu-selfAvatar rounded-3 object-fit-cover" alt="Avatar" t-att-src="this.store.self.avatarUrl"/>
    <span class="o-mail-MessagingMenu-selfName o-xsmaller text-center text-break lh-1 mw-100" t-out="this.store.self.name"/>
</t>

<t t-name="mail.GuestNamePopover">
    <div class="o-mail-GuestNamePopover p-2">
        <label class="form-label small text-muted mb-1" for="o-mail-GuestNamePopover-name">Your name</label>
        <input
            id="o-mail-GuestNamePopover-name"
            t-ref="this.inputRef"
            class="o-mail-GuestNamePopover-name form-control form-control-sm bg-view rounded-3"
            type="text"
            t-att-value="this.store.self_guest.name"
            t-on-change="(ev) => this.rename(ev.target.value)"
            t-on-keydown="(ev) => this.onKeydown(ev)"
        />
    </div>
</t>

</templates>
