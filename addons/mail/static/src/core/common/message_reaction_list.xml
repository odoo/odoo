<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">
    <t t-name="mail.MessageReactionList">
        <Dropdown state="this.preview" position="'top-middle'" menuClass="'mt-1 overflow-visible ' + this.store.discussDropdownMenuClass(this)" menuRef="this.reactionPreviewRef" manual="true" bottomSheet="false" focusToggleOnClosed="false">
            <t t-call="mail.MessageReactionList.button" />
            <t t-set-slot="content">
                <t t-call="mail.MessageReactionList.preview"/>
            </t>
        </Dropdown>
    </t>

    <t t-name="mail.MessageReactionList.button">
        <t t-set="messageAtRender" t-value="this.props.message()"/>
        <t t-set="reactionAtRender" t-value="this.props.reaction()"/>
        <button class="position-relative o-mail-MessageReaction btn d-flex p-0 bg-view border o-rounded-bubble mb-1 fs-5 px-1 gap-1 align-items-center" t-on-click="(ev) => this.onClickReaction(ev, { messageAtRender, reactionAtRender })" t-on-contextmenu="this.onContextMenu" t-on-mouseenter="this.loadEmoji" t-ref="this.reactionButtonRef" t-att-class="{
            'o-selfReacted border-primary text-primary fw-bold': this.hasSelfReacted(this.props.message(), this.props.reaction()),
            'border-secondary': !this.hasSelfReacted(this.props.message(), this.props.reaction()),
            'ms-1': this.env.inChatWindow and this.env.alignedRight,
            'me-1': !(this.env.inChatWindow and this.env.alignedRight),
            'cursor-default': !this.props.message().canAddReaction,
        }">
            <span t-out="this.props.reaction().content"/>
            <span class="small" t-out="this.props.reaction().count"/>
        </button>
    </t>

    <t t-name="mail.MessageReactionList.preview">
        <t t-set="reactionAtRender" t-value="this.props.reaction()"/>
        <div class="o-mail-MessageReactionList-preview px-0 py-1 cursor-pointer d-flex" t-on-click="(ev) => this.onClickReactionList(ev, { reactionAtRender })">
            <div class="d-flex align-items-center mx-2 gap-2">
                <span class="fs-1" t-out="this.props.reaction().content"/>
                <span class="o-mail-MessageReactionList-previewText small me-1" t-out="this.previewText(this.props.reaction())"/>
            </div>
        </div>
    </t>

</template>
