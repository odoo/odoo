<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

 <t t-name="mail.ThreadIcon">
 <div class="o-mail-ThreadIcon d-flex justify-content-center flex-shrink-0" t-att-class="this.props.className">
 <t t-set="largeClass" t-value="this.props.size === 'large' ? 'fa-lg' : ''"/>
 <t t-if="this.props.thread.channel_type === 'channel'">
 <div t-if="this.props.thread.group_public_id" class="fa-solid fa-hashtag" t-att-class="largeClass" t-att-title="this.props.thread.accessRestrictedToGroupText"/>
 <div t-else="" class="fa-solid fa-earth-americas" t-att-class="largeClass" title="Public Channel"/>
 </t>
 <t t-elif="this.props.thread.channel_type?.includes('chat') and this.correspondent">
 <t name="chat">
 <t name="chat_static">
 <ImStatus t-if="this.correspondent.im_status" member="this.correspondent" size="'md'"/>
 <div t-else="" class="d-flex rounded-circle bg-inherit">
 <i class="" t-att-class="largeClass" t-attf-class="#{ this.defaultChatIcon.class }" t-att-title="this.defaultChatIcon.title"/>
 </div>
 </t>
 </t>
 </t>
 <div t-elif="this.props.thread.channel_type === 'group'" class="o-mail-ThreadIcon oi oi-users" t-att-class="largeClass" title="Grouped Chat"/>
 <t t-elif="this.props.thread.model === 'mail.box'">
 <div t-if="this.props.thread.id === 'inbox'" class="fa-solid fa-inbox " t-att-class="largeClass"/>
 <div t-elif="this.props.thread.id === 'starred'" class="fa-regular fa-star " t-att-class="largeClass"/>
 <div t-elif="this.props.thread.id === 'history'" class="fa-solid fa-history " t-att-class="largeClass"/>
 </t>
 </div>
 </t>

</templates>
