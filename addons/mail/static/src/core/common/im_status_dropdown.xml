<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.ImStatusDropdown">
        <Dropdown menuClass="'o-mail-ImStatusDropdown'">
            <a href="#" t-att-class="{ 'd-block text-body py-2 d-flex flex-row align-items-baseline gap-2': this.uiService.isSmall() }">
                <ImStatus user="this.store.self_user"/> <span t-out="this.readableImStatus"/> <i t-if="this.uiService.isSmall()" class="oi ms-auto mt-1" data-icon="chevron_forward"/>
            </a>
            <t t-set-slot="content">
                <DropdownItem class="{ 'active': this.store.self_user.imStatusUI === 'online' }" onSelected="() => this.setManualImStatus('online')"><i class="oi oi-filled text-success me-1" data-icon="circle" title="Online" role="img"/> Online</DropdownItem>
                <hr class="my-1"/>
                <DropdownItem class="{ 'active': this.store.self_user.imStatusUI === 'away' }" onSelected="() => this.setManualImStatus('away')"><i class="oi o-yellow me-1" data-icon="contrast" title="Away" role="img"/> Away</DropdownItem>
                <DropdownItem class="{ 'active': this.store.self_user.imStatusUI === 'busy' }" onSelected="() => this.setManualImStatus('busy')">
                    <i class="oi oi-filled text-danger me-1" data-icon="remove_circle" title="Busy" role="img"/> Do Not Disturb
                    <div class="small text-muted">You will not receive any notifications</div>
                </DropdownItem>
                <DropdownItem class="{ 'active': this.store.self_user.imStatusUI === 'offline' }" onSelected="() => this.setManualImStatus('offline')"><i class="oi text-700 opacity-75 me-1" data-icon="circle" title="Offline" role="img"/> Offline</DropdownItem>
                <hr class="my-1"/>
                <div class="o-mail-ImStatusDropdown-statusMessage position-relative px-2 py-1">
                    <input type="text" class="form-control px-3 rounded-pill"
                        t-att-class="{ 'pe-4': this.store.self_user.status_message }"
                        placeholder="Set a status message"
                        aria-label="Status message"
                        autocomplete="off"
                        maxlength="100"
                        t-att-value="this.store.self_user.status_message or ''"
                        t-on-change="(ev) => this.setStatusMessage(ev.target.value)"
                        t-on-keydown="(ev) => ev.key === 'Enter' and ev.stopPropagation()"/>
                    <button t-if="this.store.self_user.status_message" type="button" class="btn btn-link text-reset p-0 border-0 shadow-none position-absolute top-0 bottom-0 end-0 me-3 d-flex align-items-center opacity-50 opacity-100-hover" title="Clear status message" aria-label="Clear status message" t-on-click="() => this.setStatusMessage('')">
                        <i class="oi oi-filled" data-icon="cancel" aria-hidden="true"/>
                    </button>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
