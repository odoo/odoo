<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.DiscussAvatar">
        <span class="o-mail-DiscussAvatar position-relative d-inline-block flex-shrink-0" t-attf-class="{{ this.props.className }}" t-att-style="'--o-mail-DiscussAvatar-iconScale: ' + this.iconScale" t-ref="this.rootRef">
            <svg t-att-width="this.props.size" t-att-height="this.props.size" t-att-viewBox="'0 0 ' + this.props.size + ' ' + this.props.size" class="d-block overflow-visible">
                <mask t-att-id="this.uniqueId" width="1000" height="1000">
                    <rect x="0" y="0" height="100%" width="100%" fill="white"/>
                    <!-- geometry of the icon mask is computed from the rendered icon, see updateIconMask -->
                    <t t-if="this.showIconMask">
                        <t t-set="imStatusData" t-value="this.imStatusData"/>
                        <t t-set="safariNonBreakingSpace" t-value="this.isBrowserSafari() ? ' ' : ''"/> <!-- hack for making mask work in Safari -->
                        <t t-if="imStatusData">
                            <!-- glyph is a ligature, i.e. text: keep it out of the text content of the avatar -->
                            <Portal target="'body'">
                                <svg width="0" height="0" class="position-absolute" aria-hidden="true">
                                    <defs>
                                        <text t-att-id="this.uniqueId + '.imStatus'" class="oi oi-filled o-mail-DiscussAvatar-imStatusMask" t-att-class="imStatusData.iconClass" t-att-data-mask-icon="imStatusData.icon" dominant-baseline="central" fill="black" stroke="black" t-att-stroke-width="this.iconMaskGap * 2" stroke-linejoin="round" aria-hidden="true" t-out="imStatusData.icon + safariNonBreakingSpace"/>
                                    </defs>
                                </svg>
                            </Portal>
                            <use t-att-href="'#' + this.uniqueId + '.imStatus'" t-ref="this.glyphMaskRef"/>
                        </t>
                        <rect t-else="" fill="black" t-ref="this.rectMaskRef"/>
                    </t>
                </mask>
                <foreignObject x="0" y="0" width="100%" height="100%" t-att-mask="'url(#' + this.uniqueId + ')'">
                    <t t-call="mail.DiscussAvatar.avatarImg"/> <!-- FIXME: owl doesn't like and load immediate <img> below <foreignObject>, hence t-call shenanigans -->
                </foreignObject>
            </svg>
            <span t-if="this.showIcon" class="o-mail-DiscussAvatar-icon position-absolute d-flex" t-ref="this.iconRef">
                <ThreadIcon t-if="this.thread" thread="this.thread" typing="this.props.typing"/>
                <ImStatus t-elif="this.channelMember" member="this.channelMember" className="'d-flex'" size="'md'" typing="this.props.typing"/>
                <ImStatus t-elif="this.user" user="this.user" persona="this.persona"  typing="this.props.typing"/>
                <ImStatus t-elif="this.persona" persona="this.persona" typing="this.props.typing"/>
            </span>
        </span>
    </t>

    <t t-name="mail.DiscussAvatar.avatarImg">
        <img t-if="this.thread" class="w-100 h-100 object-fit-cover" t-att-class="{ [this.props.imgRoundedClass]: this.props.imgRoundedClass, 'rounded-2': !this.props.imgRoundedClass }" t-att-src="this.thread.channel?.parent_channel_id?.avatarUrl ?? this.thread.channel?.avatarUrl ?? this.thread.avatarUrl" alt="Thread Image"/>
        <img t-elif="this.channelMember" alt="" class="w-100 h-100 object-fit-cover" t-att-class="{ [this.props.imgRoundedClass]: this.props.imgRoundedClass, 'rounded-3': !this.props.imgRoundedClass }" t-att-src="this.channelMember.avatarUrl"/>
        <img
            t-elif="this.user or this.persona"
            class="w-100 h-100 object-fit-cover"
            t-att-class="{ [this.props.imgRoundedClass]: this.props.imgRoundedClass, 'rounded': !this.props.imgRoundedClass }"
            t-att-src="(this.user || this.persona).avatarUrl"
            alt=""
        />
    </t>
</templates>
