<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail.MessageReactionMenu">
        <Dialog size="'md'" header="false" footer="false" contentClass="this.contentClass">
            <Tabs ref="this.tabsRef" initialTabId="this.props.initialReaction?.content"  direction="this.store.useMobileView ? 'h' : 'v'">
                <Tab t-foreach="this.props.message.sortedReactions" t-as="reaction" t-key="reaction.content" id="reaction.content" title="this.getEmojiShortcode(reaction)">
                    <t t-set-slot="header">
                        <span class="mx-1 fs-2" t-out="reaction.content"/>
                        <span class="mx-1" t-out="reaction.count"/>
                    </t>
                    <div t-foreach="reaction.personas" t-as="persona" t-key="persona.id" class="o-mail-MessageReactionMenu-persona d-flex p-1 align-items-center" t-att-class="{'o-isDeviceSmall': this.ui.isSmall}">
                        <img class="rounded object-fit-cover o-mail-MessageReactionMenu-avatar" t-att-src="persona.avatarUrl"/>
                        <span class="d-flex flex-grow-1 align-items-center">
                            <span class="mx-2 text-truncate fs-6" t-out="this.props.message.getPersonaName(persona)"/>
                            <div class="flex-grow-1"/>
                            <button t-if="this.props.message.effectiveSelf.eq(persona)" class="btn btn-light oi oi-filled rounded-pill bg-inherit border-0" data-icon="delete" title="Remove" t-on-click.stop="() => reaction.remove()"/>
                        </span>
                    </div>
                </Tab>
            </Tabs>
        </Dialog>
    </t>

</templates>
