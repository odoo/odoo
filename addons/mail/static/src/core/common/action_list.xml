<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.ActionList">
    <div class="o-mail-ActionList" t-att-class="{ 'align-items-center': this.props.inline }">
        <t t-set="groupAttClass" t-value="{
            [this.props.groupClass]: true,
            'btn-group': !this.props.dropdown,
            'btn-group-vertical': this.props.dropdown,
            'o-inline rounded-3': this.props.inline,
            'o-rounded-bubble': this.props.inline,
        }"/>
        <t t-foreach="this.groups()" t-as="group" t-key="group_index">
            <span t-if="group.length" class="o-mail-ActionList-group" t-att-class="groupAttClass">
                <Action t-foreach="group" t-as="action" t-key="action.id" t-props="this.getActionProps(action, group, { index: action_index })"/>
            </span>
            <t t-if="!group_last" t-call="mail.ActionList.groupSeparator"/>
        </t>
    </div>
</t>

<t t-name="mail.ActionList.groupSeparator">
    <span t-if="this.props.inline" class="text-muted align-self-stretch ms-2 me-1"/>
    <hr t-else="" class="mx-2 my-1 o-rounded-bubble o-discuss-separator"/>
</t>

<t t-name="mail.Action">
    <t t-if="this.action.dropdownTrigger">
        <t t-component="this.Dropdown" menuClass="(this.action.dropdownMenuClass ?? '') + ' ' + this.store.discussDropdownMenuClass(this)" position="this.action.dropdownPosition" state="this.action.dropdownState">
            <t t-call="mail.Action.toggler"/>
            <t t-set-slot="content">
                <t t-if="this.action.dropdownComponent" t-component="this.action.dropdownComponent" t-props="this.action.dropdownComponentProps"/>
                <t t-elif="this.action.dropdownTemplate" t-call="{{ this.action.dropdownTemplate }}"
                    templateParams="this.action.dropdownTemplateParams"/>
                <t t-elif="this.action.definition?.isMoreAction">
                    <t t-component="this.ActionList" actions="this.action.definition.actionsSignal" dropdown="true"/>
                </t>
                <t t-else="">No content.</t>
            </t>
        </t>
    </t>
    <t t-else="" t-call="mail.Action.toggler"/>
</t>

<t t-name="mail.Action.toggler">
    <ActionDropdown t-if="this.props.dropdown" action="this.props.action" style="this.props.style" dropdown="this.props.dropdown" inline="this.props.inline"/>
    <ActionButton t-else="" action="this.props.action" style="this.props.style" dropdown="this.props.dropdown" inline="this.props.inline" rounded="this.action.definition.propsInline?.rounded" variant="this.action.definition.propsInline?.variant"/>
</t>

</templates>
