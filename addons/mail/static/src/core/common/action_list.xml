<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.ActionList">
    <div class="o-mail-ActionList flex-shrink-0 d-flex" t-att-class="{ 'align-items-center': this.props.inline,'flex-column': !this.props.inline }">
        <t t-foreach="this.groups()" t-as="group" t-key="group_index">
            <t t-if="group.length">
                <t t-set="firstActionInGroup" t-value="group[0]"/>
                <t t-set="groupDescription" t-value="firstActionInGroup.actions?.actionGroupDescriptions.get(firstActionInGroup.sequenceGroup)"/>
                <span class="o-mail-ActionList-group" t-att-class="{
                    [this.props.groupClass]: true,
                    'btn-group': !this.props.dropdown,
                    'flex-column w-100 bg-transparent': !this.props.inline,
                    'o-inline rounded-3': this.props.inline,
                    'o-rounded-bubble': this.props.inline and !this.props.hasBtnBg,
                    'o_switcher': this.props.hasBtnBg and group.length gt 1 and this.props.inline and groupDescription?.tags?.includes('INLINE_SWITCHER_LOOK'),
                }">
                    <span class="smaller text-muted ms-1" t-if="this.props.dropdown and groupDescription?.name" t-out="groupDescription?.name"/>
                    <t t-foreach="group" t-as="action" t-key="action.id" t-component="this.getActionComponent(action)" t-props="this.getActionProps(action, group, { isFirstInGroup: action_first, index: action_index, isLastInGroup: action_last })"/>
                </span>
            </t>
            <t t-if="!group_last" t-call="mail.ActionList.groupSeparator"/>
        </t>
    </div>
</t>

<t t-name="mail.ActionList.groupSeparator">
    <span t-if="this.props.inline" class="text-muted align-self-stretch ms-2 me-1"/>
    <hr t-else="" class="mx-2 my-1 o-rounded-bubble o-discuss-separator"/>
</t>

<!-- Shared by the templates of InlineAction and DropdownAction, which give their button as body. -->
<t t-name="mail.Action">
    <t t-if="this.action.dropdownTrigger">
        <t t-component="this.Dropdown" menuClass="(this.action.dropdownMenuClass ?? '') + ' ' + this.store.discussDropdownMenuClass(this.ancestors)" position="this.action.dropdownPosition" state="this.action.dropdownState">
            <t t-out="0"/>
            <t t-set-slot="content">
                <t t-if="this.action.dropdownComponent" t-component="this.action.dropdownComponent" t-props="this.action.dropdownComponentProps"/>
                <t t-elif="this.action.dropdownTemplate" t-call="{{ this.action.dropdownTemplate }}"
                    templateParams="this.action.dropdownTemplateParams"/>
                <t t-elif="this.action.definition?.isMoreAction">
                    <t t-component="this.ActionList" actions="this.action.definition.actionsSignal" dropdown="true" actionComponent="this.dropdownActionComponent" parentAction="this.action"/>
                </t>
                <t t-else="">No content.</t>
            </t>
        </t>
    </t>
    <t t-else="" t-out="0"/>
</t>

<t t-name="mail.InlineAction">
    <t t-call="mail.Action">
        <button t-ref="this.props.action.actionRef" t-att-class="this.btnClass" t-att="this.attrs" t-on-click="(ev) => this.onSelected(this.action, ev)" t-att-data-hotkey="this.action.hotkey" t-att-style="this.props.style">
            <t t-call="mail.Action.icon"/>
            <t t-call="mail.Action.label"/>
            <t t-call="mail.Action.extraContent"/>
            <t t-if="this.action.badge" t-call="mail.Action.badge"
                extraBadgeClass="'position-absolute me-n1 mt-n1 end-0'"/>
        </button>
    </t>
</t>

<t t-name="mail.DropdownAction">
    <t t-call="mail.Action">
        <DropdownItem class="this.btnClass" tag="'button'" onSelected="(ev) => this.onSelected(this.action, ev)" attrs="this.attrs" closingMode="this.action.closingModeAsDropdown">
            <t t-if="this.action.icon" t-call="mail.Action.icon"/>
            <i t-else="" class="oi oi-fw opacity-0" data-icon="question_mark"/>
            <t t-call="mail.Action.label"/>
            <t t-if="this.action.badge" t-call="mail.Action.badge"/>
            <t t-call="mail.Action.extraContent"/>
        </DropdownItem>
    </t>
</t>

<t t-name="mail.Action.icon">
    <t t-if="this.action.icon?.template" t-call="{{ this.action.icon.template }}"
        templateParams="this.action.icon.params"/>
    <i t-elif="this.action.icon" class="oi" t-att-class="this.iconClass" t-attf-class="{{ this.action.iconClass }}" t-att-data-icon="this.action.icon"/>
</t>

<t t-name="mail.Action.label">
    <span t-if="this.showLabel" t-ref="this.props.action.actionRef" class="o-mail-ActionList-actionLabel" t-attf-class="{{ this.action.nameClass }}" t-att-class="this.labelClass" t-out="this.label"/>
</t>

<t t-name="mail.Action.extraContent">
    <t t-if="this.action.extraContentComponent" t-component="this.action.extraContentComponent" t-props="this.action.extraContentComponentProps"/>
</t>

<t t-name="mail.Action.badge">
    <span class="fw-bold badge p-0 rounded-circle d-flex justify-content-center align-items-center" t-attf-class="{{ extraBadgeClass }}" t-att-class="{ 'bg-warning o-discuss-warningBadge': this.action.tags.includes('WARNING_BADGE'), 'o-discuss-badge': this.action.tags.includes('IMPORTANT_BADGE') }" style="aspect-ratio: 1; font-size: 0.6rem;">
        <i t-if="this.action.badgeIcon" class="oi" t-att-class="this.action.badgeIconClass" t-att-data-icon="this.action.badgeIcon"/><span t-elif="this.action.badgeText" t-out="this.action.badgeText"/>
    </span>
</t>

</templates>
