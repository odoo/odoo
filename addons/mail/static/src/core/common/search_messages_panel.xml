<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.SearchMessagesPanel">
        <ActionPanel
            close="this.props.close"
            title="this.title"
            minWidth="200"
            initialWidth="400"
            icon="'search'"
        >
            <t t-set-slot="header">
                <div class="mt-2">
                    <SearchMessageInput closeSearch="this.props.closeSearch" thread="this.props.thread"/>
                </div>
            </t>
            <SearchMessageResult thread="this.props.thread"/>
        </ActionPanel>
    </t>
</templates>
