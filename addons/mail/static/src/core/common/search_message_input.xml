<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.SearchMessageInput">
        <div class="o-mail-SearchMessageInput d-flex align-items-center" t-att-class="{ 'py-2': !this.env.inChatter }">
            <SearchInput
                search="this.props.messageSearch"
                accesskey="'Q'"
                autofocus="true"
                onClear="() => this.props.messageSearch.reset()"
                placeholder="this.inputPlaceholder"
            />
            <div t-if="this.env.inChatter" class="o-mail-SearchMessageInput-buttons d-flex align-items-center justify-content-end flex-grow-0 flex-shrink-0 overflow-hidden">
                <Dropdown>
                    <button class="btn btn-outline-secondary rounded-0" aria-label="Filter Messages" title="Filter Messages">
                        <i class="oi oi-filled" data-icon="filter_alt" role="img"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.searchFilters" t-as="searchFilter" t-key="searchFilter.label">
                            <DropdownItem onSelected="() => this.onChangeSearchFilter(searchFilter)">
                                <input type="radio" class="form-check-input ms-0 me-2" t-att-checked="searchFilter.is_notification === this.props.messageSearch.is_notification" value="searchFilter.label"/>
                                <t t-out="searchFilter.name"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
                <button class="btn btn-outline-secondary border-0 rounded-0" t-on-click="() => this.props.closeSearch?.()" aria-label="Close search" title="Close">
                    <i class="oi" data-icon="close_small" aria-hidden="true"/>
                </button>
            </div>
        </div>
    </t>
</templates>
