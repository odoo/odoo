<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-inherit="mail.MessagingMenu" t-inherit-mode="extension">
    <xpath expr="//*[@name='messagingMenuExtraItems']" position="after">
        <NotificationItem
            t-if="this.showFailures"
            t-foreach="this.store.failures" t-as="failure" t-key="failure.localId"
            important="1"
            counter="failure.notifications.length"
            datetime="failure.datetime"
            persona="this.store.odoobot"
            hasMarkAsReadButton="!this.ui.isSmall"
            onClick="(isMarkAsRead, isMiddleClick) => isMarkAsRead ? this.cancelNotifications(failure) : this.onClickFailure(failure, {isMiddleClick})"
            onSwipeRight="this.hasTouch() ? { action: () => this.cancelNotifications(failure), icon: 'cancel', 'icon_class': 'oi-filled', bgColor: 'bg-warning' } : undefined"
        >
            <t t-set-slot="body" t-out="failure.body"/>
            <t t-set-slot="name"><t t-out="this.getFailureNotificationName(failure)"/></t>
        </NotificationItem>
    </xpath>
</t>

</templates>
