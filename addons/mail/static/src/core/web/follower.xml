<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail.Follower">
        <DropdownItem class="'o-mail-Follower d-flex justify-content-between p-0'">
            <t t-set="followerAtRender" t-value="this.follower()"/>
            <a class="o-mail-Follower-details d-flex align-items-center flex-grow-1 px-3 min-w-0" t-att-class="{ 'o-inactive opacity-75 text-reset text-decoration-line-through': !this.follower().is_active }" href="#" role="menuitem" t-on-click.prevent.stop="(ev) => this.onClickDetails(ev, { followerAtRender })">
                <img class="o-mail-Follower-avatar o_avatar me-2 rounded" t-att-src="this.follower().partner_id.avatarUrl" alt=""/>
                <span class="flex-shrink text-truncate" t-out="this.follower().displayName"/>
            </a>
            <div t-if="this.follower().isEditable" class="d-flex align-items-center me-2">
                <t t-set="followerAtRender" t-value="this.follower()"/>
                <span class="o-mail-Follower-action btn btn-icon p-0 opacity-50 opacity-100-hover" title="Edit Notification Preferences" aria-label="Edit Notification Preferences" t-on-click="(ev) => this.onClickEdit(ev, { followerAtRender })">
                    <i class="oi oi-fw oi-filled" data-icon="edit"/>
                </span>
                <span class="o-mail-Follower-action btn btn-icon p-0 opacity-50 opacity-100-hover" title="Remove this follower" aria-label="Remove this follower" t-on-click.stop="(ev) => this.onClickRemove(ev, { followerAtRender })">
                    <i class="oi oi-fw" data-icon="close_small"/>
                </span>
            </div>
        </DropdownItem>
    </t>

</templates>
