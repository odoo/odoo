<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail.FollowerList">
        <div t-if="this.otherFollowersCount > 20 || this.search.searchTerm" class="px-3 pb-1">
            <SearchInput search="this.search" placeholder.translate="Search by name or email" autofocus="true" onClear="() => this.onClearSearch()"/>
        </div>
        <div class="d-flex align-items-center gap-1 px-2 py-1">
            <button t-if="this.props.thread.selfFollower" class="btn btn-link btn-sm text-danger d-inline-flex align-items-center gap-1" t-on-click="() => this.onClickUnfollow()" title="Unfollow">
                <i class="oi oi-fw oi-filled" data-icon="person" aria-hidden="true"/>
                <span>Unfollow</span>
            </button>
            <button t-else="" class="btn btn-link btn-sm text-success d-inline-flex align-items-center gap-1" t-on-click="() => this.onClickFollow()" title="Follow">
                <i class="oi oi-fw" data-icon="person" aria-hidden="true"/>
                <span>Follow</span>
            </button>
            <button t-if="this.props.thread.selfFollower" class="btn btn-sm opacity-75 d-inline-flex align-items-center gap-1" title="Edit Notification Preferences" t-on-click.stop="(ev) => this.onClickEdit(ev)">
                <i class="oi oi-fw oi-filled" data-icon="notifications" aria-hidden="true"/>
                <span>Notifications</span>
            </button>
            <button t-if="this.props.thread.hasWriteAccess" class="btn btn-sm opacity-75 d-inline-flex align-items-center gap-1 ms-auto" t-on-click="() => this.onClickAddFollowers()" title="Add Followers">
                <i class="oi oi-fw oi-filled" data-icon="person_add" aria-hidden="true"/>
                <span>Add</span>
            </button>
        </div>
        <div t-if="this.followerListView.followers.length > 0" class="d-flex flex-column gap-1 pt-1">
            <t t-foreach="this.followerListView.followers" t-as="follower" t-key="follower.id">
                <Follower follower="follower" onFollowerChanged.bind="this.onFollowerChanged" close="() => this.props.dropdown.close()"/>
            </t>
            <span t-if="!this.followerListView.isFullyLoaded" class="btn btn-link" t-on-click="() => this.followerListView.loadFollowers({ abortSignal: this.scope.abortSignal, searchTerm: this.search.searchTerm })" t-ref="this.loadMoreRef">Load more</span>
        </div>
        <div t-elif="this.search.searchTerm" class="dropdown-item disabled">
            No Matching Followers
        </div>
        <div t-elif="!this.props.thread.hasWriteAccess" class="dropdown-item disabled">
            No Followers
        </div>
    </t>

</templates>
