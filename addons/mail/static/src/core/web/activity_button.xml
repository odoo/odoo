<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.ActivityButton">
        <button class="o-mail-ActivityButton" t-att-class="this.props.buttonClasses or 'btn btn-light d-flex p-1'" t-on-click.stop="this.onClick" t-ref="this.buttonRef" t-att-aria-label="this.title" t-att-data-tooltip="this.title">
            <i class="oi" t-att-class="this.buttonClass" t-att-data-icon="this.buttonIcon" role="img"/>
        </button>
    </t>
</templates>
