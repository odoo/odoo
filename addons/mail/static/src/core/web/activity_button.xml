<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.ActivityButton">
        <t t-set="recordAtRender" t-value="this.record()"/>
        <button class="o-mail-ActivityButton btn btn-link btn-link-inline" t-on-click.stop="(ev) => this.onClick(ev, { recordAtRender })" t-ref="this.buttonRef" t-att-aria-label="this.title" t-att-title="this.title">
            <i class="oi oi-fw oi-lg" t-att-class="this.buttonClass" t-att-data-icon="this.buttonIcon" role="img"/>
        </button>
    </t>
</templates>
