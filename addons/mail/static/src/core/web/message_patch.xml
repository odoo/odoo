    <t t-name="mail.Message.bodyInForward">
        <div><br/></div>
        <div>
            <span>---------- Forwarded message ----------</span><br/>
            <span>Date: <t t-out="this.date"/></span><br/>
            <span>From: <t t-out="this.name"/> <a t-att-href="'mailto:' + this.email" target="_blank">&lt;<t t-out="this.email"/>&gt;</a></span><br/>
            <span>Subject: <t t-out="this.message.subject || this.message.default_subject"/></span>
        </div>
        <t t-out="this.body"/>
        <br/>
        <div t-if="this.signature" data-o-mail-quote="1">
            <t t-call="html_editor.Signature" signatureClass="'o-signature-container'"/>
        </div>
    </t>

    <t t-name="mail.Message.bodyInReply">
        <div><br/></div>
        <div class="o_mail_reply_container" data-o-mail-quote="1">
            <div class="o_mail_reply_content">
                <div>
                    <span>On <t t-out="this.date"/> <t t-out="this.name"/> <a t-att-href="'mailto:' + this.email" target="_blank">&lt;<t t-out="this.email"/>&gt;</a>wrote</span>
                </div>
                <blockquote t-out="this.body"/>
            </div>
        </div>
        <br/>
        <div t-if="this.signature" data-o-mail-quote="1">
            <t t-call="html_editor.Signature" signatureClass="'o-signature-container'"/>
        </div>
    </t>
