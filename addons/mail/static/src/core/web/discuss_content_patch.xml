<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.DiscussContent" t-inherit-mode="extension">
        <xpath expr="//*[@t-ref='root']" position="before">
            <div t-if="this.ui.isSmall and this.store.discuss.activeTab === 'inbox' and this.store.selfUsesInbox" class="w-100 border-bottom" t-ref="mobileTopbar"><t t-call="mail.DiscussContent.mobileTopbar"/></div>
        </xpath>
        <xpath expr="//*[@t-ref='main']" position="inside">
            <t t-if="!this.ui.isSmall" t-call="mail.Discuss.loading"/>
        </xpath>
        <xpath expr="//*[@name='thread']" position="inside">
            <t t-if="!this.ui.isSmall" t-call="mail.Discuss.loading"/>
        </xpath>
    </t>
    <t t-name="mail.DiscussContent.mobileTopbar">
        <div class="btn-group d-flex w-100 p-1">
            <t t-call="mail.MobileMailbox" mailbox="this.store.inbox" />
            <t t-call="mail.MobileMailbox" mailbox="this.store.starred"/>
            <t t-call="mail.MobileMailbox" mailbox="this.store.history"/>
        </div>
    </t>
</templates>
