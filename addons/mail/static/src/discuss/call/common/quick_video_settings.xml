<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="discuss.QuickVideoSettings">
        <t t-set="rowClass" t-value="this.ancestors.inMeetingView ? 'o-gap-2_5 o-px-2_5 py-2 rounded-4 fs-6' : 'gap-2 px-2 o-py-1_5 rounded-3 o-fs-small'"/>
        <t t-set="iconClass" t-value="this.ancestors.inMeetingView ? 'fs-3' : 'o-fs-small'"/>
        <div class="o-discuss-QuickVideoSettings d-flex flex-column" t-att-class="{ 'gap-1': this.ancestors.inMeetingView }">
            <DeviceSelect icon="'videocam'" kind="'videoinput'" label.translate="Camera" menuClass="this.store.discussDropdownMenuClass(this.ancestors) + ' o-discuss-CallActionList-menu border-0 shadow' + (this.ancestors.inMeetingView ? ' o-inMeetingView mx-3' : ' mx-2')"/>
            <button t-if="this.canSwitchCamera" class="btn d-flex align-items-center border-0 lh-sm text-start" t-att-class="rowClass" t-on-click="() => this.rtc.toggleCameraFacingMode()" aria-label="Switch Camera">
                <i class="oi opacity-75" t-att-class="iconClass" data-icon="refresh"/>
                <span class="fw-medium flex-grow-1">Switch Camera</span>
            </button>
            <div t-if="!this.isBrowserSafari()" class="btn d-flex align-items-center border-0 lh-sm text-start" t-att-class="rowClass" t-on-click="() => this.store.settings.useBlur = !this.store.settings.useBlur">
                <i class="oi opacity-75" t-att-class="iconClass" data-icon="grain"/>
                <span class="fw-medium flex-grow-1 text-truncate">Blur Background</span>
                <div class="form-check form-switch d-flex align-items-center mb-0 ps-0">
                    <input class="form-check-input mx-0 mt-0" type="checkbox" role="switch" t-att-checked="this.store.settings?.useBlur ? 'checked' : ''"/>
                </div>
            </div>
            <t t-if="!this.env.pipWindow">
                <hr t-att-class="this.ancestors.inMeetingView ? 'o-mx-2_5 my-2' : 'mx-2 my-1'"/>
                <button class="btn d-flex align-items-center border-0 lh-sm text-start" t-att-class="rowClass" t-on-click="this.onClickVideoSettings">
                    <i class="oi opacity-75" t-att-class="iconClass" data-icon="settings"/>
                    <span class="fw-medium flex-grow-1">Advanced Settings</span>
                </button>
            </t>
        </div>
    </t>

</templates>
