<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="discuss.CallDeviceSelect">
        <t t-set="rowClass" t-value="'o-dropdown-no-caret border-0 lh-sm text-start ' + (this.ancestors.inMeetingView ? 'o-gap-2_5 o-px-2_5 py-2 rounded-4 fs-6' : 'gap-2 px-2 o-py-1_5 rounded-3 o-fs-small')"/>
        <Dropdown
            menuClass="this.props.menuClass"
            disabled="!this.isPermissionGranted(this.props.kind)"
            openOnMouseEnter="false"
            position="this.props.label ? 'right-middle' : undefined"
        >
            <button
                t-if="this.isPermissionGranted(this.props.kind)"
                class="o-mail-DeviceSelect-button btn w-100"
                t-att-class="{ ['d-flex align-items-center ' + rowClass]: this.props.label, 'btn-secondary o-dropdown-caret rounded-3 bg-300': !this.props.label }"
                t-att-data-kind="this.props.kind"
             >
                <t t-if="this.props.label" t-call="discuss.CallDeviceSelect.row" subtitle="this.selectLabel || this.BROWSER_DEFAULT"/>
                <t t-else="">
                    <i t-if="this.props.icon" class="oi" t-att-class="this.props.iconClass" t-att-data-icon="this.props.icon"/>
                    <span
                        class="pe-2 text-start text-truncate"
                        t-attf-class="{{ this.props.icon ? 'ps-2' : '' }}"
                        t-out="this.selectLabel || this.BROWSER_DEFAULT"/>
                </t>
            </button>
            <button
                t-else=""
                class="o-mail-DeviceSelect-button btn d-flex align-items-center w-100"
                t-att-class="{ [rowClass]: this.props.label, 'btn-secondary rounded-3 bg-300': !this.props.label }"
                t-att-data-kind="this.props.kind"
                t-on-pointerdown.prevent="(ev) => this.onPointerdownButton(ev)"
                t-on-keydown.prevent="() => this.showPermissionDialog(this.props.kind)"
                t-ref="this.rootRef"
            >
                <t t-if="this.props.label" t-call="discuss.CallDeviceSelect.row" subtitle="this.CLICK_TO_ACTIVATE"/>
                <t t-else="">
                    <i t-if="this.props.icon" class="oi" t-att-class="this.props.iconClass" t-att-data-icon="this.props.icon"/>
                    <span
                        class="text-truncate flex-grow-1"
                        t-attf-class="{{ this.props.icon ? 'ps-2' : '' }}"
                        t-out="this.CLICK_TO_ACTIVATE"/>
                </t>
            </button>
            <t t-set-slot="content">
                <t t-set="itemClass" t-value="this.props.label ? (this.ancestors.inMeetingView ? 'py-2 ps-4 fs-6' : 'ps-4') : ''"/>
                <DropdownItem t-if="!this.isBrowserChrome or this.props.kind === 'videoinput'" class="{ 'active': this.isSelected(), [itemClass]: true }" onSelected="(ev) => this.onSelectAudioDevice(ev)" closingMode="'closest'">
                    <t t-out="this.BROWSER_DEFAULT"/>
                </DropdownItem>
                <t t-foreach="this.userDevices()" t-as="device" t-key="device_index">
                    <DropdownItem t-if="device.kind === this.props.kind" class="{ 'active': this.isSelected(device.deviceId), [itemClass]: true }" onSelected="(ev) => this.onSelectAudioDevice(ev, { device })" closingMode="'closest'">
                        <t t-out="device.label || 'device ' + device_index"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

    <t t-name="discuss.CallDeviceSelect.row">
        <span class="d-flex flex-column flex-grow-1 min-w-0 o-gap-0_5">
            <span class="d-flex align-items-center" t-att-class="this.ancestors.inMeetingView ? 'o-gap-2_5' : 'gap-2'">
                <i t-if="this.props.icon" class="oi opacity-75" t-att-class="this.ancestors.inMeetingView ? 'fs-3' : 'o-fs-small'" t-att-data-icon="this.props.icon"/>
                <span class="fw-medium" t-out="this.props.label"/>
            </span>
            <span class="o-mail-DeviceSelect-subtitle fw-normal opacity-75 text-truncate" t-att-class="this.ancestors.inMeetingView ? 'o-fs-small' : 'smaller'" t-out="subtitle"/>
        </span>
        <i class="oi opacity-75 me-n1" t-att-class="this.ancestors.inMeetingView ? 'fs-3' : 'fs-5'" data-icon="chevron_forward"/>
    </t>

</templates>
