<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ChatWindow" t-inherit-mode="extension">
        <xpath expr="//Thread" position="before">
            <PipBanner t-if="this.rtc.state.isPipMode and this.thread.eq(this.rtc.channel)" compact="true"/>
            <Call t-elif="this.thread.showCallView" thread="this.thread" compact="true"/>
        </xpath>
    </t>
</templates>
