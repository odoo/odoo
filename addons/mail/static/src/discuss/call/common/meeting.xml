<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.Meeting">
        <div t-if="this.store.rtc.channel" class="o-mail-Meeting h-100 w-100 d-flex flex-column" t-att-class="{'o-fullscreen': this.store.rtc.isFullscreen, 'p-2': this.ui.isSmall, 'p-1 pb-0': !this.ui.isSmall and this.props.isPip, 'px-3 pt-3': !this.ui.isSmall and !this.props.isPip}" t-att-data-active="this.store.meetingViewOpened">
            <div class="d-flex flex-grow-1 h-100 o-min-height-0 gap-1 position-relative">
                <div class="o-mail-Meeting-callContainer h-100 flex-grow-1 min-w-0" t-att-class="{'d-none': this.ui.isSmall and this.threadActions.activeAction?.actionPanelComponentCondition, 'pb-0': this.ui.isSmall}">
                    <Call hasOverlay="false" isPip="this.props.isPip"/>
                </div>
                <div t-if="this.threadActions.activeAction?.actionPanelComponentCondition" t-attf-class="{{ this.threadActions.activeAction.actionPanelOuterClass }}" class="o-mail-DiscussContent-panelContainer h-100 border flex-shrink-0 rounded-4" t-att-class="{
                    'w-100': this.ui.isSmall,
                    'o-mail-DiscussApp-sidebarBgColor': this.threadActions.activeAction.id === 'meeting-chat',
                    'bg-view': this.threadActions.activeAction.id !== 'meeting-chat',
                }">
                    <t t-component="this.threadActions.activeAction.actionPanelComponent" t-props="this.threadActions.activeAction.actionPanelComponentProps"/>
                </div>
                <MeetingReadyBanner t-if="this.showInviteBanner"/>
            </div>
            <!-- A small screen fits its whole bar: everything past the microphone and the camera
                 is behind a single "More", so there is nothing left to scroll to. -->
            <div t-if="this.ui.isSmall" class="o-mail-Meeting-bar p-2 pb-3 d-flex align-items-center justify-content-center flex-shrink-0">
                <CallActionList channel="this.channel" pipExtraActions="this.pipExtraActions" extraMoreActionGroups="this.sideActionGroups"/>
            </div>
            <div t-else="" class="o-mail-Meeting-bar d-flex align-items-center gap-3 flex-shrink-0 overflow-x-auto" t-att-class="this.props.isPip ? 'px-4 py-2' : 'px-2 py-3'">
                <div class="d-flex flex-grow-1 flex-basis-0 align-items-center gap-3 min-w-0 overflow-hidden text-nowrap user-select-none o-text-white fs-5">
                    <t t-if="!this.rtc.isPipMode">
                        <span t-out="this.dateSimple" t-att-title="this.datetimeMedium" class="o-mail-Meeting-clock"/>
                        <span class="vr"/>
                        <span class="text-truncate opacity-75" t-out="this.channel.displayName"/>
                    </t>
                </div>
                <CallActionList channel="this.channel" pipExtraActions="this.pipExtraActions" extraMoreActionGroups="this.sideActionGroups"/>
                <div class="d-flex flex-grow-1 flex-basis-0 justify-content-end min-w-0">
                    <MeetingSideActions t-if="this.hasSideActions" threadActions="this.threadActions"/>
                </div>
            </div>
        </div>
    </t>
</templates>
