<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="discuss.FullscreenTooltip">
        <div class="p-2 d-flex flex-row gap-1" style="max-width: 300px">
            <div class="m-1">
                <i class="oi text-info me-2" data-icon="info"/>Switch to fullscreen mode
            </div>
            <div class="align-self-start cursor-pointer" t-on-click="this.onClickClose" title="Dismiss hint">
                <i class="oi" data-icon="close"/>
            </div>
        </div>
    </t>
</templates>
