<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="discuss.FullscreenTooltip">
        <div class="p-2 d-flex flex-row gap-1" style="max-width: 300px">
            <div class="m-1">
                <t t-if="!this.rtc.isFullscreen">
                    <i class="oi text-warning me-1" data-icon="warning"/>Switch to fullscreen mode
                </t>
            </div>
            <div class="align-self-start cursor-pointer" t-on-click="this.onClickClose" title="Dismiss warning">
                <i class="oi" data-icon="close"/>
            </div>
        </div>
    </t>
</templates>
