<templates>

    <t t-name="discuss.RecordingDialog">
        <Dialog size="'sm'" footer="false" title.translate="Recording">
            <div class="o-discuss-RecordingDialog d-flex flex-column gap-1">
                <t t-if="!this.store.rtc?.isRecording()">
                    <h3>Record the call</h3>
                    <p class="mb-2">
                    Video captures participants' audio, video, and screen shares. Transcription creates a written record of the call. Results will be available in the chat and call history once they are ready.
                    </p>
                </t>
                <t t-else="">
                    <h3>Recording in progress</h3>
                    <div class="d-flex flex-column gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="oi oi-filled text-danger" data-icon="circle" style="animation: blink 1s infinite;" role="img" title="Recording in progress"/>
                            <span t-if="this.store.rtc?.recordingState.video">Video recording</span>
                            <span t-elif="this.store.rtc?.recordingState.transcription">Transcription in progress</span>
                            <span t-else="">Recording in progress</span>
                        </div>
                    </div>
                </t>
                <CheckBox className="'o-discuss-RecordingDialog-option py-1'" value="this.state().transcription" disabled="!this.canChangeTranscription()" onChange.bind="this.onChangeTranscription">
                    Record transcription
                </CheckBox>
                <CheckBox className="'o-discuss-RecordingDialog-option py-1'" value="this.state().video" disabled="this.isVideoDisabled()" onChange.bind="this.onChangeVideo">
                    Record video
                </CheckBox>
                <div class="d-flex justify-content-center gap-2 p-2">
                    <t t-if="this.showUpdateButton()">
                        <button class="btn btn-secondary d-flex align-items-center justify-content-center gap-2" t-on-click="this.onClickUpdate" t-att-disabled="this.store.rtc?.recordingRequest">
                            <span>Update</span>
                            <t t-if="this.store.rtc?.recordingRequest">
                                <i class="oi oi-fw oi-spin" data-icon="autorenew" role="img" title="Updating recording"/>
                            </t>
                        </button>
                    </t>
                    <button class="btn d-flex align-items-center justify-content-center gap-2" t-att-class="this.store.rtc?.isRecording() ? 'btn-danger' : 'btn-primary'" t-on-click="this.store.rtc?.isRecording() ? this.onClickStopRecording : this.onClickStartRecording" t-att-disabled="this.isRecordingActionDisabled()">
                        <span><t t-if="this.store.rtc?.isRecording()">Stop recording</t><t t-else="">Start recording</t></span>
                        <t t-if="this.store.rtc?.recordingRequest">
                            <i class="oi oi-fw oi-spin" data-icon="autorenew" role="img" title="Applying recording request"/>
                        </t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
