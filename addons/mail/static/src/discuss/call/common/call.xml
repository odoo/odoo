<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="discuss.Call">
        <div class="o-discuss-Call user-select-none position-relative gap-2" t-att-class="{
            'o-fullSize': this.isFullSize,
            'o-compact': this.props.compact and !this.isMobileOs,
            'o-minimized': this.minimized,
            'position-relative o-mx-0_5 o-mt-0_5 p-1': !this.rtc.isFullscreen and !this.props.isPip,
            'rounded-2': !this.rtc.isFullscreen and !this.props.isPip and this.isActiveCall,
            'o-hasVideo': this.channel.videoCount > 0,
            'o-selfInCall': this.isActiveCall,
            'border-bottom': !this.isActiveCall,
        }" t-ref="this.rootRef">
            <div class="o-discuss-Call-main d-flex flex-column align-items-center justify-content-center position-relative overflow-auto o-scrollbar-thin h-100" t-on-mouseleave="this.onMouseleaveMain">
                <PttAdBanner t-if="!this.props.compact"/>
                <BlurPerformanceWarning t-if="this.store.settings.blurPerformanceWarning"/>
                <CallPresentationBar t-if="this.rtc.selfSession and this.isAnyonePresenting" />
                <div
                    class="o-discuss-Call-mainCards position-relative overflow-auto o-scrollbar-thin w-100 flex-grow-1 o-min-height-0"
                    t-att-class="{'mt-1': this.minimized, 'o-discuss-Call-sidebar': this.hasSidebar}"
                    t-on-click="() => this.showOverlay()"
                    t-on-mousemove="this.onMousemoveMain"
                    t-ref="this.gridRef"
                >
                    <t t-set="rendered" t-value="this.renderedSurfaces"/>
                    <CallParticipantCard t-foreach="rendered.surfaces" t-as="surface" t-key="surface.key"
                        cardData="surface.data"
                        className="this.surfaceClassName(surface)"
                        isSidebarItem="surface.data.placement === 'sidebar'"
                        isCropped="this.state.cropsTiles and surface.data.placement === 'main' and surface.data.type !== 'screen'"
                        inset="surface.data.placement === 'inset'"
                        minimized="this.minimized"
                        channel="this.channel"
                    />
                    <span t-if="rendered.hasMoreCards" class="oi ps-1 pe-1 o-discuss-Call-moreIndicator d-flex align-items-center justify-content-center text-white-50" data-icon="more_horiz" t-att-data-surface="'__more__'"/>
                </div>

                <!-- Buttons -->
                <div t-if="this.props.hasOverlay and (this.state.overlay or !this.isControllerFloating)" class="o-discuss-Call-overlay d-flex justify-content-center w-100 pb-1" t-att-class="{ 'o-isFloating position-absolute z-2 bottom-0 pb-2': this.isControllerFloating }">
                    <div t-on-mousemove="this.onMousemoveOverlay">
                        <CallActionList channel="this.channel" compact="this.props.compact or this.props.isPip"/>
                    </div>
                </div>
                <div t-if="this.topNotifications.length" class="o-discuss-Call-topNotifications position-absolute d-flex flex-column start-50 translate-middle-x top-0" t-att-class="{ 'pt-4': this.rtc.isFullscreen, 'pt-2': !this.rtc.isFullscreen }">
                    <span class="o-discuss-Call-notification text-bg-light shadow-lg rounded-1 m-1" t-att-class="{ 'p-3 fs-4': this.rtc.isFullscreen, 'p-2': !this.rtc.isFullscreen }" t-foreach="this.topNotifications" t-as="notification" t-key="notification.id" t-out="notification.text"/>
                </div>
                <div t-if="this.bottomNotifications.length" class="o-discuss-Call-bottomNotifications position-absolute d-flex flex-column-reverse start-0 bottom-0" t-att-class="{ 'ps-5 pb-5': this.rtc.isFullscreen, 'ps-2 pb-2': !this.rtc.isFullscreen }">
                    <span class="o-discuss-Call-notification text-bg-light shadow-lg rounded-1 m-1" t-att-class="{ 'p-3 fs-4': this.rtc.isFullscreen, 'p-2': !this.rtc.isFullscreen }" t-foreach="this.bottomNotifications" t-as="notification" t-key="notification.id" t-out="notification.text"/>
                </div>
            </div>
        </div>
    </t>

</templates>
