<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="discuss.CallMenu">
        <div class="dropdown" t-attf-class="{{ this.className }}" t-ref="this.root">
            <button t-if="this.rtc.channel" class="user-select-none dropdown-toggle o-no-caret o-dropdown--narrow px-0 rounded-pill border-0 position-relative" t-att-title="this.buttonTitle" t-on-click="this.rtc.channel.open">
                <div class="o-discuss-CallMenu-buttonContent d-flex align-items-center btn-group rounded-pill overflow-visible" t-att-class="{ 'o-isOdooCommunity': !this.isEnterprise }">
                    <div class="o-discuss-CallMenu-channelInfo text-truncate btn btn-group-item border-0 m-0 p-0 d-flex align-items-center gap-1 o-ps-1_5 pe-1 rounded-4 rounded-end-0 align-self-stretch bg-inherit" role="button" title="Open Conversation">
                        <span class="position-relative small bg-transparent">
                            <img class="rounded-2 object-fit-cover" t-att-src="this.rtc.channel.avatarUrl" alt="Thread Image" style="width: 20px; height: 20px"/>
                        </span>
                        <span class="text-truncate small" t-out="this.rtc.channel.displayName"/>
                    </div>
                    <Dropdown state="this.dropdownState">
                        <button class="o-discuss-CallMenu-actionsButton btn border-0 text-body rounded-4 rounded-start-0 m-0" t-att-class="{ 'o-dropdown-open': this.dropdownState.isOpen }" title="Select Actions">
                            <i class="oi o-fs-small" t-att-data-icon="this.icon"/>
                            <div class="o-discuss-CallMenu-actionsControl position-relative d-flex align-items-center justify-content-center">
                                <div class="o-discuss-CallMenu-actionsAudioBars">
                                    <TalkingAudioBars t-if="this.rtc.selfSession" session="this.rtc.selfSession"/>
                                </div>
                                <i class="o-discuss-CallMenu-actionsChevron oi" t-att-data-icon="this.dropdownState.isOpen ? 'keyboard_arrow_up' : 'keyboard_arrow_down'"/>
                            </div>
                        </button>
                        <t t-set-slot="content">
                            <ActionList actions="this.callActions.actionsComputed" dropdown="true"/>
                        </t>
                    </Dropdown>
                </div>
                <span class="o-discuss-inCallIcon o-fw-600 rounded-circle d-flex justify-content-center align-items-center position-absolute z-3 bg-white" style="font-size: 0.6rem; top: -4px; left: -2px; padding: 1px;">
                    <i class="oi oi-fw bg-inherit rounded-circle" data-icon="volume_up"/>
                </span>
            </button>
        </div>
    </t>

</templates>
