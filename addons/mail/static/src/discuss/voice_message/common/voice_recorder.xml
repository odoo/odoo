<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.VoiceRecorder">
        <div class="o-mail-VoiceRecorder d-flex align-items-center gap-2 flex-shrink-0 p-1 bg-200 rounded-pill">
            <button class="btn btn-secondary o_btn_circle d-flex align-items-center border-0 rounded-circle o-hasBtnBg" t-att-disabled="this.props.state.isActionPending" t-on-click="this.props.state.cancelRecording" t-att-title="this.cancelTitle">
                <i class="oi oi-fw" data-icon="delete" role="img" aria-hidden="true"/>
            </button>
            <i class="o-mail-VoiceRecorder-dot oi oi-filled text-danger" data-icon="circle" role="img" aria-label="Recording in progress" title="Recording in progress"/>
            <small class="o-mail-VoiceRecorder-elapsed flex-shrink-0" t-att-class="{ 'text-danger': this.props.state.limitWarning }">
                <t t-out="this.props.state.elapsed"/>
                <t t-if="this.props.state.limitWarning"> / <t t-out="this.props.state.limit"/></t>
            </small>
            <div class="o-mail-VoiceRecorder-visualizer d-flex align-items-center align-self-stretch overflow-hidden flex-shrink-0">
                <div class="o-mail-VoiceRecorder-bars d-flex align-items-center" t-key="this.props.state.volumeLevelsOffset">
                    <span t-foreach="this.props.state.volumeLevels" t-as="volumeLevel" t-key="volumeLevel_index" class="o-mail-VoiceRecorder-bar rounded-pill" t-att-class="this.props.state.limitWarning ? 'bg-danger' : 'bg-900'" t-attf-style="--VoiceRecorder__bar-level: {{ volumeLevel }};"/>
                </div>
            </div>
            <button class="btn btn-primary o_btn_circle d-flex align-items-center border-0 rounded-circle text-bg-primary opacity-100 o-hasBtnBg" t-att-disabled="this.props.state.isActionPending" t-on-click="this.props.state.onClick" t-att-title="this.title">
                <i class="oi oi-fw oi-filled" data-icon="stop" role="img" aria-hidden="true"/>
            </button>
        </div>
    </t>

</templates>
