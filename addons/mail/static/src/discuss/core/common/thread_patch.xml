<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Thread" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Thread')]" position="before">
            <span t-if="!this.env.inChatter and this.channel?.showUnreadBanner" class="o-mail-Thread-banner d-flex cursor-pointer rounded-4 smaller fw-bold border border-warning">
                <t t-set="alertClass" t-value="'alert alert-warning m-0 rounded-4 border-0 o-mail-Thread-bannerHover py-1'"/>
                <span t-attf-class="{{ alertClass }} rounded-end-0 flex-grow-1" t-on-click="this.onClickUnreadMessagesBanner" t-out="this.newMessageBannerText"/>
                <span t-attf-class="{{ alertClass }} rounded-start-0" t-on-click="() => this.props.thread.markAsRead()">Mark as Read<i class="ms-2 oi" data-icon="check_box"/></span>
            </span>
        </xpath>
    </t>
</templates>
