<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail.ActionPanel">
        <ResizablePanel t-if="this.props.resizable and !this.ancestors.inChatWindow and !this.ancestors.inChatter and !this.ui.isSmall()" class="'o-mail-ActionPanel-resizable rounded-4 flex-shrink-0 h-100 bg-inherit'" handleSide="'start'" outerHandle="true" initialWidth="this.initialWidth" minWidth="this.minWidth" onResize="(width) => this.onResize(width)">
            <div t-att-class="this.classNames">
                <t t-call="mail.ActionPanel.content"/>
            </div>
        </ResizablePanel>
        <div t-else="" t-att-class="this.classNames">
            <t t-call="mail.ActionPanel.content"/>
        </div>
    </t>

    <t t-name="mail.ActionPanel.content">
        <div class="o-mail-ActionPanel-header position-sticky top-0 pt-2 pb-1 d-flex flex-column bg-inherit smaller" t-att-class="{ 'px-1 pb-1': this.ancestors.inChatWindow, 'px-2 pb-2': !this.ancestors.inChatWindow and !this.ancestors.inMeetingView, 'o-ps-2_5 pe-2': this.ancestors.inMeetingView }">
            <div class="o-mail-ActionPanel-headerRow d-flex align-items-center gap-1">
                <button t-if="this.props.close and (this.ancestors.inChatWindow or this.ancestors.inMeetingView?.hasPreviousActionPanel)" class="btn p-1 opacity-75 opacity-100-hover" t-att-title="this.backButtonTitle" t-on-click.stop="() => this.props.close()" data-available-offline="">
                    <i class="oi oi-fw" data-icon="west"/>
                </button>
                <i t-if="this.props.icon" class="oi oi-fw text-muted" t-att-class="this.props.iconClass" t-att-data-icon="this.props.icon"/>
                <p t-if="this.props.title" class="fw-bold text-uppercase text-truncate m-0 flex-grow-1" t-out="this.props.title"/>
                <t t-call-slot="header-extra"/>
                <button t-if="this.props.close and this.ancestors.inMeetingView" class="btn p-1 opacity-75 opacity-100-hover ms-auto" title="Close panel" t-on-click.stop="() => this.props.close()" data-available-offline="">
                    <i class="oi oi-fw" data-icon="close_small"/>
                </button>
            </div>
            <t t-call-slot="header"/>
        </div>
        <div class="o-mail-ActionPanel-content px-1 d-flex flex-column flex-grow-1 bg-inherit o-min-height-0" t-ref="this.contentRef">
            <t t-call-slot="default"/>
        </div>
    </t>

</templates>
