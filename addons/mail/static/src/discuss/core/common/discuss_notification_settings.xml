<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail.DiscussNotificationSettings">
        <div class="o-mail-DiscussNotificationSettings d-flex flex-column">
            <div class="d-flex flex-column my-1" t-ref="this.notificationsRef" role="radiogroup" aria-label="Channel Notifications">
                <h5>Channel Notifications</h5>
                <span class="mb-1 text-muted small">This setting will be applied to all channels using the default notification settings.</span>
                <t t-foreach="this.store.settings.NOTIFICATIONS" t-as="notif" t-key="notif.label">
                    <t t-set="isSelected" t-value="notif.label === this.store.self_user.res_users_settings_id.channelNotifications"/>
                    <button class="o-navigable btn d-flex my-1" role="radio"
                        t-att-aria-checked="isSelected ? 'true' : 'false'"
                        t-att-class="{'o-selected' : isSelected}"
                        t-att-tabindex="notif.label === this.focusedNotification() ? 0 : -1"
                        t-on-focus="() => this.focusedNotification.set(notif.label)"
                        t-on-click="() => this.store.settings.setCustomNotifications(notif.label)">
                        <input class="form-check-input pe-none" type="radio" tabindex="-1" aria-hidden="true" t-att-checked="isSelected"/>
                        <div class="d-flex flex-column text-start flex-grow-1 mx-3">
                            <span t-out="notif.name"/>
                        </div>
                    </button>
                </t>
            </div>
            <hr class="o-discuss-separator my-1"/>
            <label class="cursor-pointer d-flex align-items-center my-1">
                <h5>Message sounds</h5>
                <div class="flex-grow-1"/>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" t-att-checked="this.store.settings.messageSound" t-on-change="this.onChangeMessageSound"/>
                </div>
            </label>
        </div>
    </t>
</templates>
