<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="discuss.SelectableList">
        <div class="o-discuss-SelectableList d-flex flex-column flex-grow-1 bg-inherit o-min-height-0">
            <t t-call-slot="preface"/>
            <t t-if="this.props.search">
                <t t-if="this.props.slots?.search" t-call-slot="search"/>
                <t t-else="" t-call="discuss.SelectableList-search"/>
            </t>
            <div class="d-flex flex-column pt-1 flex-grow-1 o-min-height-0">
                <t t-if="!this.props.items.length" t-call-slot="empty"/>
                <t t-call-slot="listHint"/>
                <ul class="o-discuss-SelectableList-items pb-0 overflow-auto o-scrollbar-thin list-group border-0 flex-grow-1 mb-0" t-att-class="{ 'align-items-center justify-content-center': !this.props.items.length }">
                    <t t-foreach="this.props.items" t-as="item" t-key="item.key">
                        <t t-call="{{ this.itemTemplate }}" item="item" item_index="item_index"/>
                    </t>
                </ul>
            </div>
            <div class="o-discuss-ChannelInvitation-invitationBox pt-0 pb-1 bg-inherit">
                <t t-if="this.props.selected.length" t-call-slot="selected">
                    <div class="pt-2">
                        <div class="o-discuss-ChannelInvitation-selectedList d-flex flex-wrap overflow-auto o-scrollbar-thin">
                            <t t-foreach="this.props.selected" t-as="selected" t-key="selected.key">
                                <button class="btn btn-light o-fw-600 smaller pe-1" title="Unselect" t-on-click="() => this.onClickItem(selected)">
                                    <t t-out="selected.label"/> <i class="oi oi-close border border-dark-subtle ms-1"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-call-slot="footer"/>
            </div>
        </div>
    </t>

    <t t-name="discuss.SelectableList-search">
        <div class="position-relative">
            <label t-att-id="this.searchInputId + '-status'" t-att-for="this.searchInputId" class="position-absolute top-50 px-2 translate-middle-y smaller opacity-50" role="status">
                <t t-call-slot="searchStatus">
                    <i class="oi oi-search" aria-hidden="true"/>
                </t>
            </label>
            <input t-att-id="this.searchInputId" class="o-discuss-ChannelInvitation-search form-control lh-1 px-2 ps-4 bg-view" t-att-aria-describedby="this.searchInputId + '-status'" t-att-value="this.props.search.value" t-ref="this.inputRef" t-att-placeholder="this.props.search.placeholder" t-on-input="this.onInput"/>
            <t t-call-slot="searchTrailing"/>
        </div>
    </t>

    <t t-name="discuss.SelectableList-item">
        <t t-set="isSelected" t-value="this.isSelected(item)"/>
        <li class="o-discuss-ChannelInvitation-selectable object-fit-cover d-flex align-items-center px-1 py-0 btn list-group-item border-0 rounded-0 w-100"
            t-att-class="{ 'o-odd': item_index % 2 === 1, 'o-selected': isSelected, 'align-items-center': item.avatarIcon }"
            t-on-click="() => this.onClickItem(item)"
        >
            <div class="d-flex align-items-center p-1 bg-inherit">
                <div class="position-relative d-flex flex-shrink-0 bg-inherit">
                    <DiscussAvatar t-if="item.avatarRecord" record="item.avatarRecord"/>
                    <div t-elif="item.avatarIcon" class="o-discuss-SelectableList-iconAvatar w-100 h-100 d-flex align-items-center justify-content-center rounded-3 bg-primary text-white">
                        <i t-att-class="item.avatarIcon"/>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-column mx-2 o-mb-0_5 flex-grow-1 overflow-hidden">
                <span class="text-truncate" t-out="item.label"/>
                <span t-if="item.subtitle" t-out="item.subtitle" class="text-truncate text-start smaller text-600 fw-normal lh-1 w-100"/>
            </div>
            <input class="form-check-input flex-shrink-0 mt-0 mx-1" type="checkbox" t-att-checked="isSelected ? 'checked' : undefined"/>
        </li>
    </t>

</templates>
