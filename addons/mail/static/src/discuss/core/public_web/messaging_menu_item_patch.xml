<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-inherit="mail.MessagingMenuItem" t-inherit-mode="extension">
    <xpath expr="//t[@name='itemNameBefore']" position="inside">
        <i t-if="this.prependNameWithStar" class="oi oi-filled o-mail-favorite me-1" data-icon="star" t-att-title="this.starTitle" role="img"/>
    </xpath>
    <xpath expr="//t[@name='itemName']" position="replace">
        <div t-if="this.props.channel?.parent_channel_id" class="d-flex align-items-center">
            <span class="flex-shrink-0 opacity-75 small" t-att-title="this.props.channel.parent_channel_id.displayName" t-out="this.parentChannelShortName"/>
            <i class="oi o-xsmaller o-mx-0_5 flex-shrink-0 opacity-75" data-icon="chevron_forward"/>
            <span class="text-truncate" t-out="this.props.channel.thread.displayName"/>
        </div>
        <t t-else="">$0</t>
    </xpath>
    <xpath expr="//t[@name='itemName']" position="after">
        <span t-if="this.meetingStartText" class="o-mail-MessagingMenuItem-meetingStart flex-shrink-0 align-self-baseline fw-normal text-muted smaller ms-1">@ <t t-out="this.meetingStartText"/></span>
    </xpath>
    <xpath expr="//t[@t-set-slot='name-after']" position="inside">
        <span t-if="this.props.channel?.correspondent?.partner_id?.statusSubtitle()" class="mw-100 smaller text-truncate"><t t-call="mail.statusSubtitle" partner="this.props.channel.correspondent.partner_id"/></span>
    </xpath>
    <xpath expr="//t[@t-set-slot='body']/span" position="before">
        <span t-if="this.props.channel?.hasDraft" class="o-mail-MessagingMenuItem-draft badge border border-danger text-danger fw-normal rounded-1 px-1 py-0 me-1 align-baseline overflow-visible">Draft</span>
        <MessageSeenIndicator t-elif="this.props.channel?.newestPersistentOfAllMessage?.showSeenIndicator(this.props.channel.thread)" message="this.props.channel.newestPersistentOfAllMessage"/>
    </xpath>
    <xpath expr="//t[@t-set-slot='icon']" position="inside">
        <CountryFlag t-if="this.props.channel?.showCorrespondentCountry" country="this.props.channel.correspondentCountry" class="'o-mail-NotificationItem-country position-absolute border shadow-sm'"/>
    </xpath>
</t>
</templates>
