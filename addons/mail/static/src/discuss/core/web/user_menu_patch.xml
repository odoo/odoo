<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.UserMenu" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_user_menu')]" position="attributes">
            <attribute name="t-att-data-tooltip">this.store.self_user?.status_message</attribute>
        </xpath>
        <xpath expr="//img[hasclass('o_user_avatar')]" position="replace">
            <DiscussAvatar t-if="this.store.self_user" record="this.store.self_user" showStatusMessage="true" size="26"/>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
