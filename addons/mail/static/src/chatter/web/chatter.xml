<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-inherit="mail.Chatter" t-inherit-mode="extension">
 <xpath expr="//div[hasclass('o-mail-Chatter')]" position="attributes">
 <attribute name="t-att-class">{ 'overflow-auto o-scrollbar-thin': this.props.isChatterAside and !this.isCollapsedAside, 'o-chatter-disabled': this.props.threadId === false, 'o-chatter-collapsed': this.isCollapsedAside }</attribute>
 </xpath>
 <xpath expr="//t[@name='chatter-collapsed']" position="inside">
 <t t-if="this.isCollapsedAside">
 <div class="o-mail-Chatter-collapsed d-flex flex-column align-items-center d-print-none" t-on-click="this.toggleChatterCollapse">
 <button class="btn btn-light btn-sm m-1 mb-2 p-2" title="Expand Chatter">
 <i class="oi oi-fw oi-panel-right"/>
 </button>
 <div class="o-mail-Chatter-collapsed-icon position-relative" title="Messages">
 <i class="fa-regular fa-comments"/>
 </div>
 <div t-if="this.attachments.length" class="o-mail-Chatter-collapsed-icon position-relative" title="Attachments">
 <i class="fa-solid fa-paperclip"/>
 <sup class="badge rounded-pill text-bg-primary" t-out="this.attachments.length"/>
 </div>
 <div t-if="this.props.has_activities and this.activities.length" class="o-mail-Chatter-collapsed-icon position-relative" title="Activities">
 <i class="fa-regular fa-clock"/>
 <sup class="badge rounded-pill text-bg-success" t-out="this.activities.length"/>
 </div>
 </div>
 </t>
 </xpath>
 <xpath expr="//t[@name='chatter-expanded']" position="attributes">
 <attribute name="t-if">!this.isCollapsedAside</attribute>
 </xpath>
 <xpath expr="//t[@name='chatter-topbar']" position="inside">
 <div class="o-mail-Chatter-topbar d-flex flex-shrink-0 flex-grow-0 overflow-x-auto">
 <div t-if="this.state.isSearchOpen" class="flex-grow-1">
 <SearchMessageInput closeSearch.bind="this.closeSearch" messageSearch="this.messageSearch" thread="this.state.thread"/>
 </div>
 <t t-else="" name="chatter-topbar-left-buttons">
 <button class="o-mail-Chatter-sendMessage btn text-nowrap me-1" t-att-class="{
 'btn-primary': this.state.composerType !== 'note',
 'btn-secondary': this.state.composerType === 'note',
 'active': this.state.composerType === 'message',
 'my-2': !this.props.compactHeight
 }" t-att-disabled="!this.state.thread.canPostMessage and this.props.threadId" data-hotkey="m" t-on-click="() => this.toggleComposer('message')">
 Send message
 </button>
 <button class="o-mail-Chatter-logNote btn text-nowrap me-1" t-att-class="{
 'btn-primary active': this.state.composerType === 'note',
 'btn-secondary': this.state.composerType !== 'note',
 'my-2': !this.props.compactHeight
 }" t-att-disabled="!this.state.thread.canPostMessage and this.props.threadId" data-hotkey="shift+m" t-on-click="() => this.toggleComposer('note')">
 Log note
 </button>
 <button t-if="this.props.has_activities" class="o-mail-Chatter-activity btn btn-secondary text-nowrap" t-att-class="{ 'my-2': !this.props.compactHeight }"
 t-att-disabled="!this.state.thread.canPostMessage and this.props.threadId"
 data-hotkey="shift+a" t-on-click="this.scheduleActivity">
 <span>Activity</span>
 </button>
 <span class="o-mail-Chatter-topbarGrow flex-grow-1 pe-2"/>
 <button class="btn btn-link text-action" aria-label="Search Messages" title="Search Messages" t-on-click="this.onClickSearch">
 <i class="oi oi-search" role="img"/>
 </button>
 </t>
 <button t-if="this.props.hasAttachmentPreview and this.state.thread.attachmentsInWebClientView.length" class="btn btn-link text-action" t-on-click="this.popoutAttachment">
 <i class="fa-regular fa-window-restore" aria-hidden="Pop out Attachments" title="Pop out Attachments"/>
 </button>
 <FileUploader t-if="this.attachments.length === 0" fileUploadClass="'o-mail-Chatter-fileUploader'" multiUpload="true" onUploaded="this.onUploaded(undefined, { thread: this.state.thread })" onClick="(ev) => this.onClickAttachFile(ev)" t-key="this.state.thread.localId" >
 <t t-set-slot="toggler">
 <t t-call="mail.Chatter.attachFiles"/>
 </t>
 </FileUploader>
 <t t-else="" t-call="mail.Chatter.attachFiles"/>
 <div class="o-mail-Followers d-flex me-1">
 <Dropdown position="'bottom-end'" menuClass="'o-mail-Followers-dropdown ' + this.store.discussDropdownMenuClass(this)" state="this.followerListDropdown">
 <button t-att-class="'o-mail-Followers-button btn btn-link d-flex align-items-center text-action px-1 ' + (this.props.compactHeight ? '' : 'my-2') + ' ' + (this.state.thread.selfFollower ? 'active' : '')" t-att-disabled="this.isDisabled" t-att-title="this.followerButtonLabel">
 <i class="" role="img" t-attf-class="{{ this.state.thread.selfFollower ? 'fa-solid fa-user' : 'fa-regular fa-user' }}"/>
 <i t-if="this.state.thread.id and this.state.thread.followersCount === undefined" class="fa-solid fa-circle-notch fa-spin"/>
 <sup t-else="" class="o-mail-Followers-counter" t-out="this.state.thread.followersCount ?? 0"/>
 </button>
 <t t-set-slot="content">
 <FollowerList onAddFollowers.bind="this.onAddFollowers" onFollowerChanged.bind="this.onFollowerChanged" thread="this.state.thread" dropdown="this.followerListDropdown"/>
 </t>
 </Dropdown>
 </div>
 <button t-if="this.props.isChatterAside" class="o-mail-Chatter-collapse btn btn-link text-action px-1" t-att-class="{ 'my-2': !this.props.compactHeight }" aria-label="Collapse Chatter" title="Collapse Chatter" t-on-click="this.toggleChatterCollapse">
 <i class="oi oi-fw oi-panel-right"/>
 </button>
 </div>
 </xpath>
 <xpath expr="//t[@name='chatter-composer']" position="replace">
 <t t-if="this.state.composerType">
 <t t-if="this.state.composerType === 'message'">
 <div class="d-flex py-1 ps-3">
 <span class="flex-shrink-0 text-end fw-bold px-2" style="width:46px">To: </span>
 <RecipientsInput thread="this.state.thread"/>
 </div>
 </t>
 <Composer composer="this.state.thread.composer" autofocus="true" className="this.state.composerType === 'message' ? '' : 'pt-4'" mode="'extended'" onPostCallback.bind="this.onPostCallback" onCloseFullComposerCallback.bind="this.onCloseFullComposerCallback" dropzoneRef="this.rootRef" type="this.state.composerType" t-key="this.props.threadId"/>
 </t>
 </xpath>
 <xpath expr="//t[@name='chatter-content-top']" position="inside">
 <t t-if="this.props.has_activities and this.activities.length and !this.messageSearch.searching and !this.messageSearch.searched">
 <t t-call="mail.ActivityList"/>
 </t>
 <t t-if="this.scheduledMessages.length">
 <t t-call="mail.ScheduledMessagesList"/>
 </t>
 <div t-if="this.state.isAttachmentBoxOpened" class="o-mail-AttachmentBox position-relative">
 <div class="d-flex align-items-center">
 <hr class="flex-grow-1"/>
 <span class="p-3 fw-bold">
 Files
 </span>
 <hr class="flex-grow-1"/>
 </div>
 <div class="d-flex flex-column">
 <AttachmentList
 attachments="this.attachments"
 unlinkAttachment.bind="this.unlinkAttachment"
 />
 <FileUploader multiUpload="true" fileUploadClass="'o-mail-Chatter-fileUploader'" onUploaded="this.onUploaded(undefined, { thread: this.state.thread })" onClick="(ev) => this.onClickAttachFile(ev)" t-key="this.state.thread.localId" >
 <t t-set-slot="toggler">
 <button class="btn btn-link" type="button" t-att-disabled="!this.state.thread.canPostMessage">
 <i class="fa-solid fa-plus-square"/>
 Attach files
 </button>
 </t>
 </FileUploader>
 </div>
 </div>
 </xpath>
 <xpath expr="//t[@name='chatter-thread']" position="replace">
 <SearchMessageResult t-if="this.messageSearch.searching or this.messageSearch.searched" thread="this.state.thread" messageSearch="this.messageSearch" onClickJump.bind="this.closeSearch"/>
 <Thread t-else="" thread="this.state.thread" t-key="this.state.thread.localId" order="'desc'" scrollRef="this.rootRef" jumpPresent="this.state.jumpThreadPresent"/>
 </xpath>
</t>

<t t-name="mail.ActivityList">
 <div class="o-mail-ActivityList">
 <div class="d-flex pt-2 px-2 cursor-pointer fw-bolder" t-on-click="this.toggleActivities">
 <hr class="flex-grow-1 fs-3"/>
 <div class="d-flex align-items-center px-3">
 <i class="fa-solid " t-att-class="this.state.showActivities ? 'fa-caret-down' : 'fa-caret-right'"/>
 Planned Activities
 <span t-if="!this.state.showActivities" class="badge rounded-pill ms-2 text-bg-success"><t t-out="this.activities.length"/></span>
 </div>
 <hr class="flex-grow-1 fe-3"/>
 </div>
 <t t-if="this.state.showActivities">
 <t t-foreach="this.activities" t-as="activity" t-key="activity.id">
 <Activity activity="activity" onActivityChanged.bind="this.onActivityChanged" reloadParentView.bind="this.reloadParentView"/>
 </t>
 </t>
 </div>
</t>

<t t-name="mail.ScheduledMessagesList">
 <div class="o-mail-ScheduledMessagesList">
 <div class="d-flex pt-2 cursor-pointer fw-bolder" t-on-click="this.toggleScheduledMessages">
 <hr class="flex-grow-1 fs-3"/>
 <div class="d-flex align-items-center px-3">
 <i class="fa-solid " t-att-class="this.state.showScheduledMessages ? 'fa-caret-down' : 'fa-caret-right'"/>
 Scheduled Messages
 <span t-if="!this.state.showScheduledMessages" class="badge rounded-pill ms-2 text-bg-success" t-out="this.scheduledMessages.length"/>
 </div>
 <hr class="flex-grow-1 fe-3"/>
 </div>
 <div t-if="this.state.showScheduledMessages">
 <t t-foreach="this.scheduledMessages" t-as="scheduledMessage" t-key="scheduledMessage.id">
 <ScheduledMessage scheduledMessage="scheduledMessage" onScheduledMessageChanged.bind="this.onScheduledMessageChanged"/>
 </t>
 </div>
 </div>
</t>

<t t-name="mail.Chatter.attachFiles">
 <button class="o-mail-Chatter-attachFiles btn btn-link text-action px-1 d-flex align-items-center" aria-label="Attach files" t-att-class="{ 'my-2': !this.props.compactHeight }" t-on-click="this.onClickAddAttachments"
 t-att-disabled="this.state.isSearchOpen || (!this.state.thread.canPostMessage and this.attachments.length === 0)">
 <i class="fa-solid fa-paperclip fa-lg me-1"/>
 <sup t-if="this.attachments.length > 0" t-out="this.attachments.length"/>
 <i t-if="!this.state.thread.areAttachmentsLoaded and this.state.thread.isLoadingAttachments and this.state.showAttachmentLoading" class="fa-solid fa-circle-notch fa-spin" aria-label="Attachment counter loading..."/>
 </button>
</t>

</templates>
