<?xml version="1.0"?>
<odoo>
    <data>
        <!-- mail.message tree: short view !-->
        <record model="ir.ui.view" id="view_message_tree">
            <field name="name">mail.message.list</field>
            <field name="model">mail.message</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <list string="Messages">
                    <field name="date"/>
                    <field name="subject"/>
                    <field name="author_id"/>
                    <field name="model"/>
                    <field name="res_id"/>
                </list>
            </field>
        </record>

        <!-- mail.message form: short view !-->
        <record id="mail_message_view_form" model="ir.ui.view">
            <field name="name">mail.message.view.form</field>
            <field name="model">mail.message</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form string="Message" duplicate="0">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_document"
                                type="object" class="oe_link" icon="article"
                                invisible="not model or res_id == 0">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Open Document</span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="subject"/>
                                <field name="date"/>
                                <field name="email_from"/>
                                <field name="author_id"/>
                                <field name="message_type"/>
                                <field name="subtype_id"/>
                                <field name="is_internal"/>
                            </group>
                            <group>
                                <field name="model"/>
                                <field name="res_id"/>
                                <field name="record_name"/>
                                <field name="parent_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Body" name="body">
                                <field name="body" widget="html_mail"/>
                            </page>
                            <page string="Gateway" name="gateway">
                                <group>
                                    <group>
                                        <field name="reply_to"/>
                                        <field name="reply_to_force_new"/>
                                    </group>
                                    <group>
                                        <field name="message_id"/>
                                        <field name="mail_server_id"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Recipients" name="recipients">
                                <group>
                                    <group>
                                        <field name="partner_ids" widget="many2many_tags"/>
                                        <field name="incoming_email_to"/>
                                        <field name="incoming_email_cc"/>
                                    </group>
                                    <group>
                                        <field name="notified_partner_ids" widget="many2many_tags"/>
                                        <field name="bookmarked_partner_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="notification_ids">
                                        <list>
                                            <field name="res_partner_id"/>
                                            <field name="is_read"/>
                                            <field name="notification_type"/>
                                            <field name="notification_status"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- mail.message search: wall view !-->
        <record model="ir.ui.view" id="view_message_search">
            <field name="name">mail.message.search</field>
            <field name="model">mail.message</field>
            <field name="priority">25</field>
            <field name="arch" type="xml">
                <search string="Messages Search">
                    <field name="body" string="Content" filter_domain="['|', ('subject', 'ilike', self), ('body', 'ilike', self)]" />
                    <field name="subject"/>
                    <field name="message_type"/>
                    <field name="author_id"/>
                    <field name="partner_ids"/>
                    <field name="model"/>
                    <field name="res_id"/>
                    <field name="parent_id"/>
                    <filter string="Has Mentions"
                            name="filter_has_mentions"
                            domain="[('partner_ids.user_ids', 'in', [uid])]"/>
                    <separator/>
                    <filter string="Need Action"
                            name="message_needaction" help="Unread messages"
                            domain="[('needaction', '=', True)]"/>
                    <group>
                        <filter string="Message Type" name="group_by_message_type" domain="[]" context="{'group_by': 'message_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_view_mail_message" model="ir.actions.act_window">
            <field name="name">Messages</field>
            <field name="res_model">mail.message</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_message_search"/>
        </record>

        <record id="mail_message_view_kanban_advanced_search" model="ir.ui.view">
            <field name="name">mail.message.view.kanban.advanced.search</field>
            <field name="model">mail.message</field>
            <field name="arch" type="xml">
                <kanban create="false" action="action_open_document" type="object" default_order="date desc, id desc"
                        group_create="false" records_draggable="false" js_class="mail_message_search_kanban">
                    <field name="attachment_ids"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <field name="author_id" widget="many2one_avatar_user" invisible="not author_id"/>
                                <field name="author_id" class="fw-bold text-truncate" invisible="not author_id"/>
                                <field name="email_from" class="fw-bold text-truncate" invisible="author_id"/>
                                <field name="date" class="ms-auto text-muted small text-nowrap"/>
                            </div>
                            <field name="subject" class="fw-bold text-truncate" invisible="not subject"/>
                            <field name="preview" class="text-muted text-break"/>
                            <footer class="align-items-center pt-1">
                                <span class="text-truncate">
                                    <i class="oi oi-fw me-1" data-icon="description" title="Document"/>
                                    <field name="record_model_name" class="text-muted"/>
                                    <span class="text-muted mx-1">&#8226;</span>
                                    <field name="record_name" class="fw-semibold"/>
                                </span>
                                <span t-if="record.attachment_ids.raw_value.length" class="ms-auto ps-2 text-nowrap text-muted">
                                    <i class="oi" data-icon="attach_file" title="Attachments"/>
                                    <t t-out="record.attachment_ids.raw_value.length"/>
                                </span>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="mail_message_view_list_advanced_search" model="ir.ui.view">
            <field name="name">mail.message.view.list.advanced.search</field>
            <field name="model">mail.message</field>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <list create="false" action="action_open_document" type="object" default_order="date desc, id desc">
                    <field name="date"/>
                    <field name="author_id" widget="many2one_avatar"/>
                    <field name="email_from" optional="hide"/>
                    <field name="subject" optional="show"/>
                    <field name="preview" string="Content"/>
                    <field name="message_type" optional="show"/>
                    <field name="subtype_id" optional="hide"/>
                    <field name="record_model_name" string="Document Type" optional="show"/>
                    <field name="record_name" string="Document"/>
                </list>
            </field>
        </record>

        <record id="mail_message_view_search_advanced_search" model="ir.ui.view">
            <field name="name">mail.message.view.search.advanced.search</field>
            <field name="model">mail.message</field>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <search string="Search Messages">
                    <!-- child_of: a company's messages include those of its contacts -->
                    <field name="author_id" operator="child_of"/>
                    <field name="body" string="Content" filter_domain="['|', ('subject', 'ilike', self), ('body', 'ilike', self)]"/>
                    <!-- keep external authors' notifications, they are their own words, e.g. ratings -->
                    <filter string="Hide System Messages" name="filter_hide_system"
                            domain="[('message_type', '!=', 'out_of_office'), '|', ('message_type', 'not in', ('notification', 'tracking', 'user_notification')), ('author_id.partner_share', '=', True)]"/>
                    <separator/>
                    <!-- channels like SMS reach the customer even when logged with an internal subtype -->
                    <filter string="Customer-Facing" name="filter_customer_facing"
                            domain="['|', ('message_type', 'not in', ('comment', 'email')), '|', ('subtype_id', '=', False), ('subtype_id.internal', '=', False)]"/>
                    <filter string="Internal Notes" name="filter_internal"
                            domain="[('message_type', 'in', ('comment', 'email')), ('subtype_id.internal', '=', True)]"/>
                    <separator/>
                    <filter string="With Attachments" name="filter_attachments" domain="[('attachment_ids', '!=', False)]"/>
                    <separator/>
                    <filter string="Date" name="filter_date" date="date"/>
                    <group>
                        <filter string="Conversation" name="group_by_conversation" context="{'group_by': 'record_ref'}"/>
                        <filter string="Author" name="group_by_author" context="{'group_by': 'author_id'}"/>
                        <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="mail_message_action_advanced_search" model="ir.actions.act_window">
            <field name="name">Messages</field>
            <field name="res_model">mail.message</field>
            <field name="view_mode">kanban,list</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('mail_message_view_kanban_advanced_search')}),
                (0, 0, {'view_mode': 'list', 'view_id': ref('mail_message_view_list_advanced_search')})]"/>
            <field name="search_view_id" ref="mail_message_view_search_advanced_search"/>
            <field name="domain">[('model', '!=', False), ('res_id', '!=', False)]</field>
            <field name="context">{'search_default_filter_hide_system': 1, 'search_default_group_by_conversation': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No messages found</p>
                <p>Messages written by this customer on any document you can access will show up here.</p>
            </field>
        </record>

        <record model="ir.ui.view" id="view_document_file_kanban">
            <field name="name">ir.attachment kanban</field>
            <field name="model">ir.attachment</field>
            <field name="arch" type="xml">
                <kanban edit="false" import="false" js_class="ir_attachment_kanban">
                    <field name="id"/>
                    <field name="mimetype"/>
                    <field name="type"/>
                    <templates>
                        <t t-name="menu">
                            <a t-attf-href="/web/content/#{record.id.raw_value}?download=true" download="" class="dropdown-item">Download</a>
                            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        </t>
                        <t t-name="card" class="o_kanban_attachment flex-row">
                            <aside class="o_kanban_image m-1">
                                <div class="o_kanban_image_wrapper d-flex align-items-center justify-content-center">
                                    <t t-set="webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png|webp)').test(record.mimetype.value)"/>
                                    <div t-if="record.type.raw_value == 'url'" class="oi oi-3x text-muted" data-icon="link" aria-label="Image is a link"/>
                                    <img t-elif="webimage" t-attf-src="/web/image/#{record.id.raw_value}" width="100" height="100" alt="Document" class="o_attachment_image"/>
                                    <div t-else="!webimage" class="o_image o_image_thumbnail" t-att-data-mimetype="record.mimetype.value"/>
                                </div>
                            </aside>
                            <main class="ms-1">
                                <div class="o_kanban_details_wrapper d-flex flex-column">
                                    <field name="name" class="text-truncate fw-bold fs-5"/>
                                    <div class="d-flex flex-grow-1 align-items-center">
                                        <t t-if="record.type.raw_value == 'url'">
                                            <i class="oi" data-icon="public" aria-label="Document url"/> <field name="url" widget="url"/>
                                        </t>
                                    </div>
                                    <div class="d-flex">
                                        <field name="create_date"/>
                                        <field name="create_uid" widget="many2one_avatar_user" class="ms-auto"/>
                                    </div>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="ir_attachment_view_list" model="ir.ui.view">
            <field name="name">ir.attachment.list.inherit.mail</field>
            <field name="model">ir.attachment</field>
            <field name="inherit_id" ref="base.view_attachment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="js_class">ir_attachment_list</attribute>
                </xpath>
            </field>
        </record>
        <record id="base.action_attachment" model="ir.actions.act_window">
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Attach a new document
              </p>
            </field>
        </record>

    </data>
</odoo>
