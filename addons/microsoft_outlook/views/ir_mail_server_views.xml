<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_mail_server_view_form" model="ir.ui.view">
        <field name="name">ir.mail_server.view.form.inherit.outlook</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="mail.ir_mail_server_form" />
        <field name="arch" type="xml">
            <field name="smtp_ssl_private_key" position="after">
                <div
                    invisible="smtp_authentication != 'outlook'"
                    class="d-flex flex-row align-items-center"
                    colspan="2"
                    groups="base.group_system">
                    <span
                        invisible="smtp_authentication != 'outlook' or not microsoft_outlook_refresh_token"
                        class="badge text-bg-success">
                        Outlook Token Valid
                    </span>
                    <button
                        name="open_microsoft_outlook_uri"
                        type="object"
                        invisible="smtp_authentication != 'outlook' or microsoft_outlook_refresh_token"
                        class="btn-link px-0">
                        <i class="oi oi-arrow-right" />
                        Connect your Outlook account
                    </button>
                    <button
                        name="open_microsoft_outlook_uri"
                        type="object"
                        invisible="smtp_authentication != 'outlook' or not microsoft_outlook_refresh_token"
                        class="btn-link px-0 ms-2">
                        <i class="fa-solid fa-cog" title="Edit Settings" />
                    </button>
                </div>
            </field>
            <field name="smtp_authentication_info" position="after">
                <widget
                    name="documentation_link"
                    invisible="smtp_authentication != 'outlook'"
                    label="Read More"
                    path="/applications/general/email_communication/email_servers.html?highlight=outgoing email server#use-a-default-from-email-address" />
            </field>
        </field>
    </record>

</odoo>
