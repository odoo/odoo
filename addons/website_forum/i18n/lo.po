#. module: website_forum
#. odoo-javascript
#: code:addons/website_forum/static/src/interactions/website_forum.js:0
msgid "%(score)s karma is required to perform this action."
msgstr "ຕ້ອງການ %(score)s karma ເພື່ອດຳເນີນການນີ້."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to accept or refuse an answer."
msgstr "ຕ້ອງການ %d karma ເພື່ອຍອມຮັບ ຫຼື ປະຕິເສດຄຳຕອບ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to answer a question."
msgstr "ຕ້ອງການ %d karma ເພື່ອຕອບຄຳຖາມ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to close or reopen a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອປິດ ຫຼື ເປີດໂພສຄືນໃໝ່."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_comment.py:0
msgid "%d karma required to convert a comment to an answer."
msgstr "ຕ້ອງການ %d karma ເພື່ອປ່ຽນຄຳເຫັນເປັນຄຳຕອບ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to convert an answer to a comment."
msgstr "ຕ້ອງການ %d karma ເພື່ອປ່ຽນຄຳຕອບເປັນຄຳເຫັນ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_comment.py:0
msgid "%d karma required to convert your comment to an answer."
msgstr "ຕ້ອງການ %d karma ເພື່ອປ່ຽນຄຳເຫັນຂອງທ່ານເປັນຄຳຕອບ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_tag.py:0
msgid "%d karma required to create a new Tag."
msgstr "ຕ້ອງການ %d karma ເພື່ອສ້າງແທັກໃໝ່."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to create a new question."
msgstr "ຕ້ອງການ %d karma ເພື່ອສ້າງຄຳຖາມໃໝ່."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to delete a comment."
msgstr "ຕ້ອງການ %d karma ເພື່ອລຶບຄຳເຫັນ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to delete or reactivate a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອລຶບ ຫຼື ເປີດໃຊ້ງານໂພສຄືນໃໝ່."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_vote.py:0
msgid "%d karma required to downvote."
msgstr "ຕ້ອງການ %d karma ເພື່ອລົງຄະແນນລົບ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to edit a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອແກ້ໄຂໂພສ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to flag a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອໝາຍລາຍງານໂພສ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/controllers/website_forum.py:0
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to mark a post as offensive."
msgstr "ຕ້ອງການ %d karma ເພື່ອໝາຍວ່າໂພສບໍ່ເໝາະສົມ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to post an image or link."
msgstr "ຕ້ອງການ %d karma ເພື່ອໂພສຮູບພາບ ຫຼື ລິ້ງ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to refuse a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອປະຕິເສດໂພສ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to retag."
msgstr "ຕ້ອງການ %d karma ເພື່ອປ່ຽນແທັກໃໝ່."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to unlink a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອຍົກເລີກການເຊື່ອມໂຍງໂພສ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to update a flagged post."
msgstr "ຕ້ອງການ %d karma ເພື່ອອັບເດດໂພສທີ່ຖືກໝາຍລາຍງານ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_vote.py:0
msgid "%d karma required to upvote."
msgstr "ຕ້ອງການ %d karma ເພື່ອລົງຄະແນນບວກ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post.py:0
msgid "%d karma required to validate a post."
msgstr "ຕ້ອງການ %d karma ເພື່ອກວດສອບຢືນຢັນໂພສ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_comment.py:0
msgid "%i karma required to comment."
msgstr "ຕ້ອງການ %i karma ເພື່ອອອກຄຳເຫັນ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_comment.py:0
msgid "%i karma required to delete a comment."
msgstr "ຕ້ອງການ %i karma ເພື່ອລຶບຄຳເຫັນ."

#. module: website_forum
#. odoo-python
#: code:addons/website_forum/models/forum_post_comment.py:0
msgid "%i karma required to edit a comment."
msgstr "ຕ້ອງການ %i karma ເພື່ອແກ້ໄຂຄຳເຫັນ."

