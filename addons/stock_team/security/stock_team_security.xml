<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!--
            Restricting which transfers a user sees is opt in. Record rules bind
            only the users in their groups, so a user outside both groups below
            keeps seeing every one of them, as before this module; a user in
            "Team Documents" also holds "Own Documents", whose rule is OR-ed in.
            Neither group grants access: that stays with stock.group_stock_user.
        -->
        <record id="res_groups_privilege_stock_documents" model="res.groups.privilege">
            <field name="name">Inventory Documents</field>
            <field name="sequence">11</field>
            <field name="category_id" ref="base.module_category_supply_chain" />
            <field name="placeholder">All Documents</field>
            <field
                name="description">Limit the transfers a user sees to their own, or to their teams'.</field>
        </record>
        <record id="group_stock_user_own" model="res.groups">
            <field name="name">Own Documents Only</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_documents" />
            <field
                name="comment">The user sees the transfers they are responsible for, and the ones nobody is.</field>
        </record>
        <record id="group_stock_user_team" model="res.groups">
            <field name="name">Team Documents</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_documents" />
            <field
                name="comment">The user also sees the transfers of their inventory teams.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_stock_user_own'))]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="team_team_rule_stock_manager" model="ir.rule">
            <field name="name">Inventory teams: Inventory Administrators</field>
            <field name="model_id" ref="team.model_team_team" />
            <field name="domain_force">[('use_stock', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock.group_stock_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <record id="team_member_rule_stock_manager" model="ir.rule">
            <field name="name">Inventory team members: Inventory Administrators</field>
            <field name="model_id" ref="team.model_team_member" />
            <field name="domain_force">[('team_id.use_stock', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock.group_stock_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <record id="team_alias_rule_stock_manager" model="ir.rule">
            <field name="name">Inventory team aliases: Inventory Administrators</field>
            <field name="model_id" ref="team.model_team_alias" />
            <field name="domain_force">[('team_id.use_stock', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock.group_stock_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <record id="stock_picking_own_rule" model="ir.rule">
            <field name="name">Stock Picking: Own Documents</field>
            <field name="model_id" ref="stock.model_stock_picking" />
            <field
                name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_own'))]" />
        </record>
        <record id="stock_picking_team_rule" model="ir.rule">
            <field name="name">Stock Picking: Team Documents</field>
            <field name="model_id" ref="stock.model_stock_picking" />
            <field
                name="domain_force">['|', '|', '|', '|', ('user_id', '=', False), ('user_id', '=', user.id), ('team_id', 'in', user.stock_team_ids.ids), ('picking_type_id.team_id', 'in', user.stock_team_ids.ids), ('user_id.stock_team_ids', 'in', user.stock_team_ids.ids)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_team'))]" />
        </record>
        <record id="stock_move_own_rule" model="ir.rule">
            <field name="name">Stock Move: Own Documents</field>
            <field name="model_id" ref="stock.model_stock_move" />
            <field
                name="domain_force">['|', ('picking_id', '=', False), '|', ('picking_id.user_id', '=', False), ('picking_id.user_id', '=', user.id)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_own'))]" />
        </record>
        <record id="stock_move_team_rule" model="ir.rule">
            <field name="name">Stock Move: Team Documents</field>
            <field name="model_id" ref="stock.model_stock_move" />
            <field
                name="domain_force">['|', ('picking_id', '=', False), '|', '|', '|', '|', ('picking_id.user_id', '=', False), ('picking_id.user_id', '=', user.id), ('picking_id.team_id', 'in', user.stock_team_ids.ids), ('picking_id.picking_type_id.team_id', 'in', user.stock_team_ids.ids), ('picking_id.user_id.stock_team_ids', 'in', user.stock_team_ids.ids)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_team'))]" />
        </record>
        <record id="stock_move_line_own_rule" model="ir.rule">
            <field name="name">Stock Move Line: Own Documents</field>
            <field name="model_id" ref="stock.model_stock_move_line" />
            <field
                name="domain_force">['|', ('picking_id', '=', False), '|', ('picking_id.user_id', '=', False), ('picking_id.user_id', '=', user.id)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_own'))]" />
        </record>
        <record id="stock_move_line_team_rule" model="ir.rule">
            <field name="name">Stock Move Line: Team Documents</field>
            <field name="model_id" ref="stock.model_stock_move_line" />
            <field
                name="domain_force">['|', ('picking_id', '=', False), '|', '|', '|', '|', ('picking_id.user_id', '=', False), ('picking_id.user_id', '=', user.id), ('picking_id.team_id', 'in', user.stock_team_ids.ids), ('picking_id.picking_type_id.team_id', 'in', user.stock_team_ids.ids), ('picking_id.user_id.stock_team_ids', 'in', user.stock_team_ids.ids)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_team'))]" />
        </record>
        <record id="stock_picking_batch_own_rule" model="ir.rule">
            <field name="name">Stock Picking Batch: Own Documents</field>
            <field name="model_id" ref="stock.model_stock_picking_batch" />
            <field
                name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_own'))]" />
        </record>
        <record id="stock_picking_batch_team_rule" model="ir.rule">
            <field name="name">Stock Picking Batch: Team Documents</field>
            <field name="model_id" ref="stock.model_stock_picking_batch" />
            <field
                name="domain_force">['|', '|', '|', '|', ('user_id', '=', False), ('user_id', '=', user.id), ('team_id', 'in', user.stock_team_ids.ids), ('picking_type_id.team_id', 'in', user.stock_team_ids.ids), ('user_id.stock_team_ids', 'in', user.stock_team_ids.ids)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('stock_team.group_stock_user_team'))]" />
        </record>
    </data>

</odoo>
