<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="team_view_search_stock" model="ir.ui.view">
        <field name="name">team.team.view.search.stock</field>
        <field name="model">team.team</field>
        <field name="inherit_id" ref="team.team_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//separator[@name='usages']" position="before">
                <filter
                    name="use_stock"
                    string="Inventory"
                    domain="[('use_stock', '=', True)]" />
            </xpath>
        </field>
    </record>

    <record id="team_view_form_stock" model="ir.ui.view">
        <field name="name">team.team.view.form.stock</field>
        <field name="model">team.team</field>
        <field name="inherit_id" ref="team.team_view_form" />
        <field name="arch" type="xml">
            <div name="usages" position="inside">
                <span class="d-inline-flex">
                    <field name="use_stock" />
                    <label for="use_stock" />
                </span>
            </div>
            <notebook position="inside">
                <page
                    name="stock_operations"
                    string="Operation Types"
                    invisible="not use_stock">
                    <field name="stock_picking_type_ids" readonly="1">
                        <list>
                            <field name="name" />
                            <field name="warehouse_id" />
                            <field name="code" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="team_action_stock" model="ir.actions.act_window">
        <field name="name">Inventory Teams</field>
        <field name="res_model">team.team</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('use_stock', '=', True)]</field>
        <field name="context">{'default_use_stock': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an inventory team
            </p><p>
                Give each operation type a team: its members see and run its transfers.
            </p>
        </field>
    </record>

</odoo>
