<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="address_form_fields" inherit_id="portal.address_form_fields">
        <option name="city_options" position="attributes">
            <attribute name="t-att-data-l10n_br_zip_ranges" add="c['l10n_br_zip_ranges']"/>
        </option>
        <!-- put base_address_extended fields separately to be more user-friendly -->
        <div id="div_street" position="attributes">
            <attribute
                name="t-attf-class"
                separator=" "
                add="o_standard_address {{'d-none' if country.code == 'BR' else ''}}"
            />
        </div>
        <input id="o_street" position="attributes">
            <attribute name="t-att-disabled">
                country.code == 'BR' and 'disabled' or None
            </attribute>
        </input>
        <div id="div_street" position="after">
            <div
                id="div_street_name"
                t-attf-class="col-lg-8 mb-2 o_extended_address {{
                    'd-none' if country.code != 'BR' else ''
                }}"
            >
                <label class="col-form-label" for="o_street_name">Street</label>
                <input
                    id="o_street_name"
                    type="text"
                    name="street_name"
                    class="form-control"
                    t-att-value="partner_sudo.street_name"
                    t-att-disabled="country.code != 'BR' and 'disabled' or None"
                />
            </div>
            <div
                id="div_street_number"
                t-attf-class="col-lg-4 mb-2 o_extended_address {{
                    'd-none' if country.code != 'BR' else ''
                }}"
            >
                <label class="col-form-label" for="o_street_number">Street Number</label>
                <input
                    id="o_street_number"
                    type="text"
                    name="street_number"
                    class="form-control"
                    t-att-value="partner_sudo.street_number"
                    t-att-disabled="country.code != 'BR' and 'disabled' or None"
                />
            </div>
            <div
                id="div_street_number2"
                t-attf-class="col-lg-6 mb-2 o_extended_address {{
                    'd-none' if country.code != 'BR' else ''
                }}"
            >
                <label class="col-form-label label-optional" for="o_street_number2">
                    Complement
                </label>
                <input
                    id="o_street_number2"
                    type="text"
                    name="street_number2"
                    class="form-control"
                    t-att-value="partner_sudo.street_number2"
                    t-att-disabled="country.code != 'BR' and 'disabled' or None"
                />
            </div>
        </div>
        <!-- street2 is used for neighborhood in Brazil, change the default label -->
        <label for="o_street2" position="attributes">
            <attribute
                name="t-attf-class"
                separator=" "
                add="o_standard_address {{'d-none' if country.code == 'BR' else ''}}"
            />
        </label>
        <label for="o_street2" position="after">
            <label
                for="o_street2"
                t-attf-class="col-form-label label-optional o_extended_address {{
                    'd-none' if country.code != 'BR' else ''
                }}"
            >
                Neighborhood
            </label>
        </label>
    </template>

</odoo>
