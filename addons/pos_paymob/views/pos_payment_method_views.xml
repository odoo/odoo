<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_paymob" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.paymob</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="paymob_api_key" invisible="use_payment_terminal != 'paymob'" required="use_payment_terminal == 'paymob'" password="True"/>
                <field name="paymob_terminal_identifier" invisible="use_payment_terminal != 'paymob'" required="use_payment_terminal == 'paymob'"/>
                <field name="paymob_hmac_secret" invisible="use_payment_terminal != 'paymob'" required="use_payment_terminal == 'paymob'" password="True"/>
                <field name="paymob_test_mode" invisible="use_payment_terminal != 'paymob'"/>
                <field name="paymob_callback_url" invisible="use_payment_terminal != 'paymob'" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
