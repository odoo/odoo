#. module: website_mass_mailing_sms
#: model:ir.module.module,description:base.module_website_mass_mailing_sms
msgid ""
"\n"
"This module adds a new template to the Newsletter Block to allow\n"
"your visitors to subscribe with their phone number.\n"
msgstr ""
"\n"
"ໂມດູນນີ້ເພີ່ມຮູບແບບໃໝ່ໃສ່ໃນ ບລັອກຈົດໝາຍຂ່າວ ເພື່ອໃຫ້\n"
"ຜູ້ເຂົ້າຊົມຂອງທ່ານສາມາດສະໝັກຮັບຂໍ້ມູນດ້ວຍເບີໂທລະສັບຂອງເຂົາເຈົ້າ.\n"

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.s_newsletter_sms_notifications
msgid ""
"<i class=\"oi oi-lg\" data-icon=\"check_circle\" role=\"img\"/> Thanks for "
"registering!"
msgstr ""
"<i class=\"oi oi-lg\" data-icon=\"check_circle\" role=\"img\"/> ຂອບໃຈສຳລັບການລົ"
"ງທະບຽນ!"

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.s_newsletter_block_sms_template
msgid "Always First."
msgstr "ກ່ອນໝູ່ສະເໝີ."

#. module: website_mass_mailing_sms
#: model:ir.module.module,summary:base.module_website_mass_mailing_sms
msgid "Attract visitors to subscribe to mailing lists"
msgstr "ດຶງດູດຜູ້ເຂົ້າຊົມໃຫ້ສະໝັກຮັບຂໍ້ມູນລາຍຊື່ຜູ້ຮັບຈົດໝາຍ"

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.s_newsletter_sms_notifications
msgid "Be the first to find out all the latest new, products and trends."
msgstr "ເປັນຄົນທຳອິດທີ່ຮັບຮູ້ຂ່າວສານ, ຜະລິດຕະພັນ ແລະ ທ່າອ່ຽງໃໝ່ລ່າສຸດທັງໝົດ."

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.s_newsletter_block_sms_template
msgid "Be the first to find out all the latest news, products, and trends."
msgstr "ເປັນຄົນທຳອິດທີ່ຮັບຮູ້ຂ່າວສານ, ຜະລິດຕະພັນ ແລະ ທ່າອ່ຽງໃໝ່ລ່າສຸດທັງໝົດ."

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.snippets
msgid "Newsletter"
msgstr "ຈົດໝາຍຂ່າວ"

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.snippets
msgid "Newsletter SMS Notifications"
msgstr "ການແຈ້ງເຕືອນຈົດໝາຍຂ່າວຜ່ານ SMS"

#. module: website_mass_mailing_sms
#: model:ir.module.module,shortdesc:base.module_website_mass_mailing_sms
msgid "Newsletter Subscribe SMS Template"
msgstr "ຮູບແບບ SMS ສຳລັບການສະໝັກຮັບຈົດໝາຍຂ່າວ"

#. module: website_mass_mailing_sms
#. odoo-javascript
#: code:addons/website_mass_mailing_sms/static/src/website_builder/newsletter_layout_option.xml:0
msgid "SMS Subscription"
msgstr "ການສະໝັກຮັບຂໍ້ມູນຜ່ານ SMS"

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.s_newsletter_sms_notifications
msgid "Stay in the Loop !<br/>Get the latest updates"
msgstr "ບໍ່ພາດທຸກຄວາມເຄື່ອນໄຫວ !<br/>ຮັບຂໍ້ມູນອັບເດດໃໝ່ລ່າສຸດ"

#. module: website_mass_mailing_sms
#: model_terms:ir.ui.view,arch_db:website_mass_mailing_sms.snippets
msgid ""
"updates, digests, bulletins, announcements, notifications, communication, "
"promotional, sms, alerts, dialogs, prompt, subscription, subscribe, news"
msgstr ""
"ອັບເດດ, ສະຫຼຸບຂ່າວ, ຈົດໝາຍແຈ້ງຂ່າວ, ແຈ້ງການ, ການແຈ້ງເຕືອນ, ການສື່ສານ, ໂປຣໂມຊັນ, sms, ການເຕື"
"ອນ, ກ່ອງຂໍ້ຄວາມ, ຂໍ້ຄວາມເຕືອນ, ການສະໝັກຮັບຂໍ້ມູນ, ສະໝັກຮັບຂໍ້ມູນ, ຂ່າວສານ"
