<?xml version="1.0"?>
<odoo>

    <record id="sale_order_form_quote" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale_management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">sale_order_form</attribute>
            </xpath>
            <field name="company_id" position="after">
                <field
                    name="sale_order_template_id"
                    options="{'no_create': True}"
                    readonly="state in ['cancel', 'sale']"
                />
            </field>

            <xpath expr="//form//div[@name='invoice_lines']" position="before">
                <group>
                    <field
                        name="is_optional"
                        invisible="display_type not in ['line_section', 'line_subsection']"
                        readonly="1"
                    />
                </group>
            </xpath>

            <xpath expr="//list/field[@name='linked_virtual_id']" position="after">
                <field name="is_optional" column_invisible="True"/>
            </xpath>

            <widget name="section_state" position="attributes">
                <attribute name="options">{'is_optional': 'radio_button_checked'}</attribute>
            </widget>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="purchase_price" groups="base.group_user"/>
            </xpath>

            <xpath
                expr="//field[@name='order_line']/list/column[@name='price_unit']"
                position="inside"
            >
                <field
                    name="margin"
                    widget="labeled_float_field"
                    invisible="display_type"
                    readonly="qty_invoiced &gt; 0"
                    optional="hide"
                />
                <field
                    name="margin_percent"
                    widget="labeled_percentage_field"
                    readonly="purchase_price == 0 or qty_invoiced &gt; 0"
                    invisible="display_type or price_subtotal == 0"
                    optional="hide"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list//field[@name='discount']"
                position="after"
            >
                <field name="purchase_price" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_pivot" model="ir.ui.view">
        <field name="name">sale.order.pivot.inherit.sale_management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_pivot"/>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="margin_percent" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="sale_order_graph" model="ir.ui.view">
        <field name="name">sale.order.graph.inherit.sale_management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_graph"/>
        <field name="arch" type="xml">
            <graph position="inside">
                <field name="margin_percent" invisible="1"/>
            </graph>
        </field>
    </record>

    <record id="model_sale_order_action_create_quotation_template" model="ir.actions.server">
        <field name="name">Save as template</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="state">code</field>
        <field name="code">if records: action = records.action_create_quotation_template()</field>
    </record>
</odoo>
