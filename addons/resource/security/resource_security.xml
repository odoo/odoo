<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="resource_schedule_exception_rule_group_user_create" model="ir.rule">
        <field
            name="name">resource.schedule.exception: employee reads own or global</field>
        <field name="model_id" ref="model_resource_schedule_exception" />
        <field
            name="domain_force">['|', ('resource_id', '=', False), ('resource_id.user_id', 'in', [False, user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="resource_schedule_exception_rule_group_user_modify" model="ir.rule">
        <field name="name">resource.schedule.exception: employee modifies own</field>
        <field name="model_id" ref="model_resource_schedule_exception" />
        <field name="domain_force">[('resource_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        <field name="perm_read" eval="False" />
    </record>

    <record id="resource_schedule_exception_rule_group_admin_modify" model="ir.rule">
        <field name="name">resource.schedule.exception: admin modifies any</field>
        <field name="model_id" ref="model_resource_schedule_exception" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_erp_manager'))]" />
        <field name="perm_read" eval="False" />
    </record>

    <record id="resource_resource_multi_company" model="ir.rule">
        <field name="name">resource.resource multi-company</field>
        <field name="model_id" ref="model_resource_resource" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="resource_schedule_exception_rule_multi_company" model="ir.rule">
        <field name="name">resource.schedule.exception: multi-company rule</field>
        <field name="model_id" ref="model_resource_schedule_exception" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="resource_reservation_rule_multi_company" model="ir.rule">
        <field name="name">resource.reservation: multi-company rule</field>
        <field name="model_id" ref="model_resource_reservation" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="resource_assignment_rule_multi_company" model="ir.rule">
        <field name="name">resource.assignment: multi-company rule</field>
        <field name="model_id" ref="model_resource_assignment" />
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

</odoo>
