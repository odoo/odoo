<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="inline_form">
        <div name="o_authorize_form"
             class="o_authorize_form"
             t-att-data-authorize-inline-form-values="provider_sudo._authorize_get_inline_form_values()"
        >
            <t t-if="pm_sudo.code == 'card'">
                <div class="mb-3">
                    <div class="form-floating">
                        <input
                            type="text"
                            id="o_authorize_card"
                            required=""
                            maxlength="19"
                            class="form-control"
                            placeholder=" "
                        />
                        <label for="o_authorize_card" class="col-form-label">Card Number</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-8 mb-3">
                        <label for="o_authorize_month">Expiration</label>
                        <div class="input-group">
                            <input type="number" id="o_authorize_month" placeholder="MM" min="1" max="12" required="" class="form-control"/>
                            <input type="number" id="o_authorize_year" placeholder="YY" min="00" max="99" required="" class="form-control"/>
                        </div>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <div class="form-floating">
                            <input
                                type="number"
                                id="o_authorize_code"
                                max="9999"
                                class="form-control"
                                placeholder=" "
                            />
                            <label for="o_authorize_code">Card Code</label>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="" >
                <div class="mb-3">
                    <div class="form-floating">
                        <input
                            type="text"
                            id="o_authorize_bank_name"
                            required=""
                            class="form-control"
                            placeholder=" "
                        />
                        <label for="o_authorize_bank_name" class="col-form-label">Bank Name</label>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-floating">
                        <input
                            type="text"
                            id="o_authorize_account_name"
                            required=""
                            class="form-control"
                            placeholder=" "
                        />
                        <label
                            for="o_authorize_account_name"
                            class="col-form-label"
                        >
                            Name On Account
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-floating">
                        <input
                            type="text"
                            id="o_authorize_account_number"
                            required=""
                            class="form-control"
                            placeholder=" "
                        />
                        <label
                            for="o_authorize_account_number"
                            class="col-form-label"
                        >
                            Account Number
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-floating">
                        <input
                            type="text"
                            id="o_authorize_aba_number"
                            required=""
                            class="form-control"
                            placeholder=" "
                        />
                        <label
                            for="o_authorize_aba_number"
                            class="col-form-label"
                        >
                            ABA Routing Number
                        </label>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-floating">
                        <select id="o_authorize_account_type" required="" class="form-select">
                            <option value="checking">Personal Checking</option>
                            <option value="savings">Personal Savings</option>
                            <option value="businessChecking">Business Checking</option>
                        </select>
                        <label
                            for="o_authorize_account_type"
                            class="col-form-label"
                        >
                            Bank Account Type
                        </label>
                    </div>
                </div>
            </t>
        </div>
    </template>

</odoo>
