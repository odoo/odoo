<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_device_view_form" model="ir.ui.view">
        <field name="name">resource.asset.device.form</field>
        <field name="model">resource.asset.device</field>
        <field name="inherit_id" ref="resource_asset_view_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="model_year" position="after">
                <field name="imei" />
            </field>
        </field>
    </record>

    <record id="resource_asset_property_view_form" model="ir.ui.view">
        <field name="name">resource.asset.property.form</field>
        <field name="model">resource.asset.property</field>
        <field name="inherit_id" ref="resource_asset_view_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="model_year" position="after">
                <field name="cadastral_id" />
            </field>
        </field>
    </record>

    <record id="resource_asset_telecom_view_form" model="ir.ui.view">
        <field name="name">resource.asset.telecom.form</field>
        <field name="model">resource.asset.telecom</field>
        <field name="inherit_id" ref="resource_asset_view_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="model_year" position="after">
                <field name="imei" />
            </field>
        </field>
    </record>

</odoo>
