    <record id="identifier_type_serial" model="resource.asset.identifier.type">
        <field name="name">Serial Number</field>
        <field name="code">serial</field>
        <field name="sequence">1</field>
        <field name="unique_scope">global</field>
    </record>

    <record id="identifier_type_plate" model="resource.asset.identifier.type">
