<?xml version="1.0" encoding="UTF-8" ?>
<template>
    <t t-name="hr_work_entry.WorkEntryCalendarCommonPopover.footer" t-inherit="web.CalendarCommonPopover.footer" t-inherit-mode="primary">
        <xpath expr="." position="inside">
            <span t-if="this.isWorkEntryValidated"><i class="fa-solid fa-lock me-1"/> You cannot edit a validated work entry</span>
        </xpath>
        <a t-on-click="this.onEditEvent" position="after">
            <a href="#" class="btn btn-secondary" t-if="this.isSplittable" t-on-click="this.onSplitEvent">
                Split
            </a>
        </a>
        <a t-on-click="this.onDeleteEvent" position="attributes">
            <attribute name="class" add="ms-auto btn-danger" remove="btn-secondary" separator=" "/>
        </a>
    </t>
</template>
