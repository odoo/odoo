<?xml version="1.0" ?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hr.work.entry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <group name="identification_group" position="after">
                <group name="exports" string="Export">
                    <field name="external_code" placeholder="Code used in work entry exports"/>
                </group>
            </group>
        </field>
    </record>

    <record id="action_hr_employee_export_work_entries" model="ir.actions.server">
        <field name="name">Export Time Entries</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('hr_work_entry.action_open_export_wizard').read()[0]
        </field>
    </record>
</odoo>
