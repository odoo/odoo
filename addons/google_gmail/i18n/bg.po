#. module: google_gmail
#. odoo-python
#: code:addons/google_gmail/models/ir_mail_server.py:0
msgid ""
"Incorrect Connection Security for Gmail mail server “%s”. Please set it to "
"\"TLS (STARTTLS)\"."
msgstr ""
"Неправилна сигурност на връзката за пощенския сървър на Gmail “%s”. Моля, "
"задайте я на \"TLS (STARTTLS)\"."

