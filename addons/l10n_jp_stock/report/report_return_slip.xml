<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_return_slip" inherit_id="stock.report_return_slip" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_document_date" t-value="o.date_done if o.state == 'done' else o.scheduled_date"/>
            <t t-if="o.partner_id" t-set="address">
                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "jp_honorific": True}'/>
            </t>
        </xpath>
    </template>

    <template id="report_return_document" inherit_id="stock.report_return_document">
        <xpath expr="//t[@t-call='stock.report_return_slip']" position="attributes">
            <attribute name="t-if" add="o.company_id.account_fiscal_country_id.code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='stock.report_return_slip']" position="after">
            <t t-elif="o.company_id.account_fiscal_country_id.code == 'JP'" t-call="l10n_jp_stock.report_return_slip" t-lang="o._get_report_lang()"/>
        </xpath>
    </template>
</odoo>
