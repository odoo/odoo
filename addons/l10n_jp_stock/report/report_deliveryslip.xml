<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-set='address']" position="before">
            <t t-set="jp_layout" t-value="o.company_id.external_report_layout_id.sudo().key == 'l10n_jp.external_layout_jp_standard'"/>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_recipient_partner" t-value="partner and partner.commercial_partner_id or o.partner_id.commercial_partner_id or o.partner_id"/>
            <t t-set="jp_document_date" t-value="o.date_done if o.state == 'done' else o.scheduled_date"/>
            <!-- The Japanese Business layout prints the title at the top of the page. -->
            <t t-if="jp_layout">
                <t t-set="layout_document_title">
                    <span t-out="o._get_deliveryslip_report_title()"/>
                    <span t-field="o.name"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('page')]/h2" position="attributes">
            <attribute name="t-if">not layout_document_title</attribute>
        </xpath>

        <!-- The Japanese Business layout heads the address with the recipient's name and honorific. -->
        <xpath expr="//div[@name='partner_header']/div[@t-field='partner.commercial_partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "phone", "vat"] if jp_layout else ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}</attribute>
        </xpath>
    </template>
</odoo>
