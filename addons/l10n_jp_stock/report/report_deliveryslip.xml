<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_document_date" t-value="o.date_done if o.state == 'done' else o.scheduled_date"/>
            <t t-set="layout_document_title">
                <span t-out="o._get_deliveryslip_report_title()"/>
                <span t-field="o.name"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('page')]/h2" position="replace"/>

        <!-- The recipient's name heads the delivery address with its honorific; the warehouse's is ours. -->
        <xpath expr="//div[@name='outgoing_delivery_address']/div" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True, "jp_honorific": True}</attribute>
        </xpath>
    </template>

    <template id="report_deliveryslip" inherit_id="stock.report_deliveryslip">
        <xpath expr="//t[@t-call='stock.report_delivery_document']" position="attributes">
            <attribute name="t-if" add="o.company_id.account_fiscal_country_id.code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='stock.report_delivery_document']" position="after">
            <t t-elif="o.company_id.account_fiscal_country_id.code == 'JP'" t-call="l10n_jp_stock.report_delivery_document" t-lang="o._get_report_lang()"/>
        </xpath>
    </template>
</odoo>
