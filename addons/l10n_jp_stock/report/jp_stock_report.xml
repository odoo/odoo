<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="before">
                <t t-set="jp_recipient_partner" t-value="partner and partner.commercial_partner_id or o.partner_id.commercial_partner_id or o.partner_id"/>
            </xpath>

            <xpath expr="//div[@name='partner_header']/div[@t-field='partner.commercial_partner_id']" position="attributes">
                <attribute name="t-options">{"widget": "contact", "fields": ["address", "phone", "vat"], "no_marker": True, "phone_icons": True}</attribute>
            </xpath>
        </template>
    </data>
</odoo>
