<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="before">
                <t t-set="jp_recipient_partner" t-value="partner and partner.commercial_partner_id or o.partner_id.commercial_partner_id or o.partner_id"/>
                <t t-set="layout_document_title">
                    <span t-out="o.with_context(lang=o._get_report_lang())._get_deliveryslip_report_title()"/>
                    <span t-field="o.name"/>
                </t>
            </xpath>
            <xpath expr="//div[hasclass('page')]/h2" position="attributes">
                <attribute name="t-if">not layout_document_title</attribute>
            </xpath>

            <xpath expr="//div[@name='partner_header']/div[@t-field='partner.commercial_partner_id']" position="attributes">
                <attribute name="t-options">{"widget": "contact", "fields": ["address", "phone", "vat"], "no_marker": True, "phone_icons": True}</attribute>
            </xpath>
        </template>

        <template id="report_return_slip" inherit_id="stock.report_return_slip">
            <xpath expr="//t[@t-call='web.external_layout']" position="before">
                <t t-set="layout_document_title"><t t-out="o.with_context(lang=o._get_report_lang())._get_return_slip_report_title()"/> <t t-out="o.name"/></t>
            </xpath>
        </template>

        <template id="return_label_header" inherit_id="stock.return_label_header">
            <xpath expr="//h1" position="attributes">
                <attribute name="t-if">not layout_document_title</attribute>
            </xpath>
        </template>
    </data>
</odoo>
