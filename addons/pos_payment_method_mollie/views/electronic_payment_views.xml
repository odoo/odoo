<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_electronic_payment_view_form_mollie" model="ir.ui.view">
        <field name="name">pos.electronic.payment.form.inherit.mollie</field>
        <field name="model">pos.electronic.payment</field>
        <field name="inherit_id" ref="pos_payment_method.pos_electronic_payment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'mollie'">
                    <page name="settings" string="Mollie">
                        <group>
                            <field name="mollie_payment_provider_id" invisible="payment_provider != 'mollie'" required="payment_provider == 'mollie'"/>
                            <field
                                name="mollie_api_key"
                                password="True"
                                readonly="False"
                                invisible="payment_provider != 'mollie' or not mollie_payment_provider_id"
                                required="payment_provider == 'mollie'"
                            />
                            <field name="mollie_terminal_id" invisible="payment_provider != 'mollie'" required="payment_provider == 'mollie'"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
