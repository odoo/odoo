#. module: account_qr_code_emv
#. odoo-python
#: code:addons/account_qr_code_emv/models/res_bank.py:0
msgid ""
"No EMV QR Code is available for the country of the account %"
"(account_number)s."
msgstr "ບໍ່ມີ EMV QR Code ທີ່ໃຊ້ໄດ້ສຳລັບປະເທດຂອງບັນຊີ %(account_number)s."

#. module: account_qr_code_emv
#: model:ir.model.fields.selection,name:account_qr_code_emv.selection__res_partner_bank__proxy_type__none
msgid "None"
msgstr "ບໍ່ມີ"

#. module: account_qr_code_emv
#: model_terms:ir.ui.view,arch_db:account_qr_code_emv.view_partner_bank_form_inherit_account
msgid "Payment QR Settings"
msgstr "ການຕັ້ງຄ່າ QR ການຊຳລະເງິນ"

#. module: account_qr_code_emv
#: model:ir.model.fields,help:account_qr_code_emv.field_account_setup_bank_manual_config__proxy_type
#: model:ir.model.fields,help:account_qr_code_emv.field_res_partner_bank__proxy_type
msgid ""
"The identification method linked to this bank account (e.g., Mobile Number, "
"Company ID) used to route QR payments to this account."
msgstr ""
"ວິທີລະບຸຕົວຕົນທີ່ເຊື່ອມໂຍງກັບບັນຊີທະນາຄານນີ້ (ຕົວຢ່າງ: ເບີໂທລະສັບ, ລະຫັດບໍລິສັດ) ທີ່ໃຊ້ເພື່ອສົ່ງຕໍ່ການຊຳລະເງິ"
"ນດ້ວຍ QR ເຂົ້າບັນຊີນີ້."

#. module: account_qr_code_emv
#: model:ir.model.fields,help:account_qr_code_emv.field_account_setup_bank_manual_config__proxy_value
#: model:ir.model.fields,help:account_qr_code_emv.field_res_partner_bank__proxy_value
msgid ""
"The specific number or ID linked to this bank account that matches the "
"chosen Identifier Type."
msgstr ""
"ຕົວເລກສະເພາະ ຫຼື ລະຫັດທີ່ເຊື່ອມໂຍງກັບບັນຊີທະນາຄານນີ້ ເຊິ່ງກົງກັບປະເພດລະບຸທີ່ເລືອກໄວ້."

