<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_eg</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting string="Egyptian Dual Language Invoices" company_dependent="1"
                         invisible="company_country_code != 'EG'"
                         help="Add Arabic as a secondary language to your invoices, credit notes, debit notes, vendor bills, and refund bills">
                    <field name="l10n_eg_dual_language_invoice"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
