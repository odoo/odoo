#. module: pos_self_order
#: model:mail.template,body_html:pos_self_order.delivery_email_template
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"                    <t t-set=\"client\" t-value=\"object.partner_id\"></t>\n"
"                    <t t-set=\"client_name\" t-value=\"client.name\"></t>\n"
"                    <t t-set=\"street\" t-value=\"client.street or ''\"></"
"t>\n"
"                    <t t-set=\"state\" t-value=\"client.state_id.name or "
"''\"></t>\n"
"                    <t t-set=\"city\" t-value=\"client.city or ''\"></t>\n"
"                    <t t-set=\"country\" t-value=\"client.country_id.name or "
"''\"></t>\n"
"                    <t t-set=\"store_name\" t-"
"value=\"object.config_id.name\"></t>\n"
"                    <t t-set=\"tz\" t-"
"value=\"object.company_id.partner_id.tz\"></t>\n"
"                    <t t-set=\"lg\" t-value=\"object.partner_id.lang or "
"user.lang\"></t>\n"
"                    <div>\n"
"                        <t t-if=\"client_name\">Hello <t t-"
"out=\"client_name\">Client name</t>,</t>\n"
"                        <t t-else=\"\">Hello,</t>\n"
"                    </div>\n"
"                    <br>\n"
"                    <div>Your order <t t-out=\"object.tracking_number\">...</"
"t> amounting in <t t-"
"out=\"format_amount(object.amount_total,object.currency_id)\">$xx.xx</t> has "
"been confirmed. <span t-if=\"object.preset_time or client.street\">It will "
"be ready</span> <span t-if=\"object.preset_time\">at <t t-"
"out=\"format_time(time=object.preset_time, tz=tz, time_format='short', "
"lang_code=lg)\">12:00 pm</t></span> <span t-if=\"client.street\">at <t t-"
"out=\"street\">street</t>, <t t-out=\"state\">state</t>, <t t-"
"out=\"client.zip or ''\">zip</t>, <t t-out=\"city\">city</t>, <t t-"
"out=\"country\">country</t></span></div>\n"
"                    <br>\n"
"                    <div>Thank you,</div>\n"
"                    <br>\n"
"                    <div t-if=\"object.state == 'paid'\">\n"
"                        <div>You can download your receipt <a t-attf-"
"href=\"{{ object.get_base_url() }}/pos-self-order/receipt/{{ object.id }}?"
"access_token={{ object.access_token }}\">here</a></div>\n"
"                        <br>\n"
"                    </div>\n"
"                    <t t-out=\"store_name\">Store name</t>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"                    <t t-set=\"client\" t-value=\"object.partner_id\"></t>\n"
"                    <t t-set=\"client_name\" t-value=\"client.name\"></t>\n"
"                    <t t-set=\"street\" t-value=\"client.street or ''\"></t>"
"\n"
"                    <t t-set=\"state\" t-value=\"client.state_id.name or "
"''\"></t>\n"
"                    <t t-set=\"city\" t-value=\"client.city or ''\"></t>\n"
"                    <t t-set=\"country\" t-value=\"client.country_id.name or "
"''\"></t>\n"
"                    <t t-set=\"store_name\" t-"
"value=\"object.config_id.name\"></t>\n"
"                    <t t-set=\"tz\" t-"
"value=\"object.company_id.partner_id.tz\"></t>\n"
"                    <t t-set=\"lg\" t-value=\"object.partner_id.lang or "
"user.lang\"></t>\n"
"                    <div>\n"
"                        <t t-if=\"client_name\">Salut <t t-"
"out=\"client_name\">Numele clientului</t>,</t>\n"
"                        <t t-else=\"\">Salut,</t>\n"
"                    </div>\n"
"                    <br>\n"
"                    <div>Comanda ta <t t-out=\"object.tracking_number\">...</"
"t> în valoare de <t t-out=\"format_amount"
"(object.amount_total,object.currency_id)\">$xx.xx</t> a fost confirmată. "
"<span t-if=\"object.preset_time or client.street\">Va fi gata</span> <span t-"
"if=\"object.preset_time\">la <t t-out=\"format_time(time=object.preset_time, "
"tz=tz, time_format='short', lang_code=lg)\">12:00 pm</t></span> <span t-"
"if=\"client.street\">la <t t-out=\"street\">stradă</t>, <t t-out=\"state\">"
"județ</t>, <t t-out=\"client.zip or ''\">cod poștal</t>, <t t-out=\"city\">"
"oraș</t>, <t t-out=\"country\">țară</t></span></div>\n"
"                    <br>\n"
"                    <div>Îți mulțumim,</div>\n"
"                    <br>\n"
"                    <div t-if=\"object.state == 'paid'\">\n"
"                        <div>Poți descărca bonul <a t-attf-href=\"{{ "
"object.get_base_url() }}/pos-self-order/receipt/{{ object.id }}?access_token="
"{{ object.access_token }}\">aici</a></div>\n"
"                        <br>\n"
"                    </div>\n"
"                    <t t-out=\"store_name\">Numele magazinului</t>\n"
"                </div>\n"
"            "

