<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.QuantityWidget">
        <div class="o_self_quantity_widget btn-group user-select-none" role="group" aria-label="Quantity select">
            <button type="button"
                    t-on-click="() => this.changeQuantity(false)"
                    class="btn btn-light border"
                    t-att-disabled="this.state.qty &lt;= 1 or (this.canChangeQuantity and !this.canChangeQuantity())">
                    <i class="oi oi-fw" data-icon="remove"/>
            </button>
            <div class="o-so-tabular-nums py-2 m-0 px-4 h-100 border-top border-bottom text-bg-light fs-3 fw-bold" t-out="this.state.qty"/>
            <button type="button"
                    t-on-click="() => this.changeQuantity(true)"
                    class="btn btn-light border"
                    t-att-disabled="this.canChangeQuantity and !this.canChangeQuantity()">
                    <i class="oi oi-fw" data-icon="add"/>
            </button>
        </div>
    </t>
</templates>
