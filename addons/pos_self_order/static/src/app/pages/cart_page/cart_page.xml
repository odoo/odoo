<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.CartPage">
        <div class="o_self_cart_page d-flex flex-column vh-100 overflow-hidden o_self_background o_self_fade" t-attf-style="background-image:#{this.selfOrder.kioskBackgroundImageUrl};background-size: cover; background-position: center;">
            <div class="d-flex flex-column flex-grow-1 overflow-y-auto pb-2 pb-sm-3 pt-3 py-lg-4" t-ref="this.scrollContainerRef">
                <div class="d-flex justify-content-end px-3">
                    <button t-if="this.showCancelButton" t-on-click="() => this.cancelOrder()" class="btn btm-xs btn-secondary" type="button">
                        <span>Cancel</span>
                    </button>
                </div>
                <div class="container o_self_container mt-auto cart_container">
                    <h1 class="ms-3 ms-sm-0 mb-3 ">Your Order</h1>
                    <div class="order_box d-flex flex-column bg-white px-3 px-kiosk-p-4 rounded-4 border border-light shadow-sm">
                        <t t-set="display_change_quantity" t-value="this.isCheckout and Object.keys(this.selfOrder.currentOrder.changes).length &gt; 0"/>
                        <t t-foreach="this.lines" t-as="line" t-key="line.uuid">
                            <div t-attf-class="product-cart-item d-flex align-items-center py-3 py-kiosk-p-4 {{!line_last ? 'border-bottom border-medium' : ''}}">
                                <t t-set="product" t-value="line.product_id"/>
                                <div class="product_img w-25 me-3 me-kiosk-p-4 ratio ratio-1x1 align-self-start">
                                    <img class="object-fit-scale rounded-4" t-attf-src="/web/image/product.product/{{product.id}}/image_512?unique=#{product.write_date}" loading="lazy"/>
                                </div>
                                <div class="w-100" >
                                    <div class="text-break fs-4 fw-bold "><span t-if="!display_change_quantity" class="fw-normal"><t t-out="this.getLineDisplayQty(line)"/>x </span><t t-out="product.name"/></div>
                                    <t t-set="attribute_ids" t-value="this.getAttributes(line)"/>
                                    <div t-if="attribute_ids.length > 0 || line.combo_line_ids.length > 0" class="border-start mt-2">
                                        <t t-if="attribute_ids.length > 0" >
                                            <div t-foreach="attribute_ids" t-as="attrVal" t-key="attrVal.id" class="ps-3 mt-1 text-muted">
                                                <t t-out="attrVal.attribute_id.name" />:
                                                <t t-out="attrVal.name" />
                                                <t t-set="custom_value" t-value="this.getCustomValue(line, attrVal)"/>
                                                <t t-if="custom_value">: <t t-out="custom_value" /></t>
                                            </div>
                                        </t>
                                        <div t-foreach="line.combo_line_ids" t-as="cline" t-key="cline.uuid" class="ps-3 mb-2">
                                            <t t-set="c_qty" t-value="cline.qty / line.qty"/>
                                            <span t-if="(c_qty &gt; 1)"><t t-out="c_qty"/>x </span>
                                            <t t-out="this.formatProductName(cline.product_id)"/>
                                            <div t-foreach="cline.attribute_value_ids" t-as="attrVal" t-key="attrVal.id" class="ps-3 mt-1 text-muted">
                                                <t t-out="attrVal.attribute_id.name" />:
                                                <t t-out="attrVal.name" />
                                                <t t-set="custom_value" t-value="this.getCustomValue(cline, attrVal)"/>
                                                <t t-if="custom_value">: <t t-out="custom_value" /></t>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex w-100 justify-content-between align-items-center mt-3 mt-md-4">
                                        <!-- Quantity -->
                                        <div t-if="display_change_quantity and !line.isDeliveryLine and !line.isServiceFeeLine()" class="btn-group" >
                                            <button
                                                    t-if="this.canDeleteLine(line) &amp;&amp; this.getLineChangeQty(line) > 1"
                                                    type="button"
                                                    t-on-click="() => this.changeQuantity(line, false)"
                                                    class="btn btn-secondary py-1 px-2"><i class="oi oi-fw" data-icon="remove"/></button>
                                            <button
                                                    t-else=""
                                                    type="button"
                                                    t-on-click="(e) => this.removeLine(line,e)"
                                                    class="btn btn-secondary py-1 px-2"><i class="oi oi-fw" data-icon="delete"/></button>
                                            <div class="o-so-tabular-nums fs-4 d-flex align-items-center m-0 px-4 py-2 text-bg-secondary fw-bolder" t-out="this.getLineChangeQty(line)"/>
                                            <button type="button"
                                                    t-on-click="() => this.changeQuantity(line, true)"
                                                    class="btn btn-secondary py-1 px-2"
                                                    t-att-class="{'border-secondary': this.isLineQuantityAtMaximum(line)}"
                                                    t-att-disabled="this.isLineQuantityAtMaximum(line)"
                                                    ><i class="oi oi-fw" data-icon="add"/></button>
                                        </div>
                                        <div t-else=""/>
                                        <div class="fs-4 fw-bold line-price mb-0 o-so-tabular-nums fw-bold text-primary" t-out="this.selfOrder.formatMonetary(this.getPrice(line))"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="container o_self_container" t-if="!this.selfOrder.kioskMode">
                    <hr/>
                    <button class="d-flex rounded-4 bg-secondary p-3 justify-content-between align-items-center order-note w-100 border-0 text-start" t-on-click="this.openNotePopup">
                        <div>
                            <div class="fw-bolder" style="font-size: 1.1rem;" t-out="this.orderNote ? 'Order note' : 'Add an order note'"/>
                            <div t-if="this.orderNote" class="text-muted mt-1" t-out="this.orderNote"/>
                            <div t-else="" class="text-muted small">Utensils, special instructions, etc.</div>
                        </div>
                        <span class="d-flex align-items-center justify-content-center" style="width: 2.2rem; height: 2.2rem;">
                            <i class="oi oi-filled" t-att-data-icon="this.orderNote ? 'edit' : 'add'"/>
                        </span>
                    </button>
                </div>
                <div class="container o_self_container" t-if="this.showTipSection">
                    <hr/>
                    <div class="fw-bolder mb-2 fs-5">
                        Add a tip
                    </div>
                    <div class="d-flex gap-1 w-100">
                        <t t-foreach="this.tipPercentages" t-as="percentage" t-key="percentage">
                            <button
                                type="button"
                                t-on-click="() => this.selectTipPercent(percentage)"
                                class="btn bg-white rounded-4 flex-fill w-0 py-3 px-2 border-2 d-flex flex-column align-items-center justify-content-center"
                                t-att-class="this.tipAmountForPercent(percentage) === this.tipAmount ? 'border-primary' : 'border-transparent'">
                                <div class="fw-bold lh-1" style="font-size: clamp(1rem, 4vw, 1.5rem); white-space: nowrap;">
                                    <t t-out="percentage"/>%
                                </div>
                                <div class="text-primary fw-semibold"
                                    style="font-size: clamp(0.75rem, 2.5vw, 1rem); white-space: nowrap;"
                                    t-out="this.selfOrder.formatMonetary(this.tipAmountForPercent(percentage))"/>
                            </button>
                        </t>
                        <button
                            type="button"
                            t-on-click="this.openTipNumpad"
                            class="btn bg-white rounded-4 flex-fill w-0 py-3 px-2 border-2 d-flex flex-column align-items-center justify-content-center"
                            t-att-class="this.isCustomTip ? 'border-primary' : 'border-transparent'">
                            <div
                                class="fw-bold lh-1"
                                style="font-size: clamp(0.9rem, 3.5vw, 1.25rem); white-space: nowrap;"
                                t-att-class="{'text-primary': this.isCustomTip}">
                                <t t-if="this.isCustomTip" t-out="this.selfOrder.formatMonetary(this.tipAmount)"/>
                                <t t-else="">Other</t>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
            <div class="o_self_footer border-top border-bottom bg-white py-2 py-lg-3" t-att-class="{'o_self_shadow_bottom': this.scrollShadow.bottom}">
                <div class="container o_self_container order-price d-flex flex-column gap-0 gap-lg-1 align-items-end px-md-4" >
                    <t t-set="total" t-value="this.totalPriceAndTax"/>
                    <div class="fs-3 fw-bold o-so-tabular-nums mb-0 pe-sm-2 pe-kiosk-p-4">Total: <span class="text-primary"><t t-out="this.selfOrder.formatMonetary(total.priceWithTax)" /></span><span t-if="this.tipAmount" class="fs-6 fw-normal text-muted">&#160;(Tips included)</span></div>
                    <div class="fs-4 o-so-tabular-nums mb-0 pe-sm-2 pe-kiosk-p-4 text-muted" t-if="this.displayTaxes">Taxes: <t t-out="this.selfOrder.formatMonetary(total.tax)" /></div>
                 </div>
            </div>
            <OrderWidget t-if="this.selfOrder.ordering" removeTopClasses="true">
                <t t-set-slot="left">
                    <button
                        role="button"
                        t-attf-class="btn btn-secondary btn-back btn-lg {{this.ui.isSmall ? 'opacity-75' : ''}}"
                        t-on-click="() => this.onClickBack()">
                        <i t-if="this.ui.isSmall" class="oi" data-icon="chevron_backward"/>
                        <span t-if="!this.ui.isSmall">Back</span>
                    </button>
                </t>
                <t t-set-slot="right">
                    <button
                        t-if="this.presetButton"
                        role="button"
                        class="btn btn-secondary preset-btn btn-lg text-truncate"
                        t-on-click="this.presetButton.onClick"
                        t-out="this.presetButton.label"/>
                    <button
                        t-if="this.payButton"
                        role="button"
                        t-attf-class="btn btn-primary cart btn-lg text-truncate {{this.payButton.disabled ? 'disabled' : ''}}"
                        t-on-click="() => this.pay()"
                        t-out="this.payButton.label"/>
                </t>
            </OrderWidget>
        </div>
    </t>
</templates>
