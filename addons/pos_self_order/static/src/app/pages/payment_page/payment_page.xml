<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.PaymentPage">
        <div class="payment-page d-flex flex-column flex-grow-1 overflow-y-auto o_self_background o_self_fade"
        t-attf-style="background-image:#{this.selfOrder.kioskBackgroundImageUrl};background-size: cover; background-position: center;">
            <div class="d-flex flex-column justify-content-center flex-grow-1 overflow-y-auto my-auto" t-att-class="{'justify-content-center': !this.state.selection}">
               <div class="container o_self_container">
                    <div t-if="this.state.selection" class="col-12 col-md-8 col-lg-6 col-kiosk-p-10 mx-auto d-flex flex-column gap-4 gap-kiosk-p-5 pt-5 pb-3 pb-lg-4">
                        <div class="d-flex flex-column align-items-center gap-2">
                            <span class="text-muted">Amount due</span>
                            <span class="display-1 fw-bolder lh-1 o-so-tabular-nums" t-out="this.selfOrder.formatMonetary(this.selfOrder.currentOrder.totalDue)" />
                            <span class="text-primary" t-out="this.orderSummary" />
                        </div>
                        <div class="d-flex flex-column gap-3">
                            <h2 class="text-center mb-0 fw-normal">How would you like to pay?</h2>
                            <div class="o_self_payment_methods d-grid gap-3">
                                <button
                                    t-foreach="this.selectableMethods"
                                    t-as="payment_method"
                                    t-key="payment_method.id"
                                    role="button"
                                    class="w-100 btn btn-light d-flex align-items-center gap-2 gap-sm-3 p-2 p-sm-3 border border-light rounded-4 shadow-sm overflow-hidden"
                                    t-on-click="() => this.selectMethod(payment_method.id)">
                                    <t t-set="display" t-value="this.getPaymentMethodDisplay(payment_method)"/>
                                    <i class="oi rounded-3 o_self_background p-2 p-sm-3" t-att-data-icon="display.icon" aria-hidden="true"></i>
                                    <div class="d-flex flex-column text-start">
                                        <span t-out="payment_method.name" />
                                        <small t-if="display.hint" class="text-muted fs-6" t-out="display.hint" />
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div t-else="" class="payment-state-container d-flex flex-column gap-4 align-items-center justify-content-center w-sm-75 w-50-md mx-auto"
                        t-att-class="{'fade-out': this.state.fadeOut}">
                        <t name="terminal" t-if="this.state.paymentMethodType === 'terminal'">
                            <h1 class="text-center">Follow instructions on the terminal</h1>
                            <div class="btn btn-light btn-lg w-100 py-5 border border-light shadow-sm">
                                <i class="oi oi-3x" data-icon="credit_card" aria-hidden="true"></i>
                            </div>
                        </t>
                        <t name="external_qr" t-elif="this.showQrCode">
                            <h1 class="text-center">Scan the QR code to pay</h1>
                            <div class="qr-code">
                                <div class="border rounded-4 p-4 bg-view"><img class="w-100" t-att-src="this.state.qrCode" /></div>
                            </div>
                        </t>
                        <t name="cash_machine" t-elif="this.state.paymentMethodType === 'cash_machine'">
                            <h1 class="text-center">
                                <t t-if="this.state.paymentCancelled">
                                    Cancellation in progress
                                </t>
                                <t t-else="">
                                    Follow instructions on the cash machine
                                </t>
                            </h1>
                            <div class="btn btn-light btn-lg w-100 py-5 border border-light shadow-sm">
                                Remaining: <t t-out="this.selfOrder.formatMonetary(this.selfOrder.currentOrder.totalDue - this.selectedPaymentMethod.payment_interface.amountInserted)" />
                            </div>
                        </t>
                        <t t-else="">
                            <h1 class="text-center">Processing your payment...</h1>
                            <div class="btn btn-light btn-lg w-100 py-5 border border-light shadow-sm">
                                <div class="lds-grid"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
                            </div>
                        </t>
                    </div>
               </div>
            </div>

            <div class="o_self_footer border-top bg-white py-3">
                <div class="container o_self_container d-flex justify-content-between align-items-center position-relative">
                    <button class="btn btn-secondary btn-lg" t-if="(this.state.selection || this.state.paymentMethodType !== 'terminal' || this.selfOrder.paymentError) and !this.state.paymentCancelled" t-on-click="this.back">Back to cart</button>
                    <button class="btn btn-primary btn-lg" t-if="!this.state.selection and this.selfOrder.paymentError" t-on-click="this.startPayment">Retry</button>
                </div>
            </div>

        </div>
    </t>
</templates>
