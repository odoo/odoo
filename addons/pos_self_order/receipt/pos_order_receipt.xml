<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_self_order.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <div name="header" position="before">
                <t t-if="conditions.get('from_self')">
                    <t t-set="ordering_mode" t-value="config['self_ordering_mode']"/>
                    <t t-set="service_mode" t-value="config['self_ordering_service_mode']"/>
                    <div t-if="ordering_mode != 'nothing'" class="picking-service text-center pt-3">
                        <span t-if="(preset and preset.get('service_at') == 'table') or (not preset and (service_mode == 'table' or service_mode == 'dynamic_qr'))">Service at Table</span>
                        <span t-elif="(preset and preset.get('service_at') == 'counter') or (not preset and service_mode == 'counter')">Pickup At Counter</span>
                        <span t-else="">Delivery</span>
                    </div>
                    <div t-if="order['tracking_number'] and config['self_ordering_mode'] != 'nothing'" class="tracking-number text-center text-bold" style="font-size: 75px; line-height: 130px;" t-out="order['tracking_number']" />
                </t>
            </div>
            <div name="tracking-number" position="attributes">
                <attribute name="t-if">not conditions.get('from_self')</attribute>
            </div>
        </template>
    </data>
</odoo>
