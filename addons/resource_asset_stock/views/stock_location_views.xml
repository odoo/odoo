<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_location_view_form_asset" model="ir.ui.view">
        <field name="name">stock.location.form.asset</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_stock_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_view_assets"
                    type="object"
                    icon="fa-cubes"
                    invisible="not asset_count"
                    class="oe_stat_button">
                    <field name="asset_count" string="Assets" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
