<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_view_form_calendar" model="ir.ui.view">
        <field name="name">resource.asset.form.calendar</field>
        <field name="model">resource.asset</field>
        <field name="inherit_id" ref="resource_asset.resource_asset_view_form" />
        <field name="arch" type="xml">
            <group name="where" position="inside">
                <field
                    name="appointment_resource_id"
                    invisible="not appointment_resource_id" />
                <button
                    name="action_make_bookable"
                    type="object"
                    string="Make Bookable"
                    groups="calendar.group_appointment_manager"
                    invisible="not id or appointment_resource_id or state in ('draft', 'out_of_service', 'disposed')"
                    class="btn-link ps-0" />
            </group>
        </field>
    </record>

</odoo>
