<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="goal_user_visibility" model="ir.rule">
        <field
            name="name">User can only see his/her goals or goal from the same challenge in board visibility</field>
        <field name="model_id" ref="model_gamification_goal" />
        <field
            name="domain_force">[
                '|',
                    ('user_id','=',user.id),
                    '&amp;',
                        ('challenge_id.user_ids','in',user.id),
                        ('challenge_id.visibility_mode','=','ranking')]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user')), Command.link(ref('base.group_portal'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="goal_gamification_manager_visibility" model="ir.rule">
        <field name="name">Manager can see any goal</field>
        <field name="model_id" ref="model_gamification_goal" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="goal_global_multicompany" model="ir.rule">
        <field name="name">Multicompany rule on challenges</field>
        <field name="model_id" ref="model_gamification_goal" />
        <field name="domain_force">[('user_id.company_id', 'in', company_ids)]</field>
    </record>

    <!--
        No streak rule here on purpose.  `streak_employee` in
        ir.model.access.csv grants read only, and a record rule narrows
        ACL-granted access rather than adding any, so the write rule that
        used to sit here granted nothing while asserting the opposite intent.
        Employees must not write streaks: `current_count` selects the
        milestone karma multiplier, so a user who could set it would park on
        day 6 and collect the day-7 bonus every night.
    -->
    <!-- Kudos: users can only write their own sent kudos, read all -->
    <record id="kudos_user_write" model="ir.rule">
        <field name="name">Users can only modify their own kudos</field>
        <field name="model_id" ref="model_gamification_kudos" />
        <field name="domain_force">[('sender_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!--
        Mentorship: an employee may only see and modify pairings they are
        part of.  Without this rule any employee could rewrite a mentorship
        between two other users, name themselves mentor and collect the
        completion payout.
    -->
    <record id="mentorship_own_only" model="ir.rule">
        <field name="name">Users only see mentorships they take part in</field>
        <field name="model_id" ref="model_gamification_mentorship" />
        <field
            name="domain_force">[
                '|',
                    ('mentor_id','=',user.id),
                    ('mentee_id','=',user.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!--
        id must not be "mentorship_manager": that xmlid is already taken by
        the ir.model.access row of the same name in ir.model.access.csv.
    -->
    <record id="mentorship_manager_rule" model="ir.rule">
        <field name="name">Managers see every mentorship</field>
        <field name="model_id" ref="model_gamification_mentorship" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_manager'))]" />
    </record>

    <!--
        Activity feed: enforce the profile-visibility promise at the ORM
        layer.  Filtering only inside get_activity_feed() left the rows
        readable through a plain search_read/read_group.
    -->
    <record id="activity_visibility" model="ir.rule">
        <field name="name">Activity feed respects profile visibility and company</field>
        <field name="model_id" ref="model_gamification_activity" />
        <field
            name="domain_force">[
                '&amp;',
                    ('company_id', 'in', company_ids),
                    '|',
                        ('user_id', '=', user.id),
                        ('user_id.gamification_visibility', '!=', 'private')]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!--
        Quest enrollment and its step completions were the only
        employee-writable models in this module with no record rule at all,
        so any employee could rewrite another user's progress: forge a step
        completion on their enrollment (skipping the prerequisite check that
        only complete_step performs) or abandon their quest.
    -->
    <record id="quest_enrollment_own_only" model="ir.rule">
        <field name="name">Users only see and edit their own quest enrolments</field>
        <field name="model_id" ref="model_gamification_quest_enrollment" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
    </record>

    <record id="quest_enrollment_manager_rule" model="ir.rule">
        <field name="name">Managers see every quest enrolment</field>
        <field name="model_id" ref="model_gamification_quest_enrollment" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_manager'))]" />
    </record>

    <!--
        Read-only for employees (see ir.model.access.csv), but still scoped:
        a completion row names a user through its enrolment.
    -->
    <record id="quest_step_completion_own_only" model="ir.rule">
        <field name="name">Users only see their own quest step completions</field>
        <field name="model_id" ref="model_gamification_quest_step_completion" />
        <field name="domain_force">[('enrollment_id.user_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
    </record>

    <record id="quest_step_completion_manager_rule" model="ir.rule">
        <field name="name">Managers see every quest step completion</field>
        <field name="model_id" ref="model_gamification_quest_step_completion" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_manager'))]" />
    </record>

    <!--
        gamification_visibility used to be enforced by an ir.rule on
        gamification.activity and by nothing else, while three helper methods
        filtered it in Python.  A setting that four hand-written domains
        implement is a setting three of them can silently disagree about, so
        the two remaining public records of someone's standing get the same
        rule the feed already had.  `karma` and `rank_id` on res.users stay
        readable — see the field help, which now says so.
    -->
    <record id="badge_user_visibility" model="ir.rule">
        <field name="name">Badge grants respect profile visibility</field>
        <field name="model_id" ref="model_gamification_badge_user" />
        <field
            name="domain_force">[
                '|',
                    ('user_id', '=', user.id),
                    ('user_id.gamification_visibility', '!=', 'private')]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="achievement_unlock_visibility" model="ir.rule">
        <field name="name">Achievement unlocks respect profile visibility</field>
        <field name="model_id" ref="model_gamification_achievement_unlock" />
        <field
            name="domain_force">[
                '|',
                    ('user_id', '=', user.id),
                    ('user_id.gamification_visibility', '!=', 'private')]</field>
        <field
            name="groups"
            eval="[Command.link(ref('gamification.group_gamification_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!--
        Engagement snapshots are company-wide analytics; scope them to the
        companies the reader actually belongs to.
    -->
    <record id="engagement_snapshot_multicompany" model="ir.rule">
        <field name="name">Engagement snapshots are company-scoped</field>
        <field name="model_id" ref="model_gamification_engagement_snapshot" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="gamification_badge_rule_manager_edit" model="ir.rule">
        <field name="name">Badge: manager: edit all</field>
        <field name="model_id" ref="model_gamification_badge" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_gamification_manager'))]" />
        <field name="perm_read" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

</odoo>
