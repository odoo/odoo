"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px; display: flex; max-width: fit-content; margin-bottom: 8px;\" "
"t-out=\"label or ''\">LABEL</a>\n"
"                    </t>\n"
"                </div>\n"
"            </td>\n"
"            <td style=\"padding:15px 20px 10px 20px;\">\n"
