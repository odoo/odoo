"                        <t t-set=\"url\" t-value=\"data['url']\"/>\n"
"                        <t t-set=\"label\" t-value=\"data['label']\"/>\n"
"                        <a t-att-href=\"url\" t-attf-style=\"background-"
"color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: "
