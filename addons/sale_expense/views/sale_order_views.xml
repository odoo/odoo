<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.expense</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <button name="action_view_invoice" position="before">
                <button
                    name="%(sale_expense.hr_expense_action_from_sale_order)d"
                    type="action"
                    icon="fa-money"
                    invisible="expense_count == 0"
                    class="oe_stat_button">
                    <field name="expense_count" string="Expenses" widget="statinfo" />
                </button>
            </button>
        </field>
    </record>

    <record id="sale_order_reinvoice_tree_view" model="ir.ui.view">
        <field name="name">sale.order.list.reinvoice.expense</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_list" />
        <field name="mode">primary</field>
        <field name="priority" eval="18" />
        <field name="arch" type="xml">
            <field name="amount_untaxed" position="attributes">
                <attribute name="groups">sale.group_sale_salesman,account.group_account_invoice,account.group_account_readonly</attribute>
            </field>
            <field name="amount_tax" position="attributes">
                <attribute name="groups">sale.group_sale_salesman,account.group_account_invoice,account.group_account_readonly</attribute>
            </field>
            <field name="amount_total" position="attributes">
                <attribute name="groups">sale.group_sale_salesman,account.group_account_invoice,account.group_account_readonly</attribute>
            </field>
        </field>
    </record>

</odoo>
