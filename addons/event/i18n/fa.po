"                Discover <a href=\"/event\" t-attf-style=\"color: "
"{{object.event_id.company_id.email_secondary_color or '#875A7B'}};\">all our "
"events</a>.\n"
"            </t>\n"
"        </td></tr>\n"
"        </table>\n"
"    </t>\n"
"</td></tr>\n"
"</table>\n"
