"{object.event_id.company_id.email_secondary_color or '#875A7B'}};\" t-"
"out=\"object.company_id.name or ''\">YourCompany</a>\n"
"            <t t-if=\"is_online\">\n"
"                <br/>\n"
"                Открийте <a href=\"/event\" t-attf-style=\"color: {"
"{object.event_id.company_id.email_secondary_color or '#875A7B'}};\">всички "
"наши събития</a>.\n"
"            </t>\n"
"        </td></tr>\n"
"        </table>\n"
"    </t>\n"
"</td></tr>\n"
"</table>\n"
