<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">
        <record id="res_groups_privilege_events" model="res.groups.privilege">
            <field name="name">Events</field>
            <field name="sequence">18</field>
            <field name="category_id" ref="base.module_category_marketing" />
        </record>
        <record id="group_event_registration_desk" model="res.groups">
            <field name="name">Registration Desk</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_events" />
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_event_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_events" />
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_event_registration_desk'))]" />
        </record>
        <record id="group_event_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_events" />
            <field name="implied_ids" eval="[Command.link(ref('group_event_user'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
    </data>

</odoo>
