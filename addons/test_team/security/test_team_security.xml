<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_alpha_manager" model="res.groups">
        <field name="name">Alpha Administrator</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_beta_manager" model="res.groups">
        <field name="name">Beta Administrator</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="team_rule_alpha_manager" model="ir.rule">
        <field name="name">Alpha teams: administrators</field>
        <field name="model_id" ref="team.model_team_team" />
        <field name="domain_force">[('use_alpha', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_alpha_manager'))]" />
        <field name="perm_read" eval="False" />
    </record>

    <record id="team_rule_beta_manager" model="ir.rule">
        <field name="name">Beta teams: administrators</field>
        <field name="model_id" ref="team.model_team_team" />
        <field name="domain_force">[('use_beta', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_beta_manager'))]" />
        <field name="perm_read" eval="False" />
    </record>

    <record id="team_member_rule_alpha_manager" model="ir.rule">
        <field name="name">Alpha team members: administrators</field>
        <field name="model_id" ref="team.model_team_member" />
        <field name="domain_force">[('team_id.use_alpha', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_alpha_manager'))]" />
        <field name="perm_read" eval="False" />
    </record>

</odoo>
