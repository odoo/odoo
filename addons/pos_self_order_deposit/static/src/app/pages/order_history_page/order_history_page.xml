<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
<t t-name="pos_self_order_deposit.OrdersHistoryPage" t-inherit="pos_self_order.OrdersHistoryPage" t-inherit-mode="extension">
    <xpath expr="//div[@t-foreach='order.getOrderlines()']" position="attributes">
        <attribute name="t-foreach">this.getLines(order)</attribute>
    </xpath>
    <xpath expr="//th[text()='Tax:']/.." position="after">
        <t t-set="deposit_total" t-value="this.getDepositTotal(order)"/>
        <tr t-if="deposit_total and !this.selfOrder.priceLoading" class="text-end text-muted">
            <th class="py-0 pe-0 fw-normal">Deposits:</th>
            <th class="py-0 pe-0 fw-normal o-so-tabular-nums" t-out="this.selfOrder.formatMonetary(deposit_total)"/>
        </tr>
    </xpath>
    <xpath expr="//div[@t-if='line.customer_note']" position="before">
        <div t-if="line.depositLine" class="text-muted small">
            excl. deposit <t t-out="this.selfOrder.formatLineDepositPrice(line)"/>
        </div>
    </xpath>
</t>
</templates>
