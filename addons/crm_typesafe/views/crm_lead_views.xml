<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.typesafe</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_convert_to_opportunity']" position="after">
                <field name="show_typesafe_qualify_button" invisible="1"/> <!-- used in the Qualify button visibility -->
                <button string="Qualify" name="typesafe_qualify" type="object" class="btn btn-secondary"
                    title="Qualify with TypeSafe AI"
                    invisible="not show_typesafe_qualify_button"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="typesafe_readiness" widget="progressbar" invisible="not typesafe_done"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search" model="ir.ui.view">
        <field name="name">crm.lead.view.search.inherit.typesafe</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <filter name="lost" position="after">
                <separator/>
                <filter string="Likely Spam" name="filter_typesafe_spam"
                    domain="[('typesafe_spam_probability', '>=', 0.8)]"/>
            </filter>
        </field>
    </record>
</odoo>
