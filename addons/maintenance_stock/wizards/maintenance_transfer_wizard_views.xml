<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_transfer_wizard_view_form" model="ir.ui.view">
        <field name="name">maintenance.transfer.wizard.form</field>
        <field name="model">maintenance.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Maintenance">
                <group>
                    <group>
                        <field name="order_id" />
                        <field name="lot_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <field name="location_id" />
                        <field name="location_dest_id" />
                        <field name="picking_type_id" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_send"
                        type="object"
                        string="Create Transfer"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
