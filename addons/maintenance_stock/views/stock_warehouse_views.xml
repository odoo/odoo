<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_form_maintenance" model="ir.ui.view">
        <field name="name">stock.warehouse.form.maintenance</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_stock_warehouse_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='warehouse_config']//group[@name='group_resupply']"
                position="after">
                <group name="group_asset_operations" string="Asset Operations">
                    <field name="allow_maintenance" />
                </group>
            </xpath>
            <field name="wh_output_stock_loc_id" position="after">
                <field
                    name="wh_maintenance_stock_loc_id"
                    invisible="not allow_maintenance"
                    readonly="1" />
            </field>
            <field name="xdock_type_id" position="after">
                <field
                    name="maintenance_type_id"
                    invisible="not allow_maintenance"
                    readonly="1" />
                <field
                    name="maintenance_return_type_id"
                    invisible="not allow_maintenance"
                    readonly="1" />
            </field>
        </field>
    </record>

    <record id="stock_location_form_maintenance" model="ir.ui.view">
        <field name="name">stock.location.form.maintenance</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_stock_location_form" />
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="maintenance_location" />
            </field>
        </field>
    </record>

</odoo>
