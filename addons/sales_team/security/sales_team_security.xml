<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_groups_privilege_sales" model="res.groups.privilege">
            <field name="name">Sales</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="base.module_category_sales" />
        </record>
        <!--
            Read-only is the lowest rung. The rung that implies it is the lowest
            one that already sees every document, "All Documents": record rules
            OR across a user's groups, so the tier's read rules would hand an
            own-documents salesperson every order if their rung implied it.
            A gate on a sales affordance therefore spells the pair
            `group_sale_salesman,group_sale_readonly`, as account's do.
        -->
        <record id="group_sale_readonly" model="res.groups">
            <field name="name">Read-only</field>
            <field name="sequence">5</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">Access to all Sales data but in read-only mode, no actions allowed.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_sale_salesman" model="res.groups">
            <field name="name">User: Own Documents Only</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">The user will have access to their own data in the sales application.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_sale_salesman_team" model="res.groups">
            <field name="name">User: Team Documents</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">The user will have access to records of their team members in the sales application.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_sale_salesman'))]" />
        </record>
        <record id="group_sale_salesman_all_leads" model="res.groups">
            <field name="name">User: All Documents</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">The user will have access to all records of everyone in the sales application.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_sale_salesman_team')), Command.link(ref('group_sale_readonly'))]" />
        </record>
        <record id="group_sale_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">the user will have an access to the sales configuration as well as statistic reports.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_sale_salesman_all_leads')), Command.link(ref('mail.group_mail_canned_response_admin'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
    </data>

    <data noupdate="1">
        <!--
            A Sales Administrator creates, edits and deletes sales teams only.
            Reads stay with team's own rules, so perm_read is off: a team's name
            is rendered on invoices and orders read far outside Sales.
            Deleting a team another application also uses takes a Teams
            Administrator (team.team._unlink_except_foreign_usage).
        -->
        <record id="team_team_rule_sale_manager" model="ir.rule">
            <field name="name">Sales teams: Sales Administrators</field>
            <field name="model_id" ref="team.model_team_team" />
            <field name="domain_force">[('use_sale', '=', True)]</field>
            <field name="groups" eval="[Command.link(ref('group_sale_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <record id="team_member_rule_sale_manager" model="ir.rule">
            <field name="name">Sales team members: Sales Administrators</field>
            <field name="model_id" ref="team.model_team_member" />
            <field name="domain_force">[('team_id.use_sale', '=', True)]</field>
            <field name="groups" eval="[Command.link(ref('group_sale_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
        <!--
            team.member_rule_personal shows every internal user the rosters of the
            teams they lead or belong to; "All Documents" widens that to every
            sales team's roster, OR-ed over it.
        -->
        <record id="team_member_rule_sale_all" model="ir.rule">
            <field name="name">Sales team members: All Documents</field>
            <field name="model_id" ref="team.model_team_member" />
            <field name="domain_force">[('team_id.use_sale', '=', True)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads'))]" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
        <record id="team_alias_rule_sale_manager" model="ir.rule">
            <field name="name">Sales team aliases: Sales Administrators</field>
            <field name="model_id" ref="team.model_team_alias" />
            <field name="domain_force">[('team_id.use_sale', '=', True)]</field>
            <field name="groups" eval="[Command.link(ref('group_sale_manager'))]" />
            <field name="perm_read" eval="False" />
        </record>
    </data>

</odoo>
