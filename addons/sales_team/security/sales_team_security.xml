<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_groups_privilege_sales" model="res.groups.privilege">
            <field name="name">Sales</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="base.module_category_sales" />
        </record>
        <!--
            Read-only is the lowest rung. The rung that implies it is the lowest
            one that already sees every document, "All Documents": record rules
            OR across a user's groups, so the tier's read rules would hand an
            own-documents salesperson every order if their rung implied it.
            A gate on a sales affordance therefore spells the pair
            `group_sale_salesman,group_sale_readonly`, as account's do.
        -->
        <record id="group_sale_readonly" model="res.groups">
            <field name="name">Read-only</field>
            <field name="sequence">5</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">Access to all Sales data but in read-only mode, no actions allowed.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_sale_salesman" model="res.groups">
            <field name="name">User: Own Documents Only</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">The user will have access to their own data in the sales application.</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_sale_salesman_team" model="res.groups">
            <field name="name">User: Team Documents</field>
            <field name="sequence">15</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">The user will have access to records of their team members in the sales application.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_sale_salesman'))]" />
        </record>
        <record id="group_sale_salesman_all_leads" model="res.groups">
            <field name="name">User: All Documents</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">The user will have access to all records of everyone in the sales application.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_sale_salesman_team')), Command.link(ref('group_sale_readonly'))]" />
        </record>
        <record id="group_sale_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_sales" />
            <field
                name="comment">the user will have an access to the sales configuration as well as statistic reports.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('group_sale_salesman_all_leads')), Command.link(ref('mail.group_mail_canned_response_admin'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
    </data>

    <data noupdate="1">
        <record id="sale_team_comp_rule" model="ir.rule">
            <field name="name">Sales Team multi-company</field>
            <field name="model_id" ref="model_crm_team" />
            <field
                name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <!--
            Memberships follow their team: without this, crm.team is company-scoped
            while its membership rows are not, so the memberships of another
            company's teams stay readable to every internal user.
        -->
        <record id="crm_team_member_comp_rule" model="ir.rule">
            <field name="name">Sales Team Member multi-company</field>
            <field name="model_id" ref="model_crm_team_member" />
            <field
                name="domain_force">[('crm_team_id.company_id', 'in', company_ids + [False])]</field>
        </record>
        <!--
            The same principle within a company, which the rule above does not
            cover: crm.team is restricted to the teams a salesperson leads or
            belongs to, but its membership rows carried no such rule, so a
            salesperson who cannot open team X could still search up X's roster.
            The name of X stayed hidden (reading crm_team_id's display name
            needs read on crm.team) but the rows, their user_id and the size of
            the team did not.

            A membership is visible when its team is one the reader leads or
            belongs to, and the GROUP is deliberately base.group_user and not
            group_sale_salesman. Record rules are selected by group and OR-ed,
            so a rule carried by a Sales group binds nobody outside Sales: an
            internal user with no sales group at all matched no rule here and
            read every membership in the database, while granting that same
            account "User: Own Documents Only" narrowed it to its own teams.
            Access grew by dropping a group. Carried by base.group_user the
            domain reaches every internal user, and the ladder above it is
            unchanged: group_sale_salesman implies base.group_user, so a
            salesperson still gets exactly this domain, and
            group_sale_salesman_all_leads still ORs crm_team_member_rule_all
            over it.

            user.crm_team_ids is inlined when the rule domain is computed, and
            that domain is cached per user: crm.team.member clears the registry
            cache whenever a membership is created, moved, archived or deleted.

            crm.team keeps the wider grant on purpose. Its name is rendered
            outside the Sales app (team_id on an invoice, on a sales order), so
            an accountant who reads one must be able to read the team; the same
            domain applied to base.group_user turns that into an AccessError on
            display_name. Membership rows have no such reader: nothing outside
            this module puts them on screen.
        -->
        <record id="crm_team_member_rule_personal" model="ir.rule">
            <field name="name">Personal Salesteam Members</field>
            <field name="model_id" ref="model_crm_team_member" />
            <field
                name="domain_force">['|', ('crm_team_id.user_id', '=', user.id), ('crm_team_id', 'in', user.crm_team_ids.ids)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="crm_team_member_rule_all" model="ir.rule">
            <field name="name">All Salesteam Members</field>
            <field name="model_id" ref="model_crm_team_member" />
            <field name="domain_force">[(1, '=', 1)]</field>
            <field
                name="groups"
                eval="[Command.link(ref('sales_team.group_sale_salesman_all_leads'))]" />
        </record>
    </data>

</odoo>
