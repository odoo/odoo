<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="team_view_search_sale" model="ir.ui.view">
            <field name="name">team.view.search.sale</field>
            <field name="model">team.team</field>
            <field name="inherit_id" ref="team.team_view_search" />
            <field name="arch" type="xml">
                <xpath expr="//separator[@name='usages']" position="before">
                    <filter
                        name="use_sale"
                        string="Sales"
                        domain="[('use_sale', '=', True)]" />
                </xpath>
            </field>
        </record>
        <record id="team_view_form_sale" model="ir.ui.view">
            <field name="name">team.view.form.sale</field>
            <field name="model">team.team</field>
            <field name="inherit_id" ref="team.team_view_form" />
            <field name="arch" type="xml">
                <div name="usages" position="inside">
                    <span class="d-inline-flex">
                        <field name="use_sale" />
                        <label for="use_sale" />
                    </span>
                </div>
                <field name="company_id" position="after">
                    <field name="currency_id" invisible="1" />
                </field>
            </field>
        </record>
        <record id="team_action_sales" model="ir.actions.act_window">
            <field name="name">Sales Teams</field>
            <field name="res_model">team.team</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="team.team_view_kanban_dashboard" />
            <field name="domain">[('use_sale', '=', True)]</field>
            <field
                name="context">{'in_sales_app': True, 'default_use_sale': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define a new sales team
                </p><p>
                    Use Sales Teams to organize your sales departments.
                    Each team will work with a separate pipeline.
                </p>
            </field>
        </record>
        <record id="team_action_pipeline" model="ir.actions.act_window">
            <field name="name">Teams</field>
            <field name="res_model">team.team</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="team.team_view_kanban_dashboard" />
            <field name="domain">[('use_sale', '=', True)]</field>
            <field name="context">{'default_use_sale': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define a new sales team
                </p><p>
                    Use Sales Teams to organize your sales departments.
                    Each team will work with a separate pipeline.
                </p>
            </field>
        </record>
        <record id="team_action_config" model="ir.actions.act_window">
            <field name="name">Sales Teams</field>
            <field name="res_model">team.team</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('use_sale', '=', True)]</field>
            <field name="context">{'default_use_sale': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Sales Team
                </p><p>
                    Use Sales Teams to organize your sales departments and draw up reports.
                </p>
            </field>
        </record>
        <record id="team_member_action_sales" model="ir.actions.act_window">
            <field name="name">Team Members</field>
            <field name="res_model">team.member</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('team_id.use_sale', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new salesman
                </p><p>
                    Link salespersons to sales teams.
                </p>
            </field>
        </record>
    </data>

</odoo>
