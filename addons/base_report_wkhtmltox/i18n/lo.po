#. module: base_report_wkhtmltox
#: model:ir.module.module,description:base.module_base_report_wkhtmltox
msgid ""
"\n"
"This module is the implementation of the wkhtmltopdf and\n"
"wlhtmltoimage rendering engine for Odoo.\n"
"\n"
"learn more about it here:\n"
"https://wkhtmltopdf.org/\n"
msgstr ""
"\n"
"ໂມດູນນີ້ແມ່ນການນໍາໃຊ້ລະບົບປະມວນຜົນ wkhtmltopdf ແລະ\n"
"wlhtmltoimage ສໍາລັບ Odoo.\n"
"\n"
"ຮຽນຮູ້ເພີ່ມເຕີມໄດ້ທີ່ນີ້:\n"
"https://wkhtmltopdf.org/\n"

#. module: base_report_wkhtmltox
#: model:ir.model.fields,field_description:base_report_wkhtmltox.field_ir_actions_report__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: base_report_wkhtmltox
#: model:ir.model.fields,field_description:base_report_wkhtmltox.field_ir_actions_report__report_type
msgid "Format"
msgstr "ຮູບແບບ"

#. module: base_report_wkhtmltox
#: model:ir.model.fields,field_description:base_report_wkhtmltox.field_ir_actions_report__id
msgid "ID"
msgstr "ລະຫັດ"

#. module: base_report_wkhtmltox
#: model:ir.model.fields.selection,name:base_report_wkhtmltox.selection__ir_actions_report__report_type__qweb-pdf-wkhtmltopdf
msgid "PDF (Wkhtmltopdf)"
msgstr "PDF (Wkhtmltopdf)"

#. module: base_report_wkhtmltox
#: model:ir.model,name:base_report_wkhtmltox.model_ir_actions_report
msgid "Report Action"
msgstr "ການດຳເນີນການລາຍງານ"

#. module: base_report_wkhtmltox
#: model:ir.module.module,shortdesc:base.module_base_report_wkhtmltox
msgid "Report Engine: wkhtmltopdf/wkhtmltoimage"
msgstr "ລະບົບປະມວນຜົນລາຍງານ: wkhtmltopdf/wkhtmltoimage"

#. module: base_report_wkhtmltox
#: model:ir.model.fields,help:base_report_wkhtmltox.field_ir_actions_report__report_type
msgid ""
"The type of the report that will be rendered, each one having its own "
"rendering method. HTML means the report will be opened directly in your "
"browser, PDF means the report will be generated and downloaded by the user."
msgstr ""
"ປະເພດຂອງລາຍງານທີ່ຈະຖືກປະມວນຜົນ, ເຊິ່ງແຕ່ລະປະເພດຈະມີວິທີການປະມວນຜົນສະເພາະຂອງຕົນເອງ. HTML ໝ"
"າຍເຖິງລາຍງານຈະຖືກເປີດໂດຍກົງໃນໂປຣແກຣມທ່ອງເວັບຂອງທ່ານ, PDF ໝາຍເຖິງລາຍງານຈະຖືກສ້າງຂຶ້ນ ແລະ ດ"
"າວໂຫຼດໂດຍຜູ້ໃຊ້."

#. module: base_report_wkhtmltox
#. odoo-python
#: code:addons/base_report_wkhtmltox/models/ir_actions_report.py:0
msgid "Tried to convert multiple documents in wkhtmltopdf using unpatched QT"
msgstr "ພະຍາຍາມແປງຫຼາຍເອກະສານໃນ wkhtmltopdf ໂດຍໃຊ້ QT ທີ່ຍັງບໍ່ໄດ້ຮັບການແກ້ໄຂ"

#. module: base_report_wkhtmltox
#. odoo-python
#: code:addons/base_report_wkhtmltox/models/ir_actions_report.py:0
msgid ""
"Wkhtmltoimage failed (error code: %(error_code)s). Message: %"
"(error_message_end)s"
msgstr ""
"Wkhtmltoimage ລົ້ມເຫຼວ (ລະຫັດຂໍ້ຜິດພາດ: %(error_code)s). ຂໍ້ຄວາມ: %(error_message_end)"
"s"

#. module: base_report_wkhtmltox
#. odoo-python
#: code:addons/base_report_wkhtmltox/models/ir_actions_report.py:0
msgid ""
"Wkhtmltopdf failed (error code: %(error_code)s). Memory limit too low or "
"maximum file number of subprocess reached. Message : %(message)s"
msgstr ""
"Wkhtmltopdf ລົ້ມເຫຼວ (ລະຫັດຂໍ້ຜິດພາດ: %(error_code)s). ຂີດຈຳກັດໜ່ວຍຄວາມຈຳຕ່ຳເກີນໄປ ຫຼື ຈຳນວ"
"ນໄຟລ໌ສູງສຸດຂອງຂະບວນການຍ່ອຍເຕັມແລ້ວ. ຂໍ້ຄວາມ: %(message)s"

#. module: base_report_wkhtmltox
#. odoo-python
#: code:addons/base_report_wkhtmltox/models/ir_actions_report.py:0
msgid "Wkhtmltopdf failed (error code: %(error_code)s). Message: %(message)s"
msgstr ""
"Wkhtmltopdf ລົ້ມເຫຼວ (ລະຫັດຂໍ້ຜິດພາດ: %(error_code)s). ຂໍ້ຄວາມ: %(message)s"

#. module: base_report_wkhtmltox
#. odoo-python
#: code:addons/base_report_wkhtmltox/models/ir_actions_report.py:0
msgid "wkhtmltoimage 0.12.0^ is required in order to render images from html"
msgstr "ຕ້ອງການ wkhtmltoimage ເວີຊັນ 0.12.0^ ຂຶ້ນໄປ ເພື່ອປະມວນຜົນຮູບພາບຈາກ html"

