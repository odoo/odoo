<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_tree_inherit_reprocess" model="ir.ui.view">
        <field name="name">hr.leave.list.reprocess</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_reprocess_time_rules" type="object"
                            string="Reprocess Time Rules"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="action_hr_leave_reprocess_time_rules" model="ir.actions.server">
        <field name="name">Reprocess Time Rules</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="binding_view_types">list,gantt</field>
        <field name="state">code</field>
        <field name="code">action = records.action_reprocess_time_rules()</field>
    </record>
</odoo>
