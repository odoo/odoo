<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- work_entry_type_id column in the attendance list -->
    <record id="view_attendance_tree_inherit_holidays" model="ir.ui.view">
        <field name="name">hr.attendance.list.holidays</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="worked_hours" position="after">
                <field name="work_entry_type_id" widget="many2one_work_entry_type" optional="show" string="Type"/>
            </field>
        </field>
    </record>

    <menuitem
        id="menu_hr_attendance_time_rules"
        name="Automatic Rules"
        parent="hr_attendance.menu_hr_attendance_configuration"
        action="hr_work_entry.hr_time_rule_action"
        groups="hr_attendance.group_hr_attendance_manager"
        sequence="30"/>

</odoo>
