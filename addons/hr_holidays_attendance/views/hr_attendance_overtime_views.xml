<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Related time off smart button on the attendance form -->
    <record id="view_attendance_overtime_leave_form" model="ir.ui.view">
        <field name="name">hr.attendance.overtime.leave.form</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="employee_tz" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_related_leaves" type="object" class="oe_stat_button"
                        icon="calendar_today" icon_class="oi-filled" invisible="not related_leave_count"
                        groups="hr.group_hr_manager,hr_attendance.group_hr_attendance_own">
                        <field name="related_leave_count" widget="statinfo" string="Time Off"/>
                    </button>
                </div>
            </field>
        </field>
    </record>

</odoo>
