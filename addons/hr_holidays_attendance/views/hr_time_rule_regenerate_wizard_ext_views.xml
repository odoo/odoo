<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- per-app act_window wrappers so the time rule list knows which app opened it -->
    <record id="hr_time_rule_action_attendance" model="ir.actions.act_window">
        <field name="name">Time Rules</field>
        <field name="res_model">hr.time.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_company_id': context.get('allowed_company_ids', [False])[0], 'time_rule_app': 'hr.attendance'}</field>
    </record>

    <record id="hr_time_rule_action_leave" model="ir.actions.act_window">
        <field name="name">Time Rules</field>
        <field name="res_model">hr.time.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_company_id': context.get('allowed_company_ids', [False])[0], 'time_rule_app': 'hr.leave'}</field>
    </record>

    <!-- point each app's menu to its own act_window -->
    <record id="hr_attendance.menu_hr_attendance_time_rules" model="ir.ui.menu">
        <field name="action" ref="hr_time_rule_action_attendance"/>
    </record>

    <record id="hr_holidays.menu_hr_holidays_time_rules" model="ir.ui.menu">
        <field name="action" ref="hr_time_rule_action_leave"/>
    </record>
</odoo>
