<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_order_view_search_inherit_hr" model="ir.ui.view">
        <field name="name">maintenance.order.view.search.inherit.hr</field>
        <field name="model">maintenance.order</field>
        <field name="inherit_id" ref="maintenance.maintenance_order_view_search" />
        <field name="arch" type="xml">
            <xpath expr="field[@name='user_id']" position="after">
                <field name="employee_id" />
            </xpath>
            <xpath expr="//filter[@name='my_maintenances']" position="replace">
                <filter
                    name="my_maintenances"
                    string="My Maintenances"
                    domain="[('employee_id.user_id', '=', uid)]" />
            </xpath>
            <xpath expr="//filter[@name='created_by']" position="replace">
                <filter
                    name="created_by"
                    string="Created By"
                    context="{'group_by': 'employee_id'}" />
            </xpath>
        </field>
    </record>

    <record id="maintenance_order_view_form_inherit_hr" model="ir.ui.view">
        <field name="name">maintenance.order.view.form.inherit.hr</field>
        <field name="model">maintenance.order</field>
        <field name="inherit_id" ref="maintenance.maintenance_order_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_user_id']" position="replace">
                <field
                    name="employee_id"
                    string="Created By"
                    widget="many2one_avatar_employee"
                    options="{'no_create_edit': True, 'no_open': True}" />
            </xpath>
        </field>
    </record>

    <record id="maintenance_order_view_kanban_inherit_hr" model="ir.ui.view">
        <field name="name">maintenance.order.view.kanban.inherit.hr</field>
        <field name="model">maintenance.order</field>
        <field name="inherit_id" ref="maintenance.maintenance_order_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//span[@name='owner_user_id']" position="replace">
                <field name="employee_id" />
            </xpath>
        </field>
    </record>

    <record id="maintenance_order_view_list_inherit_hr" model="ir.ui.view">
        <field name="name">maintenance.order.view.list.inherit.hr</field>
        <field name="model">maintenance.order</field>
        <field name="inherit_id" ref="maintenance.maintenance_order_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='owner_user_id']" position="replace">
                <field name="employee_id" />
            </xpath>
        </field>
    </record>

    <record id="resource_asset_view_form_inherit_hr" model="ir.ui.view">
        <field name="name">resource.asset.form.inherit.hr</field>
        <field name="model">resource.asset</field>
        <field name="inherit_id" ref="resource_asset.resource_asset_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='custody']/field[@name='assignment_ids']/list/field[@name='assignee_id']"
                position="after">
                <field name="department_id" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
