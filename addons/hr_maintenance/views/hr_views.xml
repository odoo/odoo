<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.maintenance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="priority" eval="50" />
        <field name="arch" type="xml">
            <button name="action_view_versions" position="before">
                <button
                    name="action_view_assets"
                    type="object"
                    icon="fa-cubes"
                    groups="hr.group_hr_user"
                    invisible="not asset_count"
                    class="o_stat_button">
                    <field name="asset_count" string="Assets" widget="statinfo" />
                </button>
            </button>
        </field>
    </record>

</odoo>
