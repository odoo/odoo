<templates xml:space="preserve">
<t t-name="mass_mailing.s_text_highlight" name="Text Highlight">
    <div class="s_text_highlight s_mail_text_highlight o_mail_snippet_general o_cc o_cc3 pt32 pb32 text-center mx-auto w-100" style="border-radius: 6px;" data-vxml="001">
        <h3><font class="text-white">Text Highlight</font></h3>
        <p><font class="text-white">Put the focus on what you have to say!</font></p>
    </div>
</t>


<t t-name="mass_mailing.s_rating" name="Rating">
    <t t-if="!activeStars">
        <t t-set="activeStars" t-value="3"/>
    </t>
    <t t-elif="activeStars > 5">
        <t t-set="activeStars" t-value="5"/>
    </t>
    <t t-set="inactiveStars" t-value="5 - activeStars"/>

    <div class="s_rating o_mail_snippet_general s_rating_no_title" style="padding: 0 15px;" data-snippet="s_rating" data-name="Rating" data-vcss="001" data-vxml="001" data-rating-icon="star">
        <h3 class="s_rating_title" t-out="title or 'Quality'"/>
        <div class="s_rating_icons o_not_editable" role="img" t-attf-aria-label="{{activeStars}} out of 5 stars">
            <span class="s_rating_active_icons" style="color: #f3cc00;">
                <t t-foreach="Array(activeStars)" t-as="i" t-key="i">
                    <i class="oi oi-filled" data-icon="star" role="presentation"></i><span> </span>
                </t>
            </span>
            <span class="s_rating_inactive_icons" style="color: var(--border-color);">
                <t t-foreach="Array(inactiveStars)" t-as="i" t-key="i">
                    <i class="oi oi-filled" data-icon="star" role="presentation"></i><span> </span>
                </t>
            </span>
        </div>
    </div>
</t>

<t t-name="mass_mailing.s_hr" name="Separator">
    <div class="s_hr o_mail_snippet_general pt16 pb16 o_not_editable" data-vxml="001" data-name="Separator" data-snippet="s_hr">
        <hr class="w-100 mx-auto"/>
    </div>
</t>

<t t-name="mass_mailing.s_inline_text" name="Text">
    <p class="o_snippet_drop_in_only">Text</p>
</t>

<t t-name="mass_mailing.s_alert" name="Alert">
    <div class="oe_unmovable s_alert s_mail_alert s_alert_md alert alert-info w-100 row" style="border-width: 1px !important; border-color: rgb(190 229 235) !important;">
        <i class="oi oi-2x oi-stack o_not_editable s_alert_icon rounded-1 col-auto" data-icon="info"/>
        <div class="s_alert_content col-9">
            <p class="mb-0">Explain the benefits you offer. <br/>Don't write about products or services here, write about solutions.</p>
        </div>
    </div>
</t>

<t name="CTA Badge" t-name="mass_mailing.s_cta_badge">
    <div class="s_cta_badge badge d-block mx-auto o_mail_snippet_general border rounded py-2 px-3" data-name="CTA Badge" style="border-radius: 32px !important;">
        <p class="mb-0">
            <span class="oi oi-fw" data-icon="info" role="img"/><t t-out="nbsp + nbsp"/>What do you want to promote? <t t-out="nbsp + nbsp + nbsp + nbsp"/><a href="#">See more <span class="oi" data-icon="east" role="img"/></a>
        </p>
    </div>
</t>

<t t-name="mass_mailing.s_button" name="Button">
    <p class="o_snippet_drop_in_only">
        <a class="btn btn-primary" href="https://www.example.com">Button</a>
    </p>
</t>

<t t-name="mass_mailing.s_video" name="Video">
    <p class="o_snippet_drop_in_only">
        <a href="https://www.youtube.com/watch?v=nbso3NVz3p8?rel=0&amp;autoplay=0">
            <img class="img img-fluid" style="width: 50% !important;"
                data-original-src="/mass_mailing/static/src/img/snippets_demo/s_video.jpg" src="/mass_mailing/static/src/img/snippets_demo/s_video.jpg" data-mimetype="image/jpeg"/>
        </a>
    </p>
</t>

<t t-name="mass_mailing.s_image" name="Image">
    <p class="o_snippet_drop_in_only">
        <span class="s_image o_mail_snippet_general rounded border d-inline-flex justify-content-center align-items-center bg-100 opacity-50 w-100 ratio ratio-16x9" style="max-width: 50vw">
            <svg xmlns="http://www.w3.org/2000/svg" width="12em" height="7em" viewBox="0 0 120 120" fill="none">
                <rect width="120" height="120"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M33.2503 38.4816C33.2603 37.0472 34.4199 35.8864 35.8543 35.875H83.1463C84.5848 35.875 85.7503 37.0431 85.7503 38.4816V80.5184C85.7403 81.9528 84.5807 83.1136 83.1463 83.125H35.8543C34.4158 83.1236 33.2503 81.957 33.2503 80.5184V38.4816ZM80.5006 41.1251H38.5006V77.8751L62.8921 53.4783C63.9172 52.4536 65.5788 52.4536 66.6039 53.4783L80.5006 67.4013V41.1251ZM43.75 51.6249C43.75 54.5244 46.1005 56.8749 49 56.8749C51.8995 56.8749 54.25 54.5244 54.25 51.6249C54.25 48.7254 51.8995 46.3749 49 46.3749C46.1005 46.3749 43.75 48.7254 43.75 51.6249Z" opacity="0.4" fill="currentColor"/>
            </svg>
        </span>
    </p>
</t>

<t t-name="mass_mailing.s_icon" name="Icon">
    <p class="o_snippet_drop_in_only">
        <span class="s_icon" />
    </p>
</t>

<t name="Badge" t-name="mass_mailing.s_badge">
    <div class="s_badge badge text-bg-secondary o_mail_snippet_general" data-name="Badge" data-vxml="001">
        <p class="mb-0">
            <span class="oi oi-fw oi-filled" data-icon="folder"/>Category
        </p>
    </div>
</t>

<t t-name="mass_mailing.s_social_media_template">
    <t t-call="mass_mailing.s_social_media" fillSocialLinks="true"/>
</t>

<t t-name="mass_mailing.s_social_media" name="Social Media">
    <div data-name="Social Media"
        t-attf-class="s_social_media o_not_editable {{optionalTextPosition || 'text-start'}} {{optionalSnippetClass || ''}}"
        contenteditable="false" t-att-data-company-id="company_id.id">
        <span class="s_social_media_links">
            <t t-call="mass_mailing.social_links"/>
        </span>
        <t t-if="!fillSocialLinks" t-call="mass_mailing.social_media_placeholder"/>
    </div>
</t>

<t t-name="mass_mailing.social_links">
    <t t-set="social_links" t-value="{
        social_facebook: company_id.social_links.social_facebook || 'https://www.facebook.com/odoo',
        social_instagram: company_id.social_links.social_instagram || 'https://www.instagram.com/explore/tags/odoo',
        social_twitter: company_id.social_links.social_twitter || 'https://x.com/Odoo',
        social_linkedin: company_id.social_links.social_linkedin || 'https://www.linkedin.com/company/odoo',
        social_tiktok: company_id.social_links.social_tiktok || 'https://www.tiktok.com/@odoo',
        social_youtube: company_id.social_links.social_youtube || 'https://www.youtube.com/@Odoo'
    }"/>

    <t t-foreach="fillSocialLinks ? Object.entries(social_links) : []" t-as="link" t-key="link">
        <t t-set="platform" t-value="link[0].split('social_')[1]"/>
        <t t-set="platform_capitalized" t-value="platform[0].toUpperCase() + platform.slice(1)"/>
        <a t-att-data-platform="social_links[link[0]] ? link[0] : 'customLink-' + link[0]" t-att-href="link[1]" t-att-aria-label="platform_capitalized" t-att-title="platform_capitalized">
            <i t-attf-style="{{optionalTextStyle}}" t-attf-class="oi {{ optionalIconLayout || 'oi-stack'}} o_editable_media"
                t-attf-data-icon="oi_{{platform}}"></i>
        </a>
    </t>
</t>

<t t-name="mass_mailing.s_mail_company_logo">
    <img t-if="company_id.logo"
        t-att-class="class"
        t-att-style="style"
        t-attf-src="/web/image/res.company/{{ company_id.id }}/logo"
        t-attf-data-original-src="/web/image/res.company/{{ company_id.id }}/logo" />
    <img t-else=""
        t-att-class="class"
        t-attf-style="width: 33% !important; {{style}}"
        t-attf-src="/web/image/res.company/{{ company_id.id }}/logo"
        t-attf-data-original-src="/web/image/res.company/{{ company_id.id }}/logo" />
</t>
</templates>
