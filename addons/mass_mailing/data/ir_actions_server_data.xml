<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mailing_list_merge_action" model="ir.actions.server">
        <field name="name">Merge</field>
        <field name="model_id" ref="model_mailing_list"/>
        <field name="state">code</field>
        <field name="code">action = records.action_mailing_lists_merge()</field>
    </record>

    <record id="mailing_mailing_action_set_draft" model="ir.actions.server">
        <field name="name">Set back to draft</field>
        <field name="model_id" ref="model_mailing_mailing"/>
        <field name="state">code</field>
        <field name="code">
records.action_cancel()
action = {'type': 'ir.actions.client', 'tag': 'reload'}
        </field>
    </record>
</odoo>
