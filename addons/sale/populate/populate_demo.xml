<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A Populate demo for the Sale module -->
    <record id="fake_sale_demo" model="populate.blueprint">
        <field name="name">Sale - Populate Demo</field>
        <field name="definition_xml" type="xml">
            <import ref="base.fake_partners" as="customers">
                <xpath expr="//create[@id='partners']" position="attributes">
                    <attribute name="count">1000</attribute>
                </xpath>
            </import>

            <import ref="base.fake_internal_users" as="sales">
                <xpath expr="//create[@id='users']" position="inside">
                    <field name="group_ids" eval="[Command.set([env.ref('sales_team.group_sale_salesman').id])]"/>
                </xpath>
                <xpath expr="//create[@id='users']" position="attributes">
                    <attribute name="count">200</attribute>
                </xpath>
            </import>

            <import ref="product.fake_products" as="catalog">
                <xpath expr="//create[@id='products']" position="attributes">
                    <attribute name="count">500</attribute>
                </xpath>
            </import>

            <create model="crm.team" count="10" id="sale_teams" scale="False">
                <value name="counter" generator="misc.counter" start="1"/>
                <field name="name" eval="f'Sales Team {counter}'"/>
                <field name="member_ids" ref="sales/users" count="20" std="5"/>
            </create>

            <create model="sale.order" count="2000" id="sale_orders" context="{'mail_auto_subscribe_no_notify': True}">
                <field name="partner_id" ref="customers/partners"/>
                <field name="user_id" ref="sales/users" null_ratio="0.1"/>
                <field name="team_id" ref="sale_teams" null_ratio="0.1"/>
                <field name="state" values="{'draft': 4, 'sent': 2, 'sale': 6, 'cancel': 1}"/>
                <field name="date_order" start="now -2y" end="now" distribution="exponential(rate=0.003)"/>
                <field name="validity_date" start="today" end="today +30d" null_ratio="0.5"/>
                <field name="client_order_ref" generator="fake.bothify" text="PO-####-????" null_ratio="0.6"/>
                <field name="note" generator="fake.paragraph" null_ratio="0.7"/>
            </create>

            <create model="sale.order.line" count="8000" id="sale_order_lines" context="{'mail_auto_subscribe_no_notify': True}">
                <field name="order_id" ref="sale_orders" partition="True"/>
                <field name="product_id" ref="catalog/products" domain="[('sale_ok', '=', True), ('type', '!=', 'combo')]"/>
                <field name="product_uom_qty" start="1" end="50" distribution="exponential(rate=0.1)"/>
                <field name="price_unit" start="5.0" end="5000.0" distribution="exponential(rate=0.001)"/>
                <field name="discount" start="0" end="30" distribution="exponential(rate=0.2)" null_ratio="0.7"/>
                <value name="qty_delivered_ratio" generator="scalar.float" start="0" end="1" distribution="beta(alpha=2, beta=2)"/>
                <field name="qty_delivered" eval="product_uom_qty * qty_delivered_ratio if qty_delivered_ratio else 0" null_ratio="0.4"/>
                <field name="sequence" start="1" end="100"/>
            </create>
        </field>
    </record>
</odoo>
