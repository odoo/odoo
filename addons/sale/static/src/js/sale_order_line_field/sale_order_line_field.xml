<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t
        t-name="sale.ListRenderer.RecordRow"
        t-inherit="account.SectionAndNoteListRenderer.RecordRow"
        t-inherit-mode="primary"
    >
        <t t-set="isInvisible" position="attributes">
            <attribute
                name="t-value"
                separator=" or "
                add="api.isCombo(record) and !api.getComboColumns().includes(column.name)"
            />
        </t>

        <t t-name="composition_button" position="after">
            <DropdownItem
                onSelected="() => api.toggleIsOptional(record)"
                attrs="{ 'class': api.disableOptionalButton(record) ? 'disabled' : '' }"
            >
                <i class="me-1 fa-solid fa-list"/>
                <span t-if="record.data.is_optional">Unset Optional</span>
                <span t-else="">Set Optional</span>
            </DropdownItem>
        </t>

        <xpath expr="//td[hasclass('o_list_record_remove')]" position="attributes">
            <attribute name="t-if" separator=" and " add="!api.isCombo(record)"/>
        </xpath>

        <xpath expr="//td[hasclass('o_list_section_options')]" position="before">
            <td t-elif="api.isCombo(record)" class="o_list_section_options w-print-0 p-print-0 text-center">
                <Dropdown position="'bottom-end'" t-if="!props.readonly">
                    <button class="btn d-table-cell border-0 py-0 px-1 cursor-pointer">
                        <i class="fa-solid fa-ellipsis-v"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem
                            t-if="api.getPreviousRecords(record)"
                            onSelected="() => api.moveCombo(record, 'up')"
                        >
                            <i class="me-1 fa-solid fa-arrow-up"/>
                            <span>Move Up</span>
                        </DropdownItem>
                        <DropdownItem
                            t-if="api.getNextRecords(record)"
                            onSelected="() => api.moveCombo(record, 'down')"
                        >
                            <i class="me-1 fa-solid fa-arrow-down"/>
                            <span>Move Down</span>
                        </DropdownItem>
                        <t t-if="hasDeleteButton">
                            <DropdownItem
                                onSelected="() => api.onDeleteRecord(record)"
                                class="'text-danger'"
                            >
                                <i class="me-1 fa-solid fa-trash-can"/>
                                <span>Delete</span>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </td>
        </xpath>
    </t>
</templates>
