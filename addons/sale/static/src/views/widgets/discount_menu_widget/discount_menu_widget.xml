<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sale.DiscountMenuWidget">
        <Dropdown menuClass="'py-0'">
            <button class="btn btn-secondary w-100">
                Discounts
            </button>
            <t t-set-slot="content">
                <DropdownItem
                    t-if="this.canAddManualDiscount"
                    tag="'button'"
                    class="'btn btn-link'"
                    onSelected="() => this.doActionButton('object', 'action_open_discount_wizard')"
                >
                    Manual Discount
                </DropdownItem>
            </t>
        </Dropdown>
    </t>

</templates>
