<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sale.ComboMenuWidget">
        <Dropdown menuClass="'py-0'">
            <button class="btn btn-secondary w-100">
                Combo
            </button>
            <t t-set-slot="content">
                <t t-if="!this.comboProducts.length">
                    <DropdownItem tag="'span'" class="'text-muted'">
                        No Combo Product Available
                    </DropdownItem>
                </t>
                <t t-foreach="this.comboProducts" t-as="product" t-key="product.id">
                    <DropdownItem
                        tag="'button'"
                        class="'btn btn-link'"
                        onSelected="() => this.onComboProductSelected(product)"
                    >
                        <t t-out="product.display_name"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

</templates>
