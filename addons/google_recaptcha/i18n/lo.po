#. module: google_recaptcha
#: model:ir.module.module,description:base.module_google_recaptcha
msgid ""
"\n"
"This module implements reCaptchaV3 so that you can prevent bot spam on your "
"public modules.\n"
msgstr ""
"\n"
"ໂມດູນນີ້ຕິດຕັ້ງ reCaptchaV3 ເພື່ອໃຫ້ທ່ານສາມາດປ້ອງກັນສະແປມຈາກບັອດ (bot spam) ໃນໂມດູນສາທາລະນະ"
"ຂອງທ່ານ.\n"

#. module: google_recaptcha
#: model_terms:ir.ui.view,arch_db:google_recaptcha.res_config_settings_view_form
msgid "<i class=\"oi\" data-icon=\"east\"/> Generate reCAPTCHA v3 keys"
msgstr "<i class=\"oi\" data-icon=\"east\"/> ສ້າງຄີ reCAPTCHA v3"

#. module: google_recaptcha
#: model:ir.model.fields,help:google_recaptcha.field_res_config_settings__recaptcha_min_score
msgid ""
"By default, should be one of 0.1, 0.3, 0.7, 0.9.\n"
"1.0 is very likely a good interaction, 0.0 is very likely a bot"
msgstr ""
"ຕາມຄ່າເລີ່ມຕົ້ນ, ຄວນເລືອກໜຶ່ງໃນ 0.1, 0.3, 0.7, 0.9.\n"
"1.0 ແມ່ນມີແນວໂນ້ມສູງວ່າເປັນການໂຕ້ຕອບທີ່ດີ, 0.0 ແມ່ນມີແນວໂນ້ມສູງວ່າເປັນບັອດ"

#. module: google_recaptcha
#: model:ir.model,name:google_recaptcha.model_res_config_settings
msgid "Config Settings"
msgstr "ການຕັ້ງຄ່າ"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_ir_http__display_name
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__display_name
msgid "Display Name"
msgstr "ຊື່ສະແດງ"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__enable_recaptcha
msgid "Enable reCAPTCHA"
msgstr "ເປີດນຳໃຊ້ reCAPTCHA"

#. module: google_recaptcha
#: model:ir.module.module,shortdesc:base.module_google_recaptcha
msgid "Google reCAPTCHA integration"
msgstr "ການເຊື່ອມໂຍງ Google reCAPTCHA"

#. module: google_recaptcha
#: model:ir.model,name:google_recaptcha.model_ir_http
msgid "HTTP Routing"
msgstr "ການກຳນົດເສັ້ນທາງ HTTP"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_ir_http__id
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__id
msgid "ID"
msgstr "ID"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__recaptcha_min_score
msgid "Minimum score"
msgstr "ຄະແນນຂັ້ນຕ່ຳ"

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "Privacy Policy"
msgstr "ນະໂຍບາຍຄວາມເປັນສ່ວນຕົວ"

#. module: google_recaptcha
#: model_terms:ir.ui.view,arch_db:google_recaptcha.res_config_settings_view_form
msgid ""
"Protect your forms from spam and abuse. If no keys are provided, no checks "
"will be done."
msgstr ""
"ປົກປ້ອງຟອມຂອງທ່ານຈາກສະແປມ ແລະ ການລົບກວນ. ຖ້າບໍ່ມີການລະບຸຄີ, ຈະບໍ່ມີການກວດສອບໃດໆ."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "Protected by reCAPTCHA,"
msgstr "ປົກປ້ອງໂດຍ reCAPTCHA,"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__recaptcha_private_key
msgid "Secret Key"
msgstr "ຄີລັບ"

#. module: google_recaptcha
#: model:ir.model.fields,field_description:google_recaptcha.field_res_config_settings__recaptcha_public_key
msgid "Site Key"
msgstr "ຄີເວັບໄຊ"

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "Suspicious activity detected by google reCAPTCHA."
msgstr "ກວດພົບການເຄື່ອນໄຫວທີ່ໜ້າສົງໄສໂດຍ Google reCAPTCHA."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "Terms of Service"
msgstr "ເງື່ອນໄຂການໃຫ້ບໍລິການ"

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "The reCaptcha private key is invalid."
msgstr "ຄີສ່ວນຕົວ reCaptcha ບໍ່ຖືກຕ້ອງ."

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "The reCaptcha token is invalid."
msgstr "ໂທເຄັນ reCaptcha ບໍ່ຖືກຕ້ອງ."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/js/recaptcha.js:0
msgid "The recaptcha site key is invalid."
msgstr "ຄີເວັບໄຊ reCaptcha ບໍ່ຖືກຕ້ອງ."

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "The request is invalid or malformed."
msgstr "ຄຳຮ້ອງຂໍບໍ່ຖືກຕ້ອງ ຫຼື ຮູບແບບບໍ່ສົມບູນ."

#. module: google_recaptcha
#. odoo-python
#: code:addons/google_recaptcha/models/ir_http.py:0
msgid "Your request has timed out, please retry."
msgstr "ຄຳຮ້ອງຂໍຂອງທ່ານໝົດເວລາແລ້ວ, ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/xml/recaptcha.xml:0
msgid "apply."
msgstr "ມີຜົນບັງຄັບໃຊ້."

#. module: google_recaptcha
#. odoo-javascript
#: code:addons/google_recaptcha/static/src/js/recaptcha.js:0
msgid ""
"reCAPTCHA disabled or no site key has been configured. Please check your "
"settings."
msgstr ""
"reCAPTCHA ຖືກປິດການນຳໃຊ້ ຫຼື ຍັງບໍ່ໄດ້ກຳນົດຄ່າຄີເວັບໄຊ. ກະລຸນາກວດສອບການຕັ້ງຄ່າຂອງທ່ານ."
