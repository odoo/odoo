<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_mrporder">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.internal_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row">
                        <div class="col-7">
                            <h2><span t-field="o.name">MRP-001</span></h2>
                        </div>
                        <div class="col-5">
                            <span class="text-end">
                                <span t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:350px;height:60px'}">Package barcode</span>
                            </span>
                        </div>
                    </div>
                    <div class="row mt32 mb32">
                        <div class="col-3" t-if="o.origin">
                            <strong>Source:</strong><br/>
                            <span t-field="o.origin">Vendor ABC</span>
                        </div>
                        <div class="col-3" t-if="o.user_id">
                            <strong>Responsible:</strong><br/>
                            <span t-field="o.user_id">John Doe</span>
                        </div>
                        <div class="col-3" t-if="o.date_deadline">
                            <strong>Deadline:</strong><br/>
                            <span t-field="o.date_deadline">2023-09-15</span>
                        </div>
                    </div>

                    <div class="row mt32 mb32">
                        <div class="col-3">
                            <strong>Product:</strong><br/>
                            <span t-field="o.product_id">Laptop Model X</span>
                        </div>
                        <div class="col-3" t-if="o.product_description_variants">
                            <strong>Description:</strong><br/>
                            <span t-field="o.product_description_variants">Laptop with 16GB RAM</span>
                        </div>
                        <div class="col-3" t-if="o.state != 'done'">
                            <strong>Quantity to Produce:</strong><br/>
                            <span t-field="o.product_qty">100</span>
                            <span t-field="o.uom_id.name" groups="uom.group_uom">Units</span>
                        </div>
                        <div class="col-3" t-if="o.qty_producing and o.state == 'done'">
                            <strong>Quantity Produced:</strong><br/>
                            <span t-field="o.qty_producing">50</span>
                            <span t-field="o.uom_id.name" groups="uom.group_uom">Units</span>
                        </div>
                        <div class="col-3" t-if="o.state == 'done' and o.date_finished">
                            <strong>Production Date:</strong><br/>
                            <span t-field="o.date_finished">2023-09-15</span>
                        </div>
                    </div>

                    <div t-if="o.workorder_ids" groups="mrp.group_mrp_routings">
                        <h3>
                            <span t-if="o.state == 'done'">Operations Done</span>
                            <span t-elif="o.is_planned">Operations Planned</span>
                            <span t-else="">Operations</span>
                        </h3>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <th><strong>Operation</strong></th>
                                <th><strong>Work Center</strong></th>
                                <th><strong>Duration</strong></th>
                                <th t-if="o.state == 'done'"><strong>Actual Duration</strong></th>
                                <th style="width:30%"></th>
                            </tr>
                            <tr t-foreach="o.workorder_ids" t-as="line2">
                                <td><span t-field="line2.name">Assembling</span></td>
                                <td><span t-field="line2.workcenter_id.name">Center A</span></td>
                                <td>
                                    <span t-if="o.state != 'done'" t-field="line2.duration_expected" t-options="{'widget': 'duration', 'unit': 'minute', 'format': 'narrow'}">60</span>
                                    <span t-if="o.state == 'done'" t-field="line2.duration" t-options="{'widget': 'duration', 'unit': 'minute', 'format': 'narrow'}">58</span>
                                </td>
                                <td t-if="o.state == 'done'">
                                    <span t-field="line2.duration" t-options="{'widget': 'duration', 'unit': 'minute', 'format': 'narrow'}">58</span>
                                </td>
                                <td style="width:30%">
                                    <span t-field="line2.barcode" t-if="o.state != 'done'" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:100%;height:35px'}">987654321098</span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div t-if="o.move_raw_ids">
                        <t t-call="mrp.report_mrp_production_components"/>
                    </div>
                    <div t-if="o.move_raw_ids">
                        <t t-call="mrp.report_mrp_production_serials"/>
                    </div>
                    <div class="oe_structure"/>
                </div>
            </t>
        </t>
    </t>
</template>

<template id="report_mrp_production_components">
    <h3>
        <span>
            Components
        </span>
    </h3>
    <table class="table table-sm table-borderless">
        <div class="oe_structure"></div>
        <t t-set="has_product_barcode" t-value="any(m.product_id.barcode for m in o.move_raw_ids)"/>
        <thead>
            <tr>
                <th>Products</th>
                <th t-if="o.state != 'done'" t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}">To Consume</th>
                <th t-if="o.state == 'done'" t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}">Consumed/To Consume</th>
                <th t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}">Serial Numbers</th>
                <th t-if="has_product_barcode" width="15%" class="text-center">Product Barcode</th>
            </tr>
        </thead>
        <tbody>
            <tr t-foreach="o.move_raw_ids" t-as="raw_line">
                <td>
                    <span t-field="raw_line.product_id">8 GB RAM</span>
                </td>
                <td t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}" t-if="o.state != 'done'">
                    <div>
                        <span t-field="raw_line.product_uom_qty">2</span>
                        <span t-field="raw_line.uom_id.name">Units</span>
                    </div>
                </td>
                <td t-attf-class="{{ 'text-end' if not has_product_barcode else '' }}" t-if="o.state == 'done'">
                    <div>
                        <span t-field="raw_line.quantity">2</span>
                        <span>/</span>
                        <span t-field="raw_line.product_uom_qty">2</span>
                        <span t-field="raw_line.uom_id.name">Units</span>
                    </div>
                </td>
                <td>
                    <span t-if="raw_line.lot_ids" t-field="raw_line.lot_ids">8 GB RAM</span>
                </td>
                <td t-if="has_product_barcode" width="15%" class="text-center">
                    <t t-if="raw_line.product_id.barcode">
                        <span t-field="raw_line.product_id.barcode" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:100%;height:35px'}">12345678901</span>
                    </t>
                </td>
            </tr>
        </tbody>
    </table>
</template>

<template id="report_mrp_production_serials">
    <t t-if="o.product_id.tracking in ['serial', 'lot']">
        <h3>
            <span>
                Serial Numbers
            </span>
        </h3>
        <table class="table table-sm table-borderless">
            <tbody>
                <tr t-foreach="o.lot_producing_ids" t-as="serial">
                    <td>
                        <span t-field="serial.name"/>
                    </td>
                </tr>
            </tbody>
        </table>
    </t>
</template>

<template id="label_production_view_pdf">
    <t t-call="web.basic_layout">
        <div class="oe_structure"></div>
        <div t-foreach="label_pages" t-as="page_rows" class="o_label_sheet" t-att-style="'padding: 20mm 8mm'">
            <div class="oe_structure"></div>
            <table class="my-0 table table-sm table-borderless">
                <t t-foreach="page_rows" t-as="label_row">
                    <tr>
                        <t t-foreach="label_row" t-as="label">
                            <t t-call="mrp.report_simple_label4x12"/>
                        </t>
                    </tr>
                </t>
            </table>
            <div class="oe_structure"></div>
        </div>
    </t>
</template>

<template id="report_simple_label4x12" inherit_id="product.report_simple_label4x12" primary="True">
    <xpath expr="//div[hasclass('o_label_centered_content')]/div[hasclass('o_label_table')][1]/div[hasclass('o_label_meta_block')]" position="replace">
        <div t-if="label.get('uom_name')" class="o_label_meta_block">
            <div class="o_label_meta_line">
                <span t-out="label['label_quantity']">1</span>
                <span t-out="label['uom_name']">Units</span>
            </div>
        </div>
    </xpath>
</template>

<template id="report_mrp_packages">
    <t t-set="docs" t-value="docs._get_packages_for_print()"/>
    <t t-call="stock.report_package_barcode"/>
</template>

</odoo>
