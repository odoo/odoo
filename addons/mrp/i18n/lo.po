#. module: mrp
#: model:ir.model.fields.selection,name:mrp.selection__mrp_production__search_date_category__yesterday
#: model_terms:ir.ui.view,arch_db:mrp.view_mrp_production_filter
msgid "Yesterday"
msgstr "ມື້ວານ"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/stock_lot.py:0
msgid ""
"You are not allowed to create or edit a lot or serial number for the "
"components with the operation type \"Manufacturing\". To change this, go on "
"the operation type and tick the box \"Create New Lots/Serial Numbers for "
"Components\"."
msgstr ""
"ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ສ້າງ ຫຼື ແກ້ໄຂເລກຊຸດ ຫຼື ໝາຍເລກລຳດັບສຳລັບສ່ວນປະກອບທີ່ມີປະເພດການດຳເນີນງານເປັ"
"ນ \"ການຜະລິດ\". ເພື່ອປ່ຽນແປງສິ່ງນີ້, ໃຫ້ໄປທີ່ປະເພດການດຳເນີນງານ ແລ້ວໝາຍຕິກໃສ່ຫ້ອງ \"ສ້າງເລກຊຸດ/ໝ"
"າຍເລກລຳດັບໃໝ່ສຳລັບສ່ວນປະກອບ\"."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_bom.py:0
msgid ""
"You can not create a kit-type bill of materials for products that have at "
"least one reordering rule."
msgstr ""
"ທ່ານບໍ່ສາມາດສ້າງໃບລາຍການວັດຖຸດິບປະເພດຊຸດປະກອບ ສຳລັບສິນຄ້າທີ່ມີກົດລະບຽບການສັ່ງຊື້ຄືນຢ່າງໜ້ອຍໜຶ່ງອັນໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_bom.py:0
msgid ""
"You can not delete a Bill of Material with running manufacturing orders.\n"
"Please close or cancel it first."
msgstr ""
"ທ່ານບໍ່ສາມາດລຶບໃບລາຍການວັດຖຸດິບທີ່ມີໃບສັ່ງຜະລິດກຳລັງດຳເນີນການຢູ່ໄດ້.\n"
"ກະລຸນາປິດ ຫຼື ຍົກເລີກໃບສັ່ງຜະລິດນັ້ນກ່ອນ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid ""
"You can only merge manufacturing orders of identical products with same BoM."
msgstr ""
"ທ່ານສາມາດຮວມໄດ້ສະເພາະໃບສັ່ງຜະລິດຂອງສິນຄ້າດຽວກັນທີ່ມີ BoM ດຽວກັນເທົ່ານັ້ນ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid ""
"You can only merge manufacturing orders with no additional components or by-"
"products."
msgstr ""
"ທ່ານສາມາດຮວມໄດ້ສະເພາະໃບສັ່ງຜະລິດທີ່ບໍ່ມີສ່ວນປະກອບ ຫຼື ຜົນຜະລິດພອຍໄດ້ເພີ່ມເຕີມເທົ່ານັ້ນ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You can only merge manufacturing with the same operation type"
msgstr "ທ່ານສາມາດຮວມການຜະລິດທີ່ມີປະເພດການດຳເນີນງານດຽວກັນເທົ່ານັ້ນ"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You can only merge manufacturing with the same state."
msgstr "ທ່ານສາມາດຮວມການຜະລິດທີ່ມີສະຖານະດຽວກັນເທົ່ານັ້ນ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You cannot cancel a manufacturing order that is already done."
msgstr "ທ່ານບໍ່ສາມາດຍົກເລີກໃບສັ່ງຜະລິດທີ່ເຮັດສຳເລັດແລ້ວໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_workorder.py:0
msgid "You cannot change the workcenter of a work order that is done."
msgstr "ທ່ານບໍ່ສາມາດປ່ຽນສູນປະຕິບັດງານຂອງໃບສັ່ງວຽກທີ່ສຳເລັດແລ້ວໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_bom.py:0
msgid "You cannot create a new Bill of Material from here."
msgstr "ທ່ານບໍ່ສາມາດສ້າງໃບລາຍການວັດຖຸດິບໃໝ່ຈາກບ່ອນນີ້ໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_routing.py:0
#: code:addons/mrp/models/mrp_workorder.py:0
msgid "You cannot create cyclic dependency."
msgstr "ທ່ານບໍ່ສາມາດສ້າງຄວາມຂຶ້ນຕໍ່ກັນແບບວົນຊໍ້າ (Cyclic dependency) ໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You cannot delete a manufacturing order that is already done."
msgstr "ທ່ານບໍ່ສາມາດລຶບໃບສັ່ງຜະລິດທີ່ເຮັດສຳເລັດແລ້ວໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_unbuild.py:0
msgid "You cannot delete an unbuild order if the state is 'Done'."
msgstr "ທ່ານບໍ່ສາມາດລຶບໃບສັ່ງແຍກຊິ້ນສ່ວນໄດ້ຖ້າສະຖານະແມ່ນ 'ສຳເລັດ'."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You cannot have %s  as the finished product and in the Byproducts"
msgstr "ທ່ານບໍ່ສາມາດໃຫ້ %s ເປັນທັງສິນຄ້າສຳເລັດຮູບ ແລະ ຢູ່ໃນຜົນຜະລິດພອຍໄດ້"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_workorder.py:0
msgid "You cannot link this work order to another manufacturing order."
msgstr "ທ່ານບໍ່ສາມາດເຊື່ອມໂຍງໃບສັ່ງວຽກນີ້ກັບໃບສັ່ງຜະລິດອື່ນໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You cannot move a manufacturing order once it is cancelled or done."
msgstr "ທ່ານບໍ່ສາມາດຍ້າຍໃບສັ່ງຜະລິດໄດ້ເມື່ອມັນຖືກຍົກເລີກ ຫຼື ສຳເລັດແລ້ວ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/stock_picking.py:0
msgid ""
"You cannot set a scrap location as the destination location for a "
"manufacturing type operation."
msgstr ""
"ທ່ານບໍ່ສາມາດກຳນົດສະຖານທີ່ເສດເສຍເປັນສະຖານທີ່ປາຍທາງສຳລັບການດຳເນີນງານປະເພດການຜະລິດໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You cannot set more than 1 lot"
msgstr "ທ່ານບໍ່ສາມາດກຳນົດຫຼາຍກວ່າ 1 ຊຸດໄດ້"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You cannot set more than 1 lot per product"
msgstr "ທ່ານບໍ່ສາມາດກຳນົດຫຼາຍກວ່າ 1 ຊຸດຕໍ່ສິນຄ້າໄດ້"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_workorder.py:0
msgid "You cannot start a work order that is already done or cancelled"
msgstr "ທ່ານບໍ່ສາມາດເລີ່ມຕົ້ນໃບສັ່ງວຽກທີ່ສຳເລັດ ຫຼື ຖືກຍົກເລີກແລ້ວໄດ້"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_unbuild.py:0
msgid "You cannot unbuild a undone manufacturing order."
msgstr "ທ່ານບໍ່ສາມາດແຍກຊິ້ນສ່ວນໃບສັ່ງຜະລິດທີ່ຍັງບໍ່ສຳເລັດໄດ້."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_bom.py:0
msgid ""
"You cannot use the 'Apply on Variant' functionality and simultaneously "
"create a BoM for a specific variant."
msgstr ""
"ທ່ານບໍ່ສາມາດໃຊ້ຟັງຊັນ 'ນຳໃຊ້ກັບລຸ້ນສິນຄ້າ' ພ້ອມໆກັບການສ້າງ BoM ສຳລັບລຸ້ນສິນຄ້າສະເພາະໄດ້."

#. module: mrp
#: model_terms:ir.ui.view,arch_db:mrp.view_mrp_consumption_warning_form
msgid ""
"You consumed a different quantity than expected for the following products\n"
"                        and/or consumed a product that is not included in "
"the bill of materials.\n"
"                        Please confirm it has been done on purpose."
msgstr ""
"ທ່ານໄດ້ຊົມໃຊ້ຈຳນວນແຕກຕ່າງຈາກທີ່ຄາດໄວ້ສຳລັບສິນຄ້າຕໍ່ໄປນີ້\n"
"                        ແລະ/ຫຼື ຊົມໃຊ້ສິນຄ້າທີ່ບໍ່ໄດ້ລວມຢູ່ໃນໃບລາຍການວັດຖຸດິບ.\n"
"                        ກະລຸນາຢືນຢັນວ່າມັນເກີດຂຶ້ນໂດຍເຈດຕະນາ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid "You need at least two production orders to merge them."
msgstr "ທ່ານຕ້ອງການໃບສັ່ງຜະລິດຢ່າງໜ້ອຍສອງໃບເພື່ອຮວມເຂົ້າກັນ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_workorder.py:0
msgid ""
"You need to define at least one productivity loss in the category "
"'Performance'. Create one from the Manufacturing app, menu: Configuration / "
"Productivity Losses."
msgstr ""
"ທ່ານຕ້ອງກຳນົດການສູນເສຍຜະລິດພາບຢ່າງໜ້ອຍໜຶ່ງລາຍການໃນໝວດ 'ປະສິດທິພາບ'. ສ້າງມັນຈາກແອັບການຜະລິດ, "
"ເມນູ: ການກຳນົດຄ່າ / ການສູນເສຍຜະລິດພາບ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_workorder.py:0
msgid ""
"You need to define at least one productivity loss in the category "
"'Productivity'. Create one from the Manufacturing app, menu: Configuration / "
"Productivity Losses."
msgstr ""
"ທ່ານຕ້ອງກຳນົດການສູນເສຍຜະລິດພາບຢ່າງໜ້ອຍໜຶ່ງລາຍການໃນໝວດ 'ຜະລິດພາບ'. ສ້າງມັນຈາກແອັບການຜະລິດ, ເ"
"ມນູ: ການກຳນົດຄ່າ / ການສູນເສຍຜະລິດພາບ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_workcenter.py:0
msgid ""
"You need to define at least one unactive productivity loss in the category "
"'Performance'. Create one from the Manufacturing app, menu: Configuration / "
"Productivity Losses."
msgstr ""
"ທ່ານຕ້ອງກຳນົດການສູນເສຍຜະລິດພາບທີ່ບໍ່ເປີດໃຊ້ງານຢ່າງໜ້ອຍໜຶ່ງລາຍການໃນໝວດ 'ປະສິດທິພາບ'. ສ້າງມັນຈາກແອັ"
"ບການຜະລິດ, ເມນູ: ການກຳນົດຄ່າ / ການສູນເສຍຜະລິດພາບ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_production.py:0
msgid ""
"You need to supply Lot/Serial Number for products and 'consume' them: %"
"(missing_products)s"
msgstr ""
"ທ່ານຕ້ອງລະບຸ ເລກຊຸດ/ໝາຍເລກລຳດັບ ສຳລັບສິນຄ້າ ແລະ 'ຊົມໃຊ້' ພວກມັນ: %(missing_products)s"

#. module: mrp
#: model:ir.actions.act_window,name:mrp.action_mrp_production_backorder
msgid "You produced less than the initial demand"
msgstr "ທ່ານຜະລິດໄດ້ໜ້ອຍກວ່າຄວາມຕ້ອງການເລີ່ມຕົ້ນ"

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/mrp_unbuild.py:0
msgid "You should provide a lot number for the final product."
msgstr "ທ່ານຄວນລະບຸເລກຊຸດສຳລັບສິນຄ້າສຸດທ້າຍ."

#. module: mrp
#. odoo-python
#: code:addons/mrp/models/stock_quant.py:0
msgid ""
"You should update the components quantity instead of directly updating the "
"quantity of the kit product."
msgstr "ທ່ານຄວນອັບເດດຈຳນວນສ່ວນປະກອບ ແທນທີ່ຈະອັບເດດຈຳນວນຂອງສິນຄ້າຊຸດປະກອບໂດຍກົງ."

#. module: mrp
#: model:ir.model.fields,field_description:mrp.field_mrp_finished_product_label_layout__zpl_preview
msgid "ZPL Preview"
msgstr "ຕົວຢ່າງ ZPL"

#. module: mrp
#: model:ir.model.fields,field_description:mrp.field_mrp_finished_product_label_layout__zpl_template
msgid "ZPL Template"
msgstr "ແບບຟອມ ZPL"

