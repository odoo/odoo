<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mrp.MOViewListDropdown" style="btn">
        <Dropdown t-if="this.props.record.data.production_state !== 'done'" state="this.dropdownState">
            <button
                class="o_state_selection_btn btn btn-secondary mw-100 rounded-pill lh-1 text-truncate opacity-trigger-hover"
                t-att-class="{
                    'o_has_not_label': this.props.display != 'badge',
                    'btn-sm py-1 px-2': this.props.display == 'badge' and this.props.viewType != 'form',
                    'invisible': !this.props.record.resId,
                }"
                t-att-data-tooltip="this.props.display == 'badge' ? '' : this.formattedValue">
                <i
                    class="o_status oi transition-base opacity-100-hover"
                    t-attf-class="
                        {{this.statusColor}}
                        {{this.props.record.data.state != 'ready' ? 'oi-filled' : ''}}
                        {{this.dropdownState.isOpen ? 'opacity-100' : 'opacity-75'}}
                        {{this.props.display == 'badge' ? 'me-1' : ''}}
                    "
                    t-att-data-icon="this.statusIcon"
                />
                <span t-out="this.formattedValue" class="o_status_label text-truncate" t-if="this.props.display === 'badge'"/>
            </button>
            <t t-set-slot="content">
                <DropdownItem
                    class="`d-flex align-items-center`"
                    onSelected="() => this.setState('blocked')">
                        <span class="o_status o_status_warning oi oi-filled me-2" data-icon="circle"/>
                        <span>Blocked</span>
                </DropdownItem>
                <DropdownItem
                    class="`d-flex align-items-center`"
                    onSelected="() => this.setState('ready')">
                        <span t-attf-class="oi me-2" data-icon="circle"/>
                        <span>To Do</span>
                </DropdownItem>
                <DropdownItem
                    class="`d-flex align-items-center`"
                    onSelected="() => this.setState('progress')">
                        <span t-attf-class="o_status o_status_info oi oi-filled me-2" data-icon="play_circle"/>
                        <span>In Progress</span>
                </DropdownItem>
                <DropdownItem
                    class="`d-flex align-items-center`"
                    onSelected="() => this.setState('cancel')">
                        <span t-attf-class="o_status o_status_danger oi oi-filled me-2" data-icon="cancel"/>
                        <span>Cancelled</span>
                </DropdownItem>
                <DropdownItem
                    class="`d-flex align-items-center`"
                    onSelected="() => this.setState('done')">
                        <span t-attf-class="o_status o_status_success oi oi-filled me-2" data-icon="check_circle"/>
                        <span>Done</span>
                </DropdownItem>
            </t>
        </Dropdown>
        <div
            t-else=""
            class="d-flex align-items-center gap-2 mw-100 p-1"
            t-att-class="{
                'invisible': !this.props.record.resId,
            }"
            t-att-data-tooltip="this.props.display == 'badge' ? '' : this.formattedValue">
            <i t-attf-class="o_status {{this.statusColor}} oi {{this.props.record.data.state != 'ready' ? 'oi-filled' : ''}}" t-att-data-icon="this.statusIcon"/>
            <span t-out="this.formattedValue" class="o_status_label text-truncate" t-if="this.props.display === 'badge'"/>
        </div>
    </t>

</templates>
