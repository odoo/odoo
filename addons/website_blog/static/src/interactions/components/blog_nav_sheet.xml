<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website_blog.BlogNavSheet">
    <ul class="list-unstyled mb-0">
        <t t-foreach="this.props.blogs" t-as="blog" t-key="blog.href">
            <li>
                <a t-att-href="blog.href"
                   class="dropdown-item d-flex justify-content-between"
                   t-att-class="{active: blog.active}"
                   t-att-title="blog.name">
                    <span t-out="blog.name"/>
                </a>
            </li>
        </t>
    </ul>
</t>

</templates>
