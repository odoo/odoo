<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_dynamic_snippet_blog_posts_carousel_preview_data" name="Blogs Carousel Preview Data">
    <t t-call="website.s_dynamic_snippet_carousel_preview_data">
        <div class="carousel-item active" style="min-height: 357.875px;">
            <div class="row">
                <div class="col-12 col-lg-4">
                    <t t-call="website_blog.s_blog_posts_carousel_preview_card" cover_img="'/website_blog/static/src/img/cover_3.webp'" title.f="How to stay productive working from home"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_blog.s_blog_posts_carousel_preview_card" cover_img="'/website_blog/static/src/img/cover_2.webp'" title.f="The rise of smart homes: What's next?"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_blog.s_blog_posts_carousel_preview_card" cover_img="'/website_blog/static/src/img/cover_6.webp'" title.f="Top 10 underrated travel destinations in Asia"/>
                </div>
            </div>
        </div>
        <div class="carousel-item" style="min-height: 357.875px;">
            <div class="row">
                <div class="col-12 col-lg-4">
                    <t t-call="website_blog.s_blog_posts_carousel_preview_card" cover_img="'/website_blog/static/src/img/cover_1.webp'" title.f="How to travel the world on a budget"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_blog.s_blog_posts_carousel_preview_card" cover_img="'/website_blog/static/src/img/cover_4.webp'" title.f="The future of artificial intelligence in everyday life"/>
                </div>
                <div class="col-12 col-lg-4 d-none d-lg-block">
                    <t t-call="website_blog.s_blog_posts_carousel_preview_card" cover_img="'/website_blog/static/src/img/cover_5.webp'" title.f="The benefits of a minimalist lifestyle"/>
                </div>
            </div>
        </div>
    </t>
</template>

<template id="s_blog_posts_carousel_preview_card" name="Blog Posts Carousel Preview Card">
    <div class="s_blog_posts_post position-relative w-100">
        <a class="s_blog_posts_post_cover position-relative d-block h-100 rounded shadow-sm overflow-hidden text-decoration-none text-reset ratio ratio-1x1" href="#">
            <div class="o_record_cover_container d-flex flex-column h-100 o_colored_level o_cc w-100 bg-600 position-absolute">
                <div class="o_record_cover_component o_record_cover_image" t-attf-style="background-image: url('{{cover_img}}');"/>
                <div class="o_record_cover_component o_record_cover_filter oe_black" style="opacity: 0.4;"/>
                <div class="s_blog_post_big_picture_infos position-absolute top-0 start-0 w-100 h-100">
                    <div class="s_blog_posts_post_cover_header d-flex flex-column justify-content-end w-100">
                        <h3 class="s_blog_post_big_picture_title m-0 px-4 text-white" t-out="title"/>
                    </div>
                </div>
            </div>
        </a>
    </div>
</template>

</odoo>
