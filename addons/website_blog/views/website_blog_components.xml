<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- ======   Template: Blogs Navbar   =========================================
============================================================================ -->
<template id="blogs_nav" name="Blogs Bar Template">
    <t t-set="wblog_all_title_string">All Blogs</t>

    <nav t-attf-class="#{additional_classes}" aria-label="Blog navigation">
        <h1 t-if="not website.is_view_active('website_blog.opt_blog_cover_post')" class="visually-hidden">Blog Posts</h1>
        <div t-attf-class="position-relative z-1 d-flex gap-2 flex-nowrap py-4">
            <!-- Desktop menu -->
            <ul t-if="len(blogs) > 1" class="o_wblog_category list-unstyled d-none d-lg-flex flex-wrap gap-2 mb-0">
                <li>
                    <a href="/blog" t-attf-class="btn btn-light #{(not blog) and 'active border-primary bg-primary-subtle text-primary-emphasis'}">All</a>
                </li>
                <li t-foreach="blogs" t-as="nav_blog">
                    <a t-attf-href="/blog/#{slug(nav_blog)}"
                       t-attf-class="btn btn-light #{(blog and nav_blog.id == blog.id) and 'active border-primary bg-primary-subtle text-primary-emphasis'}">
                        <span t-out="nav_blog.name"/>
                    </a>
                </li>
            </ul>
            <!-- Mobile menu (toggle button + bottom sheet) -->
            <a t-if="len(blogs) > 1 and blog" href="/blog" t-attf-class="btn btn-link d-lg-none flex-shrink-0 me-auto ps-0">
                <i class="oi me-1" data-icon="chevron_backward" role="img"/>All blogs
            </a>
            <button t-if="len(blogs) > 1" class="o_wblog_sheet_trigger btn btn-light order-last d-lg-none flex-shrink-0"
                    type="button"
                    t-att-title="blog.name if blog else wblog_all_title_string"
                    aria-haspopup="dialog">
                <i class="oi" data-icon="menu" role="img"/>
            </button>

            <!-- Search Box -->
            <!-- Mobile search input-->
            <t t-if="len(blogs) == 1 or not blog" t-call="website.website_search_box_input"
                _form_classes.f="d-sm-none flex-grow-1 ms-auto"
                search_type.f="blog_post"
                action="blog_url(tag=tag,search=search)">
                <input type="hidden" name="tag" t-att-value="tag"/>
                <input type="hidden" name="date_begin" t-att-value="date_begin"/>
                <input type="hidden" name="date_end" t-att-value="date_end"/>
            </t>
            <!-- Mobile search button -->
            <t t-if="len(blogs) > 1 and blog" t-call="website.website_search_box_input"
                search_type.f="blog_post"
                action="blog_url(tag=tag,search=search)"
                _simple_button_layout="True"
                _simple_button_classes.f="d-sm-none btn-light">
                <input type="hidden" name="tag" t-att-value="tag"/>
                <input type="hidden" name="date_begin" t-att-value="date_begin"/>
                <input type="hidden" name="date_end" t-att-value="date_end"/>
            </t>
            <!-- Desktop search input -->
            <t t-call="website.website_search_box_input"
                _form_classes.f="d-none d-sm-block col-lg-4 col-xl-3 flex-grow-1 flex-lg-grow-0 ms-lg-auto ps-lg-4 ps-xl-5"
                search_type.f="blog_post"
                action="blog_url(tag=tag,search=search)">
                <input type="hidden" name="tag" t-att-value="tag"/>
                <input type="hidden" name="date_begin" t-att-value="date_begin"/>
                <input type="hidden" name="date_end" t-att-value="date_end"/>
            </t>
        </div>
    </nav>
</template>

<!-- ======   Template: List Tags in inline list    ============================
============================================================================ -->
<template id="tags_list" name="Tags List">
    <t t-if="tags">
        <div t-if="not hide_title and categ_title" class="small text-muted fw-bold" t-out="categ_title"/>
        <t t-foreach="tags" t-as="tag">
            <span t-if="dismissibleBtn and tag.id in active_tag_ids" t-attf-class="align-items-baseline d-inline-flex ps-2 rounded mb-2 o_filter_tag #{'o_color_%s' % tag.color}">
                <i class="oi oi-filled me-2" data-icon="sell" role="presentation"/>
                <t t-out="tag.name"/>
                <a t-attf-href="#{blog_url(tag=tags_list(active_tag_ids, tag.id))}" class="btn border-0 py-1 post_link text-reset" t-att-rel="len(active_tag_ids) and 'nofollow'"><i class="oi" data-icon="close" role="presentation"/></a>
            </span>
            <a t-elif="showInactive" t-attf-href="#{blog_url(tag=tags_list(active_tag_ids, tag.id))}" t-attf-class="badge o_tag o_color_#{tag.color} post_link" t-att-rel="len(active_tag_ids) and 'nofollow'" t-out="tag.name"/>
        </t>
    </t>
</template>

<!-- ======   Template: Date Selector   ========================================
============================================================================ -->
<template id="date_selector">
    <select name="archive" class="form-select post_link">
        <option t-att-value="blog_url(date_begin=False, date_end=False, tag=tag)"
                t-att="[('selected' if (not date_begin) else 'unselected' ) , 'true' ]">
                All dates
        </option>
        <option t-att-value="blog_url(state='unpublished')" groups="website.group_website_designer">
            -- Unpublished
        </option>
        <option t-att-value="blog_url(state='scheduled')" groups="website.group_website_designer">
            -- Scheduled
        </option>

        <optgroup t-foreach="nav_list" t-as="year" t-attf-label="#{year}">
            <option t-foreach="nav_list[year]" t-as="months"
                    t-att="[('selected' if date_begin and (months['date_begin'] == date_begin) else 'unselected' ) , 'true' ]"
                    t-attf-value="#{blog_url(date_begin=months['date_begin'], date_end=months['date_end'], tag=tag)}">
                <t t-out="months['month']"/>
                <t t-out="year"/>
            </option>
        </optgroup>
    </select>
</template>

<!-- ======   Template: Post Author   ==========================================
============================================================================ -->
<template id="post_published_info">
    <div t-attf-class="d-flex #{_additionnal_classes}">
        <!-- Avatar -->
        <div t-if="blog_post.author_avatar and opt_posts_loop_show_author"
                t-field="blog_post.author_avatar"
                t-options='{"widget": "image", "alt": "", "class": "o_wblog_author_avatar o_avatar me-2 rounded-circle"}'
                t-attf-class="flex-shrink-0 o_not_editable #{_avatar_classes}"/>
        <div t-attf-class="small lh-sm #{_extra_classes}">
            <!-- Author -->
            <div t-if="opt_posts_loop_show_author">
                <div class="o_not_editable">
                    <t t-out="blog_post.author_name"/>
                </div>
            </div>
            <!-- Date -->
            <div t-if="opt_posts_loop_show_date">
                <span t-if="opt_posts_loop_show_author and show_separator" t-attf-class="text-muted #{_separator_classes}">&#8226;</span>
                <t t-if="not is_post_page">
                    <span t-if="blog_post.publish_on" class="text-muted" t-field="blog_post.publish_on" t-options="{'widget': 'date', 'format': 'long', 'date_only': True}" t-attf-title="Will be published on #{blog_post.publish_on.strftime('%Y-%m-%d')}"/>
                    <span t-elif="blog_post.published_date" class="text-muted" t-field="blog_post.published_date" t-options="{'widget': 'date', 'format': 'long', 'date_only': True}"/>
                </t>
                <t t-else="">
                    <t t-set="show_write_date" t-value="blog_post.website_published and blog_post.write_date and blog_post.write_date.date() != blog_post.published_date.date()"/>
                    <span t-if="blog_post.publish_on" class="text-muted">
                        Planned for <span t-field="blog_post.publish_on" t-options="{'widget': 'date', 'format': 'long', 'date_only': True}"/>
                    </span>
                    <span t-elif="blog_post.published_date" t-attf-class="text-muted #{show_write_date and 'small'}" t-field="blog_post.published_date" t-options="{'widget': 'date', 'format': 'long', 'date_only': True}"/>

                    <span t-if="show_write_date" class="small text-muted">
                        (Updated <t t-out="blog_post.write_date" t-options="{'widget': 'date', 'format': 'long', 'date_only': True}"/>)
                    </span>
                </t>
            </div>
        </div>
    </div>
</template>

<!-- TODO: Remove me -->
<template id="post_author"/>

<!-- ======   Template: Post Breadcrumbs   =====================================
============================================================================ -->
<template id="post_breadcrumbs">
    <a t-if="single_breadcrumb" t-attf-href="#{blog_url(tag=None, date_begin=None, date_end=None)}" class="o_wblog_single_breadcrumb_item my-4">
        <i class="oi me-1" data-icon="chevron_backward" role="presentation"/><t t-out="blog.name"/>
    </a>
    <nav t-else="" aria-label="breadcrumb">
        <ol t-attf-class="breadcrumb my-4 p-0 o_not_editable #{additional_classes}">
            <li t-if="len(blogs) > 1" class="breadcrumb-item d-none d-lg-inline-block"><a href="/blog">All Blogs</a></li>
            <li class="breadcrumb-item">
                <a t-attf-href="#{blog_url(tag=None, date_begin=None, date_end=None)}">
                    <i class="oi d-lg-none me-1" data-icon="chevron_backward" role="presentation"/><t t-out="blog.name"/>
                </a>
            </li>
            <li class="breadcrumb-item text-truncate active d-none d-lg-inline"><span t-out="blog_post.name"/></li>
        </ol>
    </nav>
</template>

<!-- ======   Template: Post comments counter (header/discussion link)   =======
============================================================================ -->
<template id="blog_post_comment_count" name="Blog Post Comment Count">
    <a id="o_wblog_post_comment_count" href="#discussion" class="o_not_editable">
        <i class="oi oi-filled me-1" data-icon="chat_bubble"/>
        <t t-out="len(blog_post.message_ids)"/>
        <span t-attf-class="#{hideText and 'd-md-none'}">
            <t t-if="len(blog_post.message_ids) > 1">Comments</t>
            <t t-else="">Comment</t>
        </span>
    </a>
</template>

<!-- TODO: Remove me -->
<template id="blog_post_info" name="Blog Post Info"/>

<!-- ======   Template: Sidebar Blog  ==========================================
Display sidebar in 'All blogs'/single blog pages.

Options:
# opt_sidebar_blog_index_about_us: Display the "About us" text zone
# opt_sidebar_blog_index_follow_us : Display follow-us links
# opt_sidebar_blog_index_tags: Display tags cloud
# opt_sidebar_blog_index_archives : Display a <select> input with post by month
============================================================================ -->
<template id="sidebar_blog_index" name="Sidebar - Blog page">
    <div id="o_wblog_sidebar">
        <div class="oe_structure" id="oe_structure_blog_sidebar_index_1"/>
        <a t-if="blog" title="RSS" t-attf-href="/blog/#{slug(blog)}/feed" class="oi float-end" data-icon="rss_feed"/>
        <div class="o_wblog_sidebar_block pb-4">
            <h2 class="h6">About us</h2>
            <div>
                <p>Write a small text here to describe your blog or company.</p>
            </div>
        </div>
        <div class="oe_structure" id="oe_structure_blog_sidebar_index_2"/>
    </div>
</template>

<!-- (Option) Sidebar Blog: About Us -->
<template id="opt_sidebar_blog_index_about_us" name="About Us" inherit_id="website_blog.sidebar_blog_index" active="True">
    <xpath expr="//div[hasclass('o_wblog_sidebar_block')][1]" position="attributes">
        <attribute name="class" add="d-none" separator=" "/>
    </xpath>
</template>

<!-- (Option) Sidebar Blog: Follow Us -->
<template id="opt_sidebar_blog_index_follow_us" name="Follow Us" priority="1" inherit_id="website_blog.sidebar_blog_index" active="False">
    <xpath expr="//div[@id='o_wblog_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block pb-4" t-ignore="true">
            <h2 class="h6">Follow Us</h2>
            <t t-snippet-call="website.s_social_media" string="Social Media"
                _classes.f="no_icon_color oe_unremovable oe_unmovable"
                _icon_classes.f="rounded-circle o_sm_custom_size"
                _style.f="--fa-icon-size: 40px;"/>
            <t t-call="website_mail.follow" t-if="blog"
                email="user_id.email"
                object="blog"
                div_class.f="pt-2"/>
        </div>
        <div class="oe_structure" id="oe_structure_blog_sidebar_index_3"/>
    </xpath>
</template>

<!-- (Option) Sidebar Blog: Archives -->
<template id="opt_sidebar_blog_index_archives" name="Archives" priority="3" inherit_id="website_blog.sidebar_blog_index" active="False">
    <xpath expr="//div[@id='o_wblog_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block pb-4">
            <h2 class="h6">Archives</h2>
            <t t-call="website_blog.date_selector"/>
        </div>
        <div class="oe_structure" id="oe_structure_blog_sidebar_index_4"/>
    </xpath>
</template>

<!-- (Option) Sidebar Blog: Show tags -->
<template id="opt_sidebar_blog_index_tags" name="Tags List" priority="2" inherit_id="website_blog.sidebar_blog_index" active="False">
    <xpath expr="//div[@id='o_wblog_sidebar']" position="inside">
        <div t-if="other_tags or tag_category" class="o_wblog_sidebar_block pb-4">
            <h2 class="h6">Tags</h2>
            <div t-attf-class="d-flex flex-wrap #{tag_category and 'flex-column gap-2' or 'gap-1'}">
                <div t-foreach="tag_category" t-as="nav_tag_category">
                    <t t-call="website_blog.tags_list"
                        categ_title="nav_tag_category.name"
                        tags="tags_by_category.get(nav_tag_category.id, [])"
                        showInactive="True"/>
                </div>
                <div>
                    <t t-call="website_blog.tags_list"
                        hide_title="not len(tag_category)"
                        categ_title.translate="Others"
                        tags="other_tags"
                        showInactive="True"/>
                </div>
            </div>
        </div>

        <div t-else="" groups="website_blog.group_website_blog_manager" class="o_wblog_sidebar_block pb-4">
            <h2 class="h6">Tags</h2>
            <em t-ignore="True" class="text-muted">No tags defined yet.</em>
        </div>
        <div class="oe_structure" id="oe_structure_blog_sidebar_index_5"/>
    </xpath>
</template>


<!-- ====== Blog Post Sidebar ==================================================
Display a sidebar beside the post content.
============================================================================ -->
<template id="blog_post_sidebar" name="Sidebar - Blog Post">
    <div id="o_wblog_post_sidebar">
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_1"/>
    </div>
</template>


<!-- (Option) Post Sidebar: Author avatar -->
<template id="opt_blog_post_author_avatar_display" name="Author" inherit_id="website_blog.blog_post_sidebar" active="False" priority="0">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block mb-2 pb-4">
            <h2 class="small mb-3">Written by</h2>
            <t t-call="website_blog.post_published_info"
                is_post_page.f="true"
                _additionnal_classes.f="d-flex align-items-center"
                opt_posts_loop_show_author.f="True"
                opt_posts_loop_show_date.f="True"/>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_2"/>
    </xpath>
</template>

<!-- (Option) Post Sidebar: Share Links Display -->
<template id="opt_blog_post_share_links_display" name="Share Links" inherit_id="website_blog.blog_post_sidebar" active="False" priority="2">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block mb-2 pb-4" t-ignore="true">
            <h2 class="small mb-3">Share this post</h2>
            <t t-snippet-call="website.s_share" string="Share"
                _classes.f="no_icon_color oe_unremovable oe_unmovable"
                _icon_classes.f="rounded-circle o_sm_custom_size shadow-sm"
                _style.f="--fa-icon-size: 40px;"
                _link_classes.f="o_wblog_share_links"/>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_3"/>
    </xpath>
</template>

<!-- (Option) Post Sidebar: display tags -->
<template id="opt_blog_post_tags_display" name="Tags" inherit_id="website_blog.blog_post_sidebar" active="False" priority="3">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block mb-2 pb-4">
            <h2 class="small mb-3">Tags</h2>
            <div t-if="blog_post.tag_ids" class="d-flex flex-wrap gap-1 small">
                <t t-foreach="blog_post.tag_ids" t-as="one_tag">
                    <a t-attf-class="badge post_link text-decoration-none o_tag o_color_#{one_tag.color}" t-attf-href="#{blog_url(tag=slug(one_tag))}" t-out="one_tag.name"/>
                </t>
            </div>
            <t t-else="">
                <div class="mb-4 bg-100 py-2 px-3 border" groups="website_blog.group_website_blog_manager">
                    <h2 class="text-muted o_not_editable h6"><em>No tags defined</em></h2>
                    <a role="menuitem" t-attf-href="/odoo/website/{{main_object._name}}/{{main_object.id}}"
                        title='Edit in backend' id="edit-in-backend" class="css_editable_mode_hidden">Add some</a>
                </div>
            </t>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_4"/>
    </xpath>
</template>

<!-- (Option) Post Sidebar: display Blogs list -->
<template id="opt_blog_post_blogs_display" name="Blogs List" inherit_id="website_blog.blog_post_sidebar" active="False" priority="4">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div t-if="len(blogs) > 1" class="o_wblog_sidebar_block mb-2 pb-4">
            <h2 class="small mb-3">Our blogs</h2>
            <ul class="list-unstyled small">
                <li t-foreach="blogs" t-as="nav_blog" class="mb-2">
                    <a t-attf-href="#{blog_url(blog=nav_blog, tag=False, date_begin=False, date_end=False)}" t-out="nav_blog.name"/>
                </li>
            </ul>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_5"/>
    </xpath>
</template>

<!-- (Option) Post Sidebar: display Archive -->
<template id="opt_blog_post_archive_display" name="Archive" inherit_id="website_blog.blog_post_sidebar" active="False" priority="5">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block mb-2 pb-4">
            <h2 class="small mb-3">Archive</h2>
            <t t-call="website_blog.date_selector"/>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_6"/>
    </xpath>
</template>

<!-- (Option) Post Sidebar: display Table of Contents -->
<template id="opt_blog_post_toc_display" name="Table of Contents" inherit_id="website_blog.blog_post_sidebar" active="True" priority="1">
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="attributes">
        <attribute name="class">o_wblog_post_sidebar_sticky o_sticky_reactive sticky-lg-top</attribute>
    </xpath>
    <xpath expr="//div[@id='o_wblog_post_sidebar']" position="inside">
        <div class="o_wblog_sidebar_block o_wblog_toc mb-2 pb-4">
            <h2 class="small mb-3">On this page</h2>
            <nav class="o_wblog_toc_nav o_not_editable">
                <!-- Table of contents will be generated by JavaScript -->
            </nav>
        </div>
        <div class="oe_structure" id="oe_structure_blog_post_sidebar_7"/>
    </xpath>
</template>

</odoo>
