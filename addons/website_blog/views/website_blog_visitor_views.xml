<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_blog_visitor_page_view_tree" model="ir.ui.view">
        <field name="name">website.track.view.list</field>
        <field name="model">website.track</field>
        <field name="arch" type="xml">
            <list string="Visitor Blog Post Views History" create="0">
                <field name="visitor_id"/>
                <field name="blog_post_id"/>
                <field name="visit_datetime"/>
            </list>
        </field>
    </record>

    <record id="website_blog_visitor_blog_post_action" model="ir.actions.act_window">
        <field name="name">Blog Post Views History</field>
        <field name="res_model">website.track</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('website_blog_visitor_page_view_tree')}),
        ]"/>
        <field name="domain">[('visitor_id', '=', active_id), ('blog_post_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
              No blog post views yet for this visitor
            </p>
        </field>
    </record>

    <record id="website_blog_visitor_page_view_search" model="ir.ui.view">
        <field name="name">website.blog.track.view.search</field>
        <field name="model">website.track</field>
        <field name="inherit_id" ref="website.website_visitor_page_view_search"/>
        <field name="arch" type="xml">
            <field name="url" position="after">
                <field name="blog_post_id"/>
            </field>
            <filter name="type_url" position="after">
                <filter string="Blog Posts" name="type_blog_post" domain="[('blog_post_id', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="website_blog_visitor_view_form" model="ir.ui.view">
        <field name="name">website.visitor.view.form</field>
        <field name="model">website.visitor</field>
        <field name="inherit_id" ref="website.website_visitor_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(website.website_visitor_page_action)d']" position="after">
                <button name="%(website_blog.website_blog_visitor_blog_post_action)d"
                    type="action"
                    class="oe_stat_button"
                    icon="sell">
                    <field name="visitor_blog_post_count" widget="statinfo" string="Blog Post Views"/>
                </button>
            </xpath>
            <field name="page_ids" position="after">
                <field name="blog_post_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="website_blog_visitor_view_tree" model="ir.ui.view">
        <field name="name">website.blog.visitor.view.list</field>
        <field name="model">website.visitor</field>
        <field name="inherit_id" ref="website.website_visitor_view_tree"/>
        <field name="arch" type="xml">
            <field name="page_ids" position="after">
                <field name="blog_post_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="website_blog_visitor_track_view_tree" model="ir.ui.view">
        <field name="name">website.track.view.list</field>
        <field name="model">website.track</field>
        <field name="inherit_id" ref="website.website_visitor_track_view_tree"/>
        <field name="arch" type="xml">
            <field name="url" position="after">
                <field name="blog_post_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
