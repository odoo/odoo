<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="partner_id"/>
                <field name="status"/>
                <button name="action_accept" type="object" icon="fa-check" title="Accept"/>
                <button name="action_refuse" type="object" icon="fa-times" title="Refuse"/>
            </list>
        </field>
    </record>
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form><header>
                <button name="action_accept" type="object" string="Accept" class="btn-primary"/>
                <button name="action_refuse" type="object" string="Refuse"/>
            </header><sheet><group>
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="partner_id"/>
                <field name="status"/>
            </group></sheet></form>
        </field>
    </record>
</odoo>
