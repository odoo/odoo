<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Opens the properties: the menu item points to this window action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Advertise your first property</p>
            <p>Create a property, then follow the offers made on it until it is sold.</p>
        </field>
    </record>
</odoo>
