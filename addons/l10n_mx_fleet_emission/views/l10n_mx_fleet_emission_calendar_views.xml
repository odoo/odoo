<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_mx_fleet_emission_calendar_view_list" model="ir.ui.view">
        <field name="name">l10n_mx.fleet.emission.calendar.list</field>
        <field name="model">l10n_mx.fleet.emission.calendar</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="color" widget="emission_sticker_color" />
                <field name="plate_digits" />
                <field name="first_period_start" />
                <field name="first_period_end" />
                <field name="second_period_start" />
                <field name="second_period_end" />
                <field name="period_display" />
            </list>
        </field>
    </record>

    <record id="l10n_mx_fleet_emission_calendar_action" model="ir.actions.act_window">
        <field name="name">Emissions Calendar</field>
        <field name="res_model">l10n_mx.fleet.emission.calendar</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the emissions inspection calendar</p>
            <p>Each row maps the last digits of a license plate to a sticker color and its two yearly inspection windows.</p>
        </field>
    </record>

</odoo>
