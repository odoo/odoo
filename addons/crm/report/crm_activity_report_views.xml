<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="crm_activity_report_view_graph" model="ir.ui.view">
            <field name="name">crm.activity.report.graph</field>
            <field name="model">mail.activity</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <graph string="Activities Analysis" sample="1">
                    <field name="activity_type_id"/>
                    <field name="date_done" interval="month"/>
                </graph>
            </field>
        </record>

        <record id="crm_activity_report_view_pivot" model="ir.ui.view">
            <field name="name">crm.activity.report.pivot</field>
            <field name="model">mail.activity</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <pivot string="Activities Analysis" sample="1">
                    <field name="activity_type_id" type="col"/>
                    <field name="date_done" interval="month" type="row"/>
                </pivot>
            </field>
        </record>

        <record id="crm_activity_report_view_tree" model="ir.ui.view">
            <field name="name">crm.activity.report.list</field>
            <field name="model">mail.activity</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <list default_order="date_done desc, id desc"
                      action="action_open_document"
                      type="object"
                >
                    <field name="date_done"/>
                    <field name="user_id" widget="many2one_avatar"/>
                    <field name="activity_type_id"/>
                </list>
            </field>
        </record>

        <record id="crm_activity_report_view_search" model="ir.ui.view">
            <field name="name">crm.activity.report.search</field>
            <field name="model">mail.activity</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <search string="Activities Analysis">
                    <field name="activity_type_id" string="Activity Type"/>
                    <field name="user_id"/>
                    <filter string="Done" name="filter_archived" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Team Members" name="filter_team_members"
                        domain="[('user_id', 'in', context.get('team_member_ids', []))]"
                        invisible="not context.get('team_member_ids')"/>
                    <separator/>
                    <filter string="Trailing 12 months" name="filter_last_12_months" domain="['|',
                        '&amp;', ('date_done', '>=', '-1y'), ('date_done', '&lt;', '+1d'),
                        '&amp;', ('create_date', '>=', '-1y'), ('create_date', '&lt;', '+1d')]"/>
                    <separator/>
                    <filter name="filter_date" date="date_done"/>
                    <group>
                        <filter string="Activity" name="group_by_activity_type" context="{'group_by': 'activity_type_id'}"/>
                        <filter string="Assigned To" name="group_by_user_id" context="{'group_by': 'user_id'}"/>
                        <filter string="Completion Date" name="group_by_completion_date" context="{'group_by': 'date_done:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="crm_activity_report_action" model="ir.actions.act_window">
            <field name="name">Activities</field>
            <field name="res_model">mail.activity</field>
            <field name="view_mode">graph,pivot,list</field>
            <field name="search_view_id" ref="crm_activity_report_view_search"/>
            <field name="context">{
                'search_default_filter_archived': 1,
                'search_default_filter_last_12_months': 1,
                'pivot_column_groupby': ['activity_type_id'],
                'pivot_row_groupby': ['date_done:month'],
                'graph_mode': 'bar',
                'graph_groupbys': ['date_done:month'],
            }</field>
            <field name="domain">[('res_model', '=', 'crm.lead'), ('active', 'in', [True, False])]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Let's get to work!
                </p><p>
                    Activities on leads will appear here, providing an overview of lead interactions.
                </p>
            </field>
        </record>

        <record id="crm_activity_report_action_view_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="crm_activity_report_view_graph"/>
            <field name="act_window_id" ref="crm_activity_report_action"/>
        </record>

        <record id="crm_activity_report_action_view_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="crm_activity_report_view_pivot"/>
            <field name="act_window_id" ref="crm_activity_report_action"/>
        </record>

        <record id="crm_activity_report_action_view_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="crm_activity_report_view_tree"/>
            <field name="act_window_id" ref="crm_activity_report_action"/>
        </record>

</odoo>
