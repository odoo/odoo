<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm.Breadcrumbs">
        <!-- Without previous breadcrumbs, the switcher replaces them: only their actions are kept -->
        <t t-if="this.hasTeamSwitcher and this.props.breadcrumbs.length &lt;= 1">
            <t t-call="web.Breadcrumb.Actions"/>
            <t t-call-slot="breadcrumb-status-indicator"/>
        </t>
        <t t-else="" t-call="web.Breadcrumbs"/>
        <!-- The switcher is always displayed after the breadcrumbs -->
        <TeamSwitcher t-if="this.hasTeamSwitcher"/>
    </t>

</templates>
