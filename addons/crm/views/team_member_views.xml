<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="team_member_view_tree_crm" model="ir.ui.view">
            <field name="name">team.member.view.list</field>
            <field name="model">team.member</field>
            <field name="inherit_id" ref="team.team_member_view_tree" />
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <field name="team_use_sale" column_invisible="True" />
                    <field name="lead_assignment_enabled" column_invisible="True" />
                    <field name="lead_assignment_optout" optional="show" />
                    <field name="lead_assignment_max" optional="show" />
                    <field
                        name="lead_month_count"
                        optional="show"
                        groups="sale.group_sale_salesman,sale.group_sale_readonly" />
                </field>
            </field>
        </record>
        <record id="team_member_view_kanban_crm" model="ir.ui.view">
            <field name="name">team.member.view.kanban.inherit.crm</field>
            <field name="model">team.member</field>
            <field name="inherit_id" ref="team.team_member_view_kanban" />
            <field name="arch" type="xml">
                <field name="active" position="after">
                    <field name="team_use_sale" />
                    <field name="lead_assignment_enabled" />
                    <field name="lead_assignment_optout" />
                    <field name="lead_assignment_max" />
                </field>
                <xpath expr="//main" position="after">
                    <div
                        class="o_member_assignment"
                        invisible="not team_use_sale or lead_assignment_optout">
                        <field
                            name="lead_month_count"
                            widget="gauge"
                            options="{'max_field': 'lead_assignment_max'}"
                            groups="sale.group_sale_salesman,sale.group_sale_readonly"
                            invisible="lead_assignment_max == 0" />
                    </div>
                </xpath>
            </field>
        </record>
        <record id="team_member_view_form_crm" model="ir.ui.view">
            <field name="name">team.member.view.form.inherit.crm</field>
            <field name="model">team.member</field>
            <field name="inherit_id" ref="team.team_member_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page
                            name="lead_assign"
                            string="Lead Assignment"
                            invisible="not team_use_sale">
                            <field name="team_use_sale" invisible="1" />
                            <group>
                                <label
                                    for="lead_assignment_max"
                                    string="Capacity"
                                    invisible="lead_assignment_optout"
                                    class="o_form_label text-900" />
                                <span invisible="lead_assignment_optout">
                                    <field
                                        name="lead_month_count"
                                        groups="sale.group_sale_salesman,sale.group_sale_readonly"
                                        class="oe_inline" />
                                    <span> leads assigned the last 30 days out of a maximum of </span>
                                    <field
                                        name="lead_assignment_max"
                                        class="oe_inline o_field_highlight o_input_6ch border-bottom border-dark" />
                                </span>
                                <field name="lead_assignment_optout" />
                                <field
                                    name="lead_assignment_domain_preferred"
                                    string="Lead Priority Filter"
                                    widget="domain"
                                    options="{'model': 'crm.lead', 'foldable': True}"
                                    invisible="not lead_assignment_enabled or lead_assignment_max == 0 or lead_assignment_optout" />
                                <field
                                    name="lead_assignment_domain"
                                    string="Lead Assignment Filter"
                                    widget="domain"
                                    options="{'model': 'crm.lead', 'foldable': True}"
                                    invisible="not lead_assignment_enabled or lead_assignment_max == 0 or lead_assignment_optout" />
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        <record id="sale_team.team_member_action_sales" model="ir.actions.act_window">
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a Team Member
                </p><p>
                    Team Members are salespersons assigned to specific teams.
                </p>
            </field>
        </record>
    </data>

</odoo>
