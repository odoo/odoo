<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_inherit_l10n_fr_factoring" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.l10n.fr.factoring</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="account.view_partner_bank_form_inherit_account"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acc_holder_name']" position="after">
                <field name="is_factoring"/>
                <field name="acc_holder_partner_id" invisible="not is_factoring" required="is_factoring" domain="[('is_company', '=', True)]" context="{'default_is_company': True}"/>
                <field name="payment_note" invisible="not is_factoring"/>
            </xpath>
        </field>
    </record>
</odoo>
