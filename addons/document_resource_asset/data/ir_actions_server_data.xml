<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="ir_actions_server_link_to_asset_code" model="ir.actions.server">
            <field name="name">Link to an asset</field>
            <field name="model_id" ref="document.model_document_document" />
            <field name="group_ids" eval="[Command.link(ref('base.group_user'))]" />
            <field name="state">code</field>
            <field
                name="code">action = records.action_link_to_record('resource.asset')</field>
        </record>
        <record id="ir_actions_server_link_to_asset" model="ir.actions.server">
            <field name="name">Link to an asset</field>
            <field name="model_id" ref="document.model_document_document" />
            <field name="group_ids" eval="[Command.link(ref('base.group_user'))]" />
            <field name="state">multi</field>
            <field
                name="child_ids"
                eval="[Command.link(ref('ir_actions_server_link_to_asset_code'))]" />
        </record>
    </data>

</odoo>
