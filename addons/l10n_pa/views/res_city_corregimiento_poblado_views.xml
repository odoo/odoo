<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_city_corregimiento_poblado_view_list" model="ir.ui.view">
        <field name="name">l10n_pa.res.city.corregimiento.poblado.list</field>
        <field name="model">l10n_pa.res.city.corregimiento.poblado</field>
        <field name="arch" type="xml">
            <list string="Poblados" editable="top" multi_edit="1">
                <field name="name"/>
                <field name="l10n_pa_code"/>
                <field name="corregimiento_id"/>
            </list>
        </field>
    </record>

    <record id="res_city_corregimiento_poblado_view_form" model="ir.ui.view">
        <field name="name">l10n_pa.res.city.corregimiento.poblado.form</field>
        <field name="model">l10n_pa.res.city.corregimiento.poblado</field>
        <field name="arch" type="xml">
            <form string="Poblado">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sirena"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="l10n_pa_code" placeholder="e.g. 8-2-1-28"/>
                        </group>
                        <group>
                            <field name="corregimiento_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_city_corregimiento_poblado_view_search" model="ir.ui.view">
        <field name="name">l10n_pa.res.city.corregimiento.poblado.search</field>
        <field name="model">l10n_pa.res.city.corregimiento.poblado</field>
        <field name="arch" type="xml">
            <search string="Search Poblado">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('l10n_pa_code', 'ilike', self)]"/>
                <field name="corregimiento_id"/>
                <group>
                    <filter name="group_by_corregimiento" string="Corregimiento" context="{'group_by': 'corregimiento_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_city_corregimiento_poblado" model="ir.actions.act_window">
        <field name="name">Poblados</field>
        <field name="res_model">l10n_pa.res.city.corregimiento.poblado</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a poblado
            </p><p>
                Poblados are the populated places within a corregimiento, each one
                identified by its DGI code.
            </p>
        </field>
    </record>

    <menuitem id="menu_res_city_corregimiento_poblado"
        name="Poblado (PA)"
        action="action_res_city_corregimiento_poblado"
        parent="contacts.menu_localisation"
        sequence="4"/>

</odoo>
