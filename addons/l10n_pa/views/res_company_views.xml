<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_company_view_form_inherit_l10n_pa" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.l10n_pa</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='vat_div']" position="inside">
                <label for="l10n_pa_dv" invisible="country_code != 'PA'"/>
                <field name="l10n_pa_dv" placeholder="e.g. 00" class="oe_inline"
                       invisible="country_code != 'PA'"/>
            </xpath>
        </field>
    </record>

</odoo>
