<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_partner_view_form_inherit_l10n_pa" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.l10n_pa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="street2" position="after">
                <field name="l10n_pa_corregimiento"
                       placeholder="Corregimiento..."
                       class="o_address_street"
                       options="{'no_open': True, 'no_quick_create': True}"
                       invisible="country_code != 'PA'"
                       readonly="type == 'contact' and parent_id"/>
            </field>
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="l10n_pa_dv" placeholder="e.g. 00" invisible="country_code != 'PA'"/>
            </xpath>
            <div name="warning_tax" position="after">
                <div class="alert alert-warning" role="alert" invisible="not l10n_pa_vat_is_cedula">
                    This Tax ID looks like a cédula. If this is a natural person, enter it as Cédula instead, with its DV.
                </div>
            </div>
        </field>
    </record>

</odoo>
