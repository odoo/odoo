<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="barcode_normal_label" inherit_id="product.barcode_normal_label">
        <xpath expr="." position="inside">
            <t t-if="label.get('hs_code')">
^FO35,220^A0N,15^FDHS:<t t-out="label['hs_code']"/>^FS
            </t>
        </xpath>
    </template>
    <template id="barcode_alternative_label" inherit_id="product.barcode_alternative_label">
        <xpath expr="." position="inside">
            <t t-if="label.get('hs_code')">
^FO35,180^A0N,15^FDHS:<t t-out="label['hs_code']"/>^FS
            </t>
        </xpath>
    </template>
</odoo>
