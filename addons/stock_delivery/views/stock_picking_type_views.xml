<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_picking_type_form_delivery">
        <field name="name">stock.picking.type.list.delivery</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_code']" position="after">
                <field name="print_label" invisible="code not in ['internal', 'outgoing']"/>
            </xpath>
            <field name="auto_print_reception_report_labels" position="after">
                <div colspan="2" class="alert alert-warning" role="alert" invisible="code == 'incoming'">
                    <a class="alert-link">Carrier Labels</a>
                    and <a class="alert-link">Export documents</a>
                    are uploaded to the chatter when the picking is validated. If you want to
                    print them automatically on validation, you need to configure a printer on the
                    report form.<br/>
                    <a type="action" name="%(open_shipping_labels_report)d">
                        <i class="oi pe-1" data-icon="arrow_forward"/>Configure Carrier Labels
                    </a>
                    <br/>
                    <a type="action" name="%(open_export_docs_report)d">
                        <i class="oi pe-1" data-icon="arrow_forward"/>Configure Export Documents
                    </a>
                </div>
                <field name="auto_print_carrier_labels" string="Carrier Labels" invisible="code == 'incoming'"/>
                <field name="auto_print_export_documents" string="Export Documents" invisible="code == 'incoming'"/>
            </field>
            <div name="wave_category" position="after">
                <div name="batch_carrier" class="o_row" invisible="batch_creation_type == 'manual'">
                    <field name="batch_group_by_carrier"/>
                    <label for="batch_group_by_carrier"/>
                </div>
            </div>
            <div name="batch_lines" position="after">
                <div class="o_row" name="batch_max_weight" invisible="batch_creation_type == 'manual'">
                    <field name="batch_max_weight" style="max-width:4em" widget="external_placeholder_integer_field" placeholder="All"/>
                    <div>
                        <field name="weight_uom_name" class="oe_inline"/>
                        <label for="batch_max_weight" string=""/>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
