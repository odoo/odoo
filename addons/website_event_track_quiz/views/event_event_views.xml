<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="event_event_view_form" model="ir.ui.view">
        <field name="name">event.event.view.form.inherit.track.quiz</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="website_event.event_event_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//*[label[@for='website_menu']]" position="after">
                <span name="community_menu">
                    <field name="community_menu" class="w-auto"/>
                    <label for="community_menu" string="Community"/>
                </span>
            </xpath>
        </field>
    </record>

</data></odoo>
