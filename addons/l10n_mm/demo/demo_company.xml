<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_demo_company_mm" model="res.partner" forcecreate="1">
        <field name="name">MM Company</field>
        <field name="street">No. 123, Pyay Road</field>
        <field name="street2">Kamayut Township</field>
        <field name="city">Yangon</field>
        <field name="country_id" ref="base.mm"/>
        <field name="zip">11041</field>
        <field name="phone">+95 1 234 5678</field>
        <field name="email">info@company.mmexample.com</field>
        <field name="website">www.mmexample.com</field>
    </record>

    <record id="base.demo_company_mm" model="res.company" forcecreate="1">
        <field name="name">MM Company</field>
        <field name="partner_id" ref="base.partner_demo_company_mm"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('base.demo_company_mm')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('base.demo_company_mm'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>mm</value>
        <value model="res.company" eval="obj().env.ref('base.demo_company_mm')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
