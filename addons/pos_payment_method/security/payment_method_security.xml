<odoo>
    <record id="group_payment_method_user" model="res.groups">
        <field name="name">User</field>
    </record>
    <record id="group_payment_method_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('group_payment_method_user'))]"/>
    </record>
</odoo>
