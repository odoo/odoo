<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website_sale_stock.locationSelector.location">
        <button
            t-attf-id="location-{{this.props.id}}"
            class="collapsed d-flex gap-3 w-100 border rounded p-3 text-body text-start"
            t-att-class="{'border-primary bg-primary-light': this.props.isSelected}"
            t-on-click="() => this.props.setSelectedLocation(this.props.id)"
            type="button"
            t-att-aria-pressed="this.props.isSelected ? 'true' : 'false'"
            t-attf-data-bs-target="#collapseHours_{{this.props.id}}"
            aria-expanded="false"
            t-attf-aria-controls="collapseHours_{{this.props.id}}"
            data-bs-toggle="collapse"
        >
            <span
                class="o_location_selector_number d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle small fw-bold"
                t-att-class="this.props.isSelected ? 'text-bg-primary' : 'text-bg-light'"
                t-out="this.props.number"
            />
            <span class="d-flex flex-column gap-1 w-100">
                <strong class="fw-bold" t-out="this.props.name"/>
                <small
                    t-if="this.hasOpeningHours"
                    name="location_today_status"
                    class="fw-medium"
                    t-att-class="this.todayStatus.isOpen ? 'text-success' : 'text-danger'"
                    t-out="this.todayStatus.label"
                />
                <small class="text-muted">
                    <t t-out="this.props.street"/>, <t t-out="this.getCityAndZipCode()"/>
                </small>
                <small name="location_opening_hours" t-attf-class="d-flex align-items-center gap-1 fw-bold {{this.hasOpeningHours ? 'd-md-none' : 'd-none'}}">
                    <i class="oi" data-icon="schedule" role="img" aria-label="Opening hours"/>
                    <t t-out="this.openingHoursLabel"/>
                    <i class="oi o_location_selector_hours_caret ms-auto transition-base" data-icon="keyboard_arrow_up" role="img" aria-hidden="true"/>
                </small>

                <!-- Schedule -->
                <span
                    class="collapse d-md-none"
                    t-attf-id="collapseHours_{{this.props.id}}"
                    data-bs-parent="#o_location_selector_list_view"
                  >
                    <LocationSchedule openingHours="this.props.openingHours"/>
                </span>
            </span>
        </button>
    </t>
</templates>
