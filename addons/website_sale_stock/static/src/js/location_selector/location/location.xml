<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website_sale_stock.locationSelector.location">
        <div class="position-relative d-flex gap-3 border rounded p-3">
            <span
                class="o_location_selector_number d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle small fw-bold"
                t-att-class="{'text-bg-primary': this.isHovered}"
            >
                <i t-if="this.props.readonly" class="oi" data-icon="storefront" role="img" aria-hidden="true"/>
                <t t-else="" t-out="this.props.number"/>
            </span>
            <div class="d-flex flex-column gap-1 w-100">
                <strong
                    t-if="this.props.readonly"
                    t-attf-id="location-{{this.props.id}}"
                    name="location_name"
                    t-out="this.props.name"
                />
                <button
                    t-else=""
                    t-attf-id="location-{{this.props.id}}"
                    type="button"
                    name="location_name"
                    class="stretched-link border-0 p-0 bg-transparent text-body text-start fw-bold"
                    t-on-click="() => this.props.setSelectedLocation(this.props.id)"
                    t-out="this.props.name"
                />
                <small name="location_address" class="text-muted">
                    <t t-out="this.props.street"/>, <t t-out="this.getCityAndZipCode()"/>
                </small>
                <div
                    t-if="this.hasOpeningHours"
                    name="location_opening_hours"
                    class="position-relative z-2 mt-1 rounded bg-light"
                >
                    <t
                        t-call="website_sale_stock.locationSelector.openingHours"
                        collapseId="'collapseHours_' + this.props.id"
                        collapseParent="'#o_location_selector_list_view'"
                        openingHours="this.props.openingHours"
                        todayStatus="this.todayStatus"
                    />
                </div>
                <button
                    t-if="!this.props.readonly"
                    type="button"
                    class="btn btn-primary position-relative z-2 mt-2"
                    t-on-click="this.chooseLocation"
                >
                    Choose this location
                </button>
            </div>
        </div>
    </t>
</templates>
