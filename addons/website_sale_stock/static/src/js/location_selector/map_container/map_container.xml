<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website_sale_stock.locationSelector.mapContainer">
        <div class="position-relative d-flex flex-column h-100 w-100">
            <Map
                t-if="this.state.shouldLoadMap"
                locations="this.props.locations"
                selectedLocationId="this.props.selectedLocationId"
                setSelectedLocation="this.props.setSelectedLocation"
            />
            <div
                t-else=""
                class="d-flex justify-content-center align-items-center flex-grow-1 w-100 bg-200"
            >
                <span t-out="this.errorMessage"/>
            </div>

            <!-- Desktop infos -->
            <div
                t-if="this.selectedLocation"
                class="card col-11 col-lg-7 position-absolute bottom-0 start-0 z-1 d-none d-md-flex flex-column gap-3 m-3 m-lg-4 border-0 p-4 shadow"
            >
                <div class="d-flex flex-column gap-1">
                    <h2 class="h5 mb-0" t-out="this.selectedLocation.name"/>
                    <small class="text-muted">
                        <t t-out="this.selectedLocation.street"/>
                        <br/>
                        <t t-out="this.getCityAndZipCode(this.selectedLocation)"/>
                    </small>
                </div>

                <!-- Schedule -->
                <div t-if="this.hasOpeningHours" name="location_opening_hours" class="rounded bg-light">
                    <button
                        type="button"
                        class="collapsed d-flex align-items-center gap-2 w-100 border-0 px-3 py-2 bg-transparent text-body text-start small"
                        data-bs-toggle="collapse"
                        data-bs-target="#o_location_selector_details_hours"
                        aria-expanded="false"
                        aria-controls="o_location_selector_details_hours"
                    >
                        <i
                            class="oi"
                            t-att-class="this.todayStatus.isOpen ? 'text-success' : 'text-danger'"
                            data-icon="schedule"
                            role="img"
                            aria-hidden="true"
                        />
                        <span
                            class="flex-grow-1 fw-medium"
                            t-att-class="this.todayStatus.isOpen ? 'text-success' : 'text-danger'"
                            t-out="this.todayStatus.label"
                        />
                        <small class="text-muted">All hours</small>
                        <i class="oi o_location_selector_hours_caret transition-base" data-icon="keyboard_arrow_up" role="img" aria-hidden="true"/>
                    </button>
                    <div id="o_location_selector_details_hours" class="collapse">
                        <LocationSchedule
                            openingHours="this.selectedLocation.opening_hours"
                            wrapClass="'px-3 pb-3'"
                        />
                    </div>
                </div>

                <button
                    type="button"
                    id="submit_location_large"
                    class="btn btn-primary"
                    t-att-disabled="!this.props.selectedLocationId"
                    t-on-click="this.props.validateSelection"
                    t-out="this.chooseLocationButtonLabel"/>
            </div>

            <!-- Mobile infos -->
            <button
                t-if="this.selectedLocation"
                class="btn collapsed d-flex d-md-none gap-2 gap-lg-3 w-100 border-0 p-3 bg-transparent text-start"
                type="button"
                data-bs-target="#map_collapseHours"
                aria-expanded="false"
                aria-controls="map_collapseHours"
                data-bs-toggle="collapse"
            >
                <span class="d-flex flex-column gap-1 w-100">
                    <span class="d-flex flex-column">
                        <strong class="fw-bold" t-out="this.selectedLocation.name"/>
                        <small class="text-muted">
                            <span t-out="this.selectedLocation.street"/>
                            <span class="d-block" t-out="this.getCityAndZipCode(this.selectedLocation)"/>
                        </small>
                    </span>
                    <span t-attf-class="d-flex align-items-center gap-1 small fw-bold {{this.hasOpeningHours ? 'd-md-none' : 'd-none'}}">
                        <i class="oi" data-icon="schedule" role="img" aria-hidden="true"/>
                        <t t-out="this.openingHoursLabel"/>
                        <i class="o_location_selector_hours_caret oi ms-auto transition-base" data-icon="keyboard_arrow_up" role="img" aria-hidden="true"/>
                    </span>

                    <!-- Schedule -->
                    <span class="collapse" id="map_collapseHours">
                        <LocationSchedule openingHours="this.selectedLocation.opening_hours"/>
                    </span>
                </span>
            </button>
        </div>
    </t>
</templates>
