<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website_sale_stock.locationSelector.mapContainer">
        <div class="d-flex flex-column h-100 w-100">
            <Map
                t-if="this.state.shouldLoadMap"
                locations="this.props.locations"
                selectedLocationId="this.props.selectedLocationId"
                setSelectedLocation="this.props.setSelectedLocation"
                setHoveredLocation="this.props.setHoveredLocation"
                readonly="this.props.readonly"
            />
            <div
                t-else=""
                class="d-flex justify-content-center align-items-center flex-grow-1 w-100 bg-200"
            >
                <span t-out="this.errorMessage"/>
            </div>

            <!-- Mobile infos -->
            <div t-if="this.selectedLocation" class="d-flex d-md-none flex-column gap-1 p-3">
                <strong t-out="this.selectedLocation.name"/>
                <small class="text-muted">
                    <t t-out="this.selectedLocation.street"/>, <t t-out="this.getCityAndZipCode(this.selectedLocation)"/>
                </small>
                <div t-if="this.hasOpeningHours" class="mt-1 rounded bg-light">
                    <t
                        t-call="website_sale_stock.locationSelector.openingHours"
                        collapseId="'map_collapseHours'"
                        openingHours="this.selectedLocation.opening_hours"
                        todayStatus="this.todayStatus"
                    />
                </div>
                <button
                    t-if="!this.props.readonly"
                    type="button"
                    class="btn btn-primary mt-2"
                    t-on-click="this.props.validateSelection"
                >
                    Choose this location
                </button>
            </div>
        </div>
    </t>
</templates>
