<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="website_sale_stock.locationSelector.dialog">
        <Dialog
            title="this.title"
            size="'xl'"
            header="this.state.isSmall or this.hideListView"
            bodyClass="'d-flex flex-column p-0'"
            contentClass="'o_location_selector h-100 overflow-hidden'"
        >
            <!-- Mobile view -->
            <t t-if="this.state.isSmall">
                <!-- Search bar -->
                <div class="p-3 border-bottom">
                    <t t-call="website_sale_stock.locationSelector.searchbar"/>
                </div>

                <!-- "List view / Map view" navigation -->
                <div class="nav nav-tabs">
                    <button
                        class="o_location_selector_mobile_tab btn flex-grow-1 border-0 rounded-0 py-3 bg-transparent"
                        t-att-class="{'border-bottom active': this.state.viewMode === 'list'}"
                        t-on-click="() => this.state.viewMode = 'list'"
                    >
                        List view
                    </button>
                    <button
                        class="o_location_selector_mobile_tab btn flex-grow-1 border-0 rounded-0 py-3 bg-transparent"
                        t-att-class="{'border-bottom border-primary fw-bold active' : this.state.viewMode === 'map'}"
                        t-on-click="() => this.state.viewMode = 'map'"
                    >
                        Map view
                    </button>
                </div>

                <!-- Component -->
                <div class="flex-grow-1 overflow-x-auto">
                    <t
                        t-if="this.locations.length"
                        t-component="this.mobileComponent"
                        locations="this.locations"
                        selectedLocationId="this.state.selectedLocationId.toString()"
                        setSelectedLocation.bind="this.setSelectedLocation"
                        validateSelection.bind="this.validateSelection"
                    />
                    <t t-else="" t-call="website_sale_stock.locationSelector.placeholder"/>
                </div>
            </t>

            <!-- Desktop view -->
            <div t-else="" class="d-flex h-100 overflow-hidden">

                <!-- List view -->
                <section
                    id="location_selector_list_view"
                    class="o_location_selector_view col-md-5 col-lg-4 position-relative d-flex flex-column border-end"
                >
                    <div class="d-flex flex-column gap-3 p-4 pb-3">
                        <h1 class="modal-title h5 mb-0" t-out="this.title"/>

                        <!-- Search bar -->
                        <t t-call="website_sale_stock.locationSelector.searchbar"/>
                    </div>

                    <!-- List group -->
                    <LocationList
                        t-if="this.locations.length"
                        locations="this.locations"
                        selectedLocationId="this.state.selectedLocationId.toString()"
                        setSelectedLocation.bind="this.setSelectedLocation"
                        validateSelection.bind="this.validateSelection"
                    />
                    <t t-else="" t-call="website_sale_stock.locationSelector.placeholder"/>
                </section>

                <!-- Map view -->
                <section class="o_location_selector_view position-relative d-flex flex-grow-1">
                    <MapContainer
                        locations="this.locations"
                        selectedLocationId="this.state.selectedLocationId.toString()"
                        setSelectedLocation.bind="this.setSelectedLocation"
                        validateSelection.bind="this.validateSelection"
                    />
                    <div
                        t-if="!this.hideListView"
                        class="position-absolute top-0 end-0 z-1 d-flex m-3 rounded p-2 bg-body shadow-sm"
                    >
                        <button
                            type="button"
                            class="btn-close"
                            title="Close"
                            aria-label="Close"
                            t-on-click="() => this.props.close()"
                        />
                    </div>
                </section>
            </div>

            <!-- Validation button in mobile view -->
            <t t-if="this.state.isSmall" t-set-slot="footer">
                <div class="w-100 m-0 border-top p-3">
                    <button
                        type="button"
                        id="submit_location_small"
                        class="btn btn-primary w-100"
                        t-att-disabled="!this.state.selectedLocationId"
                        t-on-click="this.validateSelection"
                    >
                        Choose this location
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

    <t t-name="website_sale_stock.locationSelector.placeholder">
        <p t-if="this.state.error" class="px-4 py-5 text-center text-muted">No result</p>
        <div t-else="" class="position-absolute top-50 start-50 translate-middle">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </t>

    <t t-name="website_sale_stock.locationSelector.searchbar">
        <div role="search" class="input-group">
            <input
                id="o_location_selector_search"
                class="search-query form-control oe_search_box border-0 text-bg-light"
                t-model.proxy.lazy="this.state.zipCode"
                placeholder="Zip or City"
            />
            <button
                t-on-click="this.debouncedSearchButton"
                aria-label="Search"
                title="Search"
                class="btn btn-light"
            >
                <i class="oi" data-icon="search" role="img" aria-hidden="true"/>
            </button>
        </div>
    </t>
</templates>
