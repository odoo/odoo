<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="tax_report" model="account.report">
        <field name="name">Tax Report</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.li"/>
        <field name="allow_foreign_vat" eval="True"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="tax_report_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_tax_report_line_turnover" model="account.report.line">
                <field name="name">I. TURNOVER</field>
                <field name="name@de">I. UMSATZ</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="account_tax_report_line_litax_200" model="account.report.line">
                        <field name="name">200 - Total amount of agreed or collected consideration incl. from supplies opted for taxation, transfer of supplies acc. to the notification procedure and supplies provided abroad (worldwide turnover)</field>
                        <field name="name@de">200 - Total der vereinbarten bzw. vereinnahmten Entgelte, inkl. optierte Leistungen im Ausland</field>
                        <field name="code">tax_li_200</field>
                        <field name="aggregation_formula">tax_li_303a.balance + tax_li_313a.balance + tax_li_343a.balance + tax_li_205.balance + tax_li_289.balance</field>
                    </record>
                    <record id="account_tax_report_line_litax_205" model="account.report.line">
                        <field name="name">205 - Consideration reported in Ref. 200 from supplies exempt from the tax without credit (art. 21) where the option for their taxation according to art. 22 has been exercised</field>
                        <field name="name@de">205 - In Ziffer 200 enthaltene Entgelte aus von der Steuer ausgenommenen Leistungen (Art. 21), für welche nach Art. 22 optiert wird</field>
                        <field name="code">tax_li_205</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_205_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">205</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_220" model="account.report.line">
                        <field name="name">220 - Supplies exempt from the tax (e.g. export, art. 23) and supplies provided to institutional and individual beneficiaries that are exempt from liability for tax (art. 107 para. 1 lit. a)</field>
                        <field name="name@de">220 - Von der Steuer befreite Leistungen (u.a. Exporte, Art. 23), von der Steuer befreite Leistungen an begünstigte Einrichtungen und Personen (Art. 107 Abs. 1 Bst. a)</field>
                        <field name="code">tax_li_220</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_220_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-220</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_221" model="account.report.line">
                        <field name="name">221 - Supplies provided abroad</field>
                        <field name="name@de">221 - Leistungen im Ausland</field>
                        <field name="code">tax_li_221</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_221_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-221</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_225" model="account.report.line">
                        <field name="name">225 - Transfer of supplies according to the notification procedure (art. 38, please submit Form 764)</field>
                        <field name="name@de">225 - Übertragung im Meldeverfahren (Art. 38)</field>
                        <field name="code">tax_li_225</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_225_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">225</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_230" model="account.report.line">
                        <field name="name">230 - Supplies provided domestically exempt from the tax without credit (art. 21) and where the option for their taxation according to art. 22 has not been exercised</field>
                        <field name="name@de">230 - Von der Steuer ausgenommene Inlandleistungen (Art. 21), für die nicht nach Art. 22 optiert wird</field>
                        <field name="code">tax_li_230</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_230_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-230</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_235" model="account.report.line">
                        <field name="name">235 - Reduction of consideration (discounts, rebates etc.)</field>
                        <field name="name@de">235 - Entgeltsminderungen wie Skonti, Rabatte usw.</field>
                        <field name="code">tax_li_235</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_235_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">235</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_280" model="account.report.line">
                        <field name="name">280 - Miscellaneous (e.g. land value, purchase prices in case of margin taxation)</field>
                        <field name="name@de">280 - Diverses (z.B. Wert des Bodens, Ankaufspreise Margenbesteuerung)</field>
                        <field name="code">tax_li_280</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_280_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">280</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_289" model="account.report.line">
                        <field name="name">289 - Deductions (Total Ref. 220 to 280)</field>
                        <field name="name@de">289 - Abzüge (Total Ziff. 220 bis 280)</field>
                        <field name="code">tax_li_289</field>
                        <field name="aggregation_formula">tax_li_220.balance + tax_li_221.balance + tax_li_225.balance + tax_li_230.balance + tax_li_235.balance + tax_li_280.balance</field>
                    </record>
                    <record id="account_tax_report_line_litax_299" model="account.report.line">
                        <field name="name">299 - Taxable turnover (Ref. 200 minus Ref. 289)</field>
                        <field name="name@de">299 - Steuerbarer Gesamtumsatz (Ziff. 200 abzüglich Ziff. 289)</field>
                        <field name="aggregation_formula">tax_li_200.balance - tax_li_289.balance</field>
                    </record>
                </field>
            </record>
            <record id="account_tax_report_line_tax_calculation" model="account.report.line">
                <field name="name">II. TAX CALCULATION</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="account_tax_report_line_supplies" model="account.report.line">
                        <field name="name">Supplies CHF</field>
                        <field name="name@de">Leistungen CHF</field>
                        <field name="children_ids">
                            <record id="account_tax_report_line_litax_303a" model="account.report.line">
                                <field name="name">303a - Standard rate (8,1%): Supplies CHF</field>
                                <field name="name@de">303a - Normalsatz (8.1%): Leistungen CHF</field>
                                <field name="code">tax_li_303a</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_303a_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-303a</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_tax_report_line_litax_313a" model="account.report.line">
                                <field name="name">313a - Reduced rate (2,6%): Supplies CHF</field>
                                <field name="name@de">313a - Reduzierter Satz (2.6%): Leistungen CHF</field>
                                <field name="code">tax_li_313a</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_313a_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-313a</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_tax_report_line_litax_343a" model="account.report.line">
                                <field name="name">343a - Accommodation rate (3,8%): Supplies CHF</field>
                                <field name="name@de">343a - Beherbergungssatz (3.8%): Leistungen CHF</field>
                                <field name="code">tax_li_343a</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_343a_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-343a</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_tax_report_line_litax_383a" model="account.report.line">
                                <field name="name">383a - Acquisition tax: Supplies CHF</field>
                                <field name="name@de">383a - Bezugsteuersatz: Leistungen CHF</field>
                                <field name="code">tax_li_383a</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_383a_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">383a</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_tax_amount" model="account.report.line">
                        <field name="name">Tax amount CHF / cent.</field>
                        <field name="name@de">Steuer CHF / Rp.</field>
                        <field name="children_ids">
                            <record id="account_tax_report_line_litax_303b" model="account.report.line">
                                <field name="name">303b - Standard rate (8,1%): Tax amount CHF / cent.</field>
                                <field name="name@de">303b - Normalsatz (8.1%): Steuer CHF / Rp.</field>
                                <field name="code">tax_li_303b</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_303b_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-303b</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_tax_report_line_litax_313b" model="account.report.line">
                                <field name="name">313b - Reduced rate (2,6%): Tax amount CHF / cent.</field>
                                <field name="name@de">313b - Reduzierter Satz (2.6%): Steuer CHF / Rp.</field>
                                <field name="code">tax_li_313b</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_313b_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-313b</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_tax_report_line_litax_343b" model="account.report.line">
                                <field name="name">343b - Accommodation rate (3,8%): Tax amount CHF / cent.</field>
                                <field name="name@de">343b - Beherbergungssatz (3.8%): Steuer CHF / Rp.</field>
                                <field name="code">tax_li_343b</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_343b_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-343b</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_tax_report_line_litax_383b" model="account.report.line">
                                <field name="name">383b - Acquisition tax: Tax amount CHF / cent.</field>
                                <field name="name@de">383b - Bezugsteuersatz: Steuer CHF / Rp.</field>
                                <field name="code">tax_li_383b</field>
                                <field name="expression_ids">
                                    <record id="account_tax_report_line_litax_383b_tag" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-383b</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_399" model="account.report.line">
                        <field name="name">399 - Total amount of tax due</field>
                        <field name="name@de">399 - Total geschuldete Steuer</field>
                        <field name="code">tax_li_399</field>
                        <field name="aggregation_formula">tax_li_303b.balance + tax_li_313b.balance + tax_li_343b.balance + tax_li_383b.balance</field>
                    </record>
                    <record id="account_tax_report_line_litax_400" model="account.report.line">
                        <field name="name">400 - Input tax on cost of materials and supplies of services</field>
                        <field name="name@de">400 - Vorsteuer auf Material- und Dienstleistungsaufwand</field>
                        <field name="code">tax_li_400</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_400_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">400</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_405" model="account.report.line">
                        <field name="name">405 - Input tax on investments and other operating costs</field>
                        <field name="name@de">405 - Vorsteuer auf Investitionen und übrigem Betriebsaufwand</field>
                        <field name="code">tax_li_405</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_405_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">405</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_410" model="account.report.line">
                        <field name="name">410 - De-taxation (art. 32)</field>
                        <field name="name@de">410 - Einlageentsteuerung (Art. 32)</field>
                        <field name="code">tax_li_410</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_410_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">410</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_415" model="account.report.line">
                        <field name="name">415 - Correction of the input tax deduction: mixed use (art. 30), own use (art. 31)</field>
                        <field name="name@de">415 - Vorsteuerkorrekturen: gemischte Verwendung (Art. 30), Eigenverbrauch (Art. 31)</field>
                        <field name="code">tax_li_415</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_415_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-415</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_420" model="account.report.line">
                        <field name="name">420 - Reduction of the input tax deduction: Flow of funds, which are not deemed to be consideration, such as subsidies, tourist charges (art. 33 para. 2)</field>
                        <field name="name@de">420 - Vorsteuerkürzungen: Nicht-Entgelte wie Subventionen, Tourismusabgaben (Art. 33 Abs. 2)</field>
                        <field name="code">tax_li_420</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_420_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-420</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_479" model="account.report.line">
                        <field name="name">479 - Total Ref. 400 to 420</field>
                        <field name="name@de">479 - Total Ziff. 400 bis 420</field>
                        <field name="code">tax_li_479</field>
                        <field name="aggregation_formula">tax_li_400.balance + tax_li_405.balance + tax_li_410.balance - tax_li_415.balance - tax_li_420.balance</field>
                    </record>
                    <record id="account_tax_report_line_litax_500" model="account.report.line">
                        <field name="name">500 - Amount payable</field>
                        <field name="name@de">500 - Zu bezahlender Betrag</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_500_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">tax_li_399.balance - tax_li_479.balance</field>
                                <field name="subformula">if_above(CHF(0))</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_510" model="account.report.line">
                        <field name="name">510 - Credit in favour of the taxable person</field>
                        <field name="name@de">510 - Guthaben der steuerpflichtigen Person</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_510_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">tax_li_479.balance - tax_li_399.balance</field>
                                <field name="subformula">if_above(CHF(0))</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_tax_report_line_other_cash_flows" model="account.report.line">
                <field name="name">III. OTHER CASH FLOWS</field>
                <field name="name@de">III. ANDERE MITTELFLÜSSE</field>
                <field name="hierarchy_level">0</field>
                <field name="aggregation_formula">tax_li_900.balance + tax_li_910.balance</field>
                <field name="children_ids">
                    <record id="account_tax_report_line_litax_900" model="account.report.line">
                        <field name="name">900 - Subsidies, tourist funds collected by tourist offices, contributions from cantonal water, sewage or waste funds (art. 18 para. 2 lit. a to c)</field>
                        <field name="name@de">900 - Subventionen, durch Kurvereine eingenommene Tourismusabgaben, Entsorgungs- und Wasserwerkbeiträge (Bst. a-c)</field>
                        <field name="code">tax_li_900</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_900_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-900</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_tax_report_line_litax_910" model="account.report.line">
                        <field name="name">910 - Donations, dividends, payments of damages etc. (art. 18 para. 2 lit. d to l)</field>
                        <field name="name@de">910 - Spenden, Dividenden, Schadenersatz usw.</field>
                        <field name="code">tax_li_910</field>
                        <field name="expression_ids">
                            <record id="account_tax_report_line_litax_910_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-910</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
