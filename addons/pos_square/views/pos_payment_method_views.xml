<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_square" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.square</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider != 'square'">
                    <page name="settings" string="Square">
                        <group>
                            <field name="square_application_id" invisible="payment_provider != 'square'" required="payment_provider == 'square'"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
