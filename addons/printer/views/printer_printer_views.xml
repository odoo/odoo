<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="printer_printer_view_list" model="ir.ui.view">
        <field name="name">printer.printer.view.list</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="address"/>
                <field name="report_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="printer_printer_view_form" model="ir.ui.view">
        <field name="name">printer.printer.view.form</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Packing station"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="address" placeholder="e.g. 192.168.1.20 or zebra-1.local:8080"/>
                        </group>
                        <group>
                            <field name="report_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="printer_printer_view_search" model="ir.ui.view">
        <field name="name">printer.printer.view.search</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="address"/>
                <field name="report_ids"/>
                <filter name="kind_zpl" string="ZPL" domain="[('kind', '=', 'zpl')]"/>
                <filter name="kind_epos" string="ePOS" domain="[('kind', '=', 'epos')]"/>
                <group>
                    <filter name="group_by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="printer_printer_action" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">printer.printer</field>
        <field name="path">printers</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a printer of the local network
            </p>
            <p>
                Reports linked to a printer are sent to it from the browser when they are printed.
            </p>
        </field>
    </record>

    <record id="printer_reset_linked_printers_action" model="ir.actions.client">
        <field name="name">Reset Linked Printers</field>
        <field name="tag">printer.reset_linked_printers</field>
        <field name="path">reset-linked-printers</field>
    </record>

</odoo>
