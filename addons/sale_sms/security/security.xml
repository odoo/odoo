<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_rule_sms_template_so_sale_manager" model="ir.rule">
        <field name="name">SMS Template: sale manager CUD on sale orders</field>
        <field name="model_id" ref="sms.model_sms_template" />
        <field
            name="domain_force">[('model_id.model', 'in', ('sale.order', 'res.partner'))]</field>
        <field name="groups" eval="[Command.link(ref('sale.group_sale_manager'))]" />
        <field name="perm_read" eval="False" />
    </record>

</odoo>
