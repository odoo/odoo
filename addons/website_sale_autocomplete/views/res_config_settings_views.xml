<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_autocomplete_googleplaces" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.autocomplete.googleplaces</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='autocomplete_googleplaces_setting']" position="inside">
                <div>
                    <div class="content-group row mt16">
                        <label class="col-4" for="website_google_places_api_key" string="API Key"/>
                        <field class="col-6" name="website_google_places_api_key"/>
                    </div>
                    <div class="mt8" invisible="website_google_places_use_api_new">
                        <a target="_blank" href="https://console.cloud.google.com/getting-started">
                            <i class="oi oi-arrow-right"/>
                            Create a Google Project and get a key
                        </a>
                        <br/>
                        <a target="_blank" href="https://console.cloud.google.com/billing">
                            <i class="oi oi-arrow-right"/>
                            Enable billing on your Google Project
                        </a>
                    </div>
                    <div class="mt8" invisible="not website_google_places_use_api_new">
                        <a target="_blank" href="https://developers.google.com/maps/documentation/places/web-service/cloud-setup">
                            <i class="oi oi-arrow-right"/>
                            Set up a Google Project for the Places API (New)
                        </a>
                        <br/>
                        <a target="_blank" href="https://console.cloud.google.com/apis/library/places.googleapis.com">
                            <i class="oi oi-arrow-right"/>
                            Enable the Places API (New) on your Google Project
                        </a>
                        <br/>
                        <a target="_blank" href="https://developers.google.com/maps/documentation/places/web-service/get-api-key">
                            <i class="oi oi-arrow-right"/>
                            Get an API key
                        </a>
                        <br/>
                        <a target="_blank" href="https://console.cloud.google.com/billing">
                            <i class="oi oi-arrow-right"/>
                            Enable billing on your Google Project
                        </a>
                    </div>
                    <div class="alert alert-warning mt16 mb-0" role="alert" invisible="website_google_places_use_api_new or not website_id" groups="base.group_system">
                        This API is deprecated.
                        <button name="action_website_google_places_switch_to_api_new" type="object"
                                class="btn btn-link p-0 align-baseline" string="Switch to the new one"/>
                        (irreversible, change the API key afterwards to the new one)
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
