<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_my_home_menu_purchase" name="Portal layout : purchase menu entries" inherit_id="portal.portal_breadcrumbs" priority="25">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li t-if="page_name == 'rfq' or order and order.state == 'sent'" t-attf-class="breadcrumb-item #{'active ' if not order else ''}">
        <a t-if="order" t-attf-href="/my/rfq?{{ keep_query() }}">Requests for Quotation</a>
        <t t-else="">Requests for Quotation</t>
      </li>
      <li t-if="page_name == 'purchase' or order and order.state != 'sent'" t-attf-class="breadcrumb-item #{'active ' if not order else ''}">
        <a t-if="order" t-attf-href="/my/purchase?{{ keep_query() }}">Purchase Orders</a>
        <t t-else="">Purchase Orders</t>
      </li>
      <li t-if="order" class="breadcrumb-item active">
        <t t-out="order.name"/>
      </li>
    </xpath>
  </template>

  <template id="portal_my_purchase_rfqs" name="My Requests For Quotation">
      <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">

          <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Requests For Quotation"/>
          <t t-if="not rfqs">
              <p class="alert alert-warning">There are currently no requests for quotation for your account.</p>
          </t>
          <t t-if="rfqs" t-call="portal.portal_table">
              <thead>
                  <tr class="active">
                    <th>
                        <span class='d-none d-md-inline'>Request for Quotation #</span>
                        <span class='d-block d-md-none'>Ref.</span>
                    </th>
                      <th class="text-end">Order Deadline</th>
                  </tr>
              </thead>
              <t t-foreach="rfqs" t-as="rfq">
                  <tr>
                      <td><a t-att-href="rfq.get_portal_url()"><t t-out="rfq.name"/></a></td>
                      <td class="text-end">
                          <span t-field="rfq.date_order" t-options="{'widget': 'date'}"/>&amp;nbsp;
                          <span class='d-none d-md-inline' t-field="rfq.date_order" t-options="{'time_only': True}"/>
                      </td>
                  </tr>
              </t>
          </t>
      </t>
  </template>

  <template id="portal_my_purchase_orders" name="My Purchase Orders">
      <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">

          <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True" title.translate="Purchase Orders"/>
          <t t-if="not orders">
              <p class="alert alert-warning">There are currently no purchase orders for your account.</p>
          </t>
          <t t-if="orders" t-call="portal.portal_table">
              <thead>
                  <tr class="active">
                      <th id="order_name_header">
                          <span class='d-none d-md-inline'>Purchase Order #</span>
                          <span class='d-block d-md-none'>Ref.</span>
                      </th>
                      <th id="order_confirmation_header" class="text-end">
                          <span class='d-none d-md-inline'>Confirmation Date</span>
                          <span class='d-block d-md-none'>Confirmation</span>
                      </th>
                      <th id="order_badge_header" class="text-center"/>
                      <th id="order_total_header" class="text-end">Total</th>
                  </tr>
              </thead>
              <t t-foreach="orders" t-as="order">
                  <tr>
                      <td id="order_name"><a t-att-href="order.get_portal_url()"><t t-out="order.name"/></a></td>
                      <td id="order_confirmation" class="text-end">
                          <span t-field="order.date_approve" t-options="{'widget': 'date'}"/>&amp;nbsp;
                          <span class='d-none d-md-inline' t-field="order.date_approve" t-options="{'time_only': True}"/>
                      </td>
                      <td id="order_badge" class="text-center">
                          <span t-if="order.invoice_status == 'to invoice'" class="badge rounded-pill text-bg-info">
                              <i class="oi oi-fw oi-filled" data-icon="article" role="img" aria-label="Waiting for Bill" title="Waiting for Bill"></i><span class="d-none d-md-inline"> Waiting for Bill</span>
                          </span>
                          <span t-if="order.state == 'cancel'" class="badge rounded-pill text-bg-secondary">
                              <i class="oi oi-fw" data-icon="close" role="img" aria-label="Cancelled" title="Cancelled"></i><span class="d-none d-md-inline"> Cancelled</span>
                          </span>
                      </td>
                      <td id="order_total" class="text-end"><span t-field="order.amount_total"/></td>
                  </tr>
              </t>
          </t>
      </t>
  </template>

  <template id="portal_my_purchase_order" name="Purchase Order" inherit_id="portal.portal_sidebar" primary="True">
      <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
          <t t-set="o_portal_fullwidth_alert" groups="purchase.group_purchase_manager">
              <t t-call="portal.portal_back_in_edit_mode"
                  backend_url="'/odoo/action-purchase.purchase_rfq/%s' % (order.id)"/>
          </t>

          <div class="row o_portal_purchase_sidebar">
              <t t-set="invoices" t-value="[i for i in order.invoice_ids if i.state not in ['draft', 'cancel']]"/>

              <!-- Sidebar -->
              <t t-set="title" t-value="None"/>
              <t t-set="subtitle" t-value="None"/>
              <!-- RFQ prices are hidden from the vendor -->
              <t t-if="order.state == 'purchase'">
                  <t t-set="title">
                      <h2 t-field="order.amount_total" class="mb-0 text-break"/>
                  </t>
                  <t t-set="subtitle">Tax Included</t>
              </t>
              <t t-set="entries">
                  <div class="d-none d-lg-flex flex-column mt-3">
                      <div class="d-flex flex-column gap-2" id="purchase_order_sidebar_button">
                          <a class="btn btn-light o_print_btn o_portal_invoice_print" t-att-href="order.get_portal_url(report_type='pdf')" id="print_invoice_report" title="Download" role="button" target="_blank">Download</a>
                          <button t-if="order._get_edi_builders()" id="portal_connect_software_modal_btn" type="button" class="btn btn-light"
                              data-bs-toggle="modal" data-bs-target="#portal_connect_software_modal">
                              Connect with your software!
                          </button>
                      </div>

                      <div t-if="invoices" id="sidebar_invoices" class="d-flex flex-column gap-1 overflow-hidden">
                          <hr/>
                          <strong class="smaller text-uppercase text-muted">Invoices</strong>
                          <div class="d-flex flex-column gap-1">
                              <t t-foreach="invoices" t-as="i">
                                  <t t-call="purchase.purchase_order_portal_invoice"/>
                              </t>
                          </div>
                      </div>

                      <div t-if="order.user_id">
                          <t t-call="portal.portal_my_contact"
                              _contact_avatar="image_data_uri(order.user_id.avatar_128)"
                              _contact_name="order.user_id.name"
                              _contact_link="True">
                              <div t-field="order.user_id" t-options='{"widget": "contact", "fields": ["phone"], "no_marker": False}' class="small mt-2"/>
                          </t>
                      </div>
                  </div>
              </t>
              <t t-call="portal.portal_record_sidebar"
                  classes.f="col-lg-4 col-xl-3 d-none d-lg-block d-print-none order-lg-first"
                  title="title"
                  subtitle="subtitle"
                  entries="entries"/>

              <div class="modal fade" id="portal_connect_software_modal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-body">
                            <div>
                                <h5>Want to import this document in Odoo?</h5>
                                <p>Drag and drop the request for quotation PDF file into your list of quotations in Odoo. Enjoy the automation!</p>
                            </div>
                            <div>
                                <h5>Not using Odoo?</h5>
                                <div class="input-group mb-3 w-50">
                                    <t t-set="base_address" t-value="order.env['ir.config_parameter'].sudo().get_str('web.base.url')"/>
                                    <t t-set="doc_url" t-value="base_address + '/my/purchase/' + str(order.id) + '/download_edi?' + str(keep_query())"/>
                                    <input type="text" class="form-control" aria-describedby="copy-button" readonly="readonly" t-att-value="doc_url"/>
                                    <button class="btn btn-outline-secondary" type="button" id="copy-button"
                                    t-attf-onclick="navigator.clipboard.writeText('#{doc_url}')">Copy</button>
                                </div>
                                <p>Use the above REST URL to get structured data of the purchase order in UBL format.
                                    <a href="https://www.odoo.com/documentation/">Read the documentation </a>to learn all the ways to connect your software with <a href="https://www.odoo.com">Odoo</a>.
                                </p>
                            </div>
                            <div>
                                <h5>You don't use a good CRM software?</h5>
                                <p><a href="https://www.odoo.com/app/sales">Start on Odoo</a>, it's 100% free! You'll save time creating beautiful quotations and track sales.</p>
                            </div>
                        </div>
                        <div class="modal-footer justify-content-between">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
              </div>

              <!-- Page content -->
              <div id="quote_content" class="col-12 col-lg-8 col-xl-9 mt-0">
                  <div t-if="order.state == 'cancel'" class="alert alert-danger d-print-none" role="alert">
                      <strong>This order has been cancelled.</strong>
                  </div>

                  <!-- main content -->
                  <div id="portal_purchase_content">
                      <div><t t-call="purchase.purchase_order_portal_content"/></div>
                  </div>

                  <!-- Mobile Invoices -->
                  <div t-if="invoices" class="d-lg-none mt-4 p-3 rounded-3 border d-print-none">
                      <h4>Invoices</h4>
                      <div class="d-flex flex-column gap-2 mt-2">
                          <t t-foreach="invoices" t-as="i">
                              <t t-call="purchase.purchase_order_portal_invoice"/>
                          </t>
                      </div>
                  </div>

                  <!-- chatter -->
                  <div id="purchase_order_communication" class="mt-4 p-3 p-lg-4 rounded-3 border">
                      <h4 class="pb-1">Communication History</h4>
                      <t t-call="portal.message_thread" hide_header="True"/>
                  </div>
              </div><!-- // #quote_content -->
          </div>
      </xpath>
  </template>

  <template id="purchase_order_portal_invoice" name="Purchase Order Portal Invoice">
      <div class="d-flex flex-wrap align-items-center column-gap-2">
          <a t-att-href="i.get_portal_url(report_type='pdf', download=True)" t-out="i.name"/>
          <small class="text-muted" t-field="i.invoice_date"/>
          <span t-if="i.payment_state in ('paid', 'in_payment')" class="ms-auto badge rounded-pill text-bg-success"><i class="oi oi-fw" data-icon="check" aria-hidden="true"/>Paid</span>
          <span t-elif="i.payment_state == 'reversed'" class="ms-auto badge rounded-pill text-bg-success"><i class="oi oi-fw" data-icon="check" aria-hidden="true"/>Reversed</span>
          <span t-else="" class="ms-auto badge rounded-pill text-bg-primary"><i class="oi oi-fw" data-icon="schedule" aria-hidden="true"/>Waiting Payment</span>
      </div>
  </template>

  <template id="purchase_order_portal_content" name="Purchase Order Portal Content">
      <t t-set="display_price_and_taxes" t-value="not update_dates and order.state == 'purchase'"/>
      <t t-set="lines_to_report" t-value="order.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)"/>
      <t t-set="display_discount" t-value="display_price_and_taxes and any(line.discount for line in lines_to_report)"/>
      <t t-set="display_taxes" t-value="display_price_and_taxes and any(line.tax_ids for line in lines_to_report)"/>

      <!-- Intro -->
      <div id="introduction" class="p-3 p-lg-4 bg-100 border rounded-top">
          <div class="d-flex gap-2">
              <div class="d-flex flex-column me-auto min-w-0">
                  <small>
                      <span class="text-muted">
                          <t t-if="order.state in ['draft', 'sent']">Request for Quotation from</t>
                          <t t-else="">Purchase Order from</t>
                      </span>
                      <b t-out="order.company_id.name"/>
                  </small>
                  <h2 class="mb-0" t-out="order.name"/>
                  <div id="po_date" class="d-flex align-items-center gap-1 text-muted small flex-wrap">
                      <span t-out="order.date_approve or order.date_order" t-options='{"widget": "date"}'/>
                      <t t-if="order.date_planned">
                          <span>·</span>
                          <span>Expected arrival <span t-field="order.date_planned" t-options='{"widget": "date"}'/></span>
                      </t>
                      <t t-if="order.partner_ref">
                          <span>·</span>
                          <span>Ref: <span t-field="order.partner_ref"/></span>
                      </t>
                      <t t-if="order.incoterm_id">
                          <span>·</span>
                          <span t-field="order.incoterm_id.code"/>
                          <span t-if="order.incoterm_location" t-field="order.incoterm_location"/>
                      </t>
                  </div>
              </div>
              <div class="d-lg-none flex-shrink-0">
                  <a class="btn btn-secondary o_print_btn o_portal_invoice_print"
                      t-att-href="order.get_portal_url(report_type='pdf')"
                      title="Download"
                      aria-label="Download"
                      role="button"
                      target="_blank">
                      <i class="oi" data-icon="download" aria-hidden="true"/>
                  </a>
              </div>
          </div>
          <div t-if="order.user_id" class="d-lg-none" name="portal_purchase_buyer">
              <hr class="my-3 mx-n3"/>
              <div class="small">
                  <div class="text-muted">Buyer</div>
                  <div class="fw-medium" t-out="order.user_id.name"/>
              </div>
          </div>
          <div t-if="order._get_edi_builders()" class="d-flex d-lg-none flex-wrap gap-2 mt-3">
              <button type="button" class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#portal_connect_software_modal"><i class="oi me-1" data-icon="link" aria-hidden="true"/>Connect with your software!</button>
          </div>
      </div>

      <div id="content">
          <section id="details" class="p-0 p-lg-3 pt-lg-0 rounded-bottom border-start border-end border-bottom" style="page-break-inside: auto;">
              <!-- ===== MOBILE VIEW ===== -->
              <div class="d-lg-none">
                  <t t-foreach="lines_to_report" t-as="line">
                      <div t-if="line.display_type in ('line_section', 'line_subsection')"
                          t-attf-class="d-flex justify-content-between align-items-center py-2 px-3 fw-bold border-bottom {{ 'bg-200' if line.display_type == 'line_section' else 'bg-100' }}">
                          <span t-field="line.name"/>
                          <span t-if="display_price_and_taxes" class="text-nowrap ms-2"
                              t-out="line._get_section_totals()"
                              t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                      </div>
                      <div t-elif="line.display_type == 'line_note'" class="fst-italic py-2 px-3 border-bottom text-muted small">
                          <span t-field="line.name"/>
                      </div>
                      <div t-else="" class="py-3 px-3 border-bottom">
                          <t t-set="label_parts" t-value="(line.label or '').split('\n', 1)"/>
                          <div class="d-flex justify-content-between align-items-start gap-2">
                              <span t-out="label_parts[0]"/>
                              <span t-if="display_price_and_taxes" class="text-nowrap" t-field="line.price_subtotal"/>
                          </div>
                          <span t-if="len(label_parts) > 1" class="o_purchase_portal_line_description d-block text-muted small mt-1" t-out="label_parts[1]"/>
                          <div class="d-flex flex-wrap align-items-baseline gap-1 mt-1 small text-muted">
                              <span>
                                  <span t-field="line.product_qty" t-options="{'min_precision': 0}"/>
                                  <span class="ms-1" t-field="line.uom_id" groups="uom.group_uom"/>
                              </span>
                              <t t-if="display_price_and_taxes and line.price_unit">
                                  <span>×</span>
                                  <span t-if="line.discount" t-field="line.price_unit_discounted" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                  <span t-field="line.price_unit"
                                      t-att-class="line.discount and 'text-decoration-line-through text-muted' or None"
                                      t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                  <span t-if="line.discount" class="small text-success fw-medium">
                                      (−<t t-out="((line.discount % 1) and '%s' or '%d') % line.discount"/>%)
                                  </span>
                              </t>
                          </div>
                          <div t-if="display_taxes and line.tax_ids" class="mt-1 small text-muted">
                              <span>Tax:</span>
                              <span t-out="', '.join(line.tax_ids.mapped('tax_label'))"/>
                          </div>
                          <div t-if="update_dates" class="mt-2">
                              <label class="form-label small text-muted" t-attf-for="date_planned_m_#{line.id}">Scheduled Date</label>
                              <input type="text" t-attf-id="date_planned_m_#{line.id}"
                                  class="form-control datetimepicker-input o-purchase-datetimepicker"
                                  t-att-data-access-token="order.access_token"
                                  t-att-data-order-id="order.id"
                                  t-att-data-line-id="line.id"
                                  t-att-data-value="line.date_planned.isoformat()"/>
                          </div>
                      </div>
                  </t>
              </div>

              <!-- ===== DESKTOP TABLE ===== -->
              <div class="table-responsive d-none d-lg-block">
                  <table t-att-data-order-id="order.id" t-att-data-token="order.access_token" class="table align-middle" id="purchase_order_table">
                      <thead t-if="display_price_and_taxes or update_dates">
                          <tr>
                              <th class="text-start" aria-label="Description"/>
                              <th class="text-end" aria-label="Quantity"/>
                              <th t-if="update_dates" class="text-end">Scheduled Date</th>
                              <th t-if="display_discount" class="text-end">Discount</th>
                              <th t-if="display_price_and_taxes" class="text-end text-nowrap">Unit Price</th>
                              <th t-if="display_taxes" class="text-end">Taxes</th>
                              <th t-if="display_price_and_taxes" class="text-end">Amount</th>
                          </tr>
                      </thead>
                      <tbody class="purchase_tbody">
                          <t t-foreach="lines_to_report" t-as="line">
                              <tr t-if="line.display_type in ('line_section', 'line_subsection')"
                                  t-attf-class="{{ 'o_line_section bg-200' if line.display_type == 'line_section' else 'o_line_subsection bg-100' }} fw-bold">
                                  <td colspan="99" t-if="not display_price_and_taxes">
                                      <span t-field="line.name"/>
                                  </td>
                                  <t t-else="">
                                      <td t-att-colspan="3 + (1 if display_discount else 0) + (1 if display_taxes else 0)">
                                          <span t-field="line.name"/>
                                      </td>
                                      <td class="text-end">
                                          <span class="text-nowrap" t-out="line._get_section_totals()"
                                              t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                      </td>
                                  </t>
                              </tr>
                              <tr t-elif="line.display_type == 'line_note'" class="fst-italic o_line_note">
                                  <td colspan="99">
                                      <span t-field="line.name"/>
                                  </td>
                              </tr>
                              <tr t-else="">
                                  <td id="product_name">
                                      <div class="d-flex align-items-center">
                                          <img t-if="line.product_id.image_128" t-att-src="image_data_uri(line.product_id.image_128)"
                                              t-att-alt="line.product_id.display_name" class="o_purchase_portal_product_image me-2 rounded object-fit-cover"/>
                                          <div>
                                              <t t-set="label_parts" t-value="(line.label or '').split('\n', 1)"/>
                                              <span t-out="label_parts[0]"/>
                                              <span t-if="len(label_parts) > 1" class="o_purchase_portal_line_description d-block text-muted small" t-out="label_parts[1]"/>
                                          </div>
                                      </div>
                                  </td>
                                  <td class="text-end text-nowrap">
                                      <span t-field="line.product_qty" t-options="{'min_precision': 0}"/>
                                      <span t-field="line.uom_id" groups="uom.group_uom"/>
                                  </td>
                                  <td t-if="update_dates" class="text-end">
                                      <input type="text"
                                          class="form-control datetimepicker-input o-purchase-datetimepicker text-end"
                                          t-att-data-access-token="order.access_token"
                                          t-att-data-order-id="order.id"
                                          t-att-data-line-id="line.id"
                                          t-att-data-value="line.date_planned.isoformat()"
                                          aria-label="Scheduled Date"/>
                                  </td>
                                  <td t-if="display_discount" class="text-end">
                                      <span t-if="line.discount" class="badge text-bg-success">
                                          <t t-out="((line.discount % 1) and '%s' or '%d') % line.discount"/> %
                                      </span>
                                  </td>
                                  <td t-if="display_price_and_taxes" class="text-end text-nowrap">
                                      <span t-field="line.price_unit"
                                          t-att-class="line.discount and 'text-decoration-line-through text-muted' or None"
                                          t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                      <span t-if="line.discount" class="ms-2" t-field="line.price_unit_discounted"
                                          t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                  </td>
                                  <td t-if="display_taxes" class="text-end">
                                      <span t-foreach="line.tax_ids" t-as="tax" class="badge text-bg-secondary me-1" t-out="tax.tax_label"/>
                                  </td>
                                  <td t-if="display_price_and_taxes" class="text-end">
                                      <span class="oe_order_line_price_subtotal" t-field="line.price_subtotal"/>
                                  </td>
                              </tr>
                          </t>
                      </tbody>
                  </table>
              </div>

              <div id="total" t-if="order.state == 'purchase'" name="total" class="mb-0 mb-lg-5" style="page-break-inside: avoid;">
                  <div class="col-md-5 ms-auto">
                      <t t-call="purchase.purchase_order_portal_content_totals_table"/>
                  </div>
              </div>

              <div t-if="not is_html_empty(order.note) or order.payment_term_id" id="terms" class="px-3 px-lg-2 my-3">
                  <div t-if="not is_html_empty(order.note)">
                      <span t-field="order.note"/>
                  </div>
                  <div t-if="order.payment_term_id">
                      <span t-field="order.payment_term_id.note"/>
                  </div>
              </div>
          </section>

          <section id="purchase_addresses" class="p-3 p-lg-4 mt-4 rounded-3 border">
              <div class="row">
                  <div class="col-12 col-lg-6">
                      <div class="mb-2">
                          <span class="badge text-bg-info">Billing</span>
                      </div>
                      <div t-field="order.company_id.partner_id"
                          t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                  </div>
                  <div t-if="order.dest_address_id" class="col-12 col-lg-6 mt-3 mt-lg-0">
                      <div class="mb-2">
                          <span class="badge text-bg-info">Delivery</span>
                      </div>
                      <div t-field="order.dest_address_id"
                          t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'/>
                  </div>
              </div>
          </section>
      </div>
  </template>

  <template id="purchase_order_portal_content_totals_table">
      <table class="table mb-0">
          <t t-call="purchase.document_tax_totals"
              tax_totals="order.tax_totals"
              currency="order.currency_id"/>
      </table>
  </template>

  <template id="portal_my_purchase_order_update_date" name="Portal: My Purchase Order Update Dates" inherit_id="purchase.portal_my_purchase_order" primary="True">
    <xpath expr="////div[@id='portal_purchase_content']" position="replace">
      <div id="portal_purchase_content">
        <t t-set="update_dates" t-value="True"/>
        <div><t t-call="purchase.purchase_order_portal_content"/></div>
      </div>
    </xpath>
  </template>

</odoo>
