#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
#, python-format
msgid "Returns the account codes of a given group."
msgstr "Връща кодовете на сметките от дадена група."

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
#, python-format
msgid ""
"Returns the ending date of the fiscal year encompassing the provided date."
msgstr ""
"Връща крайната дата на финансовата година, обхващаща предоставената дата."

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
#, python-format
msgid ""
"Returns the starting date of the fiscal year encompassing the provided date."
msgstr ""
"Връща началната дата на финансовата година, обхващаща предоставената дата."

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/index.js:0
#, python-format
msgid "See records"
msgstr "Виж записите"

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
#, python-format
msgid "Set to TRUE to include unposted entries."
msgstr "Задайте на TRUE, за да включите непубликуваните записи."

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_datasource.js:0
