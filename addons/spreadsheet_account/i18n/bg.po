#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
#, python-format
msgid ""
"The date range. Supported formats are \"21/12/2022\", \"Q1/2022\", "
"\"12/2022\", and \"2022\"."
msgstr ""
"Период от дати. Поддържаните формати са \"21/12/2022\", \"Q1/2022\", \"12/"
"2022\" и \"2022\"."

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
#, python-format
msgid "The day from which to extract the fiscal year end."
msgstr "Денят, от който да се извлече краят на финансовата година."

#. module: spreadsheet_account
#. odoo-javascript
#: code:addons/spreadsheet_account/static/src/accounting_functions.js:0
