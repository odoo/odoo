<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='partner_id']]" position="after">
                <field name="l10n_sg_statutory_board_subbusiness_unit"
                    invisible="not l10n_sg_partner_is_statutory_board"
                    options="{'no_create': True}"
                />
            </xpath>

            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="domain">[('id', 'in', l10n_sg_allowed_payment_term_ids)]</attribute>
            </xpath>

            <xpath expr="//list[@name='journal_items']/field[@name='product_id']" position="before">
                <field name="l10n_sg_b2g_invoice_line_no" string="Invoice Line Number" optional="hide"/>
            </xpath>

            <xpath expr="//group[@name='sale_info_group']/field[@name='ref']" position="replace">
                <div class="d-flex">
                    <field name="ref" />
                    <div class="col-lg-4" invisible="not l10n_sg_partner_is_statutory_board">
                        <label for="l10n_sg_is_from_po_invoice" string="PO/II" />
                        <field name="l10n_sg_is_from_po_invoice"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
