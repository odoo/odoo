<odoo>
    <record id="boe_view_form" model="ir.ui.view">
        <field name="name">l10n_in.boe.wizard.view.form</field>
        <field name="model">l10n_in.boe.wizard</field>
        <field name="arch" type="xml">
            <form string="Bill of Entry">
                <sheet>
                    <field name="company_currency_id" invisible="1"/> <!-- for monetary fields -->

                    <group col="2">
                        <group>
                            <field name="move_ids" widget="many2many_tags" string="Reference" readonly="1" />
                            <label for="picking_ids" string="Transfers"/>
                            <div class="o_row">
                                <field name="picking_ids" widget="many2many_tags" options="{'no_create': True}" required="1"/>
                            </div>

                            <label for="currency_id" string="Currency"/>
                            <div name="currency_div" class="w-100">
                                <div class="d-flex gap-1">
                                    <field name="currency_id" class="oe_inline" options="{'no_create': True}"/>
                                </div>
                                <div name="currency_conversion_div" class="d-flex gap-1 text-muted" invisible="currency_id == company_currency_id">
                                    <span>1</span>
                                    <field name="company_currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                                    <span>=</span>
                                    <field name="invoice_currency_rate" digits="[12,6]" style="max-width: 21ch;"/>
                                    <field name="currency_id" readonly="1" options="{'no_open': True}" class="w-auto"/>
                                </div>
                            </div>

                        </group>

                        <group>
                            <field name="l10n_in_shipping_bill_number" string="Bill of Entry Number" required="1"/>
                            <field name="l10n_in_shipping_bill_date" string="Bill of Entry Date" required="1"/>
                            <field name="l10n_in_shipping_port_code_id" required="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="assessable_value"/>
                                    <field name="stock_move_id" column_invisible="1"/> <!-- required for boe_lines creation-->
                                    <field name="quantity"/>
                                    <field name="custom_duty"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="taxable_amount"/>
                                    <field name="tax_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                     <group class="oe_subtotal_footer">
                        <field name="total_custom_duty"/>
                        <field name="total_tax"/>
                        <field name="total_amount"/>
                     </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_on_submit_boe" type="object" class="oe_highlight"/>
                    <button class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
