<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_l10n_in_boe_wizard_multi" model="ir.actions.server">
        <field name="name">Bill of Entry</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_l10n_in_open_boe_wizard()
        </field>
    </record>

    <record id="invoice_form_inherit_l10n_in_boe" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.in.boe</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_l10n_in_open_boe_wizard" string="Bill Of Entry"
                    type="object" class="btn btn-secondary float-end"
                    invisible="move_type != 'in_invoice' or state != 'posted' or l10n_in_gst_treatment != 'overseas'" />
            </xpath>

        </field>
    </record>
</odoo>
