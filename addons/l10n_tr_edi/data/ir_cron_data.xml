<odoo>
    <record id="ir_cron_l10n_tr_edi_fetch_einvoice_purchase_documents" model="ir.cron">
        <field name="name">TR EDI: retrieve new purchase documents</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_l10n_tr_edi_fetch_einvoice_purchase_documents()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=12)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

