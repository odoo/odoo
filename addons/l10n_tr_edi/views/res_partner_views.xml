<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.property.form.inherit.l10n_tr_edi</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_edi_ubl_cii.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_edi_format']" position="after">
                <label for="l10n_tr_edi_customer_status" invisible="invoice_edi_format != 'ubl_tr'"/>
                <div name="l10n_tr_edi_customer_status_div"
                     class="o_row"
                     invisible="invoice_edi_format != 'ubl_tr'">
                    <field name="l10n_tr_edi_customer_status" class="flex-grow-1"/>
                    <button name="action_l10n_tr_edi_verify_customer_status"
                            class="btn btn-secondary"
                            type="object"
                            string="Verify"
                            context="{'retry_existing': True}"
                            help="Verify the partner's GİB status"/>
                </div>
                <label for="l10n_tr_edi_einvoice_alias" invisible="invoice_edi_format != 'ubl_tr' or l10n_tr_edi_customer_status != 'einvoice'"/>
                <div name="l10n_tr_edi_einvoice_alias_div"
                     class="o_row"
                     invisible="invoice_edi_format != 'ubl_tr' or l10n_tr_edi_customer_status != 'einvoice'">
                    <field name="l10n_tr_edi_einvoice_alias" class="flex-grow-1 text-break"/>
                    <button name="action_l10n_tr_edi_select_einvoice_alias"
                            type="object"
                            title="Choose among the aliases the GİB lists"
                            class="oi oe_inline oe_link"
                            data-icon="edit"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_l10n_tr_edi_verify_customer_status" model="ir.actions.server">
        <field name="name">Verify GİB Status</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_l10n_tr_edi_verify_customer_status()
        </field>
    </record>
</odoo>
