<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tr_edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='peppol']" position="after">
                <block title="Türkiye Electronic Integrations" id="l10n_tr_edi_settings" invisible="country_code != 'TR'">
                    <setting id="l10n_tr_edi_provider"
                             string="e-Document Provider"
                             company_dependent="1"
                             help="The integrator that exchanges your e-Invoices, e-Archives and e-Dispatches with the GİB.">
                        <field name="l10n_tr_edi_provider"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
