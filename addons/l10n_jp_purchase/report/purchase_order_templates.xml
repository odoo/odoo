<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document" primary="True">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_hide_zero_decimals" t-value="all(line.price_unit.is_integer() for line in o.order_line if line.display_type or line.product_qty)"/>
            <t t-set="jp_document_date" t-value="o.date_approve or o.date_order"/>
        </xpath>

        <!-- The recipient's name heads the address with its honorific. -->
        <xpath expr="//div[@t-field='o.partner_id']" position="before">
            <t t-call="l10n_jp.recipient_name" partner="o.partner_id"/>
        </xpath>
        <xpath expr="//div[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "phone", "vat"], "no_marker": True, "phone_icons": True}</attribute>
        </xpath>

        <!-- The column drops its decimals only when every unit price in it is whole. -->
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'min_precision': 0} if jp_hide_zero_decimals else {}</attribute>
        </xpath>
    </template>

    <template id="report_purchaseorder" inherit_id="purchase.report_purchaseorder">
        <xpath expr="//t[@t-call='purchase.report_purchaseorder_document']" position="attributes">
            <attribute name="t-if" add="o.country_code != 'JP'" separator=" and "/>
        </xpath>
        <xpath expr="//t[@t-call='purchase.report_purchaseorder_document']" position="after">
            <t t-elif="o.country_code == 'JP'" t-call="l10n_jp_purchase.report_purchaseorder_document" t-lang="o.partner_id.lang"/>
        </xpath>
    </template>
</odoo>
