<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//t[@t-set='address']" position="before">
            <t t-set="jp_layout" t-value="o.company_id.external_report_layout_id.sudo().key == 'l10n_jp.external_layout_jp_standard'"/>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="jp_hide_zero_decimals"
               t-value="o.company_id.account_fiscal_country_id.code == 'JP'
                        and all(line.price_unit.is_integer() for line in o.order_line if line.display_type or line.product_qty)"/>
            <t t-set="jp_document_date" t-value="o.date_order"/>
        </xpath>

        <!-- The Japanese Business layout heads the address with the recipient's name and honorific. -->
        <xpath expr="//div[@t-field='o.partner_id']" position="attributes">
            <attribute name="t-options">{"widget": "contact", "fields": ["address", "phone", "vat"] if jp_layout else ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}</attribute>
        </xpath>

        <!-- The column drops its decimals only when every unit price in it is whole. -->
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'min_precision': 0} if jp_hide_zero_decimals else {}</attribute>
        </xpath>
    </template>
</odoo>
