<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_restaurant.pos_order_change_receipt" inherit_id="point_of_sale.pos_order_change_receipt">
            <div name="order-label" position="after">
                <div t-if="extra_data.get('table_name')" name="table-info" class="text-large">
                    <span t-if="extra_data.get('floor_name')">
                        <span t-out="extra_data['floor_name'] + ' - '"/>
                        <span class="text-bold">T </span>
                    </span>
                    <span t-else="" class="text-bold">Table </span>
                    <span class="text-bold" t-out="extra_data['table_name']"/>
                </div>
            </div>
            <div name="order-reference" position="before">
                <div t-if="order.get('customer_count')">Guest <t t-out="order['customer_count']"/></div>
            </div>
        </template>
    </data>
</odoo>
