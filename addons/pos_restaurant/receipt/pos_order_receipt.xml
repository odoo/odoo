<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="pos_restaurant.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <tr name="date_order" position="inside">
                <td class="text-end w-40" t-if="conditions['module_pos_restaurant'] and extra_data['table_name']">
                    Table <t t-out="extra_data['table_name']" />, Guest <t t-out="order['customer_count'] or 'N/A'" />
                </td>
            </tr>
        </template>
    </data>
</odoo>
