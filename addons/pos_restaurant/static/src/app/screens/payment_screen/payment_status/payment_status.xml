<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//span[@t-out='this.order.remainingDueLabel']" position="after">
            <button class="o_split_and_pay_button btn btn-primary" t-on-click="() => this.onClickSplitAndPay()">
                Split and pay
            </button>
        </xpath>
    </t>
</templates>