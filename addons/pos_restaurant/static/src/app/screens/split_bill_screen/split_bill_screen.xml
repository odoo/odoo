<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant.SplitBillScreenActions" t-inherit="point_of_sale.SplitBillScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('top-content-center')]/h2" position="replace">
            <h2 class="mb-0">
                <t t-if="this.pos.config.module_pos_restaurant">Bill Splitting</t>
                <t t-else="">Split Order</t>
            </h2>
        </xpath>
        <xpath expr="//div[hasclass('pay-button')]/button[hasclass('pay-split-order')]" position="after">
            <div t-if="this.pos.config.module_pos_restaurant" class="d-flex gap-2 w-100 mt-2">
                <button class="btn btn-lg btn-secondary w-100 split-order-button"
                    t-attf-class="{{ this.ui.isSmall ? 'fs-5 py-2' : 'fs-1 py-4' }}"
                    t-att-disabled="!this.getNumberOfProducts()"
                    t-on-click="this.splitOrder">
                    Split Order
                </button>
                <button class="btn btn-lg btn-secondary w-100 transfer-split-order"
                    t-attf-class="{{ this.ui.isSmall ? 'fs-5 py-2' : 'fs-1 py-4' }}"
                    t-att-disabled="this.pos.disableForSelfOrder"
                    t-on-click="this.transferSplittedOrder">
                    Transfer
                </button>
            </div>
        </xpath>
    </t>
</templates>
