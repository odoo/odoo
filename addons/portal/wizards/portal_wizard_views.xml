<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- wizard action on res.partner -->
    <record id="partner_wizard_action_create_and_open" model="ir.actions.server">
        <field name="name">Grant Portal Access…</field>
        <field name="model_id" ref="portal.model_portal_wizard" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_icon">fa-solid fa-user-shield</field>
        <!--
            Only offer the action to users who can actually run the wizard
            (portal.wizard ACL is group_partner_manager); otherwise the menu
            entry raises a raw AccessError dialog.
        -->
        <field
            name="group_ids"
            eval="[Command.link(ref('base.group_partner_manager'))]" />
        <field name="state">code</field>
        <field name="code">action = model.action_view_wizard()</field>
    </record>

    <record id="partner_wizard_action" model="ir.actions.act_window">
        <field name="name">Grant Portal Access…</field>
        <field name="res_model">portal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" eval="False" />
        <field name="binding_icon">fa-solid fa-user-shield</field>
    </record>

    <!-- wizard view -->
    <record id="wizard_view" model="ir.ui.view">
        <field name="name">Grant portal access</field>
        <field name="model">portal.wizard</field>
        <field name="arch" type="xml">
            <form string="Portal Access Management">
                <div class="mb-3">
                    Select which contacts should belong to the portal in the list below.
                    The email address of each selected contact must be valid and unique.
                    If necessary, you can fix any contact's email address directly in the list.
                </div>
                <field
                    name="welcome_message"
                    placeholder="This text is included at the end of the email sent to new portal users."
                    class="mb-3" />
                <field
                    name="user_ids"
                    widget="portal_wizard_user_one2many"
                    class="o_portal_wizard_user_one2many">
                    <list
                        string="Contacts"
                        editable="bottom"
                        create="false"
                        delete="false">
                        <field name="partner_id" force_save="1" />
                        <field name="email" readonly="is_internal" />
                        <field name="email_state" column_invisible="True" />
                        <button
                            name="action_refresh_modal"
                            type="object"
                            title="Valid Email Address"
                            icon="fa-check text-success"
                            invisible="email_state != 'ok'" />
                        <button
                            name="action_refresh_modal"
                            type="object"
                            title="Invalid Email Address"
                            icon="fa-times text-danger"
                            invisible="email_state != 'ko'" />
                        <button
                            name="action_refresh_modal"
                            type="object"
                            title="Email Address already taken by another user"
                            icon="fa-user-times text-danger"
                            invisible="email_state != 'exist'" />
                        <field name="login_date" />
                        <field name="is_portal" column_invisible="True" />
                        <field name="is_internal" column_invisible="True" />
                        <button
                            name="action_grant_access"
                            type="object"
                            string="Grant Access"
                            invisible="is_portal or is_internal or email_state != 'ok'"
                            class="btn-secondary" />
                        <button
                            name="action_revoke_access"
                            type="object"
                            string="Revoke Access"
                            invisible="not is_portal or is_internal"
                            class="btn-secondary" />
                        <button
                            name="action_invite_again"
                            type="object"
                            string="Re-Invite"
                            invisible="not is_portal or is_internal or email_state != 'ok'"
                            class="btn-secondary" />
                        <button
                            string="Internal User"
                            title="This partner is linked to an internal User and already has access to the Portal."
                            invisible="not is_internal"
                            disabled="True" />
                    </list>
                </field>
                <footer>
                    <button
                        special="save"
                        string="Close"
                        class="btn-primary"
                        data-hotkey="v" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
