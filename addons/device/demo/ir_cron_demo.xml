<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_poll_demo_devices" model="ir.cron">
        <field name="name">Remote: Poll Demo Devices</field>
        <field name="model_id" ref="model_device_device" />
        <field name="state">code</field>
        <field name="code">model._cron_poll_demo_devices()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">minute</field>
        <field name="active" eval="True" />
    </record>

</odoo>
