<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="device_kind_view_tree" model="ir.ui.view">
        <field name="name">device.kind.list</field>
        <field name="model">device.kind</field>
        <field name="arch" type="xml">
            <list string="Device Types">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="comm_protocol" />
                <field name="device_count" />
            </list>
        </field>
    </record>

    <record id="device_kind_view_form" model="ir.ui.view">
        <field name="name">device.kind.form</field>
        <field name="model">device.kind</field>
        <field name="arch" type="xml">
            <form string="Device Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_devices"
                            type="object"
                            icon="fa-microchip"
                            class="oe_stat_button">
                            <field
                                name="device_count"
                                string="Devices"
                                widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <label for="name" string="Device Type Name" />
                        <h1>
                            <field name="name" placeholder="e.g., Temperature Sensor" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="icon" />
                            <field name="color" widget="color_picker" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field name="comm_protocol" />
                            <field name="link_mode" />
                            <field name="disconnect_timeout_seconds" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field
                                name="description"
                                placeholder="Describe this device type..." />
                        </page>
                        <page string="Capabilities">
                            <field
                                name="capabilities"
                                widget="ace"
                                options="{'mode': 'json'}" />
                            <div class="text-muted">
                                <p>Define device capabilities in JSON format. Example:</p>
                                <pre>{
  "sensors": ["temperature", "humidity"],
  "actuators": ["relay"],
  "units": {
    "temperature": "°C",
    "humidity": "%"
  }
}</pre>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_kind_view_kanban" model="ir.ui.view">
        <field name="name">device.kind.kanban</field>
        <field name="model">device.kind</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <field name="name" />
                <field name="color" />
                <field name="device_count" />
                <field name="icon" />
                <templates>
                    <t t-name="card">
                        <div
                            t-attf-class="oe_kanban_color_#{record.color.raw_value or 0} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <i
                                    t-att-class="record.icon.raw_value + ' fa-3x'"
                                    t-att-title="record.name.raw_value" />
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="code" />
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="device_count" /> Device(s)
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="device_kind_action" model="ir.actions.act_window">
        <field name="name">Device Types</field>
        <field name="res_model">device.kind</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first device type
            </p>
            <p>
                Device types define templates for different categories of Remote devices.<br />
                Examples: Temperature Sensors, Smart Switches, Industrial PLCs, etc.
            </p>
        </field>
    </record>

</odoo>
