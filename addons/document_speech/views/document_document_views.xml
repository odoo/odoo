<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_view_list_main_speech" model="ir.ui.view">
        <field name="name">document.document.view.list.speech</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.documents_view_list_main" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='folder_id']" position="after">
                <field name="transcript_state" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="documents_transcribe_action" model="ir.actions.server">
        <field name="name">Transcribe</field>
        <field name="model_id" ref="document.model_document_document" />
        <field name="binding_model_id" ref="document.model_document_document" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_transcribe()</field>
    </record>

</odoo>
