<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="l10n_fr_pdp_view_in_invoice_refund_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_refund_tree" />
        <field name="arch" type="xml">
            <field name="payment_state" position="before">
                <field name="peppol_move_state" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="l10n_fr_pdp_view_in_bill_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree" />
        <field name="arch" type="xml">
            <field name="payment_state" position="before">
                <field name="peppol_move_state" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="l10n_fr_pdp_view_move_form" model="ir.ui.view">
        <field name="name">l10n.fr.pdp.view.move.form</field>
        <field name="model">account.move</field>
        <field name="priority">30</field>
        <field name="inherit_id" ref="account_peppol.account_peppol_view_move_form"/>
        <field name="arch" type="xml">
            <!-- We do not show the "Reset to draft" but stil need to be able to cancel-->
            <button name="button_cancel" position="after">
                <button name="button_cancel" type="object" groups="account.group_account_invoice" data-hotkey="x"
                        string="Cancel" confirm="Do you really want to cancel this journal entry?"
                        invisible="state != 'posted' or show_reset_to_draft_button or not pdp_is_sent"
                        />
            </button>
            <label for="peppol_move_state" position="attributes">
                <attribute name="string">E-Invoicing Status</attribute>
            </label>
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="pdp_is_sent" invisible="1"/>  <!-- used in `invisible` modifier above -->
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']/div" position="after">
                <label for="pdp_ppf_move_state" groups="base.group_no_one" invisible="not pdp_ppf_move_state"/>
                <div name="pdp_ppf_info" groups="base.group_no_one" invisible="not pdp_ppf_move_state">
                    <field name="pdp_ppf_move_state"/>
                </div>
            </xpath>
        </field>
    </record>


    <record id="l10n_fr_pdp_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_peppol.account_peppol_view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="peppol_ready" position="attributes">
                <attribute name="string">E-Invoicing Ready</attribute>
            </filter>
            <filter name="peppol_move_state" position="attributes">
                <attribute name="string">E-Invoicing Status</attribute>
            </filter>
            <filter name="peppol_move_state" position="after">
                <filter name="l10n_fr_pdp_status" string="E-Reporting Status"
                        context="{'group_by': 'l10n_fr_pdp_status'}"
                        invisible="not context.get('l10n_fr_pdp_flow_id')"/>
            </filter>
        </field>
    </record>

    <record id="l10n_fr_pdp_reports_view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n.fr.pdp.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="button_cancel" position="after">
                <button
                    name="button_cancel" string="Cancel" type="object"
                    groups="account.group_account_invoice" data-hotkey="x"
                    invisible="not id or state != 'posted' or not l10n_fr_pdp_sent_in_flow_ids"
                />
            </button>
            <xpath expr="//group[@name='accounting_info_group']" position="inside">
                <field name="l10n_fr_pdp_sent_in_flow_ids" invisible="1"/>  <!-- used in `invisible` modifier above -->
            </xpath>
        </field>
    </record>

    <record id="l10n_fr_pdp_action_open_response_wizard" model="ir.actions.server">
        <field name="name">Send Response</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types"></field>
        <field name="state">code</field>
        <field name="sequence">8</field>
        <field name="code">
            if records:
                action = records.action_pdp_open_response_wizard()
        </field>
    </record>

    <record id="l10n_fr_pdp_list_view_move_ereporting" model="ir.ui.view">
        <field name="name">account.move.list.l10n.fr.pdp.move.ereporting</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" expand="context.get('expand', False)">
                <field name="made_sequence_hole" column_invisible="True"/>
                <field name="name" decoration-bf="1" decoration-danger="made_sequence_hole"/>
                <field name="partner_id" string="Partner" readonly="state != 'draft'"/>
                <field name="invoice_date" optional="show" readonly="state != 'draft'" string="Invoice Date"/>
                <field name="date" optional="hide" string="Accounting Date" readonly="state in ['cancel', 'posted']"/>
                <field name="amount_untaxed_signed" string="Tax Excluded" sum="Total" optional="show"/>
                <field name="amount_total_signed" string="Total" sum="Total" optional="show" decoration-bf="1"/>
                <field name="company_id" options="{'no_create': True}" optional="hide"/>
                <field name="currency_id" optional="hide" readonly="state in ['cancel', 'posted']"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="move_type" column_invisible="True"/>
                <field name="payment_state"
                       string="Payment"
                       widget="badge"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state in ('partial', 'in_payment')"
                       decoration-success="payment_state in ('paid', 'reversed')"
                       invisible="payment_state == 'invoicing_legacy' or state != 'posted' or move_type == 'entry'"
                       optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
                <field name="l10n_fr_pdp_status"
                       widget="badge"
                       optional="show"
                       decoration-danger="l10n_fr_pdp_status == 'error'"
                       decoration-success="l10n_fr_pdp_status == 'sent'"
                       decoration-info="l10n_fr_pdp_status == 'ready'"
                       decoration-muted="l10n_fr_pdp_status in ['pending', 'out_of_scope']"
                       invisible="not l10n_fr_pdp_status"/>
            </tree>
        </field>
    </record>

</odoo>
