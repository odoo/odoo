<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_send_wizard_form_annuaire" model="ir.ui.view">
        <field name="name">account.move.send.wizard.form.annuaire</field>
        <field name="model">account.move.send.wizard</field>
        <field name="inherit_id" ref="account.account_move_send_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='alerts']" position="after">
                <field name="l10n_fr_pdp_show_force_send" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not l10n_fr_pdp_show_force_send">
                    The customer is not registered in the French e-invoicing annuaire.
                    You can still transmit invoice data to the DGFiP by enabling the option below.
                </div>
                <group invisible="not l10n_fr_pdp_show_force_send">
                    <field name="l10n_fr_pdp_force_send_einvoicing"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
