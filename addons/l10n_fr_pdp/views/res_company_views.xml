<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_legal_notes" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n.fr.pdp.legal.notes</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="country_code" invisible="1"/>
                <field name="x_studio_peppol_company_legal_form" invisible="country_code != 'FR'"/>
                <field name="x_studio_peppol_company_share_capital" invisible="country_code != 'FR'"/>
                <field name="x_studio_peppol_company_rcs_city" invisible="country_code != 'FR'"/>
            </xpath>
        </field>
    </record>
</odoo>
