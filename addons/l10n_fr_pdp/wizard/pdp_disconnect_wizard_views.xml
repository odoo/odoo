<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pdp_disconnect_wizard_form" model="ir.ui.view">
        <field name="name">pdp.disconnect.wizard.form</field>
        <field name="model">pdp.disconnect.wizard</field>
        <field name="arch" type="xml">
            <form string="Disconnect">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <i class="fa fa-warning me-2"/>Are you sure you want to unregister from the Odoo PDP ?
                    </div>
                    <div class="text-muted mb-3">
                        <p>
                            The platform change must be initiated by your NEW platform
                        </p>
                        <p>
                            Here are the steps to follow
                            <ol>
                                <li>Sign your contract with the new platform.</li>
                                <li>Your new platform will contact Odoo to request the directory transfer</li>
                                <li>Odoo will validate the request within 5 business days.</li>
                            </ol>
                        </p>
                        <p>
                            <strong>Guaranteed service continuity:</strong>
                            <br/>In accordance with regulations, Odoo will continue to process the reception of your invoices until your new platform effectively takes over <br/> (and for a maximum period of 12 months).
                        </p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
