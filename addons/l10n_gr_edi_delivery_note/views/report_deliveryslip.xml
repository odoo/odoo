<?xml version="1.0"?>
<odoo>

    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='signature']" position="after">
            <t t-set="mydata_values" t-value="o._l10n_gr_edi_get_extra_invoice_report_values()"/>
            <div name="l10n_gr_edi_mydata" class="row avoid-page-break-inside mt-3" t-if="mydata_values">
                <div class="col-4" t-if="mydata_values.get('barcode_src')">
                    <img alt="myDATA QR Code" t-att-src="mydata_values['barcode_src']"/>
                </div>
                <div class="col-8">
                    <ul class="list-unstyled mb-0">
                        <li>
                            <strong>MARK:</strong>
                            <span t-out="mydata_values['mydata_mark']"/>
                        </li>
                    </ul>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
