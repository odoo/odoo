<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="apple_wallet_button" name="Add Event Pass to Apple Wallet">
        <a class="o_website_event_wallet_badge d-inline-block p-1"
           t-attf-href="/event/{{ event.id }}/registration/{{ attendee.id }}/wallet/apple?tickets_hash={{ event._get_tickets_access_hash([attendee.id]) }}"
           title="Add to Apple Wallet" aria-label="Add to Apple Wallet">
            <img src="/website_event_wallet/static/src/img/add_to_apple_wallet.svg"
                 alt="Add to Apple Wallet" height="40" style="width: auto;"/>
            <span t-if="len(attendees) &gt; 1" class="d-block small text-center" t-out="attendee.name"/>
        </a>
    </template>

    <template id="registration_complete" inherit_id="website_event.registration_complete">
        <xpath expr="//t[@t-call='website_event.registration_ticket_access']" position="after">
            <t t-foreach="wallet_providers" t-as="provider_code">
                <div class="o_website_event_wallet d-none d-flex flex-wrap align-items-center gap-2"
                     t-att-data-provider-code="provider_code">
                    <t t-foreach="attendees.filtered(lambda attendee: attendee.state in ('open', 'done'))" t-as="attendee">
                        <t t-if="provider_code == 'apple'" t-call="website_event_wallet.apple_wallet_button"/>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
