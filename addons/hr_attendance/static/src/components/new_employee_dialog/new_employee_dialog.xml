<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_attendance.NewEmployeeDialog" owl="1">
        <Dialog title="this.props.title" footer="this.props.footer" bodyClass="'overflow-visible'">
            <div class="p-3">
                <div class="mb-3">
                    <label class="form-label">Create the name of the new employee below</label>
                    <div class="d-flex">
                        <input type="text" t-model="this.state.employeeName" class="form-control me-2" placeholder="e.g. John Doe"/>
                        <button class="btn btn-primary" t-on-click="this.onCreate">Confirm</button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Employee Without Badge</label>
                    <div class="o_select_employee">
                        <div class="o_select_employee_display form-control">
                            <img t-if="this.state.value" class="d-flex rounded" t-attf-src="/web/image/hr.employee/{{this.state.value.id}}/avatar_128"/>
                            <div class="o_select_employee_option p-0">
                                <Many2One value="this.state.searchName" update.bind="this.onSelectEmployee" token="this.props.token"/>
                            </div>
                        </div>
                        <input type="text" t-model="this.state.badgeId" class="form-control" placeholder="Enter Badge Number"/>
                        <button class="btn btn-primary" style="min-width: fit-content;" t-on-click="this.onSetBadge">Set the Badge</button>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
