<templates xml:space="preserve">

    <t t-name="hr_attendance.KioskConfirmation">
        <t t-if="this.attendance">
            <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 flex-column gap-3 justify-content-center align-items-center">
                <div class="o_attendance_card card w-100 border-0 shadow-lg">
                    <div class="o_attendance_card_body card-body overflow-auto text-center">
                        <div class="d-flex flex-column align-items-center justify-content-center gap-4">
                            <div class="d-flex flex-column align-items-center gap-2 mt-4">
                                <AttendanceVideoStream
                                    t-if="this.showVideoStream"
                                    exposeCameraCapture.bind="this.props.exposeCameraCapture"
                                    onStreamStateChange.bind="this.setStreamAvailable"
                                />
                                <t
                                    t-else=""
                                    t-call="hr_attendance.EmployeeBadge"
                                    employeeAvatar="this.employeeAvatar"
                                    employeeAvatarHeight="'128'"
                                />
                                <h3 class="mb-0 h4 fw-bold" t-out="this.employeeName"/>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <h5 class="mb-0">
                                    Confirm
                                    <t t-if="this.isCheckedIn">check-out</t>
                                    <t t-else="">check-in</t>
                                    ?
                                </h5>
                                <p class="mb-0 text-muted" role="status">
                                    <i class="oi" data-icon="timer" title="Hours today"/>
                                    Today: <strong t-out="this.hoursToday"/>
                                </p>
                            </div>
                            <button class="btn btn-primary w-100"
                            t-on-click="() => this.props.kioskConfirm(this.props.employeeData.id, false)">
                                <t t-if="this.isCheckedIn">Check-out</t>
                                <t t-else="">Check-in <i class="oi ms-1" data-icon="login"/></t>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 justify-content-center align-items-center">
                <div class="alert alert-warning text-center px-4 py-3">
                    <h4 class="mb-2">Invalid request</h4>
                    <p class="mb-0">Please return to the main menu.</p>
                </div>
            </div>
            <div class="o_hr_kiosk_mode_bottom my-4 text-center">
                <button class="btn btn-primary btn-lg rounded-pill px-5"
                        t-on-click="this.props.backToManualSelection">
                    <i class="oi me-2" data-icon="chevron_backward"/>
                    Go back
                </button>
            </div>
        </t>
    </t>

</templates>
