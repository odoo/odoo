<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_attendance.EmployeeBadge">
        <div class="o_hr_attendance_user_badge text-center">
            <img
                class="o_hr_attendance_employee_badge img rounded-circle"
                t-attf-src="{{employeeAvatar}}"
                t-attf-height="{{ employeeAvatarHeight or '120'}}"/>
        </div>
    </t>

    <t t-name="hr_attendance.public_kiosk_greetings">
        <t t-if="this.attendance">
            <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 flex-column gap-3 justify-content-center align-items-center">
                <div class="o_attendance_card card w-100 border-0 shadow-lg">
                    <div class="o_attendance_card_body card-body overflow-auto text-center">
                        <div class="d-flex flex-column align-items-center justify-content-center gap-4">
                            <div class="d-flex flex-column align-items-center mt-4">
                                <t t-call="hr_attendance.EmployeeBadge"
                                    employeeAvatar="this.props.employeeData.employee_avatar"
                                    employeeAvatarHeight="'128'"
                                />
                                <h1 class="d-block h5 mt-2 mb-1 text-muted">
                                    <t t-if="this.isCheckOut">Goodbye</t>
                                    <t t-else="">Welcome</t>
                                </h1>
                                <h2 class="mb-0 h4 fw-bold" t-out="this.props.employeeData.employee_name"/>
                            </div>
                            <div class="d-flex flex-column gap-3" role="status">
                                <h3 class="h5 mb-0 lh-base">
                                    <t t-if="this.isCheckOut">
                                        <span class="text-danger">Checked out at</span>
                                        <span class="d-block fw-bold" t-out="this.checkOutTime()"/>
                                    </t>
                                    <t t-else="">
                                        <span class="text-success">Checked in at</span>
                                        <span class="d-block fw-bold" t-out="this.checkInTime()"/>
                                    </t>
                                </h3>
                                <p t-if="this.props.employeeData.hours_today" class="mb-0 text-muted" role="status">
                                    <t t-if="this.props.employeeData.is_employee_single_checkin and !this.attendance.check_out">
                                        You've already checked in.
                                    </t>
                                    <t t-else="">
                                        <t t-if="this.isCheckOut">
                                            <i class="oi me-1" data-icon="timer" title="Today"/>
                                            Today:
                                        </t>
                                        <t t-else="">
                                            <i class="oi me-1" data-icon="timer" title="Previously Today"/>
                                            Previously Today:
                                        </t>
                                        <strong t-out="this.hoursToday()"/>
                                    </t>
                                </p>
                            </div>
                            <div
                                t-if="this.attendance.check_out and this.overtimeToday()"
                                class="alert alert-warning w-100 mb-0 text-center"
                            >
                                <h5 class="small fw-bolder text-uppercase">
                                    Extra hours
                                </h5>
                                <p class="mb-0">Today: <strong t-out="this.overtimeToday()"/></p>
                                <p t-if="this.totalOvertime()" class="mb-0">Total: <strong t-out="this.totalOvertime()"/></p>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-2 mt-4">
                            <button t-if="this.isCheckOut and this.props.employeeData.break_management_enabled" type="button" class="btn btn-secondary" t-on-click="this.continueBreak">
                                Add my break times
                            </button>
                            <button class="o_attendance_btn_next btn btn-primary" t-on-click="this.props.kioskReturn">
                                Next
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="o_hr_kiosk_mode_main d-flex flex-grow-1 justify-content-center align-items-center">
                <div class="alert alert-warning px-5 text-center" role="alert">
                    <h4 class="alert-heading mt-3">Invalid request</h4>
                    <p>Please return to the main menu.</p>
                </div>
            </div>
            <div class="o_hr_kiosk_mode_bottom my-4 mx-auto">
                <button class="btn btn-primary btn-lg rounded-pill px-5" t-on-click="this.props.kioskReturn">
                    <i class="oi me-2" data-icon="chevron_backward"/>
                    <span>Go back</span>
                </button>
            </div>
        </t>
    </t>
</templates>
