<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="hr_attendance.KioskBarcodeScanner" t-inherit="barcodes.BarcodeScanner" t-inherit-mode="primary">
    <xpath expr="//div[hasclass('o_barcode_mobile_container')]" position="replace">
        <div class="o_attendance_card card w-100 shadow-lg">
            <div class="o_attendance_card_body card-body overflow-auto">
                <div class="my-4 text-center">
                    <AttendanceVideoStream
                        t-if="this.showVideoStream"
                        exposeCameraCapture.bind="this.kioskProps.exposeCameraCapture"
                        onStreamStateChange.bind="this.setStreamAvailable"
                    />
                    <h1 class="d-block mt-2 mb-1 h5 text-muted">Welcome</h1>
                    <h2 class="h4 mb-1 fw-bold">Scan your badge</h2>
                    <p class="mb-0 text-muted small">Hold it under the reader to check in</p>
                </div>
                <button
                    t-on-click="this.openMobileScanner"
                    class="o_attendance_scan_zone position-relative d-block w-100 border border-2 rounded-3 mx-auto py-3 px-4 bg-100 overflow-hidden"
                >
                    <svg class="o_attendance_barcode d-block w-100 h-auto mx-auto text-primary" viewBox="0 0 60 45" fill="currentColor" role="img" aria-label="Barcode">
                        <rect x="0" width="5" height="45"/>
                        <rect x="8" width="3" height="45"/>
                        <rect x="14" width="6" height="45"/>
                        <rect x="23" width="3" height="45"/>
                        <rect x="29" width="3" height="45"/>
                        <rect x="35" width="7" height="45"/>
                        <rect x="45" width="3" height="45"/>
                        <rect x="51" width="4" height="45"/>
                        <rect x="58" width="2" height="45"/>
                    </svg>
                    <span class="o_attendance_barcode_laser"/>
                </button>

                <t t-if="this.kioskProps.kioskMode !== 'barcode'">
                    <div class="d-flex align-items-center gap-3 my-4 text-400">
                        <hr class="flex-grow-1 my-0"/>
                        <small class="fw-medium text-uppercase">Or</small>
                        <hr class="flex-grow-1 my-0"/>
                    </div>
                    <button t-on-click="() => this.kioskProps.onIdentifyManually()" class="o_attendance_identify_btn btn btn-secondary w-100">
                        <i class="oi me-2" data-icon="badge"/>
                        <span>Identify Manually</span>
                    </button>
                </t>
            </div>
        </div>
        <a
            t-if="!this.isDisplayStandalone"
            t-att-href="this.installURL"
            target="_blank"
            rel="noopener noreferrer"
            class="o_hr_attendance_install_btn btn btn-secondary btn smaller"
        >
            <i class="oi me-1" data-icon="download"/>
            <span>Install as an app</span>
        </a>
    </xpath>
</t>

<t t-name="hr_attendance.PublicKiosksSettingScreen">
    <div class="align-self-center" t-att-class="{'h2 mt-5': !this.ui.isSmall, 'my-3 text-center h5': this.ui.isSmall}">
        Choose how to record attendances
    </div>
    <div class="o_hr_kiosk_mode_main d-flex m-auto" t-att-class="{'gap-5': !this.ui.isSmall, 'gap-3 flex-column': this.ui.isSmall}">
        <div class="d-flex flex-column align-items-center text-center gap-2" t-att-style="!this.ui.isSmall ? 'max-width: min-content;' : ''">
            <button
                t-on-click="() => this.setSetting('manual')"
                class="btn btn-light"
                t-att-class="{
                    'd-flex flex-row rounded-2 ps-2 align-items-center gap-2' : this.ui.isSmall,
                    'btn-lg rounded-3': !this.ui.isSmall
                }">
                <t t-if="this.ui.isSmall">
                    <img src="/hr_attendance/static/img/tablet-pin.svg" alt="Manual Attendance" width="40%"/>
                    <h6 class="m-0">Manually (optional PIN)</h6>
                </t>
                <t t-else="">
                    <img src="/hr_attendance/static/img/tablet-pin.svg" height="170px" alt="Manual Attendance"/>
                </t>
            </button>
            <t t-if="!this.ui.isSmall">
                <h5 class="m-0">Select on Tablet</h5>
                <em>with optional PIN code</em>
            </t>
        </div>
        <div class="d-flex flex-column align-items-center text-center gap-2" t-att-style="!this.ui.isSmall ? 'max-width: min-content;' : ''">
            <button
                t-on-click="() => this.setSetting('barcode')"
                class="btn btn-light"
                t-att-class="{
                    'flex-row d-flex rounded-2 ps-2 align-items-center gap-2' : this.ui.isSmall,
                    'btn-lg rounded-3': !this.ui.isSmall
                }">
                <t t-if="this.ui.isSmall">
                    <img src="/hr_attendance/static/img/tablet-cam.svg" alt="Attendance with barcode" width="40%"/>
                    <h6 class="m-0">Badge with Barcode</h6>
                </t>
                <t t-else="">
                    <img src="/hr_attendance/static/img/tablet-cam.svg" height="170px" alt="Attendance with barcode"/>
                </t>
            </button>
            <t t-if="!this.ui.isSmall">
                <h5 class="m-0 w-75">Badge with Barcode on Tablet</h5>
            </t>
        </div>
        <div class="d-flex flex-column align-items-center text-center gap-2" t-att-style="!this.ui.isSmall ? 'max-width: min-content;' : ''">
            <button
                t-on-click="() => this.setSetting('barcode_manual')"
                class="btn btn-light"
                t-att-class="{
                    'flex-row d-flex rounded-2 ps-2 align-items-center gap-2' : this.ui.isSmall,
                    'btn-lg rounded-3': !this.ui.isSmall
                }">
                <t t-if="this.ui.isSmall">
                    <img src="/hr_attendance/static/img/tablet-rfid.svg" alt="Manual Attendance or with barcode" width="40%"/>
                    <h6 class="m-0">RFID Token with reader</h6>
                </t>
                <t t-else="">
                    <img src="/hr_attendance/static/img/tablet-rfid.svg" height="170px"
                    alt="Manual Attendance or with barcode"/>
                </t>
            </button>
            <t t-if="!this.ui.isSmall">
                <h5 class="m-0 w-75">RFID Token with reader on tablet</h5>
            </t>
        </div>
    </div>
</t>

<t t-name="hr_attendance.public_kiosk_app">
    <MainComponentsContainer/>
    <CardLayout
        fromTrialMode="this.props.fromTrialMode"
        kioskReturn.bind="this.kioskReturn"
        activeDisplay="this.state.active_display"
        kioskModeClasses="this.state.active_display === 'greet' ? 'flex-grow-1 h-auto' : ''"
    >
        <t t-if="this.state.active_display === 'settings'">
            <t t-call="hr_attendance.PublicKiosksSettingScreen"/>
        </t>
        <t t-if="this.state.active_display === 'main'">
            <div class="o_hr_kiosk_mode_main d-flex flex-column align-items-center gap-5 w-100 m-auto">
                <t t-if="this.state.kioskMode !== 'manual'">
                <KioskBarcodeScanner
                    kioskMode="this.state.kioskMode"
                    fromTrialMode="this.props.fromTrialMode"
                    token="this.props.token"
                    barcodeSource="this.props.barcodeSource"
                    onBarcodeScanned="(ev) => this.onBarcodeScanned(ev)"
                    captureCheckInImage="this.props.captureCheckInImage"
                    exposeCameraCapture.bind="this.setCameraCapture"
                    onIdentifyManually="() => this.switchDisplay('manual')"
                />
                <div
                    t-if="this.props.fromTrialMode"
                    class="o_hr_kiosk_mode_main mt-5"
                    t-attf-style="position: relative; top: {{ this.props.captureCheckInImage ? '100px' : '' }}"
                >
                    <button t-on-click="() => this.newSetUp()" class="btn btn-light btn-lg rounded-3 mt-5">
                        <span>New Set-up (Employee/Badge)</span>
                    </button>
                </div>
                </t>
            </div>
        </t>
        <t t-if="this.state.active_display === 'manual'">
            <KioskManualSelection
                displayBackButton="!this.manualKioskMode || this.props.fromTrialMode"
                departments="this.props.departments"
                onSelectEmployee="(e) => this.kioskEmployeeSelected(e)"
                onClickBack="() => this.kioskReturn()"
                token="this.props.token"
            />
        </t>
        <t t-if="this.state.active_display === 'confirmation'">
            <KioskConfirmation
                employeeData="this.employeeData"
                kioskConfirm.bind="this.onManualSelection"
                backToManualSelection.bind="() => this.switchDisplay('manual')"
                captureCheckInImage="this.props.captureCheckInImage"
                exposeCameraCapture.bind="this.setCameraCapture"
            />
        </t>
        <t t-if="this.state.active_display === 'greet'">
            <KioskGreetings
                employeeData="this.employeeData"
                kioskReturn="() => this.kioskReturn(true)"
                kioskContinueBreak.bind="this.continueAsBreakTime"/>
        </t>
        <t t-if="this.state.active_display === 'pin'">
            <KioskPinCode
                employeeData="this.employeeData"
                onPinConfirm="(id, pin) => this.onManualSelection(id, pin)"
                onClickBack="() => this.kioskReturn()"
                captureCheckInImage="this.props.captureCheckInImage"
                exposeCameraCapture.bind="this.setCameraCapture"
            />
        </t>
    </CardLayout>
</t>
</templates>
