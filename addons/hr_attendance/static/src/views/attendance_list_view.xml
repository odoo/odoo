<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr_attendance.AttendanceListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <AttendanceDashboard t-if="this.showDashboard"/>
        </xpath>
        <ActionHelper position="replace"/>
        <table position="after">
            <t t-if="this.showNoContentHelper">
                <AttendanceActionHelper noContentHelp="this.props.noContentHelp"/>
            </t>
        </table>
    </t>
</odoo>
