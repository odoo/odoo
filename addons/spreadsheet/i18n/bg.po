#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional column or row containing true or false values."
msgstr "Допълнителна колона или ред, съдържащи стойности true или false."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional conditions to be evaluated if the previous ones are FALSE."
msgstr "Допълнителни условия, които да се изчислят, ако предишните са FALSE."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional criteria to check."
msgstr "Допълнителни критерии за проверка."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional criteria_range and criterion to check."
msgstr "Допълнителни criteria_range и критерий за проверка."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional future cash flows."
msgstr "Допълнителни бъдещи парични потоци."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional numbers or ranges to add to value1."
msgstr "Допълнителни числа или диапазони, които да се добавят към value1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"Additional ranges over which to evaluate the additional criteria. The "
"filtered set will be the intersection of the sets produced by each criterion-"
"range pair."
msgstr ""
"Допълнителни диапазони, върху които да се изчислят допълнителните критерии. "
"Филтрираният набор ще бъде пресечната точка на наборите, получени от всяка "
"двойка критерий-диапазон."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional ranges to add to range1."
msgstr "Допълнителни диапазони, които да се добавят към range1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "Additional ranges to check."
msgstr "Допълнителни диапазони за проверка."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
