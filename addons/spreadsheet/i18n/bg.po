#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A boolean indicating whether to use A1 style notation (TRUE) or R1C1 style "
"notation (FALSE)."
msgstr ""
"Булева стойност, указваща дали да се използва A1 стилова нотация (TRUE) или "
"R1C1 стилова нотация (FALSE)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A boolean; if TRUE, empty cells selected in the text arguments won't be "
"included in the result."
msgstr ""
"Булева стойност; ако е TRUE, празните клетки, избрани в текстовите "
"аргументи, няма да бъдат включени в резултата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A column or row containing true or false values corresponding to the first "
"column or row of range."
msgstr ""
"Колона или ред, съдържащи стойности true или false, съответстващи на първата "
"колона или ред от диапазона."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A conditional count across a range."
msgstr "Условно броене в диапазон."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A conditional sum across a range."
msgstr "Условно сумиране в диапазон."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A filter can only be created on a continuous selection."
msgstr ""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A flag specifying wheter to compute the slope or not"
msgstr ""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A flag specifying whether to compute the intercept or not."
msgstr "Флаг, указващ дали да се изчисли пресечната точка или не."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A flag specifying whether to return additional regression statistics or only "
"the linear coefficients and the y-intercept"
msgstr ""
"Флаг, указващ дали да се върнат допълнителни регресионни статистики или само "
"линейните коефициенти и y-пресечната точка"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A maximum range limit value is needed"
msgstr "Необходима е стойност за максималната граница на диапазона"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A minimum range limit value is needed"
msgstr "Необходима е стойност за минималната граница на диапазона"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A number indicating which numbering system to use to represent weekdays. By "
"default, counts starting with Sunday = 1."
msgstr ""
"Число, указващо коя номерационна система да се използва за представяне на "
"дните от седмицата. По подразбиране броенето започва с неделя = 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A number or string representing which days of the week are considered "
"weekends."
msgstr ""
"Число или низ, представящи кои дни от седмицата се считат за почивни дни."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A number raised to a power."
msgstr "Число, повдигнато на степен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A number representing the day that a week starts on. Sunday = 1."
msgstr "Число, представящо деня, в който започва седмицата. Неделя = 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A number representing the way to display ties."
msgstr "Число, представящо начина на показване на равенствата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A number with the sign reversed."
msgstr "Число с обърнат знак."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A random number between 0 inclusive and 1 exclusive."
msgstr "Случайно число между 0 включително и 1 изключително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A range containing the income or payments associated with the investment. "
"The array should contain bot payments and incomes."
msgstr ""
"Диапазон, съдържащ приходите или плащанията, свързани с инвестицията. "
"Масивът трябва да съдържа както плащания, така и приходи."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A range needs to be defined"
msgstr "Трябва да бъде дефиниран диапазон"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid ""
"A range or array constant containing the date serial numbers to consider "
"holidays."
msgstr ""
"Диапазон или масивна константа, съдържащи серийните номера на датите, които "
"да се считат за празници."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A range or array constant containing the dates to consider as holidays."
msgstr ""
"Диапазон или масивна константа, съдържащи датите, които да се считат за "
"празници."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A range or array constant containing the dates to consider holidays."
msgstr ""
"Диапазон или масивна константа, съдържащи датите, които да се считат за "
"празници."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "A segment of a string."
msgstr "Сегмент от низ."

