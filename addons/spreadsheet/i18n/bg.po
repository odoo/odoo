#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting unit, the unit currently assigned to value"
msgstr "Началната единица, единицата, която в момента е присвоена на стойността"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting_at (%s) must be greater than or equal to 1."
msgstr "starting_at (%s) трябва да е по-голям или равен на 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting_at argument (%s) must be positive greater than one."
msgstr "Аргументът starting_at (%s) трябва да е положителен и по-голям от едно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string from which the left portion will be returned."
msgstr "Низът, от който ще се върне лявата част."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string from which the right portion will be returned."
msgstr "Низът, от който ще се върне дясната част."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string on which you want to extract text."
msgstr "Низът, от който искате да извлечете текст."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string representing the date."
msgstr "Низът, представляващ датата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string that holds the time representation."
msgstr "Низът, който съдържа представянето на часа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string that will replace search_for."
msgstr "Низът, който ще замени search_for."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to convert to lowercase."
msgstr "Низът, който да се преобразува в малки букви."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to convert to uppercase."
msgstr "Низът, който да се преобразува в главни букви."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to extract a segment from."
msgstr "Низът, от който да се извлече сегмент."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to look for within text_to_search."
msgstr "Низът, който да се търси в text_to_search."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to search for within text_to_search."
msgstr "Низът, който да се търси в text_to_search."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string whose length will be returned."
msgstr "Низът, чиято дължина ще бъде върната."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The substring after which text will be returned."
msgstr "Подниз, след който ще се върне текст."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The subtrahend, or number to subtract from value1."
msgstr "Умалителят, или числото, което да се извади от value1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The table zone is invalid for an unknown reason"
msgstr "Зоната на таблицата е невалидна по неизвестна причина"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The table_number (%s) is out of range."
msgstr "table_number (%s) е извън диапазона."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text or reference to a cell containing text to be trimmed."
msgstr "Текстът или референцията към клетка, съдържаща текст за подрязване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to display in the cell, enclosed in quotation marks."
msgstr "Текстът за показване в клетката, заграден в кавички."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to divide."
msgstr "Текстът за разделяне."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to search for the first occurrence of search_for."
msgstr "Текстът, в който да се търси първото срещане на search_for."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to split."
msgstr "Текстът, който да се раздели."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text which will be inserted into the original text."
msgstr "Текстът, който ще бъде вмъкнат в оригиналния текст."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The text which will be returned with the first letter of each word in "
"uppercase and all other letters in lowercase."
msgstr ""
"Текстът, който ще бъде върнат с първата буква на всяка дума с главна буква и "
"всички останали букви с малки."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text whose non-printable characters are to be removed."
msgstr "Текстът, чиито непечатаеми знаци да бъдат премахнати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text within which to search and replace."
msgstr "Текстът, в който да се търси и заменя."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text, a part of which will be replaced."
msgstr "Текстът, част от който ще бъде заменена."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text_to_search must be non-empty."
msgstr "text_to_search не трябва да е празен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time from which to calculate the hour component."
msgstr "Часът, от който да се изчисли компонентът за час."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time from which to calculate the minute component."
msgstr "Часът, от който да се изчисли компонентът за минути."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time from which to calculate the second component."
msgstr "Часът, от който да се изчисли компонентът за секунди."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time_string (%s) cannot be parsed to date/time."
msgstr "time_string (%s) не може да бъде разпознат като дата/час."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The timing of the payment payments are due for each period."
msgstr "Времето, в което плащанията са дължими за всеки период."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The type (%s) is out of range."
msgstr "Типът (%s) е извън диапазона."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The type (%s) must be between 1 and 3 or between 11 and 17."
msgstr "Типът (%s) трябва да е между 1 и 3 или между 11 и 17."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The type of information requested."
msgstr "Видът на исканата информация."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The unit (%s) must be strictly positive."
msgstr "Единицата (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The unit of measure into which to convert value"
msgstr "Мерната единица, в която да се преобразува value"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The units of the desired fraction, e.g. 8 for 1/8ths or 32 for 1/32nds."
msgstr "Единиците на желаната дроб, напр. 8 за 1/8 или 32 за 1/32."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The units of the fraction, e.g. 8 for 1/8ths or 32 for 1/32nds."
msgstr "Единиците на дробта, напр. 8 за 1/8 или 32 за 1/32."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The upper inflection point value must be a number"
msgstr "Стойността на горната инфлексна точка трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) cannot be between -1 and 1 inclusive."
msgstr "Стойността (%s) не може да е между -1 и 1 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be a valid base %s representation."
msgstr "Стойността (%s) трябва да е валидно представяне в основа %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be between -1 and 1 exclusive."
msgstr "Стойността (%s) трябва да е между -1 и 1 без границите."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be between -1 and 1 inclusive."
msgstr "Стойността (%s) трябва да е между -1 и 1 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be greater than or equal to 1."
msgstr "Стойността (%s) трябва да е по-голяма или равна на 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be positive or null."
msgstr "Стойността (%s) трябва да е положителна или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be strictly positive."
msgstr "Стойността (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value does not match the custom formula data validation rule"
msgstr ""
"Стойността не отговаря на правилото за валидиране на данни по собствена "
"формула"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse cosine. Must be between -1 and "
"1, inclusive."
msgstr ""
"Стойността, за която да се изчисли обратният косинус. Трябва да е между -1 и "
"1 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the inverse cotangent."
msgstr "Стойността, за която да се изчисли обратният котангенс."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse hyperbolic cosine. Must be "
"greater than or equal to 1."
msgstr ""
"Стойността, за която да се изчисли обратният хиперболичен косинус. Трябва да "
"е по-голяма или равна на 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse hyperbolic cotangent. Must not "
"be between -1 and 1, inclusive."
msgstr ""
"Стойността, за която да се изчисли обратният хиперболичен котангенс. Не "
"трябва да е между -1 и 1 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the inverse hyperbolic sine."
msgstr "Стойността, за която да се изчисли обратният хиперболичен синус."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse hyperbolic tangent. Must be "
"between -1 and 1, exclusive."
msgstr ""
"Стойността, за която да се изчисли обратният хиперболичен тангенс. Трябва да "
"е между -1 и 1 без границите."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse sine. Must be between -1 and 1, "
"inclusive."
msgstr ""
"Стойността, за която да се изчисли обратният синус. Трябва да е между -1 и 1 "
"включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the inverse tangent."
msgstr "Стойността, за която да се изчисли обратният тангенс."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the logarithm, base e."
msgstr "Стойността, за която да се изчисли логаритъмът при основа e."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the logarithm."
msgstr "Стойността, за която да се изчисли логаритъмът."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be %s"
msgstr "Стойността трябва да е %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a boolean"
msgstr "Стойността трябва да е булева"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date"
msgstr "Стойността трябва да е дата"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date after %s"
msgstr "Стойността трябва да е дата след %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date before %s"
msgstr "Стойността трябва да е дата преди %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date between %s and %s"
msgstr "Стойността трябва да е дата между %s и %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date not between %s and %s"
msgstr "Стойността трябва да е дата извън интервала %s и %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date on or after %s"
msgstr "Стойността трябва да е дата на или след %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date on or before %s"
msgstr "Стойността трябва да е дата на или преди %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a formula"
msgstr "Стойността трябва да е формула"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a number"
msgstr "Стойността трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that begins with \"%s\""
msgstr "Стойността трябва да е текст, който започва с \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that contains \"%s\""
msgstr "Стойността трябва да е текст, който съдържа \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that does not contain \"%s\""
msgstr "Стойността трябва да е текст, който не съдържа \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that ends with \"%s\""
msgstr "Стойността трябва да е текст, който завършва с \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid date"
msgstr "Стойността трябва да е валидна дата"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid email address"
msgstr "Стойността трябва да е валиден имейл адрес"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid link"
msgstr "Стойността трябва да е валидна връзка"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid range"
msgstr "Стойността трябва да е валиден диапазон"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a value in the range %s"
msgstr "Стойността трябва да е стойност в диапазона %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be between %s and %s"
msgstr "Стойността трябва да е между %s и %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be empty"
msgstr "Стойността трябва да е празна"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be equal to %s"
msgstr "Стойността трябва да е равна на %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be exactly \"%s\""
msgstr "Стойността трябва да е точно \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be greater or equal to %s"
msgstr "Стойността трябва да е по-голяма или равна на %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be greater than %s"
msgstr "Стойността трябва да е по-голяма от %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be less or equal to %s"
msgstr "Стойността трябва да е по-малка или равна на %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be less than %s"
msgstr "Стойността трябва да е по-малка от %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be one of: %s"
msgstr "Стойността трябва да е една от: %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be the date %s"
msgstr "Стойността трябва да е датата %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be a formula"
msgstr "Стойността не трябва да е формула"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be between %s and %s"
