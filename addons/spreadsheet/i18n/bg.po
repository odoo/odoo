msgstr "Необходима е стойност за максималната граница на диапазона"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "A minimum range limit value is needed"
msgstr "Необходима е стойност за минималната граница на диапазона"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
