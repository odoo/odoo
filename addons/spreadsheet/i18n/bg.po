msgstr ""
"Инвестираната сума (независимо от номиналната стойност на всяка ценна книга)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount invested in the security."
msgstr "Сумата, инвестирана в ценната книга."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount of each payment made."
msgstr "Размерът на всяко извършено плащане."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount of initial capital or value to compound against."
msgstr "Размерът на началния капитал или стойност, върху която да се натрупва."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount per period to be paid."
msgstr "Сумата за плащане за всеки период."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount to be received at maturity."
msgstr "Сумата, която ще бъде получена на падежа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount to increment each value in the sequence"
msgstr "Стъпката, с която да се увеличава всяка стойност в поредицата"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to convert from radians to degrees."
msgstr "Ъгълът за преобразуване от радиани в градуси."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the cosecant of, in radians."
msgstr "Ъгълът, за който да се намери косекансът, в радиани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the cosine of, in radians."
msgstr "Ъгълът, за който да се намери косинусът, в радиани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the cotangent of, in radians."
msgstr "Ъгълът, за който да се намери котангенсът, в радиани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the secant of, in radians."
msgstr "Ъгълът, за който да се намери секансът, в радиани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the sine of, in radians."
msgstr "Ъгълът, за който да се намери синусът, в радиани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the tangent of, in radians."
msgstr "Ъгълът, за който да се намери тангенсът, в радиани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The annualized rate of interest."
msgstr "Годишният лихвен процент."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The argument %s is not a valid measure. Here are the measures: %s"
msgstr "Аргументът %s не е валидна мярка. Ето мерките: %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The argument dimension must be positive"
msgstr "Аргументът dimension трябва да е положителен"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The argument is missing. Please provide a value"
msgstr "Аргументът липсва. Моля, въведете стойност"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The argument square_matrix must have the same number of columns and rows."
msgstr "Аргументът square_matrix трябва да има еднакъв брой колони и редове."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The arguments array_x and array_y must contain at least one pair of numbers."
msgstr ""
"Аргументите array_x и array_y трябва да съдържат поне една двойка числа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The arguments array_x and array_y must have the same dimensions."
msgstr "Аргументите array_x и array_y трябва да имат еднакви размерности."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The arguments condition must be a single column or row."
msgstr "Аргументът condition трябва да е една колона или ред."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The arguments conditions must have the same dimensions."
msgstr "Аргументите conditions трябва да имат еднакви размерности."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array of ranges containing the values to be counted."
msgstr "Масивът от диапазони, съдържащи стойностите, които да бъдат преброени."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range containing dependent (y) values that are already known, "
"used to curve fit an ideal exponential growth curve."
msgstr ""
"Масивът или диапазонът, съдържащ вече известните зависими (y) стойности, "
"използвани за напасване на крива по идеална експоненциална крива на растеж."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range containing dependent (y) values that are already known, "
"used to curve fit an ideal linear trend."
msgstr ""
"Масивът или диапазонът, съдържащ вече известните зависими (y) стойности, "
"използвани за напасване на крива по идеален линеен тренд."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range containing the data to consider, structured in such a way "
"that the first row contains the labels for each column's values."
msgstr ""
"Масивът или диапазонът, съдържащ данните за разглеждане, структуриран така, "
"че първият ред да съдържа етикетите за стойностите на всяка колона."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array or range containing the dataset to consider."
msgstr "Масивът или диапазонът, съдържащ набора от данни за разглеждане."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values that will be reduced by corresponding entries "
"in array_y, squared, and added together."
msgstr ""
"Масивът или диапазонът от стойности, които ще бъдат намалени със съответните "
"записи в array_y, повдигнати на квадрат и събрани заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values that will be subtracted from corresponding "
"entries in array_x, the result squared, and all such results added together."
msgstr ""
"Масивът или диапазонът от стойности, които ще бъдат извадени от съответните "
"записи в array_x, резултатът повдигнат на квадрат и всички такива резултати "
"събрани заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be added to the squares of "
"corresponding entries in array_x and added together."
msgstr ""
"Масивът или диапазонът от стойности, чиито квадрати ще бъдат добавени към "
"квадратите на съответните записи в array_x и събрани заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be added to the squares of "
"corresponding entries in array_y and added together."
msgstr ""
"Масивът или диапазонът от стойности, чиито квадрати ще бъдат добавени към "
"квадратите на съответните записи в array_y и събрани заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be reduced by the squares of "
"corresponding entries in array_y and added together."
msgstr ""
"Масивът или диапазонът от стойности, чиито квадрати ще бъдат намалени с "
"квадратите на съответните записи в array_y и събрани заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be subtracted from the "
"squares of corresponding entries in array_x and added together."
msgstr ""
"Масивът или диапазонът от стойности, чиито квадрати ще бъдат извадени от "
"квадратите на съответните записи в array_x и събрани заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array that contains the columns to be returned."
msgstr "Масивът, който съдържа колоните, които да бъдат върнати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array that contains the rows to be returned."
msgstr "Масивът, който съдържа редовете, които да бъдат върнати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array to expand."
msgstr "Масивът за разширяване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array which will be transformed."
msgstr "Масивът, който ще бъде трансформиран."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base (%s) must be between 2 and 36 inclusive."
msgstr "Основата (%s) трябва да е между 2 и 36 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base (%s) must be strictly positive."
msgstr "Основата (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base must be different from 1."
msgstr "Основата трябва да е различна от 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base of the logarithm."
msgstr "Основата на логаритъма."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base to convert the value from."
msgstr "Основата, от която да се преобразува стойността."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The baseline value is invalid"
msgstr "Базовата стойност е невалидна"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The case-sensitive format of the result, enclosed in quotation marks. "
"Examples: \"0.00\" rounded to 2 decimal places, \"hh:mm:ss\" for "
"hour:minutes:seconds."
msgstr ""
"Форматът на резултата с отчитане на регистъра, ограден в кавички. Примери: "
"\"0.00\" закръглено до 2 знака след десетичната запетая, \"hh:mm:ss\" за "
"часове:минути:секунди."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The case_sensitivity (%s) must be 0 or 1."
msgstr "case_sensitivity (%s) трябва да е 0 или 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The cashflow_amounts and cashflow_dates ranges must have the same dimensions."
msgstr ""
"Диапазоните cashflow_amounts и cashflow_dates трябва да имат еднакви размери."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The cell whose column number will be returned. Column A corresponds to 1. By "
"default, the function use the cell in which the formula is entered."
msgstr ""
"Клетката, чийто номер на колона ще бъде върнат. Колона A съответства на 1. "
"По подразбиране функцията използва клетката, в която е въведена формулата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The cell whose row number will be returned. By default, this function uses "
"the cell in which the formula is entered."
msgstr ""
"Клетката, чийто номер на ред ще бъде върнат. По подразбиране тази функция "
"използва клетката, в която е въведена формулата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cell you are trying to edit has been deleted."
msgstr "Клетката, която се опитвате да редактирате, е изтрита."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The character or characters to use to split text."
msgstr "Знакът или знаците, които да се използват за разделяне на текста."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The character or string to place between each concatenated value."
msgstr "Знакът или низът, който да се постави между всяка свързана стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The character within text_to_search at which to start the search."
msgstr "Знакът в text_to_search, при който да започне търсенето."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The chart definition is invalid for an unknown reason"
msgstr "Дефиницията на диаграмата е невалидна по неизвестна причина"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The column index of the value to be returned, where the first column in "
"range is numbered 1."
msgstr ""
"Индексът на колоната на стойността, която да бъде върната, където първата "
"колона в диапазона е номерирана с 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The column number (not name) of the cell reference. A is column number 1. "
msgstr ""
"Номерът на колоната (не името) на референцията на клетката. A е колона номер "
"1. "

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The columns argument (%s) must be strictly positive."
msgstr "Аргументът columns (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The columns arguments (%s) must be greater or equal than the number of "
"columns of the array."
msgstr ""
"Аргументите columns (%s) трябва да са по-големи или равни на броя колони на "
"масива."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The columns arguments must be between -%s and %s (got %s), excluding 0."
msgstr ""
"Аргументите columns трябва да са между -%s и %s (получено %s), с изключение "
"на 0."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The columns indexes of the columns to be returned."
msgstr "Индексите на колоните, които да бъдат върнати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/currency/formulas.js:0
msgid "The company to take the exchange rate from."
msgstr "Дружеството, от което да се вземе обменният курс."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The corresponding value to be returned if case1 matches expression."
msgstr ""
"Съответната стойност, която да бъде върната, ако case1 съвпада с израза."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cost (%s) must be positive or null."
msgstr "Цената (%s) трябва да е положителна или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cost (%s) must be strictly positive."
msgstr "Цената (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The covariance of a dataset."
msgstr "Ковариацията на набор от данни."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The criteria range contains %s row, it must be at least 2 rows."
msgstr "Диапазонът на критериите съдържа %s ред, той трябва да е поне 2 реда."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The current value of the annuity."
msgstr "Текущата стойност на анюитета."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The current window is too small to display this sheet properly. Consider "
"resizing your browser window or adjusting frozen rows and columns."
msgstr ""
"Текущият прозорец е твърде малък, за да се покаже коректно този лист. "
"Помислете за преоразмеряване на прозореца на браузъра или за коригиране на "
"замразените редове и колони."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data points to return the y values for on the ideal curve fit."
msgstr ""
"Точките с данни, за които да се върнат стойностите по y на идеалната "
"апроксимираща крива."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data range is invalid"
msgstr "Диапазонът от данни е невалиден"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to be filtered."
msgstr "Данните, които да бъдат филтрирани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to be sorted."
msgstr "Данните, които да бъдат сортирани."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to filter by unique entries."
msgstr "Данните, които да се филтрират по уникални записи."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The data view makes the carousel transparent, revealing the data underneath."
msgstr ""
"Изгледът с данни прави въртележката прозрачна, разкривайки данните отдолу."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The data you entered in %s violates the data validation rule set on the "
"cell:\n"
"%s"
msgstr ""
"Данните, които въведохте в %s, нарушават правилото за валидиране на данни, "
"зададено за клетката:\n"
"%s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The dataset is invalid"
msgstr "Наборът от данни е невалиден"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The date for which to determine the ISO week number. Must be a reference to "
"a cell containing a date, a function returning a date type, or a number."
msgstr ""
"Датата, за която да се определи ISO номерът на седмицата. Трябва да е "
"референция към клетка, съдържаща дата, функция, връщаща тип дата, или число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The date for which to determine the day of the week. Must be a reference to "
"a cell containing a date, a function returning a date type, or a number."
msgstr ""
"Датата, за която да се определи денят от седмицата. Трябва да е референция "
"към клетка, съдържаща дата, функция, връщаща тип дата, или число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The date for which to determine the week number. Must be a reference to a "
"cell containing a date, a function returning a date type, or a number."
msgstr ""
"Датата, за която да се определи номерът на седмицата. Трябва да е референция "
"към клетка, съдържаща дата, функция, връщаща тип дата, или число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to begin counting."
msgstr "Датата, от която да започне броенето."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the end of quarter."
msgstr "Датата, от която да се изчисли краят на тримесечието."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the end of the year."
msgstr "Датата, от която да се изчисли краят на годината."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the result."
msgstr "Датата, от която да се изчисли резултатът."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the start of quarter."
msgstr "Датата, от която да се изчисли началото на тримесечието."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the start of the year."
msgstr "Датата, от която да се изчисли началото на годината."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the day."
msgstr "Датата, от която да се извлече денят."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the month."
msgstr "Датата, от която да се извлече месецът."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the quarter."
msgstr "Датата, от която да се извлече тримесечието."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the year."
msgstr "Датата, от която да се извлече годината."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date the asset was purchased."
msgstr "Датата, на която е закупен активът."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date the first period ended."
msgstr "Датата, на която приключва първият период."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date the security was initially issued."
msgstr "Датата, на която ценната книга е първоначално емитирана."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date_string (%s) cannot be parsed to date/time."
msgstr "date_string (%s) не може да бъде разчетен като дата/час."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The day component of the date."
msgstr "Компонентът ден от датата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The day_count_convention (%s) must be between 0 and 4 inclusive."
msgstr "day_count_convention (%s) трябва да е между 0 и 4 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The delimiter (%s) must be not be empty."
msgstr "Разделителят (%s) не трябва да е празен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The delimiters cannot be empty values."
msgstr "Разделителите не могат да бъдат празни стойности."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The deprecation rate."
msgstr "Нормата на амортизация."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The depreciation factor (%s) must be strictly positive."
msgstr "Амортизационният коефициент (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The desired instance of the delimiter after which we extract the text. A "
"negative number searches from the end."
msgstr ""
"Желаното поредно срещане на разделителя, след което извличаме текста. "
"Отрицателно число търси от края."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The desired instance of the delimiter before which we extract the text. A "
"negative number searches from the end."
msgstr ""
"Желаното поредно срещане на разделителя, преди което извличаме текста. "
"Отрицателно число търси от края."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be different from -1."
msgstr "Отстъпката (%s) трябва да е различна от -1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be smaller than 1."
msgstr "Отстъпката (%s) трябва да е по-малка от 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be strictly positive."
msgstr "Отстъпката (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the bill at time of purchase."
msgstr "Сконтовият процент на съкровищния бон към момента на закупуване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the investment over one period."
msgstr "Сконтовият процент на инвестицията за един период."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the security at time of purchase."
msgstr "Сконтовият процент на ценната книга към момента на закупуване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the security invested in."
msgstr "Сконтовият процент на ценната книга, в която е инвестирано."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The divisor must be different from 0."
msgstr "Делителят трябва да е различен от 0."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The divisor must be different from zero."
msgstr "Делителят трябва да е различен от нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The effective interest rate per year."
msgstr "Ефективният годишен лихвен процент."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The effective_rate (%s) must be strictly positive."
msgstr "effective_rate (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date of the period from which to calculate the number of net working "
"days."
msgstr ""
"Крайната дата на периода, за който да се изчисли броят на нетните работни "
"дни."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end date to consider in the calculation."
msgstr "Крайната дата, която да се вземе предвид в изчислението."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date to consider in the calculation. Must be a reference to a cell "
"containing a DATE, a function returning a DATE type, or a number."
msgstr ""
"Крайната дата, която да се вземе предвид в изчислението. Трябва да е "
"референция към клетка, съдържаща DATE, функция, връщаща тип DATE, или число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date to consider in the calculation. Must be a reference to a cell "
"containing a date, a function returning a date type, or a number."
msgstr ""
"Крайната дата, която да се вземе предвид в изчислението. Трябва да е "
"референция към клетка, съдържаща дата, функция, връщаща тип дата, или число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end of the date range."
msgstr "Краят на диапазона от дати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end_date (%s) must be positive or null."
msgstr "end_date (%s) трябва да е положителна или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end_period (%(end)s) must be smaller or equal to the life (%(life)s)."
msgstr "end_period (%(end)s) трябва да е по-малък или равен на life (%(life)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end_period (%s) must be positive or null."
msgstr "end_period (%s) трябва да е положителен или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The expected annual yield of the security."
msgstr "Очакваната годишна доходност на ценната книга."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent (%s) must be an integer when the base is negative."
msgstr ""
"Експонентата (%s) трябва да е цяло число, когато основата е отрицателна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent to raise base to."
msgstr "Експонентата, на която да се повдигне основата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent to raise e."
msgstr "Експонентата, на която да се повдигне e."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The extract_length argument (%s) must be positive or null."
msgstr "Аргументът extract_length (%s) трябва да е положителен или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The factor (%s) must be positive when the value (%s) is positive."
msgstr ""
"Коефициентът (%s) трябва да е положителен, когато стойността (%s) е "
"положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The factor by which depreciation decreases."
msgstr "Коефициентът, с който намалява амортизацията."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_data_source.js:0
msgid "The field %s does not exist or you do not have access to that field"
msgstr "Полето %s не съществува или нямате достъп до това поле"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The field (%(fieldValue)s) must be one of %(dimRowDB)s or must be a number "
"between 1 and %s inclusive."
msgstr ""
"Полето (%(fieldValue)s) трябва да е едно от %(dimRowDB)s или трябва да е "
"число между 1 и %s включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The field (%s) must be one of %s."
msgstr "Полето (%s) трябва да е едно от %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The field must be a number or a string"
msgstr "Полето трябва да е число или низ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_functions.js:0
msgid "The field name should not be empty."
msgstr "Името на полето не трябва да е празно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The file you are trying to copy is too large (>%sMB).\n"
"It will not be added to your OS clipboard.\n"
"You can download it directly instead."
msgstr ""
"Файлът, който се опитвате да копирате, е твърде голям (>%sMB).\n"
"Той няма да бъде добавен към клипборда на вашата ОС.\n"
"Вместо това можете да го изтеглите директно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first addend."
msgstr "Първото събираемо."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first and second arguments of [[FUNCTION_NAME]] must be non-empty "
"matrices."
msgstr ""
"Първият и вторият аргумент на [[FUNCTION_NAME]] трябва да са непразни "
"матрици."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first case to be checked against expression."
msgstr "Първият случай, който да бъде проверен спрямо израза."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first column index of the columns to be returned."
msgstr "Индексът на първата колона от колоните, които да бъдат върнати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first condition to be evaluated. This can be a boolean, a number, an "
"array, or a reference to any of those."
msgstr ""
"Първото условие, което да бъде оценено. Това може да е булева стойност, "
"число, масив или референция към някоя от тях."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first future cash flow."
msgstr "Първият бъдещ паричен поток."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first matrix in the matrix multiplication operation."
msgstr "Първата матрица в операцията за умножение на матрици."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first multiplicand."
msgstr "Първият множител."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number in the sequence"
msgstr "Първото число в последователността"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number or range to add together."
msgstr "Първото число или диапазон, които да се съберат заедно."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number or range to calculate for the product."
msgstr "Първото число или диапазон, за които да се изчисли произведението."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number to compare."
msgstr "Първото число за сравнение."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first range to be appended."
msgstr "Първият диапазон, който да бъде добавен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first range to flatten."
msgstr "Първият диапазон, който да бъде сплеснат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first range whose entries will be multiplied with corresponding entries "
"in the other ranges."
msgstr ""
"Първият диапазон, чиито записи ще бъдат умножени със съответните записи в "
"другите диапазони."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first row index of the rows to be returned."
msgstr "Индексът на първия ред от редовете, които да бъдат върнати."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first string to compare."
msgstr "Първият низ за сравнение."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value must be a number"
msgstr "Първата стойност трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range in which to count the number of blanks."
msgstr ""
"Първата стойност или диапазон, в които да се преброи броят на празните "
"клетки."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range of the population."
msgstr "Първата стойност или диапазон на генералната съвкупност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range of the sample."
msgstr "Първата стойност или диапазон на извадката."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range to consider for uniqueness."
msgstr ""
"Първата стойност или диапазон, които да се вземат предвид за уникалност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the average value."
msgstr ""
"Първата стойност или диапазон, които да се вземат предвид при изчисляване на "
"средната стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the maximum value."
msgstr ""
"Първата стойност или диапазон, които да се вземат предвид при изчисляване на "
"максималната стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range to consider when calculating the median value."
msgstr ""
"Първата стойност или диапазон, които да се вземат предвид при изчисляване на "
"медианата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first value or range to consider when calculating the minimum value."
msgstr ""
"Първата стойност или диапазон, които да се вземат предвид при изчисляване на "
"минималната стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value or range to consider when counting."
msgstr "Първата стойност или диапазон, които да се вземат предвид при броене."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value."
msgstr "Първата стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first_period (%(first)s) must be smaller or equal to the last_period (%"
"(last)s)."
msgstr ""
"first_period (%(first)s) трябва да е по-малък или равен на last_period (%"
"(last)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first_period (%s) must be strictly positive."
msgstr "first_period (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit should be 'k', 'm' or 'b'."
msgstr "Единицата за форматиране трябва да е 'k', 'm' или 'b'."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit. Use 'k', 'm', or 'b' to force the unit"
msgstr ""
"Единицата за форматиране. Използвайте 'k', 'm' или 'b', за да наложите "
"единицата"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formula must be valid"
msgstr "Формулата трябва да е валидна"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The frequency (%s) must be one of %s"
msgstr "Честотата (%s) трябва да е една от %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The full URL of the link enclosed in quotation marks."
msgstr "Пълният URL адрес на връзката, ограден в кавички."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a boolean value, but '%s' is a text, "
"and cannot be coerced to a boolean."
msgstr ""
"Функцията [[FUNCTION_NAME]] очаква булева стойност, но '%s' е текст и не "
"може да бъде преобразуван в булева стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value between %s and %s "
"inclusive, but receives %s."
msgstr ""
"Функцията [[FUNCTION_NAME]] очаква числова стойност между %s и %s "
"включително, но получава %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value to be greater than or "
"equal to 1, but receives %s."
msgstr ""
"Функцията [[FUNCTION_NAME]] очаква числова стойност, която да е по-голяма "
"или равна на 1, но получава %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value, but '%s' is a string, "
"and cannot be coerced to a number."
msgstr ""
"Функцията [[FUNCTION_NAME]] очаква числова стойност, но '%s' е низ и не може "
"да бъде преобразуван в число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] has an argument with value '%s'. It should be "
"one of: %s."
msgstr ""
"Функцията [[FUNCTION_NAME]] има аргумент със стойност '%s'. Той трябва да е "
"един от: %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function [[FUNCTION_NAME]] result cannot be negative"
msgstr "Резултатът от функцията [[FUNCTION_NAME]] не може да е отрицателен"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] result must be greater than or equal "
"01/01/1900."
msgstr ""
"Резултатът от функцията [[FUNCTION_NAME]] трябва да е по-голям или равен на "
"01/01/1900."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function code (%s) must be between 1 to 11 or 101 to 111."
msgstr "Кодът на функцията (%s) трябва да е между 1 и 11 или 101 и 111."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function to use in subtotal aggregation."
msgstr "Функцията, която да се използва при агрегиране на междинните суми."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future value of the investment."
msgstr "Бъдещата стойност на инвестицията."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future value remaining after the final payment has been made."
msgstr "Бъдещата стойност, оставаща след извършването на последното плащане."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future_value (%s) must be strictly positive."
msgstr "future_value (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The header row of a table can't be moved."
msgstr "Заглавният ред на таблица не може да бъде преместен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The high (%s) must be greater than or equal to the low (%s)."
msgstr ""
"Високата стойност (%s) трябва да е по-голяма или равна на ниската стойност "
"(%s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The high end of the random range."
msgstr "Горната граница на случайния диапазон."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The hour component of the time."
msgstr "Компонентът час от времето."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index from the left of string from which to begin extracting. The first "
"character in string has the index 1."
msgstr ""
"Индексът отляво на низа, от който да започне извличането. Първият знак в "
"низа има индекс 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the column in range or a range outside of range containing the "
"values by which to sort."
msgstr ""
"Индексът на колоната в диапазона или диапазон извън диапазона, съдържащ "
"стойностите, по които да се сортира."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the column to be returned from within the reference range of "
"cells."
msgstr ""
"Индексът на колоната, която да бъде върната от референтния диапазон от "
"клетки."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the row to be returned from within the reference range of cells."
msgstr ""
"Индексът на реда, който да бъде върнат от референтния диапазон от клетки."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The info_type should be one of %s."
msgstr "info_type трябва да е един от %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The initial cost of the asset."
msgstr "Първоначалната стойност на актива."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The initial string."
msgstr "Първоначалният низ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The instance of search_for within text_to_search to replace with "
"replace_with. By default, all occurrences of search_for are replaced; "
"however, if occurrence_number is specified, only the indicated instance of "
"search_for is replaced."
msgstr ""
"Поредното срещане на search_for в text_to_search, което да се замени с "
"replace_with. По подразбиране се заменят всички срещания на search_for; "
"въпреки това, ако е зададено occurrence_number, се заменя само посоченото "
"срещане на search_for."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The instance_num (%s) must not be zero."
msgstr "instance_num (%s) не трябва да е нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The interest rate paid on funds invested."
msgstr "Лихвеният процент, платен върху инвестираните средства."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The interest rate."
msgstr "Лихвеният процент."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment (%s) must be strictly positive."
msgstr "Инвестицията (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment's current value."
msgstr "Текущата стойност на инвестицията."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment's desired future value."
msgstr "Желаната бъдеща стойност на инвестицията."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The issue (%s) must be positive or null."
msgstr "Емисията (%s) трябва да е положителна или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The key value is invalid"
msgstr "Ключовата стойност е невалидна"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/pivot/pivot_functions.js:0
msgid "The label of the filter whose value to return."
msgstr "Етикетът на филтъра, чиято стойност да бъде върната."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The last_period (%(last)s) must be smaller or equal to the number_of_periods "
"(%(nPeriods)s)."
msgstr ""
"last_period (%(last)s) трябва да е по-малък или равен на number_of_periods (%"
"(nPeriods)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The last_period (%s) must be strictly positive."
msgstr "last_period (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The length of the segment to extract."
msgstr "Дължината на сегмента, който да се извлече."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The life (%s) must be strictly positive."
msgstr "life (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, base e (euler's number)."
msgstr "Логаритъмът на число с основа e (числото на Ойлер)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, for a given base."
msgstr "Логаритъмът на число при дадена основа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The low end of the random range."
msgstr "Долната граница на случайния диапазон."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The lower inflection point value must be a number"
msgstr "Стойността на долната инфлексна точка трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The matrix is not invertible."
msgstr "Матрицата не е обратима."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maturity (%(maturity)s) must be strictly greater than the settlement (%"
"(settlement)s)."
msgstr ""
"Падежът (%(maturity)s) трябва да е строго по-голям от сетълмента (%"
"(settlement)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maturity date of the security."
msgstr "Падежната дата на ценната книга."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maturity or end date of the security, when it can be redeemed at face, "
"or par value."
msgstr ""
"Падежът или крайната дата на ценната книга, когато тя може да бъде изкупена "
"по номинал, или номинална стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum (%s) and minimum (%s) must be integers when whole_number is TRUE."
msgstr ""
"Максималната стойност (%s) и минималната стойност (%s) трябва да са цели "
"числа, когато whole_number е TRUE."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum (%s) must be greater than or equal to the minimum (%s)."
msgstr ""
"Максималната стойност (%s) трябва да е по-голяма или равна на минималната "
"стойност (%s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum number of cells for each column, rounded down to the nearest "
"whole number."
msgstr ""
"Максималният брой клетки за всяка колона, закръглен надолу до най-близкото "
"цяло число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum number of cells for each row, rounded down to the nearest whole "
"number."
msgstr ""
"Максималният брой клетки за всеки ред, закръглен надолу до най-близкото цяло "
"число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum number you would like returned."
msgstr "Максималното число, което бихте искали да бъде върнато."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum range limit value must be a number"
msgstr "Стойността на горната граница на диапазона трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maxpoint must be a number"
msgstr "Максималната точка трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/chart/odoo_chart/odoo_chart_helpers.js:0
msgid ""
"The menu linked to this chart doesn't have an corresponding action. Please "
"link the chart to another menu."
msgstr ""
"Менюто, свързано с тази диаграма, няма съответстващо действие. Моля, "
"свържете диаграмата с друго меню."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The midpoint must be a number"
msgstr "Средната точка трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minimum number you would like returned."
msgstr "Минималното число, което бихте искали да бъде върнато."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minimum range limit value must be a number"
msgstr "Стойността на долната граница на диапазона трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minpoint must be a number"
msgstr "Минималната точка трябва да е число"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minuend, or number to be subtracted from."
msgstr "Умаляемото или числото, от което да се извади."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minute component of the time."
msgstr "Компонентът минута от часа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/data_sources/data_source.js:0
#: code:addons/spreadsheet/static/src/pivot/odoo_pivot_loader.js:0
msgid "The model \"%(model)s\" does not exist."
msgstr "Моделът \"%(model)s\" не съществува."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/global_filters/components/filter_value/filter_value.js:0
msgid ""
"The model (%(model)s) of this global filter is not valid (it may have been "
"renamed/deleted)."
msgstr ""
"Моделът (%(model)s) на този глобален филтър не е валиден (възможно е да е "
"бил преименуван/изтрит)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The month (%s) must be between 1 and 12 inclusive."
msgstr "Месецът (%s) трябва да е между 1 и 12 включително."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The month component of the date."
msgstr "Компонентът месец от датата."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The net present value of an investment based on a series of periodic cash "
"flows and a discount rate."
msgstr ""
"Нетната настояща стойност на инвестиция, базирана на поредица от периодични "
"парични потоци и сконтов процент."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The nominal interest rate per year."
msgstr "Номиналният годишен лихвен процент."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The nominal_rate (%s) must be strictly positive."
msgstr "nominal_rate (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number for which to calculate the positive square root."
msgstr "Числото, за което да се изчисли положителният квадратен корен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters in the text to be replaced."
msgstr "Броят на знаците в текста, които да бъдат заменени."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters to return from the left side of string."
msgstr "Броят на знаците, които да се върнат от лявата страна на низа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters to return from the right side of string."
msgstr "Броят знаци, които да се върнат от дясната страна на низа."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns (%s) must be positive."
msgstr "Броят колони (%s) трябва да е положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns in the constrained array."
msgstr "Броят колони в ограничения масив."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns in the expanded array. If missing, columns will not be "
"expanded."
msgstr ""
"Броят колони в разширения масив. Ако липсва, колоните няма да бъдат "
"разширени."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns must be positive."
msgstr "Броят колони трябва да е положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns of the range to return starting at the offset target."
msgstr ""
"Броят колони от диапазона, които да се върнат, започвайки от целевото "
"отместване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to be returned."
msgstr "Броят колони, които да се върнат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to offset by."
msgstr "Броят колони за отместване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to return"
msgstr "Броят колони, които да се върнат"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of compounding periods per year."
msgstr "Броят на капитализационните периоди за година."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of days between start_date and end_date"
msgstr "Броят дни между start_date и end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of days between start_date and end_date after subtracting whole "
"months"
msgstr "Броят дни между start_date и end_date след изваждане на цели месеци"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of days between start_date and end_date, assuming start_date and "
"end_date were no more than one year apart"
msgstr ""
"Броят дни между start_date и end_date, ако приемем, че start_date и end_date "
"са на не повече от една година един от друг"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of decimal places to which to round."
msgstr "Броят десетични позиции, до които да се закръгли."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of interest or coupon payments per year (1, 2, or 4)."
msgstr "Броят лихвени или купонни плащания за година (1, 2 или 4)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of items to return."
msgstr "Броят елементи, които да се върнат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of months before (negative) or after (positive) 'start_date' to "
"calculate."
msgstr ""
"Броят месеци преди (отрицателно) или след (положително) 'start_date', които "
"да се изчислят."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of months before (negative) or after (positive) 'start_date' to "
"consider."
msgstr ""
"Броят месеци преди (отрицателно) или след (положително) 'start_date', които "
"да се вземат предвид."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of months in the first year of depreciation."
msgstr "Броят месеци в първата година на амортизация."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of numeric values in dataset."
msgstr "Броят числови стойности в набора от данни."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of payments to be made."
msgstr "Броят плащания, които да се извършат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods over which the asset is depreciated."
msgstr "Броят периоди, през които активът се амортизира."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods."
msgstr "Броят периоди."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows (%s) must be positive."
msgstr "Броят редове (%s) трябва да е положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows in the constrained array."
msgstr "Броят редове в ограничения масив."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows in the expanded array. If missing, rows will not be "
"expanded."
msgstr ""
"Броят редове в разширения масив. Ако липсва, редовете няма да бъдат "
"разширени."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows must be positive."
msgstr "Броят редове трябва да е положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows of the range to return starting at the offset target."
msgstr ""
"Броят редове от диапазона, които да се върнат, започвайки от целевото "
"отместване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to be returned."
msgstr "Броят редове, които да се върнат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to offset by."
msgstr "Броят редове за отместване."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to return"
msgstr "Броят редове, които да се върнат"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of significant digits to the right of the decimal point to retain."
msgstr "Броят значещи цифри вдясно от десетичната запетая, които да се запазят."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of the character to look up from the current Unicode table in "
"decimal format."
msgstr ""
"Номерът на знака, който да се потърси в текущата Unicode таблица в десетичен "
"формат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to begin the cumulative calculation."
msgstr ""
"Номерът на периода на плащане, от който да започне кумулативното изчисление."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to end the cumulative calculation."
msgstr ""
"Номерът на периода на плащане, на който да приключи кумулативното изчисление."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of values in a dataset."
msgstr "Броят стойности в набор от данни."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of which to return the absolute value."
msgstr "Числото, на което да се върне абсолютната стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole months between start_date and end_date"
msgstr "Броят цели месеци между start_date и end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of whole months between start_date and end_date after subtracting "
"whole years"
msgstr ""
"Броят цели месеци между start_date и end_date след изваждане на цели години"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole years between start_date and end_date"
msgstr "Броят цели години между start_date и end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of working days to advance from start_date. If negative, counts "
"backwards."
msgstr ""
"Броят работни дни за напредване от start_date. Ако е отрицателен, се брои "
"назад."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number pi."
msgstr "Числото пи."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided to find the remainder."
msgstr "Числото, което да се раздели, за да се намери остатъкът."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided."
msgstr "Числото, което да се раздели."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to convert."
msgstr "Числото, което да се преобразува."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to divide by."
msgstr "Числото, на което да се раздели."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to have its sign reversed. Equivalently, the number to multiply "
"by -1."
msgstr ""
"Числото, чийто знак да се обърне. Еквивалентно — числото, което да се умножи "
"по -1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to raise to the exponent power."
msgstr "Числото, което да се повдигне на степен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to return."
msgstr "Числото, което да се върне."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to round down to the nearest integer."
msgstr "Числото, което да се закръгли надолу до най-близкото цяло число."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples number will be rounded."
msgstr "Числото, до чиито кратни числото ще бъде закръглено."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to whose multiples number will be rounded. The sign of "
"significance will be ignored."
msgstr ""
"Числото, до чиито кратни числото ще бъде закръглено. Знакът на значимостта "
"ще бъде игнориран."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples value will be rounded."
msgstr "Числото, до чиито кратни стойността ще бъде закръглена."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number, date or time to format."
msgstr "Числото, датата или часът за форматиране."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number."
msgstr "Числото."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_characters (%s) must be positive or null."
msgstr "number_of_characters (%s) трябва да е положителен или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be different from zero."
msgstr "number_of_periods (%s) трябва да е различен от нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be strictly positive."
msgstr "number_of_periods (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The occurrenceNumber (%s) must be positive or null."
msgstr "occurrenceNumber (%s) трябва да е положителен или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The one-dimensional array to be searched."
msgstr "Едномерният масив, в който да се търси."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The order of the polynomial to fit the data, between 1 and 6."
msgstr "Степента на полинома за напасване на данните, между 1 и 6."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The other range whose entries will be multiplied with corresponding entries "
"in the other ranges."
msgstr ""
"Другият диапазон, чиито записи ще бъдат умножени със съответните записи в "
"другите диапазони."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range."
msgstr "Шаблонът или тестът, който да се приложи към criteria_range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The pattern or test to apply to criteria_range1, such that each cell that "
"evaluates to TRUE will be included in the filtered set."
msgstr ""
"Шаблонът или тестът, който да се приложи към criteria_range1, така че всяка "
"клетка, която се оценява като TRUE, да бъде включена във филтрирания набор."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range1."
msgstr "Шаблонът или тестът, който да се приложи към criteria_range1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range2."
msgstr "Шаблонът или тестът, който да се приложи към criteria_range2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to range."
msgstr "Шаблонът или тестът, който да се приложи към range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The percentile whose value within data will be calculated and returned."
msgstr "Процентилът, чиято стойност в data ще бъде изчислена и върната."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The percentile, exclusive of 0 and 1, whose value within 'data' will be "
"calculated and returned."
msgstr ""
"Процентилът, изключващ 0 и 1, чиято стойност в 'data' ще бъде изчислена и "
"върната."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal life (%(life)s)."
msgstr ""
"Периодът (%(period)s) трябва да е по-малък или равен на живота (%(life)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal to %(lifeLimit)s."
msgstr "Периодът (%(period)s) трябва да е по-малък или равен на %(lifeLimit)s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be positive or null."
msgstr "Периодът (%s) трябва да е положителен или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be strictly positive."
msgstr "Периодът (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period for which you want to view the interest payment."
msgstr "Периодът, за който искате да видите лихвеното плащане."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period must be between 1 and number_of_periods (%s)"
msgstr "Периодът трябва да е между 1 и number_of_periods (%s)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The periods_by_year (%s) must be strictly positive."
msgstr "periods_by_year (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains a reserved value"
msgstr ""
"Обобщаващата таблица не може да бъде създадена, защото клетка %s съдържа "
"запазена стойност"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains an error"
msgstr ""
"Обобщаващата таблица не може да бъде създадена, защото клетка %s съдържа "
"грешка"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s is empty"
msgstr "Обобщената таблица не може да бъде създадена, защото клетка %s е празна"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because the dataset is missing."
msgstr ""
"Обобщаващата таблица не може да бъде създадена, защото наборът от данни "
"липсва."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position (%s) must be greater than or equal to 1."
msgstr "Позицията (%s) трябва да е по-голяма или равна на 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position where the replacement will begin (starting from 1)."
msgstr "Позицията, на която ще започне замяната (започвайки от 1)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present value of the investment."
msgstr "Настоящата стойност на инвестицията."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present_value (%s) must be strictly positive."
msgstr "present_value (%s) трябва да е строго положителен."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price (%s) must be strictly positive."
msgstr "Цената (%s) трябва да е строго положителна."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought per 100 face value."
msgstr "Цената, на която ценната книга се купува на 100 номинална стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought."
msgstr "Цената, на която ценната книга се купува."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given as a decimal value."
msgstr "Котировката на цената, дадена като десетична стойност."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given using fractional decimal conventions."
msgstr "Котировката на цената, дадена с дробни десетични конвенции."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The purchase_date (%(purchaseDate)s) must be before the first_period_end (%"
"(firstPeriodEnd)s)."
msgstr ""
"purchase_date (%(purchaseDate)s) трябва да е преди first_period_end (%"
"(firstPeriodEnd)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The purchase_date (%s) must be positive or null."
msgstr "purchase_date (%s) трябва да е положителен или нула."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the dataset to consider."
msgstr "Диапазонът, съдържащ набора от данни, който да се вземе предвид."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range containing the return value. Should have the same dimensions as "
"lookup_range."
msgstr ""
"Диапазонът, съдържащ върнатата стойност. Трябва да има същите размери като "
"lookup_range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the set of classes."
msgstr "Диапазонът, съдържащ набора от класове."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range from which to return a result. The value returned corresponds to "
"the location where search_key is found in search_range. This range must be "
"only a single row or column and should not be used if using the "
"search_result_array method."
msgstr ""
"Диапазонът, от който да се върне резултат. Върнатата стойност съответства на "
"местоположението, където search_key се намира в search_range. Този диапазон "
"трябва да е само един ред или колона и не бива да се използва, ако се "
"прилага методът search_result_array."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is invalid"
