msgstr "Броят плащания, които да се извършат."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
msgid "The number of periods by year (%s) must strictly greater than 0."
msgstr ""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
#, python-format
