#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is invalid."
msgstr "Диапазонът е невалиден."

#. module: spreadsheet
#. odoo-javascript
