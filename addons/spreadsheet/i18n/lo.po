#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Text:"
msgstr "ຂໍ້ຄວາມ:"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amortization period, in terms of number of periods."
msgstr "ໄລຍະເວລາການຕັດຈ່າຍ, ຄິດໄລ່ຕາມຈຳນວນງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount invested (irrespective of face value of each security)."
msgstr "ຈຳນວນເງິນທີ່ລົງທຶນ (ບໍ່ຂຶ້ນກັບມູນຄ່າໜ້າປີ້ຂອງແຕ່ລະຫຼັກຊັບ)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount invested in the security."
msgstr "ຈຳນວນເງິນທີ່ລົງທຶນໃນຫຼັກຊັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount of each payment made."
msgstr "ຈຳນວນເງິນຂອງການຊຳລະແຕ່ລະງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount of initial capital or value to compound against."
msgstr "ຈຳນວນເງິນທຶນເລີ່ມຕົ້ນ ຫຼື ມູນຄ່າທີ່ຈະຄິດໄລ່ດອກເບ້ຍທົບຕົ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount per period to be paid."
msgstr "ຈຳນວນເງິນທີ່ຈະຕ້ອງຊຳລະຕໍ່ແຕ່ລະງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount to be received at maturity."
msgstr "ຈຳນວນເງິນທີ່ຈະໄດ້ຮັບເມື່ອຮອດກຳນົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The amount to increment each value in the sequence"
msgstr "ຈຳນວນຄ່າທີ່ຈະເພີ່ມຂຶ້ນໃນແຕ່ລະລຳດັບ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to convert from radians to degrees."
msgstr "ມຸມທີ່ຈະປ່ຽນຈາກເຣດຽນເປັນອົງສາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the cosecant of, in radians."
msgstr "ມຸມທີ່ຈະຊອກຫາຄ່າໂຄຊີແຄນ (cosecant), ເປັນຫົວໜ່ວຍເຣດຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the cosine of, in radians."
msgstr "ມຸມທີ່ຈະຊອກຫາຄ່າໂຄຊາຍ (cosine), ເປັນຫົວໜ່ວຍເຣດຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the cotangent of, in radians."
msgstr "ມຸມທີ່ຈະຊອກຫາຄ່າໂຄຕັງຊັງ (cotangent), ເປັນຫົວໜ່ວຍເຣດຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the secant of, in radians."
msgstr "ມຸມທີ່ຈະຊອກຫາຄ່າຊີແຄນ (secant), ເປັນຫົວໜ່ວຍເຣດຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the sine of, in radians."
msgstr "ມຸມທີ່ຈະຊອກຫາຄ່າຊາຍ (sine), ເປັນຫົວໜ່ວຍເຣດຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The angle to find the tangent of, in radians."
msgstr "ມຸມທີ່ຈະຊອກຫາຄ່າຕັງຊັງ (tangent), ເປັນຫົວໜ່ວຍເຣດຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The annualized rate of interest."
msgstr "ອັດຕາດອກເບ້ຍຕໍ່ປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The argument %s is not a valid measure. Here are the measures: %s"
msgstr "ອາຄິວເມັ້ນ %s ບໍ່ແມ່ນຕົວວັດແທກທີ່ຖືກຕ້ອງ. ນີ້ແມ່ນຕົວວັດແທກທີ່ມີ: %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The argument dimension must be positive"
msgstr "ມິຕິຂອງອາຄິວເມັ້ນຕ້ອງເປັນຄ່າບວກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The argument is missing. Please provide a value"
msgstr "ບໍ່ມີອາຄິວເມັ້ນ. ກະລຸນາໃສ່ຄ່າໃສ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The argument square_matrix must have the same number of columns and rows."
msgstr "ອາຄິວເມັ້ນ square_matrix ຕ້ອງມີຈຳນວນຖັນ ແລະ ແຖວເທົ່າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The arguments array_x and array_y must contain at least one pair of numbers."
msgstr "ອາຄິວເມັ້ນ array_x ແລະ array_y ຕ້ອງມີຄູ່ຕົວເລກຢ່າງໜ້ອຍໜຶ່ງຄູ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The arguments array_x and array_y must have the same dimensions."
msgstr "ອາຄິວເມັ້ນ array_x ແລະ array_y ຕ້ອງມີມິຕິເທົ່າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The arguments condition must be a single column or row."
msgstr "ອາຄິວເມັ້ນ condition ຕ້ອງເປັນພຽງຖັນດຽວ ຫຼື ແຖວດຽວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The arguments conditions must have the same dimensions."
msgstr "ອາຄິວເມັ້ນ conditions ຕ້ອງມີມິຕິເທົ່າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array from which to drop rows or columns"
msgstr "ອາເຣທີ່ຈະຕັດແຖວ ຫຼື ຖັນອອກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array from which to take rows or columns."
msgstr "ອາເຣທີ່ຈະດຶງເອົາແຖວ ຫຼື ຖັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array of ranges containing the values to be counted."
msgstr "ອາເຣຂອງຊ່ວງຂໍ້ມູນທີ່ມີຄ່າທີ່ຈະນັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range containing dependent (y) values that are already known, "
"used to curve fit an ideal exponential growth curve."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ມີຄ່າຕົວປ່ຽນຕາມ (y) ທີ່ຮູ້ນຳແລ້ວ, ໃຊ້ສຳລັບການປັບເສັ້ນໂຄ້ງການເຕີບໂຕແບບທະວີຄູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range containing dependent (y) values that are already known, "
"used to curve fit an ideal linear trend."
msgstr "ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ມີຄ່າຕົວປ່ຽນຕາມ (y) ທີ່ຮູ້ນຳແລ້ວ, ໃຊ້ສຳລັບການປັບເສັ້ນແນວໂນ້ມແບບເສັ້ນຊື່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range containing the data to consider, structured in such a way "
"that the first row contains the labels for each column's values."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ປະກອບດ້ວຍຂໍ້ມູນທີ່ຈະພິຈາລະນາ, ໂດຍມີໂຄງສ້າງທີ່ແຖວທຳອິດເປັນຫົວຂໍ້ຂອງຄ່າໃນແຕ່ລະຖັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array or range containing the dataset to consider."
msgstr "ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ປະກອບດ້ວຍຊຸດຂໍ້ມູນທີ່ຈະພິຈາລະນາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values that will be reduced by corresponding entries "
"in array_y, squared, and added together."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ຈະຖືກລົບອອກດ້ວຍຄ່າທີ່ກົງກັນໃນ array_y, ຂຶ້ນກຳລັງສອງ, ແລ້ວນຳມາບວກເຂົ້າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values that will be subtracted from corresponding "
"entries in array_x, the result squared, and all such results added together."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ຈະຖືກລົບອອກຈາກຄ່າທີ່ກົງກັນໃນ array_x, ເອົາຜົນໄດ້ຮັບມາຂຶ້ນກຳລັງສອງ, "
"ແລ້ວນຳຜົນທັງໝົດມາບວກເຂົ້າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be added to the squares of "
"corresponding entries in array_x and added together."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ຈະນຳກຳລັງສອງໄປບວກໃສ່ກັບກຳລັງສອງຂອງຄ່າທີ່ກົງກັນໃນ array_x "
"ແລ້ວນຳມາບວກເຂົ້າກັນທັງໝົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be added to the squares of "
"corresponding entries in array_y and added together."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ຈະນຳກຳລັງສອງໄປບວກໃສ່ກັບກຳລັງສອງຂອງຄ່າທີ່ກົງກັນໃນ array_y "
"ແລ້ວນຳມາບວກເຂົ້າກັນທັງໝົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be reduced by the squares of "
"corresponding entries in array_y and added together."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ຈະນຳກຳລັງສອງມາລົບອອກດ້ວຍກຳລັງສອງຂອງຄ່າທີ່ກົງກັນໃນ array_y "
"ແລ້ວນຳມາບວກເຂົ້າກັນທັງໝົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The array or range of values whose squares will be subtracted from the "
"squares of corresponding entries in array_x and added together."
msgstr ""
"ອາເຣ ຫຼື ຊ່ວງຂໍ້ມູນທີ່ຈະນຳກຳລັງສອງໄປລົບອອກຈາກກຳລັງສອງຂອງຄ່າທີ່ກົງກັນໃນ array_x "
"ແລ້ວນຳມາບວກເຂົ້າກັນທັງໝົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array that contains the columns to be returned."
msgstr "ອາເຣທີ່ບັນຈຸຖັນທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array that contains the rows to be returned."
msgstr "ອາເຣທີ່ບັນຈຸແຖວທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array to convert into text"
msgstr "ອາເຣທີ່ຈະປ່ຽນເປັນຂໍ້ຄວາມ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array to expand."
msgstr "ອາເຣທີ່ຈະຂະຫຍາຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The array which will be transformed."
msgstr "ອາເຣທີ່ຈະຖືກແປງຮູບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base (%s) must be between 2 and 36 inclusive."
msgstr "ຖານ (%s) ຕ້ອງຢູ່ລະຫວ່າງ 2 ຫາ 36."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base (%s) must be strictly positive."
msgstr "ຖານ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base must be different from 1."
msgstr "ຖານຕ້ອງຕ່າງຈາກ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base of the logarithm."
msgstr "ຖານຂອງໂລກາຣິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The base to convert the value from."
msgstr "ຖານເລີ່ມຕົ້ນທີ່ຈະປ່ຽນຄ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The bubble sizes range is invalid"
msgstr "ຊ່ວງຂະໜາດຟອງສະແດງຜົນບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The case-sensitive format of the result, enclosed in quotation marks. "
"Examples: \"0.00\" rounded to 2 decimal places, \"hh:mm:ss\" for "
"hour:minutes:seconds."
msgstr ""
"ຮູບແບບຜົນໄດ້ຮັບທີ່ແຍກຕົວພິມນ້ອຍ-ໃຫຍ່ ໂດຍຢູ່ໃນເຄື່ອງໝາຍຢືມ. ຕົວຢ່າງ: \"0.00\" ປັດເສດທົດສະນິຍົມ 2 "
"ຕຳແໜ່ງ, \"hh:mm:ss\" ສຳລັບ ຊົ່ວໂມງ:ນາທີ:ວິນາທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The case_sensitivity (%s) must be 0 or 1."
msgstr "case_sensitivity (%s) ຕ້ອງເປັນ 0 ຫຼື 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The cashflow_amounts and cashflow_dates ranges must have the same dimensions."
msgstr "ຊ່ວງຂໍ້ມູນ cashflow_amounts ແລະ cashflow_dates ຕ້ອງມີມິຕິເທົ່າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cell does not contain a formula."
msgstr "ເຊວນີ້ບໍ່ມີສູດຄິດໄລ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The cell whose column number will be returned. Column A corresponds to 1. By "
"default, the function use the cell in which the formula is entered."
msgstr "ເຊວທີ່ຈະສົ່ງຄ່າເລກຖັນກັບຄືນ. ຖັນ A ກົງກັບ 1. ໂດຍຄ່າເລີ່ມຕົ້ນ, ຟັງຊັນຈະໃຊ້ເຊວທີ່ປ້ອນສູດໃສ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The cell whose row number will be returned. By default, this function uses "
"the cell in which the formula is entered."
msgstr "ເຊວທີ່ຈະສົ່ງຄ່າເລກແຖວກັບຄືນ. ໂດຍຄ່າເລີ່ມຕົ້ນ, ຟັງຊັນນີ້ຈະໃຊ້ເຊວທີ່ປ້ອນສູດໃສ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cell you are trying to edit has been deleted."
msgstr "ເຊວທີ່ທ່ານພະຍາຍາມແກ້ໄຂນັ້ນຖືກລຶບໄປແລ້ວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The character or characters to use to split text."
msgstr "ຕົວອັກສອນທີ່ຈະໃຊ້ເພື່ອແຍກຂໍ້ຄວາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The character or string to place between each concatenated value."
msgstr "ຕົວອັກສອນ ຫຼື ຂໍ້ຄວາມທີ່ຈະໃສ່ຂັ້ນລະຫວ່າງແຕ່ລະຄ່າທີ່ນຳມາຕໍ່ກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The character within text_to_search at which to start the search."
msgstr "ຕຳແໜ່ງຕົວອັກສອນໃນ text_to_search ທີ່ຈະເລີ່ມຕົ້ນການຊອກຫາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The chart definition is invalid for an unknown reason"
msgstr "ການກຳນົດຄ່າແຜນພູມບໍ່ຖືກຕ້ອງ ຍ້ອນສາເຫດທີ່ບໍ່ສາມາດລະບຸໄດ້"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "The chart is deactivated"
msgstr ""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The column index of the column to be returned."
msgstr "ດັດຊະນີຂອງຖັນທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The column index of the value to be returned, where the first column in "
"range is numbered 1."
msgstr "ດັດຊະນີຖັນຂອງຄ່າທີ່ຈະສົ່ງຄືນ, ໂດຍຖັນທຳອິດໃນຊ່ວງຂໍ້ມູນຈະເປັນເລກ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The column number (not name) of the cell reference. A is column number 1. "
msgstr "ໝາຍເລກຖັນ (ບໍ່ແມ່ນຊື່ຖັນ) ຂອງເຊວອ້າງອີງ. A ແມ່ນຖັນເລກ 1. "

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The columns argument (%s) must be strictly positive."
msgstr "ອາຄິວເມັ້ນຖັນ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The columns arguments (%s) must be greater or equal than the number of "
"columns of the array."
msgstr "ອາຄິວເມັ້ນຖັນ (%s) ຕ້ອງໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ ຈຳນວນຖັນຂອງອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The columns arguments must be between -%s and %s (got %s), excluding 0."
msgstr "ອາຄິວເມັ້ນຖັນຕ້ອງຢູ່ລະຫວ່າງ -%s ຫາ %s (ໄດ້ຮັບ %s), ໂດຍບໍ່ລວມເລກ 0."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/currency/formulas.js:0
msgid "The company to take the exchange rate from."
msgstr "ບໍລິສັດທີ່ຈະດຶງເອົາອັດຕາແລກປ່ຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The condition to be evaluated. It can be a boolean, a number, an array, or a "
"reference to any of those."
msgstr "ເງື່ອນໄຂທີ່ຈະປະເມີນ. ສາມາດເປັນຄ່າບູນລີນ, ຕົວເລກ, ອາເຣ ຫຼື ການອ້າງອີງເຖິງຄ່າເຫຼົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cost (%s) must be positive or null."
msgstr "ຕົ້ນທຶນ (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The cost (%s) must be strictly positive."
msgstr "ຕົ້ນທຶນ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The covariance of a dataset."
msgstr "ຄ່າໂຄແວຣຽນ (covariance) ຂອງຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The criteria range contains %s row, it must be at least 2 rows."
msgstr "ຊ່ວງຂໍ້ມູນເງື່ອນໄຂມີ %s ແຖວ, ແຕ່ຕ້ອງມີຢ່າງໜ້ອຍ 2 ແຖວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The current value of the annuity."
msgstr "ມູນຄ່າປັດຈຸບັນຂອງເງິນງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The current window is too small to display this sheet properly. Consider "
"resizing your browser window or adjusting frozen rows and columns."
msgstr ""
"ໜ້າຕ່າງປັດຈຸບັນມີຂະໜາດນ້ອຍເກີນໄປທີ່ຈະສະແດງແຜ່ນວຽກນີ້ຢ່າງຖືກຕ້ອງ. ກະລຸນາຂະຫຍາຍໜ້າຕ່າງບຣາວເຊີ ຫຼື "
"ປັບປ່ຽນແຖວ ແລະ ຖັນທີ່ຖືກຕຶງໄວ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data points to return the y values for on the ideal curve fit."
msgstr "ຈຸດຂໍ້ມູນທີ່ຈະສົ່ງຄ່າ y ກັບຄືນສຳລັບເສັ້ນໂຄ້ງທີ່ເໝາະສົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data range is invalid"
msgstr "ຊ່ວງຂໍ້ມູນບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to average."
msgstr "ຂໍ້ມູນທີ່ຈະຄິດໄລ່ຫາຄ່າສະເລ່ຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to be filtered."
msgstr "ຂໍ້ມູນທີ່ຈະນຳມາກັ່ນຕອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to be sorted."
msgstr "ຂໍ້ມູນທີ່ຈະນຳມາຈັດລຽງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The data to filter by unique entries."
msgstr "ຂໍ້ມູນທີ່ຈະກັ່ນຕອງຕາມລາຍການທີ່ບໍ່ຊ້ຳກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The data you entered in %s violates the data validation rule set on the "
"cell:\n"
"%s"
msgstr ""
"ຂໍ້ມູນທີ່ທ່ານປ້ອນໃສ່ໃນ %s ຂັດກັບກົດການກວດສອບຄວາມຖືກຕ້ອງຂອງຂໍ້ມູນທີ່ຕັ້ງໄວ້ໃນເຊວ:\n"
"%s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The dataset is invalid"
msgstr "ຊຸດຂໍ້ມູນບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The date for which to determine the ISO week number. Must be a reference to "
"a cell containing a date, a function returning a date type, or a number."
msgstr ""
"ວັນທີທີ່ຈະກຳນົດເລກອາທິດ ISO. ຕ້ອງເປັນການອ້າງອີງເຖິງເຊວທີ່ມີວັນທີ, ຟັງຊັນທີ່ສົ່ງຄ່າປະເພດວັນທີ, ຫຼື ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The date for which to determine the day of the week. Must be a reference to "
"a cell containing a date, a function returning a date type, or a number."
msgstr ""
"ວັນທີທີ່ຈະກຳນົດວັນໃນອາທິດ. ຕ້ອງເປັນການອ້າງອີງເຖິງເຊວທີ່ມີວັນທີ, ຟັງຊັນທີ່ສົ່ງຄ່າປະເພດວັນທີ, ຫຼື ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The date for which to determine the week number. Must be a reference to a "
"cell containing a date, a function returning a date type, or a number."
msgstr ""
"ວັນທີທີ່ຈະກຳນົດເລກລຳດັບອາທິດ. ຕ້ອງເປັນການອ້າງອີງເຖິງເຊວທີ່ມີວັນທີ, ຟັງຊັນທີ່ສົ່ງຄ່າປະເພດວັນທີ, ຫຼື ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to begin counting."
msgstr "ວັນທີທີ່ຈະເລີ່ມຕົ້ນນັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the end of quarter."
msgstr "ວັນທີທີ່ຈະຄິດໄລ່ວັນສິ້ນສຸດໄຕມາດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the end of the year."
msgstr "ວັນທີທີ່ຈະຄິດໄລ່ວັນສິ້ນສຸດປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the result."
msgstr "ວັນທີທີ່ຈະຄິດໄລ່ຫາຜົນໄດ້ຮັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the start of quarter."
msgstr "ວັນທີທີ່ຈະຄິດໄລ່ວັນເລີ່ມຕົ້ນໄຕມາດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to calculate the start of the year."
msgstr "ວັນທີທີ່ຈະຄິດໄລ່ວັນເລີ່ມຕົ້ນປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the day."
msgstr "ວັນທີທີ່ຈະດຶງເອົາຄ່າຂອງມື້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the month."
msgstr "ວັນທີທີ່ຈະດຶງເອົາຄ່າຂອງເດືອນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the quarter."
msgstr "ວັນທີທີ່ຈະດຶງເອົາຄ່າຂອງໄຕມາດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date from which to extract the year."
msgstr "ວັນທີທີ່ຈະດຶງເອົາຄ່າຂອງປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date the asset was purchased."
msgstr "ວັນທີທີ່ຊື້ຊັບສິນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date the first period ended."
msgstr "ວັນທີສິ້ນສຸດງວດທຳອິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date the security was initially issued."
msgstr "ວັນທີອອກຫຼັກຊັບໃນຄັ້ງທຳອິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The date_string (%s) cannot be parsed to date/time."
msgstr "ບໍ່ສາມາດປ່ຽນ date_string (%s) ເປັນວັນທີ/ເວລາໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The day component of the date."
msgstr "ສ່ວນປະກອບຂອງມື້ໃນວັນທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The day_count_convention (%s) must be between 0 and 4 inclusive."
msgstr "day_count_convention (%s) ຕ້ອງຢູ່ລະຫວ່າງ 0 ຫາ 4."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The degrees of freedom."
msgstr "ລະດັບຄວາມເປັນອິດສະຫຼະ (degrees of freedom)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The delimiter (%s) must be not be empty."
msgstr "ຕົວຂັ້ນ (%s) ຕ້ອງບໍ່ຫວ່າງເປົ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The delimiters cannot be empty values."
msgstr "ຕົວຂັ້ນບໍ່ສາມາດເປັນຄ່າຫວ່າງເປົ່າໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The deprecation rate."
msgstr "ອັດຕາຄ່າຫຼຸ້ຍຫ້ຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The depreciation factor (%s) must be strictly positive."
msgstr "ຕົວຄູນຄ່າຫຼຸ້ຍຫ້ຽນ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The desired instance of the delimiter after which we extract the text. A "
"negative number searches from the end."
msgstr "ລຳດັບຂອງຕົວຂັ້ນທີ່ຕ້ອງການ ເຊິ່ງຈະດຶງຂໍ້ຄວາມຫຼັງຈາກນັ້ນອອກມາ. ຖ້າເປັນຄ່າລົບຈະຊອກຫາຈາກທ້າຍສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The desired instance of the delimiter before which we extract the text. A "
"negative number searches from the end."
msgstr "ລຳດັບຂອງຕົວຂັ້ນທີ່ຕ້ອງການ ເຊິ່ງຈະດຶງຂໍ້ຄວາມກ່ອນໜ້ານັ້ນອອກມາ. ຖ້າເປັນຄ່າລົບຈະຊອກຫາຈາກທ້າຍສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be different from -1."
msgstr "ສ່ວນຫຼຸດ (%s) ຕ້ອງຕ່າງຈາກ -1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be smaller than 1."
msgstr "ສ່ວນຫຼຸດ (%s) ຕ້ອງນ້ອຍກວ່າ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount (%s) must be strictly positive."
msgstr "ສ່ວນຫຼຸດ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the bill at time of purchase."
msgstr "ອັດຕາສ່ວນຫຼຸດຂອງໃບຮຽກເກັບເງິນໃນເວລາຊື້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the investment over one period."
msgstr "ອັດຕາສ່ວນຫຼຸດຂອງການລົງທຶນໃນໜຶ່ງງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the security at time of purchase."
msgstr "ອັດຕາສ່ວນຫຼຸດຂອງຫຼັກຊັບໃນເວລາຊື້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The discount rate of the security invested in."
msgstr "ອັດຕາສ່ວນຫຼຸດຂອງຫຼັກຊັບທີ່ລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The divisor must be different from 0."
msgstr "ຕົວຫານຕ້ອງຕ່າງຈາກ 0."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The divisor must be different from zero."
msgstr "ຕົວຫານຕ້ອງຕ່າງຈາກສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The effective interest rate per year."
msgstr "ອັດຕາດອກເບ້ຍທີ່ແທ້ຈິງຕໍ່ປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The effective_rate (%s) must be strictly positive."
msgstr "effective_rate (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date of the period from which to calculate the number of net working "
"days."
msgstr "ວັນທີສິ້ນສຸດຂອງໄລຍະເວລາ ທີ່ຈະໃຊ້ຄິດໄລ່ຈຳນວນມື້ເຮັດວຽກຕົວຈິງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end date to consider in the calculation."
msgstr "ວັນທີສິ້ນສຸດທີ່ຈະພິຈາລະນາໃນການຄິດໄລ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date to consider in the calculation. Must be a reference to a cell "
"containing a DATE, a function returning a DATE type, or a number."
msgstr ""
"ວັນທີສິ້ນສຸດທີ່ຈະພິຈາລະນາໃນການຄິດໄລ່. ຕ້ອງເປັນການອ້າງອີງເຖິງເຊວທີ່ມີ DATE, ຟັງຊັນທີ່ສົ່ງຄ່າປະເພດ "
"DATE, ຫຼື ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end date to consider in the calculation. Must be a reference to a cell "
"containing a date, a function returning a date type, or a number."
msgstr ""
"ວັນທີສິ້ນສຸດທີ່ຈະພິຈາລະນາໃນການຄິດໄລ່. ຕ້ອງເປັນການອ້າງອີງເຖິງເຊວທີ່ມີວັນທີ, ຟັງຊັນທີ່ສົ່ງຄ່າປະເພດວັນທີ, ຫຼື "
"ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end of the date range."
msgstr "ວັນທີສິ້ນສຸດຂອງຊ່ວງວັນທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end_date (%s) must be positive or null."
msgstr "end_date (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The end_period (%(end)s) must be smaller or equal to the life (%(life)s)."
msgstr "end_period (%(end)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ ອາຍຸການໃຊ້ງານ (%(life)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The end_period (%s) must be positive or null."
msgstr "end_period (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The expected annual yield of the security."
msgstr "ຜົນຕອບແທນປະຈຳປີທີ່ຄາດຫວັງຂອງຫຼັກຊັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent (%s) must be an integer when the base is negative."
msgstr "ກຳລັງ (%s) ຕ້ອງເປັນຈຳນວນຖ້ວນ ເມື່ອຖານເປັນຄ່າລົບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent to raise base to."
msgstr "ກຳລັງທີ່ຈະຍົກຖານຂຶ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The exponent to raise e."
msgstr "ກຳລັງທີ່ຈະຍົກ e ຂຶ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The extract_length argument (%s) must be positive or null."
msgstr "ອາຄິວເມັ້ນ extract_length (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The factor (%s) must be positive when the value (%s) is positive."
msgstr "ຕົວຄູນ (%s) ຕ້ອງເປັນຄ່າບວກ ເມື່ອຄ່າ (%s) ເປັນຄ່າບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The factor by which depreciation decreases."
msgstr "ອັດຕາສ່ວນທີ່ຄ່າຫຼຸ້ຍຫ້ຽນຫຼຸດລົງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_data_source.js:0
msgid "The field %s does not exist or you do not have access to that field"
msgstr "ບໍ່ມີຟິວ %s ນີ້ ຫຼື ທ່ານບໍ່ມີສິດເຂົ້າເຖິງຟິວດັ່ງກ່າວ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The field (%(fieldValue)s) must be one of %(dimRowDB)s or must be a number "
"between 1 and %s inclusive."
msgstr ""
"ຟິວ (%(fieldValue)s) ຕ້ອງແມ່ນໜຶ່ງໃນ %(dimRowDB)s ຫຼື ຕ້ອງເປັນຕົວເລກລະຫວ່າງ 1 ຫາ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The field (%s) must be one of %s."
msgstr "ຟິວ (%s) ຕ້ອງແມ່ນໜຶ່ງໃນ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The field must be a number or a string"
msgstr "ຟິວຕ້ອງເປັນຕົວເລກ ຫຼື ຂໍ້ຄວາມ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_functions.js:0
msgid "The field name should not be empty."
msgstr "ຊື່ຟິວບໍ່ຄວນຫວ່າງເປົ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The file you are trying to copy is too large (>%sMB).\n"
"It will not be added to your OS clipboard.\n"
"You can download it directly instead."
msgstr ""
"ໄຟລ໌ທີ່ທ່ານພະຍາຍາມສຳເນົາມີຂະໜາດໃຫຍ່ເກີນໄປ (>%sMB).\n"
"ຂໍ້ມູນຈະບໍ່ຖືກເພີ່ມໃສ່ຄລິບບອດຂອງລະບົບປະຕິບັດການ.\n"
"ທ່ານສາມາດດາວໂຫຼດໄຟລ໌ໂດຍກົງແທນໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first addend."
msgstr "ຕົວເລກບວກຕົວທຳອິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first and second arguments of [[FUNCTION_NAME]] must be non-empty "
"matrices."
msgstr "ອາຄິວເມັ້ນທຳອິດ ແລະ ທີສອງຂອງ [[FUNCTION_NAME]] ຕ້ອງເປັນມາຕຣິກທີ່ບໍ່ຫວ່າງເປົ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first matrix in the matrix multiplication operation."
msgstr "ມາຕຣິກທຳອິດໃນການຄູນມາຕຣິກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first multiplicand."
msgstr "ຕົວຕັ້ງຄູນທຳອິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number in the sequence"
msgstr "ຕົວເລກທຳອິດໃນລຳດັບ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first number to compare."
msgstr "ຕົວເລກທຳອິດທີ່ຈະປຽບທຽບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first sample."
msgstr "ກຸ່ມຕົວຢ່າງທຳອິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first string to compare."
msgstr "ຂໍ້ຄວາມທຳອິດທີ່ຈະປຽບທຽບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value must be a number"
msgstr "ຄ່າທຳອິດຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first value."
msgstr "ຄ່າທຳອິດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The first_period (%(first)s) must be smaller or equal to the last_period (%"
"(last)s)."
msgstr "first_period (%(first)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ last_period (%(last)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The first_period (%s) must be strictly positive."
msgstr "first_period (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The format entered is not valid."
msgstr "ຮູບແບບທີ່ປ້ອນໃສ່ບໍ່ຖືກຕ້ອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The format of the returned data."
msgstr "ຮູບແບບຂອງຂໍ້ມູນທີ່ຈະສົ່ງຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit should be 'k', 'm' or 'b'."
msgstr "ຫົວໜ່ວຍຮູບແບບຄວນເປັນ 'k', 'm' ຫຼື 'b'."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formatting unit. Use 'k', 'm', or 'b' to force the unit"
msgstr "ຫົວໜ່ວຍຮູບແບບ. ໃຊ້ 'k', 'm', ຫຼື 'b' ເພື່ອກຳນົດຫົວໜ່ວຍ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The formula must be valid"
msgstr "ສູດຕ້ອງຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The frequency (%s) must be one of %s"
msgstr "ຄວາມຖີ່ (%s) ຕ້ອງແມ່ນໜຶ່ງໃນ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The full URL of the link enclosed in quotation marks."
msgstr "URL ເຕັມຂອງລິ້ງທີ່ຢູ່ໃນເຄື່ອງໝາຍຢືມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a boolean value, but '%s' is a text, "
"and cannot be coerced to a boolean."
msgstr ""
"ຟັງຊັນ [[FUNCTION_NAME]] ຕ້ອງການຄ່າບູນລີນ, ແຕ່ '%s' ເປັນຂໍ້ຄວາມ ແລະ ບໍ່ສາມາດແປງເປັນບູນລີນໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value between %s and %s "
"inclusive, but receives %s."
msgstr "ຟັງຊັນ [[FUNCTION_NAME]] ຕ້ອງການຄ່າຕົວເລກລະຫວ່າງ %s ຫາ %s, ແຕ່ໄດ້ຮັບ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value to be greater than or "
"equal to 1, but receives %s."
msgstr "ຟັງຊັນ [[FUNCTION_NAME]] ຕ້ອງການຄ່າຕົວເລກທີ່ໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ 1, ແຕ່ໄດ້ຮັບ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] expects a number value, but '%s' is a string, "
"and cannot be coerced to a number."
msgstr ""
"ຟັງຊັນ [[FUNCTION_NAME]] ຕ້ອງການຄ່າຕົວເລກ, ແຕ່ '%s' ເປັນຂໍ້ຄວາມ ແລະ "
"ບໍ່ສາມາດແປງເປັນຕົວເລກໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function [[FUNCTION_NAME]] expects a reference to a cell or range."
msgstr "ຟັງຊັນ [[FUNCTION_NAME]] ຕ້ອງການການອ້າງອີງເຖິງເຊວ ຫຼື ຊ່ວງຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] has an argument with value '%s'. It should be "
"one of: %s."
msgstr "ຟັງຊັນ [[FUNCTION_NAME]] ມີອາຄິວເມັ້ນທີ່ມີຄ່າ '%s'. ມັນຄວນແມ່ນໜຶ່ງໃນ: %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function [[FUNCTION_NAME]] result cannot be negative"
msgstr "ຜົນໄດ້ຮັບຂອງຟັງຊັນ [[FUNCTION_NAME]] ບໍ່ສາມາດເປັນຄ່າລົບໄດ້"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The function [[FUNCTION_NAME]] result must be greater than or equal "
"01/01/1900."
msgstr "ຜົນໄດ້ຮັບຂອງຟັງຊັນ [[FUNCTION_NAME]] ຕ້ອງໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ 01/01/1900."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function code (%s) must be between 1 to 11 or 101 to 111."
msgstr "ລະຫັດຟັງຊັນ (%s) ຕ້ອງຢູ່ລະຫວ່າງ 1 ຫາ 11 ຫຼື 101 ຫາ 111."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The function to use in subtotal aggregation."
msgstr "ຟັງຊັນທີ່ຈະໃຊ້ໃນການລວມຍອດຍ່ອຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future cash flows."
msgstr "ກະແສເງິນສົດໃນອະນາຄົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future value of the investment."
msgstr "ມູນຄ່າໃນອະນາຄົດຂອງການລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future value remaining after the final payment has been made."
msgstr "ມູນຄ່າໃນອະນາຄົດທີ່ເຫຼືອຫຼັງຈາກການຊຳລະງວດສຸດທ້າຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The future_value (%s) must be strictly positive."
msgstr "future_value (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The header row of a table can't be moved."
msgstr "ແຖວຫົວຕາຕະລາງບໍ່ສາມາດຍ້າຍໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The high (%s) must be greater than or equal to the low (%s)."
msgstr "ຄ່າສູງສຸດ (%s) ຕ້ອງໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ ຄ່າຕ່ຳສຸດ (%s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The high end of the random range."
msgstr "ຄ່າສູງສຸດຂອງຊ່ວງການສຸ່ມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The horizontal axis values range is invalid"
msgstr "ຊ່ວງຄ່າຂອງແກນນອນບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The hour component of the time."
msgstr "ສ່ວນປະກອບຂອງຊົ່ວໂມງໃນເວລາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index from the left of string from which to begin extracting. The first "
"character in string has the index 1."
msgstr "ດັດຊະນີຈາກເບື້ອງຊ້າຍຂອງຂໍ້ຄວາມທີ່ຈະເລີ່ມຕົ້ນດຶງ. ຕົວອັກສອນທຳອິດໃນຂໍ້ຄວາມມີດັດຊະນີແມ່ນ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the column in range or a range outside of range containing the "
"value by which to sort."
msgstr "ດັດຊະນີຂອງຖັນໃນຊ່ວງຂໍ້ມູນ ຫຼື ຊ່ວງຂໍ້ມູນພາຍນອກ ທີ່ມີຄ່າທີ່ຕ້ອງການນຳມາຈັດລຽງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the column to be returned from within the reference range of "
"cells."
msgstr "ດັດຊະນີຂອງຖັນທີ່ຈະສົ່ງຄ່າຄືນ ຈາກພາຍໃນຊ່ວງເຊວອ້າງອີງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The index of the row to be returned from within the reference range of cells."
msgstr "ດັດຊະນີຂອງແຖວທີ່ຈະສົ່ງຄ່າຄືນ ຈາກພາຍໃນຊ່ວງເຊວອ້າງອີງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The info_type should be one of %s."
msgstr "info_type ຄວນແມ່ນໜຶ່ງໃນ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The initial cost of the asset."
msgstr "ຕົ້ນທຶນເລີ່ມຕົ້ນຂອງຊັບສິນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The instance of search_for within text_to_search to replace with "
"replace_with. By default, all occurrences of search_for are replaced; "
"however, if occurrence_number is specified, only the indicated instance of "
"search_for is replaced."
msgstr ""
"ລຳດັບທີ່ພົບຂອງ search_for ພາຍໃນ text_to_search ທີ່ຈະແທນທີ່ດ້ວຍ replace_with. "
"ໂດຍຄ່າເລີ່ມຕົ້ນ, ທຸກຕຳແໜ່ງທີ່ພົບຈະຖືກແທນທີ່ທັງໝົດ; ແຕ່ຖ້າມີການລະບຸ occurrence_number, "
"ຈະແທນທີ່ສະເພາະລຳດັບທີ່ລະບຸໄວ້ເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The instance_num (%s) must not be zero."
msgstr "instance_num (%s) ຕ້ອງບໍ່ແມ່ນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The interest rate paid on funds invested."
msgstr "ອັດຕາດອກເບ້ຍທີ່ຈ່າຍໃຫ້ກັບເງິນລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The interest rate."
msgstr "ອັດຕາດອກເບ້ຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment (%s) must be strictly positive."
msgstr "ການລົງທຶນ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment's current value."
msgstr "ມູນຄ່າປັດຈຸບັນຂອງການລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The investment's desired future value."
msgstr "ມູນຄ່າໃນອະນາຄົດທີ່ຕ້ອງການຂອງການລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The issue (%s) must be positive or null."
msgstr "issue (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/pivot/pivot_functions.js:0
msgid "The label of the filter whose value to return."
msgstr "ປ້າຍຊື່ຂອງຕົວກັ່ນຕອງທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The last_period (%(last)s) must be smaller or equal to the number_of_periods "
"(%(nPeriods)s)."
msgstr ""
"last_period (%(last)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ number_of_periods (%(nPeriods)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The last_period (%s) must be strictly positive."
msgstr "last_period (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The length (%s) must be positive or zero."
msgstr "ຄວາມຍາວ (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The length of the segment to extract."
msgstr "ຄວາມຍາວຂອງສ່ວນຂໍ້ຄວາມທີ່ຈະດຶງອອກມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The life (%s) must be strictly positive."
msgstr "ອາຍຸການໃຊ້ງານ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, base e (euler's number)."
msgstr "ໂລກາຣິດຂອງຕົວເລກ, ຖານ e (ຕົວເລກອອຍເລີ)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The logarithm of a number, for a given base."
msgstr "ໂລກາຣິດຂອງຕົວເລກ ສຳລັບຖານທີ່ກຳນົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The low end of the random range."
msgstr "ຄ່າຕ່ຳສຸດຂອງຊ່ວງການສຸ່ມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The lower inflection point value must be a number"
msgstr "ຄ່າຈຸດປ່ຽນໂຄ້ງດ້ານລຸ່ມຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The matrix is not invertible."
msgstr "ມາຕຣິກນີ້ບໍ່ມີມາຕຣິກປີ້ນ (ບໍ່ສາມາດຫານໄດ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maturity (%(maturity)s) must be strictly greater than the settlement (%"
"(settlement)s)."
msgstr "ວັນຄົບກຳນົດ (%(maturity)s) ຕ້ອງໃຫຍ່ກວ່າ ວັນຊຳລະສະສາງ (%(settlement)s) ເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maturity date of the security."
msgstr "ວັນຄົບກຳນົດຂອງຫຼັກຊັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maturity or end date of the security, when it can be redeemed at face, "
"or par value."
msgstr "ວັນຄົບກຳນົດ ຫຼື ວັນສິ້ນສຸດຂອງຫຼັກຊັບ, ເມື່ອສາມາດໄຖ່ຖອນຕາມມູນຄ່າໜ້າປີ້ໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum (%s) and minimum (%s) must be integers when whole_number is TRUE."
msgstr "ຄ່າສູງສຸດ (%s) ແລະ ຄ່າຕ່ຳສຸດ (%s) ຕ້ອງເປັນຈຳນວນຖ້ວນ ເມື່ອ whole_number ເປັນ TRUE."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum (%s) must be greater than or equal to the minimum (%s)."
msgstr "ຄ່າສູງສຸດ (%s) ຕ້ອງໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ ຄ່າຕ່ຳສຸດ (%s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum number of cells for each column, rounded down to the nearest "
"whole number."
msgstr "ຈຳນວນເຊວສູງສຸດສຳລັບແຕ່ລະຖັນ, ປັດເສດລົງເປັນຈຳນວນຖ້ວນທີ່ໃກ້ຄຽງທີ່ສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The maximum number of cells for each row, rounded down to the nearest whole "
"number."
msgstr "ຈຳນວນເຊວສູງສຸດສຳລັບແຕ່ລະແຖວ, ປັດເສດລົງເປັນຈຳນວນຖ້ວນທີ່ໃກ້ຄຽງທີ່ສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum number you would like returned."
msgstr "ຕົວເລກສູງສຸດທີ່ທ່ານຕ້ອງການໃຫ້ສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maximum range limit value must be a number"
msgstr "ຄ່າກຳນົດຂອບເຂດສູງສຸດຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The maxpoint must be a number"
msgstr "ຄ່າຈຸດສູງສຸດ (maxpoint) ຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/chart/odoo_chart/odoo_chart_helpers.js:0
msgid ""
"The menu linked to this chart doesn't have an corresponding action. Please "
"link the chart to another menu."
msgstr "ເມນູທີ່ເຊື່ອມໂຍງກັບແຜນພູມນີ້ບໍ່ມີການກະທຳທີ່ກ່ຽວຂ້ອງ. ກະລຸນາເຊື່ອມໂຍງແຜນພູມກັບເມນູອື່ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The midpoint must be a number"
msgstr "ຄ່າຈຸດກາງ (midpoint) ຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minimum number you would like returned."
msgstr "ຕົວເລກຕ່ຳສຸດທີ່ທ່ານຕ້ອງການໃຫ້ສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minimum range limit value must be a number"
msgstr "ຄ່າກຳນົດຂອບເຂດຕ່ຳສຸດຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minpoint must be a number"
msgstr "ຄ່າຈຸດຕ່ຳສຸດ (minpoint) ຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minuend, or number to be subtracted from."
msgstr "ຕົວຕັ້ງລົບ, ຫຼື ຕົວເລກທີ່ຈະຖືກລົບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The minute component of the time."
msgstr "ສ່ວນປະກອບຂອງນາທີໃນເວລາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/data_sources/data_source.js:0
#: code:addons/spreadsheet/static/src/pivot/odoo_pivot_loader.js:0
msgid "The model \"%(model)s\" does not exist."
msgstr "ບໍ່ມີໂມເດວ \"%(model)s\" ນີ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/global_filters/components/filter_value/filter_value.js:0
msgid ""
"The model (%(model)s) of this global filter is not valid (it may have been "
"renamed/deleted)."
msgstr "ໂມເດວ (%(model)s) ຂອງຕົວກັ່ນຕອງລວມນີ້ບໍ່ຖືກຕ້ອງ (ອາດຈະຖືກປ່ຽນຊື່ ຫຼື ລຶບອອກແລ້ວ)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The month (%s) must be between 1 and 12 inclusive."
msgstr "ເດືອນ (%s) ຕ້ອງຢູ່ລະຫວ່າງ 1 ຫາ 12."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The month component of the date."
msgstr "ສ່ວນປະກອບຂອງເດືອນໃນວັນທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The named range name is invalid. Valid names can contain letters, digits, "
"underscores, and periods. The name cannot be only a number, TRUE, or FALSE."
msgstr ""
"ຊື່ຂອງຊ່ວງຂໍ້ມູນທີ່ຕັ້ງຂຶ້ນບໍ່ຖືກຕ້ອງ. ຊື່ທີ່ຖືກຕ້ອງສາມາດປະກອບມີ ຕົວອັກສອນ, ຕົວເລກ, ເຄື່ອງໝາຍຂີດກ້ອງ ແລະ "
"ຈ້ຳເມັດ. ຊື່ຕ້ອງບໍ່ແມ່ນພຽງແຕ່ຕົວເລກ, TRUE, ຫຼື FALSE."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The named range to update was not found."
msgstr "ບໍ່ພົບຊ່ວງຂໍ້ມູນທີ່ມີຊື່ທີ່ຈະອັບເດດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The net present value of an investment based on a series of periodic cash "
"flows and a discount rate."
msgstr "ມູນຄ່າປັດຈຸບັນສຸດທິຂອງການລົງທຶນ ໂດຍອີງໃສ່ກະແສເງິນສົດເປັນງວດ ແລະ ອັດຕາສ່ວນຫຼຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The nominal interest rate per year."
msgstr "ອັດຕາດອກເບ້ຍທີ່ລະບຸຕໍ່ປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The nominal_rate (%s) must be strictly positive."
msgstr "nominal_rate (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number for which to calculate the positive square root."
msgstr "ຕົວເລກທີ່ຈະຄິດໄລ່ຮາກຂັ້ນສອງຄ່າບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters in the text to be replaced."
msgstr "ຈຳນວນຕົວອັກສອນໃນຂໍ້ຄວາມທີ່ຈະຖືກແທນທີ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters to return from the left side of string."
msgstr "ຈຳນວນຕົວອັກສອນທີ່ຈະສົ່ງຄືນຈາກເບື້ອງຊ້າຍຂອງຂໍ້ຄວາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of characters to return from the right side of string."
msgstr "ຈຳນວນຕົວອັກສອນທີ່ຈະສົ່ງຄືນຈາກເບື້ອງຂວາຂອງຂໍ້ຄວາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns (%s) must be positive."
msgstr "ຈຳນວນຖັນ (%s) ຕ້ອງເປັນຄ່າບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns in the constrained array."
msgstr "ຈຳນວນຖັນໃນອາເຣທີ່ຖືກຈຳກັດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns in the expanded array. If missing, columns will not be "
"expanded."
msgstr "ຈຳນວນຖັນໃນອາເຣທີ່ຂະຫຍາຍອອກ. ຖ້າບໍ່ໄດ້ລະບຸ, ຖັນຈະບໍ່ຖືກຂະຫຍາຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns must be positive."
msgstr "ຈຳນວນຖັນຕ້ອງເປັນຄ່າບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns of the range to return starting at the offset target."
msgstr "ຈຳນວນຖັນຂອງຊ່ວງຂໍ້ມູນທີ່ຈະສົ່ງຄືນ ໂດຍເລີ່ມຈາກເປົ້າໝາຍ offset."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to be returned."
msgstr "ຈຳນວນຖັນທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns to exclude. A negative value drops from the end of the "
"array."
msgstr "ຈຳນວນຖັນທີ່ຈະຕັດອອກ. ຄ່າລົບຈະຕັດອອກຈາກທ້າຍຂອງອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to offset by."
msgstr "ຈຳນວນຖັນທີ່ຈະຍ້າຍຕຳແໜ່ງ (offset)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of columns to return"
msgstr "ຈຳນວນຖັນທີ່ຈະສົ່ງຄ່າກັບຄືນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of columns to take. A negative value takes from the end of the "
"array."
msgstr "ຈຳນວນຖັນທີ່ຈະດຶງເອົາ. ຄ່າລົບຈະດຶງເອົາຈາກທ້າຍຂອງອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of compounding periods per year."
msgstr "ຈຳນວນງວດທົບຕົ້ນຕໍ່ປີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of days between start_date and end_date"
msgstr "ຈຳນວນມື້ລະຫວ່າງ start_date ແລະ end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of days between start_date and end_date after subtracting whole "
"months"
msgstr "ຈຳນວນມື້ລະຫວ່າງ start_date ແລະ end_date ຫຼັງຈາກລົບເດືອນເຕັມອອກແລ້ວ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of days between start_date and end_date, assuming start_date and "
"end_date were no more than one year apart"
msgstr ""
"ຈຳນວນມື້ລະຫວ່າງ start_date ແລະ end_date, ໂດຍຖືວ່າ start_date ແລະ end_date "
"ຫ່າງກັນບໍ່ເກີນໜຶ່ງປີ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of decimal places to which to round."
msgstr "ຈຳນວນຫຼັກທົດສະນິຍົມທີ່ຈະປັດເສດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of interest or coupon payments per year (1, 2, or 4)."
msgstr "ຈຳນວນຄັ້ງຂອງການຈ່າຍດອກເບ້ຍ ຫຼື ຄູປອງຕໍ່ປີ (1, 2, ຫຼື 4)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of items to return."
msgstr "ຈຳນວນລາຍການທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of months before (negative) or after (positive) 'start_date' to "
"calculate."
msgstr "ຈຳນວນເດືອນກ່ອນ (ຄ່າລົບ) ຫຼື ຫຼັງ (ຄ່າບວກ) 'start_date' ທີ່ຈະຄິດໄລ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of months before (negative) or after (positive) 'start_date' to "
"consider."
msgstr "ຈຳນວນເດືອນກ່ອນ (ຄ່າລົບ) ຫຼື ຫຼັງ (ຄ່າບວກ) 'start_date' ທີ່ຈະພິຈາລະນາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of months in the first year of depreciation."
msgstr "ຈຳນວນເດືອນໃນປີທຳອິດຂອງການຄິດໄລ່ຄ່າຫຼຸ້ຍຫ້ຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of numeric values in dataset."
msgstr "ຈຳນວນຄ່າຕົວເລກໃນຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of payments to be made."
msgstr "ຈຳນວນງວດການຊຳລະເງິນທັງໝົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods over which the asset is depreciated."
msgstr "ຈຳນວນງວດທີ່ຊັບສິນຖືກຕັດຄ່າຫຼຸ້ຍຫ້ຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of periods."
msgstr "ຈຳນວນງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows (%s) must be positive."
msgstr "ຈຳນວນແຖວ (%s) ຕ້ອງເປັນຄ່າບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows can not be zero."
msgstr "ຈຳນວນແຖວບໍ່ສາມາດເປັນສູນໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows in the constrained array."
msgstr "ຈຳນວນແຖວໃນອາເຣທີ່ຖືກຈຳກັດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows in the expanded array. If missing, rows will not be "
"expanded."
msgstr "ຈຳນວນແຖວໃນອາເຣທີ່ຂະຫຍາຍອອກ. ຖ້າບໍ່ໄດ້ລະບຸ, ແຖວຈະບໍ່ຖືກຂະຫຍາຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows must be positive."
msgstr "ຈຳນວນແຖວຕ້ອງເປັນຄ່າບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows of the range to return starting at the offset target."
msgstr "ຈຳນວນແຖວຂອງຊ່ວງຂໍ້ມູນທີ່ຈະສົ່ງຄືນ ໂດຍເລີ່ມຈາກເປົ້າໝາຍ offset."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows or column to exclude must be smaller than the number of "
"elements in the array."
msgstr "ຈຳນວນແຖວ ຫຼື ຖັນທີ່ຈະຕັດອອກ ຕ້ອງນ້ອຍກວ່າຈຳນວນສະມາຊິກໃນອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/list/list_functions.js:0
msgid "The number of rows parameter should be a positive number."
msgstr "ພາຣາມິເຕີຈຳນວນແຖວຄວນເປັນຕົວເລກບວກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to be returned."
msgstr "ຈຳນວນແຖວທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows to drop. A negative value drops from the end of the array."
msgstr "ຈຳນວນແຖວທີ່ຈະຕັດອອກ. ຄ່າລົບຈະຕັດອອກຈາກທ້າຍຂອງອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to offset by."
msgstr "ຈຳນວນແຖວທີ່ຈະຍ້າຍຕຳແໜ່ງ (offset)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of rows to return"
msgstr "ຈຳນວນແຖວທີ່ຈະສົ່ງຄ່າກັບຄືນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of rows to take. A negative value takes from the end of the array."
msgstr "ຈຳນວນແຖວທີ່ຈະດຶງເອົາ. ຄ່າລົບຈະດຶງເອົາຈາກທ້າຍຂອງອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of significant digits to the right of the decimal point to retain."
msgstr "ຈຳນວນຕົວເລກທີ່ສຳຄັນທາງເບື້ອງຂວາຂອງຈຸດທົດສະນິຍົມທີ່ຈະເກັບຮັກສາໄວ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of the character to look up from the current Unicode table in "
"decimal format."
msgstr "ໝາຍເລກຂອງຕົວອັກສອນທີ່ຈະຊອກຫາຈາກຕາຕະລາງ Unicode ປັດຈຸບັນ ໃນຮູບແບບເລກຖານສິບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to begin the cumulative calculation."
msgstr "ງວດການຊຳລະທີ່ຈະເລີ່ມຕົ້ນການຄິດໄລ່ແບບສະສົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of the payment period to end the cumulative calculation."
msgstr "ງວດການຊຳລະທີ່ຈະສິ້ນສຸດການຄິດໄລ່ແບບສະສົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of values in a dataset."
msgstr "ຈຳນວນຄ່າໃນຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of which to return the absolute value."
msgstr "ຕົວເລກທີ່ຈະສົ່ງຄ່າສຳບູນກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole months between start_date and end_date"
msgstr "ຈຳນວນເດືອນເຕັມລະຫວ່າງ start_date ແລະ end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of whole months between start_date and end_date after subtracting "
"whole years"
msgstr "ຈຳນວນເດືອນເຕັມລະຫວ່າງ start_date ແລະ end_date ຫຼັງຈາກລົບປີເຕັມອອກແລ້ວ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number of whole years between start_date and end_date"
msgstr "ຈຳນວນປີເຕັມລະຫວ່າງ start_date ແລະ end_date"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number of working days to advance from start_date. If negative, counts "
"backwards."
msgstr "ຈຳນວນມື້ເຮັດວຽກທີ່ຈະນັບໄປໜ້າຈາກ start_date. ຖ້າເປັນຄ່າລົບ ຈະນັບຖອຍຫຼັງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number pi."
msgstr "ຄ່າເລກພາຍ (pi)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided to find the remainder."
msgstr "ຕົວຕັ້ງຫານເພື່ອຊອກຫາເສດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to be divided."
msgstr "ຕົວຕັ້ງຫານ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to convert."
msgstr "ຕົວເລກທີ່ຈະປ່ຽນຄ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to divide by."
msgstr "ຕົວຫານ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to have its sign reversed. Equivalently, the number to multiply "
"by -1."
msgstr "ຕົວເລກທີ່ຈະປ່ຽນເຄື່ອງໝາຍກົງກັນຂ້າມ, ຫຼື ຄູນດ້ວຍ -1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to raise to the exponent power."
msgstr "ຕົວເລກທີ່ຈະຍົກກຳລັງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to return."
msgstr "ຕົວເລກທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to round down to the nearest integer."
msgstr "ຕົວເລກທີ່ຈະປັດເສດລົງເປັນຈຳນວນຖ້ວນທີ່ໃກ້ຄຽງທີ່ສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples number will be rounded."
msgstr "ຕົວເລກພະຫຸຄູນທີ່ຈະໃຊ້ໃນການປັດເສດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The number to whose multiples number will be rounded. The sign of "
"significance will be ignored."
msgstr "ຕົວເລກພະຫຸຄູນທີ່ຈະໃຊ້ໃນການປັດເສດ ໂດຍບໍ່ຄຳນຶງເຖິງເຄື່ອງໝາຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number to whose multiples value will be rounded."
msgstr "ຕົວເລກພະຫຸຄູນທີ່ຈະໃຊ້ປັດເສດຄ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number, date or time to format."
msgstr "ຕົວເລກ, ວັນທີ ຫຼື ເວລາ ທີ່ຈະຈັດຮູບແບບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number."
msgstr "ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_characters (%s) must be positive or null."
msgstr "number_of_characters (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_characters (%s) must be positive or zero."
msgstr "number_of_characters (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be different from zero."
msgstr "number_of_periods (%s) ຕ້ອງຕ່າງຈາກສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The number_of_periods (%s) must be strictly positive."
msgstr "number_of_periods (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The occurrenceNumber (%s) must be positive or null."
msgstr "occurrenceNumber (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The one-dimensional array to be searched."
msgstr "ອາເຣໜຶ່ງມິຕິທີ່ຈະຊອກຫາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The order of the polynomial to fit the data, between 1 and 6."
msgstr "ລະດັບຂັ້ນຂອງໂພລີໂນມຽລເພື່ອປັບໃຫ້ເຂົ້າກັບຂໍ້ມູນ, ຢູ່ລະຫວ່າງ 1 ຫາ 6."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to criteria_range."
msgstr "ຮູບແບບ ຫຼື ເງື່ອນໄຂທີ່ຈະນຳໃຊ້ກັບ criteria_range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pattern or test to apply to range."
msgstr "ຮູບແບບ ຫຼື ເງື່ອນໄຂທີ່ຈະນຳໃຊ້ກັບ range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The percentile whose value within data will be calculated and returned."
msgstr "ເປີເຊັນໄທລ໌ທີ່ຈະຄິດໄລ່ ແລະ ສົ່ງຄືນຄ່າຈາກພາຍໃນຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The percentile, exclusive of 0 and 1, whose value within 'data' will be "
"calculated and returned."
msgstr "ເປີເຊັນໄທລ໌ (ບໍ່ລວມ 0 ແລະ 1) ທີ່ຈະຄິດໄລ່ ແລະ ສົ່ງຄືນຄ່າຈາກພາຍໃນ 'data'."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal life (%(life)s)."
msgstr "ງວດ (%(period)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ ອາຍຸການໃຊ້ງານ (%(life)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%(period)s) must be less than or equal to %(lifeLimit)s."
msgstr "ງວດ (%(period)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ %(lifeLimit)s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be positive or null."
msgstr "ງວດ (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period (%s) must be strictly positive."
msgstr "ງວດ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period for which you want to view the interest payment."
msgstr "ງວດທີ່ທ່ານຕ້ອງການເບິ່ງການຈ່າຍດອກເບ້ຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The period must be between 1 and number_of_periods (%s)"
msgstr "ງວດຕ້ອງຢູ່ລະຫວ່າງ 1 ຫາ number_of_periods (%s)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The periods_by_year (%s) must be strictly positive."
msgstr "periods_by_year (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains a reserved value"
msgstr "ບໍ່ສາມາດສ້າງ Pivot ໄດ້ ເນື່ອງຈາກເຊວ %s ມີຄ່າທີ່ສະຫງວນໄວ້"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s contains an error"
msgstr "ບໍ່ສາມາດສ້າງ Pivot ໄດ້ ເນື່ອງຈາກເຊວ %s ມີຂໍ້ຜິດພາດ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because cell %s is empty"
msgstr "ບໍ່ສາມາດສ້າງ Pivot ໄດ້ ເນື່ອງຈາກເຊວ %s ຫວ່າງເປົ່າ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The pivot cannot be created because the dataset is missing."
msgstr "ບໍ່ສາມາດສ້າງ Pivot ໄດ້ ເນື່ອງຈາກບໍ່ມີຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The population standard deviation."
msgstr "ຄ່າຜັນປ່ຽນມາດຕະຖານຂອງປະຊາກອນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position (%s) must be greater than or equal to 1."
msgstr "ຕຳແໜ່ງ (%s) ຕ້ອງໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The position where the replacement will begin (starting from 1)."
msgstr "ຕຳແໜ່ງທີ່ຈະເລີ່ມຕົ້ນການແທນທີ່ (ເລີ່ມຈາກ 1)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present value of the investment."
msgstr "ມູນຄ່າປັດຈຸບັນຂອງການລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The present_value (%s) must be strictly positive."
msgstr "present_value (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price (%s) must be strictly positive."
msgstr "ລາຄາ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought per 100 face value."
msgstr "ລາຄາທີ່ຊື້ຫຼັກຊັບຕໍ່ມູນຄ່າໜ້າປີ້ 100."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price at which the security is bought."
msgstr "ລາຄາທີ່ຊື້ຫຼັກຊັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given as a decimal value."
msgstr "ລາຄາທີ່ສະເໜີໃນຮູບແບບທົດສະນິຍົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The price quotation given using fractional decimal conventions."
msgstr "ລາຄາທີ່ສະເໜີຕາມແບບແຜນເສດສ່ວນທົດສະນິຍົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The purchase_date (%(purchaseDate)s) must be before the first_period_end (%"
"(firstPeriodEnd)s)."
msgstr ""
"purchase_date (%(purchaseDate)s) ຕ້ອງມາກ່ອນ first_period_end (%"
"(firstPeriodEnd)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The purchase_date (%s) must be positive or null."
msgstr "purchase_date (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the dataset to consider."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ມີຊຸດຂໍ້ມູນທີ່ຈະພິຈາລະນາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the expected values."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ມີຄ່າທີ່ຄາດຫວັງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the observed values."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ມີຄ່າທີ່ສັງເກດໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range containing the return value. Should have the same dimensions as "
"lookup_range."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ມີຄ່າທີ່ຈະສົ່ງຄືນ. ຄວນມີມິຕິເທົ່າກັນກັບ lookup_range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range containing the set of classes."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ມີຊຸດຂອງຊັ້ນຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range from which to return a result. The value returned corresponds to "
"the location where search_key is found in search_range. This range must be "
"only a single row or column and should not be used if using the "
"search_result_array method."
msgstr ""
"ຊ່ວງຂໍ້ມູນທີ່ຈະສົ່ງຜົນໄດ້ຮັບຄືນ. ຄ່າທີ່ສົ່ງຄືນຈະກົງກັບຕຳແໜ່ງທີ່ພົບ search_key ໃນ search_range. "
"ຊ່ວງນີ້ຕ້ອງເປັນພຽງແຖວດຽວ ຫຼື ຖັນດຽວເທົ່ານັ້ນ ແລະ ບໍ່ຄວນໃຊ້ຖ້າໃຊ້ວິທີ search_result_array."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is invalid"
msgstr "ຊ່ວງຂໍ້ມູນບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is invalid."
msgstr "ຊ່ວງຂໍ້ມູນບໍ່ຖືກຕ້ອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is out of bounds."
msgstr "ຊ່ວງຂໍ້ມູນຢູ່ນອກຂອບເຂດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range is out of the sheet"
msgstr "ຊ່ວງຂໍ້ມູນຢູ່ນອກແຜ່ນວຽກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range must be a single row or a single column."
msgstr "ຊ່ວງຂໍ້ມູນຕ້ອງເປັນພຽງແຖວດຽວ ຫຼື ຖັນດຽວເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range of cells from which the maximum will be determined."
msgstr "ຊ່ວງເຊວທີ່ຈະຊອກຫາຄ່າສູງສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range of cells from which the minimum will be determined."
msgstr "ຊ່ວງເຊວທີ່ຈະຊອກຫາຄ່າຕ່ຳສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range of cells from which the number of unique values will be counted."
msgstr "ຊ່ວງເຊວທີ່ຈະນັບຈຳນວນຄ່າທີ່ບໍ່ຊ້ຳກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range of cells from which the values are returned."
msgstr "ຊ່ວງເຊວທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range representing the array or matrix of dependent data."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ເປັນຕົວແທນຂອງອາເຣ ຫຼື ມາຕຣິກຂອງຂໍ້ມູນຕົວປ່ຽນຕາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range representing the array or matrix of independent data."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ເປັນຕົວແທນຂອງອາເຣ ຫຼື ມາຕຣິກຂອງຂໍ້ມູນຕົວປ່ຽນອິດສະຫຼະ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range representing the array or matrix of observed data."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ເປັນຕົວແທນຂອງອາເຣ ຫຼື ມາຕຣິກຂອງຂໍ້ມູນທີ່ສັງເກດໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range representing the array or matrix of predicted data."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ເປັນຕົວແທນຂອງອາເຣ ຫຼື ມາຕຣິກຂອງຂໍ້ມູນທີ່ຄາດຄະເນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range that is tested against criterion."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະກວດສອບກັບເງື່ອນໄຂ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to average."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະຄິດໄລ່ຫາຄ່າສະເລ່ຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range to average. If not included, criteria_range is used for the "
"average instead."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະຄິດໄລ່ຫາຄ່າສະເລ່ຍ. ຖ້າບໍ່ໄດ້ລະບຸ, ຈະໃຊ້ criteria_range ສຳລັບການຄິດໄລ່ແທນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to be appended."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະນຳມາຕໍ່ທ້າຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to be summed, if different from range."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະລວມຍອດ, ຖ້າຫາກຕ່າງຈາກ range."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to be transposed."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະສະຫຼັບປ່ຽນແຖວ-ຖັນ (transpose)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to check against criterion."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະກວດສອບຕາມເງື່ອນໄຂ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range to consider for the search. Should be a single column or a single "
"row."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະພິຈາລະນາສຳລັບການຊອກຫາ. ຄວນເປັນຖັນດຽວ ຫຼື ແຖວດຽວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range to consider for the search. The first column in the range is "
"searched for the key specified in search_key."
msgstr ""
"ຊ່ວງຂໍ້ມູນທີ່ຈະພິຈາລະນາສຳລັບການຊອກຫາ. ຖັນທຳອິດໃນຊ່ວງຂໍ້ມູນຈະຖືກຊອກຫາຕາມຄີທີ່ລະບຸໃນ search_key."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range to consider for the search. The first row in the range is searched "
"for the key specified in search_key."
msgstr ""
"ຊ່ວງຂໍ້ມູນທີ່ຈະພິຈາລະນາສຳລັບການຊອກຫາ. ແຖວທຳອິດໃນຊ່ວງຂໍ້ມູນຈະຖືກຊອກຫາຕາມຄີທີ່ລະບຸໃນ search_key."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to constrain."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະຈຳກັດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to flatten."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະແປງໃຫ້ເປັນແຖວດຽວ (flatten)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to sum."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະລວມຍອດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range to wrap."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະຕັດຂຶ້ນແຖວໃໝ່ (wrap)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range which is tested against criterion."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຖືກກວດສອບກັບເງື່ອນໄຂ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range whose column count will be returned."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະສົ່ງຄືນຈຳນວນຖັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range whose entries will be multiplied with corresponding entries in the "
"other range."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະຖືກຄູນກັບຄ່າທີ່ກົງກັນໃນອີກຊ່ວງຂໍ້ມູນໜຶ່ງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The range whose row count will be returned."
msgstr "ຊ່ວງຂໍ້ມູນທີ່ຈະສົ່ງຄືນຈຳນວນແຖວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The range you specified is outside of the sheet.\n"
"\n"
"If you meant to create a named range, named range cannot have the same name "
"as a cell reference. Please choose another name."
msgstr ""
"ຊ່ວງຂໍ້ມູນທີ່ທ່ານລະບຸຢູ່ນອກແຜ່ນວຽກ.\n"
"\n"
"ຖ້າທ່ານຕ້ອງການສ້າງຊ່ວງຂໍ້ມູນທີ່ມີຊື່, ຊື່ຊ່ວງຂໍ້ມູນບໍ່ສາມາດຄືກັນກັບຊື່ອ້າງອີງເຊວໄດ້. ກະລຸນາເລືອກຊື່ອື່ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The ranges must contain at least 2 values."
msgstr "ຊ່ວງຂໍ້ມູນຕ້ອງມີຢ່າງໜ້ອຍ 2 ຄ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rank from largest to smallest of the element to return."
msgstr "ອັນດັບຈາກໃຫຍ່ຫາໜ້ອຍສຸດຂອງສະມາຊິກທີ່ຈະສົ່ງຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rank from smallest to largest of the element to return."
msgstr "ອັນດັບຈາກໜ້ອຍຫາໃຫຍ່ສຸດຂອງສະມາຊິກທີ່ຈະສົ່ງຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rate (%s) must be positive or null."
msgstr "ອັດຕາ (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rate (%s) must be strictly positive."
msgstr "ອັດຕາ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rate at which the investment grows each period."
msgstr "ອັດຕາການເຕີບໂຕຂອງການລົງທຶນໃນແຕ່ລະງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rate_guess (%s) must be strictly greater than -1."
msgstr "rate_guess (%s) ຕ້ອງໃຫຍ່ກວ່າ -1 ເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The redemption (%s) must be strictly positive."
msgstr "ມູນຄ່າໄຖ່ຖອນ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The redemption amount per 100 face value, or par."
msgstr "ຈຳນວນເງິນໄຖ່ຖອນຕໍ່ມູນຄ່າໜ້າປີ້ 100."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The reference is invalid."
msgstr "ການອ້າງອີງບໍ່ຖືກຕ້ອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The reference to get the spilled range from."
msgstr "ການອ້າງອີງເພື່ອດຶງເອົາຊ່ວງຂໍ້ມູນທີ່ຂະຫຍາຍອອກ (spill range)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The reference to the cell."
msgstr "ການອ້າງອີງເຖິງເຊວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The regular expression pattern to match against the text."
msgstr "ຮູບແບບ Regular Expression ທີ່ຈະໃຊ້ກວດສອບກັບຂໍ້ຄວາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The result_range must be a single row or a single column."
msgstr "result_range ຕ້ອງເປັນພຽງແຖວດຽວ ຫຼື ຖັນດຽວເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The return (as a percentage) earned on reinvestment of income received from "
"the investment."
msgstr "ຜົນຕອບແທນ (ເປັນເປີເຊັນ) ທີ່ໄດ້ຮັບຈາກການລົງທຶນຕໍ່ຈາກລາຍຮັບທີ່ໄດ້ມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The return_mode (%s) must be 0, 1 or 2."
msgstr "return_mode (%s) ຕ້ອງເປັນ 0, 1 ຫຼື 2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The row index of the row to be returned."
msgstr "ດັດຊະນີແຖວຂອງແຖວທີ່ຈະສົ່ງຄ່າກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The row index of the value to be returned, where the first row in range is "
"numbered 1."
msgstr "ດັດຊະນີແຖວຂອງຄ່າທີ່ຈະສົ່ງຄືນ, ໂດຍແຖວທຳອິດໃນຊ່ວງຂໍ້ມູນຈະເປັນເລກ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The row number of the cell reference. "
msgstr "ໝາຍເລກແຖວຂອງເຊວອ້າງອີງ. "

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rows argument (%s) must be strictly positive."
msgstr "ອາຄິວເມັ້ນແຖວ (%s) ຕ້ອງເປັນຄ່າບວກເທົ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The rows arguments (%s) must be greater or equal than the number of rows of "
"the array."
msgstr "ອາຄິວເມັ້ນແຖວ (%s) ຕ້ອງໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ ຈຳນວນແຖວຂອງອາເຣ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rows arguments must be between -%s and %s (got %s), excluding 0."
msgstr "ອາຄິວເມັ້ນແຖວຕ້ອງຢູ່ລະຫວ່າງ -%s ຫາ %s (ໄດ້ຮັບ %s), ໂດຍບໍ່ລວມເລກ 0."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rule is invalid for an unknown reason"
msgstr "ກົດລະບຽບບໍ່ຖືກຕ້ອງ ຍ້ອນສາເຫດທີ່ບໍ່ສາມາດລະບຸໄດ້"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The rule is invalid for an unknown reason."
msgstr "ກົດລະບຽບບໍ່ຖືກຕ້ອງ ຍ້ອນສາເຫດທີ່ບໍ່ສາມາດລະບຸໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The salvage (%(salvage)s) must be smaller or equal than the cost (%(cost)s)."
msgstr "ມູນຄ່າຊາກ (%(salvage)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ ຕົ້ນທຶນ (%(cost)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The salvage (%s) must be positive or null."
msgstr "ມູນຄ່າຊາກ (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນສູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The sample covariance of a dataset."
msgstr "ຄ່າໂຄແວຣຽນກຸ່ມຕົວຢ່າງຂອງຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The sample size."
msgstr "ຂະໜາດກຸ່ມຕົວຢ່າງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The sample standard deviation."
msgstr "ຄ່າຜັນປ່ຽນມາດຕະຖານຂອງກຸ່ມຕົວຢ່າງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The search and match mode combination is not supported for XLOOKUP "
"evaluation."
msgstr "ຮູບແບບການຊອກຫາ ແລະ ການຈັບຄູ່ທີ່ເລືອກໄວ້ ນຳໃຊ້ຮ່ວມກັນບໍ່ໄດ້ໃນການປະເມີນ XLOOKUP."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The search method is a number 1, 0 or -1 indicating which value to return. 1 "
"finds the largest value less than or equal to search_key when range is "
"sorted in ascending order. 0 finds the exact value when range is unsorted. "
"-1 finds the smallest value greater than or equal to search_key when range "
"is sorted in descending order."
msgstr ""
"ວິທີການຊອກຫາແມ່ນຕົວເລກ 1, 0 ຫຼື -1 ທີ່ລະບຸວ່າຈະສົ່ງຄ່າໃດກັບຄືນ. 1 ແມ່ນຊອກຫາຄ່າໃຫຍ່ສຸດທີ່ນ້ອຍກວ່າ ຫຼື "
"ເທົ່າກັບ search_key ເມື່ອຊ່ວງຂໍ້ມູນຖືກຈັດລຽງຈາກໜ້ອຍຫາຫຼາຍ. 0 ແມ່ນຊອກຫາຄ່າທີ່ກົງກັນພໍດີ "
"ເມື່ອຊ່ວງຂໍ້ມູນບໍ່ໄດ້ຈັດລຽງ. -1 ແມ່ນຊອກຫາຄ່າຕ່ຳສຸດທີ່ໃຫຍ່ກວ່າ ຫຼື ເທົ່າກັບ search_key "
"ເມື່ອຊ່ວງຂໍ້ມູນຖືກຈັດລຽງຈາກຫຼາຍຫາໜ້ອຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second addend."
msgstr "ຕົວເລກບວກຕົວທີສອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second argument is missing. Please provide a value"
msgstr "ບໍ່ມີອາຄິວເມັ້ນທີສອງ. ກະລຸນາໃສ່ຄ່າໃສ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second component of the time."
msgstr "ສ່ວນປະກອບຂອງວິນາທີໃນເວລາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second matrix in the matrix multiplication operation."
msgstr "ມາຕຣິກທີສອງໃນການຄູນມາຕຣິກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second multiplicand."
msgstr "ຕົວຕັ້ງຄູນທີສອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second number to compare."
msgstr "ຕົວເລກທີສອງທີ່ຈະປຽບທຽບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second sample."
msgstr "ກຸ່ມຕົວຢ່າງທີສອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second string to compare."
msgstr "ຂໍ້ຄວາມທີສອງທີ່ຈະປຽບທຽບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second value must be a number"
msgstr "ຄ່າທີສອງຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The second value."
msgstr "ຄ່າທີສອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The settlement date (%(settlement)s) must at most one year after the "
"maturity date (%(maturity)s)."
msgstr ""
"ວັນທີຊຳລະສະສາງ (%(settlement)s) ຕ້ອງບໍ່ເກີນໜຶ່ງປີ ຫຼັງຈາກວັນທີຄົບກຳນົດ (%(maturity)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The settlement date (%(settlement)s) must be greater or equal to the issue "
"date (%(issue)s)."
msgstr "ວັນທີຊຳລະສະສາງ (%(settlement)s) ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບວັນທີອອກ (%(issue)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The settlement date (%(settlement)s) must be strictly greater than the issue "
"date (%(issue)s)."
msgstr "ວັນທີຊຳລະສະສາງ (%(settlement)s) ຕ້ອງຫຼາຍກວ່າວັນທີອອກ (%(issue)s) ຢ່າງເຂັ້ມງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The settlement date of the security, the date after issuance when the "
"security is delivered to the buyer."
msgstr "ວັນທີຊຳລະສະສາງຂອງຫຼັກຊັບ, ວັນທີຫຼັງຈາກການອອກຈຳໜ່າຍ ເມື່ອຫຼັກຊັບຖືກສົ່ງມອບໃຫ້ແກ່ຜູ້ຊື້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The sheet name cannot be empty."
msgstr "ຊື່ແຜ່ນງານບໍ່ສາມາດຫວ່າງເປົ່າໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The sheet on which the range is defined is hidden."
msgstr "ແຜ່ນງານທີ່ກຳນົດຊ່ວງຂໍ້ມູນໄວ້ນັ້ນຖືກເຊື່ອງຢູ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The significance level (e.g. 0.05 for 95% CI)."
msgstr "ລະດັບຄວາມສຳຄັນທາງສະຖິຕິ (ຕົວຢ່າງ: 0.05 ສຳລັບ 95% CI)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The single period within life for which to calculate depreciation."
msgstr "ງວດດຽວພາຍໃນອາຍຸການນຳໃຊ້ ທີ່ຕ້ອງການຄິດໄລ່ຄ່າຫຼຸ້ຍຫ້ຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The source text."
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The start date of the period from which to calculate the number of net "
"working days."
msgstr "ວັນທີເລີ່ມຕົ້ນຂອງໄລຍະເວລາ ທີ່ໃຊ້ຄິດໄລ່ຈຳນວນມື້ເຮັດວຽກຕົວຈິງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The start date to consider in the calculation."
msgstr "ວັນທີເລີ່ມຕົ້ນທີ່ຈະນຳມາພິຈາລະນາໃນການຄິດໄລ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The start date to consider in the calculation. Must be a reference to a cell "
"containing a DATE, a function returning a DATE type, or a number."
msgstr ""
"ວັນທີເລີ່ມຕົ້ນທີ່ຈະນຳມາພິຈາລະນາໃນການຄິດໄລ່. ຕ້ອງເປັນການອ້າງອີງໃສ່ຫ້ອງເຊວທີ່ມີ DATE, "
"ຟັງຊັນທີ່ສົ່ງຄ່າກັບມາເປັນປະເພດ DATE, ຫຼື ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The start date to consider in the calculation. Must be a reference to a cell "
"containing a date, a function returning a date type, or a number."
msgstr ""
"ວັນທີເລີ່ມຕົ້ນທີ່ຈະນຳມາພິຈາລະນາໃນການຄິດໄລ່. ຕ້ອງເປັນການອ້າງອີງໃສ່ຫ້ອງເຊວທີ່ມີວັນທີ, "
"ຟັງຊັນທີ່ສົ່ງຄ່າກັບມາເປັນປະເພດວັນທີ, ຫຼື ຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The start of the date range."
msgstr "ຈຸດເລີ່ມຕົ້ນຂອງຊ່ວງວັນທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The start_date (%s) must be positive or null."
msgstr "start_date (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນຄ່າຫວ່າງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The start_period (%(start)s) must be smaller or equal to the end_period (%"
"(end)s)."
msgstr "start_period (%(start)s) ຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ end_period (%(end)s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The start_period (%s) must be positive or null."
msgstr "start_period (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນຄ່າຫວ່າງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting point from which to count the offset rows and columns."
msgstr "ຈຸດເລີ່ມຕົ້ນທີ່ຈະນັບໄລຍະຫ່າງຂອງແຖວ ແລະ ຖັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting unit, the unit currently assigned to value"
msgstr "ຫົວໜ່ວຍເລີ່ມຕົ້ນ, ຫົວໜ່ວຍທີ່ກຳນົດໃຫ້ກັບຄ່າໃນປັດຈຸບັນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting_at (%s) must be greater than or equal to 1."
msgstr "starting_at (%s) ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The starting_at argument (%s) must be positive greater than one."
msgstr "ອາຣກິວເມັນ starting_at (%s) ຕ້ອງເປັນຄ່າບວກທີ່ຫຼາຍກວ່າໜຶ່ງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string from which the left portion will be returned."
msgstr "ຂໍ້ຄວາມທີ່ຕ້ອງການຕັດເອົາສ່ວນເບື້ອງຊ້າຍອອກມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string from which the right portion will be returned."
msgstr "ຂໍ້ຄວາມທີ່ຕ້ອງການຕັດເອົາສ່ວນເບື້ອງຂວາອອກມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string in which you want to replace text."
msgstr "ຂໍ້ຄວາມທີ່ທ່ານຕ້ອງການແທນທີ່ຂໍ້ຄວາມໃສ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string on which you want to extract text."
msgstr "ຂໍ້ຄວາມທີ່ທ່ານຕ້ອງການດຶງເອົາຂໍ້ຄວາມອອກມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string representing the date."
msgstr "ຂໍ້ຄວາມທີ່ສະແດງເຖິງວັນທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string that holds the time representation."
msgstr "ຂໍ້ຄວາມທີ່ສະແດງເຖິງເວລາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string that will replace search_for."
msgstr "ຂໍ້ຄວາມທີ່ຈະນຳມາແທນທີ່ search_for."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to convert to lowercase."
msgstr "ຂໍ້ຄວາມທີ່ຈະປ່ຽນເປັນຕົວພິມນ້ອຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to convert to uppercase."
msgstr "ຂໍ້ຄວາມທີ່ຈະປ່ຽນເປັນຕົວພິມໃຫຍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to extract a segment from."
msgstr "ຂໍ້ຄວາມທີ່ຈະດຶງເອົາບາງສ່ວນອອກມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to look for within text_to_search."
msgstr "ຂໍ້ຄວາມທີ່ຈະຊອກຫາພາຍໃນ text_to_search."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to search for within text_to_search."
msgstr "ຂໍ້ຄວາມທີ່ຈະຄົ້ນຫາພາຍໃນ text_to_search."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string to test."
msgstr "ຂໍ້ຄວາມທີ່ຈະທົດສອບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The string whose length will be returned."
msgstr "ຂໍ້ຄວາມທີ່ຈະສົ່ງຄືນຄ່າຄວາມຍາວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The substring after which text will be returned."
msgstr "ຂໍ້ຄວາມຍ່ອຍ ທີ່ຂໍ້ຄວາມຖັດຈາກນັ້ນຈະຖືກສົ່ງຄືນມາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The subtrahend, or number to subtract from value1."
msgstr "ຕົວລົບ, ຫຼື ຕົວເລກທີ່ຈະນຳໄປລົບອອກຈາກ value1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The table zone is invalid for an unknown reason"
msgstr "ເຂດຕາຕະລາງບໍ່ຖືກຕ້ອງ ຍ້ອນເຫດຜົນທີ່ບໍ່ຮູ້ສາເຫດ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The table_number (%s) is out of range."
msgstr "table_number (%s) ຢູ່ນອກຂອບເຂດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text or reference to a cell containing text to be trimmed."
msgstr "ຂໍ້ຄວາມ ຫຼື ການອ້າງອີງໃສ່ຫ້ອງເຊວທີ່ມີຂໍ້ຄວາມທີ່ຕ້ອງການຕັດຍະຫວ່າງອອກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to display in the cell, enclosed in quotation marks."
msgstr "ຂໍ້ຄວາມທີ່ຈະສະແດງໃນຫ້ອງເຊວ, ໂດຍຂັ້ນດ້ວຍເຄື່ອງໝາຍວົງຢືມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to divide."
msgstr "ຂໍ້ຄວາມທີ່ຈະແບ່ງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to search for the first occurrence of search_for."
msgstr "ຂໍ້ຄວາມທີ່ຈະຄົ້ນຫາຕຳແໜ່ງທຳອິດທີ່ພົບ search_for."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to split."
msgstr "ຂໍ້ຄວາມທີ່ຈະແຍກອອກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text to use as the replacement."
msgstr "ຂໍ້ຄວາມທີ່ຈະນຳມາໃຊ້ແທນທີ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text which will be inserted into the original text."
msgstr "ຂໍ້ຄວາມທີ່ຈະແຊກເຂົ້າໄປໃນຂໍ້ຄວາມຕົ້ນສະບັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The text which will be returned with the first letter of each word in "
"uppercase and all other letters in lowercase."
msgstr ""
"ຂໍ້ຄວາມທີ່ຈະສົ່ງຄືນມາ ໂດຍໃຫ້ຕົວອັກສອນທຳອິດຂອງແຕ່ລະຄຳເປັນຕົວພິມໃຫຍ່ ແລະ ຕົວອື່ນໆທັງໝົດເປັນຕົວພິມນ້ອຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text whose non-printable characters are to be removed."
msgstr "ຂໍ້ຄວາມທີ່ຕ້ອງການລຶບຕົວອັກສອນທີ່ບໍ່ສາມາດພິມອອກມາໄດ້ນັ້ນອອກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text within which to search and replace."
msgstr "ຂໍ້ຄວາມທີ່ຈະຄົ້ນຫາ ແລະ ແທນທີ່ພາຍໃນນັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text, a part of which will be replaced."
msgstr "ຂໍ້ຄວາມທີ່ຈະຖືກແທນທີ່ບາງສ່ວນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The text_to_search must be non-empty."
msgstr "text_to_search ຕ້ອງບໍ່ຫວ່າງເປົ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time from which to calculate the hour component."
msgstr "ເວລາທີ່ຈະນຳມາຄິດໄລ່ເອົາສ່ວນຂອງຊົ່ວໂມງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time from which to calculate the minute component."
msgstr "ເວລາທີ່ຈະນຳມາຄິດໄລ່ເອົາສ່ວນຂອງນາທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time from which to calculate the second component."
msgstr "ເວລາທີ່ຈະນຳມາຄິດໄລ່ເອົາສ່ວນຂອງວິນາທີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The time_string (%s) cannot be parsed to date/time."
msgstr "time_string (%s) ບໍ່ສາມາດແປງເປັນ ວັນທີ/ເວລາ ໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The timing of the payment payments are due for each period."
msgstr "ກຳນົດເວລາຂອງການຊຳລະເງິນທີ່ຄົບກຳນົດໃນແຕ່ລະງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The two ranges must have the same dimensions."
msgstr "ສອງຊ່ວງຂໍ້ມູນຕ້ອງມີມິຕິຂະໜາດເທົ່າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The type (%s) is out of range."
msgstr "ປະເພດ (%s) ຢູ່ນອກຂອບເຂດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The type (%s) must be between 1 and 3 or between 11 and 17."
msgstr "ປະເພດ (%s) ຕ້ອງຢູ່ລະຫວ່າງ 1 ຫາ 3 ຫຼື ລະຫວ່າງ 11 ຫາ 17."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The type of information requested."
msgstr "ປະເພດຂອງຂໍ້ມູນທີ່ຮ້ອງຂໍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The unit (%s) must be strictly positive."
msgstr "ຫົວໜ່ວຍ (%s) ຕ້ອງເປັນຄ່າບວກຢ່າງເຂັ້ມງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The unit of measure into which to convert value"
msgstr "ຫົວໜ່ວຍວັດແທກທີ່ຈະແປງຄ່າໄປໃສ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The units of the desired fraction, e.g. 8 for 1/8ths or 32 for 1/32nds."
msgstr "ຫົວໜ່ວຍເສດສ່ວນທີ່ຕ້ອງການ, ຕົວຢ່າງ: 8 ສຳລັບ 1/8 ຫຼື 32 ສຳລັບ 1/32."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The units of the fraction, e.g. 8 for 1/8ths or 32 for 1/32nds."
msgstr "ຫົວໜ່ວຍເສດສ່ວນ, ຕົວຢ່າງ: 8 ສຳລັບ 1/8 ຫຼື 32 ສຳລັບ 1/32."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The upper inflection point value must be a number"
msgstr "ຄ່າຈຸດປ່ຽນໂຄ້ງດ້ານເທິງຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) cannot be between -1 and 1 inclusive."
msgstr "ຄ່າ (%s) ບໍ່ສາມາດຢູ່ລະຫວ່າງ -1 ຫາ 1 ໄດ້ (ລວມທັງສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be a valid base %s representation."
msgstr "ຄ່າ (%s) ຕ້ອງເປັນການສະແດງຖານ %s ທີ່ຖືກຕ້ອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be between -1 and 1 exclusive."
msgstr "ຄ່າ (%s) ຕ້ອງຢູ່ລະຫວ່າງ -1 ຫາ 1 (ບໍ່ລວມສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be between -1 and 1 inclusive."
msgstr "ຄ່າ (%s) ຕ້ອງຢູ່ລະຫວ່າງ -1 ຫາ 1 (ລວມທັງສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be greater than or equal to 1."
msgstr "ຄ່າ (%s) ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be positive or null."
msgstr "ຄ່າ (%s) ຕ້ອງເປັນຄ່າບວກ ຫຼື ເປັນຄ່າຫວ່າງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value (%s) must be strictly positive."
msgstr "ຄ່າ (%s) ຕ້ອງເປັນຄ່າບວກຢ່າງເຂັ້ມງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value does not match the custom formula data validation rule"
msgstr "ຄ່າບໍ່ກົງກັບກົດການກວດສອບຄວາມຖືກຕ້ອງຂອງຂໍ້ມູນແບບກຳນົດສູດເອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse cosine. Must be between -1 and "
"1, inclusive."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ cosine ປີ້ນກັບ. ຕ້ອງຢູ່ລະຫວ່າງ -1 ຫາ 1 (ລວມທັງສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the inverse cotangent."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ cotangent ປີ້ນກັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse hyperbolic cosine. Must be "
"greater than or equal to 1."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ hyperbolic cosine ປີ້ນກັບ. ຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse hyperbolic cotangent. Must not "
"be between -1 and 1, inclusive."
msgstr ""
"ຄ່າທີ່ຕ້ອງການຄິດໄລ່ hyperbolic cotangent ປີ້ນກັບ. ຕ້ອງບໍ່ຢູ່ລະຫວ່າງ -1 ຫາ 1 (ລວມທັງສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the inverse hyperbolic sine."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ hyperbolic sine ປີ້ນກັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse hyperbolic tangent. Must be "
"between -1 and 1, exclusive."
msgstr ""
"ຄ່າທີ່ຕ້ອງການຄິດໄລ່ hyperbolic tangent ປີ້ນກັບ. ຕ້ອງຢູ່ລະຫວ່າງ -1 ຫາ 1 (ບໍ່ລວມສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value for which to calculate the inverse sine. Must be between -1 and 1, "
"inclusive."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ sine ປີ້ນກັບ. ຕ້ອງຢູ່ລະຫວ່າງ -1 ຫາ 1 (ລວມທັງສອງຄ່ານີ້)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the inverse tangent."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ tangent ປີ້ນກັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the logarithm, base e."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ logarithm ຖານ e."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value for which to calculate the logarithm."
msgstr "ຄ່າທີ່ຕ້ອງການຄິດໄລ່ logarithm."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be %s"
msgstr "ຄ່າຕ້ອງແມ່ນ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a boolean"
msgstr "ຄ່າຕ້ອງເປັນບູລີນ (Boolean)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date"
msgstr "ຄ່າຕ້ອງເປັນວັນທີ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date after %s"
msgstr "ຄ່າຕ້ອງເປັນວັນທີຫຼັງຈາກ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date before %s"
msgstr "ຄ່າຕ້ອງເປັນວັນທີກ່ອນ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date between %s and %s"
msgstr "ຄ່າຕ້ອງເປັນວັນທີລະຫວ່າງ %s ຫາ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date not between %s and %s"
msgstr "ຄ່າຕ້ອງເປັນວັນທີທີ່ບໍ່ຢູ່ລະຫວ່າງ %s ຫາ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date on or after %s"
msgstr "ຄ່າຕ້ອງເປັນວັນທີໃນ ຫຼື ຫຼັງຈາກ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a date on or before %s"
msgstr "ຄ່າຕ້ອງເປັນວັນທີໃນ ຫຼື ກ່ອນ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a formula"
msgstr "ຄ່າຕ້ອງເປັນສູດຄິດໄລ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a number"
msgstr "ຄ່າຕ້ອງເປັນຕົວເລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a positive number"
msgstr "ຄ່າຕ້ອງເປັນຕົວເລກບວກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that begins with \"%s\""
msgstr "ຄ່າຕ້ອງເປັນຂໍ້ຄວາມທີ່ເລີ່ມຕົ້ນດ້ວຍ \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that contains \"%s\""
msgstr "ຄ່າຕ້ອງເປັນຂໍ້ຄວາມທີ່ມີ \"%s\" ຢູ່ພາຍໃນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that does not contain \"%s\""
msgstr "ຄ່າຕ້ອງເປັນຂໍ້ຄວາມທີ່ບໍ່ມີ \"%s\" ຢູ່ພາຍໃນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a text that ends with \"%s\""
msgstr "ຄ່າຕ້ອງເປັນຂໍ້ຄວາມທີ່ລົງທ້າຍດ້ວຍ \"%s\""

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid date"
msgstr "ຄ່າຕ້ອງເປັນວັນທີທີ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid email address"
msgstr "ຄ່າຕ້ອງເປັນທີ່ຢູ່ອີເມວທີ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid link"
msgstr "ຄ່າຕ້ອງເປັນລິ້ງທີ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a valid range"
msgstr "ຄ່າຕ້ອງເປັນຊ່ວງຂໍ້ມູນທີ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be a value in the range %s"
msgstr "ຄ່າຕ້ອງເປັນຄ່າທີ່ຢູ່ໃນຊ່ວງ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be between %s and %s"
msgstr "ຄ່າຕ້ອງຢູ່ລະຫວ່າງ %s ຫາ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be empty"
msgstr "ຄ່າຕ້ອງຫວ່າງເປົ່າ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be equal to %s"
msgstr "ຄ່າຕ້ອງເທົ່າກັບ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be exactly \"%s\""
msgstr "ຄ່າຕ້ອງແມ່ນ \"%s\" ຢ່າງແນ່ນອນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be greater or equal to %s"
msgstr "ຄ່າຕ້ອງຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be greater than %s"
msgstr "ຄ່າຕ້ອງຫຼາຍກວ່າ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be in bottom %(value)s%(percentSymbol)s"
msgstr "ຄ່າຕ້ອງຢູ່ໃນກຸ່ມ %(value)s%(percentSymbol)s ດ້ານລຸ່ມສຸດ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be in top %(value)s%(percentSymbol)s"
msgstr "ຄ່າຕ້ອງຢູ່ໃນກຸ່ມ %(value)s%(percentSymbol)s ດ້ານເທິງສຸດ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be less or equal to %s"
msgstr "ຄ່າຕ້ອງນ້ອຍກວ່າ ຫຼື ເທົ່າກັບ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be less than %s"
msgstr "ຄ່າຕ້ອງນ້ອຍກວ່າ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be one of: %s"
msgstr "ຄ່າຕ້ອງແມ່ນໜຶ່ງໃນ: %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be the date %s"
msgstr "ຄ່າຕ້ອງແມ່ນວັນທີ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must be unique"
msgstr "ຄ່າຕ້ອງບໍ່ຊ້ຳກັນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be a formula"
msgstr "ຄ່າຕ້ອງບໍ່ແມ່ນສູດຄິດໄລ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be between %s and %s"
msgstr "ຄ່າຕ້ອງບໍ່ຢູ່ລະຫວ່າງ %s ຫາ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be empty"
msgstr "ຄ່າຕ້ອງບໍ່ຫວ່າງເປົ່າ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be equal to %s"
msgstr "ຄ່າຕ້ອງບໍ່ເທົ່າກັບ %s"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value must not be unique"
msgstr "ຄ່າຕ້ອງບໍ່ແມ່ນຄ່າສະເພາະ (ຕ້ອງມີຄ່າຊ້ຳ)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value of the asset at the end of depreciation."
msgstr "ມູນຄ່າຂອງຊັບສິນເມື່ອສິ້ນສຸດການຮັກຄ່າຫຼຸ້ຍຫ້ຽນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value the function returns if logical_expression is FALSE."
msgstr "ຄ່າທີ່ຟັງຊັນຈະສົ່ງກັບຄືນ ຖ້າ logical_expression ເປັນ FALSE (ຜິດ)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value the function returns if logical_expression is TRUE."
msgstr "ຄ່າທີ່ຟັງຊັນຈະສົ່ງກັບຄືນ ຖ້າ logical_expression ເປັນ TRUE (ຖືກ)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value the function returns if value is an #N/A error."
msgstr "ຄ່າທີ່ຟັງຊັນຈະສົ່ງກັບຄືນ ຖ້າຄ່ານັ້ນເປັນຂໍ້ຜິດພາດ #N/A."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value the function returns if value is an error."
msgstr "ຄ່າທີ່ຟັງຊັນຈະສົ່ງກັບຄືນ ຖ້າຄ່ານັ້ນເກີດຂໍ້ຜິດພາດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to append to value1."
msgstr "ຄ່າທີ່ຈະນຳໄປຕໍ່ທ້າຍ value1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be checked."
msgstr "ຄ່າທີ່ຈະຖືກກວດສອບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be returned if its corresponding condition is TRUE."
msgstr "ຄ່າທີ່ຈະຖືກສົ່ງກັບຄືນ ຖ້າເງື່ອນໄຂທີ່ກ່ຽວຂ້ອງເປັນ TRUE (ຖືກ)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be truncated."
msgstr "ຄ່າທີ່ຈະຖືກຕັດເສດອອກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be verified as a logical TRUE or FALSE."
msgstr "ຄ່າທີ່ຈະກວດສອບວ່າເປັນຄ່າຕັກກະສາດ TRUE ຫຼື FALSE."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be verified as a number."
msgstr "ຄ່າທີ່ຈະກວດສອບວ່າເປັນຕົວເລກຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be verified as an error type."
msgstr "ຄ່າທີ່ຈະກວດສອບວ່າເປັນປະເພດຂໍ້ຜິດພາດຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be verified as even."
msgstr "ຄ່າທີ່ຈະກວດສອບວ່າເປັນເລກຄູ່ຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to be verified as text."
msgstr "ຄ່າທີ່ຈະກວດສອບວ່າເປັນຂໍ້ຄວາມຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to evaluate."
msgstr "ຄ່າທີ່ຈະນຳມາປະເມີນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to interpret as a percentage."
msgstr "ຄ່າທີ່ຈະຕີຄວາມໝາຍເປັນເປີເຊັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to return if value itself is not #N/A an error."
msgstr "ຄ່າທີ່ຈະສົ່ງກັບຄືນ ຖ້າຄ່ານັ້ນບໍ່ໄດ້ເປັນຂໍ້ຜິດພາດແບບ #N/A."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to return if value itself is not an error."
msgstr "ຄ່າທີ່ຈະສົ່ງກັບຄືນ ຖ້າຄ່ານັ້ນບໍ່ມີຂໍ້ຜິດພາດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round down to the nearest integer multiple of factor."
msgstr "ຄ່າທີ່ຈະມົນລົງຫາຈຳນວນຖ້ວນທີ່ເປັນຜົນຄູນທີ່ໃກ້ທີ່ສຸດຂອງ factor."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The value to round down to the nearest integer multiple of significance."
msgstr "ຄ່າທີ່ຈະມົນລົງຫາຈຳນວນຖ້ວນທີ່ເປັນຜົນຄູນທີ່ໃກ້ທີ່ສຸດຂອງ significance."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round to places number of places, always rounding down."
msgstr "ຄ່າທີ່ຈະມົນຕາມຈຳນວນຫຼັກທົດສະນິຍົມ, ໂດຍມົນລົງສະເໝີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round to places number of places, always rounding up."
msgstr "ຄ່າທີ່ຈະມົນຕາມຈຳນວນຫຼັກທົດສະນິຍົມ, ໂດຍມົນຂຶ້ນສະເໝີ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round to places number of places."
msgstr "ຄ່າທີ່ຈະມົນຕາມຈຳນວນຫຼັກທົດສະນິຍົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round to the next greatest odd number."
msgstr "ຄ່າທີ່ຈະມົນຂຶ້ນໄປຫາເລກຄີກຖັດໄປທີ່ຫຼາຍກວ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round up to the nearest integer multiple of factor."
msgstr "ຄ່າທີ່ຈະມົນຂຶ້ນຫາຈຳນວນຖ້ວນທີ່ເປັນຜົນຄູນທີ່ໃກ້ທີ່ສຸດຂອງ factor."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to round up to the nearest integer multiple of significance."
msgstr "ຄ່າທີ່ຈະມົນຂຶ້ນຫາຈຳນວນຖ້ວນທີ່ເປັນຜົນຄູນທີ່ໃກ້ທີ່ສຸດຂອງ significance."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to search for."
msgstr "ຄ່າທີ່ຈະຄົ້ນຫາ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to search for. For example, 42, 'Cats', or I24."
msgstr "ຄ່າທີ່ຈະຄົ້ນຫາ. ຕົວຢ່າງ: 42, 'Cats', ຫຼື I24."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to test against value1 for equality."
msgstr "ຄ່າທີ່ຈະທົດສອບຄວາມເທົ່າກັນກັບ value1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to test against value1 for inequality."
msgstr "ຄ່າທີ່ຈະທົດສອບຄວາມບໍ່ເທົ່າກັນກັບ value1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to test as being greater than or equal to value2."
msgstr "ຄ່າທີ່ຈະທົດສອບວ່າຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ value2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to test as being greater than value2."
msgstr "ຄ່າທີ່ຈະທົດສອບວ່າຫຼາຍກວ່າ value2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to test as being less than or equal to value2."
msgstr "ຄ່າທີ່ຈະທົດສອບວ່ານ້ອຍກວ່າ ຫຼື ເທົ່າກັບ value2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to test as being less than value2."
msgstr "ຄ່າທີ່ຈະທົດສອບວ່ານ້ອຍກວ່າ value2."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to use for padding empty cells."
msgstr "ຄ່າທີ່ຈະໃຊ້ຕື່ມໃສ່ຫ້ອງເຊວທີ່ຫວ່າງເປົ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value to which value2 will be appended."
msgstr "ຄ່າທີ່ value2 ຈະຖືກນຳໄປຕໍ່ທ້າຍໃສ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value whose rank will be determined."
msgstr "ຄ່າທີ່ຈະກຳນົດອັນດັບ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value with which to fill the extra cells in the range."
msgstr "ຄ່າທີ່ຈະໃຊ້ຕື່ມໃສ່ຫ້ອງເຊວສ່ວນເກີນໃນຊ່ວງຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value with which to pad."
msgstr "ຄ່າທີ່ຈະໃຊ້ຕື່ມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The value(s) on the x-axis to forecast."
msgstr "ຄ່າໃນແກນ X ທີ່ຕ້ອງການພະຍາກອນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The values of the independent variable(s) corresponding with known_data_y."
msgstr "ຄ່າຂອງຕົວປ່ຽນເອກະລາດທີ່ກົງກັບ known_data_y."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The vertical axis values range is invalid"
msgstr "ຊ່ວງຄ່າຂອງແກນຕັ້ງບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The weekend (%s) must be a string or a number in the range 1-7 or 11-17."
msgstr "weekend (%s) ຕ້ອງເປັນຂໍ້ຄວາມ ຫຼື ຕົວເລກໃນຊ່ວງ 1-7 ຫຼື 11-17."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The weekend must be a number or a string."
msgstr "weekend ຕ້ອງເປັນຕົວເລກ ຫຼື ຂໍ້ຄວາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The weekend must be different from '1111111'."
msgstr "weekend ຕ້ອງບໍ່ແມ່ນ '1111111'."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The window is too small to display multiple side panels."
msgstr "ໜ້າຕ່າງນ້ອຍເກີນໄປທີ່ຈະສະແດງແຖບດ້ານຂ້າງຫຼາຍແຜ່ນໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The wrap_count (%s) must be strictly positive."
msgstr "wrap_count (%s) ຕ້ອງເປັນຄ່າບວກຢ່າງເຂັ້ມງວດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The x coordinate of the endpoint of the line segment for which to calculate "
"the angle from the x-axis."
msgstr "ພິກັດ X ຂອງຈຸດສິ້ນສຸດເສັ້ນຊື່ ທີ່ຕ້ອງການຄິດໄລ່ມຸມຈາກແກນ X."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"The y coordinate of the endpoint of the line segment for which to calculate "
"the angle from the x-axis."
msgstr "ພິກັດ Y ຂອງຈຸດສິ້ນສຸດເສັ້ນຊື່ ທີ່ຕ້ອງການຄິດໄລ່ມຸມຈາກແກນ X."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "The year (%s) must be between 0 and 9999 inclusive."
msgstr "ປີ (%s) ຕ້ອງຢູ່ລະຫວ່າງ 0 ຫາ 9999 (ລວມທັງສອງຄ່ານີ້)."

#. module: spreadsheet
