msgstr "ສົ່ງຄືນໝາຍເລກຖັນຂອງຕາກະໂລໃນການອ້າງອີງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the content of a cell, specified by a string."
msgstr "ສົ່ງຄືນເນື້ອໃນຂອງຕາກະໂລ, ທີ່ລະບຸໂດຍຂໍ້ຄວາມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the content of a cell, specified by row and column offset."
msgstr "ສົ່ງຄືນເນື້ອໃນຂອງຕາກະໂລ, ທີ່ລະບຸໂດຍໄລຍະຫ່າງແຖວ ແລະ ຖັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the error value #N/A."
msgstr "ສົ່ງຄືນຄ່າຂໍ້ຜິດພາດ #N/A."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the first n items in a data set after performing a sort."
msgstr "ສົ່ງຄືນ n ລາຍການທຳອິດໃນຊຸດຂໍ້ມູນ ຫຼັງຈາກດຳເນີນການຈັດລຽງແລ້ວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the format of the top left cell in reference."
msgstr "ສົ່ງຄືນຮູບແບບຂອງຕາກະໂລເທິງຊ້າຍສຸດໃນການອ້າງອີງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the interest paid at a particular period of an investment."
msgstr "ສົ່ງຄືນດອກເບ້ຍທີ່ຈ່າຍໃນງວດໃດໜຶ່ງສະເພາະຂອງການລົງທຶນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the matrix determinant of a square matrix."
msgstr "ສົ່ງຄືນເດແຕກມີນັງຂອງມາຕຣິກຈະຕຸລັດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the maximum value in a range of cells, filtered by a set of criteria."
msgstr "ສົ່ງຄືນຄ່າສູງສຸດໃນຂອບເຂດຕາກະໂລ, ທີ່ຖືກກັ່ນຕອງຕາມເງື່ອນໄຂທີ່ກຳນົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the minimum value in a range of cells, filtered by a set of criteria."
msgstr "ສົ່ງຄືນຄ່າຕໍ່າສຸດໃນຂອບເຂດຕາກະໂລ, ທີ່ຖືກກັ່ນຕອງຕາມເງື່ອນໄຂທີ່ກຳນົດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the multiplicative inverse of a square matrix."
msgstr "ສົ່ງຄືນມາຕຣິກປີ້ນຂອງມາຕຣິກຈະຕຸລັດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the p-value of a Student's t-test."
msgstr "ສົ່ງຄືນຄ່າ p-value ຂອງການທົດສອບ Student's t-test."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the p-value of a chi-square test for independence, comparing actual "
"to expected values."
msgstr ""
"ສົ່ງຄືນຄ່າ p-value ຂອງການທົດສອບໄຄສະແຄວສຳລັບຄວາມເປັນອິດສະຫຼະ, "
"ໂດຍປຽບທຽບຄ່າຕົວຈິງກັບຄ່າທີ່ຄາດຫວັງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the rank of a specified value in a dataset."
msgstr "ສົ່ງຄືນອັນດັບຂອງຄ່າທີ່ລະບຸໃນຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the row number of the top left cell in reference."
msgstr "ສົ່ງຄືນໝາຍເລກແຖວຂອງຕາກະໂລເທິງຊ້າຍສຸດໃນການອ້າງອີງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the two-tailed p-value of an F-test comparing the variances of two "
"datasets."
msgstr ""
"ສົ່ງຄືນຄ່າ p-value ແບບສອງທ້າຍຂອງການທົດສອບ F-test ເຊິ່ງປຽບທຽບຄວາມແປປວນຂອງສອງຊຸດຂໍ້ມູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Returns the type of data in the cell in reference. The following values are "
"returned: \"b\" for a blank cell, \"l\" (for label) if the cell contains "
"plain text, and \"v\" (for value) if the cell contains any other type of "
"data."
msgstr ""
"ສົ່ງຄືນປະເພດຂອງຂໍ້ມູນໃນຕາກະໂລທີ່ອ້າງອີງ. ຄ່າທີ່ຈະຖືກສົ່ງຄືນມີດັ່ງນີ້: \"b\" ສຳລັບຕາກະໂລຫວ່າງເປົ່າ, "
"\"l\" (ສຳລັບປ້າຍກຳກັບ) ຖ້າຕາກະໂລມີຂໍ້ຄວາມທຳມະດາ, ແລະ \"v\" (ສຳລັບຄ່າ) "
"ຖ້າຕາກະໂລມີຂໍ້ມູນປະເພດອື່ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns the value contained in the top left cell in reference."
msgstr "ສົ່ງຄືນຄ່າທີ່ມີຢູ່ໃນຕາກະໂລເທິງຊ້າຍສຸດໃນການອ້າງອີງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Returns value depending on logical expression."
msgstr "ສົ່ງຄືນຄ່າຂຶ້ນກັບນິພົດຕັກກະສາດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Reveals correlation between two numeric variables."
msgstr "ສະແດງໃຫ້ເຫັນສາຍພົວພັນລະຫວ່າງສອງຕົວປ່ຽນຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Reverse icons"
msgstr "ກັບດ້ານໄອຄອນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Right"
msgstr "ຂວາ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Right axis"
msgstr "ແກນຂວາ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rotation"
msgstr "ການໝຸນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rounds a number according to standard rules."
msgstr "ມົນຕົວເລກຕາມກົດເກນມາດຕະຖານ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Rounds a number down to the nearest integer that is less than or equal to it."
msgstr "ມົນຕົວເລກລົງເປັນຈຳນວນຖ້ວນທີ່ໃກ້ຄຽງທີ່ສຸດ ເຊິ່ງໜ້ອຍກວ່າ ຫຼື ເທົ່າກັບຄ່ານັ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rounds a number up to the nearest odd integer."
msgstr "ມົນຕົວເລກຂຶ້ນເປັນຈຳນວນຄີກທີ່ໃກ້ຄຽງທີ່ສຸດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rounds down a number."
msgstr "ມົນຕົວເລກລົງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rounds number down to nearest multiple of factor."
msgstr "ມົນຕົວເລກລົງເປັນຈຳນວນທະວີຄູນທີ່ໃກ້ຄຽງທີ່ສຸດຂອງຕົວຄູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rounds number up to nearest multiple of factor."
msgstr "ມົນຕົວເລກຂຶ້ນເປັນຈຳນວນທະວີຄູນທີ່ໃກ້ຄຽງທີ່ສຸດຂອງຕົວຄູນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Rounds up a number."
msgstr "ມົນຕົວເລກຂຶ້ນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Row above"
msgstr "ແຖວທາງເທິງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Row below"
msgstr "ແຖວທາງລຸ່ມ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Row number of a specified cell."
msgstr "ໝາຍເລກແຖວຂອງຕາກະໂລທີ່ລະບຸ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Rows"
msgstr "ແຖວ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Rows to ignore"
msgstr "ແຖວທີ່ຈະລະເວັ້ນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Running total"
msgstr "ຜົນລວມສະສົມ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "SKEW requires at least 3 values."
msgstr "SKEW ຕ້ອງການຢ່າງໜ້ອຍ 3 ຄ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "SKEW requires non-constant data."
msgstr "SKEW ຕ້ອງການຂໍ້ມູນທີ່ບໍ່ແມ່ນຄ່າຄົງທີ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "SKEW.P requires at least 3 values."
msgstr "SKEW.P ຕ້ອງການຢ່າງໜ້ອຍ 3 ຄ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "SKEW.P requires non-constant data."
msgstr "SKEW.P ຕ້ອງການຂໍ້ມູນທີ່ບໍ່ແມ່ນຄ່າຄົງທີ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "SUM"
msgstr "SUM"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Same as pie, cleaner proportional look."
msgstr "ຄືກັນກັບຮູບວົງມົນ, ແຕ່ສະແດງສັດສ່ວນໄດ້ສະອາດຕາກວ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Sample:"
msgstr "ຕົວຢ່າງ:"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Saturday"
msgstr "ວັນເສົາ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Saturday is the only weekend"
msgstr "ວັນເສົາເປັນມື້ພັກທ້າຍອາທິດມື້ດຽວ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Saturday/Sunday are weekends"
msgstr "ວັນເສົາ/ວັນອາທິດ ເປັນມື້ພັກທ້າຍອາທິດ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Save"
msgstr "ບັນທຶກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Scale"
msgstr "ມາດຕາສ່ວນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Scan by column"
msgstr "ກວດສອບຕາມຖັນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Scan by row (default)"
msgstr "ກວດສອບຕາມແຖວ (ຄ່າເລີ່ມຕົ້ນ)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Scan the array by column. By default, the array is scanned by row."
msgstr "ກວດສອບອາເຣຕາມຖັນ. ຕາມຄ່າເລີ່ມຕົ້ນ, ອາເຣຈະຖືກກວດສອບຕາມແຖວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Scatter"
msgstr "ກະຈາຍ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Scientific"
msgstr "ວິທະຍາສາດ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Scorecard"
msgstr "ໃບບັນທຶກຄະແນນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Scorecard Design"
msgstr "ການອອກແບບໃບບັນທຶກຄະແນນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Search"
msgstr "ຄົ້ນຫາ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Search a range for a match and return the corresponding item from a second "
"range."
msgstr "ຄົ້ນຫາຂໍ້ມູນທີ່ກົງກັນໃນຂອບເຂດ ແລະ ສົ່ງຄືນລາຍການທີ່ກົງກັນຈາກຂອບເຂດທີສອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Search first to last (default)"
msgstr "ຄົ້ນຫາແຕ່ຕົ້ນຫາທ້າຍ (ຄ່າເລີ່ມຕົ້ນ)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Search in formulas"
msgstr "ຄົ້ນຫາໃນສູດຄິດໄລ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Search last to first"
msgstr "ຄົ້ນຫາແຕ່ທ້າຍຫາຕົ້ນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Search..."
msgstr "ຄົ້ນຫາ..."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Searches the text for a delimiter match. By default, a case-sensitive match "
"is done."
msgstr "ຄົ້ນຫາຂໍ້ຄວາມສຳລັບຕົວຂັ້ນທີ່ກົງກັນ. ຕາມຄ່າເລີ່ມຕົ້ນ, ຈະກວດສອບແບບກົງຕາມຕົວພິມນ້ອຍ-ໃຫຍ່."

#. module: spreadsheet
