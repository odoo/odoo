msgstr "ກຳນົດວ່າການຈັບຄູ່ຈະແຍກແຍະຕົວພິມນ້ອຍ-ໃຫຍ່ຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether the provided value is even."
msgstr "ກວດສອບວ່າຄ່າທີ່ລະບຸເປັນເລກຄູ່ຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether the referenced cell is empty"
msgstr "ກວດສອບວ່າຫ້ອງເຊວທີ່ອ້າງອີງຫວ່າງເປົ່າຫຼືບໍ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Whether to consider the values in data in descending or ascending order."
msgstr "ກຳນົດວ່າຈະພິຈາລະນາຄ່າໃນຂໍ້ມູນແບບຈັດລຽງຈາກຫຼາຍຫາໜ້ອຍ ຫຼື ແຕ່ໜ້ອຍຫາຫຼາຍ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to filter the data by columns or by rows."
msgstr "ກຳນົດວ່າຈະກັ່ນຕອງຂໍ້ມູນຕາມຖັນ ຫຼື ຕາມແຖວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Whether to ignore certain types of values. By default, no values are ignored."
msgstr "ກຳນົດວ່າຈະລະເລີຍຄ່າບາງປະເພດຫຼືບໍ່. ໂດຍຄ່າເລີ່ມຕົ້ນແລ້ວ ຈະບໍ່ມີການລະເລີຍຄ່າໃດໆ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to ignore empty cells."
msgstr "ກຳນົດວ່າຈະລະເລີຍຫ້ອງເຊວທີ່ຫວ່າງເປົ່າຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to include the column titles or not."
msgstr "ກຳນົດວ່າຈະລວມຫົວຂໍ້ຖັນຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to include the measure titles row or not."
msgstr "ກຳນົດວ່າຈະລວມແຖວຫົວຂໍ້ການວັດແທກຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to include total/sub-totals or not."
msgstr "ກຳນົດວ່າຈະລວມຍອດລວມ/ຍອດລວມຍ່ອຍຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to match a delimiter against the end of the text."
msgstr "ກຳນົດວ່າຈະຈັບຄູ່ຕົວຂັ້ນກັບທ້າຍຂໍ້ຄວາມຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to return only entries with no duplicates."
msgstr "ກຳນົດວ່າຈະສົ່ງຄືນສະເພາະລາຍການທີ່ບໍ່ມີຄ່າຊ້ຳກັນເທົ່ານັ້ນຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Whether to switch to straight-line depreciation when the depreciation is "
"greater than the declining balance calculation."
msgstr "ກຳນົດວ່າຈະປ່ຽນໄປໃຊ້ວິທີຫັກຄ່າຫຼຸ້ຍຫ້ຽນແບບເສັ້ນຊື່ຫຼືບໍ່ ເມື່ອຄ່າຫຼຸ້ຍຫ້ຽນສູງກວ່າການຄິດໄລ່ແບບຍອດຫຼຸດລົງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Whether to treat the end of text as a delimiter."
msgstr "ກຳນົດວ່າຈະຖືເອົາທ້າຍຂໍ້ຄວາມເປັນຕົວຂັ້ນຫຼືບໍ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Which choice to return."
msgstr "ຕົວເລືອກໃດທີ່ຈະສົ່ງກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Which quartile value to return."
msgstr "ຄ່າຄວໍໄທລ໌ໃດທີ່ຈະສົ່ງກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Which quartile value, exclusive of 0 and 4, to return."
msgstr "ຄ່າຄວໍໄທລ໌ໃດ, ໂດຍບໍ່ລວມ 0 ແລະ 4, ທີ່ຈະສົ່ງກັບຄືນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Width value is %(_width)s. It should be greater than or equal to 1."
msgstr "ຄ່າຄວາມກວ້າງແມ່ນ %(_width)s. ມັນຄວນຫຼາຍກວ່າ ຫຼື ເທົ່າກັບ 1."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wildcard character match"
msgstr "ການຈັບຄູ່ດ້ວຍຕົວອັກສອນ Wildcard"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Window"
msgstr "ໜ້າຕ່າງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Works well for named entities with long labels."
msgstr "ໃຊ້ໄດ້ດີສຳລັບລາຍການທີ່ມີຊື່ ຫຼື ປ້າຍກຳກັບຍາວ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/helpers/geo_json_service.js:0
msgid "World"
msgstr "ໂລກ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wrap"
msgstr "ຕັດຂຶ້ນແຖວໃໝ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wrapping"
msgstr "ການຕັດຂຶ້ນແຖວໃໝ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Wraps the provided row or column of cells by columns after a specified "
"number of elements to form a new array."
msgstr "ຕັດແຖວ ຫຼື ຖັນຂອງຫ້ອງເຊວທີ່ລະບຸຕາມຖັນ ຫຼັງຈາກຄົບຈຳນວນອົງປະກອບທີ່ກຳນົດ ເພື່ອສ້າງເປັນອາເຣໃໝ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Wraps the provided row or column of cells by rows after a specified number "
"of elements to form a new array."
msgstr ""
"ຕັດແຖວ ຫຼື ຖັນຂອງຫ້ອງເຊວທີ່ລະບຸຕາມແຖວ ຫຼັງຈາກຄົບຈຳນວນອົງປະກອບທີ່ກຳນົດ ເພື່ອສ້າງເປັນອາເຣໃໝ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wrong function call"
msgstr "ການເອີ້ນໃຊ້ຟັງຊັນບໍ່ຖືກຕ້ອງ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wrong number of arguments. Expected an even number of arguments."
msgstr "ຈຳນວນອາຣກິວເມັນບໍ່ຖືກຕ້ອງ. ຕ້ອງການຈຳນວນອາຣກິວເມັນເປັນເລກຄູ່."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wrong size for %s. Expected a range of size 1x%s. Got %sx%s."
msgstr "ຂະໜາດບໍ່ຖືກຕ້ອງສຳລັບ %s. ຕ້ອງການຊ່ວງຂະໜາດ 1x%s. ແຕ່ໄດ້ຮັບ %sx%s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Wrong value of 'display_ties_mode'. Expected a positive number between 0 and "
"3. Got %s."
msgstr ""
"ຄ່າຂອງ 'display_ties_mode' ບໍ່ຖືກຕ້ອງ. ຕ້ອງການຕົວເລກບວກລະຫວ່າງ 0 ຫາ 3. ແຕ່ໄດ້ຮັບ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Wrong value of 'n'. Expected a positive number. Got %s."
msgstr "ຄ່າຂອງ 'n' ບໍ່ຖືກຕ້ອງ. ຕ້ອງການຕົວເລກບວກ. ແຕ່ໄດ້ຮັບ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/global_filters/helpers.js:0
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Year"
msgstr "ປີ"

#. module: spreadsheet
#. odoo-javascript
