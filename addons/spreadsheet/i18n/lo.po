msgstr "[[FUNCTION_NAME]] ມີຈຳນວນອາຣກິວເມັນບໍ່ກົງກັນລະຫວ່າງ %s ກັບ %s."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] has mismatched dimensions for argument %s (%s vs %s)."
msgstr "[[FUNCTION_NAME]] ມີມິຕິຂະໜາດບໍ່ກົງກັນສຳລັບອາຣກິວເມັນ %s (%s ກັບ %s)."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] has mismatched range sizes."
msgstr "[[FUNCTION_NAME]] ມີຂະໜາດຊ່ວງຂໍ້ມູນບໍ່ກົງກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] has no valid input data."
msgstr "[[FUNCTION_NAME]] ບໍ່ມີຂໍ້ມູນຂາເຂົ້າທີ່ຖືກຕ້ອງ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "ascending"
msgstr "ແຕ່ໜ້ອຍຫາຫຼາຍ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "b is calculated normally"
msgstr "b ຖືກຄິດໄລ່ຕາມປົກກະຕິ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "b is forced to 1"
msgstr "b ຖືກກຳນົດໃຫ້ເປັນ 1"

#. module: spreadsheet
#. odoo-javascript
