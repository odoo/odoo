#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.xml:0
msgid "Zoom"
msgstr "ຊູມ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] evaluates to an out of bounds range."
msgstr "[[FUNCTION_NAME]] ປະມວນຜົນອອກມາຢູ່ນອກຂອບເຂດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] evaluates to an out of range column value %s."
msgstr "[[FUNCTION_NAME]] ປະມວນຜົນອອກມາເປັນຄ່າຖັນ %s ທີ່ຢູ່ນອກຂອບເຂດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] evaluates to an out of range row value %s."
msgstr "[[FUNCTION_NAME]] ປະມວນຜົນອອກມາເປັນຄ່າແຖວ %s ທີ່ຢູ່ນອກຂອບເຂດ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] expects number values."
msgstr "[[FUNCTION_NAME]] ຕ້ອງການຄ່າທີ່ເປັນຕົວເລກ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"[[FUNCTION_NAME]] expects the provided values of %(argName)s to be a non-"
"empty matrix."
msgstr "[[FUNCTION_NAME]] ຕ້ອງການໃຫ້ຄ່າຂອງ %(argName)s ທີ່ລະບຸເປັນມາຕຣິກທີ່ບໍ່ຫວ່າງເປົ່າ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "[[FUNCTION_NAME]] expects the weight to be positive or equal to 0."
msgstr "[[FUNCTION_NAME]] ຕ້ອງການໃຫ້ນ້ຳໜັກເປັນຄ່າບວກ ຫຼື ເທົ່າກັບ 0."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
