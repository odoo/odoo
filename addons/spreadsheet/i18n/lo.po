#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Calculates values as follows:\n"
"((value in cell) x (Grand Total of Grand Totals)) / ((Grand Row Total) x "
"(Grand Column Total))"
msgstr ""
"ຄິດໄລ່ຄ່າດັ່ງນີ້:\n"
"((ຄ່າໃນຫ້ອງ) x (ຍອດລວມທັງໝົດຂອງຍອດລວມທັງໝົດ)) / ((ຍອດລວມແຖວທັງໝົດ) x (ຍອດລວມຖັນທັງໝົດ))"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Calculates values as follows:\n"
"(value for the item) / (value for the parent item of the selected Base field)"
msgstr ""
"ຄິດໄລ່ຄ່າດັ່ງນີ້:\n"
"(ຄ່າຂອງລາຍການ) / (ຄ່າຂອງລາຍການຫຼັກຂອງຟິວພື້ນຖານທີ່ເລືອກ)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Calculates values as follows:\n"
"(value for the item) / (value for the parent item on columns)"
msgstr ""
"ຄິດໄລ່ຄ່າດັ່ງນີ້:\n"
"(ຄ່າຂອງລາຍການ) / (ຄ່າຂອງລາຍການຫຼັກໃນຖັນ)"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid ""
"Calculates values as follows:\n"
