msgstr "ຕັ້ງຄ່າຂະໜາດໃໝ່"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Result couldn't be automatically expanded."
msgstr "ບໍ່ສາມາດຂະຫຍາຍຜົນຮັບໂດຍອັດຕະໂນມັດໄດ້."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Result of multiplying a series of numbers together."
msgstr "ຜົນຮັບຈາກການຄູນຊຸດຕົວເລກເຂົ້າກັນ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return a whole number or a decimal value."
msgstr "ສົ່ງຄ່າກັບຄືນເປັນຈຳນວນຖ້ວນ ຫຼື ທົດສະນິຍົມ."

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return every distinct item"
msgstr "ສົ່ງຄ່າກັບຄືນທຸກລາຍການທີ່ແຕກຕ່າງກັນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/o_spreadsheet/o_spreadsheet.js:0
msgid "Return items that appear exactly once"
msgstr "ສົ່ງຄ່າກັບຄືນລາຍການທີ່ປະກົດຂຶ້ນພຽງຄັ້ງດຽວເທົ່ານັ້ນ"

#. module: spreadsheet
#. odoo-javascript
#: code:addons/spreadsheet/static/src/pivot/pivot_functions.js:0
