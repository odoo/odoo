<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="mail_activity_schedule_view_form" model="ir.ui.view">
    <field name="name">mail.activity.schedule.view.form.inherit.phone.validation</field>
    <field name="model">mail.activity.schedule</field>
    <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
    <field name="arch" type="xml">
        <field name="phone" position="before">
            <field name="phone_formatted" invisible="1"/><!-- phone widget: display format -->
        </field>
        <field name="phone" position="attributes">
            <attribute name="widget">phone</attribute>
            <attribute name="options">{'display_buttons': False}</attribute>
        </field>
    </field>
</record>

</odoo>
