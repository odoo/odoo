<odoo>
    <record id="view_l10n_cr_fe_mr_motivo_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cr.fe.mr.motivo.wizard.form</field>
        <field name="model">l10n_cr.fe.mr.motivo.wizard</field>
        <field name="arch" type="xml">
            <form string="Motivo del Mensaje Receptor">
                <field name="move_id" invisible="1"/>
                <field name="decision" invisible="1"/>
                <group>
                    <field name="motivo" placeholder="Ej. No venía en el pedido"/>
                </group>
                <footer>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
