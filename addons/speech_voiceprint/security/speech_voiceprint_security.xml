<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_speech_voiceprint_own" model="ir.rule">
        <field name="name">Voiceprint: own</field>
        <field name="model_id" ref="model_speech_voiceprint" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="rule_speech_voiceprint_hr" model="ir.rule">
        <field name="name">Voiceprint: the officer's companies</field>
        <field name="model_id" ref="model_speech_voiceprint" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('hr.group_hr_user'))]" />
    </record>

</odoo>
