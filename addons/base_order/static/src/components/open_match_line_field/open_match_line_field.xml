<?xml version="1.0" encoding="utf-8"?>
<templates>

    <!--
        A real button, not a click-handling div: this cell is the only one in an
        editable list that opens a document instead of entering edit mode, so it
        has to be reachable by keyboard and has to look actionable.
    -->
    <t t-name="base_order.OpenMatchLineField">
        <button type="button" class="btn btn-link p-0 text-start text-truncate"
                t-att-title="this.value"
                t-on-click.prevent.stop="this.openMatchLine"
                t-out="this.value"/>
    </t>

</templates>
