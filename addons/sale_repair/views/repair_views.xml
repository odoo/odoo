<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_repair_order_tree" model="ir.ui.view">
            <field name="name">repair.list</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_tree"/>
            <field name="arch" type="xml">
                <field name="picking_id" position="after">
                    <field name="sale_order_id" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_repair_order_form" model="ir.ui.view">
            <field name="name">repair.form</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="attributes">
                    <attribute name="readonly">sale_order_id</attribute>
                </field>
                <button name="action_assign" position="after">
                    <button name="action_create_sale_order" type="object" string="Quote" invisible="not can_create_sale_or_invoice"/>
                    <button name="action_create_invoice" type="object" string="Invoice" invisible="not (can_create_sale_or_invoice and state == 'done')"/>
                </button>
                <div class="oe_button_box" name="button_box" position="inside">
                    <button name="action_view_sale_order" type="object" string="Sale Order" icon="attach_money" class="oe_stat_button" invisible="not sale_order_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="sale_order_id" widget="statinfo" nolabel="1" class="mr4"/>
                            </span>
                            <span class="o_stat_text">Sale Order</span>
                        </div>
                    </button>
                    <button name="action_view_invoice"
                        type="object"
                        icon="edit_square"
                        class="oe_stat_button"
                        invisible="not invoice_count">
                        <field name="invoice_count" widget="statinfo" string="Invoices"/>
                    </button>
                </div>
                <field name="allowed_lot_ids" position="after">
                    <field name="repair_request" invisible="not sale_order_line_id"/>
                </field>
                <field name="picking_id" position="after">
                    <field name="under_warranty" readonly="state in ['cancel', 'done']"/>
                </field>
            </field>
        </record>

        <record id="view_repair_order_form_filter" model="ir.ui.view">
            <field name="name">repair.select</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="sale_order_id"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
