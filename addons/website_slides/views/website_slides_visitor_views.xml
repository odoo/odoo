<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_slides_visitor_page_view_tree" model="ir.ui.view">
        <field name="name">website.track.view.list</field>
        <field name="model">website.track</field>
        <field name="arch" type="xml">
            <list string="Visitor Course Views History" create="0">
                <field name="visitor_id"/>
                <field name="slide_channel_id"/>
                <field name="visit_datetime"/>
            </list>
        </field>
    </record>

    <record id="website_slides_visitor_slide_channel_action" model="ir.actions.act_window">
        <field name="name">Course Views History</field>
        <field name="res_model">website.track</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('website_slides_visitor_page_view_tree')}),
        ]"/>
        <field name="domain">[('visitor_id', '=', active_id), ('slide_channel_id', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
              No course views yet for this visitor
            </p>
        </field>
    </record>

    <record id="website_slides_visitor_page_view_search" model="ir.ui.view">
        <field name="name">website.slides.track.view.search</field>
        <field name="model">website.track</field>
        <field name="inherit_id" ref="website.website_visitor_page_view_search"/>
        <field name="arch" type="xml">
            <field name="url" position="after">
                <field name="slide_channel_id"/>
            </field>
            <filter name="type_url" position="after">
                <filter string="Courses" name="type_slide_channel" domain="[('slide_channel_id', '!=', False)]"/>
            </filter>
        </field>
    </record>

    <record id="website_slides_visitor_view_form" model="ir.ui.view">
        <field name="name">website.visitor.view.form</field>
        <field name="model">website.visitor</field>
        <field name="inherit_id" ref="website.website_visitor_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(website.website_visitor_page_action)d']" position="after">
                <button name="%(website_slides.website_slides_visitor_slide_channel_action)d"
                    type="action"
                    class="oe_stat_button"
                    icon="sell">
                    <field name="visitor_slide_channel_count" widget="statinfo" string="Course Views"/>
                </button>
            </xpath>
            <field name="page_ids" position="after">
                <field name="slide_channel_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="website_slides_visitor_view_tree" model="ir.ui.view">
        <field name="name">website.slides.visitor.view.list</field>
        <field name="model">website.visitor</field>
        <field name="inherit_id" ref="website.website_visitor_view_tree"/>
        <field name="arch" type="xml">
            <field name="page_ids" position="after">
                <field name="slide_channel_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="website_slides_visitor_track_view_tree" model="ir.ui.view">
        <field name="name">website.track.view.list</field>
        <field name="model">website.track</field>
        <field name="inherit_id" ref="website.website_visitor_track_view_tree"/>
        <field name="arch" type="xml">
            <field name="url" position="after">
                <field name="slide_channel_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
