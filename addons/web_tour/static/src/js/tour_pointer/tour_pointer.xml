<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="web_tour.TourPointer">
        <div
            t-if="this.isVisible"
            t-ref="pointer"
            t-attf-class="
                o_tour_pointer
                o_{{ this.position }}
                {{ this.isOpen ? 'o_open' : (this.props.bounce ? 'o_bouncing' : '') }}
                {{ this.props.pointerState.onClick ? 'cursor-pointer' : '' }}
            "
            t-attf-style="
                --TourPointer__width: {{ this.constructor.width }}px;
                --TourPointer__height: {{ this.constructor.height }}px;
            "
            t-on-mouseenter="this.props.pointerState.onMouseEnter or (() => {})"
            t-on-mouseleave="this.props.pointerState.onMouseLeave or (() => {})"
            t-on-click="this.props.pointerState.onClick or (() => {})"
        >
            <div class="o_tour_pointer_tip position-absolute" />
            <div
                class="o_tour_pointer_content rounded overflow-hidden px-3 py-2 w-100 h-100 position-relative"
                t-att-class="{ 'invisible': !this.isOpen }"
            >
                <span>
                    <t t-out="this.content" />
                </span>
                <div class="d-flex justify-content-end">
                    <button class="btn btn-link" t-on-click="this.onStopClicked">Stop Tour</button>
                </div>
            </div>
        </div>
        <div class="o_tour_dropzone position-fixed pe-none" t-if="this.props.pointerState.isVisible and this.props.pointerState.isZone" t-ref="zone" style="border: 3px dashed #714b67;"/>
    </t>
</templates>
