#. module: document
#: model:mail.template,body_html:document.mail_template_document_share
msgid ""
"<t t-set=\"documents\" t-value=\"ctx.get('documents', object.env['document.document'])\"/>\n"
"            <t t-set=\"access_urls_by_partner\" t-value=\"ctx.get('access_urls_by_partner', {})\"/>\n"
"            <t t-set=\"access_urls\" t-value=\"access_urls_by_partner.get(object) or {}\"/>\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                <tr>\n"
"                    <td align=\"center\">\n"
"                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                            <tbody>\n"
"                                <!-- HEADER -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\">\n"
"                                                    <span style=\"font-size: 10px;\" t-if=\"len(documents) == 1\"> Shared Document<br/>\n"
"                                            <span style=\"font-size: 20px; font-weight: bold;\" t-out=\"documents.name or ''\"/>\n"
"                                                    </span>\n"
"                                                    <span style=\"font-size: 10px;\" t-if=\"len(documents) &gt; 1\"> Shared\n"
"                                                        Documents<br/>\n"
"                                            <span style=\"font-size: 20px; font-weight: bold;\" t-out=\"', '.join(documents.filtered('name').mapped('name'))\"/>\n"
"                                                    </span>\n"
"                                                    <br/>\n"
"                                                </td>\n"
"                                                <td valign=\"middle\" align=\"right\" t-if=\"not user.company_id.uses_default_logo\">\n"
"                                                    <img t-attf-src=\"/logo.png?company={{ user.company_id.id }}\" style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" t-att-alt=\"user.company_id.name\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td colspan=\"2\" style=\"text-align:center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                                <!-- CONTENT -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                                    <div> Hello <t t-out=\"object.name\"/>, <br/><br/>\n"
"                                            <t t-if=\"len(documents) &lt;= 1\">\n"
"                                                            <t t-if=\"documents.type == 'folder'\" t-set=\"share_message\">shared the\n"
"                                                        following folder with you</t>\n"
"                                                            <t t-else=\"\" t-set=\"share_message\">shared\n"
"                                                        the following document with you</t>\n"
"                                                        </t>\n"
"                                            <t t-elif=\"len(documents) &gt; 1\">\n"
"                                                            <t t-set=\"document_types\" t-value=\"set(documents.mapped('type'))\"/>\n"
"                                                            <t t-if=\"document_types == {'folder'}\" t-set=\"share_message\">shared the\n"
"                                                        following folders with you</t>\n"
"                                                            <t t-elif=\"'folder' not in document_types\" t-set=\"share_message\">shared the\n"
"                                                        following documents with you</t>\n"
"                                                            <t t-else=\"\" t-set=\"share_message\">shared\n"
"                                                        the following documents/folders with you</t>\n"
"                                                        </t>\n"
"                                            <t t-out=\"user.name or ''\">OdooBot</t> (<t t-out=\"user.email or ''\">\n"
"                                                        odoobot@example.com</t>) <t t-out=\"share_message\"/>: <br/><br/>\n"
"                                            <center t-if=\"len(documents) &lt;= 1\">\n"
"                                                            <div t-if=\"len(documents) == 1\">\n"
"                                                                <b t-out=\"documents.name\"/>\n"
"                                                            </div>\n"
"                                                            <div t-if=\"ctx.get('message')\">\n"
"                                                                <i t-out=\"ctx['message']\"/>\n"
"                                                            </div>\n"
"                                                            <br/>\n"
"                                                            <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                                                                <a t-att-href=\"access_urls.get(documents)\" t-attf-style=\"background-color: {{user.company_id.email_secondary_color or '#875A7B'}}; padding: 20px 30px 20px 30px; text-decoration: none; color: {{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"                                                                    <b>Get your files</b>\n"
"                                                                </a>\n"
"                                                            </div>\n"
"                                                        </center>\n"
"                                            <t t-elif=\"len(documents) &gt; 1\">\n"
"                                                            <div t-if=\"ctx.get('message')\">\n"
"                                                                <i t-out=\"ctx['message']\"/>\n"
"                                                            </div>\n"
"                                                            <ul>\n"
"                                                                <li t-foreach=\"documents\" t-as=\"document\">\n"
"                                                                    <a t-att-href=\"access_urls.get(document)\" t-attf-style=\"color: {{user.company_id.email_secondary_color or '#875A7B'}}; font-size:13px;\">\n"
"                                                                        <b>Get <t t-out=\"document.name\"/></b>\n"
"                                                                    </a>\n"
"                                                                </li>\n"
"                                                            </ul>\n"
"                                                        </t>\n"
"\n"
"                                            <br/>\n"
"                                            <t t-if=\"user and user.signature\" data-o-mail-quote-container=\"1\">\n"
"                                                            <br/>\n"
"                                                            <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature\" data-o-mail-quote=\"1\"/></div>\n"
"                                                            <br data-o-mail-quote=\"1\"/>\n"
"                                                        </t>\n"
"                                                    </div>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"text-align:center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                                <!-- FOOTER -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\" align=\"left\">\n"
"                                                    <t t-out=\"user.company_id.name or ''\">\n"
"                                                        YourCompany</t>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\" align=\"left\" style=\"opacity: 0.7;\">\n"
"                                                    <t t-out=\"user.company_id.phone or ''\">+1\n"
"                                                        650-123-4567</t>\n"
"                                                    <t t-if=\"user.company_id.email\"> | <a t-attf-href=\"mailto:{{ user.company_id.email }}\" style=\"text-decoration:none; color: #454748;\" t-out=\"user.company_id.email\">\n"
"                                                        info@yourcompany.com</a>\n"
"                                                    </t>\n"
"                                                    <t t-if=\"user.company_id.website\"> | <a t-att-href=\"user.company_id.website\" style=\"text-decoration:none; color: #454748;\" t-out=\"user.company_id.website\">\n"
"                                                        http://www.example.com</a>\n"
"                                                    </t>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </tbody>\n"
"                        </table>\n"
"                    </td>\n"
"                </tr>\n"
"                <!-- POWERED BY -->\n"
"                <tr>\n"
"                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;\">\n"
"                            <tr>\n"
"                                <td style=\"text-align: center; font-size: 13px;\"> Powered by <a target=\"_blank\" href=\"https://www.odoo.com/app/documents\" t-attf-style=\"color: {{user.company_id.email_secondary_color or '#875A7B'}};\">Odoo\n"
"                                    Documents</a>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        "
msgstr ""

#. module: document
#: model:mail.template,body_html:document.mail_template_document_request
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\">\n"
"                <tr>\n"
"                    <td align=\"center\">\n"
"                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: white; color: #454748; border-collapse:separate;\">\n"
"                            <tbody>\n"
"                                <!-- HEADER -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\">\n"
"                                                    <span style=\"font-size: 10px;\"> Document\n"
"                                                        Request: <br/>\n"
"                                            <t t-if=\"object.name\">\n"
"                                                <span style=\"font-size: 20px; font-weight: bold;\" t-out=\"object.name or ''\">Inbox\n"
"                                                Financial</span>\n"
"                                                </t>\n"
"                                                </span>\n"
"                                                <br/>\n"
"                                                </td>\n"
"                                                <td valign=\"middle\" align=\"right\" t-if=\"not object.create_uid.company_id.uses_default_logo\">\n"
"                                                    <img t-attf-src=\"/logo.png?company={{ object.create_uid.company_id.id }}\" style=\"padding: 0px; margin: 0px; height: auto; width: 80px;\" t-att-alt=\"object.create_uid.company_id.name\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td colspan=\"2\" style=\"text-align:center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                                <!-- CONTENT -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                                    <div> Hello <t t-out=\"object.requestee_partner_id.name or ''\">\n"
"                                                        OdooBot</t>, <br/><br/>\n"
"                                            <t t-out=\"object.create_uid.name or ''\">\n"
"                                                OdooBot</t> (<t t-out=\"object.create_uid.email or ''\">\n"
"                                                odoobot@example.com</t>) asks you to provide\n"
"                                                the following document: <br/><br/>\n"
"                                            <center>\n"
"                                                <div>\n"
"                                                    <t t-if=\"object.name\">\n"
"                                                        <b t-out=\"object.name or ''\">Inbox\n"
"                                                Financial</b>\n"
"                                                    </t>\n"
"                                                    </div>\n"
"                                                    <div>\n"
"                                                        <t t-if=\"object.request_activity_id.note\">\n"
"                                                            <i t-out=\"object.request_activity_id.note or ''\">Example\n"
"                                                of a note.</i>\n"
"                                                    </t>\n"
"                                                    </div>\n"
"                                                    <br/>\n"
"                                                    <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                                                        <a t-att-href=\"object.access_url\" t-attf-style=\"background-color: {{user.company_id.email_secondary_color or '#875A7B'}}; padding: 20px 30px 20px 30px; text-decoration: none; color: {{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;\">\n"
"                                                Upload the requested document\n"
"                                                    </a>\n"
"                                                    </div>\n"
"                                                </center><br/>\n"
"                                                Please provide us with the missing document\n"
"                                                before <t t-out=\"object.request_activity_id.date_deadline\">\n"
"                                                2021-05-17</t>. <t t-if=\"user and user.signature\" data-o-mail-quote-container=\"1\">\n"
"                                                    <br/>\n"
"                                                    <div data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/><t t-out=\"user.signature or ''\" data-o-mail-quote=\"1\">Mitchell\n"
"                                                Admin</t></div>\n"
"                                                    <br data-o-mail-quote=\"1\"/>\n"
"                                                </t>\n"
"                                                </div>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"text-align:center;\">\n"
"                                                    <hr width=\"100%\" style=\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;\"/>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                    </td>\n"
"                                </tr>\n"
"                                <!-- FOOTER -->\n"
"                                <tr>\n"
"                                    <td align=\"center\" style=\"min-width: 590px;\">\n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;\">\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\" align=\"left\">\n"
"                                                    <t t-out=\"object.create_uid.company_id.name or ''\">\n"
"                                                        YourCompany</t>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td valign=\"middle\" align=\"left\" style=\"opacity: 0.7;\">\n"
