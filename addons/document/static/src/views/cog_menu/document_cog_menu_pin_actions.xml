<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="document.DocumentCogMenuPinAction">
        <Dropdown>
            <button class="o_cog_submenu_toggler opacity-trigger-hover">
                <i class="o_cog_menu_item_icon fa-solid fa-thumbtack me-1" aria-hidden="true"/>Actions on Select
            </button>
            <t t-set-slot="content">
                <span t-if="this.documentsState.isLoading" class="o-dropdown-item dropdown-item">
                    <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"/>
                </span>
                <DropdownItem t-else="" t-foreach="this.documentsState.actions" t-as="action" t-key="action.id"
                    closingMode="'none'"
                    class="{ 'selected': action.is_embedded }"
                    attrs="{ 'aria-checked': action.is_embedded ? 'true' : 'false' }"
                    role="'menuitemcheckbox'"
                    onSelected="() => this.onEnableAction(action.id)">
                    <t t-out="action.name"/>
                </DropdownItem>
                <div role="separator" class="dropdown-divider"/>
                <DropdownItem onSelected="() => this.documentService.goToServerActionsView()">
                    Add Custom Action
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
