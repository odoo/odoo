<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="document.DocumentsAction">
        <div t-if="this.props.targetRecords.length" class="btn-group mt-1 mt-sm-0 d-empty-none">
            <ActionMenus t-if="this.props.isPreview and this.state.actionMenuProps" t-props="this.state.actionMenuProps"/>
            <div t-if="!this.ui.isSmall and this.topbarActions.length" class="d-flex flex-row flex-wrap btn-group d-none d-md-inline">
                <t t-set="firstEmbeddedActions"
                   t-value="this.props.folderId === 'TRASH' ? this.topbarActions.slice(0, 1) : this.topbarActions.slice(0, this.ui.isSmall ? 0 : this.visibleTopbarActions)"/>
                <t t-set="lastEmbeddedActions"
                   t-value="this.props.folderId === 'TRASH' ? [] : this.topbarActions.slice(this.ui.isSmall ? 0 : this.visibleTopbarActions)"/>
                <button t-foreach="firstEmbeddedActions" t-as="action" t-key="action_index" class="btn btn-secondary"
                    t-on-click="() => action.callback()" t-out="action.description" />
                <div class="dropdown btn-group" t-if="lastEmbeddedActions?.length">
                    <Dropdown>
                        <button class="btn btn-secondary o_dropdown_title dropdown-toggle" type="button">
                            More
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem t-foreach="lastEmbeddedActions" t-as="action" t-key="action_index"
                                class="'btn btn-secondary mx-1'"
                                onSelected="() => action.callback()">
                                <t t-out="action.description"/>
                            </DropdownItem>
                        </t>
                    </Dropdown>
                </div>
            </div>
        </div>
    </t>
</templates>
