<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="document.DocumentsDetailsPanelMany2ManyTagsField" t-inherit="web.Many2ManyTagsField" t-inherit-mode="primary">
        <div t-if="this.showM2OSelectionField" position="after">
            <span
                t-elif="!this.tags.length"
                t-out="this.props.readonlyPlaceholder || this.props.placeholder"
                class="o_documents_details_panel_placeholder"
            />
        </div>
    </t>
</templates>
