<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="document.DocumentsListActionItem">
        <i
            t-if="this.isVisible"
            t-attf-class="#{this.icon} fa-fw me-2"
            t-att-title="this.description"
            t-on-click="this.onActionClicked"
        />
    </t>
</templates>
