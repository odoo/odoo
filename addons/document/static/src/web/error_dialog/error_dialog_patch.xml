<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.ErrorDialog" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='footer']//button" position="after">
            <button t-if="this.documentService.userIsInternal" class="btn btn-secondary ms-auto ms-md-2"
                t-on-click="this.shareTraceback" t-att-disabled="this.state.processed">
                Share
            </button>
            <div t-if="this.state.tracebackUrl"
                class="o_field_widget o_readonly_modifier o_field_CopyClipboardChar ms-0 ms-md-2 w-md-auto w-100">
                <div class="d-grid rounded-2 overflow-hidden">
                    <span t-out="this.state.tracebackUrl"/>
                    <CopyButton className="'o_btn_char_copy btn-sm'" content="this.state.tracebackUrl" icon="'fa-clipboard'"
                        successText.translate="The document URL has been copied to your clipboard."/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
