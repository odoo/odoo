<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="document.DocumentsViews.RightPanel">
        <div t-if="this.state.visible"
            class="o_document_chatter_container o-mail-ChatterContainer"
            t-att-class="{'mt-2': this.isMobile, 'h-100 o-aside': !this.isMobile, 'd-flex flex-column' : !this.panelDisabled}"
            t-ref="chatterContainer"
        >
            <t t-if="this.panelDisabled" t-call="document.DocumentsViews.ChatterOverlay"/>
            <DocumentsDetailsPanel t-if="!this.panelDisabled" record="this.state.previewedDocument?.record || this.state.focusedRecord" nbViewItems="this.props.nbViewItems" />
            <Chatter t-if="this.state.focusedRecord?.data and this.documentService.userIsInternal"
                threadId="typeof this.state.focusedRecord.data.id === 'number' and this.state.focusedRecord.data.id"
                threadModel="'document.document'"
                isChatterAside="!this.isMobile"/>
        </div>
    </t>
</templates>
