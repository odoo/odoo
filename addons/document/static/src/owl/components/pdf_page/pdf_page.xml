<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="document.component.PdfPage">
        <div t-att-data-id="this.props.pageId"
            t-att-class="{ 'o_pdf_page_focused': this.props.isFocused, 'o_pdf_thumbnail_dragover': this.state.isHover,
                           'o_pdf_page_selected': this.props.isSelected, 'o_pdf_page_preview': this.props.isPreview,
                           'o_pdf_page': !this.props.isPreview }"
        >
            <div t-if="!this.props.isPreview" class="o_documents_pdf_button_wrapper">
                <i class="o_documents_pdf_page_selector fa"
                    t-att-class="{'fa-check-circle': this.props.isSelected, 'fa-circle-thin': !this.props.isSelected }"
                    aria-label="select" title="select" t-on-click.stop="this.onClickSelect"/>
            </div>
            <div class="o_documents_pdf_canvas_wrapper"
                draggable="true"
                t-on-dragstart.stop="this.onDragStart"
                t-on-drop="this.onDrop"
                t-on-dragover.stop="this.onDragOver"
                t-on-dragenter.stop="this.onDragEnter"
                t-on-dragleave.stop="this.onDragLeave"
                t-on-click.stop="this.onClickWrapper"
                t-ref="canvasWrapper"
            >
                <div t-if="!this.props.isPreview" class="o_bottom_selection" t-on-click.stop="this.onClickSelect"/>
            </div>
            <div class="o_documents_pdf_selected_overlay position-absolute start-0 bottom-0 w-100 h-100 pe-none"/>
        </div>
    </t>
</templates>
