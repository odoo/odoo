<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail_speech.VoiceTranscript">
        <div class="o-mail-VoiceTranscript small">
            <t t-if="this.props.attachment.transcript_text">
                <div class="o-mail-VoiceTranscript-text text-muted fst-italic"
                     t-out="this.props.attachment.transcript_text" />
            </t>
            <t t-elif="this.props.attachment.can_transcribe">
                <button class="btn btn-link btn-sm p-0 text-muted"
                        type="button"
                        t-att-disabled="this.isPending"
                        t-on-click="this.onClickTranscribe">
                    <i class="fa fa-file-text-o me-1" />
                    <t t-out="this.label" />
                </button>
            </t>
        </div>
    </t>

</templates>
