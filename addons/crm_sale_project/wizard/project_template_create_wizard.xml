<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="crm_project_view_form_simplified_template_billable" model="ir.ui.view">
        <field name="name">crm.project.create.wizard.form.billable</field>
        <field name="model">project.template.create.wizard</field>
        <field name="inherit_id" ref="crm_project.crm_project_view_form_simplified_template"/>
        <field name="arch" type="xml">
            <!-- `sale_project` contributes its own customer field to the parent view;
                 the wizard already asks for it through the 'Project Customer' choice. -->
            <xpath expr="//field[@name='partner_id'][not(parent::div[@name='crm_lead_customer'])]" position="replace"/>
            <xpath expr="//field[@name='template_id']" position="attributes">
                <attribute name="domain">[
                    ('is_template', '=', True), ('allow_billable', '=', True),
                    '|', ('company_id', '=?', context.get('lead_company_id')), ('company_id', '=', False)]
                </attribute>
                <attribute name="context">{'default_is_template': True, 'default_allow_billable': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
