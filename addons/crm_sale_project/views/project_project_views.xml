<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_edit_project_inherit_form_crm_project" model="ir.ui.view">
        <field name="name">project.project.view.inherit.crm.project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="sale_project.view_edit_project_inherit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_customer_preview']" position="after">
                <button name="action_view_lead" icon="star" icon_class="oi-filled" type="object" class="oe_stat_button"
                    invisible="not lead_id or not allow_billable" groups="sales_team.group_sale_salesman_all_leads">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Opportunity</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="project_embedded_action_opportunity" model="ir.embedded.actions">
        <field name="parent_res_model">project.project</field>
        <field name="sequence">115</field>
        <field name="name">Opportunity</field>
        <field name="groups_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="parent_action_id" ref="project.act_project_project_2_project_task_all"/>
        <field name="python_method">action_view_lead</field>
        <field name="domain">[('lead_id', '!=', False), ('allow_billable', '=', True)]</field>
    </record>

    <record id="project_embedded_action_opportunity_dashboard" model="ir.embedded.actions">
        <field name="parent_res_model">project.project</field>
        <field name="sequence">115</field>
        <field name="name">Opportunity</field>
        <field name="groups_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        <field name="parent_action_id" ref="project.project_update_all_action"/>
        <field name="python_method">action_view_lead</field>
        <field name="domain">[('lead_id', '!=', False), ('allow_billable', '=', True)]</field>
    </record>

</odoo>
