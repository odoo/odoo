<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_stock_fleet" model="ir.ui.view">
        <field name="name">product.template.form.stock.fleet</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="fleet.product_template_form_view_fleet" />
        <field name="arch" type="xml">
            <group name="vehicle_body" position="inside">
                <label for="weight_capacity" />
                <div class="o_row">
                    <field name="weight_capacity" class="oe_inline" />
                    <field name="weight_capacity_uom_name" class="oe_inline" />
                </div>
                <label for="volume_capacity" />
                <div class="o_row">
                    <field name="volume_capacity" class="oe_inline" />
                    <field name="volume_capacity_uom_name" class="oe_inline" />
                </div>
            </group>
        </field>
    </record>

</odoo>
