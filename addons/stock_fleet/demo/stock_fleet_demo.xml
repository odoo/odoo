<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="vehicle_tag_transport" model="fleet.vehicle.tag">
        <field name="name">Transport</field>
        <field name="color" eval="5" />
    </record>

    <record id="model_volvo_fm" model="product.product">
        <field name="name">FM</field>
        <field name="type">consu</field>
        <field name="sale_ok" eval="False" />
        <field name="asset_kind_id" ref="resource_asset.kind_vehicle" />
        <field name="manufacturer_id" ref="fleet.brand_volvo" />
        <field name="doors">2</field>
        <field name="fuel_type">diesel</field>
        <field name="vehicle_model_year">2020</field>
        <field name="weight_capacity">44000</field>
        <field name="volume_capacity">32</field>
    </record>

    <record id="model_ford_transit" model="product.product">
        <field name="name">Transit</field>
        <field name="type">consu</field>
        <field name="sale_ok" eval="False" />
        <field name="asset_kind_id" ref="resource_asset.kind_vehicle" />
        <field name="manufacturer_id" ref="fleet.brand_ford" />
        <field name="weight_capacity">7000</field>
        <field name="volume_capacity">15</field>
    </record>

    <record id="operator_resource_admin" model="resource.resource">
        <field name="partner_id" ref="base.partner_admin" />
        <field name="resource_type">user</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="vehicle_truck_volvo" model="resource.asset.vehicle">
        <field name="name">Volvo FM ODO-1347</field>
        <field name="kind_id" ref="resource_asset.kind_vehicle" />
        <field name="product_id" ref="model_volvo_fm" />
        <field name="license_plate">ODO-1347</field>
        <field name="vin_sn">1V6AD0ERXBC414305</field>
        <field name="state">in_service</field>
        <field
            name="date_acquisition"
            eval="(DateTime.now() - timedelta(days=336)).strftime('%Y-%m-%d')" />
        <field name="operator_id" ref="operator_resource_admin" />
        <field name="odometer">18000</field>
        <field name="manager_id" ref="operator_resource_admin" />
        <field name="tag_ids" eval="[Command.set([ref('vehicle_tag_transport')])]" />
    </record>

</odoo>
