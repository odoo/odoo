<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_form_inherit_pt" model="ir.ui.view">
            <field name="name">sale.order.inherit.pt</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Future Date Warning -->
                <xpath expr="//div[hasclass('alert')]" position="after">
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not l10n_pt_show_future_date_warning">
                        Setting the order date in the future will prevent new documents with an order date before
                        <field name="date_order" readonly="1"/> from being posted.
                    </div>
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not l10n_pt_at_series_missing_at_code">
                        The AT Series <field name="l10n_pt_at_series_id" readonly="1"/> is missing its validation code.
                        Register it with the Autoridade Tributária before sending or printing.
                    </div>
                </xpath>
                <!-- A quotation confirmed into a sales order stays a quotation: say it is ordered -->
                <xpath expr="//div[@name='button_box']" position="before">
                    <field name="l10n_pt_ordered" invisible="1"/>
                    <widget name="web_ribbon" title="Ordered" bg_color="text-bg-success" invisible="not l10n_pt_ordered"/>
                </xpath>
                <!-- Smart Buttons -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button"
                            name="action_view_sale_orders"
                            type="object"
                            icon="fa-pencil-square-o"
                            invisible="not sales_order_ids or state == 'sale' or country_code != 'PT'">
                        <field string="Sale Orders" name="sales_order_count" widget="statinfo"/>
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_origin_quotation"
                            type="object"
                            icon="fa-pencil-square-o"
                            string="Quotation"
                            invisible="not quotation_id or state not in ('sale', 'cancel') or country_code != 'PT'"/>
                </xpath>
                <!-- Buttons -->
                <xpath expr="//button[@id='action_confirm']" position="replace">
                    <button name="action_l10n_pt_confirm" type="object" class="btn-primary" string="Confirm"
                            data-hotkey="q" context="{'validate_analytic': True}" invisible="state != 'sent' or l10n_pt_ordered"/>
                </xpath>
                <xpath expr="//button[@name='action_confirm'][@invisible=&quot;state != &apos;draft&apos;&quot;]" position="replace">
                    <button name="action_l10n_pt_confirm" type="object" string="Confirm" data-hotkey="q"
                            context="{'validate_analytic': True}" invisible="state != 'draft' or l10n_pt_ordered"/>
                </xpath>
                <xpath expr="//button[@name='action_unlock']" position="attributes">
                    <attribute name="invisible">country_code == 'PT'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state not in ['draft', 'sent', 'sale'] or not id or (locked and country_code != 'PT')</attribute>
                </xpath>
                <xpath expr="//button[@name='action_draft']" position="attributes">
                    <attribute name="invisible">state != 'cancel' or country_code == 'PT'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_open_discount_wizard']" position="attributes">
                    <attribute name="invisible">country_code == 'PT'</attribute>
                </xpath>
                <!-- The series decides the number; the number is the document's PT identity once issued.
                     Required here, so a missing series is created from its own dropdown before
                     saving. No quick create: a series also needs a prefix. -->
                <xpath expr="//group[@name='partner_details']" position="inside">
                    <field name="l10n_pt_at_series_id"
                           invisible="country_code != 'PT'"
                           readonly="l10n_pt_document_number"
                           required="country_code == 'PT' and state in ('draft', 'sent')"
                           context="{'l10n_pt_series_document_types': [l10n_pt_document_type], 'default_company_id': company_id}"
                           options="{'no_quick_create': True}"/>
                    <field name="l10n_pt_document_number"
                           invisible="country_code != 'PT' or not l10n_pt_document_number"/>
                </xpath>
                <xpath expr="//field[@name='date_order']" position="attributes">
                    <attribute name="readonly">locked</attribute>
                </xpath>
                <xpath expr="//group[@name='order_details']" position="inside">
                    <field name="l10n_pt_global_discount"
                           invisible="country_code != 'PT'"
                           readonly="l10n_pt_inalterable_hash"/>
                </xpath>
                <!-- Add line discount in sale order line -->
                <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                    <attribute name="column_invisible">parent.country_code == 'PT'</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='tax_ids']" position="after">
                    <field name="l10n_pt_line_discount" string="Disc.%" optional="hide" column_invisible="parent.country_code != 'PT'"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//form//field[@name='discount']" position="attributes">
                    <attribute name="invisible">parent.country_code == 'PT'</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//form//field[@name='tax_ids']" position="after">
                    <field name="l10n_pt_line_discount" string="Disc.%" invisible="parent.country_code != 'PT'"/>
                </xpath>
                <!-- What issuing records, in the same tab and order on every PT document -->
                <xpath expr="//page[@name='other_information']" position="after">
                    <page name="l10n_pt_info" string="Portugal" invisible="country_code != 'PT'">
                        <group name="l10n_pt_info_group">
                            <group string="Document" name="l10n_pt_document_group">
                                <field name="l10n_pt_document_type"/>
                                <field name="l10n_pt_document_number"/>
                                <field name="l10n_pt_at_series_id" readonly="1"/>
                                <field name="l10n_pt_atcud"/>
                            </group>
                            <group string="Issue" name="l10n_pt_issue_group" invisible="not l10n_pt_document_number">
                                <field name="l10n_pt_issued_on"/>
                                <field name="l10n_pt_issue_user_id" widget="many2one_avatar_user"/>
                            </group>
                            <group string="Cancellation" name="l10n_pt_cancel_group" invisible="state != 'cancel'">
                                <field name="l10n_pt_cancel_date"/>
                                <field name="l10n_pt_cancel_user_id" widget="many2one_avatar_user"/>
                                <field name="l10n_pt_cancel_reason"
                                       required="state == 'cancel' and l10n_pt_document_number"/>
                            </group>
                            <group string="Signature" name="l10n_pt_signature_group" groups="base.group_no_one" invisible="not l10n_pt_inalterable_hash">
                                <field name="l10n_pt_inalterable_hash"/>
                                <field name="l10n_pt_hashed_on"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="attributes">
                    <attribute name="readonly">locked</attribute>
                </xpath>
            </field>
        </record>

        <record id="sale_order_tree_inherit_pt" model="ir.ui.view">
            <field name="name">sale.order.list.inherit.pt</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                   <field name="l10n_pt_document_number" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_quotation_tree_inherit_pt" model="ir.ui.view">
            <field name="name">sale.order.list.quotation.inherit.pt</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <!-- Quotations confirmed into a sales order are done with -->
                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-muted">state == 'cancel' or l10n_pt_ordered</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="l10n_pt_ordered" column_invisible="True"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_view_search_inherit_quotation_pt" model="ir.ui.view">
            <field name="name">sale.order.search.inherit.quotation.pt</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
                <filter name="sales" position="after">
                    <filter string="Not Ordered" name="l10n_pt_not_ordered" domain="[('l10n_pt_ordered', '=', False), ('state', 'in', ('draft', 'sent'))]"/>
                </filter>
            </field>
        </record>

        <record id="action_l10n_pt_sale_report_hash_integrity" model="ir.actions.report">
            <field name="name">Portuguese sale hash integrity result PDF</field>
            <field name="model">res.company</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_pt_sale.report_hash_integrity</field>
            <field name="report_file">l10n_pt_sale.report_hash_integrity</field>
        </record>

        <record model="ir.actions.server" id="action_l10n_pt_sale_check_hash_integrity">
            <field name="name">Portuguese Sale Inalterability Check</field>
            <field name="model_id" ref="l10n_pt_sale.model_res_company"/>
            <field name="state">code</field>
            <field name="code">
                action = env.company._l10n_pt_sale_action_check_hash_integrity()
            </field>
        </record>
    </data>
</odoo>
