#. module: hr_holidays
#: model:mail.template,body_html:hr_holidays.new_timeoff_request_template
msgid ""
"<div>\n"
"                    Dear <b><t t-out=\"object.env.context.get('manager')\"/"
"></b>,\n"
"                    <br/><br/>\n"
"                    <p>I'm requesting a Time Off. I would appreciate if you "
"could approve it whenever possible!</p>\n"
"                    <ul>\n"
"                        <li>Time Type: <t t-"
"out=\"object.work_entry_type_id.name\"/></li>\n"
"                        <li><t t-out=\"object.request_date_from\"/> → <t t-"
"out=\"object.request_date_to\"/> (<t t-out=\"object.duration_display\"/>)</"
"li>\n"
"                        <li t-if=\"object.name\">Reason: <t t-"
"out=\"object.name\"/></li>\n"
"                    </ul>\n"
"                </div>\n"
"            "
msgstr ""

#. module: hr_holidays
#: model:mail.template,body_html:hr_holidays.mail_template_allocation_confirmed
msgid ""
"<div>\n"
"                    Dear <t t-out=\"object.employee_id.name or 'Employee'\"/"
">,<br/><br/>\n"
"                    Your time off allocation has been confirmed.<br/><br/>\n"
"                    Details:<br/>\n"
"                    <ul>\n"
"                        <li>Time Type: <t t-"
"out=\"object.work_entry_type_id.name or ''\"/></li>\n"
"                        <li>Allocation: <t t-out=\"object.duration_display "
"or ''\"/></li>\n"
"                        <li>Valid From: <t t-out=\"object.date_from or ''\"/"
"> <t t-if=\"not object.date_to\">(No Expiry)</t><t t-else=\"\"> to <t t-"
"out=\"object.date_to or ''\"/></t></li>\n"
"                        <li t-if=\"object.accrual_plan_id\">Accrual Plan: <t "
"t-out=\"object.accrual_plan_id.name or ''\"/></li>\n"
"                    </ul>\n"
"                    <br/>\n"
"                    For any questions, contact HR Responsible.<br/><br/>\n"
"                    Regards,<br/>\n"
"                    <t t-out=\"object.env.user.name or ''\"/>\n"
"                </div>\n"
"            "
msgstr ""

