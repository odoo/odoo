#. module: hr_holidays
#: model:ir.model.fields,help:hr_holidays.field_hr_work_entry_type__country_code
msgid ""
"The ISO country code in two chars. \n"
"You can use this field for quick search."
msgstr ""
"ລະຫັດປະເທດ ISO ເປັນຕົວອັກສອນສອງຕົວ. \n"
"ທ່ານສາມາດໃຊ້ຊ່ອງນີ້ສຳລັບການຄົ້ນຫາແບບວ່ອງໄວ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid "The Start Date of the Validity Period must be anterior to the End Date."
msgstr "ວັນທີເລີ່ມຕົ້ນຂອງໄລຍະເວລາການນຳໃຊ້ຕ້ອງມາກ່ອນວັນທີສິ້ນສຸດ."

#. module: hr_holidays
#: model:ir.model.fields,help:hr_holidays.field_hr_leave_accrual_level__start_count
msgid ""
"The accrual starts after a defined period from the allocation start date. "
"This field defines the number of days, months or years after which accrual "
"is used."
msgstr ""
"ການສະສົມຈະເລີ່ມຕົ້ນຫຼັງຈາກໄລຍະເວລາທີ່ກຳນົດໄວ້ນັບຈາກວັນທີເລີ່ມຕົ້ນການຈັດສັນ. ຊ່ອງນີ້ກຳນົດຈຳນວນມື້, ເດືອນ "
"ຫຼື ປີ ທີ່ຫຼັງຈາກນັ້ນຈະເລີ່ມມີການສະສົມ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_work_entry_type.py:0
msgid ""
"The allocation requirement of a time type cannot be changed once leaves of "
"that type have been taken. You should create a new time type instead."
msgstr ""
"ເງື່ອນໄຂການຈັດສັນຂອງປະເພດເວລາບໍ່ສາມາດປ່ຽນແປງໄດ້ເມື່ອມີການລາພັກປະເພດນັ້ນໄປແລ້ວ. ທ່ານຄວນສ້າງປະເພ"
"ດເວລາໃໝ່ແທນ."

#. module: hr_holidays
#: model:ir.model.fields,help:hr_holidays.field_hr_leave__color
#: model:ir.model.fields,help:hr_holidays.field_hr_leave_employee_report__color
#: model:ir.model.fields,help:hr_holidays.field_hr_work_entry_type__color
msgid ""
"The color selected here will be used in every screen with the time type."
msgstr "ສີທີ່ເລືອກຢູ່ນີ້ຈະຖືກນຳໃຊ້ໃນທຸກໜ້າຈໍທີ່ມີປະເພດເວລານີ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/res_company.py:0
msgid ""
"The company country cannot be changed while time off leaves or allocations "
"with the country exist."
msgstr ""
"ປະເທດຂອງບໍລິສັດບໍ່ສາມາດປ່ຽນແປງໄດ້ ໃນຂະນະທີ່ຍັງມີການລາພັກ ຫຼື ການຈັດສັນທີ່ກ່ຽວຂ້ອງກັບປະເທດນັ້ນຢູ່."

#. module: hr_holidays
#: model_terms:ir.ui.view,arch_db:hr_holidays.hr_accrual_level_view_form
msgid "The days carried over will be effective for"
msgstr "ມື້ທີ່ຍົກຍອດໄປຈະມີຜົນນຳໃຊ້ເປັນເວລາ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_employee_departure.py:0
msgid "The employee will leave the company on %(departure_date)s."
msgstr "ພະນັກງານຈະລາອອກຈາກບໍລິສັດໃນວັນທີ %(departure_date)s."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_accrual_plan_level.py:0
msgid "The first day must be lower than the second day."
msgstr "ມື້ທຳອິດຕ້ອງມາກ່ອນມື້ທີສອງ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"The following employees are not supposed to work during that period:\n"
" %s"
msgstr ""
"ພະນັກງານຕໍ່ໄປນີ້ບໍ່ໄດ້ກຳນົດໃຫ້ເຮັດວຽກໃນໄລຍະເວລານັ້ນ:\n"
" %s"

#. module: hr_holidays
#. odoo-javascript
#: code:addons/hr_holidays/static/src/dashboard/time_off_card.xml:0
msgid ""
"The leaves planned in the future are exceeding the maximum value of the "
"allocation.\n"
"                It will not be possible to take all of them."
msgstr ""
"ການລາພັກທີ່ວາງແຜນໄວ້ໃນອະນາຄົດເກີນມູນຄ່າສູງສຸດຂອງການຈັດສັນ.\n"
"                ຈະບໍ່ສາມາດລາພັກທັງໝົດນັ້ນໄດ້."

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_work_entry_type_check_negative
msgid ""
"The maximum excess amount should be greater than 0. If you want to set 0, "
"disable the negative cap instead."
msgstr ""
"ຈຳນວນເກີນສູງສຸດຄວນຫຼາຍກວ່າ 0. ຖ້າທ່ານຕ້ອງການຕັ້ງເປັນ 0, ໃຫ້ປິດການຈຳກັດຄ່າລົບແທນ."

#. module: hr_holidays
#: model_terms:ir.ui.view,arch_db:hr_holidays.hr_accrual_level_view_form
msgid "The plan will be on hold if the balance reach"
msgstr "ແຜນການຈະຖືກພັກໄວ້ຊົ່ວຄາວ ຖ້າຍອດເຫຼືອຮອດ"

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_date_check3
msgid "The request start date must be before or equal to the request end date."
msgstr "ວັນທີເລີ່ມຕົ້ນການຮ້ອງຂໍຕ້ອງມາກ່ອນ ຫຼື ເທົ່າກັບວັນທີສິ້ນສຸດການຮ້ອງຂໍ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid ""
"The selected accrual plan has no time type set. Please set a time type on "
"the accrual plan."
msgstr ""
"ແຜນການສະສົມທີ່ເລືອກຍັງບໍ່ມີການກຳນົດປະເພດເວລາ. ກະລຸນາກຳນົດປະເພດເວລາໃນແຜນການສະສົມ."

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_mandatory_day_date_from_after_day_to
msgid "The start date must be anterior than the end date."
msgstr "ວັນທີເລີ່ມຕົ້ນຕ້ອງມາກ່ອນວັນທີສິ້ນສຸດ."

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_date_check2
msgid "The start date must be before or equal to the end date."
msgstr "ວັນທີເລີ່ມຕົ້ນຕ້ອງມາກ່ອນ ຫຼື ເທົ່າກັບວັນທີສິ້ນສຸດ."

#. module: hr_holidays
#: model:ir.model.fields,help:hr_holidays.field_hr_leave_allocation__state
msgid ""
"The status is 'To Approve', when an allocation request is created.\n"
"The status is 'Refused', when an allocation request is refused by manager.\n"
"The status is 'Approved', when an allocation request is approved by manager."
msgstr ""
"ສະຖານະຈະເປັນ 'ລໍຖ້າອະນຸມັດ', ເມື່ອຄຳຮ້ອງຂໍການຈັດສັນຖືກສ້າງຂຶ້ນ.\n"
"ສະຖານະຈະເປັນ 'ຖືກປະຕິເສດ', ເມື່ອຄຳຮ້ອງຂໍການຈັດສັນຖືກປະຕິເສດໂດຍຜູ້ຈັດການ.\n"
"ສະຖານະຈະເປັນ 'ອະນຸມັດແລ້ວ', ເມື່ອຄຳຮ້ອງຂໍການຈັດສັນໄດ້ຮັບການອະນຸມັດໂດຍຜູ້ຈັດການ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "The time off has been automatically approved"
msgstr "ການລາພັກໄດ້ຮັບການອະນຸມັດໂດຍອັດຕະໂນມັດແລ້ວ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "The time off is outside the working schedule of the employee"
msgstr "ເວລາລາພັກຢູ່ນອກຕາຕະລາງການເຮັດວຽກຂອງພະນັກງານ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"The time off request has been cancelled for the following reason:%(reason)s"
msgstr "ຄຳຮ້ອງຂໍລາພັກໄດ້ຖືກຍົກເລີກຍ້ອນເຫດຜົນດັ່ງຕໍ່ໄປນີ້: %(reason)s"

#. module: hr_holidays
#: model_terms:ir.ui.view,arch_db:hr_holidays.hr_time_rule_view_form_inherit_hr_holidays
msgid ""
"The time off type created for the deficit. Must not require allocation. The "
"output unit may be finer than the condition unit (e.g. hour output on a day "
"leave trims the source to sub-day)."
msgstr ""
"ປະເພດການລາພັກທີ່ສ້າງຂຶ້ນສຳລັບສ່ວນທີ່ຂາດ. ຕ້ອງບໍ່ຮຽກຮ້ອງໃຫ້ມີການຈັດສັນ. ຫົວໜ່ວຍຂາອອກອາດຈະລະອຽດກວ່າຫົ"
"ວໜ່ວຍເງື່ອນໄຂ (ຕົວຢ່າງ: ການອອກເປັນຊົ່ວໂມງໃນການລາແບບວັນຈະຕັດຕົ້ນທາງໃຫ້ຍ່ອຍກວ່າມື້)."

#. module: hr_holidays
#: model_terms:ir.ui.view,arch_db:hr_holidays.hr_time_rule_view_form_inherit_hr_holidays
msgid ""
"The time off type created for the excess. Must not require allocation. The "
"output unit may be finer than the condition unit (e.g. hour output on a day "
"leave trims the source to sub-day)."
msgstr ""
"ປະເພດການລາພັກທີ່ສ້າງຂຶ້ນສຳລັບສ່ວນເກີນ. ຕ້ອງບໍ່ຮຽກຮ້ອງໃຫ້ມີການຈັດສັນ. ຫົວໜ່ວຍຂາອອກອາດຈະລະອຽດກວ່າຫົວ"
"ໜ່ວຍເງື່ອນໄຂ (ຕົວຢ່າງ: ການອອກເປັນຊົ່ວໂມງໃນການລາແບບວັນຈະຕັດຕົ້ນທາງໃຫ້ຍ່ອຍກວ່າມື້)."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid ""
"The total negative allocation within this validity period cannot exceed %"
"(max)s %(unit)s."
msgstr ""
"ການຈັດສັນຄ່າລົບທັງໝົດພາຍໃນໄລຍະເວລານຳໃຊ້ນີ້ ບໍ່ສາມາດເກີນ %(max)s %(unit)s."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"There is no employee set on the time off. Please make sure you're logged in "
"the correct company."
msgstr ""
"ບໍ່ມີການກຳນົດພະນັກງານໃນການລາພັກ. ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບໃນບໍລິສັດທີ່ຖືກຕ້ອງ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"There is no valid allocation to cover this request for the following "
"employees: %s"
msgstr "ບໍ່ມີການຈັດສັນທີ່ຖືກຕ້ອງເພື່ອຮອງຮັບຄຳຮ້ອງຂໍນີ້ສຳລັບພະນັກງານຕໍ່ໄປນີ້: %s"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/wizard/load_public_holiday_wizard.py:0
msgid "These companies do not have a country set: %(companies)s."
msgstr "ບໍລິສັດເຫຼົ່ານີ້ບໍ່ໄດ້ກຳນົດປະເທດ: %(companies)s."

#. module: hr_holidays
#: model_terms:ir.ui.view,arch_db:hr_holidays.hr_accrual_plan_view_form
msgid "They should be carried over."
msgstr "ພວກມັນຄວນຖືກຍົກຍອດໄປ."

#. module: hr_holidays
#: model_terms:ir.ui.view,arch_db:hr_holidays.hr_accrual_plan_view_form
