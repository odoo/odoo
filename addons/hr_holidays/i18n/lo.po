#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid "You can't do the same action twice."
msgstr "ທ່ານບໍ່ສາມາດດຳເນີນການອັນເກົ່າຊ້ຳສອງເທື່ອໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "You can't refuse a leave with validation by Time Off Officer."
msgstr "ທ່ານບໍ່ສາມາດປະຕິເສດການລາພັກທີ່ກຳນົດໃຫ້ຢັ້ງຢືນໂດຍເຈົ້າໜ້າທີ່ການລາພັກໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid "You can't refuse an allocation with validation by Time Off Officer."
msgstr ""
"ທ່ານບໍ່ສາມາດປະຕິເສດການຈັດສັນທີ່ກຳນົດໃຫ້ຢັ້ງຢືນໂດຍເຈົ້າໜ້າທີ່ການລາພັກໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "You can't reset a leave. Cancel/delete this one and create an other"
msgstr "ທ່ານບໍ່ສາມາດຕັ້ງຄ່າການລາພັກໃໝ່ໄດ້. ໃຫ້ຍົກເລີກ/ລຶບລາຍການນີ້ ແລ້ວສ້າງໃໝ່"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid ""
"You can't reset an allocation. Cancel/delete this one and create an other"
msgstr "ທ່ານບໍ່ສາມາດຕັ້ງຄ່າການຈັດສັນໃໝ່ໄດ້. ໃຫ້ຍົກເລີກ/ລຶບລາຍການນີ້ ແລ້ວສ້າງໃໝ່"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "You can't validate this leave."
msgstr "ທ່ານບໍ່ສາມາດຢັ້ງຢືນການລາພັກນີ້ໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_work_entry_type.py:0
msgid "You cannot allow requests on top of leaves of type 'Absence'."
msgstr "ທ່ານບໍ່ສາມາດອະນຸຍາດໃຫ້ຮ້ອງຂໍທັບຊ້ອນເທິງການລາປະເພດ 'ຂາດວຽກ' ໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "You cannot approve this leave."
msgstr "ທ່ານບໍ່ສາມາດອະນຸມັດການລາພັກນີ້ໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"You cannot create a time off request for an employee of type company "
"executive."
msgstr "ທ່ານບໍ່ສາມາດສ້າງຄຳຮ້ອງຂໍລາພັກໃຫ້ແກ່ພະນັກງານປະເພດຜູ້ບໍລິຫານບໍລິສັດໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid ""
"You cannot delete an allocation request which has some validated leaves."
msgstr "ທ່ານບໍ່ສາມາດລຶບຄຳຮ້ອງຂໍການຈັດສັນທີ່ມີການລາພັກທີ່ຢັ້ງຢືນແລ້ວ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid "You cannot delete an allocation request which is in %s state."
msgstr "ທ່ານບໍ່ສາມາດລຶບຄຳຮ້ອງຂໍການຈັດສັນທີ່ຢູ່ໃນສະຖານະ %s."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"You cannot encode more absence hours than allowed for this period.\n"
"Expected attendance: %(attendance)g hours.\n"
"Maximum allowed absence: %(max_absence)g hours.\n"
"Requested absence: %(requested)g hours."
msgstr ""
"ທ່ານບໍ່ສາມາດປ້ອນຊົ່ວໂມງຂາດວຽກຫຼາຍກວ່າທີ່ອະນຸຍາດສຳລັບໄລຍະເວລານີ້.\n"
"ເວລາເຮັດວຽກທີ່ຄາດຫວັງ: %(attendance)g ຊົ່ວໂມງ.\n"
"ການຂາດວຽກທີ່ອະນຸຍາດສູງສຸດ: %(max_absence)g ຊົ່ວໂມງ.\n"
"ການຂາດວຽກທີ່ຮ້ອງຂໍ: %(requested)g ຊົ່ວໂມງ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"You cannot first approve a time off for %s, because you are not his time off "
"manager"
msgstr ""
"ທ່ານບໍ່ສາມາດອະນຸມັດຂັ້ນທຳອິດສຳລັບການລາພັກຂອງ %s ໄດ້, ເນື່ອງຈາກທ່ານບໍ່ແມ່ນຜູ້ຈັດການການລາພັກຂອງລາວ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_accrual_plan_level.py:0
msgid "You cannot have a balance cap on accrued time set to 0."
msgstr "ທ່ານບໍ່ສາມາດກຳນົດຂີດຈຳກັດຍອດເຫຼືອເວລາສະສົມເປັນ 0 ໄດ້."

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_accrual_level_valid_yearly_cap_value
msgid ""
"You cannot have a cap on yearly accrued time without setting a maximum "
"amount."
msgstr "ທ່ານບໍ່ສາມາດກຳນົດຂີດຈຳກັດເວລາສະສົມລາຍປີໄດ້ ໂດຍບໍ່ໄດ້ກຳນົດຈຳນວນສູງສຸດ."

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_accrual_level_valid_max_carriedover_duration_value
msgid "You cannot have a maximum quantity to carryover set to 0."
msgstr "ທ່ານບໍ່ສາມາດກຳນົດຈຳນວນສູງສຸດທີ່ຈະຍົກຍອດໄປເປັນ 0 ໄດ້."

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_accrual_level_valid_accrual_validity_value
msgid "You cannot have an accrual validity time set to 0."
msgstr "ທ່ານບໍ່ສາມາດກຳນົດໄລຍະເວລານຳໃຊ້ການສະສົມເປັນ 0 ໄດ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_work_entry_type.py:0
msgid ""
"You cannot modify the 'Duration Count' setting because one or more leaves "
"have already been taken for this time off type. Changing it now would affect "
"existing employee balances."
msgstr ""
"ທ່ານບໍ່ສາມາດແກ້ໄຂການຕັ້ງຄ່າ 'ການນັບໄລຍະເວລາ' ໄດ້ ເນື່ອງຈາກມີການນຳໃຊ້ການລາພັກປະເພດນີ້ໄປແລ້ວ. ກາ"
"ນປ່ຽນແປງຕອນນີ້ຈະສົ່ງຜົນກະທົບຕໍ່ຍອດເຫຼືອທີ່ມີຢູ່ຂອງພະນັກງານ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_work_entry_type.py:0
msgid ""
"You cannot modify the 'Public Holiday Included' setting since one or more "
"leaves for that time type are overlapping with public holidays, meaning that "
"the balance of those employees would be affected by this change."
msgstr ""
"ທ່ານບໍ່ສາມາດແກ້ໄຂການຕັ້ງຄ່າ 'ນັບລວມວັນພັກລັດຖະການ' ໄດ້ ເນື່ອງຈາກມີການລາພັກສຳລັບປະເພດເວລານັ້ນທັບຊ້ອ"
"ນກັບວັນພັກລັດຖະການ, ຊຶ່ງໝາຍຄວາມວ່າຍອດເຫຼືອຂອງພະນັກງານເຫຼົ່ານັ້ນຈະໄດ້ຮັບຜົນກະທົບຈາກການປ່ຽນແປງນີ້."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave_allocation.py:0
msgid ""
"You cannot reduce the duration below the duration of leaves already taken by "
"the employee."
msgstr ""
"ທ່ານບໍ່ສາມາດຫຼຸດໄລຍະເວລາລົງໃຫ້ຕ່ຳກວ່າໄລຍະເວລາລາພັກທີ່ພະນັກງານໄດ້ໃຊ້ໄປແລ້ວ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"You do not have any allocation for this time type.\n"
"Please request an allocation before submitting your time off request."
msgstr ""
"ທ່ານບໍ່ມີການຈັດສັນໃດໆສຳລັບປະເພດເວລານີ້.\n"
"ກະລຸນາຮ້ອງຂໍການຈັດສັນກ່ອນສົ່ງຄຳຮ້ອງຂໍລາພັກຂອງທ່ານ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"You don't have the rights to apply second approval on a time off request"
msgstr "ທ່ານບໍ່ມີສິດໃນການອະນຸມັດຂັ້ນທີສອງໃນຄຳຮ້ອງຂໍລາພັກ"

#. module: hr_holidays
#: model_terms:ir.actions.act_window,help:hr_holidays.action_my_days_off_dashboard_calendar
msgid "You have no time off yet!"
msgstr "ທ່ານຍັງບໍ່ມີການລາພັກເທື່ອ!"

#. module: hr_holidays
#: model:ir.model.constraint,message:hr_holidays.constraint_hr_leave_accrual_level_added_value_greater_than_zero
msgid "You must give a rate greater than 0 in accrual plan levels."
msgstr "ທ່ານຕ້ອງລະບຸອັດຕາທີ່ຫຼາຍກວ່າ 0 ໃນລະດັບແຜນການສະສົມ."

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid ""
"You must have manager rights to modify/validate a time off that already begun"
msgstr "ທ່ານຕ້ອງມີສິດຜູ້ຈັດການເພື່ອແກ້ໄຂ/ຢັ້ງຢືນການລາພັກທີ່ເລີ່ມຕົ້ນໄປແລ້ວ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "You've already booked time off which overlaps with this period:"
msgstr "ທ່ານໄດ້ຈອງເວລາລາພັກທີ່ທັບຊ້ອນກັບໄລຍະເວລານີ້ແລ້ວ:"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "Your %(work_entry_type)s planned on %(date)s has been accepted"
msgstr ""
"%(work_entry_type)s ຂອງທ່ານທີ່ວາງແຜນໄວ້ໃນວັນທີ %(date)s ໄດ້ຮັບການອະນຸມັດແລ້ວ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
msgid "Your %(work_entry_type)s planned on %(date)s has been refused"
msgstr "%(work_entry_type)s ຂອງທ່ານທີ່ວາງແຜນໄວ້ໃນວັນທີ %(date)s ຖືກປະຕິເສດແລ້ວ"

#. module: hr_holidays
#. odoo-python
#: code:addons/hr_holidays/models/hr_leave.py:0
