<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_holidays.CalendarController.Buttons">
        <Dropdown t-if="this.props.archInfo.canCreate">
            <button class="btn btn-primary o-dropdown-caret d-inline-flex align-items-center">
                New
            </button>
            <t t-set-slot="content">
                <DropdownItem tag="'button'" class="'btn btn-link'" onSelected="() => this.newTimeOffRequest()">
                    New Time Off
                </DropdownItem>
                <DropdownItem tag="'button'" class="'btn btn-link'" onSelected="() => this.newAllocationRequest()">
                    New Allocation Request
                </DropdownItem>
            </t>
        </Dropdown>
    </t>

</templates>
