<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_holidays.TimeOffCalendarSidePanel" t-inherit="web.CalendarSidePanel" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_calendar_sidepanel_content')]" position="inside">
            <div class="o_calendar_filter mt-4">
                <h5>Legend</h5>
                <div class="d-flex flex-column">
                    <span class="align-middle"><img class="o_calendar_filter_plain" src="/hr/static/src/img/icons/plain.svg"/> Approved</span>
                    <span class="align-middle"><img class="o_calendar_filter_hatched" src="/hr/static/src/img/icons/hatched.svg"/> To Approve</span>
                    <span class="align-middle"><img class="o_calendar_filter_line" src="/hr/static/src/img/icons/line.svg"/> Refused</span>
                </div>

                <div class="d-flex flex-column mt-4" t-if="this.mandatoryDays().length">
                    <h5>Mandatory Days</h5>
                    <ul class="ps-0">
                        <li t-foreach="this.mandatoryDays()" t-as="mandatoryDay" t-key="mandatoryDay.id" class="mt-2 list-unstyled"
                            t-att-class="mandatoryDay.end &lt; this.currentDateTime ? 'text-muted' : 'fw-bold'">
                            <span
                                    t-out="this.getFormattedDateSpan(mandatoryDay.start, mandatoryDay.end)"
                                    t-attf-class="hr_mandatory_day_{{ mandatoryDay.colorIndex }}"
                                    t-att-class="{ 'opacity-50': mandatoryDay.end &lt; this.currentDateTime }"/>
                            : <t t-out="mandatoryDay.title"/>
                        </li>
                    </ul>
                </div>

                <div class="d-flex flex-column mt-4" t-if="this.bankHolidays().length">
                    <h5>Public Holidays</h5>
                    <ul class="ps-0">
                        <li t-foreach="this.bankHolidays()" t-as="bankHoliday" t-key="bankHoliday.id" class="mt-2 list-unstyled"
                            t-att-class="bankHoliday.end &lt; this.currentDateTime ? 'text-muted' : 'fw-bold'">
                            <span
                                    t-out="this.getFormattedDateSpan(bankHoliday.start, bankHoliday.end)"/>
                            : <t t-out="bankHoliday.title"/>
                        </li>
                    </ul>
                </div>
            </div>
        </xpath>
    </t>
</templates>
