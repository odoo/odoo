<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_holidays.TimeOffCalendarMobileFilterPanel" t-inherit="web.CalendarMobileFilterPanel" t-inherit-mode="primary">
        <xpath expr="//i[@name='expand_filter_button']" position="replace">
            <div class="o_expand_filter_button d-flex align-items-center ms-2 h-100 text-nowrap">
                Time Type
                <i t-attf-class="oi oi-chevron-{{this.caretDirection}} ms-1" name="expand_filter_button"/>
            </div>
        </xpath>
    </t>
</templates>
