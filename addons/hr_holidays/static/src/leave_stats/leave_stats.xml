<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <div t-name="hr_holidays.LeaveStatsComponent" class="o_leave_stats">
        <div t-if="this.state.employee and this.state.leaves.length !== 0" id="o_leave_stats_employee" class="sub_table px-3 py-2 mb-3">
            <h4 class="d-flex">
                Summary <t t-out="this.thisYear"/>
            </h4>
            <div class="d-flex flex-column">
                <div t-foreach="this.state.leaves" t-as="record_leave" t-key="record_leave.data.id" class="d-flex gap-2">
                    <t t-set="leave" t-value="record_leave.data"/>
                    <div t-att-class="'rounded-circle border-0 flex-shrink-0 o_colorlist_toggler o_colorlist_item_color_' + leave.color"
                         style="width: 16px; height: 16px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);"></div>
                    <p t-out="leave.name" class="col-5 fw-bold mb-2"/>
                    <p class="mb-2">
                        <t t-out="record_leave.leaves_approved" class="me-1"/>
                        <t t-if="record_leave.max_leaves">
                            / <t t-out="record_leave.max_leaves" class="mx-1"/>
                        </t>
                        <t t-if="record_leave.unit_of_measure == 'day'"> days</t>
                    </p>
                    <p t-if="record_leave.remaining_leaves > 0" class="text-muted mb-2">
                        ( <t t-out="record_leave.remaining_leaves" class="mx-1"/>
                        <t t-if="record_leave.unit_of_measure == 'day'"> days</t> remaining )
                    </p>
                </div>
            </div>
        </div>

        <div t-if="this.state.department and this.state.nbEmployee > 0" id="o_leave_stats_department" class="alert alert-info px-3 py-2" role="alert">
            <h4>
                <t t-out="this.state.department_name"/>
                Overlaps
            </h4>
            <p class="mb-0">
                <b t-out="this.state.nbEmployee"/>
                team members on holiday during this period
                <a class="oe_link fw-bold"
                    href="#"
                    t-on-click="this.action_department_leaves">
                    <i class="oi oi-fw o_button_icon" data-icon="east"/>
                    View Overlaps
                </a>
            </p>
        </div>
    </div>
</templates>
