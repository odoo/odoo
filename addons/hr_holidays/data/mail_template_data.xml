<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="new_timeoff_request_template" model="mail.template">
            <field name="name">New Time Off Request</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="partner_to" eval="False"/>
            <field name="subject">I'm requesting {{ object.duration_display }} of {{ object.work_entry_type_id.name }} {{ 'on' if object.request_date_from == object.request_date_to else 'from' }} {{ object.get_formatted_leave_timings() }}</field>
            <field name="use_default_to" eval="True"/>
            <field name="description">Mail for new leave request</field>
            <field name="body_html" type="html">
                <div>
                    Dear <t t-out="object.sudo()._get_responsible_for_approval().partner_id.name or ''"/>,
                    <br/><br/>
                    <p><span style="font-weight:bold;" t-out="object.employee_id.name"/> is requesting <span style="font-weight:bold;" t-out="object.duration_display"/> of <span style="font-weight:bold;">Time off</span></p>
                    <ul>
                        <li>
                            <span style="font-weight:bold; display:inline-block; width:80px">When</span>
                            <span t-out="object.get_formatted_leave_timings()"/>
                        </li>
                        <li>
                            <span style="font-weight:bold; display:inline-block; width:80px">Type</span>
                            <span t-out="object.work_entry_type_id.name"/>
                        </li>
                        <li>
                            <span style="font-weight:bold; display:inline-block; width:80px">Remaining</span>
                            <span><t t-out="object.virtual_remaining_leaves"/> days</span>
                        </li>
                    </ul>
                    <br/>
                    Please approve the time off at your disposal.
                    <br/>
                </div>
            </field>
            <field name="lang">{{ object.user_id.lang }}</field>
        </record>

        <record id="mail_template_allocation_confirmed" model="mail.template">
            <field name="name">Time Off Allocation Confirmed</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="subject">Time Off Allocation Confirmed: {{ object.work_entry_type_id.name }} ({{ object.duration_display }})</field>
            <field name="description">Sent to employee when their time off allocation is confirmed</field>
            <field name="body_html" type="html">
                <div>
                    Dear <t t-out="object.employee_id.name or 'Employee'"/>,<br/><br/>
                    Your time off allocation has been confirmed.<br/><br/>
                    Details:<br/>
                    <ul>
                        <li>Time Type: <t t-out="object.work_entry_type_id.name or ''"/></li>
                        <li>Allocation: <t t-out="object.duration_display or ''"/></li>
                        <li>Valid From: <t t-out="object.date_from or ''"/> <t t-if="not object.date_to">(No Expiry)</t><t t-else=""> to <t t-out="object.date_to or ''"/></t></li>
                        <li t-if="object.accrual_plan_id">Accrual Plan: <t t-out="object.accrual_plan_id.name or ''"/></li>
                    </ul>
                    <br/>
                    For any questions, contact HR Responsible.<br/><br/>
                    Regards,<br/>
                    <t t-out="object.env.user.name or ''"/>
                </div>
            </field>
            <field name="lang">{{ object.employee_id.user_id.lang }}</field>
        </record>
    </data>
</odoo>
