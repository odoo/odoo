<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_time_rule_view_search_inherit_hr_holidays" model="ir.ui.view">
        <field name="name">hr.time.rule.search.inherit.hr.holidays</field>
        <field name="model">hr.time.rule</field>
        <field name="inherit_id" ref="hr_work_entry.hr_time_rule_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='give_salary']" position="after">
                <filter name="give_time" string="Give Time" domain="[('leave_compensation_rate', '>', 0)]"/>
            </xpath>
            <xpath expr="//filter[@name='group_amount_rate']" position="after">
                <filter name="group_leave_compensation_rate" string="Holiday Rate" context="{'group_by': 'leave_compensation_rate'}"/>
            </xpath>
        </field>
    </record>

    <record id="hr_time_rule_view_list_inherit_hr_holidays" model="ir.ui.view">
        <field name="name">hr.time.rule.list.inherit.hr.holidays</field>
        <field name="model">hr.time.rule</field>
        <field name="inherit_id" ref="hr_work_entry.hr_time_rule_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_rate']" position="after">
                <field name="leave_compensation_rate" string="Holiday Rate (%)" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="hr_time_rule_view_form_inherit_hr_holidays" model="ir.ui.view">
        <field name="name">hr.time.rule.form.inherit.hr.holidays</field>
        <field name="model">hr.time.rule</field>
        <field name="inherit_id" ref="hr_work_entry.hr_time_rule_view_form"/>
        <field name="arch" type="xml">
            <!-- expose computed flag used throughout for invisible conditions -->
            <xpath expr="//field[@name='country_work_entry_type_ids']" position="after">
                <field name="condition_is_hourly" invisible="1"/>
            </xpath>

            <!-- hide "Working Hours" threshold row for day/half-day condition types -->
            <xpath expr="//label[@for='working_hours_mode']" position="attributes">
                <attribute name="invisible">not condition_is_hourly</attribute>
            </xpath>
            <xpath expr="//field[@name='working_hours_mode']/ancestor::div[1]" position="attributes">
                <attribute name="invisible">not condition_is_hourly</attribute>
            </xpath>

            <!-- hide timing window row for day/half-day condition types -->
            <xpath expr="//field[@name='timing_start']/.." position="attributes">
                <attribute name="invisible">not condition_is_hourly</attribute>
            </xpath>

            <!-- replace "Set Excess/Deficit to" with "Reclassify to" for day/half-day types;
                 also extend the existing tooltips with leave-specific constraints -->
            <xpath expr="//span[hasclass('o_form_label')][contains(.,'Set Excess')]" position="attributes">
                <attribute name="invisible">threshold_operator == 'less_than' or not condition_is_hourly</attribute>
            </xpath>
            <xpath expr="//span[hasclass('o_form_label')][contains(.,'Set Excess')]/sup" position="attributes">
                <attribute name="data-tooltip">The time off type created for the excess. Must not require allocation. For hourly conditions, only hourly output types are accepted.</attribute>
            </xpath>
            <xpath expr="//span[hasclass('o_form_label')][contains(.,'Set Deficit')]" position="attributes">
                <attribute name="invisible">threshold_operator != 'less_than' or not condition_is_hourly</attribute>
            </xpath>
            <xpath expr="//span[hasclass('o_form_label')][contains(.,'Set Deficit')]/sup" position="attributes">
                <attribute name="data-tooltip">The time off type created for the deficit. Must not require allocation. For hourly conditions, only hourly output types are accepted.</attribute>
            </xpath>
            <xpath expr="//span[hasclass('o_form_label')][contains(.,'Set Deficit')]" position="after">
                <span class="o_form_label" invisible="condition_is_hourly">Reclassify to <sup class="d-print-none text-info p-1 ms-1" data-tooltip="The time off type used to reclassify this record. Must not require allocation.">?</sup></span>
            </xpath>

            <!-- allocation row appended after the output WET div -->
            <xpath expr="//field[@name='work_entry_type_id']/.." position="after">
                <span class="o_form_label" invisible="threshold_operator == 'less_than' or not condition_is_hourly">Allocate <sup class="d-print-none text-info p-1 ms-1" data-tooltip="You can grant time to the employee, with the rate of your choice (100% means 1:1), allowing him to take leave in compensation.">?</sup></span>
                <span class="o_form_label" invisible="threshold_operator != 'less_than' or not condition_is_hourly">Take <sup class="d-print-none text-info p-1 ms-1" data-tooltip="You can take time from the employee, with the rate of your choice (100% means 1:1).">?</sup></span>
                <span class="o_form_label" invisible="condition_is_hourly">Allocate <sup class="d-print-none text-info p-1 ms-1" data-tooltip="You can grant time to the employee in compensation for each matching record.">?</sup></span>
                <div class="d-flex gap-3 align-items-baseline">
                    <field name="leave_compensation_rate" widget="percentage" nolabel="1" style="width:6ch"/>
                    <span class="text-muted" invisible="not leave_compensation_rate or threshold_operator == 'less_than'">to</span>
                    <span class="text-muted" invisible="not leave_compensation_rate or threshold_operator != 'less_than'">from</span>
                    <field name="allocation_type_id" nolabel="1"
                        invisible="not leave_compensation_rate"
                        placeholder="Choose a Time Off Type"
                        help="Must require allocation and be selectable in time off requests."/>
                </div>
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_hr_holidays_time_rules"
        name="Automatic Rules"
        parent="hr_holidays.menu_hr_holidays_configuration"
        action="hr_work_entry.hr_time_rule_action"
        groups="hr_holidays.group_hr_holidays_manager"
        sequence="5"/>

</odoo>
