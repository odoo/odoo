<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_accrual_level_view_form" model="ir.ui.view">
        <field name="name">hr.leave.accrual.level.form</field>
        <field name="model">hr.leave.accrual.level</field>
        <field name="arch" type="xml">
            <form string="Accrual Level">
                <sheet>
                    <div colspan="2">
                        <field name="can_modify_value_type" invisible="1" />
                    </div>
                    <div class="o_accrual_level_form">
                        <group string="Accrual Level Options" class="o_accrual">
                            <label
                                for="added_value"
                                string="Set the employee accrual frequency :"
                                class="fw-bold" />
                            <span>
                                <field
                                    name="added_value"
                                    widget="float_without_trailing_zeros"
                                    nolabel="1"
                                    class="me-1 o_field_accrual" />
                                <field
                                    name="added_value_type"
                                    nolabel="1"
                                    readonly="not can_modify_value_type"
                                    class="me-1 o_field_accrual" />
                                <field
                                    name="frequency"
                                    nolabel="1"
                                    class="o_field_accrual" />
                                <span name="weekly" invisible="frequency != 'weekly'">
                                    on
                                    <field
                                        name="repeat_weekday"
                                        placeholder="select a weekday"
                                        nolabel="1"
                                        required="frequency == 'weekly'"
                                        class="o_field_accrual" />
                                </span>
                                <span name="monthly" invisible="frequency != 'monthly'">
                                    on the
                                    <field
                                        name="repeat_day"
                                        placeholder="select a day"
                                        nolabel="1"
                                        required="frequency == 'monthly'"
                                        class="o_field_accrual" />
                                    of the month.
                                </span>
                                <span
                                    name="bimonthly"
                                    invisible="frequency != 'bimonthly'"
                                    style="width: 100%">
                                    on the
                                    <field
                                        name="repeat_day"
                                        placeholder="select a day"
                                        nolabel="1"
                                        required="frequency == 'bimonthly'"
                                        class="o_field_accrual" />
                                    and the
                                    <field
                                        name="repeat_second_day"
                                        placeholder="select a day"
                                        nolabel="1"
                                        required="frequency == 'bimonthly'"
                                        class="o_field_accrual" />
                                    of the month
                                </span>
                                <span
                                    name="biyearly"
                                    invisible="frequency != 'biyearly'">
                                    on the
                                    <field
                                        name="repeat_day"
                                        placeholder="select a day"
                                        widget="day_selection"
                                        nolabel="1"
                                        required="frequency == 'biyearly'"
                                        class="o_field_accrual"
                                        month_field="repeat_month" />
                                    of
                                    <field
                                        name="repeat_month"
                                        placeholder="select a month"
                                        required="frequency == 'biyearly'"
                                        class="o_field_accrual" />
                                    and the
                                    <field
                                        name="repeat_second_day"
                                        placeholder="select a day"
                                        widget="day_selection"
                                        nolabel="1"
                                        required="frequency == 'biyearly'"
                                        class="o_field_accrual"
                                        month_field="repeat_second_month" />
                                    of
                                    <field
                                        name="repeat_second_month"
                                        placeholder="select a month"
                                        nolabel="1"
                                        required="frequency == 'biyearly'"
                                        class="o_field_accrual" />
                                </span>
                                <span name="yearly" invisible="frequency != 'yearly'">
                                    on the
                                    <field
                                        name="repeat_day"
                                        placeholder="select a day"
                                        widget="day_selection"
                                        nolabel="1"
                                        required="frequency == 'yearly'"
                                        class="o_field_accrual"
                                        month_field="repeat_month" />
                                    of
                                    <field
                                        name="repeat_month"
                                        placeholder="select a month"
                                        nolabel="1"
                                        required="frequency == 'yearly'"
                                        class="o_field_accrual" />
                                </span>
                            </span>
                            <span name="yearly_gain" class="text-muted">
                                <label
                                    for="yearly_gain"
                                    string="Gain for the year :"
                                    invisible="is_based_on_worked_time"
                                    class="fw-bold" />
                                <label
                                    for="yearly_gain"
                                    string="Maximum gain for the year :"
                                    invisible="not is_based_on_worked_time"
                                    class="fw-bold" />
                            </span>
                            <span class="text-muted">
                                <field
                                    name="yearly_gain"
                                    nolabel="1"
                                    widget="float_without_trailing_zeros"
                                    class="me-1 o_field_accrual" />
                                <field
                                    name="added_value_type"
                                    nolabel="1"
                                    readonly="1"
                                    class="o_field_accrual" />
                                <span
                                    invisible="not cap_accrued_time_yearly and not cap_accrued_time"
                                    class="ms-3">(Caps can affect that gain)</span>
                            </span>
                            <label
                                for="milestone_date"
                                string="This milestone will be reached :"
                                class="fw-bold" />
                            <span name="milestone_date">
                                <field
                                    name="milestone_date"
                                    widget="radio_followed_by_element"
                                    nolabel="1"
                                    options="{'links': {'after': 'milestone_date_after'}, 'observe': 'milestone_date'}"
                                    class="ms-1" />
                                <span id="milestone_date_after">
                                    <field
                                        name="start_count"
                                        nolabel="1"
                                        class="ms-1 me-1 o_field_accrual" />
                                    <field
                                        name="start_type"
                                        nolabel="1"
                                        class="me-1 o_field_accrual" />
                                    from the start of allocation
                                </span>
                            </span>
                        </group>
                        <group
                            string="Carry Over Options"
                            invisible="not can_be_carryover"
                            class="o_accrual">
                            <label
                                for="action_with_unused_accruals"
                                string="After a year, unused time off will be :"
                                class="fw-bold" />
                            <span>
                                <span name="unused_accruals">
                                    <field
                                        name="action_with_unused_accruals"
                                        widget="radio"
                                        nolabel="1"
                                        readonly="not can_be_carryover"
                                        class="ms-1" />
                                </span>
                            </span>
                            <label
                                for="carryover_options"
                                string="How much time can be carried over :"
                                invisible="action_with_unused_accruals == 'lost'"
                                class="fw-bold" />
                            <span
                                invisible="action_with_unused_accruals == 'lost'"
                                id="unused_accruals_all">
                                <span name="carryover_options">
                                    <field
                                        name="carryover_options"
                                        widget="radio_followed_by_element"
                                        nolabel="1"
                                        options="{'links': {'limited': 'carryover_options_limited'}, 'observe': 'carryover_options'}"
                                        class="ms-1" />
                                    <span id="carryover_options_limited" readonly="1">
                                        <field
                                            name="postpone_max_days"
                                            nolabel="1"
                                            class="ms-1 me-1 o_field_accrual" />
                                        <field
                                            name="added_value_type"
                                            nolabel="1"
                                            readonly="1"
                                            class="o_field_accrual" />
                                    </span>
                                </span>
                            </span>
                            <label
                                for="accrual_validity"
                                string="Define a carry over validity?"
                                invisible="action_with_unused_accruals == 'lost'"
                                class="fw-bold" />
                            <span
                                invisible="action_with_unused_accruals == 'lost'"
                                class="d-flex">
                                <field
                                    name="accrual_validity"
                                    nolabel="1"
                                    class="ms-1" />
                                <span invisible="not accrual_validity">
                                    The days carried over will be effective for
                                    <field
                                        name="accrual_validity_count"
                                        nolabel="1"
                                        class="me-1 o_field_accrual" />
                                    <field
                                        name="accrual_validity_type"
                                        nolabel="1"
                                        class="me-1 o_field_accrual" />
                                </span>
                            </span>
                        </group>
                        <group string="Cap Options" class="o_accrual">
                            <label
                                for="cap_accrued_time_yearly"
                                string="Define a yearly cap?"
                                class="fw-bold" />
                            <span>
                                <field
                                    name="cap_accrued_time_yearly"
                                    nolabel="1"
                                    class="ms-1" />
                                <span invisible="not cap_accrued_time_yearly">
                                    Accrual will stop until next carry-over date if accrued time's reach
                                    <field
                                        name="maximum_leave_yearly"
                                        widget="float_without_trailing_zeros"
                                        nolabel="1"
                                        class="me-1 o_field_accrual" />
                                    <field name="added_value_type" nolabel="1" readonly="1" class="o_field_accrual" />.
                                </span>
                            </span>
                            <label
                                for="cap_accrued_time"
                                string="Define a balance cap?"
                                class="fw-bold" />
                            <span>
                                <field
                                    name="cap_accrued_time"
                                    nolabel="1"
                                    class="ms-1" />
                                <span invisible="not cap_accrued_time">
                                    The plan will be on hold if the balance reach
                                    <field
                                        name="maximum_leave"
                                        widget="float_without_trailing_zeros"
                                        nolabel="1"
                                        class="me-1 o_field_accrual" />
                                    <field name="added_value_type" nolabel="1" readonly="1" class="o_field_accrual" /> of available time.
                                </span>
                            </span>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button special="save" string="Save" class="btn btn-primary" />
                    <button
                        name="action_save_new"
                        type="object"
                        string="Save &amp; New"
                        invisible="not context.get('new')"
                        class="btn btn-primary" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn btn-secondary" />
                    <button
                        name="unlink"
                        type="object"
                        string="Delete"
                        invisible="context.get('new')"
                        class="btn btn-danger ms-auto" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_accrual_plan_view_tree" model="ir.ui.view">
        <field name="name">hr.leave.accrual.plan.list</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="arch" type="xml">
            <list string="Accrual Plans" sample="1">
                <field name="name" />
                <field name="level_count" />
                <field name="employees_count" />
            </list>
        </field>
    </record>

    <record id="hr_accrual_plan_view_form" model="ir.ui.view">
        <field name="name">hr.leave.accrual.plan.form</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="arch" type="xml">
            <form string="Accrual Plan" class="o_accrual_plan_form">
                <field name="active" invisible="1" />
                <field name="show_transition_mode" invisible="1" />
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button
                            name="action_view_accrual_plan_employees"
                            type="object"
                            icon="fa-users"
                            groups="hr.group_hr_user"
                            invisible="employees_count == 0"
                            class="oe_stat_button">
                            <field name="employees_count" widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="bg-danger" />
                    <div>
                        <div class="d-flex flex-direction-row o_accrual_plan_settings">
                            <div class="w-100">
                                <div class="oe_title w-50">
                                    <label for="name" string="Title" class="fw-bold" />
                                    <h1><field name="name" placeholder="e.g. Seniority Plan, PTO, RTT, ..." required="id" /></h1>
                                    <group groups="base.group_multi_company">
                                        <field
                                            name="company_id"
                                            placeholder="Visible to all"
                                            options="{'no_create': True}"
                                            groups="base.group_multi_company" />
                                    </group>
                                </div>
                                <group string="Configuration" class="mt-0 o_accrual">
                                    <label
                                        for="accrued_gain_time"
                                        string="When the time is accrued?"
                                        class="fw-bold" />
                                    <field
                                        name="accrued_gain_time"
                                        widget="radio"
                                        nolabel="1"
                                        class="ms-1" />
                                    <label
                                        for="is_based_on_worked_time"
                                        string="It is based on worked time?"
                                        invisible="accrued_gain_time == 'start'"
                                        class="fw-bold" />
                                    <span invisible="accrued_gain_time == 'start'">
                                        <field
                                            name="is_based_on_worked_time"
                                            widget="boolean_radio"
                                            options="{                                                     'yes_label_element_id': 'is_based_on_worked_time_yes',                                                     'no_label_element_id': 'is_based_on_worked_time_no'                                                 }"
                                            readonly="accrued_gain_time == 'start'"
                                            class="o_field_radio ms-1" />
                                        <template id="is_based_on_worked_time_yes">Yes, consider the worked hours, excluding any time off taken during that period.
                                        </template>
                                        <template id="is_based_on_worked_time_no">No, always consider the entire accrual period (whole calendar days).
                                        </template>
                                    </span>
                                    <label
                                        for="can_be_carryover"
                                        string="Do you need a carry-over of the accrued days from one year to another?"
                                        class="fw-bold" />
                                    <span>
                                        <field name="can_be_carryover" class="ms-1" />
                                    </span>
                                    <label
                                        for="carryover_date"
                                        string="When do you want the accrued time left to be carried-over?"
                                        invisible="not can_be_carryover"
                                        class="fw-bold" />
                                    <span
                                        name="carryover"
                                        invisible="not can_be_carryover">
                                        <field
                                            name="carryover_date"
                                            widget="radio_followed_by_element"
                                            options="{'links': {'other': 'carryover_custom_date'}, 'observe': 'carryover'}"
                                            class="ms-1" />
                                        <span id="carryover_custom_date">
                                            : the
                                            <field
                                                name="carryover_day"
                                                placeholder="select a day"
                                                widget="day_selection"
                                                required="carryover_date == 'other'"
                                                month_field="carryover_month" />
                                            of
                                            <field
                                                name="carryover_month"
                                                placeholder="select a month"
                                                required="carryover_date == 'other'" />
                                        </span>
                                    </span>
                                    <label
                                        for="transition_mode"
                                        string="Switch employees to the new accrual level:"
                                        invisible="not show_transition_mode"
                                        class="fw-bold" />
                                    <span invisible="not show_transition_mode">
                                        <field
                                            name="transition_mode"
                                            widget="radio"
                                            class="ms-1" />
                                    </span>
                                </group>
                            </div>
                        </div>
                        <div
                            class="o_accrual_plan_levels border rounded-3 d-flex mt-2 flex-direction-column align-items-center flex-1 overflow-hidden">
                            <div
                                class="o_accrual_levels_scrollable w-100 h-100 d-flex align-content-center">
                                <div
                                    class="o_view_nocontent top-0"
                                    style="position: relative;"
                                    invisible="level_ids">
                                    <div class="o_nocontent_help">
                                        <p class="o_view_nocontent_smiling_face">
                                            No milestones on the plan yet. Let's create a new one
                                        </p>
                                        <button
                                            name="action_create_accrual_plan_level"
                                            type="object"
                                            string="Create a milestone"
                                            class="btn btn-primary" />
                                    </div>
                                </div>
                                <field
                                    name="level_ids"
                                    widget="accrual_levels"
                                    invisible="not level_ids" />
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_accrual_plan_view_search" model="ir.ui.view">
        <field name="name">hr.leave.accrual.plan.search</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="arch" type="xml">
            <search string="Accrual Plan">
                <field name="name" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]" />
                <filter
                    name="company_id"
                    string="Company"
                    context="{'group_by':'company_id'}"
                    groups="base.group_multi_company" />
            </search>
        </field>
    </record>

    <record id="open_view_accrual_plans" model="ir.actions.act_window">
        <field name="name">Accrual Plans</field>
        <field name="res_model">hr.leave.accrual.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Accrual Plan
            </p>
            <p>
                Use accrual plans to give determined amount of time following the rules you define
            </p>
        </field>
    </record>

</odoo>
