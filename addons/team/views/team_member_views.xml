<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="team_member_view_search" model="ir.ui.view">
            <field name="name">team.member.view.search</field>
            <field name="model">team.member</field>
            <field name="arch" type="xml">
                <search string="Team Members">
                    <field name="user_id" />
                    <field name="team_id" />
                    <separator />
                    <filter
                        name="archived"
                        string="Archived"
                        domain="[('active', '=', False)]" />
                    <group>
                        <filter
                            name="groupby_team_id"
                            string="Team"
                            context="{'group_by': 'team_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <record id="team_member_view_tree" model="ir.ui.view">
            <field name="name">team.member.view.list</field>
            <field name="model">team.member</field>
            <field name="arch" type="xml">
                <list string="Team Members" sample="1">
                    <field name="team_id" />
                    <field name="user_id" />
                </list>
            </field>
        </record>
        <record id="team_member_view_tree_from_team" model="ir.ui.view">
            <field name="name">team.member.view.list.from.team</field>
            <field name="model">team.member</field>
            <field name="inherit_id" ref="team.team_member_view_tree" />
            <field name="mode">primary</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='team_id']" position="replace" />
            </field>
        </record>
        <record id="team_member_view_kanban" model="ir.ui.view">
            <field name="name">team.member.view.kanban</field>
            <field name="model">team.member</field>
            <field name="arch" type="xml">
                <kanban
                    default_group_by="team_id"
                    sample="1"
                    class="o_team_member_kanban"
                    group_create="0"
                    quick_create="false"
                    records_draggable="0">
                    <field name="active" />
                    <templates>
                        <t t-name="card" class="flex-row mb-3">
                            <widget
                                name="web_ribbon"
                                title="Archived"
                                invisible="active"
                                bg_color="text-bg-danger" />
                            <aside>
                                <field
                                    name="user_id"
                                    widget="image"
                                    options="{'preview_image': 'avatar_128'}"
                                    class="o_image_64_cover"
                                    alt="Avatar" />
                            </aside>
                            <main class="ms-3">
                                <field name="user_id" class="fw-bold fs-5" />
                                <a type="open" class="nav-link p-0"><field name="team_id" /></a>
                                <div class="d-flex align-items-baseline text-break">
                                    <i class="fa-solid fa-envelope me-1" role="img" aria-label="Email" title="Email" /><field name="email" />
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="team_member_view_kanban_from_team" model="ir.ui.view">
            <field name="name">team.member.view.kanban.from.team</field>
            <field name="model">team.member</field>
            <field name="inherit_id" ref="team.team_member_view_kanban" />
            <field name="mode">primary</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='team_id']" position="replace" />
            </field>
        </record>
        <record id="team_member_view_form" model="ir.ui.view">
            <field name="name">team.member.view.form</field>
            <field name="model">team.member</field>
            <field name="arch" type="xml">
                <form string="Team Members" js_class="team_form">
                    <field name="active" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="user_company_ids" invisible="1" />
                    <field name="can_activate_multi_membership" invisible="1" />
                    <sheet>
                        <div
                            class="alert alert-info text-center d-flex flex-wrap justify-content-center gap-1"
                            role="alert"
                            invisible="not member_warning">
                            <field name="member_warning" class="w-auto" />
                            <span
                                invisible="not can_activate_multi_membership"
                                class="d-flex flex-wrap gap-1">
                                Working in multiple teams?
                                <button
                                    name="team_activate_multi_membership"
                                    type="team_event"
                                    class="btn btn-link p-0 lh-1">
                                    Activate "Multi-team"
                                </button>
                            </span>
                        </div>
                        <widget
                            name="web_ribbon"
                            title="Archived"
                            invisible="active"
                            bg_color="text-bg-danger" />
                        <field
                            name="image_1920"
                            widget="image"
                            options="{&quot;preview_image&quot;: &quot;image_128&quot;, &quot;size&quot;: [130,130], &quot;img_class&quot;: &quot;rounded border&quot;}"
                            invisible="not user_id"
                            class="float-start pe-3" />
                        <h1 class="d-flex">
                            <field
                                name="user_id"
                                placeholder="e.g. John Doe"
                                options="{'no_quick_create': True}"
                                class="flex-grow-1" />
                        </h1>
                        <group name="team_id">
                            <field
                                name="team_id"
                                id="team_id"
                                context="{'kanban_view_ref': 'team.team_view_kanban'}" />
                        </group>
                        <group name="member_partner_info">
                            <div class="d-flex flex-column flex-grow-1">
                                <div
                                    colspan="2"
                                    class="d-flex align-items-baseline"
                                    invisible="not user_id">
                                    <i
                                        class="fa-solid fa-envelope me-1 text-primary"
                                        title="Email" />
                                    <field name="email" nolabel="1" />
                                </div>
                                <div
                                    colspan="2"
                                    class="d-flex align-items-baseline"
                                    invisible="not user_id">
                                    <i
                                        class="fa-solid fa-phone me-1 text-primary"
                                        title="Phone" />
                                    <field
                                        name="phone_ids"
                                        widget="many2many_tags"
                                        nolabel="1" />
                                </div>
                                <div
                                    colspan="2"
                                    class="d-flex align-items-baseline"
                                    invisible="not user_id"
                                    groups="base.group_multi_company">
                                    <i
                                        class="fa-solid fa-building me-1 text-primary"
                                        title="Company" />
                                    <field name="company_id" />
                                </div>
                            </div>
                        </group>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>
        <record id="team_member_view_form_from_team" model="ir.ui.view">
            <field name="name">team.member.view.form.from.team</field>
            <field name="model">team.member</field>
            <field name="inherit_id" ref="team.team_member_view_form" />
            <field name="mode">primary</field>
            <field name="priority">32</field>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='team_id']" position="replace" />
                <xpath
                    expr="//group[@name='member_partner_info']/div"
                    position="attributes">
                    <attribute name="class">px-0</attribute>
                </xpath>
            </field>
        </record>
        <record id="team_member_action" model="ir.actions.act_window">
            <field name="name">Team Members</field>
            <field name="res_model">team.member</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a member to a team
                </p><p>
                    Link users to the teams they work in.
                </p>
            </field>
        </record>
    </data>

</odoo>
