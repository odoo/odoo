<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_form_inherit_ticket" model="ir.ui.view">
        <field name="name">event.form.inherit</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='%(event.act_event_registration_from_event)d']"
                position="after">
                <field name="currency_id" invisible="1" />
                <button
                    name="action_view_linked_orders"
                    type="object"
                    help="Total sales for this event"
                    icon="fa-dollar"
                    groups="sale.group_sale_salesman"
                    invisible="sale_price_total == 0 or not sale_price_total"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field
                                name="sale_price_total"
                                string="Sales"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}" />
                            </span>
                        <span class="o_stat_text">Sales</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
