#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/tools/peppol_errors.py:0
msgid ""
"A 0% tax cannot use Tax Category 'S' (Standard). Please update the Tax "
"Category in the Advanced Options of the tax configuration."
msgstr ""
"ອາກອນ 0% ບໍ່ສາມາດໃຊ້ໝວດໝູ່ອາກອນ 'S' (ມາດຕະຖານ) ໄດ້. "
"ກະລຸນາປັບປຸງໝວດໝູ່ອາກອນໃນຕົວເລືອກຂັ້ນສູງຂອງການກຳນົດຄ່າອາກອນ."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/account_edi_proxy_user.py:0
msgid ""
"A Peppol response declaring you %(status)s this document could not be sent "
"to the Peppol Access Point."
msgstr ""
"ບໍ່ສາມາດສົ່ງຄຳຕອບ Peppol ທີ່ລະບຸວ່າທ່ານ %(status)s ເອກະສານນີ້ ໄປຍັງ Peppol Access Point "
"ໄດ້."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/models/account_edi_proxy_user.py:0
msgid ""
"A Peppol response was sent to the Peppol Access Point declaring you %"
"(status)s this document."
msgstr ""
"ຄຳຕອບ Peppol ທີ່ລະບຸວ່າທ່ານ %(status)s ເອກະສານນີ້ ໄດ້ຖືກສົ່ງໄປຍັງ Peppol Access Point "
"ແລ້ວ."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A Receipt has been received  for a message that was previously sent by the "
"MSH generating this error, but the content does not match the message "
"content (e.g. some part has not been acknowledged, or the digest associated "
"does not match the signature digest, for NRR)."
msgstr ""
"ໄດ້ຮັບໃບຕອບຮັບສຳລັບຂໍ້ຄວາມທີ່ຖືກສົ່ງກ່ອນໜ້ານີ້ໂດຍ MSH ທີ່ສ້າງຂໍ້ຜິດພາດນີ້ແລ້ວ, "
"ແຕ່ເນື້ອໃນບໍ່ກົງກັບເນື້ອໃນຂໍ້ຄວາມ (ຕົວຢ່າງ: ບາງສ່ວນບໍ່ໄດ້ຮັບການຮັບຮອງ, ຫຼື digest ທີ່ກ່ຽວຂ້ອງບໍ່ກົງກັບ "
"digest ລາຍເຊັນ, ສຳລັບ NRR)."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A Receipt has not been received  for a message that was previously sent by "
"the MSH generating this error."
msgstr "ຍັງບໍ່ໄດ້ຮັບໃບຕອບຮັບສຳລັບຂໍ້ຄວາມທີ່ຖືກສົ່ງກ່ອນໜ້ານີ້ໂດຍ MSH ທີ່ສ້າງຂໍ້ຜິດພາດນີ້."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/wizard/peppol_registration.py:0
msgid "A connection to '%s' already exists."
msgstr "ມີການເຊື່ອມຕໍ່ກັບ '%s' ຢູ່ແລ້ວ."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received but a previously received fragment message had the "
"same values for GroupId and FragmentNum"
msgstr ""
"ໄດ້ຮັບສ່ວນຍ່ອຍແລ້ວ ແຕ່ຂໍ້ຄວາມສ່ວນຍ່ອຍທີ່ໄດ້ຮັບກ່ອນໜ້ານີ້ມີຄ່າດຽວກັນສຳລັບ GroupId ແລະ FragmentNum"

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received but more than one fragment message in a group of "
"fragments specifies a value for a compression element."
msgstr ""
"ໄດ້ຮັບສ່ວນຍ່ອຍແລ້ວ ແຕ່ມີຂໍ້ຄວາມສ່ວນຍ່ອຍຫຼາຍກວ່າໜຶ່ງຂໍ້ຄວາມໃນກຸ່ມສ່ວນຍ່ອຍທີ່ກຳນົດຄ່າສຳລັບອົງປະກອບການບີບອັດ."

#. module: account_peppol
#. odoo-python
#: code:addons/account_peppol/exceptions.py:0
msgid ""
"A fragment is received but more than one fragment message in a group of "
"fragments specifies a value for this element."
msgstr ""
"ໄດ້ຮັບສ່ວນຍ່ອຍແລ້ວ ແຕ່ມີຂໍ້ຄວາມສ່ວນຍ່ອຍຫຼາຍກວ່າໜຶ່ງຂໍ້ຄວາມໃນກຸ່ມສ່ວນຍ່ອຍທີ່ກຳນົດຄ່າສຳລັບອົງປະກອບນີ້."

