970	16	\N	1	1	Rating: static star widget	\N	portal_rating.rating_widget_stars_static	qweb	portal_rating/views/rating_templates.xml	primary	{"en_US": "<t name=\\"Rating: static star widget\\" t-name=\\"portal_rating.rating_widget_stars_static\\">\\n        <t t-set=\\"rating_avg\\" t-value=\\"round(rating_avg * 100) / 100\\"/>\\n        <t t-set=\\"val_decimal\\" t-value=\\"round(rating_avg % 1, 1)\\"/>\\n        <t t-set=\\"val_integer\\" t-value=\\"int(rating_avg)\\"/>\\n        <t t-set=\\"empty_star\\" t-value=\\"5 - (val_integer+1) if val_decimal else 5 - val_integer\\"/>\\n        <div class=\\"o_website_rating_static\\" t-att-style=\\"inline_mode and 'display:inline'\\" t-att-title=\\"rating_avg\\">\\n            <t t-if=\\"rating_style_compressed\\">\\n                <t t-if=\\"rating_avg &lt;= 2\\">\\n                    <i class=\\"fa fa-star-o\\" role=\\"img\\"/>\\n                </t>\\n                <t t-elif=\\"rating_avg &gt;= 2.1 and rating_avg &lt;= 3.5\\">\\n                    <i class=\\"fa fa-star-half-o\\" role=\\"img\\"/>\\n                </t>\\n                <t t-else=\\"\\">\\n                    <i class=\\"fa fa-star\\" role=\\"img\\"/>\\n                </t>\\n                <small class=\\"text-muted ms-1\\">\\n                    <t t-esc=\\"rating_avg\\"/>\\n                </small>\\n            </t>\\n            <t t-else=\\"\\">\\n                <t t-foreach=\\"range(0, val_integer)\\" t-as=\\"num\\">\\n                    <i class=\\"fa fa-star\\" role=\\"img\\"/>\\n                </t>\\n                <t t-if=\\"val_decimal\\">\\n                    <i class=\\"fa fa-star-half-o\\" role=\\"img\\"/>\\n                </t>\\n                <t t-foreach=\\"range(0, empty_star)\\" t-as=\\"num\\">\\n                    <i class=\\"fa fa-star-o\\" role=\\"img\\"/>\\n                </t>\\n                <small class=\\"text-muted ms-1\\">\\n                    (<t t-esc=\\"rating_count\\"/>)\\n                </small>\\n            </t>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Rating: static star widget" t-name="portal_rating.rating_widget_stars_static">\n        <t t-set="rating_avg" t-value="round(rating_avg * 100) / 100"/>\n        <t t-set="val_decimal" t-value="round(rating_avg % 1, 1)"/>\n        <t t-set="val_integer" t-value="int(rating_avg)"/>\n        <t t-set="empty_star" t-value="5 - (val_integer+1) if val_decimal else 5 - val_integer"/>\n        <div class="o_website_rating_static" t-att-style="inline_mode and 'display:inline'" t-att-title="rating_avg">\n            <t t-if="rating_style_compressed">\n                <t t-if="rating_avg &lt;= 2">\n                    <i class="fa fa-star-o" role="img"/>\n                </t>\n                <t t-elif="rating_avg &gt;= 2.1 and rating_avg &lt;= 3.5">\n                    <i class="fa fa-star-half-o" role="img"/>\n                </t>\n                <t t-else="">\n                    <i class="fa fa-star" role="img"/>\n                </t>\n                <small class="text-muted ms-1">\n                    <t t-esc="rating_avg"/>\n                </small>\n            </t>\n            <t t-else="">\n                <t t-foreach="range(0, val_integer)" t-as="num">\n                    <i class="fa fa-star" role="img"/>\n                </t>\n                <t t-if="val_decimal">\n                    <i class="fa fa-star-half-o" role="img"/>\n                </t>\n                <t t-foreach="range(0, empty_star)" t-as="num">\n                    <i class="fa fa-star-o" role="img"/>\n                </t>\n                <small class="text-muted ms-1">\n                    (<t t-esc="rating_count"/>)\n                </small>\n            </t>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:52.068126	2026-09-05 15:59:52.068126	f
