887	20	\N	1	1	rating.rating.view.kanban.stars	rating.rating	\N	kanban	rating/views/rating_rating_views.xml	primary	{"en_US": "<kanban create=\\"false\\" class=\\"o_rating_rating_kanban\\">\\n                    <field name=\\"rating\\"/>\\n                    <templates>\\n                        <t t-name=\\"card\\" class=\\"row g-0\\">\\n                            <t t-set=\\"val_stars\\" t-value=\\"Math.round(record.rating.raw_value * 10) / 10\\"/>\\n                            <t t-set=\\"val_integer\\" t-value=\\"Math.floor(val_stars)\\"/>\\n                            <t t-set=\\"val_decimal\\" t-value=\\"val_stars - val_integer\\"/>\\n                            <t t-set=\\"empty_star\\" t-value=\\"5 - (val_integer + Math.ceil(val_decimal))\\"/>\\n                            <aside class=\\"col-3 me-2\\">\\n                                <div class=\\"display-3 fw-bold text-center text-primary mb-2\\" t-esc=\\"val_stars\\"/>\\n                                <i t-foreach=\\"[...Array(val_integer).keys()]\\" t-as=\\"num\\" t-key=\\"num\\" class=\\"fa fa-star\\" aria-label=\\"A star\\" role=\\"img\\"/>\\n                                <i t-if=\\"val_decimal\\" class=\\"fa fa-star-half-o\\" aria-label=\\"Half a star\\" role=\\"img\\"/>\\n                                <i t-foreach=\\"[...Array(empty_star).keys()]\\" t-as=\\"num\\" t-key=\\"num\\" class=\\"fa fa-star text-black-25\\" aria-label=\\"A star\\" role=\\"img\\"/>\\n                            </aside>\\n                            <main class=\\"col\\">\\n                                <field name=\\"partner_id\\" class=\\"fw-bold fs-5\\"/>\\n                                <div class=\\"mt0\\">\\n                                    <i class=\\"fa fa-folder me-2\\" aria-label=\\"Open folder\\"/>\\n                                    <a type=\\"object\\" name=\\"action_open_rated_object\\" t-att-title=\\"record.res_name.raw_value\\">\\n                                        <field name=\\"res_name\\"/>\\n                                    </a>\\n                                    <div><i class=\\"fa fa-clock-o me-2\\" aria-label=\\"Create date\\"/> <field name=\\"rated_on\\"/></div>\\n                                    <field name=\\"feedback\\" class=\\"mt-2\\"/>\\n                                </div>\\n                            </main>\\n                        </t>\\n                    </templates>\\n                </kanban>"}	<?xml version="1.0"?>\n<kanban create="false" class="o_rating_rating_kanban">\n                    <field name="rating"/>\n                    <templates>\n                        <t t-name="card" class="row g-0">\n                            <t t-set="val_stars" t-value="Math.round(record.rating.raw_value * 10) / 10"/>\n                            <t t-set="val_integer" t-value="Math.floor(val_stars)"/>\n                            <t t-set="val_decimal" t-value="val_stars - val_integer"/>\n                            <t t-set="empty_star" t-value="5 - (val_integer + Math.ceil(val_decimal))"/>\n                            <aside class="col-3 me-2">\n                                <div class="display-3 fw-bold text-center text-primary mb-2" t-esc="val_stars"/>\n                                <i t-foreach="[...Array(val_integer).keys()]" t-as="num" t-key="num" class="fa fa-star" aria-label="A star" role="img"/>\n                                <i t-if="val_decimal" class="fa fa-star-half-o" aria-label="Half a star" role="img"/>\n                                <i t-foreach="[...Array(empty_star).keys()]" t-as="num" t-key="num" class="fa fa-star text-black-25" aria-label="A star" role="img"/>\n                            </aside>\n                            <main class="col">\n                                <field name="partner_id" class="fw-bold fs-5"/>\n                                <div class="mt0">\n                                    <i class="fa fa-folder me-2" aria-label="Open folder"/>\n                         