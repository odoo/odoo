 Geofence attendance is disabled until the work address has valid coordinates and positive radius and accuracy limits.\\n                </div>\\n                <separator string=\\"Approval Routing\\"/>\\n                <group name=\\"presenly_location_approval_routing\\">\\n                    <group>\\n                        <field name=\\"presenly_manager_id\\" widget=\\"many2one_avatar_user\\" domain=\\"[('active', '=', True), ('company_ids', 'in', company_id)]\\" help=\\"Used only by Approval Steps whose Approver Source is Work Location Manager. The user must also have the Presenly Approver role.\\"/>\\n                    </group>\\n                    <group>\\n                        <div class=\\"alert alert-info\\" role=\\"alert\\">\\n                            This manager is not an automatic approver. It is selected only when an Approval Step uses Work Location Manager. Use Approval Overrides only when this location needs a different route from the company default.\\n                        </div>\\n                    </group>\\n                </group>\\n            </xpath>\\n        </data>"}	<data><xpath expr="//sheet/group[1]" position="before">\n                <div class="oe_button_box" name="button_box">\n                    <button name="action_open_presenly_approval_overrides" type="object" class="oe_stat_button" icon="fa-random" invisible="not id" groups="presenly.group_presenly_manager" help="Configure approval steps that override company defaults only at this Work Location.">\n                        <field name="presenly_approval_override_count" widget="statinfo" string="Ready Overrides"/>\n                    </button>\n                </div>\n            </xpath>\n            <xpath expr="//sheet" position="inside">\n                <separator string="Presenly Mobile Attendance Policy"/>\n                <field name="presenly_is_geofence_ready" invisible="1"/>\n                <group name="presenly_mobile_attendance_policy">\n                    <group string="Geofence Validation">\n                        <field name="latitude"/>\n                        <field name="longitude"/>\n                        <field name="presenly_radius_meters" help="Maximum accepted distance from this location; default 150 meters."/>\n                        <field name="presenly_gps_accuracy_limit_meters" help="GPS readings less accurate than this limit are rejected."/>\n                    </group>\n                    <group string="Selfie Evidence">\n                        <field name="presenly_require_selfie_check_in"/>\n                        <field name="presenly_require_selfie_check_out"/>\n                    </group>\n                </group>\n                <div class="alert alert-warning" role="alert" invisible="presenly_is_geofence_ready">\n                    Geofence attendance is disabled until the work address has valid coordinates and positive radius and accuracy limits.\n                </div>\n                <separator string="Approval Routing"/>\n                <group name="presenly_location_approval_routing">\n                    <group>\n                        <field name="presenly_manager_id" widget="many2one_avatar_user" domain="[('active', '=', True), ('company_ids', 'in', company_id)]" help="Used only by Approval Steps whose Approver Source is Work Location Manager. The user must also have the Presenly Approver role."/>\n                    </group>\n                    <group>\n                        <div class="alert alert-info" role="alert">\n                            This manager is not an automatic approver. It is selected only when an Approval Step uses Work Location Manager. Use Approval Overrides only when this location needs a different route from the company default.\n                        </div>\n                    </group>\n                </group>\n            </xpath>\n        </data>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
