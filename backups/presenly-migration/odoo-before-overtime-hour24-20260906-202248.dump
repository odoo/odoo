676	32	\N	1	1	hr.leave.allocation.view.form	hr.leave.allocation	\N	form	hr_holidays/views/hr_leave_allocation_views.xml	primary	{"en_US": "<form string=\\"Allocation Request\\" duplicate=\\"false\\">\\n                <field name=\\"can_approve\\" invisible=\\"1\\"/>\\n                <field name=\\"validation_type\\" invisible=\\"1\\"/>\\n                <!--\\n                The following two lines are required so that the two fields are sent as part of the `vals_list`\\n                to the create method when the allocation is created. Otherwise, carried_over_days_expiration_date\\n                wouldn't be set and the days won't expire on that date.\\n                -->\\n                <field name=\\"expiring_carryover_days\\" invisible=\\"1\\"/>\\n                <field name=\\"carried_over_days_expiration_date\\" invisible=\\"1\\"/>\\n                <header>\\n                    <button string=\\"Approve\\" name=\\"action_approve\\" type=\\"object\\" class=\\"oe_highlight\\" invisible=\\"not can_approve or not id\\"/>\\n                    <button string=\\"Validate\\" name=\\"action_approve\\" invisible=\\"not can_validate or can_approve or not id\\" type=\\"object\\" class=\\"oe_highlight\\"/>\\n                    <button string=\\"Refuse\\" name=\\"action_refuse\\" type=\\"object\\" invisible=\\"not can_refuse or not id\\"/>\\n                    <field name=\\"state\\" widget=\\"statusbar\\" statusbar_visible=\\"confirm,validate,validate1\\" invisible=\\"validation_type != 'both'\\"/>\\n                    <field name=\\"state\\" widget=\\"statusbar\\" statusbar_visible=\\"confirm,validate\\" invisible=\\"validation_type == 'both'\\"/>\\n                </header>\\n                <sheet>\\n                    <div class=\\"oe_button_box\\" name=\\"button_box\\"/>\\n                    <div id=\\"title\\" class=\\"oe_title\\">\\n                        <h2><field name=\\"name\\" class=\\"w-100\\" placeholder=\\"e.g. Time Off type (From validity start to validity end / no limit)\\" invisible=\\"state != 'confirm'\\" readonly=\\"True\\" force_save=\\"True\\"/>\\n                        <field name=\\"name_validity\\" invisible=\\"state == 'confirm'\\"/></h2>\\n                    </div>\\n                    <group id=\\"full_group\\">\\n                        <group id=\\"alloc_left_col\\">\\n                            <field name=\\"is_name_custom\\" invisible=\\"1\\"/> <!-- needed for triggering reasons -->\\n                            <field name=\\"type_request_unit\\" invisible=\\"1\\"/>\\n                            <!-- Save already_accrued when creating record to avoid double allocation when cron runs -->\\n                            <field name=\\"already_accrued\\" invisible=\\"1\\"/>\\n                            <field name=\\"holiday_status_id\\" context=\\"{'employee_id':employee_id, 'default_date_from':current_date, 'request_type':'allocation'}\\" readonly=\\"state == 'validate'\\"/>\\n                            <field name=\\"allocation_type\\" widget=\\"radio\\" invisible=\\"1\\" readonly=\\"not is_officer or state == 'validate'\\"/>\\n                            <field name=\\"is_officer\\" invisible=\\"1\\"/>\\n                            <field name=\\"accrual_plan_id\\" invisible=\\"allocation_type == 'regular'\\" required=\\"allocation_type == 'accrual'\\" readonly=\\"not is_officer or state == 'validate'\\"/>\\n                            <div class=\\"o_td_label\\" name=\\"validity_label\\" invisible=\\"not is_officer\\">\\n                                <label for=\\"date_from\\" string=\\"Validity Period\\" invisible=\\"allocation_type == 'accrual' or state != 'confirm'\\"/>\\n                                <label for=\\"date_from\\" string=\\"Start Date\\" invisible=\\"allocation_type == 'regular'\\"/>\\n                            </div>\\n                            <div class=\\"o_row\\" name=\\"validity\\" invisible=\\"not is_officer\\">\\n                                <field name=\\"date_from\\" nolabel=\\"1\\" readonly=\\"allocation_type == 'accrual' and state != 'confirm'\\" invisible=\\"allocation_type == 'regular' and state != 'confirm'\\"/>\\n                                <i class=\\"fa fa-long-arrow-right mx-2\\" aria-label=\\"Arrow icon\\" title=\\"Arrow\\" invisible=\\"allocation_type == 'accrual' or state != 'confirm'\\"/>\\n                                <label class=\\"mx-2\\" for=\\"date_to\\" string=\\"Run until\\" invisible=\\"allocation_type == 'regular'\\"/>\\n                                <field name=\\"date_to\\" nolabel=\\"1\\" placeholder=\\"No Limit\\" readonly=\\"allocation_type == 'accrual' and state != 'confirm'\\" invisible=\\"allocation_type == 'regular' and state != 'confirm'\\"/>\\n                                <div id=\\"no_limit_label\\" class=\\"oe_read_only\\" invisible=\\"not id or date_to or state != 'confirm'\\">No limit</div>\\n                            </div>\\n                            <div colspan=\\"2\\" class=\\"oe_row alert alert-warning my-2\\" role=\\"alert\\" invisible=\\"id or not date_to or not (date_to &lt; context_today().strftime('%Y-%m-%d')) or (date_from and (date_to &lt; date_from))\\">\\n                                <span>The allocated days cannot be used, because the allocation is set to finish in the past.</span>\\n                            </div>\\n                            <field name=\\"number_of_days\\" invisible=\\"1\\"/>\\n                            <div class=\\"o_td_label\\">\\n                                <label for=\\"number_of_days_display\\" string=\\"Allocation\\" readonly=\\"allocation_type == 'accrual' or state == 'validate'\\"/>\\n                            </div>\\n                            <div name=\\"duration_display\\">\\n                                <field name=\\"number_of_days_display\\" nolabel=\\"1\\" style=\\"width: 6ch;\\" invisible=\\"type_request_unit == 'hour'\\" readonly=\\"state != 'confirm' and not is_officer\\"/>\\n                                <field name=\\"number_of_hours_display\\" nolabel=\\"1\\" style=\\"width: 6ch;\\" invisible=\\"type_request_unit != 'hour'\\" readonly=\\"state != 'confirm' and not is_officer\\"/>\\n                                <span class=\\"ml8\\" invisible=\\"type_request_unit == 'hour'\\">Days</span>\\n                                <span class=\\"ml8\\" invisible=\\"type_request_unit != 'hour'\\">Hours</span>\\n                            </div>\\n                        </group>\\n                        <group name=\\"alloc_right_col\\">\\n                            <field name=\\"employee_id\\" invisible=\\"1\\" readonly=\\"state in ['refuse', 'validate']\\"/>\\n                        </group>\\n                    </group>\\n                    <field name=\\"notes\\" nolabel=\\"1\\" placeholder=\\"Add a reason...\\" readonly=\\"state not in ['confirm']\\"/>\\n                </sheet>\\n                <chatter/>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Allocation Request" duplicate="false">\n                <field name="can_approve" invisible="1"/>\n                <field name="validation_type" invisible="1"/>\n                <!--\n                The following two lines are required so that the two fields are sent as part of the `vals_list`\n                to the create method when the allocation is created. Otherwise, carried_over_days_expiration_date\n                wouldn't be set and the days won't expire on that date.\n                -->\n                <field name="expiring_carryover_days" invisible="1"/>\n                <field name="carried_over_days_expiration_date" invisible="1"/>\n                <header>\n                    <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="not can_approve or not id"/>\n                    <button string="Validate" name="action_approve" invisible="not can_validate or can_approve or not id" type="object" class="oe_highlight"/>\n                    <button string="Refuse" name="action_refuse" type="object" invisible="not can_refuse or not id"/>\n                    <field name="state" widget="statusbar" statusbar_visible="confirm,validate,validate1" invisible="validation_type != 'both'"/>\n                    <field name="state" widget="statusbar" statusbar_visible="confirm,validate" invisible="validation_type == 'both'"/>\n                </header>\n                <sheet>\n                    <div class="oe_button_box" name="button_box"/>\n                    <div id="title" class="oe_title">\n                        <h2><field name="name" class="w-100" placeholder="e.g. Time Off type (From validity start to validity end / no limit)" invisible="state != 'confirm'" readonly="True" force_save="True"/>\n                        <field name="name_validity" invisible="state == 'confirm'"/></h2>\n                    </div>\n                    <group id="full_group">\n                        <group id="alloc_left_col">\n                            <field name="is_name_custom" invisible="1"/> <!-- needed for triggering reasons -->\n                            <field name="type_request_unit" invisible="1"/>\n                            <!-- Save already_accrued when creating record to avoid double allocation when cron runs -->\n                            <field name="already_accrued" invisible="1"/>\n                            <field name="holiday_status_id" context="{'employee_id':employee_id, 'default_date_from':current_date, 'request_type':'allocation'}" readonly="state == 'validate'"/>\n                            <field name="allocation_type" widget="radio" invisible="1" readonly="not is_officer or state == 'validate'"/>\n                            <field name="is_officer" invisible="1"/>\n                            <field name="accrual_plan_id" invisible="allocation_type == 'regular'" required="allocation_type == 'accrual'" readonly="not is_officer or state == 'validate'"/>\n                            <div class="o_td_label" name="validity_label" invisible="not is_officer">\n                                <label for="date_from" string="Validity Period" invisible="allocation_type == 'accrual' or state != 'confirm'"/>\n                                <label for="date_from" string="Start Date" invisible="allocation_type == 'regular'"/>\n                            </div>\n                            <div class="o_row" name="validity" invisible="not is_officer">\n                                <field name="date_from" nolabel="1" readonly="allocation_type == 'accrual' and state != 'confirm'" invisible="allocation_type == 'regular' and state != 'confirm'"/>\n                                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow" invisible="allocation_type == 'accrual' or state != 'confirm'"/>\n                                <label class="mx-2" for="date_to" string="Run until" invisible="allocation_type == 'regular'"/>\n                                <field name="date_to" nolabel="1" placeholder="No Limit" readonly="allocation_type == 'accrual' and state != 'confirm'" invisible="allocation_type == 'regular' and state != 'confirm'"/>\n                                <div id="no_limit_label" class="oe_read_only" invisible="not id or date_to or state != 'confirm'">No limit</div>\n                            </div>\n                            <div colspan="2" class="oe_row alert alert-warning my-2" role="alert" invisible="id or not date_to or not (date_to &lt; context_today().strftime('%Y-%m-%d')) or (date_from and (date_to &lt; date_from))">\n                                <span>The allocated days cannot be used, because the allocation is set to finish in the past.</span>\n                            </div>\n                            <field name="number_of_days" invisible="1"/>\n                            <div class="o_td_label">\n                                <label for="number_of_days_display" string="Allocation" readonly="allocation_type == 'accrual' or state == 'validate'"/>\n                            </div>\n                            <div name="duration_display">\n                                <field name="number_of_days_display" nolabel="1" style="width: 6ch;" invisible="type_request_unit == 'hour'" readonly="state != 'confirm' and not is_officer"/>\n                                <field name="number_of_hours_display" nolabel="1" style="width: 6ch;" invisible="type_request_unit != 'hour'" readonly="state != 'confirm' and not is_officer"/>\n                                <span class="ml8" invisible="type_request_unit == 'hour'">Days</span>\n                                <span class="ml8" invisible="type_request_unit != 'hour'">Hours</span>\n                            </div>\n                        </group>\n                        <group name="alloc_right_col">\n                            <field name="employee_id" invisible="1" readonly="state in ['refuse', 'validate']"/>\n                        </group>\n                    </group>\n                    <field name="notes" nolabel="1" placeholder="Add a reason..." readonly="state not in ['confirm']"/>\n                </sheet>\n                <chatter/>\n            </form>\n        	f	t	2026-09-05 15:59:49.146439	2026-09-05 15:59:49.146439	f
