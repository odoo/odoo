1048	16	\N	1	1	Left Text	\N	mass_mailing.s_mail_block_header_text_social	qweb	mass_mailing/views/snippets_themes.xml	primary	{"en_US": "<t name=\\"Left Text\\" t-name=\\"mass_mailing.s_mail_block_header_text_social\\">\\n    <section class=\\"s_header_text_social o_mail_block_header_text_social o_mail_snippet_general pt32 pb32\\" data-name=\\"Left Text\\">\\n        <div class=\\"container\\">\\n            <div class=\\"row\\">\\n                <div class=\\"col-md-6 col-12 pt16 pb16\\">\\n                    <h1><span class=\\"h2-fs\\" t-out=\\"company_id.partner_id.name\\"/></h1>\\n                </div>\\n                <div class=\\"col-md-6 col-12 o_mail_header_social\\" style=\\"text-align: right;\\">\\n                    <t t-call=\\"mass_mailing.social_links\\"/>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n</t>"}	<?xml version="1.0"?>\n<t name="Left Text" t-name="mass_mailing.s_mail_block_header_text_social">\n    <section class="s_header_text_social o_mail_block_header_text_social o_mail_snippet_general pt32 pb32" data-name="Left Text">\n        <div class="container">\n            <div class="row">\n                <div class="col-md-6 col-12 pt16 pb16">\n                    <h1><span class="h2-fs" t-out="company_id.partner_id.name"/></h1>\n                </div>\n                <div class="col-md-6 col-12 o_mail_header_social" style="text-align: right;">\n                    <t t-call="mass_mailing.social_links"/>\n                </div>\n            </div>\n        </div>\n    </section>\n</t>\n\n	f	t	2026-09-05 15:59:52.12261	2026-09-05 15:59:52.12261	f
