          <field name=\\"state_id\\" class=\\"o_address_state\\" placeholder=\\"State\\" options=\\"{&quot;no_open&quot;: True}\\"/>\\n                                        <field name=\\"zip\\" placeholder=\\"ZIP\\" class=\\"o_address_zip\\"/>\\n                                        <field name=\\"country_id\\" placeholder=\\"Country\\" class=\\"o_address_country\\" options=\\"{&quot;no_open&quot;: True, &quot;no_create&quot;: True}\\"/>\\n                                    </div>\\n                                    <field name=\\"vat\\"/>\\n                                    <field name=\\"company_registry_placeholder\\" invisible=\\"1\\"/> <!-- Needed for the placeholder widget -->\\n                                    <field name=\\"company_registry\\" options=\\"{'placeholder_field': 'company_registry_placeholder'}\\"/>\\n                                    <field name=\\"currency_id\\" options=\\"{'no_create': True, 'no_open': True}\\" id=\\"company_currency\\" context=\\"{'active_test': False}\\"/>\\n                                </group>\\n                                <group>\\n                                    <field name=\\"phone\\" class=\\"o_force_ltr\\"/>\\n                                    <field name=\\"email\\"/>\\n                                    <field name=\\"website\\" string=\\"Website\\" widget=\\"url\\" placeholder=\\"e.g. https://www.odoo.com\\"/>\\n                                    <field name=\\"parent_id\\" groups=\\"base.group_no_one\\"/>\\n                                    <field name=\\"color\\" widget=\\"color_picker\\"/>\\n                                </group>\\n                                <group name=\\"social_media\\"/>\\n                            </group>\\n                        </page>\\n                        <page string=\\"Branches\\" name=\\"branches\\">\\n                            <field name=\\"child_ids\\" nolabel=\\"1\\" context=\\"{'default_parent_id': id}\\"/>\\n                        </page>\\n                    </notebook>\\n                    </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Company" duplicate="0">\n                  <sheet>\n                    <div class="oe_button_box" name="button_box">\n                        <button class="oe_stat_button" name="action_all_company_branches" type="object" invisible="not all_child_ids" icon="fa-sitemap" string="Branches"/>\n                    </div>\n                    <div class="d-flex gap-2">\n                        <field name="logo" widget="contact_image" class="oe_avatar text-start float-none" nolabel="1" options="{'size': [100,100], 'img_class': 'rounded-4'}"/>\n                        <div class="oe_title">\n                            <label for="name"/>\n                            <h1>\n                                <field name="name" placeholder="e.g. My Company"/>\n                            </h1>\n                        </div>\n                    </div>\n                    <notebook colspan="4">\n                        <page string="General Information" name="general_info">\n                            <group>\n                                <group>\n                                    <field name="partner_id" string="Contact" readonly="1" required="0" groups="base.group_no_one"/>\n                                    <label for="street" string="Address"/>\n                                    <div class="o_address_format">\n                                        <field name="street" placeholder="Street..." class="o_address_street"/>\n                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>\n                                        <field name="city" placeholder="City" class="o_address_city"/>\n                                        <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}"/>\n                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>\n                                        <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>\n                                    </div>\n                                    <field name="vat"/>\n                                    <field name="company_registry_placeholder" invisible="1"/> <!-- Needed for the placeholder widget -->\n                                    <field name="company_registry" options="{'placeholder_field': 'company_registry_placeholder'}"/>\n                                    <field name="currency_id" options="{'no_create': True, 'no_open': True}" id="company_currency" context="{'active_test': False}"/>\n                                </group>\n                                <group>\n                                    <field name="phone" class="o_force_ltr"/>\n                                    <field name="email"/>\n                                    <field name="website" string="Website" widget="url" placeholder="e.g. https://www.odoo.com"/>\n                                    <field name="parent_id" groups="base.group_no_one"/>\n                                    <field name="color" widget="color_picker"/>\n                                </group>\n                                <group name="social_media"/>\n                            </group>\n                        </page>\n                        <page string="Branches" name="branches">\n                            <field name="child_ids" nolabel="1" context="{'default_parent_id': id}"/>\n                        </page>\n                    </notebook>\n                    </sheet>\n                </form>\n            	f	t	2026-09-05 15:58:45.179291	2026-09-05 15:58:45.179291	\N
