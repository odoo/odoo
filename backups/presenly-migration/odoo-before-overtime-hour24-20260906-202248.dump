786	16	\N	1	1	presenly.work.location.schedule.form	presenly.work.location.schedule	\N	form	presenly/views/presenly_schedule_views.xml	primary	{"en_US": "<form string=\\"Work Location Schedule\\">\\n                <sheet>\\n                    <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                    <div class=\\"oe_title\\">\\n                        <label for=\\"name\\" string=\\"Location Slot\\"/>\\n                        <h1><field name=\\"name\\" readonly=\\"1\\"/></h1>\\n                    </div>\\n                    <group>\\n                        <group string=\\"Employee and Location\\">\\n                            <field name=\\"employee_id\\" widget=\\"many2one_avatar_employee\\"/>\\n                            <field name=\\"company_id\\" invisible=\\"1\\"/>\\n                            <field name=\\"calendar_two_weeks\\" invisible=\\"1\\"/>\\n                            <field name=\\"calendar_id\\" readonly=\\"1\\"/>\\n                            <field name=\\"work_location_id\\" domain=\\"[('active', '=', True), ('company_id', '=', company_id)]\\" options=\\"{'no_create_edit': True}\\"/>\\n                            <field name=\\"active\\" invisible=\\"1\\"/>\\n                        </group>\\n                        <group string=\\"When\\">\\n                            <field name=\\"schedule_type\\" widget=\\"radio\\" options=\\"{'horizontal': true}\\"/>\\n                            <field name=\\"weekday\\" invisible=\\"schedule_type != 'weekly'\\"/>\\n                            <field name=\\"week_type\\" invisible=\\"schedule_type != 'weekly' or not calendar_two_weeks\\" required=\\"schedule_type == 'weekly' and calendar_two_weeks\\"/>\\n                            <field name=\\"schedule_date\\" invisible=\\"schedule_type != 'date'\\" required=\\"schedule_type == 'date'\\"/>\\n                        </group>\\n                    </group>\\n                    <group>\\n                        <group string=\\"Time Slot\\">\\n                            <field name=\\"hour_from\\" widget=\\"float_time\\"/>\\n                            <field name=\\"hour_to\\" widget=\\"float_time\\"/>\\n                            <field name=\\"check_in_tolerance_minutes\\"/>\\n                        </group>\\n                        <group string=\\"Weekly Validity\\" invisible=\\"schedule_type != 'weekly'\\">\\n                            <field name=\\"date_start\\" widget=\\"daterange\\" options=\\"{'end_date_field': 'date_end'}\\"/>\\n                            <field name=\\"date_end\\" invisible=\\"1\\"/>\\n                        </group>\\n                    </group>\\n                    <group string=\\"Working Hours Integration\\">\\n                        <field name=\\"calendar_sync_state\\" widget=\\"badge\\" decoration-success=\\"calendar_sync_state in ('valid', 'flexible')\\" decoration-danger=\\"calendar_sync_state in ('outside', 'no_calendar')\\"/>\\n                        <field name=\\"calendar_sync_message\\" readonly=\\"1\\" nolabel=\\"1\\"/>\\n                    </group>\\n                    <div class=\\"alert alert-danger\\" role=\\"alert\\" invisible=\\"calendar_sync_state not in ('outside', 'no_calendar')\\">\\n                        This location slot cannot be used by attendance until it fits the Employee Working Hours.\\n                    </div>\\n                    <div class=\\"alert alert-info\\" role=\\"alert\\">\\n                        Specific Date slots replace Weekly slots for that date. Working Hours controls when the employee works; this slot assigns the physical Work Location within that time.\\n                    </div>\\n                </sheet>\\n            </form>"}	<form string="Work Location Schedule">\n                <sheet>\n                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                    <div class="oe_title">\n                        <label for="name" string="Location Slot"/>\n                        <h1><field name="name" readonly="1"/></h1>\n                    </div>\n                    <group>\n                        <group string="Employee and Location">\n                            <field name="employee_id" widget="many2one_avatar_employee"/>\n                            <field name="company_id" invisible="1"/>\n                            <field name="calendar_two_weeks" invisible="1"/>\n                            <field name="calendar_id" readonly="1"/>\n                            <field name="work_location_id" domain="[('active', '=', True), ('company_id', '=', company_id)]" options="{'no_create_edit': True}"/>\n                            <field name="active" invisible="1"/>\n                        </group>\n                        <group string="When">\n                            <field name="schedule_type" widget="radio" options="{'horizontal': true}"/>\n                            <field name="weekday" invisible="schedule_type != 'weekly'"/>\n                            <field name="week_type" invisible="schedule_type != 'weekly' or not calendar_two_weeks" required="schedule_type == 'weekly' and calendar_two_weeks"/>\n                            <field name="schedule_date" invisible="schedule_type != 'date'" required="schedule_type == 'date'"/>\n                        </group>\n                    </group>\n                    <group>\n                        <group string="Time Slot">\n                            <field name="hour_from" widget="float_time"/>\n                            <field name="hour_to" widget="float_time"/>\n                            <field name="check_in_tolerance_minutes"/>\n                        </group>\n                        <group string="Weekly Validity" invisible="schedule_type != 'weekly'">\n                            <field name="date_start" widget="daterange" options="{'end_date_field': 'date_end'}"/>\n                            <field name="date_end" invisible="1"/>\n                        </group>\n                    </group>\n                    <group string="Working Hours Integration">\n                        <field name="calendar_sync_state" widget="badge" decoration-success="calendar_sync_state in ('valid', 'flexible')" decoration-danger="calendar_sync_state in ('outside', 'no_calendar')"/>\n                        <field name="calendar_sync_message" readonly="1" nolabel="1"/>\n                    </group>\n                    <div class="alert alert-danger" role="alert" invisible="calendar_sync_state not in ('outside', 'no_calendar')">\n                        This location slot cannot be used by attendance until it fits the Employee Working Hours.\n                    </div>\n                    <div class="alert alert-info" role="alert">\n                        Specific Date slots replace Weekly slots for that date. Working Hours controls when the employee works; this slot assigns the physical Work Location within that time.\n                    </div>\n                </sheet>\n            </form>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
