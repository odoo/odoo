--
-- Name: CONSTRAINT survey_survey_attempts_limit_check ON survey_survey; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_survey_attempts_limit_check ON public.survey_survey IS 'CHECK( (is_attempts_limited=False) OR (attempts_limit is not null AND attempts_limit > 0) )';


--
-- Name: CONSTRAINT survey_survey_certification_check ON survey_survey; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_survey_certification_check ON public.survey_survey IS 'CHECK( scoring_type!=''no_scoring'' OR certification=False )';


--
-- Name: CONSTRAINT survey_survey_scoring_success_min_check ON survey_survey; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_survey_scoring_success_min_check ON public.survey_survey IS 'CHECK( scoring_success_min IS NULL OR (scoring_success_min>=0 AND scoring_success_min<=100) )';


--
-- Name: CONSTRAINT survey_survey_session_speed_rating_has_time_limit ON survey_survey; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_survey_session_speed_rating_has_time_limit ON public.survey_survey IS 'CHECK (session_speed_rating != TRUE OR session_speed_rating_time_limit IS NOT NULL AND session_speed_rating_time_limit > 0)';


--
-- Name: CONSTRAINT survey_survey_time_limit_check ON survey_survey; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_survey_time_limit_check ON public.survey_survey IS 'CHECK( (is_time_limited=False) OR (time_limit is not null AND time_limit > 0) )';


