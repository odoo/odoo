      <separator/>\n                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>\n                <filter name="inprogress" string="Running" domain="[                         '|',                             ('state', '=', 'inprogress'),                             '&amp;',                                 ('state', 'in', ('done', 'failed')),                                 ('end_date', '&gt;=', 'today')                     ]"/>\n                <filter name="closed" string="Done" domain="[                         ('state', 'in', ('reached', 'failed')),                         '|',                             ('end_date', '=', False),                             ('end_date', '&lt;', 'today')                     ]"/>\n                <separator/>\n\n                <field name="user_id"/>\n                <field name="definition_id"/>\n                <field name="challenge_id"/>\n                <group>\n                    <filter name="group_by_user" string="User" domain="[]" context="{'group_by':'user_id'}"/>\n                    <filter name="group_by_definition" string="Goal Definition" domain="[]" context="{'group_by':'definition_id'}"/>\n                    <filter string="State" name="state" domain="[]" context="{'group_by':'state'}"/>\n                    <filter string="End Date" name="enddate" domain="[]" context="{'group_by':'end_date'}"/>\n                </group>\n            </search>\n        	f	t	2026-09-05 15:59:51.079296	2026-09-05 15:59:51.079296	f
864	16	\N	1	1	Goal Kanban View	gamification.goal	\N	kanban	gamification/views/gamification_goal_views.xml	primary	{"en_US": "<kanban highlight_color=\\"color\\" create=\\"false\\">\\n                <field name=\\"state\\"/>\\n                <field name=\\"color\\"/>\\n                <field name=\\"definition_condition\\"/>\\n                <field name=\\"definition_suffix\\"/>\\n                <field name=\\"definition_display\\"/>\\n                <field name=\\"last_update\\"/>\\n                <templates>\\n                    <t t-name=\\"card\\" class=\\"text-center\\">\\n                        <field class=\\"fw-bold fs-4\\" name=\\"definition_id\\"/>\\n                        <div class=\\"d-flex justify-content-center mt-3\\">\\n                            <field class=\\"o_image_24_cover me-1 rounded\\" name=\\"user_id\\" widget=\\"image\\" options=\\"{'preview_image': 'avatar_128'}\\"/>\\n                            <field name=\\"user_id\\" class=\\"fw-bold\\"/>\\n                        </div>\\n                        <div class=\\"pt-3 fs-1 fw-bolder\\">\\n                            <t t-if=\\"record.definition_display.raw_value == 'boolean'\\">\\n                                <t t-if=\\"record.state.raw_value=='reached'\\"><i role=\\"img\\" class=\\"text-success fa fa-check fa-3x\\" title=\\"Goal Reached\\" aria-label=\\"Goal Reached\\"/></t>\\n                                <t t-if=\\"record.state.raw_value=='inprogress'\\"><i role=\\"img\\" class=\\"text-body fa fa-clock-o fa-3x\\" title=\\"Goal in Progress\\" aria-label=\\"Goal in Progress\\"/></t>\\n                                <t t-if=\\"record.state.raw_value=='failed'\\"><i role=\\"img\\" class=\\"text-danger fa fa-times fa-3x\\" title=\\"Goal Failed\\" aria-label=\\"Goal Failed\\"/></t>\\n                            </t>\\n                            <t t-if=\\"record.definition_display.raw_value == 'progress'\\">\\n                                <t t-if=\\"record.definition_condition.raw_value =='higher'\\">\\n                                    <field name=\\"current\\" widget=\\"gauge\\" options=\\"{'max_field': 'target_goal', 'label_field': 'definition_suffix', 'style': 'width:160px; height: 120px;'}\\"/>\\n                                </t>\\n                                <t t-if=\\"record.definition_condition.raw_value != 'higher'\\">\\n                                    <field class=\\"#{record.current.raw_value == record.target_goal.raw_value+1 ? 'text-warning' : record.current.raw_value &gt; record.target_goal.raw_value ? 'text-danger' : 'text-success'}\\" name=\\"current\\"/>\\n                                    <em>Target: less than <field name=\\"target_goal\\"/></em>\\n                                </t>\\n                            </t>\\n                        </div>\\n                        <p>\\n                            <t t-if=\\"record.start_date.value\\">\\n                                From <field name=\\"start_date\\"/>\\n                            </t>\\n                            <t t-if=\\"record.end_date.value\\">\\n                                To <field name=\\"end_date\\"/>\\n                            </t>\\n                        </p>\\n                    </t>\\n                </templates>\\n            </kanban>"}	<?xml version="1.0"?>\n<kanban highlight_color="color" create="false">\n                <field name="state"/>\n                <field name="color"/>\n                <field name="definition_condition"/>\n                <field name="definition_suffix"/>\n                <field name="definition_display"/>\n                <field name="last_update"/>\n                <templates>\n                    <t t-name="card" class="text-center">\n                        <field class="fw-bold fs-4" name="definition_id"/>\n                        <div class="d-flex justify-content-center mt-3">\n                            <field class="o_image_24_cover me-1 rounded" name="user_id" widget="image" options="{'preview_image': 'avatar_128'}"/>\n                            <field name="user_id" class="fw-bold"/>\n                        </div>\n                        <div class="pt-3 fs-1 fw-bolder">\n                            <t t-if="record.definition_display.raw_value == 'boolean'">\n                                <t t-if="record.state.raw_value=='reached'"><i role="img" class="text-success fa fa-check fa-3x" title="Goal Reached" aria-label="Goal Reached"/></t>\n                                <t t-if="record.state.raw_value=='inprogress'"><i role="img" class="text-body fa fa-clock-o fa-3x" title="Goal in Progress" aria-label="Goal in Progress"/></t>\n                                <t t-if="record.state.raw_value=='failed'"><i role="img" class="text-danger fa fa-times fa-3x" title="Goal Failed" aria-label="Goal Failed"/></t>\n                            </t>\n                            <t t-if="record.definition_display.raw_value == 'progress'">\n                                <t t-if="record.definition_condition.raw_value =='higher'">\n                                    <field name="current" widget="gauge" options="{'max_field': 'target_goal', 'label_field': 'definition_suffix', 'style': 'width:160px; height: 120px;'}"/>\n                                </t>\n                                <t t-if="record.definition_condition.raw_value != 'higher'">\n                                    <field class="#{record.current.raw_value == record.target_goal.raw_value+1 ? 'text-warning' : record.current.raw_value &gt; record.target_goal.raw_value ? 'text-danger' : 'text-success'}" name="current"/>\n                                    <em>Target: less than <field name="target_goal"/></em>\n                                </t>\n                            </t>\n                        </div>\n                        <p>\n                            <t t-if="record.start_date.value">\n                                From <field name="start_date"/>\n                            </t>\n                            <t t-if="record.end_date.value">\n                                To <field name="end_date"/>\n                            </t>\n                        </p>\n                    </t>\n                </templates>\n            </kanban>\n        	f	t	2026-09-05 15:59:51.079296	2026-09-05 15:59:51.079296	f
