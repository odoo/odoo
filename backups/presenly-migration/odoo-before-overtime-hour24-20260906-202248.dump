792	16	\N	1	1	presenly.permission.form	presenly.permission	\N	form	presenly/views/presenly_permission_views.xml	primary	{"en_US": "<form string=\\"Permission / Dispensation Request\\" duplicate=\\"false\\">\\n                <header>\\n                    <button name=\\"action_submit\\" type=\\"object\\" string=\\"Submit\\" class=\\"oe_highlight\\" invisible=\\"not can_submit\\"/>\\n                    <button name=\\"action_approve\\" type=\\"object\\" string=\\"Approve\\" class=\\"oe_highlight\\" invisible=\\"not can_approve\\"/>\\n                    <button name=\\"action_open_reject_wizard\\" type=\\"object\\" string=\\"Reject\\" invisible=\\"not can_reject\\"/>\\n                    <button name=\\"action_cancel\\" type=\\"object\\" string=\\"Cancel\\" invisible=\\"not can_cancel or not id\\"/>\\n                    <field name=\\"state\\" widget=\\"statusbar\\" statusbar_visible=\\"draft,submitted,approved\\"/>\\n                </header>\\n                <sheet>\\n                    <field name=\\"can_submit\\" invisible=\\"1\\"/>\\n                    <field name=\\"can_approve\\" invisible=\\"1\\"/>\\n                    <field name=\\"can_reject\\" invisible=\\"1\\"/>\\n                    <field name=\\"can_cancel\\" invisible=\\"1\\"/>\\n                    <field name=\\"can_edit_request\\" invisible=\\"1\\"/>\\n                    <field name=\\"is_request_owner\\" invisible=\\"1\\"/>\\n                    <field name=\\"requires_attachment\\" invisible=\\"1\\"/>\\n                    <field name=\\"allowed_request_mode\\" invisible=\\"1\\"/>\\n\\n                    <widget name=\\"web_ribbon\\" title=\\"Approved\\" bg_color=\\"text-bg-success\\" invisible=\\"state != 'approved'\\"/>\\n                    <widget name=\\"web_ribbon\\" title=\\"Rejected\\" bg_color=\\"text-bg-danger\\" invisible=\\"state != 'rejected'\\"/>\\n                    <widget name=\\"web_ribbon\\" title=\\"Cancelled\\" bg_color=\\"text-bg-secondary\\" invisible=\\"state != 'cancelled'\\"/>\\n\\n                    <div class=\\"oe_title\\">\\n                        <label for=\\"name\\" string=\\"Permission Request\\"/>\\n                        <h1><field name=\\"name\\" readonly=\\"1\\"/></h1>\\n                    </div>\\n\\n                    <div class=\\"alert alert-info d-flex align-items-center\\" role=\\"alert\\" invisible=\\"not requires_attachment or state != 'draft'\\">\\n                        <i class=\\"fa fa-info-circle me-2\\" title=\\"Information\\"/>\\n                        Supporting document is required for this permission type.\\n                    </div>\\n\\n                    <group>\\n                        <group string=\\"Request\\">\\n                            <field name=\\"employee_id\\" widget=\\"many2one_avatar_employee\\" readonly=\\"not can_edit_request or is_request_owner\\" options=\\"{'no_create': True, 'no_open': True}\\"/>\\n                            <field name=\\"permission_type_id\\" readonly=\\"not can_edit_request\\" domain=\\"[('is_complete', '=', True), ('active', '=', True), ('company_id', '=', company_id)]\\" options=\\"{'no_create': True, 'no_open': True}\\"/>\\n                            <field name=\\"work_location_id\\" readonly=\\"not can_edit_request\\" domain=\\"[('active', '=', True), ('company_id', '=', company_id)]\\" options=\\"{'no_create': True, 'no_open': True}\\"/>\\n                            <field name=\\"company_id\\" groups=\\"base.group_multi_company\\" readonly=\\"1\\"/>\\n                        </group>\\n                        <group string=\\"Approval\\">\\n                            <field name=\\"approval_progress_display\\" string=\\"Progress\\" readonly=\\"1\\"/>\\n                            <field name=\\"current_approver_ids\\" widget=\\"many2many_tags\\" readonly=\\"1\\" invisible=\\"state != 'submitted'\\" options=\\"{'no_open': True}\\"/>\\n                            <field name=\\"presenly_approval_request_id\\" string=\\"Approval Journey\\" readonly=\\"1\\" invisible=\\"not presenly_approval_request_id\\"/>\\n                            <field name=\\"paid_status\\" readonly=\\"1\\"/>\\n                            <field name=\\"affects_attendance\\" readonly=\\"1\\"/>\\n                        </group>\\n                    </group>\\n\\n                    <group>\\n                        <group string=\\"Duration\\">\\n                            <field name=\\"request_mode\\" widget=\\"radio\\" options=\\"{'horizontal': true}\\" readonly=\\"not can_edit_request\\" invisible=\\"allowed_request_mode != 'both'\\"/>\\n                            <label for=\\"date_from\\" string=\\"Date\\"/>\\n                            <div class=\\"o_row\\">\\n                                <field name=\\"date_from\\" widget=\\"daterange\\" options=\\"{'end_date_field': 'date_to', 'always_range': true}\\" readonly=\\"not can_edit_request\\"/>\\n                                <field name=\\"date_to\\" invisible=\\"1\\"/>\\n                                <span class=\\"text-muted\\">(<field name=\\"duration_display\\" readonly=\\"1\\" class=\\"oe_inline\\"/>)</span>\\n                            </div>\\n                            <label for=\\"hour_from\\" string=\\"Hours\\" invisible=\\"request_mode != 'hours'\\"/>\\n                            <div class=\\"o_row\\" invisible=\\"request_mode != 'hours'\\">\\n                                <field name=\\"hour_from\\" widget=\\"float_time\\" readonly=\\"not can_edit_request\\" class=\\"oe_inline\\"/>\\n                                <span class=\\"mx-2\\">to</span>\\n                                <field name=\\"hour_to\\" widget=\\"float_time\\" readonly=\\"not can_edit_request\\" class=\\"oe_inline\\"/>\\n                            </div>\\n                        </group>\\n                        <group string=\\"Details\\">\\n                            <field name=\\"reason\\" widget=\\"text\\" readonly=\\"not can_edit_request\\" placeholder=\\"Describe the reason for this request...\\"/>\\n                            <field name=\\"rejection_reason\\" readonly=\\"1\\" invisible=\\"not rejection_reason\\"/>\\n                        </group>\\n                    </group>\\n\\n                    <group string=\\"Supporting Documents\\">\\n                        <field name=\\"attachment_ids\\" widget=\\"many2many_binary\\" nolabel=\\"1\\" readonly=\\"not can_edit_request\\" colspan=\\"2\\"/>\\n                    </group>\\n\\n                    <group string=\\"Approval Journey\\" invisible=\\"not presenly_approval_request_id\\">\\n                        <field name=\\"presenly_approval_step_ids\\" nolabel=\\"1\\" readonly=\\"1\\" colspan=\\"2\\">\\n                            <list create=\\"0\\" edit=\\"0\\" delete=\\"0\\" decoration-info=\\"state == 'pending'\\" decoration-success=\\"state == 'approved'\\" decoration-danger=\\"state == 'rejected'\\" decoration-muted=\\"state in ('waiting', 'cancelled')\\">\\n                                <field name=\\"level\\"/>\\n                                <field name=\\"name\\"/>\\n                                <field name=\\"assigned_user_ids\\" widget=\\"many2many_tags\\"/>\\n                                <field name=\\"state\\" widget=\\"badge\\" decoration-info=\\"state == 'pending'\\" decoration-success=\\"state == 'approved'\\" decoration-danger=\\"state == 'rejected'\\" decoration-muted=\\"state in ('waiting', 'cancelled')\\"/>\\n                                <field name=\\"decision_user_id\\" widget=\\"many2one_avatar_user\\" optional=\\"show\\"/>\\n                                <field name=\\"decision_date\\" optional=\\"show\\"/>\\n                                <field name=\\"decision_note\\" optional=\\"hide\\"/>\\n                            </list>\\n                        </field>\\n                    </group>\\n                </sheet>\\n                <chatter reload_on_post=\\"True\\" reload_on_attachment=\\"True\\"/>\\n            </form>"}	<form string="Permission / Dispensation Request" duplicate="false">\n                <header>\n                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="not can_submit"/>\n                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="not can_approve"/>\n                    <button name="action_open_reject_wizard" type="object" string="Reject" invisible="not can_reject"/>\n                    <button name="action_cancel" type="object" string="Cancel" invisible="not can_cancel or not id"/>\n                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>\n                </header>\n                <sheet>\n                    <field name="can_submit" invisible="1"/>\n                    <field name="can_approve" invisible="1"/>\n                    <field name="can_reject" invisible="1"/>\n                    <field name="can_cancel" invisible="1"/>\n                    <field name="can_edit_request" invisible="1"/>\n                    <field name="is_request_owner" invisible="1"/>\n                    <field name="requires_attachment" invisible="1"/>\n                    <field name="allowed_request_mode" invisible="1"/>\n\n                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>\n                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>\n                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>\n\n                    <div class="oe_title">\n                        <label for="name" string="Permission Request"/>\n                        <h1><field name="name" readonly="1"/></h1>\n                    </div>\n\n                    <div class="alert alert-info d-flex align-items-center" role="alert" invisible="not requires_attachment or state != 'draft'">\n                        <i class="fa fa-info-circle me-2" title="Information"/>\n                        Supporting document is required for this permission type.\n                    </div>\n\n                    <group>\n                        <group string="Request">\n                            <field name="employee_id" widget="many2one_avatar_employee" readonly="not can_edit_request or is_request_owner" options="{'no_create': True, 'no_open': True}"/>\n                            <field name="permission_type_id" readonly="not can_edit_request" domain="[('is_complete', '=', True), ('active', '=', True), ('company_id', '=', company_id)]" options="{'no_create': True, 'no_open': True}"/>\n                            <field name="work_location_id" readonly="not can_edit_request" domain="[('active', '=', True), ('company_id', '=', company_id)]" options="{'no_create': True, 'no_open': True}"/>\n                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>\n                        </group>\n                        <group string="Approval">\n                            <field name="approval_progress_display" string="Progress" readonly="1"/>\n                            <field name="current_approver_ids" widget="many2many_tags" readonly="1" invisible="state != 'submitted'" options="{'no_open': True}"/>\n                            <field name="presenly_approval_request_id" string="Approval Journey" readonly="1" invisible="not presenly_approval_request_id"/>\n                            <field name="paid_status" readonly="1"/>\n                            <field name="affects_attendance" readonly="1"/>\n                        </group>\n                    </group>\n\n                    <group>\n                        <group string="Duration">\n                            <field name="request_mode" widget="radio" options="{'horizontal': true}" readonly="not can_edit_request" invisible="allowed_request_mode != 'both'"/>\n                            <label for="date_from" string="Date"/>\n                            <div class="o_row">\n                                <field name="date_from" widget="daterange" options="{'end_date_field': 'date_to', 'always_range': true}" readonly="not can_edit_request"/>\n                                <field name="date_to" invisible="1"/>\n                                <span class="text-muted">(<field name="duration_display" readonly="1" class="oe_inline"/>)</span>\n                            </div>\n                            <label for="hour_from" string="Hours" invisible="request_mode != 'hours'"/>\n                            <div class="o_row" invisible="request_mode != 'hours'">\n                                <field name="hour_from" widget="float_time" readonly="not can_edit_request" class="oe_inline"/>\n                                <span class="mx-2">to</span>\n                                <field name="hour_to" widget="float_time" readonly="not can_edit_request" class="oe_inline"/>\n                            </div>\n                        </group>\n                        <group string="Details">\n                            <field name="reason" widget="text" readonly="not can_edit_request" placeholder="Describe the reason for this request..."/>\n                            <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>\n                        </group>\n                    </group>\n\n                    <group string="Supporting Documents">\n                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" readonly="not can_edit_request" colspan="2"/>\n                    </group>\n\n                    <group string="Approval Journey" invisible="not presenly_approval_request_id">\n                        <field name="presenly_approval_step_ids" nolabel="1" readonly="1" colspan="2">\n                            <list create="0"