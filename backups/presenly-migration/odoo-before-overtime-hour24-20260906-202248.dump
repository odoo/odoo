le_type': module_type, 'module_name':name}</attribute>\n                    <attribute name="type">object</attribute>\n                    <attribute name="name">more_info</attribute>\n                </xpath>\n            </data>	f	t	2026-09-05 15:58:48.295304	2026-09-05 15:58:48.295304	\N
