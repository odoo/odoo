ol-lg-4">\n                                <img class="img img-fluid mx-auto" src="/rating/static/src/img/503.svg" alt=""/>\n                            </div>\n                            <div class="col-lg-8 text-lg-start">\n                                <h1>You cannot rate this <t t-out="model_name"/></h1>\n                                <p>\n                                    Only the customer of "<t t-out="name"/>" or someone from the same company can give it a rating.\n                                </p>\n                            </div>\n                            <hr class="my-5 opacity-100"/>\n                            <div class="mb128 col-lg-12">\n                                <ul class="list-inline text-center">\n                                    <li>\n                                        <a t-att-href="web_base_url" class="btn btn-primary">Home</a>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </t>\n        </t>\n\n        	f	t	2026-09-05 15:59:51.596516	2026-09-05 15:59:51.596516	f
893	16	\N	1	1	Rate our Services	\N	rating.rating_external_page_submit	qweb	rating/views/rating_templates.xml	primary	{"en_US": "<t name=\\"Rate our Services\\" t-name=\\"rating.rating_external_page_submit\\">\\n            <t t-call=\\"web.frontend_layout\\">\\n                <div class=\\"container mb-5 mt-4 o_rating_page_submit\\">\\n                    <div class=\\"oe_structure\\" id=\\"oe_structure_rate_submit_header\\"/>\\n                    <div class=\\"row text-center justify-content-center\\">\\n                        <h1 class=\\"col-12 mt-5\\">Thank you for rating our services!</h1>\\n                        <form class=\\"col-md-6\\" t-attf-action=\\"/rate/#{token}/submit_feedback\\" method=\\"post\\">\\n                            <div class=\\"btn-group row flex-nowrap justify-content-center w-100 mt-5\\" role=\\"group\\" data-bs-toggle=\\"buttons\\">\\n                                <t t-foreach=\\"rate_names\\" t-as=\\"rate_name\\">\\n                                    <input type=\\"radio\\" name=\\"rate\\" class=\\"btn-check\\" t-attf-id=\\"rate_{{rate_name}}\\" t-att-value=\\"rate_name\\" t-att-checked=\\"rate == rate_name\\"/>\\n                                    <label t-attf-class=\\"col p-4 btn o_rating_label shadow-none transition-base {{rate == rate_name and 'active' or ''}}\\" t-att-for=\\"'rate_%s' % (rate_name)\\">\\n                                        <img t-attf-src=\\"/rating/static/src/img/rating_#{rate_name}.svg\\" t-att-alt=\\"rate_name_value\\" t-att-title=\\"rate_name_value\\" t-attf-class=\\"o_{{rate_name_value.lower()}}\\"/>\\n                                    </label>\\n                                </t>\\n                            </div>\\n                            <p class=\\"mt-5\\">\\n                                Feel free to share feedback on your experience:\\n                            </p>\\n                            <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                            <textarea class=\\"form-control\\" name=\\"feedback\\" rows=\\"8\\" t-att-value=\\"rating.feedback\\"/>\\n                            <button type=\\"submit\\" class=\\"btn btn-primary mt-4\\" style=\\"margin-top:8px;\\">Send Feedback</button>\\n                        </form>\\n                        <div class=\\"oe_structure\\" id=\\"oe_structure_rate_submit_footer\\"/>\\n                    </div>\\n                </div>\\n            </t>\\n        </t>"}	<?xml version="1.0"?>\n<t name="Rate our Services" t-name="rating.rating_external_page_submit">\n            <t t-call="web.frontend_layout">\n                <div class="container mb-5 mt-4 o_rating_page_submit">\n                    <div class="oe_structure" id="oe_structure_rate_submit_header"/>\n                    <div class="row text-center justify-content-center">\n                        <h1 class="col-12 mt-5">Thank you for rating our services!</h1>\n                        <form class="col-md-6" t-attf-action="/rate/#{token}/submit_feedback" method="post">\n                            <div class="btn-group row flex-nowrap justify-content-center w-100 mt-5" role="group" data-bs-toggle="buttons">\n                                <t t-foreach="rate_names" t-as="rate_name">\n                                    <input type="radio" name="rate" class="btn-check" t-attf-id="rate_{{rate_name}}" t-att-value="rate_name" t-att-checked="rate == rate_name"/>\n                                    <label t-attf-class="col p-4 btn o_rating_label shadow-none transition-base {{rate == rate_name and 'active' or ''}}" t-att-for="'rate_%s' % (rate_name)">\n                                        <img t-attf-src="/rating/static/src/img/rating_#{rate_name}.svg" t-att-alt="rate_name_value" t-att-title="rate_name_value" t-attf-class="o_{{rate_name_value.lower()}}"/>\n                                    </label>\n                                </t>\n                            </div>\n                            <p class="mt-5">\n                                Feel free to share feedback on your experience:\n                            </p>\n                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                            <textarea class="form-control" name="feedback" rows="8" t-att-value="rating.feedback"/>\n                            <button type="submit" class="btn btn-primary mt-4" style="margin-top:8px;">Send Feedback</button>\n                        </form>\n                        <div class="oe_structure" id="oe_structure_rate_submit_footer"/>\n                    </div>\n                </div>\n            </t>\n        </t>\n	f	t	2026-09-05 15:59:51.596516	2026-09-05 15:59:51.596516	f
