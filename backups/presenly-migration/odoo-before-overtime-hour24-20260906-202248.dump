492	16	\N	1	1	Language Selector	\N	portal.language_selector	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t name=\\"Language Selector\\" t-name=\\"portal.language_selector\\">\\n        <t t-set=\\"language_selector_visible\\" t-value=\\"len(frontend_languages) &gt; 1\\"/>\\n        <div t-attf-class=\\"js_language_selector #{_div_classes} d-print-none\\" t-if=\\"language_selector_visible\\">\\n            <t t-set=\\"active_lang\\" t-value=\\"frontend_languages[lang]\\"/>\\n            <button t-attf-class=\\"border-0 dropdown-toggle #{_btn_class or 'btn btn-sm btn-outline-secondary'}\\" type=\\"button\\" data-bs-toggle=\\"dropdown\\" aria-haspopup=\\"true\\" aria-expanded=\\"true\\">\\n                <span t-if=\\"not no_text\\" t-attf-class=\\"#{_txt_class}\\" t-esc=\\"active_lang.name.split('/').pop()\\"/>\\n                <span t-elif=\\"codes\\" class=\\"align-middle\\" t-esc=\\"active_lang.url_code.split('_').pop(0).upper()\\"/>\\n            </button>\\n            <div t-attf-class=\\"dropdown-menu #{_dropdown_menu_class}\\" role=\\"menu\\">\\n                <t t-foreach=\\"frontend_languages.values()\\" t-as=\\"lg\\">\\n                    <a class=\\"dropdown-item\\" t-att-href=\\"url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)\\" t-attf-class=\\"dropdown-item js_change_lang #{active_lang == lg and 'active'}\\" t-att-data-url_code=\\"lg.url_code\\" t-att-title=\\"lg.name.split('/').pop()\\" role=\\"menuitem\\">\\n                        <span t-if=\\"not no_text\\" t-esc=\\"lg.name.split('/').pop()\\" t-attf-class=\\"#{_txt_class}\\"/>\\n                        <span t-elif=\\"codes\\" t-esc=\\"lg.url_code.split('_').pop(0).upper()\\" t-attf-class=\\"align-middle #{_txt_class}\\"/>\\n                    </a>\\n                </t>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Language Selector" t-name="portal.language_selector">\n        <t t-set="language_selector_visible" t-value="len(frontend_languages) &gt; 1"/>\n        <div t-attf-class="js_language_selector #{_div_classes} d-print-none" t-if="language_selector_visible">\n            <t t-set="active_lang" t-value="frontend_languages[lang]"/>\n            <button t-attf-class="border-0 dropdown-toggle #{_btn_class or 'btn btn-sm btn-outline-secondary'}" type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true">\n                <span t-if="not no_text" t-attf-class="#{_txt_class}" t-esc="active_lang.name.split('/').pop()"/>\n                <span t-elif="codes" class="align-middle" t-esc="active_lang.url_code.split('_').pop(0).upper()"/>\n            </button>\n            <div t-attf-class="dropdown-menu #{_dropdown_menu_class}" role="menu">\n                <t t-foreach="frontend_languages.values()" t-as="lg">\n                    <a class="dropdown-item" t-att-href="url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)" t-attf-class="dropdown-item js_change_lang #{active_lang == lg and 'active'}" t-att-data-url_code="lg.url_code" t-att-title="lg.name.split('/').pop()" role="menuitem">\n                        <span t-if="not no_text" t-esc="lg.name.split('/').pop()" t-attf-class="#{_txt_class}"/>\n                        <span t-elif="codes" t-esc="lg.url_code.split('_').pop(0).upper()" t-attf-class="align-middle #{_txt_class}"/>\n                    </a>\n                </t>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
493	16	\N	1	1	Portal User Dropdown	\N	portal.user_dropdown	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t name=\\"Portal User Dropdown\\" t-name=\\"portal.user_dropdown\\">\\n        <t t-set=\\"is_connected\\" t-value=\\"not user_id._is_public()\\"/>\\n        <li t-if=\\"is_connected\\" t-attf-class=\\"#{_item_class} o_no_autohide_item\\">\\n            <a href=\\"#\\" role=\\"button\\" data-bs-toggle=\\"dropdown\\" t-attf-class=\\"#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}\\">\\n                <t t-if=\\"_avatar\\">\\n                    <t t-set=\\"avatar_source\\" t-value=\\"image_data_uri(user_id.avatar_256)\\"/>\\n                    <img t-att-src=\\"avatar_source\\" t-attf-class=\\"rounded-circle object-fit-cover #{_avatar_class}\\" width=\\"24\\" height=\\"24\\" alt=\\"\\" loading=\\"eager\\"/>\\n                </t>\\n                <div t-if=\\"_icon\\" t-attf-class=\\"#{_icon_wrap_class}\\">\\n                    <i t-attf-class=\\"fa fa-1x fa-fw fa-user #{_icon_class}\\"/>\\n                </div>\\n                <span t-if=\\"_user_name\\" t-attf-class=\\"#{_user_name_class}\\" t-esc=\\"user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name\\"/>\\n            </a>\\n            <div t-attf-class=\\"dropdown-menu js_usermenu #{_dropdown_menu_class}\\" role=\\"menu\\">\\n                <a groups=\\"base.group_user\\" href=\\"/odoo\\" role=\\"menuitem\\" class=\\"dropdown-item ps-3\\" id=\\"o_backend_user_dropdown_link\\">\\n                    <i class=\\"fa fa-fw fa-th me-1 small text-primary-emphasis\\"/> Apps\\n                </a>\\n                <div id=\\"o_logout_divider\\" class=\\"dropdown-divider\\"/>\\n                <a t-attf-href=\\"/web/session/logout?redirect=/\\" role=\\"menuitem\\" id=\\"o_logout\\" class=\\"dropdown-item ps-3\\">\\n                    <i class=\\"fa fa-fw fa-sign-out me-1 small text-primary-emphasis\\"/> Logout\\n                </a>\\n            </div>\\n        </li>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Portal User Dropdown" t-name="portal.user_dropdown">\n        <t t-set="is_connected" t-value="not user_id._is_public()"/>\n        <li t-if="is_connected" t-attf-class="#{_item_class} o_no_autohide_item">\n            <a href="#" role="button" data-bs-toggle="dropdown" t-attf-class="#{'' if _no_caret else 'dropdown-toggle'} #{_link_class}">\n                <t t-if="_avatar">\n                    <t t-set="avatar_source" t-value="image_data_uri(user_id.avatar_256)"/>\n                    <img t-att-src="avatar_source" t-attf-class="rounded-circle object-fit-cover #{_avatar_class}" width="24" height="24" alt="" loading="eager"/>\n                </t>\n                <div t-if="_icon" t-attf-class="#{_icon_wrap_class}">\n                    <i t-attf-class="fa fa-1x fa-fw fa-user #{_icon_class}"/>\n                </div>\n                <span t-if="_user_name" t-attf-class="#{_user_name_class}" t-esc="user_id.name[:23] + '...' if user_id.name and len(user_id.name) &gt; 25 else user_id.name"/>\n            </a>\n            <div t-attf-class="dropdown-menu js_usermenu #{_dropdown_menu_class}" role="menu">\n                <a groups="base.group_user" href="/odoo" role="menuitem" class="dropdown-item ps-3" id="o_backend_user_dropdown_link">\n                    <i class="fa fa-fw fa-th me-1 small text-primary-emphasis"/> Apps\n                </a>\n                <div id="o_logout_divider" class="dropdown-divider"/>\n                <a t-attf-href="/web/session/logout?redirect=/" role="menuitem" id="o_logout" class="dropdown-item ps-3">\n                    <i class="fa fa-fw fa-sign-out me-1 small text-primary-emphasis"/> Logout\n                </a>\n            </div>\n        </li>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
494	16	\N	1	1	Portal Breadcrumbs	\N	portal.portal_breadcrumbs	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t name=\\"Portal Breadcrumbs\\" t-name=\\"portal.portal_breadcrumbs\\">\\n        <ol t-if=\\"page_name != 'home'\\" class=\\"o_portal_submenu breadcrumb mb-0 flex-grow-1 px-0\\">\\n            <li class=\\"breadcrumb-item ms-1\\"><a href=\\"/my/home\\" aria-label=\\"Home\\" title=\\"Home\\"><i class=\\"fa fa-home\\"/></a></li>\\n            <li t-if=\\"page_name == 'my_addresses'\\" class=\\"breadcrumb-item\\">Addresses</li>\\n            <li t-elif=\\"page_name == 'address_form'\\" class=\\"breadcrumb-item\\">\\n                <a href=\\"/my/addresses\\" aria-label=\\"Addresses\\" title=\\"Addresses\\">Addresses</a>\\n            </li>\\n            <li t-if=\\"page_name in ['my_details', 'address_form']\\" class=\\"breadcrumb-item\\">Details</li>\\n        </ol>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Portal Breadcrumbs" t-name="portal.portal_breadcrumbs">\n        <ol t-if="page_name != 'home'" class="o_portal_submenu breadcrumb mb-0 flex-grow-1 px-0">\n            <li class="breadcrumb-item ms-1"><a href="/my/home" aria-label="Home" title="Home"><i class="fa fa-home"/></a></li>\n            <li t-if="page_name == 'my_addresses'" class="breadcrumb-item">Addresses</li>\n            <li t-elif="page_name == 'address_form'" class="breadcrumb-item">\n                <a href="/my/addresses" aria-label="Addresses" title="Addresses">Addresses</a>\n            </li>\n            <li t-if="page_name in ['my_details', 'address_form']" class="breadcrumb-item">Details</li>\n        </ol>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
