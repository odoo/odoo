371	16	\N	1	1	mail_notification_light	\N	mail.mail_notification_light	qweb	mail/data/mail_templates_email_layouts.xml	primary	{"en_US": "<t t-name=\\"mail.mail_notification_light\\">\\n<html t-att-lang=\\"lang\\">\\n<head>\\n    <meta http-equiv=\\"Content-Type\\" content=\\"text/html charset=UTF-8\\"/>\\n</head>\\n<body>\\n<t t-set=\\"subtype_internal\\" t-value=\\"False\\"/>\\n<t t-call=\\"mail.notification_preview\\"/>\\n<table role=\\"presentation\\" border=\\"0\\" cellpadding=\\"0\\" cellspacing=\\"0\\" style=\\"padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;\\"><tr><td align=\\"center\\">\\n<table role=\\"presentation\\" border=\\"0\\" cellpadding=\\"0\\" cellspacing=\\"0\\" width=\\"590\\" style=\\"padding: 24px; background-color: white; color: #454748; border-collapse:separate;\\">\\n<tbody>\\n    <!-- HEADER -->\\n    <tr>\\n        <td align=\\"center\\" style=\\"min-width: 590px;\\">\\n            <table role=\\"presentation\\" border=\\"0\\" cellpadding=\\"0\\" cellspacing=\\"0\\" width=\\"100%\\" style=\\"background-color: white; padding: 0; border-collapse:separate;\\">\\n                <tr><td valign=\\"middle\\">\\n                    <span style=\\"font-size: 10px;\\">Your <t t-out=\\"model_description or 'document'\\"/></span>\\n                    <br/>\\n                    <t t-if=\\"has_button_access\\">\\n                        <a t-att-href=\\"button_access['url']\\">\\n                            <span style=\\"font-size: 20px; font-weight: bold;\\">\\n                                <t t-out=\\"(record_name or message.record_name or '').replace('/','-')\\"/>\\n                            </span>\\n                        </a>\\n                    </t>\\n                    <t t-else=\\"\\">\\n                        <span style=\\"font-size: 20px; font-weight: bold;\\">\\n                            <t t-out=\\"(record_name or message.record_name or '').replace('/','-')\\"/>\\n                        </span>\\n                    </t>\\n                </td><td valign=\\"middle\\" align=\\"right\\" t-if=\\"company and not company.uses_default_logo\\">\\n                    <img t-att-src=\\"'/logo.png?company=%s' % company.id\\" style=\\"padding: 0px; margin: 0px; height: 48px;\\" t-att-alt=\\"'%s' % company.name\\"/>\\n                </td></tr>\\n                <tr><td colspan=\\"2\\" style=\\"text-align:center;\\">\\n                  <hr width=\\"100%\\" style=\\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:4px 0px 32px 0px;\\"/>\\n                </td></tr>\\n            </table>\\n        </td>\\n    </tr>\\n    <!-- CONTENT -->\\n    <tr>\\n        <td style=\\"min-width: 590px;\\">\\n            <t t-out=\\"message.body\\"/>\\n        </td>\\n    </tr>\\n    <!-- FOOTER -->\\n    <tr>\\n        <td align=\\"center\\" style=\\"min-width: 590px; padding: 0 8px 0 8px; font-size:11px;\\">\\n            <hr width=\\"100%\\" style=\\"background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 4px 0px;\\"/>\\n            <b t-out=\\"company.name\\"/><br/>\\n            <div style=\\"color: #999999;\\">\\n                <t t-out=\\"company.phone\\"/>\\n                <t t-if=\\"company.email and company.phone\\"> |</t>\\n                <a t-if=\\"company.email\\" t-att-href=\\"'mailto:%s' % company.email\\" style=\\"text-decoration:none; color: #999999;\\" t-out=\\"company.email\\"/>\\n                <t t-if=\\"company.website and (company.phone or company.email)\\"> |</t>\\n                <a t-if=\\"company.website\\" t-att-href=\\"'%s' % company.website\\" style=\\"text-decoration:none; color: #999999;\\" t-out=\\"company.website\\"/>\\n            </div>\\n        </td>\\n    </tr>\\n</tbody>\\n</table>\\n</td></tr>\\n<!-- POWERED BY -->\\n<tr><td align=\\"center\\" style=\\"min-width: 590px;\\">\\n        Powered by <a target=\\"_blank\\" href=\\"https://www.odoo.com?utm_source=db&amp;utm_medium=email\\" t-att-style=\\"'color: ' + (company.email_secondary_color or '#875A7B') + ';'\\">Odoo</a>\\n    <span t-if=\\"show_unfollow\\" id=\\"mail_unfollow\\">\\n        | <a href=\\"/mail/unfollow\\" style=\\"text-decoration:none; color:#555555;\\">Unfollow</a>\\n    </span>\\n</td></tr>\\n</table>\\n</body>\\n</html>\\n        </t>"}	<?xml version="1.0"?>\n<t t-name="mail.mail_notification_light">\n<html t-att-lang="lang">\n<head>\n    <meta http-equiv="Content-Type" content="text/html charset=UTF-8"/>\n</head>\n<body>\n<t t-set="subtype_internal" t-value="False"/>\n<t t-call="mail.notification_preview"/>\n<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"><tr><td align="center">\n<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 24px; background-color: white; color: #454748; border-collapse:separate;">\n<tbody>\n    <!-- HEADER -->\n    <tr>\n        <td align="center" style="min-width: 590px;">\n            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: white; padding: 0; border-collapse:separate;">\n                <tr><td valign="middle">\n                    <span style="font-size: 10px;">Your <t t-out="model_description or 'document'"/></span>\n                    <br/>\n                    <t t-if="has_button_access">\n                        <a t-att-href="button_access['url']">\n                            <span style="font-size: 20px; font-weight: bold;">\n                                <t t-out="(record_name or message.record_name or '').replace('/','-')"/>\n                            </span>\n                        </a>\n                    </t>\n                    <t t-else="">\n                        <span style="font-size: 20px; font-weight: bold;">\n                            <t t-out="(record_name or message.record_name or '').replace('/','-')"/>\n                        </span>\n                    </t>\n                </td><td valign="middle" align="right" t-if="company and not company.uses_default_logo">\n                    <img t-att-src="'/logo.png?company=%s' % company.id" style="padding: 0px; margin: 0px; height: 48px;" t-att-alt="'%s' % company.name"/>\n                </td></tr>\n                <tr><td colspan="2" style="text-align:center;">\n                  <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:4px 0px 32px 0px;"/>\n                </td></tr>\n            </table>\n        </td>\n    </tr>\n    <!-- CONTENT -->\n    <tr>\n        <td style="min-width: 590px;">\n            <t t-out="message.body"/>\n        </td>\n    </tr>\n    <!-- FOOTER -->\n    <tr>\n        <td align="center" style="min-width: 590px; padding: 0 8px 0 8px; font-size:11px;">\n            <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 4px 0px;"/>\n            <b t-out="company.name"/><br/>\n            <div style="color: #999999;">\n                <t t-out="company.phone"/>\n                <t t-if="company.email and company.phone"> |</t>\n                <a t-if="company.email" t-att-href="'mailto:%s' % company.email" style="text-decoration:none; color: #999999;" t-out="company.email"/>\n                <t t-if="company.website and (company.phone or company.email)"> |</t>\n                <a t-if="company.website" t-att-href="'%s' % company.website" style="text-decoration:none; color: #999999;" t-out="company.website"/>\n            </div>\n        </td>\n    </tr>\n</tbody>\n</table>\n</td></tr>\n<!-- POWERED BY -->\n<tr><td align="center" style="min-width: 590px;">\n        Powered by <a target="_blank" href="https://www.odoo.com?utm_source=db&amp;utm_medium=email" t-att-style="'color: ' + (company.email_secondary_color or '#875A7B') + ';'">Odoo</a>\n    <span t-if="show_unfollow" id="mail_unfollow">\n        | <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>\n    </span>\n</td></tr>\n</table>\n</body>\n</html>\n        </t>\n\n        	f	t	2026-09-05 15:59:45.191692	2026-09-05 15:59:45.191692	\N
