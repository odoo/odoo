866	16	\N	1	1	Goal Definitions Form	gamification.goal.definition	\N	form	gamification/views/gamification_goal_definition_views.xml	primary	{"en_US": "<form string=\\"Goal definitions\\">\\n                <sheet>\\n                        <label for=\\"name\\"/>\\n                        <h1>\\n                            <field name=\\"name\\" placeholder=\\"e.g. Get started\\" class=\\"w-100\\"/>\\n                        </h1>\\n                        <label for=\\"description\\"/>\\n                        <div>\\n                            <field name=\\"description\\" placeholder=\\"e.g. Register to the platform\\" class=\\"w-100\\"/>\\n                        </div>\\n\\n                        <group string=\\"How is the goal computed?\\" name=\\"compute_details\\">\\n\\n                            <field widget=\\"radio\\" name=\\"computation_mode\\"/>\\n\\n                            <!-- Hide the fields below if manually -->\\n                            <field name=\\"model_id\\" class=\\"oe_inline\\" invisible=\\"computation_mode not in ('sum', 'count')\\" required=\\"computation_mode in ('sum', 'count')\\"/>\\n                            <field name=\\"model_inherited_ids\\" invisible=\\"1\\"/>\\n                            <field name=\\"field_id\\" class=\\"oe_inline\\" options=\\"{'no_create': True}\\" invisible=\\"computation_mode != 'sum'\\" required=\\"computation_mode == 'sum'\\"/>\\n                            <field name=\\"field_date_id\\" class=\\"oe_inline\\" invisible=\\"computation_mode not in ('sum', 'count')\\"/>\\n                            <field name=\\"domain\\" invisible=\\"computation_mode not in ('sum', 'count')\\" required=\\"computation_mode in ('sum', 'count')\\" class=\\"oe_inline\\"/>\\n                            <field name=\\"compute_code\\" invisible=\\"computation_mode != 'python'\\" required=\\"computation_mode == 'python'\\"/>\\n                            <field name=\\"condition\\" widget=\\"radio\\"/>\\n                        </group>\\n                        <group string=\\"Optimisation\\" name=\\"optimisation\\" invisible=\\"computation_mode not in ('sum', 'count')\\">\\n                            <field name=\\"batch_mode\\"/>\\n                            <div colspan=\\"2\\">In batch mode, the domain is evaluated globally. If enabled, do not use keyword 'user' in above filter domain.</div>\\n                            <field name=\\"batch_distinctive_field\\" invisible=\\"not batch_mode\\" required=\\"batch_mode\\" domain=\\"[('model_id', '=', model_id)]\\" class=\\"oe_inline\\" options=\\"{'no_create': True}\\"/>\\n                            <field name=\\"batch_user_expression\\" invisible=\\"not batch_mode\\" required=\\"batch_mode\\" class=\\"oe_inline\\" placeholder=\\"e.g. user.partner_id.id\\"/>\\n                        </group>\\n                        <group string=\\"Formatting Options\\" name=\\"format_options\\">\\n                            <field name=\\"display_mode\\" widget=\\"radio\\"/>\\n                            <field name=\\"suffix\\" placeholder=\\"e.g. days\\" class=\\"oe_inline\\"/>\\n                            <field name=\\"monetary\\"/>\\n                        </group>\\n                        <group string=\\"Clickable Goals\\" name=\\"clickable_goals\\" invisible=\\"computation_mode == 'manually'\\">\\n                            <field name=\\"action_id\\" class=\\"oe_inline\\"/>\\n                            <field name=\\"res_id_field\\" invisible=\\"not action_id\\" class=\\"oe_inline\\"/>\\n                        </group>\\n\\n                </sheet>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Goal definitions">\n                <sheet>\n                        <label for="name"/>\n                        <h1>\n                            <field name="name" placeholder="e.g. Get started" class="w-100"/>\n                        </h1>\n                        <label for="description"/>\n                        <div>\n                            <field name="description" placeholder="e.g. Register to the platform" class="w-100"/>\n                        </div>\n\n                        <group string="How is the goal computed?" name="compute_details">\n\n                            <field widget="radio" name="computation_mode"/>\n\n                            <!-- Hide the fields below if manually -->\n                            <field name="model_id" class="oe_inline" invisible="computation_mode not in ('sum', 'count')" required="computation_mode in ('sum', 'count')"/>\n                            <field name="model_inherited_ids" invisible="1"/>\n                            <field name="field_id" class="oe_inline" options="{'no_create': True}" invisible="computation_mode != 'sum'" required="computation_mode == 'sum'"/>\n                            <field name="field_date_id" class="oe_inline" invisible="computation_mode not in ('sum', 'count')"/>\n                            <field name="domain" invisible="computation_mode not in ('sum', 'count')" required="computation_mode in ('sum', 'count')" class="oe_inline"/>\n                            <field name="compute_code" invisible="computation_mode != 'python'" required="computation_mode == 'python'"/>\n                            <field name="condition" widget="radio"/>\n                        </group>\n                        <group string="Optimisation" name="optimisation" invisible="computation_mode not in ('sum', 'count')">\n                            <field name="batch_mode"/>\n                            <div colspan="2">In batch mode, the domain is evaluated globally. If enabled, do not use keyword 'user' in above filter domain.</div>\n                            <field name="batch_distinctive_field" invisible="not batch_mode" required="batch_mode" domain="[('model_id', '=', model_id)]" class="oe_inline" options="{'no_create': True}"/>\n                            <field name="batch_user_expression" invisible="not batch_mode" required="batch_mode" class="oe_inline" placeholder="e.g. user.partner_id.id"/>\n                        </group>\n                        <group string="Formatting Options" name="format_options">\n                            <field name="display_mode" widget="radio"/>\n                            <field name="suffix" placeholder="e.g. days" class="oe_inline"/>\n                            <field name="monetary"/>\n                        </group>\n                        <group string="Clickable Goals" name="clickable_goals" invisible="computation_mode == 'manually'">\n                            <field name="action_id" class="oe_inline"/>\n                            <field name="res_id_field" invisible="not action_id" class="oe_inline"/>\n                        </group>\n\n                </sheet>\n            </form>\n        	f	t	2026-09-05 15:59:51.079296	2026-09-05 15:59:51.079296	f
