--
-- Name: presenly_work_location_schedule; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.presenly_work_location_schedule (
    id integer NOT NULL,
    employee_id integer NOT NULL,
    company_id integer,
    work_location_id integer NOT NULL,
    check_in_tolerance_minutes integer,
    create_uid integer,
    write_uid integer,
    name character varying,
    schedule_type character varying NOT NULL,
    weekday character varying,
    week_type character varying,
    schedule_date date,
    date_start date,
    date_end date,
    active boolean,
    create_date timestamp without time zone,
    write_date timestamp without time zone,
    hour_from double precision NOT NULL,
    hour_to double precision NOT NULL,
    CONSTRAINT presenly_work_location_schedule_nonnegative_tolerance CHECK ((check_in_tolerance_minutes >= 0)),
    CONSTRAINT presenly_work_location_schedule_valid_hours CHECK (((hour_from >= (0)::double precision) AND (hour_from < hour_to) AND (hour_to <= (24)::double precision))),
    CONSTRAINT presenly_work_location_schedule_valid_period CHECK (((date_end IS NULL) OR (date_start IS NULL) OR (date_end >= date_start)))
);


--
-- Name: TABLE presenly_work_location_schedule; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON TABLE public.presenly_work_location_schedule IS 'Employee Work Location Time Slot';


