Meetings" sample="1" multi_edit="1" js_class="calendar_list_view">\n                <header>\n                    <button name="action_open_composer" type="object" context="{'default_composition_mode':'mass_mail'}" string="Send Mail"/>\n                </header>\n                <field name="name" string="Subject" decoration-bf="1" readonly="recurrency"/>\n                <field name="start" string="Start Date" readonly="1"/>\n                <field name="stop" string="End Date" readonly="1"/>\n                <field name="user_id" widget="many2one_avatar_user" readonly="recurrency" optional="hide"/>\n                <field name="partner_ids" widget="many2many_tags" readonly="recurrency" optional="show"/>\n                <field name="alarm_ids" widget="many2many_tags" optional="hide" readonly="recurrency"/>\n                <field name="categ_ids" widget="many2many_tags" optional="hide" readonly="recurrency" options="{'color_field': 'color'}"/>\n                <field name="recurrency" optional="hide" readonly="1"/>\n                <field name="privacy" optional="hide" readonly="recurrency"/>\n                <field name="show_as" optional="hide" readonly="recurrency"/>\n                <field name="location" optional="show" readonly="recurrency"/>\n                <field name="duration" widget="float_time" readonly="1"/>\n                <field name="description" optional="hide" readonly="recurrency"/>\n                <field name="allday" column_invisible="True"/>\n                <field name="message_needaction" column_invisible="True"/>\n            </list>\n        	f	t	2026-09-05 15:59:46.487049	2026-09-05 15:59:46.487049	\N
444	1	\N	1	1	calendar.event.form	calendar.event	\N	form	calendar/views/calendar_views.xml	primary	{"en_US": "<form string=\\"Meetings\\" class=\\"o_calendar_event_form_view\\" js_class=\\"calendar_form\\">\\n                <header>\\n                    <button name=\\"action_open_composer\\" class=\\"btn btn-primary\\" type=\\"object\\" string=\\"Send email\\" invisible=\\"not user_can_edit\\"/>\\n                </header>\\n                <div invisible=\\"not recurrence_id\\" class=\\"alert alert-info oe_edit_only\\" role=\\"status\\">\\n                    <p>Edit recurring event</p>\\n                    <field name=\\"recurrence_update\\" widget=\\"radio\\"/>\\n                </div>\\n                <sheet>\\n                    <div class=\\"oe_button_box\\" name=\\"button_box\\">\\n                        <button icon=\\"fa-bars\\" type=\\"object\\" name=\\"action_open_calendar_event\\" invisible=\\"not (res_id and res_model_name)\\">\\n                            <field name=\\"res_model_name\\"/>\\n                        </button>\\n                    </div>\\n                    <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                    <field name=\\"active\\" invisible=\\"1\\"/>\\n                    <field name=\\"user_can_edit\\" invisible=\\"1\\"/>\\n                    <field name=\\"invalid_email_partner_ids\\" invisible=\\"1\\"/> <!-- this field will be used in\\n                        many2many_attendees widget -->\\n                    <div class=\\"oe_title mb-3\\">\\n                        <div>\\n                            <label for=\\"name\\"/>\\n                        </div>\\n                        <h1>\\n                            <field name=\\"name\\" placeholder=\\"e.g. Business Lunch\\" readonly=\\"not user_can_edit\\"/>\\n                        </h1>\\n                    </div>\\n                    <group>\\n                        <group>\\n                            <field name=\\"start_date\\" widget=\\"daterange\\" options=\\"{'end_date_field': 'stop_date'}\\" invisible=\\"not allday\\" required=\\"allday\\" readonly=\\"not user_can_edit\\"/>\\n                            <field name=\\"start\\" widget=\\"daterange\\" options=\\"{'end_date_field': 'stop'}\\" invisible=\\"allday\\" required=\\"not allday\\" readonly=\\"not user_can_edit\\"/>\\n                            <field name=\\"stop_date\\" invisible=\\"1\\"/>\\n                            <field name=\\"stop\\" invisible=\\"1\\"/>\\n                            <field name=\\"unavailable_partner_ids\\" invisible=\\"1\\"/> <!-- this field will be used in many2many_attendees widget -->\\n                            <label for=\\"duration\\" class=\\"fw-bold text-900 opacity-100\\"/>\\n                            <div class=\\"d-flex gap-2\\">\\n                                <div class=\\"d-flex align-items-start\\" invisible=\\"allday\\">\\n                                    <field name=\\"duration\\" widget=\\"float_time\\" string=\\"Duration\\" class=\\"oe_inline pe-2\\" readonly=\\"(id and recurrency) or not user_can_edit\\"/>\\n                                    <span> hours</span>\\n                                </div>\\n                                <span invisible=\\"allday\\" style=\\"white-space: pre;\\"> or </span>\\n                                <div class=\\"d-flex gap-2\\">\\n                                    <label for=\\"allday\\" class=\\"\\"/>\\n                                    <field name=\\"allday\\" class=\\"oe_inline\\" widget=\\"boolean_toggle\\" force_save=\\"1\\" options=\\"{'autosave': False}\\" readonly=\\"not user_can_edit\\"/>\\n                                </div>\\n                            </div>\\n\\n                            <field name=\\"location\\" placeholder=\\"Online Meeting\\" readonly=\\"not user_can_edit\\"/>\\n                            <label for=\\"videocall_location\\" class=\\"opacity-100\\"/>\\n                            <div name=\\"videocall_location_div\\">\\n                                <div class=\\"d-flex\\">\\n                                    <field name=\\"videocall_location\\" string=\\"Video Link\\" widget=\\"CopyClipboardChar\\" force_save=\\"1\\" class=\\"mb-0\\" readonly=\\"videocall_source == 'discuss' or not user_can_edit\\"/>\\n                                    <div class=\\"d-flex flex-nowrap\\">\\n                                        <button name=\\"clear_videocall_location\\" type=\\"object\\" class=\\"btn btn-link btn-lg ms-1 px-1 py-0\\" invisible=\\"not videocall_location or not user_can_edit\\" context=\\"{'recurrence_update': recurrence_update}\\">\\n                                            <span title=\\"Clear meeting\\" class=\\"fa fa-times\\"/>\\n                                        </button>\\n                                        <button name=\\"action_join_video_call\\" class=\\"btn btn-link btn-lg px-1 py-0\\" help=\\"Join Video Call\\" type=\\"object\\" invisible=\\"not videocall_location or not user_can_edit\\">\\n                                            <span title=\\"Join video call\\" class=\\"fa fa-sign-in\\"/>\\n                                        </button>\\n                                        <button name=\\"set_discuss_videocall_location\\" type=\\"object\\" class=\\"btn btn-link btn-sm px-0 text-nowrap\\" invisible=\\"videocall_location or not user_can_edit\\" context=\\"{'recurrence_update': recurrence_update}\\">\\n                                            <span class=\\"fa fa-plus\\"/><span> Odoo meeting</span>\\n                                        </button>\\n                                    </div>\\n                                </div>\\n                            </div>\\n                            <field name=\\"res_id\\" string=\\"Linked to\\" invisible=\\"not res_id\\" readonly=\\"1\\"/>\\n                            <field name=\\"res_model\\" invisible=\\"1\\"/>\\n                            <field name=\\"videocall_source\\" invisible=\\"1\\"/>\\n                            <field name=\\"access_token\\" invisible=\\"1\\" force_save=\\"1\\"/>\\n                        </group>\\n                        <group>\\n                            <field name=\\"current_status\\" class=\\"o_calendar_form_status_selection_badge\\" string=\\"Going?\\" widget=\\"selection_badge\\" options=\\"{'horizontal': true, 'size': 'sm'}\\" required=\\"should_show_status\\" readonly=\\"not should_show_status\\" invisible=\\"not should_show_status\\"/>\\n                            <label for=\\"privacy\\" string=\\"Status\\"/>\\n                            <div class=\\"d-flex\\">\\n                                <field name=\\"show_as\\" class=\\"oe_inline me-2\\" readonly=\\"not user_can_edit\\" nolabel=\\"1\\"/>\\n                                <field name=\\"privacy\\" class=\\"oe_inline me-2\\" readonly=\\"not user_can_edit\\" nolabel=\\"1\\" placeholder=\\"User default\\" help=\\"Set whether you're available for other simultaneous events and the privacy of this event to others. Manage your default privacy in your user preferences.\\"/>\\n                            </div>\\n                            <field name=\\"should_show_status\\" invisible=\\"1\\"/>\\n                            <div class=\\"d-flex mb-2\\" colspan=\\"2\\">\\n                                <div>\\n                                    <span class=\\"fw-medium o_form_label\\">\\n                                        <field name=\\"attendees_count\\" class=\\"w-auto oe_inline\\" nolabel=\\"1\\"/><span> guests</span>\\n                                    </span>\\n                                    <div invisible=\\"not accepted_count and not tentative_count and not declined_count and not awaiting_count\\" class=\\"text-muted fw-normal\\">\\n                                        <span invisible=\\"not accepted_count\\" class=\\"me-1\\">\\n                                            <field name=\\"accepted_count\\" class=\\"w-auto oe_inline\\" nolabel=\\"1\\"/> Yes\\n                                        </span>\\n                                        <span invisible=\\"not tentative_count\\" class=\\"me-1\\">\\n                                            <field name=\\"tentative_count\\" class=\\"w-auto oe_inline\\" nolabel=\\"1\\"/> Maybe\\n                                        </span>\\n                                        <span invisible=\\"not declined_count\\" class=\\"me-1\\">\\n                                            <field name=\\"declined_count\\" class=\\"w-auto oe_inline\\" nolabel=\\"1\\"/> No\\n                                        </span>\\n                                        <span invisible=\\"not awaiting_count\\" class=\\"me-1\\">\\n                                            <field name=\\"awaiting_count\\" class=\\"w-auto oe_inline\\" nolabel=\\"1\\"/> Awaiting\\n                                        </span>\\n                                    </div>\\n                                </div>\\n                                <div name=\\"send_buttons\\" class=\\"d-flex gap-2 mb-auto ms-4\\">\\n                                    <button name=\\"action_open_composer\\" help=\\"Send Email to attendees\\" type=\\"object\\" string=\\" EMAIL\\" icon=\\"fa-envelope\\" invisible=\\"not user_can_edit\\"/>\\n                                </div>\\n                            </div>\\n                            <div class=\\"d-flex align-items-baseline\\" colspan=\\"2\\">\\n                                <field name=\\"partner_ids\\" widget=\\"many2manyattendee\\" placeholder=\\"Select attendees...\\" options=\\"{'no_quick_create': True}\\" context=\\"{'form_view_ref': 'base.view_partner_simple_form'}\\" domain=\\"[('type','!=','private')]\\" class=\\"oe_inline\\" readonly=\\"not user_can_edit\\"/>\\n                            </div>\\n                        </group>\\n                    </group>\\n                    <notebook>\\n                        <page name=\\"notes\\" string=\\"Notes\\">\\n                            <field name=\\"notes\\" type=\\"html\\" options=\\"{'resizable': false}\\" readonly=\\"not user_can_edit\\" placeholder=\\"Add notes about this meeting...\\"/>\\n                        </page>\\n                        <page name=\\"options\\" string=\\"Options\\">\\n                            <group>\\n                                <group>\\n                                    <field name=\\"user_id\\" widget=\\"many2one_avatar_user\\" readonly=\\"not user_can_edit\\"/>\\n                                    <field name=\\"categ_ids\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color', 'no_create_edit': True}\\" readonly=\\"not user_can_edit\\"/>\\n                                    <label for=\\"description\\" string=\\"Calendar description\\" colspan=\\"2\\"/>\\n                                    <field name=\\"description\\" colspan=\\"2\\" nolabel=\\"1\\" class=\\"border border-1 rounded\\" options=\\"{'height': 120}\\" placeholder=\\"Add description\\" readonly=\\"not user_can_edit\\"/>\\n                                </group>\\n                                <group>\\n                                    <field name=\\"alarm_ids\\" widget=\\"many2many_tags\\" options=\\"{'no_quick_create': True}\\" readonly=\\"not user_can_edit\\"/>\\n                                    <field name=\\"recurrence_id\\" invisible=\\"1\\"/>\\n                                    <field name=\\"rrule_type\\" invisible=\\"1\\"/>\\n                                    <label for=\\"recurrency\\" string=\\"Recurrent\\"/>\\n                                    <div class=\\"d-flex align-items-baseline gap-1\\">\\n                                        <field name=\\"recurrency\\" widget=\\"boolean_toggle\\" options=\\"{'autosave': False}\\" class=\\"w-auto\\" readonly=\\"not user_can_edit\\"/>\\n                                        <span invisible=\\"not recurrency\\" class=\\"mx-1\\">Repeat:</span>\\n                                        <field name=\\"rrule_type_ui\\" class=\\"w-auto o_input\\" invisible=\\"not recurrency\\" required=\\"recurrency\\" readonly=\\"not user_can_edit\\"/>\\n                                    </div>\\n                                    <label for=\\"interval\\" class=\\"fw-bold text-900\\" invisible=\\"not recurrency or rrule_type_ui != 'custom'\\"/>\\n                                    <div class=\\"d-flex gap-1\\" invisible=\\"not recurrency or rrule_type_ui != 'custom'\\">\\n                                        <field name=\\"interval\\" string=\\"Repeat every\\" class=\\"oe_inline w-auto o_input_5ch\\"/>\\n                                        <field name=\\"rrule_type\\" nolabel=\\"1\\" class=\\"oe_inline\\" required=\\"rrule_type_ui == 'custom'\\"/>\\n                                    </div>\\n                                    <span class=\\"fw-bold text-nowrap\\" invisible=\\"rrule_type_ui not in ['weekly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'weekly')\\">Repeat on</span>\\n                                    <div invisible=\\"rrule_type_ui not in ['weekly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'weekly')\\"><widget name=\\"calendar_week_days\\" readonly=\\"not user_can_edit\\"/></div>\\n                                    <field name=\\"recurrence_id\\" invisible=\\"1\\"/>\\n\\n                                    <label string=\\"Day of Month\\" for=\\"month_by\\" class=\\"fw-bold text-900\\" style=\\"width: fit-content;\\" invisible=\\"rrule_type_ui not in ['monthly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly')\\"/>\\n                                    <div class=\\"d-flex gap-2\\" invisible=\\"rrule_type_ui not in ['monthly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly')\\">\\n                                        <field name=\\"month_by\\" nolabel=\\"1\\" class=\\"oe_inline w-auto\\" required=\\"rrule_type_ui == 'monthly' or rrule_type == 'monthly'\\"/>\\n                                        <field name=\\"day\\" nolabel=\\"1\\" class=\\"oe_inline w-auto\\" required=\\"(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'date'\\" invisible=\\"month_by != 'date'\\"/>\\n                                        <field name=\\"byday\\" string=\\"The\\" class=\\"oe_inline w-auto\\" nolabel=\\"1\\" required=\\"(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'day'\\" invisible=\\"month_by != 'day'\\"/>\\n                                        <field name=\\"weekday\\" nolabel=\\"1\\" class=\\"oe_inline w-auto\\" required=\\"(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'day'\\" invisible=\\"month_by != 'day'\\"/>\\n                                    </div>\\n                                    <label string=\\"Until\\" for=\\"end_type\\" class=\\"fw-bold text-900\\" invisible=\\"not recurrency\\"/>\\n                                    <div class=\\"d-flex gap-2\\" invisible=\\"not recurrency\\">\\n                                        <field name=\\"end_type\\" class=\\"oe_inline w-auto\\" nolabel=\\"1\\" required=\\"recurrency\\" readonly=\\"not user_can_edit\\"/>\\n                                        <field name=\\"count\\" class=\\"oe_inline w-auto\\" nolabel=\\"1\\" invisible=\\"end_type != 'count'\\" required=\\"recurrency\\" readonly=\\"not user_can_edit\\"/>\\n                                        <field name=\\"until\\" class=\\"oe_inline w-auto\\" nolabel=\\"1\\" invisible=\\"end_type != 'end_date'\\" readonly=\\"not user_can_edit\\" required=\\"recurrency and end_type == 'end_date'\\" placeholder=\\"e.g: 12/31/2023\\"/>\\n                                    </div>\\n                                    <field name=\\"event_tz\\" invisible=\\"not recurrency\\" readonly=\\"not user_can_edit\\"/>\\n                                </group>\\n                            </group>\\n                        </page>\\n                        <page name=\\"page_invitations\\" string=\\"Invitations\\" groups=\\"base.group_no_one\\" invisible=\\"not user_can_edit\\">\\n                            <button name=\\"action_sendmail\\" type=\\"object\\" string=\\"Send Invitations\\" icon=\\"fa-envelope\\" class=\\"oe_link\\"/>\\n                            <field name=\\"attendee_ids\\" widget=\\"one2many\\" mode=\\"list,kanban\\" readonly=\\"1\\">\\n                                <list string=\\"Invitation details\\" editable=\\"top\\" create=\\"false\\" delete=\\"false\\">\\n                                    <field name=\\"partner_id\\"/>\\n                                    <field name=\\"email\\" widget=\\"email\\"/>\\n                                    <field name=\\"phone\\" widget=\\"phone\\"/>\\n                                    <field name=\\"state\\"/>\\n                                    <button name=\\"do_tentative\\" invisible=\\"state not in ('needsAction', 'declined', 'accepted')\\" string=\\"Uncertain\\" type=\\"object\\" icon=\\"fa-asterisk\\"/>\\n                                    <button name=\\"do_accept\\" string=\\"Accept\\" invisible=\\"state not in ('needsAction', 'tentative', 'declined')\\" type=\\"object\\" icon=\\"fa-check text-success\\"/>\\n                                    <button name=\\"do_decline\\" string=\\"Decline\\" invisible=\\"state not in ('needsAction', 'tentative', 'accepted')\\" type=\\"object\\" icon=\\"fa-times-circle text-danger\\"/>\\n                                </list>\\n                                <kanban class=\\"o_kanban_mobile\\" create=\\"false\\" delete=\\"false\\">\\n\\n                                    <templates>\\n                                        <t t-name=\\"card\\">\\n                                            <field name=\\"partner_id\\"/>\\n                                            <field name=\\"email\\" widget=\\"email\\"/>\\n                                            <span>Status: <field name=\\"state\\"/></span>\\n                                            <footer class=\\"justify-content-end\\">\\n                                                <button name=\\"do_tentative\\" invisible=\\"state not in ('needsAction', 'declined', 'accepted')\\" string=\\"Uncertain\\" type=\\"object\\" class=\\"btn fa fa-asterisk\\"/>\\n                                                <button name=\\"do_accept\\" invisible=\\"state not in ('needsAction', 'tentative', 'declined')\\" string=\\"Accept\\" type=\\"object\\" class=\\"btn fa fa-check text-success\\"/>\\n                                                <button name=\\"do_decline\\" invisible=\\"state not in ('needsAction', 'tentative', 'accepted')\\" string=\\"Decline\\" type=\\"object\\" class=\\"btn fa fa-times-circle text-danger\\"/>\\n                                            </footer>\\n                                        </t>\\n                                    </templates>\\n                                </kanban>\\n                            </field>\\n                        </page>\\n                    </notebook>\\n                </sheet>\\n                <chatter/>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Meetings" class="o_calendar_event_form_view" js_class="calendar_form">\n                <header>\n                    <button name="action_open_composer" class="btn btn-primary" type="object" string="Send email" invisible="not user_can_edit"/>\n                </header>\n                <div invisible="not recurrence_id" class="alert alert-info oe_edit_only" role="status">\n                    <p>Edit recurring event</p>\n                    <field name="recurrence_update" widget="radio"/>\n                </div>\n                <sheet>\n                    <div class="oe_button_box" name="button_box">\n                        <button icon="fa-bars" type="object" name="action_open_calendar_event" invisible="not (res_id and res_model_name)">\n                            <field name="res_model_name"/>\n                        </button>\n                    </div>\n                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                    <field name="active" invisible="1"/>\n                    <field name="user_can_edit" invisible="1"/>\n                    <field name="invalid_email_partner_ids" invisible="1"/> <!-- this field will be used in\n                        many2many_attendees widget -->\n                    <div class="oe_title mb-3">\n                        <div>\n                            <label for="name"/>\n                        </div>\n                        <h1>\n                            <field name="name" placeholder="e.g. Business Lunch" readonly="not user_can_edit"/>\n                        </h1>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="start_date" widget="daterange" options="{'end_date_field': 'stop_date'}" invisible="not allday" required="allday" readonly="not user_can_edit"/>\n                            <field name="start" widget="daterange" options="{'end_date_field': 'stop'}" invisible="allday" required="not allday" readonly="not user_can_edit"/>\n                            <field name="stop_date" invisible="1"/>\n                            <field name="stop" invisible="1"/>\n                            <field name="unavailable_partner_ids" invisible="1"/> <!-- this field will be used in many2many_attendees widget -->\n                            <label for="duration" class="fw-bold text-900 opacity-100"/>\n                            <div class="d-flex gap-2">\n                                <div class="d-flex align-items-start" invisible="allday">\n                                    <field name="duration" widget="float_time" string="Duration" class="oe_inline pe-2" readonly="(id and recurrency) or not user_can_edit"/>\n                                    <span> hours</span>\n                                </div>\n                                <span invisible="allday" style="white-space: pre;"> or </span>\n                                <div class="d-flex gap-2">\n                                    <label for="allday" class=""/>\n                                    <field name="allday" class="oe_inline" widget="boolean_toggle" force_save="1" options="{'autosave': False}" readonly="not user_can_edit"/>\n                                </div>\n                            </div>\n\n                            <field name="location" placeholder="Online Meeting" readonly="not user_can_edit"/>\n                            <label for="videocall_location" class="opacity-100"/>\n                            <div name="videocall_location_div">\n                                <div class="d-flex">\n                                    <field name="videocall_location" string="Video Link" widget="CopyClipboardChar" force_save="1" class="mb-0" readonly="videocall_source == 'discuss' or not user_can_edit"/>\n                                    <div class="d-flex flex-nowrap">\n                                        <button name="clear_videocall_location" type="object" class="btn btn-link btn-lg ms-1 px-1 py-0" invisible="not videocall_location or not user_can_edit" context="{'recurrence_update': recurrence_update}">\n                                            <span title="Clear meeting" class="fa fa-times"/>\n                                        </button>\n                                        <button name="action_join_video_call" class="btn btn-link btn-lg px-1 py-0" help="Join Video Call" type="object" invisible="not videocall_location or not user_can_edit">\n                                            <span title="Join video call" class="fa fa-sign-in"/>\n                                        </button>\n                                        <button name="set_discuss_videocall_location" type="object" class="btn btn-link btn-sm px-0 text-nowrap" invisible="videocall_location or not user_can_edit" context="{'recurrence_update': recurrence_update}">\n                                            <span class="fa fa-plus"/><span> Odoo meeting</span>\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                            <field name="res_id" string="Linked to" invisible="not res_id" readonly="1"/>\n                            <field name="res_model" invisible="1"/>\n                            <field name="videocall_source" invisible="1"/>\n                            <field name="access_token" invisible="1" force_save="1"/>\n                        </group>\n                        <group>\n                            <field name="current_status" class="o_calendar_form_status_selection_badge" string="Going?" widget="selection_badge" options="{'horizontal': true, 'size': 'sm'}" required="should_show_status" readonly="not should_show_status" invisible="not should_show_status"/>\n                            <label for="privacy" string="Status"/>\n                            <div class="d-flex">\n                                <field name="show_as" class="oe_inline me-2" readonly="not user_can_edit" nolabel="1"/>\n                                <field name="privacy" class="oe_inline me-2" readonly="not user_can_edit" nolabel="1" placeholder="User default" help="Set whether you're available for other simultaneous events and the privacy of this event to others. Manage your default privacy in your user preferences."/>\n                            </div>\n                            <field name="should_show_status" invisible="1"/>\n                            <div class="d-flex mb-2" colspan="2">\n                                <div>\n                                    <span class="fw-medium o_form_label">\n                                        <field name="attendees_count" class="w-auto oe_inline" nolabel="1"/><span> guests</span>\n                                    </span>\n                                    <div invisible="not accepted_count and not tentative_count and not declined_count and not awaiting_count" class="text-muted fw-normal">\n                                        <span invisible="not accepted_count" class="me-1">\n                                            <field name="accepted_count" class="w-auto oe_inline" nolabel="1"/> Yes\n                                        </span>\n                                        <span invisible="not tentative_count" class="me-1">\n                                            <field name="tentative_count" class="w-auto oe_inline" nolabel="1"/> Maybe\n                                        </span>\n                                        <span invisible="not declined_count" class="me-1">\n                                            <field name="declined_count" class="w-auto oe_inline" nolabel="1"/> No\n                                        </span>\n                                        <span invisible="not awaiting_count" class="me-1">\n                                            <field name="awaiting_count" class="w-auto oe_inline" nolabel="1"/> Awaiting\n                                        </span>\n                                    </div>\n                                </div>\n                                <div name="send_buttons" class="d-flex gap-2 mb-auto ms-4">\n                                    <button name="action_open_composer" help="Send Email to attendees" type="object" string=" EMAIL" icon="fa-envelope" invisible="not user_can_edit"/>\n                                </div>\n                            </div>\n                            <div class="d-flex align-items-baseline" colspan="2">\n                                <field name="partner_ids" widget="many2manyattendee" placeholder="Select attendees..." options="{'no_quick_create': True}" context="{'form_view_ref': 'base.view_partner_simple_form'}" domain="[('type','!=','private')]" class="oe_inline" readonly="not user_can_edit"/>\n                            </div>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page name="notes" string="Notes">\n                            <field name="notes" type="html" options="{'resizable': false}" readonly="not user_can_edit" placeholder="Add notes about this meeting..."/>\n                        </page>\n                        <page name="options" string="Options">\n                            <group>\n                                <group>\n                                    <field name="user_id" widget="many2one_avatar_user" readonly="not user_can_edit"/>\n                                    <field name="categ_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" readonly="not user_can_edit"/>\n                                    <label for="description" string="Calendar description" colspan="2"/>\n                                    <field name="description" colspan="2" nolabel="1" class="border border-1 rounded" options="{'height': 120}" placeholder="Add description" readonly="not user_can_edit"/>\n                                </group>\n                                <group>\n                                    <field name="alarm_ids" widget="many2many_tags" options="{'no_quick_create': True}" readonly="not user_can_edit"/>\n                                    <field name="recurrence_id" invisible="1"/>\n                                    <field name="rrule_type" invisible="1"/>\n                                    <label for="recurrency" string="Recurrent"/>\n                                    <div class="d-flex align-items-baseline gap-1">\n                                        <field name="recurrency" widget="boolean_toggle" options="{'autosave': False}" class="w-auto" readonly="not user_can_edit"/>\n                                        <span invisible="not recurrency" class="mx-1">Repeat:</span>\n                                        <field name="rrule_type_ui" class="w-auto o_input" invisible="not recurrency" required="recurrency" readonly="not user_can_edit"/>\n                                    </div>\n                                    <label for="interval" class="fw-bold text-900" invisible="not recurrency or rrule_type_ui != 'custom'"/>\n                                    <div class="d-flex gap-1" invisible="not recurrency or rrule_type_ui != 'custom'">\n                                        <field name="interval" string="Repeat every" class="oe_inline w-auto o_input_5ch"/>\n                                        <field name="rrule_type" nolabel="1" class="oe_inline" required="rrule_type_ui == 'custom'"/>\n                                    </div>\n                                    <span class="fw-bold text-nowrap" invisible="rrule_type_ui not in ['weekly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'weekly')">Repeat on</span>\n                                    <div invisible="rrule_type_ui not in ['weekly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'weekly')"><widget name="calendar_week_days" readonly="not user_can_edit"/></div>\n                                    <field name="recurrence_id" invisible="1"/>\n\n                                    <label string="Day of Month" for="month_by" class="fw-bold text-900" style="width: fit-content;" invisible="rrule_type_ui not in ['monthly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly')"/>\n                                    <div class="d-flex gap-2" invisible="rrule_type_ui not in ['monthly', 'custom'] or (rrule_type_ui == 'custom' and rrule_type != 'monthly')">\n                                        <field name="month_by" nolabel="1" class="oe_inline w-auto" required="rrule_type_ui == 'monthly' or rrule_type == 'monthly'"/>\n                                        <field name="day" nolabel="1" class="oe_inline w-auto" required="(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'date'" invisible="month_by != 'date'"/>\n                                        <field name="byday" string="The" class="oe_inline w-auto" nolabel="1" required="(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'day'" invisible="month_by != 'day'"/>\n                                        <field name="weekday" nolabel="1" class="oe_inline w-auto" required="(rrule_type_ui == 'monthly' or rrule_type == 'monthly') and month_by == 'day'" invisible="month_by != 'day'"/>\n                                    </div>\n                                    <label string="Until" for="end_type" class="fw-bold text-900" invisible="not recurrency"/>\n                                    <div class="d-flex gap-2" invisible="not recurrency">\n                                        <field name="end_type" class="oe_inline w-auto" nolabel="1" required="recurrency" readonly="not user_can_edit"/>\n                                        <field name="count" class="oe_inline w-auto" nolabel="1" invisible="end_type != 'count'" required="recurrency" readonly="not user_can_edit"/>\n                                        <field name="until" class="oe_inline w-auto" nolabel="1" invisible="end_type != 'end_date'" readonly="not user_can_edit" required="recurrency and end_type == 'end_date'" placeholder="e.g: 12/31/2023"/>\n                                    </div>\n                                    <field name="event_tz" invisible="not recurrency" readonly="not user_can_edit"/>\n                                </group>\n                            </group>\n                        </page>\n                        <page name="page_invitations" string="Invitations" groups="base.group_no_one" invisible="not user_can_edit">\n                            <button name="action_sendmail" type="object" string="Send Invitations" icon="fa-envelope" class="oe_link"/>\n                            <field name="attendee_ids" widget="one2many" mode="list,kanban" readonly="1">\n                                <list string="Invitation details" editable="top" create="false" delete="false">\n                                    <field name="partner_id"/>\n                                    <field name="email" widget="email"/>\n                                    <field name="phone" widget="phone"/>\n                                    <field name="state"/>\n                                    <button name="do_tentative" invisible="state not in ('needsAction', 'declined', 'accepted')" string="Uncertain" type="object" icon="fa-asterisk"/>\n                                    <button name="do_accept" string="Accept" invisible="state not in ('needsAction', 'tentative', 'declined')" type="object" icon="fa-check text-success"/>\n                                    <button name="do_decline" string="Decline" invisible="state not in ('needsAction', 'tentative', 'accepted')" type="object" icon="fa-times-circle text-danger"/>\n                                </list>\n                                <kanban class="o_kanban_mobile" create="false" delete="false">\n\n                                    <templates>\n                                        <t t-name="card">\n                                            <field name="partner_id"/>\n                                            <field name="email" widget="email"/>\n                                            <span>Status: <field name="state"/></span>\n                                            <footer class="justify-content-end">\n                                                <button name="do_tentative" invisible="state not in ('needsAction', 'declined', 'accepted')" string="Uncertain" type="object" class="btn fa fa-asterisk"/>\n                                                <button name="do_accept" invisible="state not in ('needsAction', 'tentative', 'declined')" string="Accept" type="object" class="btn fa fa-check text-success"/>\n                                                <button name="do_decline" invisible="state not in ('needsAction', 'tentative', 'accepted')" string="Decline" type="object" class="btn fa fa-times-circle text-danger"/>\n                                            </footer>\n                                        </t>\n                                    </templates>\n                                </kanban>\n                            </field>\n                        </page>\n                    </notebook>\n                </sheet>\n                <chatter/>\n            </form>\n        	f	t	2026-09-05 15:59:46.487049	2026-09-05 15:59:46.487049	\N
