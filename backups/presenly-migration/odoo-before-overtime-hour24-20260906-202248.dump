1159	16	\N	1	1	Project Update Description	\N	project.project_update_default_description	qweb	project/views/project_update_templates.xml	primary	{"en_US": "<t name=\\"Project Update Description\\" t-name=\\"project.project_update_default_description\\">\\n<!--As this template is rendered in an html field, the spaces may be interpreted as nbsp while editing. -->\\n<div name=\\"summary\\">\\n<br/><h1 style=\\"font-weight: bolder;\\">Summary</h1>\\n<br/><p>How’s this project going?</p><br/><br/>\\n</div>\\n\\n<div name=\\"activities\\" t-if=\\"show_activities\\">\\n<h1 style=\\"font-weight: bolder;\\">Activities</h1>\\n</div>\\n\\n<div name=\\"profitability\\" t-if=\\"show_profitability\\">\\n<t t-if=\\"project.account_id\\" name=\\"costs\\">\\n<h3 style=\\"font-weight: bolder\\"><u>Profitability</u></h3>\\n\\n<div name=\\"profitability_detail\\" class=\\"mt-4\\">\\n<table class=\\"table table-striped\\" t-if=\\"profitability['revenues']['data']\\">\\n<thead class=\\"border-2 border-start-0 border-end-0\\">\\n<tr>\\n<th class=\\"fw-bolder\\" style=\\"width: 55%\\">Revenues</th>\\n<th class=\\"fw-bolder text-end\\" style=\\"width: 15%\\">Expected</th>\\n<th class=\\"fw-bolder text-end\\" style=\\"width: 15%\\">To Invoice</th>\\n<th class=\\"fw-bolder text-end\\" style=\\"width: 15%\\">Invoiced</th>\\n</tr>\\n</thead>\\n<tbody>\\n<tr t-foreach=\\"profitability['revenues']['data']\\" t-as=\\"revenue\\">\\n<tr class=\\"revenue_data\\">\\n<td t-out=\\"profitability['labels'][revenue['id']]\\"/>\\n<td class=\\"text-end\\" t-out=\\"format_monetary(revenue['invoiced'] + revenue['to_invoice'])\\"/>\\n<td class=\\"text-end\\" t-out=\\"format_monetary(revenue['to_invoice'])\\"/>\\n<td class=\\"text-end\\" t-out=\\"format_monetary(revenue['invoiced'])\\"/>\\n</tr>\\n</tr>\\n<tfoot>\\n<td class=\\"fw-bolder\\">Total Revenues</td>\\n<td class=\\"fw-bolder text-end\\" t-out=\\"format_monetary(profitability['revenues']['total']['invoiced'] + profitability['revenues']['total']['to_invoice'])\\"/>\\n<td class=\\"fw-bolder text-end\\" t-out=\\"format_monetary(profitability['revenues']['total']['to_invoice'])\\"/>\\n<td class=\\"fw-bolder text-end\\" t-out=\\"format_monetary(profitability['revenues']['total']['invoiced'])\\"/>\\n</tfoot>\\n</tbody>\\n</table>\\n\\n<table class=\\"table table-striped mt-4 table-bordered\\" t-if=\\"profitability['costs']['data']\\">\\n<thead>\\n<tr>\\n<th class=\\"fw-bolder\\" style=\\"width: 55%\\">Costs</th>\\n<th class=\\"fw-bolder text-end\\" style=\\"width: 15%\\">Expected</th>\\n<th class=\\"fw-bolder text-end\\" style=\\"width: 15%\\">To Bill</th>\\n<th class=\\"fw-bolder text-end\\" style=\\"width: 15%\\">Billed</th>\\n</tr>\\n</thead>\\n<tbody>\\n<tr t-foreach=\\"profitability['costs']['data']\\" t-as=\\"cost\\">\\n<td t-out=\\"profitability['labels'][cost['id']]\\"/>\\n<td class=\\"text-end\\" t-out=\\"format_monetary(cost['billed'] + cost['to_bill'])\\"/>\\n<td class=\\"text-end\\" t-out=\\"format_monetary(cost['to_bill'])\\"/>\\n<td class=\\"text-end\\" t-out=\\"format_monetary(cost['billed'])\\"/>\\n</tr>\\n</tbody>\\n<tr>\\n<td class=\\"fw-bolder\\">Total Costs</td>\\n<td class=\\"fw-bolder text-end\\" t-out=\\"format_monetary(profitability['costs']['total']['billed'] + profitability['costs']['total']['to_bill'])\\"/>\\n<td class=\\"fw-bolder text-end\\" t-out=\\"format_monetary(profitability['costs']['total']['to_bill'])\\"/>\\n<td class=\\"fw-bolder text-end\\" t-out=\\"format_monetary(profitability['costs']['total']['billed'])\\"/>\\n</tr>\\n<tr t-if=\\"profitability['costs']['data'] and profitability['revenues']['data']\\">\\n<td class=\\"fw-bolder align-middle\\">Total</td>\\n<td t-attf-class=\\"#{'text-danger' if profitability['total']['margin'] &lt; 0 else 'text-success'}\\" style=\\"text-align: right\\">\\n<t t-out=\\"format_monetary(profitability['total']['margin'])\\"/><br/>\\n<t t-if=\\"profitability['expected_percentage']\\">\\n<t t-out=\\"profitability['expected_percentage']\\"/><t>%</t>\\n</t>\\n</td>\\n<td t-attf-class=\\"#{'text-danger' if profitability['to_bill_to_invoice'] &lt; 0 else 'text-success'}\\" style=\\"text-align: right\\">\\n<t t-out=\\"format_monetary(profitability['to_bill_to_invoice'])\\"/><br/>\\n<t t-if=\\"profitability['to_bill_to_invoice_percentage']\\">\\n<t t-out=\\"profitability['to_bill_to_invoice_percentage']\\"/><t>%</t>\\n</t>\\n</td>\\n<td t-attf-class=\\"#{'text-danger' if profitability['billed_invoiced'] &lt; 0 else 'text-success'}\\" style=\\"text-align: right\\">\\n<t t-out=\\"format_monetary(profitability['billed_invoiced'])\\"/><br/>\\n<t t-if=\\"profitability['billed_invoiced_percentage']\\">\\n<t t-out=\\"profitability['billed_invoiced_percentage']\\"/><t>%</t>\\n</t>\\n</td>\\n</tr>\\n</table>\\n</div>\\n</t>\\n</div>\\n\\n<div name=\\"milestone\\" t-if=\\"milestones['show_section']\\">\\n<br/>\\n<h3 style=\\"font-weight: bolder\\"><u>Milestones</u></h3>\\n\\n<ul class=\\"o_checklist\\" t-if=\\"milestones['list']\\">\\n<t t-foreach=\\"milestones['list']\\" t-as=\\"milestone\\">\\n<li t-att-class=\\"milestone['is_reached'] and 'o_checked'\\" t-attf-id=\\"checkId-{{milestone_index}}\\">\\n<t t-out=\\"milestone['name']\\"/>\\n<span t-if=\\"milestone['is_deadline_exceeded']\\"><font style=\\"color: rgb(255, 0, 0);\\"><t t-call=\\"project.milestone_deadline\\"/></font></span>\\n<span t-elif=\\"not milestone['can_be_marked_as_done']\\"><font style=\\"color: rgb(190, 190, 190);\\"><t t-set=\\"color_level\\" t-value=\\"64\\"/><t t-call=\\"project.milestone_deadline\\"/></font></span>\\n<span t-else=\\"\\"><t t-set=\\"color_level\\" t-value=\\"128\\"/><t t-call=\\"project.milestone_deadline\\"/></span>\\n</li>\\n</t>\\n</ul>\\n\\n<t t-if=\\"milestones['updated']\\">\\n<t t-if=\\"milestones['last_update_date']\\">Since <t t-out=\\"milestones['last_update_date']\\" t-options=\\"{&quot;widget&quot;: &quot;date&quot;}\\"/> (last project update), </t>\\n<t t-if=\\"len(milestones['updated']) &gt; 1\\">the deadline for the following milestones has been updated:</t>\\n<t t-else=\\"\\">the deadline for the following milestone has been updated:</t>\\n<ul>\\n<t t-foreach=\\"milestones['updated']\\" t-as=\\"milestone\\">\\n<li>\\n<t t-out=\\"milestone['name']\\"/> (<t t-out=\\"milestone['old_value']\\" t-options=\\"{&quot;widget&quot;: &quot;date&quot;}\\"/> =&gt; <t t-out=\\"milestone['new_value']\\" t-options=\\"{&quot;widget&quot;: &quot;date&quot;}\\"/>)\\n</li>\\n</t>\\n</ul>\\n</t>\\n\\n<t t-if=\\"milestones['created']\\">\\n<t t-if=\\"len(milestones['created']) &gt; 1\\">The following milestones have been added:</t>\\n<t t-else=\\"\\">The following milestone has been added:</t>\\n<ul>\\n<t t-foreach=\\"milestones['created']\\" t-as=\\"milestone\\">\\n<li>\\n<t t-out=\\"milestone['name']\\"/>\\n<span t-if=\\"milestone['is_deadline_exceeded']\\"><font style=\\"color: rgb(255, 0, 0);\\"><t t-call=\\"project.milestone_deadline\\"/></font></span>\\n<span t-else=\\"\\"><font style=\\"color: rgb(190, 190, 190);\\"><t t-set=\\"color_level\\" t-value=\\"128\\"/><t t-call=\\"project.milestone_deadline\\"/></font></span>\\n</li>\\n</t>\\n</ul>\\n</t>\\n</div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Project Update Description" t-name="project.project_update_default_description">\n<!--As this template is rendered in an html field, the spaces may be interpreted as nbsp while editing. -->\n<div name="summary">\n<br/><h1 style="font-weight: bolder;">Summary</h1>\n<br/><p>How’s this project going?</p><br/><br/>\n</div>\n\n<div name="activities" t-if="show_activities">\n<h1 style="font-weight: bolder;">Activities</h1>\n</div>\n\n<div name="profitability" t-if="show_profitability">\n<t t-if="project.account_id" name="costs">\n<h3 style="font-weight: bolder"><u>Profitability</u></h3>\n\n<div name="profitability_detail" class="mt-4">\n<table class="table table-striped" t-if="profitability['revenues']['data']">\n<thead class="border-2 border-start-0 border-end-0">\n<tr>\n<th class="fw-bolder" style="width: 55%">Revenues</th>\n<th class="fw-bolder text-end" style="width: 15%">Expected</th>\n<th class="fw-bolder text-end" style="width: 15%">To Invoice</th>\n<th class="fw-bolder text-end" style="width: 15%">Invoiced</th>\n</tr>\n</thead>\n<tbody>\n<tr t-foreach="profitability['revenues']['data']" t-as="revenue">\n<tr class="revenue_data">\n<td t-out="profitability['labels'][revenue['id']]"/>\n<td class="text-end" t-out="format_monetary(revenue['invoiced'] + revenue['to_invoice'])"/>\n<td class="text-end" t-out="format_monetary(revenue['to_invoice'])"/>\n<td class="text-end" t-out="format_monetary(revenue['invoiced'])"/>\n</tr>\n</tr>\n<tfoot>\n<td class="fw-bolder">Total Revenues</td>\n<td class="fw-bolder text-end" t-out="format_monetary(profitability['revenues']['total']['invoiced'] + profitability['revenues']['total']['to_invoice'])"/>\n<td class="fw-bolder text-end" t-out="format_monetary(profitability['revenues']['total']['to_invoice'])"/>\n<td class="fw-bolder text-end" t-out="format_monetary(profitability['revenues']['total']['invoiced'])"/>\n</tfoot>\n</tbody>\n</table>\n\n<table class="table table-striped mt-4 table-bordered" t-if="profitability['costs']['data']">\n<thead>\n<tr>\n<th class="fw-bolder" style="width: 55%">Costs</th>\n<th class="fw-bolder text-end" style="width: 15%">Expected</th>\n<th class="fw-bolder text-end" style="width: 15%">To Bill</th>\n<th class="fw-bolder text-end" style="width: 15%">Billed</th>\n</tr>\n</thead>\n<tbody>\n<tr t-foreach="profitability['costs']['data']" t-as="cost">\n<td t-out="profitability['labels'][cost['id']]"/>\n<td class="text-end" t-out="format_monetary(cost['billed'] + cost['to_bill'])"/>\n<td class="text-end" t-out="format_monetary(cost['to_bill'])"/>\n<td class="text-end" t-out="format_monetary(cost['billed'])"/>\n</tr>\n</tbody>\n<tr>\n<td class="fw-bolder">Total Costs</td>\n<td class="fw-bolder text-end" t-out="format_monetary(profitability['costs']['total']['billed'] + profitability['costs']['total']['to_bill'])"/>\n<td class="fw-bolder text-end" t-out="format_monetary(profitability['costs']['total']['to_bill'])"/>\n<td class="fw-bolder text-end" t-out="format_monetary(profitability['costs']['total']['billed'])"/>\n</tr>\n<tr t-if="profitability['costs']['data'] and profitability['revenues']['data']">\n<td class="fw-bolder align-middle">Total</td>\n<td t-attf-class="#{'text-danger' if profitability['total']['margin'] &lt; 0 else 'text-success'}" style="text-align: right">\n<t t-out="format_monetary(profitability['total']['margin'])"/><br/>\n<t t-if="profitability['expected_percentage']">\n<t t-out="profitability['expected_percentage']"/><t>%</t>\n</t>\n</td>\n<td t-attf-class="#{'text-danger' if profitability['to_bill_to_invoice'] &lt; 0 else 'text-success'}" style="text-align: right">\n<t t-out="format_monetary(profitability['to_bill_to_invoice'])"/><br/>\n<t t-if="profitability['to_bill_to_invoice_percentage']">\n<t t-out="profitability['to_bill_to_invoice_percentage']"/><t>%</t>\n</t>\n</td>\n<td t-attf-class="#{'text-danger' if profitability['billed_invoiced'] &lt; 0 else 'text-success'}" style="text-align: right">\n<t t-out="format_monetary(profitability['billed_invoiced'])"/><br/>\n<t t-if="profitability['billed_invoiced_percentage']">\n<t t-out="profitability['billed_invoiced_percentage']"/><t>%</t>\n</t>\n</td>\n</tr>\n</table>\n</div>\n</t>\n</div>\n\n<div name="milestone" t-if="milestones['show_section']">\n<br/>\n<h3 style="font-weight: bolder"><u>Milestones</u></h3>\n\n<ul class="o_checklist" t-if="milestones['list']">\n<t t-foreach="milestones['list']" t-as="milestone">\n<li t-att-class="milestone['is_reached'] and 'o_checked'" t-attf-id="checkId-{{milestone_index}}">\n<t t-out="milestone['name']"/>\n<span t-if="milestone['is_deadline_exceeded']"><font style="color: rgb(255, 0, 0);"><t t-call="project.milestone_deadline"/></font></span>\n<span t-elif="not milestone['can_be_marked_as_done']"><font style="color: rgb(190, 190, 190);"><t t-set="color_level" t-value="64"/><t t-call="project.milestone_deadline"/></font></span>\n<span t-else=""><t t-set="color_level" t-value="128"/><t t-call="project.milestone_deadline"/></span>\n</li>\n</t>\n</ul>\n\n<t t-if="milestones['updated']">\n<t t-if="milestones['last_update_date']">Since <t t-out="milestones['last_update_date']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/> (last project update), </t>\n<t t-if="len(milestones['updated']) &gt; 1">the deadline for the following milestones has been updated:</t>\n<t t-else="">the deadline for the following milestone has been updated:</t>\n<ul>\n<t t-foreach="milestones['updated']" t-as="milestone">\n<li>\n<t t-out="milestone['name']"/> (<t t-out="milestone['old_value']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/> =&gt; <t t-out="milestone['new_value']" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>)\n</li>\n</t>\n</ul>\n</t>\n\n<t t-if="milestones['created']">\n<t t-if="len(milestones['created']) &gt; 1">The following milestones have been added:</t>\n<t t-else="">The following milestone has been added:</t>\n<ul>\n<t t-foreach="milestones['created']" t-as="milestone">\n<li>\n<t t-out="milestone['name']"/>\n<span t-if="milestone['is_deadline_exceeded']"><font style="color: rgb(255, 0, 0);"><t t-call="project.milestone_deadline"/></font></span>\n<span t-else=""><font style="color: rgb(190, 190, 190);"><t t-set="color_level" t-value="128"/><t t-call="project.milestone_deadline"/></font></span>\n</li>\n</t>\n</ul>\n</t>\n</div>\n    </t>\n	f	t	2026-09-05 15:59:52.742806	2026-09-05 15:59:52.742806	f
