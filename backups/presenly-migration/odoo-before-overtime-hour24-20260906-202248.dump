"?>\n<data name="Survey User Input Session" inherit_id="web.frontend_layout" primary="True">\n        <xpath expr="//head" position="before">\n            <!--TODO DBE Fix me : If one day, there is a survey_livechat bridge module, put this in that module-->\n            <t t-set="no_livechat" t-value="True"/>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']" position="attributes">\n            <attribute name="t-att-style" add="(('background-image: url(' + survey.session_question_id.background_image_url + ');')                              if survey.session_question_id and survey.session_question_id.background_image_url                              else ('background-image: url(' + survey.background_image_url + ');')                              if survey.background_image_url                              else 'background-image: url(\\'/survey/static/src/img/survey_background_sample.svg\\')')"/>\n            <attribute name="t-att-class" add="'o_survey_background'"/>\n        </xpath>\n        <xpath expr="//head/t[@t-call-assets][last()]" position="after">\n            <t t-call-assets="survey.survey_assets" lazy_load="True"/>\n            <t t-call-assets="survey.survey_user_input_session_assets" lazy_load="True"/>\n        </xpath>\n        <xpath expr="//header" position="before">\n            <t t-set="no_header" t-value="True"/>\n            <t t-set="no_footer" t-value="True"/>\n        </xpath>\n        <xpath expr="//header" position="after">\n            <div id="wrap" class="oe_structure oe_empty"/>\n        </xpath>\n    <xpath expr="." position="attributes"><attribute name="t-name">survey.user_input_session</attribute></xpath></data>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
