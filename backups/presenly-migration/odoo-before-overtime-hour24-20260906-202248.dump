490	16	185	1	1	Main Frontend Layout	\N	portal.frontend_layout	qweb	portal/views/portal_templates.xml	extension	{"en_US": "<data name=\\"Main Frontend Layout\\" inherit_id=\\"web.frontend_layout\\">\\n        <xpath expr=\\"//html\\" position=\\"attributes\\">\\n            <attribute name=\\"t-att-dir\\" add=\\"request.env['res.lang']._get_data(code=request.env.lang).direction\\" separator=\\" \\"/>\\n        </xpath>\\n        <xpath expr=\\"//div[@id='wrapwrap']\\" position=\\"attributes\\">\\n            <attribute name=\\"t-attf-class\\" add=\\"#{request.env['res.lang']._get_data(code=request.env.lang).direction == 'rtl' and 'o_rtl' or ''}\\" separator=\\" \\"/>\\n            <attribute name=\\"t-attf-class\\" add=\\"#{'o_portal' if is_portal else ''}\\" separator=\\" \\"/>\\n        </xpath>\\n        <xpath expr=\\"//div[@id='wrapwrap']/header\\" position=\\"before\\">\\n            <a class=\\"o_skip_to_content btn btn-primary rounded-0 visually-hidden-focusable position-absolute start-0\\" href=\\"#wrap\\" groups=\\"!base.group_user\\">Skip to Content</a>\\n        </xpath>\\n        <xpath expr=\\"//div[@id='wrapwrap']/header/img\\" position=\\"replace\\">\\n            <nav class=\\"navbar navbar-expand navbar-light bg-light\\">\\n                <div class=\\"container\\">\\n                    <a href=\\"/\\" class=\\"navbar-brand logo\\">\\n                        <img t-att-src=\\"'/logo.png?company=%s' % res_company.id\\" t-att-alt=\\"'Logo of %s' % res_company.name\\" t-att-title=\\"res_company.name\\"/>\\n                    </a>\\n                    <ul id=\\"top_menu\\" class=\\"nav navbar-nav ms-auto\\">\\n                        <t t-call=\\"portal.placeholder_user_sign_in\\">\\n                            <t t-set=\\"_item_class\\" t-value=\\"'nav-item'\\"/>\\n                            <t t-set=\\"_link_class\\" t-value=\\"'nav-link'\\"/>\\n                        </t>\\n                        <t t-call=\\"portal.user_dropdown\\">\\n                            <t t-set=\\"_user_name\\" t-value=\\"true\\"/>\\n                            <t t-set=\\"_item_class\\" t-value=\\"'nav-item dropdown'\\"/>\\n                            <t t-set=\\"_link_class\\" t-value=\\"'nav-link'\\"/>\\n                            <t t-set=\\"_dropdown_menu_class\\" t-value=\\"'dropdown-menu-end'\\"/>\\n                        </t>\\n                    </ul>\\n                </div>\\n            </nav>\\n        </xpath>\\n        <xpath expr=\\"//div[@id='wrapwrap']/main/t[@t-out='0']\\" position=\\"before\\">\\n            <div t-if=\\"o_portal_fullwidth_alert\\" class=\\"container mt-3\\">\\n                <div class=\\"alert alert-info alert-dismissible fade show d-print-none css_editable_mode_hidden\\">\\n                    <t t-out=\\"o_portal_fullwidth_alert\\"/>\\n                </div>\\n            </div>\\n        </xpath>\\n        <xpath expr=\\"//head/meta\\" position=\\"after\\">\\n            <t t-if=\\"preview_object\\">\\n                <!-- Remove seo_object to not define og and twitter tags twice when wesbite is installed -->\\n                <t t-set=\\"seo_object\\" t-value=\\"False\\"/>\\n                <t t-set=\\"company\\" t-value=\\"preview_object.company_id or request.env.company\\"/>\\n                <t t-set=\\"not_uses_default_logo\\" t-value=\\"company and not company.uses_default_logo\\"/>\\n                <meta property=\\"og:title\\" t-att-content=\\"preview_object.name\\"/>\\n                <meta property=\\"og:description\\" t-att-content=\\"preview_object.description.striptags() if preview_object.description else ''\\"/>\\n                <meta property=\\"og:site_name\\" t-att-content=\\"company.name if company else ''\\"/>\\n                <t t-if=\\"not_uses_default_logo\\">\\n                    <meta property=\\"og:image\\" t-attf-content=\\"/web/binary/company_logo?company={{ company.id }}\\"/>\\n                </t>\\n                <meta property=\\"og:image:width\\" content=\\"300\\"/>\\n                <meta property=\\"og:image:height\\" content=\\"200\\"/>\\n                <meta name=\\"twitter:card\\" content=\\"summary_large_image\\"/>\\n                <meta property=\\"twitter:title\\" t-att-content=\\"preview_object.name\\"/>\\n                <meta property=\\"twitter:description\\" t-att-content=\\"preview_object.description.striptags() if preview_object.description else ''\\"/>\\n                <t t-if=\\"not_uses_default_logo\\">\\n                    <meta property=\\"twitter:image\\" t-attf-content=\\"/web/binary/company_logo?company={{ company.id }}\\"/>\\n                </t>\\n            </t>\\n        </xpath>\\n    </data>"}	<?xml version="1.0"?>\n<data name="Main Frontend Layout" inherit_id="web.frontend_layout">\n        <xpath expr="//html" position="attributes">\n            <attribute name="t-att-dir" add="request.env['res.lang']._get_data(code=request.env.lang).direction" separator=" "/>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']" position="attributes">\n            <attribute name="t-attf-class" add="#{request.env['res.lang']._get_data(code=request.env.lang).direction == 'rtl' and 'o_rtl' or ''}" separator=" "/>\n            <attribute name="t-attf-class" add="#{'o_portal' if is_portal else ''}" separator=" "/>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/header" position="before">\n            <a class="o_skip_to_content btn btn-primary rounded-0 visually-hidden-focusable position-absolute start-0" href="#wrap" groups="!base.group_user">Skip to Content</a>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/header/img" position="replace">\n            <nav class="navbar navbar-expand navbar-light bg-light">\n                <div class="container">\n                    <a href="/" class="navbar-brand logo">\n                        <img t-att-src="'/logo.png?company=%s' % res_company.id" t-att-alt="'Logo of %s' % res_company.name" t-att-title="res_company.name"/>\n                    </a>\n                    <ul id="top_menu" class="nav navbar-nav ms-auto">\n                        <t t-call="portal.placeholder_user_sign_in">\n                            <t t-set="_item_class" t-value="'nav-item'"/>\n                            <t t-set="_link_class" t-value="'nav-link'"/>\n                        </t>\n                        <t t-call="portal.user_dropdown">\n                            <t t-set="_user_name" t-value="true"/>\n                            <t t-set="_item_class" t-value="'nav-item dropdown'"/>\n                            <t t-set="_link_class" t-value="'nav-link'"/>\n                            <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>\n                        </t>\n                    </ul>\n                </div>\n            </nav>\n        </xpath>\n        <xpath expr="//div[@id='wrapwrap']/main/t[@t-out='0']" position="before">\n            <div t-if="o_portal_fullwidth_alert" class="container mt-3">\n                <div class="alert alert-info alert-dismissible fade show d-print-none css_editable_mode_hidden">\n                    <t t-out="o_portal_fullwidth_alert"/>\n                </div>\n            </div>\n        </xpath>\n        <xpath expr="//head/meta" position="after">\n            <t t-if="preview_object">\n                <!-- Remove seo_object to not define og and twitter tags twice when wesbite is installed -->\n                <t t-set="seo_object" t-value="False"/>\n                <t t-set="company" t-value="preview_object.company_id or request.env.company"/>\n                <t t-set="not_uses_default_logo" t-value="company and not company.uses_default_logo"/>\n                <meta property="og:title" t-att-content="preview_object.name"/>\n                <meta property="og:description" t-att-content="preview_object.description.striptags() if preview_object.description else ''"/>\n                <meta property="og:site_name" t-att-content="company.name if company else ''"/>\n                <t t-if="not_uses_default_logo">\n                    <meta property="og:image" t-attf-content="/web/binary/company_logo?company={{ company.id }}"/>\n                </t>\n                <meta property="og:image:width" content="300"/>\n                <meta property="og:image:height" content="200"/>\n                <meta name="twitter:card" content="summary_large_image"/>\n                <meta property="twitter:title" t-att-content="preview_object.name"/>\n                <meta property="twitter:description" t-att-content="preview_object.description.striptags() if preview_object.description else ''"/>\n                <t t-if="not_uses_default_logo">\n                    <meta property="twitter:image" t-attf-content="/web/binary/company_logo?company={{ company.id }}"/>\n                </t>\n            </t>\n        </xpath>\n    </data>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
