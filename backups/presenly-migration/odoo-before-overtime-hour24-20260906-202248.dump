="o_customer_address_fill">\n                <div class="row">\n                    <div name="address_div" class="oe_clear_stucture col-12 col-lg-8">\n                        <div>\n                            <t t-if="address_type == 'billing'">\n                                <h3 class="mb-3">Billing address</h3>\n                            </t>\n                            <t t-elif="address_type == 'delivery'">\n                                <h3 class="mb-3">Delivery address</h3>\n                            </t>\n                            <div id="errors"/> <!-- for js -->\n                            <form action="/my/address/submit" method="post" name="address_form" class="address_autoformat" t-att-data-company-country-code="res_company.country_id.code" t-att-data-submit-url="'/my/address/submit'">\n                                <div name="address_details" class="row">\n                                    <t t-call="portal.address_form_fields"/>\n                                </div>\n                                <t t-call="portal.address_footer"/>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n\n	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
