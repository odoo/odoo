975	16	\N	1	1	Marketing: mailing link trackers statistic	\N	mass_mailing.mass_mailing_kpi_link_trackers	qweb	mass_mailing/data/mailing_data_templates.xml	primary	{"en_US": "<t name=\\"Marketing: mailing link trackers statistic\\" t-name=\\"mass_mailing.mass_mailing_kpi_link_trackers\\">\\n        <table t-if=\\"link_trackers\\" class=\\"global_table_layout\\" bgcolor=\\"#ffffff\\" cellspacing=\\"0\\" cellpadding=\\"0\\" align=\\"center\\" border=\\"0\\" style=\\"width: 100%;\\">\\n            <tr>\\n                <td style=\\"width: 100%;\\">\\n                    <table cellspacing=\\"0\\" cellpadding=\\"0\\" border=\\"0\\" align=\\"center\\" style=\\"width:100%;\\">\\n                        <tr>\\n                            <td align=\\"left\\">\\n                                <span style=\\"color:#282f33; font-size: 15px; font-weight: bold; line-height: 30px\\">\\n                                    <t t-esc=\\"'Click Rate Report on %i %s Sent' % (object.expected, mailing_type)\\"/>\\n                                </span>\\n                            </td>\\n                        </tr>\\n                    </table>\\n                </td>\\n            </tr>\\n            <tr>\\n                <td style=\\"margin: 0; padding:0;\\">\\n                    <table cellspacing=\\"0\\" cellpadding=\\"0\\" border=\\"0\\" align=\\"center\\" style=\\"width:100%; border-collapse: collapse;\\">\\n                        <tr t-att-style=\\"'color: ' + (company.email_secondary_color or '#875a7b') + '; font-size: 16px; font-weight: 500;'\\">\\n                            <td style=\\"width: 70%;padding: 10px 0; text-align: center; border: 1px solid #e7e7e7;\\">Button Label</td>\\n                            <td style=\\"width: 30%;padding: 10px 0; text-align: center; border: 1px solid #e7e7e7;\\">%Click (Total)</td>\\n                        </tr>\\n                        <tr t-foreach=\\"link_trackers\\" t-as=\\"link_tracker\\" style=\\"color: #888888; font-size: 15px; font-weight: 300;\\">\\n                            <td style=\\"width: 70%;padding: 10px 0; border: 1px solid #e7e7e7;\\">\\n                                <a t-att-href=\\"link_tracker.absolute_url\\" target=\\"_blank\\" style=\\"color: #56b3b5; text-decoration: none;\\" t-esc=\\"link_tracker.label or link_tracker.url\\"/>\\n                            </td>\\n                            <td style=\\"width: 30%;padding: 10px 0; text-align: center;  border: 1px solid #e7e7e7;\\">\\n                                <t t-esc=\\"int(link_tracker.count * 100 / object.sent) if object.sent else 0\\"/>% (<t t-esc=\\"link_tracker.count\\"/>)\\n                            </td>\\n                        </tr>\\n                    </table>\\n                </td>\\n            </tr>\\n        </table>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Marketing: mailing link trackers statistic" t-name="mass_mailing.mass_mailing_kpi_link_trackers">\n        <table t-if="link_trackers" class="global_table_layout" bgcolor="#ffffff" cellspacing="0" cellpadding="0" align="center" border="0" style="width: 100%;">\n            <tr>\n                <td style="width: 100%;">\n                    <table cellspacing="0" cellpadding="0" border="0" align="center" style="width:100%;">\n                        <tr>\n                            <td align="left">\n                                <span style="color:#282f33; font-size: 15px; font-weight: bold; line-height: 30px">\n                                    <t t-esc="'Click Rate Report on %i %s Sent' % (object.expected, mailing_type)"/>\n                                </span>\n                            </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n            <tr>\n                <td style="margin: 0; padding:0;">\n                    <table cellspacing="0" cellpadding="0" border="0" align="center" style="width:100%; border-collapse: collapse;">\n                        <tr t-att-style="'color: ' + (company.email_secondary_color or '#875a7b') + '; font-size: 16px; font-weight: 500;'">\n                            <td style="width: 70%;padding: 10px 0; text-align: center; border: 1px solid #e7e7e7;">Button Label</td>\n                            <td style="width: 30%;padding: 10px 0; text-align: center; border: 1px solid #e7e7e7;">%Click (Total)</td>\n                        </tr>\n                        <tr t-foreach="link_trackers" t-as="link_tracker" style="color: #888888; font-size: 15px; font-weight: 300;">\n                            <td style="width: 70%;padding: 10px 0; border: 1px solid #e7e7e7;">\n                                <a t-att-href="link_tracker.absolute_url" target="_blank" style="color: #56b3b5; text-decoration: none;" t-esc="link_tracker.label or link_tracker.url"/>\n                            </td>\n                            <td style="width: 30%;padding: 10px 0; text-align: center;  border: 1px solid #e7e7e7;">\n                                <t t-esc="int(link_tracker.count * 100 / object.sent) if object.sent else 0"/>% (<t t-esc="link_tracker.count"/>)\n                            </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n        </table>\n    </t>\n	f	t	2026-09-05 15:59:52.12261	2026-09-05 15:59:52.12261	f
