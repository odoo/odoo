                  <t name=\\"warning_section\\"/>\\n                    <sheet string=\\"Task\\">\\n                    <div class=\\"oe_button_box\\" name=\\"button_box\\" groups=\\"base.group_user\\">\\n                        <!-- Dummy tag for organizing buttons, using position='replace' when inheriting -->\\n                        <span id=\\"button_products\\" invisible=\\"1\\"/>\\n                        <span id=\\"button_worksheet\\" invisible=\\"1\\"/>\\n                        <!-- Dummy tag used to organize buttons, englobing the 3 buttons modifies the width of the button -->\\n                        <span id=\\"start_rating_buttons\\" invisible=\\"1\\"/>\\n                        <field name=\\"rating_avg\\" invisible=\\"1\\"/>\\n                        <field name=\\"rating_active\\" invisible=\\"1\\"/>\\n                        <button name=\\"action_open_ratings\\" type=\\"object\\" invisible=\\"rating_count == 0 or not rating_active or has_template_ancestor or has_project_template\\" class=\\"oe_stat_button\\">\\n                            <i class=\\"fa fa-fw o_button_icon fa-smile-o text-success\\" invisible=\\"rating_avg &lt; 3.66\\" title=\\"Happy\\"/>\\n                            <i class=\\"fa fa-fw o_button_icon fa-meh-o text-warning\\" invisible=\\"rating_avg &lt; 2.33 or rating_avg &gt;= 3.66\\" title=\\"Neutral\\"/>\\n                            <i class=\\"fa fa-fw o_button_icon fa-frown-o text-danger\\" invisible=\\"rating_avg &gt;= 2.33\\" title=\\"Unhappy\\"/>\\n                            <div class=\\"o_field_widget o_stat_info\\">\\n                                <span class=\\"o_stat_value\\"><field name=\\"rating_avg_text\\" nolabel=\\"1\\"/></span>\\n                                <span class=\\"o_stat_text\\">Last Rating</span>\\n                            </div>\\n                        </button>\\n                        <!-- Dummy tag used to organize buttons -->\\n                        <span id=\\"end_rating_buttons\\" invisible=\\"1\\"/>\\n                        <button name=\\"action_open_parent_task\\" type=\\"object\\" class=\\"oe_stat_button\\" icon=\\"fa-check\\" invisible=\\"not parent_id\\">\\n                            <div class=\\"o_stat_info\\">\\n                                <span class=\\"o_stat_text\\">Parent Task</span>\\n                            </div>\\n                        </button>\\n                        <button name=\\"action_recurring_tasks\\" type=\\"object\\" invisible=\\"not active or not recurrence_id or not allow_recurring_tasks\\" class=\\"oe_stat_button\\" icon=\\"fa-repeat\\" groups=\\"project.group_project_recurring_tasks\\">\\n                            <field name=\\"recurring_count\\" widget=\\"statinfo\\" string=\\"Recurring Tasks\\"/>\\n                        </button>\\n                        <button name=\\"action_open_subtasks\\" type=\\"object\\" class=\\"oe_stat_button\\" icon=\\"fa-check\\" invisible=\\"not id or subtask_count == 0\\" context=\\"{                                 'default_project_id': project_id,                                 'default_user_ids': user_ids,                                 'default_milestone_id': milestone_id,                                 'subtask_action': True,                                 'default_is_template': is_template,                             }\\">\\n                            <div class=\\"o_field_widget o_stat_info\\">\\n                                <span class=\\"o_stat_text\\">Sub-tasks</span>\\n                                <span class=\\"o_stat_value\\">\\n                                    <field name=\\"closed_subtask_count\\"/> / <field name=\\"subtask_count\\"/>\\n                                    (<field name=\\"subtask_completion_percentage\\" widget=\\"percentage\\" options=\\"{'digits': [1, 0]}\\"/>)\\n                                </span>\\n                            </div>\\n                        </button>\\n                        <button name=\\"action_dependent_tasks\\" type=\\"object\\" invisible=\\"dependent_tasks_count == 0 or not allow_task_dependencies\\" class=\\"oe_stat_button\\" icon=\\"fa-check\\" groups=\\"project.group_project_task_dependencies\\">\\n                            <field name=\\"dependent_tasks_count\\" widget=\\"statinfo\\" string=\\"Blocked Tasks\\"/>\\n                        </button>\\n                        <!-- Dummy tag used to organize buttons -->\\n                        <span id=\\"end_button_box\\" invisible=\\"1\\"/>\\n                    </div>\\n                    <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active or is_template\\"/>\\n                    <widget name=\\"web_ribbon\\" title=\\"Template\\" bg_color=\\"text-bg-info\\" invisible=\\"not is_template\\"/>\\n                    <div class=\\"d-flex justify-content-between align-items-center\\">\\n                        <h1 class=\\"d-flex w-100\\">\\n                            <field name=\\"name\\" options=\\"{'line_breaks': False}\\" widget=\\"text\\" class=\\"o_task_name text-truncate w-md-75 w-100 pe-2\\" placeholder=\\"Task Title...\\"/>\\n                        </h1>\\n                        <div class=\\"d-flex justify-content-end align-items-center px-1\\" invisible=\\"not active or is_template or has_project_template\\">\\n                            <field name=\\"priority\\" class=\\"h3 pe-2\\" widget=\\"priority_switch\\"/>\\n                        </div>\\n                        <div class=\\"d-flex justify-content-end o_state_container\\" invisible=\\"not active or is_template or has_project_template\\">\\n                            <field name=\\"state\\" widget=\\"project_task_state_selection\\" class=\\"o_task_state_widget\\"/>\\n                        </div>\\n                        <div class=\\"d-flex justify-content-start align-items-center w-100 w-md-50 w-lg-25\\" invisible=\\"active and not (is_template or has_project_template)\\">\\n                            <field name=\\"priority\\" class=\\"h3 pe-2\\" widget=\\"priority_switch\\"/>\\n                            <field name=\\"state\\" widget=\\"project_task_state_selection\\" class=\\"o_task_state_widget\\"/>\\n                        </div>\\n                    </div>\\n                    <group>\\n                        <group>\\n                            <field name=\\"project_id\\" domain=\\"[('active', '=', True), '|', ('company_id', '=', False), ('company_id', '=?', company_id)]\\" required=\\"parent_id or child_ids or is_template\\" widget=\\"project\\"/>\\n                            <field name=\\"milestone_id\\" placeholder=\\"e.g. Product Launch\\" context=\\"{'default_project_id': project_id}\\" invisible=\\"not project_id or not allow_milestones\\"/>\\n                            <field name=\\"user_ids\\" class=\\"o_task_user_field\\" options=\\"{'no_open': True, 'no_quick_create': True}\\" required=\\"not project_id\\" widget=\\"many2many_avatar_user\\"/>\\n                            <field name=\\"role_ids\\" invisible=\\"not has_project_template or is_template\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color', 'no_create_edit': True}\\" placeholder=\\"Assign at project creation\\"/>\\n                        </group>\\n                        <group>\\n                            <field name=\\"active\\" invisible=\\"1\\"/>\\n                            <field name=\\"tag_ids\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color', 'no_create_edit': True}\\" context=\\"{'project_id': project_id}\\"/>\\n                            <field name=\\"partner_id\\" nolabel=\\"0\\" widget=\\"res_partner_many2one\\" class=\\"o_task_customer_field\\" invisible=\\"not project_id or has_template_ancestor or has_project_template\\"/>\\n                            <label for=\\"date_deadline\\"/>\\n                            <div id=\\"date_deadline_and_recurring_task\\" class=\\"d-inline-flex w-100\\">\\n                                <field name=\\"date_deadline\\" nolabel=\\"1\\" decoration-danger=\\"date_deadline and date_deadline &lt; current_date and state not in ['1_done', '1_canceled']\\"/>\\n                                <field name=\\"recurring_task\\" nolabel=\\"1\\" class=\\"ms-0\\" style=\\"width: fit-content;\\" widget=\\"boolean_icon\\" options=\\"{'icon': 'fa-repeat'}\\" invisible=\\"not active or parent_id or not allow_recurring_tasks\\" groups=\\"project.group_project_recurring_tasks\\"/>\\n                            </div>\\n                            <label for=\\"repeat_interval\\" groups=\\"project.group_project_recurring_tasks\\" invisible=\\"not recurring_task or not allow_recurring_tasks\\"/>\\n                            <div invisible=\\"not recurring_task or not allow_recurring_tasks\\" class=\\"d-flex\\" groups=\\"project.group_project_recurring_tasks\\" name=\\"repeat_intervals\\">\\n                                <field name=\\"repeat_interval\\" required=\\"recurring_task\\" class=\\"me-2\\" style=\\"max-width: 2rem !important;\\"/>\\n                                <field name=\\"repeat_unit\\" required=\\"recurring_task\\" class=\\"me-2\\" style=\\"max-width: 4rem !important;\\"/>\\n                                <field name=\\"repeat_type\\" required=\\"recurring_task\\" class=\\"me-2\\" style=\\"max-width: 15rem !important;\\"/>\\n                                <field name=\\"repeat_until\\" invisible=\\"repeat_type != 'until'\\" required=\\"repeat_type == 'until'\\" class=\\"me-2\\"/>\\n                            </div>\\n                            <!-- Field needed to trigger its compute in project_enterprise, but will be replaced in an override defined in hr_timesheet module -->\\n                            <field name=\\"allocated_hours\\" invisible=\\"1\\"/>\\n                        </group>\\n                    </group>\\n                        <field name=\\"task_properties\\" columns=\\"2\\"/>\\n                    <notebook>\\n                        <page name=\\"description_page\\" string=\\"Description\\">\\n                            <field name=\\"description\\" type=\\"html\\" options=\\"{'collaborative': true, 'resizable': false}\\" placeholder=\\"Add details about this task...\\"/>\\n                        </page>\\n                        <page name=\\"sub_tasks_page\\" string=\\"Sub-tasks\\" invisible=\\"not project_id\\">\\n                            <field name=\\"child_ids\\" mode=\\"list,kanban\\" context=\\"{                                         'default_project_id': project_id,                                         'default_user_ids': user_ids,                                         'default_parent_id': id,                                         'default_partner_id': partner_id,                                         'default_milestone_id': allow_milestones and milestone_id,                                         'kanban_view_ref': 'project.project_sub_task_view_kanban_mobile',                                         'closed_X2M_count': closed_subtask_count,                                         'default_is_template': is_template,                                         'default_tag_ids': tag_ids,                                    }\\" widget=\\"subtasks_one2many\\">\\n                                <list editable=\\"bottom\\" decoration-muted=\\"state in ['1_done','1_canceled']\\" open_form_view=\\"True\\">\\n                                    <field name=\\"active\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"is_template\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"allow_milestones\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"display_in_project\\" column_invisible=\\"True\\" force_save=\\"1\\"/>\\n                                    <field name=\\"sequence\\" widget=\\"handle\\"/>\\n                                    <field name=\\"id\\" optional=\\"hide\\" options=\\"{'enable_formatting': False}\\"/>\\n                                    <field name=\\"parent_id\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"state\\" widget=\\"project_task_state_selection\\" nolabel=\\"1\\" width=\\"20px\\"/>\\n                                    <field name=\\"name\\" widget=\\"name_with_subtask_count\\"/>\\n                                    <field name=\\"subtask_count\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"closed_subtask_count\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"project_id\\" string=\\"Project\\" optional=\\"hide\\" required=\\"1\\" options=\\"{'no_open': 1}\\" widget=\\"project\\"/>\\n                                    <field name=\\"milestone_id\\" optional=\\"hide\\" context=\\"{'default_project_id': project_id}\\" column_invisible=\\"not parent.allow_milestones\\" invisible=\\"not allow_milestones\\"/>\\n                                    <field name=\\"partner_id\\" optional=\\"hide\\" widget=\\"res_partner_many2one\\" invisible=\\"not project_id\\" column_invisible=\\"parent.has_template_ancestor or parent.has_project_template\\"/>\\n                                    <field name=\\"user_ids\\" widget=\\"many2many_avatar_user\\" optional=\\"show\\"/>\\n                                    <field name=\\"company_id\\" groups=\\"base.group_multi_company\\" optional=\\"hide\\"/>\\n                                    <field name=\\"company_id\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"date_deadline\\" invisible=\\"state in ['1_done', '1_canceled']\\" optional=\\"hide\\" decoration-danger=\\"date_deadline and date_deadline &lt; current_date\\"/>\\n                                    <field name=\\"priority\\" widget=\\"priority\\" optional=\\"hide\\" width=\\"70px\\"/>\\n                                    <field name=\\"activity_ids\\" string=\\"Next Activity\\" widget=\\"list_activity\\" optional=\\"hide\\"/>\\n                                    <field name=\\"my_activity_date_deadline\\" string=\\"My Deadline\\" widget=\\"remaining_days\\" options=\\"{'allow_order': '1'}\\" optional=\\"hide\\"/>\\n                                    <field name=\\"rating_last_text\\" string=\\"Rating\\" decoration-danger=\\"rating_last_text == 'ko'\\" decoration-warning=\\"rating_last_text == 'ok'\\" decoration-success=\\"rating_last_text == 'top'\\" class=\\"fw-bold\\" widget=\\"badge\\" optional=\\"hide\\" invisible=\\"rating_last_text == 'none'\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"tag_ids\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color'}\\" optional=\\"hide\\"/>\\n                                    <field name=\\"create_date\\" optional=\\"hide\\"/>\\n                                    <field name=\\"stage_id\\" optional=\\"hide\\" context=\\"{'default_project_id': project_id}\\"/>\\n                                </list>\\n                            </field>\\n                        </page>\\n                        <page name=\\"task_dependencies\\" string=\\"Blocked By\\" invisible=\\"not allow_task_dependencies\\" groups=\\"project.group_project_task_dependencies\\">\\n                            <field name=\\"depend_on_ids\\" nolabel=\\"1\\" mode=\\"list,kanban\\" context=\\"{                                         'default_project_id': project_id,                                         'search_view_ref' : 'project.view_task_search_form',                                         'search_default_project_id': project_id,                                         'list_view_ref': 'project.open_view_all_tasks_list_view',                                         'search_default_open_tasks': 1,                                         'kanban_view_ref': 'project.project_sub_task_view_kanban_mobile',                                         'closed_X2M_count': closed_depend_on_count,                                         'default_is_template': is_template,                                         'render_task_templates': False,                                    }\\" widget=\\"notebook_task_one2many\\">\\n                                <list editable=\\"bottom\\" decoration-muted=\\"state in ['1_done','1_canceled']\\" open_form_view=\\"True\\">\\n                                    <field name=\\"allow_milestones\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"parent_id\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"subtask_count\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"closed_subtask_count\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"id\\" optional=\\"hide\\" options=\\"{'enable_formatting': False}\\"/>\\n                                    <field name=\\"state\\" widget=\\"project_task_state_selection\\" nolabel=\\"1\\" width=\\"20px\\"/>\\n                                    <field name=\\"name\\" widget=\\"name_with_subtask_count\\"/>\\n                                    <field name=\\"project_id\\" optional=\\"hide\\" options=\\"{'no_open': 1}\\"/>\\n                                    <field name=\\"milestone_id\\" optional=\\"hide\\" context=\\"{'default_project_id': project_id}\\" column_invisible=\\"not parent.allow_milestones\\" invisible=\\"not allow_milestones\\"/>\\n                                    <field name=\\"partner_id\\" optional=\\"hide\\" widget=\\"res_partner_many2one\\" invisible=\\"not project_id\\" column_invisible=\\"parent.has_template_ancestor or parent.has_project_template\\"/>\\n                                    <field name=\\"parent_id\\" optional=\\"hide\\" groups=\\"base.group_no_one\\"/>\\n                                    <field name=\\"user_ids\\" widget=\\"many2many_avatar_user\\" optional=\\"show\\"/>\\n                                    <field name=\\"company_id\\" optional=\\"hide\\" groups=\\"base.group_multi_company\\"/>\\n                                    <field name=\\"company_id\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"date_deadline\\" invisible=\\"state in ['1_done', '1_canceled']\\" optional=\\"hide\\" decoration-danger=\\"date_deadline and date_deadline &lt; current_date\\"/>\\n                                    <field name=\\"priority\\" widget=\\"priority\\" optional=\\"hide\\" width=\\"70px\\"/>\\n                                    <field name=\\"activity_ids\\" string=\\"Next Activity\\" widget=\\"list_activity\\" optional=\\"hide\\"/>\\n                                    <field name=\\"my_activity_date_deadline\\" string=\\"My Deadline\\" widget=\\"remaining_days\\" options=\\"{'allow_order': '1'}\\" optional=\\"hide\\"/>\\n                                    <field name=\\"rating_last_text\\" string=\\"Rating\\" decoration-danger=\\"rating_last_text == 'ko'\\" decoration-warning=\\"rating_last_text == 'ok'\\" decoration-success=\\"rating_last_text == 'top'\\" class=\\"fw-bold\\" widget=\\"badge\\" optional=\\"hide\\" invisible=\\"rating_last_text == 'none'\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"tag_ids\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color'}\\" optional=\\"hide\\"/>\\n                                    <field name=\\"create_date\\" optional=\\"hide\\"/>\\n                                    <field name=\\"stage_id\\" optional=\\"hide\\"/>\\n                                </list>\\n                            </field>\\n                        </page>\\n                        <page name=\\"extra_info\\" string=\\"Extra Info\\" groups=\\"base.group_no_one\\">\\n                            <group>\\n                                <group>\\n                                    <field name=\\"parent_id\\" invisible=\\"not project_id\\" groups=\\"base.group_no_one\\" context=\\"{'search_view_ref' : 'project.view_task_search_form', 'search_default_project_id': project_id, 'default_project_id': project_id}\\"/>\\n                                    <field name=\\"company_id\\" groups=\\"base.group_multi_company\\" options=\\"{'no_create': True}\\" placeholder=\\"Visible to all\\"/>\\n                                    <field name=\\"sequence\\" groups=\\"base.group_no_one\\"/>\\n                                    <field name=\\"email_cc\\" groups=\\"base.group_no_one\\" invisible=\\"is_template or has_project_template\\"/>\\n                                </group>\\n                                <group invisible=\\"is_template or has_project_template\\">\\n                                    <field name=\\"date_assign\\" groups=\\"base.group_no_one\\"/>\\n                                    <field name=\\"date_last_stage_update\\" groups=\\"base.group_no_one\\"/>\\n                                </group>\\n                                <group string=\\"Working Time to Assign\\" invisible=\\"working_hours_open == 0.0\\">\\n                                    <field name=\\"working_hours_open\\" widget=\\"float_time\\" string=\\"Hours\\"/>\\n                                    <field name=\\"working_days_open\\" string=\\"Days\\"/>\\n                                </group>\\n                                <group string=\\"Working Time to Close\\" invisible=\\"working_hours_close == 0.0\\">\\n                                    <field name=\\"working_hours_close\\" widget=\\"float_time\\" string=\\"Hours\\"/>\\n                                    <field name=\\"working_days_close\\" string=\\"Days\\"/>\\n                                </group>\\n                            </group>\\n                        </page>\\n                    </notebook>\\n                    </sheet>\\n                    <chatter reload_on_follower=\\"True\\"/>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Task" class="o_form_project_tasks" js_class="project_task_form">\n                    <field name="recurrence_id" invisible="1"/>\n                    <field name="allow_task_dependencies" invisible="1"/>\n                    <field name="rating_last_value" invisible="1"/>\n                    <field name="rating_count" invisible="1"/>\n                    <field name="allow_milestones" invisible="1"/>\n                    <field name="parent_id" invisible="1"/>\n                    <field name="company_id" invisible="1"/>\n                    <field name="is_closed" invisible="1"/>\n                    <field name="depend_on_count" invisible="1"/>\n                    <field name="closed_depend_on_count" invisible="1"/>\n                    <field name="html_field_history_metadata" invisible="1"/>\n                    <field name="is_template" invisible="1"/>\n                    <field name="is_rotting" invisible="1"/>\n                    <field name="rotting_days" invisible="1"/>\n                    <header>\n                        <field name="stage_id" widget="rotting_statusbar_duration" options="{'clickable': '1', 'fold_field': 'fold'}" invisible="not project_id and not stage_id"/>\n                        <field name="state" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" invisible="1"/>\n                        <field name="personal_stage_type_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}" invisible="project_id" domain="[('user_id', '=', uid)]" string="Personal Stage"/>\n                    </header>\n                    <!-- Used in inherited views to display the eventual warnings -->\n                    <t name="warning_section"/>\n                    <sheet string="Task">\n                    <div class="oe_button_box" name="button_box" groups="base.group_user">\n                        <!-- Dummy tag for organizing buttons, using position='replace' when inheriting -->\n                        <span id="button_products" invisible="1"/>\n                        <span id="button_worksheet" invisible="1"/>\n                        <!-- Dummy tag used to organize buttons, englobing the 3 buttons modifies the width of the button -->\n                        <span id="start_rating_buttons" invisible="1"/>\n                        <field name="rating_avg" invisible="1"/>\n                        <field name="rating_active" invisible="1"/>\n                        <button name="action_open_ratings" type="object" invisible="rating_count == 0 or not rating_active or has_template_ancestor or has_project_template" class="oe_stat_button">\n                            <i class="fa fa-fw o_button_icon fa-smile-o text-success" invisible="rating_avg &lt; 3.66" title="Happy"/>\n                            <i class="fa fa-fw o_button_icon fa-meh-o text-warning" invisible="rating_avg &lt; 2.33 or rating_avg &gt;= 3.66" title="Neutral"/>\n                            <i class="fa fa-fw o_button_icon fa-frown-o text-danger" invisible="rating_avg &gt;= 2.33" title="Unhappy"/>\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_value"><field name="rating_avg_text" nolabel="1"/></span>\n                                <span class="o_stat_text">Last Rating</span>\n                            </div>\n                        </button>\n                        <!-- Dummy tag used to organize buttons -->\n                        <span id="end_rating_buttons" invisible="1"/>\n                        <button name="action_open_parent_task" type="object" class="oe_stat_button" icon="fa-check" invisible="not parent_id">\n                            <div class="o_stat_info">\n                                <span class="o_stat_text">Parent Task</span>\n                            </div>\n                        </button>\n                        <button name="action_recurring_tasks" type="object" invisible="not active or not recurrence_id or not allow_recurring_tasks" class="oe_stat_button" icon="fa-repeat" groups="project.group_project_recurring_tasks">\n                            <field name="recurring_count" widget="statinfo" string="Recurring Tasks"/>\n                        </button>\n                        <button name="action_open_subtasks" type="object" class="oe_stat_button" icon="fa-check" invisible="not id or subtask_count == 0" context="{                                 'default_project_id': project_id,                                 'default_user_ids': user_ids,                                 'default_milestone_id': milestone_id,                                 'subtask_action': True,                                 'default_is_template': is_template,                             }">\n                            <div class="o_field_widget o_stat_info">\n                                <span class="o_stat_text">Sub-tasks</span>\n                                <span class="o_stat_value">\n                                    <field name="closed_subtask_count"/> / <field name="subtask_count"/>\n                                    (<field name="subtask_completion_percentage" widget="percentage" options="{'digits': [1, 0]}"/>)\n                                </span>\n                            </div>\n                        </button>\n                        <button name="action_dependent_tasks" type="object" invisible="dependent_tasks_count == 0 or not allow_task_dependencies" class="oe_stat_button" icon="fa-check" groups="project.group_project_task_dependencies">\n                            <field name="dependent_tasks_count" widget="statinfo" string="Blocked Tasks"/>\n                        </button>\n                        <!-- Dummy tag used to organize buttons -->\n                        <span id="end_button_box" invisible="1"/>\n                    </div>\n                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active or is_template"/>\n                    <widget name="web_ribbon" title="Template" bg_color="text-bg-info" invisible="not is_template"/>\n                    <div class="d-flex justify-content-between align-items-center">\n                        <h1 class="d-flex w-100">\n                            <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Task Title..."/>\n                        </h1>\n                        <div class="d-flex justify-content-end align-items-center px-1" invisible="not active or is_template or has_project_template">\n                            <field name="priority" class="h3 pe-2" widget="priority_switch"/>\n                        </div>\n                        <div class="d-flex justify-content-end o_state_container" invisible="not active or is_template or has_project_template">\n                            <field name="state" widget="project_task_state_selection" class="o_task_state_widget"/>\n                        </div>\n                        <div class="d-flex justify-content-start align-items-center w-100 w-md-50 w-lg-25" invisible="active and not (is_template or has_project_template)">\n                            <field name="priority" class="h3 pe-2" widget="priority_switch"/>\n                            <field name="state" widget="project_task_state_selection" class="o_task_state_widget"/>\n                        </div>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="project_id" domain="[('active', '=', True), '|', ('company_id', '=', False), ('company_id', '=?', company_id)]" required="parent_id or child_ids or is_template" widget="project"/>\n                            <field name="milestone_id" placeholder="e.g. Product Launch" context="{'default_project_id': project_id}" invisible="not project_id or not allow_milestones"/>\n                            <field name="user_ids" class="o_task_user_field" options="{'no_open': True, 'no_quick_create': True}" required="not project_id" widget="many2many_avatar_user"/>\n                            <field name="role_ids" invisible="not has_project_template or is_template" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Assign at project creation"/>\n                        </group>\n                        <group>\n                            <field name="active" invisible="1"/>\n                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'project_id': project_id}"/>\n                            <field name="partner_id" nolabel="0" widget="res_partner_many2one" class="o_task_customer_field" invisible="not project_id or has_template_ancestor or has_project_template"/>\n                            <label for="date_deadline"/>\n                            <div id="date_deadline_and_recurring_task" class="d-inline-flex w-100">\n                                <field name="date_deadline" nolabel="1" decoration-danger="date_deadline and date_deadline &lt; current_date and state not in ['1_done', '1_canceled']"/>\n                                <field name="recurring_task" nolabel="1" class="ms-0" style="width: fit-content;" widget="boolean_icon" options="{'icon': 'fa-repeat'}" invisible="not active or parent_id or not allow_recurring_tasks" groups="project.group_project_recurring_tasks"/>\n                            </div>\n                            <label for="repeat_interval" groups="project.group_project_recurring_tasks" invisible="not recurring_task or not allow_recurring_tasks"/>\n                            <div invisible="not recurring_task or not allow_recurring_tasks" class="d-flex" groups="project.group_project_recurring_tasks" name="repeat_intervals">\n                                <field name="repeat_interval" required="recurring_task" class="me-2" style="max-width: 2rem !important;"/>\n                                <field name="repeat_unit" required="recurring_task" class="me-2" style="max-width: 4rem !important;"/>\n                                <field name="repeat_type" required="recurring_task" class="me-2" style="max-width: 15rem !important;"/>\n                                <field name="repeat_until" invisible="repeat_type != 'until'" required="repeat_type == 'until'" class="me-2"/>\n                            </div>\n                            <!-- Field needed to trigger its compute in project_enterprise, but will be replaced in an override defined in hr_timesheet module -->\n                            <field name="allocated_hours" invisible="1"/>\n                        </group>\n                    </group>\n                        <field name="task_properties" columns="2"/>\n                    <notebook>\n                        <page name="description_page" string="Description">\n                            <field name="description" type="html" options="{'collaborative': true, 'resizable': false}" placeholder="Add details about this task..."/>\n                        </page>\n                        <page name="sub_tasks_page" string="Sub-tasks" invisible="not project_id">\n                            <field name="child_ids" mode="list,kanban" context="{                                         'default_project_id': project_id,                                         'default_user_ids': user_ids,                                         'default_parent_id': id,                                         'default_partner_id': partner_id,                                         'default_milestone_id': allow_milestones and milestone_id,                                         'kanban_view_ref': 'project.project_sub_task_view_kanban_mobile',                                         'closed_X2M_count': closed_subtask_count,                                         'default_is_template': is_template,                                         'default_tag_ids': tag_ids,                                    }" widget="subtasks_one2many">\n                                <list editable="bottom" decoration-muted="state in ['1_done','1_canceled']" open_form_view="True">\n                                    <field name="active" column_invisible="True"/>\n                                    <field name="is_template" column_invisible="True"/>\n                                    <field name="allow_milestones" column_invisible="True"/>\n                                    <field name="display_in_project" column_invisible="True" force_save="1"/>\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="id" optional="hide" options="{'enable_formatting': False}"/>\n                                    <field name="parent_id" column_invisible="True"/>\n                                    <field name="state" widget="project_task_state_selection" nolabel="1" width="20px"/>\n                                    <field name="name" widget="name_with_subtask_count"/>\n                                    <field name="subtask_count" column_invisible="True"/>\n                                    <field name="closed_subtask_count" column_invisible="True"/>\n                                    <field name="project_id" string="Project" optional="hide" required="1" options="{'no_open': 1}" widget="project"/>\n                                    <field name="milestone_id" optional="hide" context="{'default_project_id': project_id}" column_invisible="not parent.allow_milestones" invisible="not allow_milestones"/>\n                                    <field name="partner_id" optional="hide" widget="res_partner_many2one" invisible="not project_id" column_invisible="parent.has_template_ancestor or parent.has_project_template"/>\n                                    <field name="user_ids" widget="many2many_avatar_user" optional="show"/>\n                                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>\n                                    <field name="company_id" column_invisible="True"/>\n                                    <field name="date_deadline" invisible="state in ['1_done', '1_canceled']" optional="hide" decoration-danger="date_deadline and date_deadline &lt; current_date"/>\n                                    <field name="priority" widget="priority" optional="hide" width="70px"/>\n                                    <field name="activity_ids" string="Next Activity" widget="list_activity" optional="hide"/>\n                                    <field name="my_activity_date_deadline" string="My Deadline" widget="remaining_days" options="{'allow_order': '1'}" optional="hide"/>\n                                    <field name="rating_last_text" string="Rating" decoration-danger="rating_last_text == 'ko'" decoration-warning="rating_last_text == 'ok'" decoration-success="rating_last_text == 'top'" class="fw-bold" widget="badge" optional="hide" invisible="rating_last_text == 'none'" column_invisible="True"/>\n                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>\n                                    <field name="create_date" optional="hide"/>\n                                    <field name="stage_id" optional="hide" context="{'default_project_id': project_id}"/>\n                                </list>\n                            </field>\n                        </page>\n                        <page name="task_dependencies" string="Blocked By" invisible="not allow_task_dependencies" groups="project.group_project_task_dependencies">\n                            <field name="depend_on_ids" nolabel="1" mode="list,kanban" context="{                                         'default_project_id': project_id,                                         'search_view_ref' : 'project.view_task_search_form',                                         'search_default_project_id': project_id,                                         'list_view_ref': 'project.open_view_all_tasks_list_view',                                         'search_default_open_tasks': 1,                                         'kanban_view_ref': 'project.project_sub_task_view_kanban_mobile',                                         'closed_X2M_count': closed_depend_on_count,                                         'default_is_template': is_template,                                         'render_task_templates': False,                                    }" widget="notebook_task_one2many">\n                                <list editable="bottom" decoration-muted="state in ['1_done','1_canceled']" open_form_view="True">\n                                    <field name="allow_milestones" column_invisible="True"/>\n                                    <field name="parent_id" column_invisible="True"/>\n                                    <field name="subtask_count" column_invisible="True"/>\n                                    <field name="closed_subtask_count" column_invisible="True"/>\n                                    <field name="id" optional="hide" options="{'enable_formatting': False}"/>\n                                    <field name="state" widget="project_task_state_selection" nolabel="1" width="20px"/>\n                                    <field name="name" widget="name_with_subtask_count"/>\n                                    <field name="project_id" optional="hide" options="{'no_open': 1}"/>\n                                    <field name="milestone_id" optional="hide" context="{'default_project_id': project_id}" column_invisible="not parent.allow_milestones" invisible="not allow_milestones"/>\n                                    <field name="partner_id" optional="hide" widget="res_partner_many2one" invisible="not project_id" column_invisible="parent.has_template_ancestor or parent.has_project_template"/>\n                                    <field name="parent_id" optional="hide" groups="base.group_no_one"/>\n                                    <field name="user_ids" widget="many2many_avatar_user" optional="show"/>\n                                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>\n                                    <field name="company_id" column_invisible="True"/>\n                                    <field name="date_deadline" invisible="state in ['1_done', '1_canceled']" optional="hide" decoration-danger="date_deadline and date_deadline &lt; current_date"/>\n                                    <field name="priority" widget="priority" optional="hide" width="70px"/>\n                                    <field name="activity_ids" string="Next Activity" widget="list_activity" optional="hide"/>\n                                    <field name="my_activity_date_deadline" string="My Deadline" widget="remaining_days" options="{'allow_order': '1'}" optional="hide"/>\n                                    <field name="rating_last_text" string="Rating" decoration-danger="rating_last_text == 'ko'" decoration-warning="rating_last_text == 'ok'" decoration-success="rating_last_text == 'top'" class="fw-bold" widget="badge" optional="hide" invisible="rating_last_text == 'none'" column_invisible="True"/>\n                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>\n                                    <field name="create_date" optional="hide"/>\n                                    <field name="stage_id" optional="hide"/>\n                                </list>\n                            </field>\n                        </page>\n                        <page name="extra_info" string="Extra Info" groups="base.group_no_one">\n                            <group>\n                                <group>\n                                    <field name="parent_id" invisible="not project_id" groups="base.group_no_one" context="{'search_view_ref' : 'project.view_task_search_form', 'search_default_project_id': project_id, 'default_project_id': project_id}"/>\n                                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" placeholder="Visible to all"/>\n                                    <field name="sequence" groups="base.group_no_one"/>\n                                    <field name="email_cc" groups="base.group_no_one" invisible="is_template or has_project_template"/>\n                                </group>\n                                <group invisible="is_template or has_project_template">\n                                    <field name="date_assign" groups="base.group_no_one"/>\n                                    <field name="date_last_stage_update" groups="base.group_no_one"/>\n                                </group>\n                                <group string="Working Time to Assign" invisible="working_hours_open == 0.0">\n                                    <field name="working_hours_open" widget="float_time" string="Hours"/>\n                                    <field name="working_days_open" string="Days"/>\n                                </group>\n                                <group string="Working Time to Close" invisible="working_hours_close == 0.0">\n                                    <field name="working_hours_close" widget="float_time" string="Hours"/>\n                                    <field name="working_days_close" string="Days"/>\n                                </group>\n                            </group>\n                        </page>\n                    </notebook>\n                    </sheet>\n                    <chatter reload_on_follower="True"/>\n                </form>\n 