--
-- Name: hr_leave_attendance_report; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.hr_leave_attendance_report AS
 WITH bounds AS (
         SELECT ((date_trunc('month'::text, ((now())::date)::timestamp with time zone) - '1 year'::interval))::date AS date_from,
            ((now())::date - 1) AS date_to
        ), cal_workday AS (
         SELECT DISTINCT resource_calendar_attendance.calendar_id,
            (resource_calendar_attendance.dayofweek)::integer AS dayofweek
           FROM public.resource_calendar_attendance
        ), emp_day AS (
         SELECT DISTINCT ON (v.employee_id, gs.day) v.employee_id,
            emp.company_id,
            (gs.day)::date AS day,
            v.resource_calendar_id,
            COALESCE(rc_1.tz, 'UTC'::character varying) AS tz
           FROM ((((public.hr_version v
             JOIN public.hr_employee emp ON ((emp.id = v.employee_id)))
             JOIN public.resource_calendar rc_1 ON ((rc_1.id = v.resource_calendar_id)))
             CROSS JOIN bounds b)
             CROSS JOIN LATERAL generate_series((GREATEST(v.contract_date_start, v.date_version, b.date_from))::timestamp with time zone, (LEAST(COALESCE(v.contract_date_end, b.date_to), b.date_to))::timestamp with time zone, '1 day'::interval) gs(day))
          WHERE ((v.contract_date_start IS NOT NULL) AND (v.date_version <= b.date_to))
          ORDER BY v.employee_id, gs.day, v.date_version DESC
        ), emp_cal AS (
         SELECT DISTINCT emp_day.employee_id,
            emp_day.company_id,
            emp_day.resource_calendar_id AS calendar_id,
            emp_day.tz
           FROM emp_day
        ), holiday AS (
         SELECT DISTINCT closure.company_id,
            closure.calendar_id,
            closure.tz,
            closure.day
           FROM ( SELECT ct.company_id,
                    ct.calendar_id,
                    ct.tz,
                    (gs.day)::date AS day
                   FROM ((public.resource_calendar_leaves rcl
                     JOIN ( SELECT DISTINCT emp_cal.company_id,
                            emp_cal.calendar_id,
                            emp_cal.tz
                           FROM emp_cal) ct ON (((ct.company_id = rcl.company_id) AND (ct.calendar_id = rcl.calendar_id))))
                     CROSS JOIN LATERAL generate_series(((((rcl.date_from AT TIME ZONE 'UTC'::text) AT TIME ZONE ct.tz))::date)::timestamp with time zone, ((((rcl.date_to AT TIME ZONE 'UTC'::text) AT TIME ZONE ct.tz))::date)::timestamp with time zone, '1 day'::interval) gs(day))
                  WHERE ((rcl.resource_id IS NULL) AND (rcl.calendar_id IS NOT NULL))
                UNION ALL
                 SELECT ct.company_id,
                    ct.calendar_id,
                    ct.tz,
                    (gs.day)::date AS day
                   FROM ((public.resource_calendar_leaves rcl
                     JOIN ( SELECT DISTINCT emp_cal.company_id,
                            emp_cal.calendar_id,
                            emp_cal.tz
                           FROM emp_cal) ct ON ((ct.company_id = rcl.company_id)))
                     CROSS JOIN LATERAL generate_series(((((rcl.date_from AT TIME ZONE 'UTC'::text) AT TIME ZONE ct.tz))::date)::timestamp with time zone, ((((rcl.date_to AT TIME ZONE 'UTC'::text) AT TIME ZONE ct.tz))::date)::timestamp with time zone, '1 day'::interval) gs(day))
                  WHERE ((rcl.resource_id IS NULL) AND (rcl.calendar_id IS NULL))) closure
        ), attendance AS (
         SELECT hr_attendance.employee_id,
            ((hr_attendance.check_in AT TIME ZONE 'UTC'::text))::date AS check_date,
            sum(hr_attendance.worked_hours) AS worked_hours
           FROM (public.hr_attendance
             CROSS JOIN bounds b)
          WHERE ((hr_attendance.check_in >= (b.date_from - '1 day'::interval)) AND (hr_attendance.check_in < (b.date_to + '2 days'::interval)))
          GROUP BY hr_attendance.employee_id, (((hr_attendance.check_in AT TIME ZONE 'UTC'::text))::date)
        ), leave AS (
         SELECT lv.id,
            lv.employee_id,
            lv.number_of_hours,
            lv.date_from,
            lv.date_to,
            lvt.include_public_holidays_in_duration
           FROM ((public.hr_leave lv
             JOIN public.hr_leave_type lvt ON ((lvt.id = lv.holiday_status_id)))
             CROSS JOIN bounds b)
          WHERE (((lv.state)::text = 'validate'::text) AND (lv.date_from < (b.date_to + '2 days'::interval)) AND (lv.date_to >= (b.date_from - '1 day'::interval)))
        ), leave_day AS (
         SELECT charge.employee_id,
            charge.calendar_id,
            charge.tz,
            charge.day,
            sum(charge.leave_hours) AS leave_hours
           FROM ( SELECT ec.employee_id,
                    ec.calendar_id,
                    ec.tz,
                    (d.day)::date AS day,
                    (lv.number_of_hours / (count(*) OVER (PARTITION BY lv.id, ec.calendar_id, ec.tz))::double precision) AS leave_hours
                   FROM ((((leave lv
                     JOIN emp_cal ec ON ((ec.employee_id = lv.employee_id)))
                     CROSS JOIN LATERAL generate_series(((((lv.date_from AT TIME ZONE 'UTC'::text) AT TIME ZONE ec.tz))::date)::timestamp with time zone, ((((lv.date_to AT TIME ZONE 'UTC'::text) AT TIME ZONE ec.tz))::date)::timestamp with time zone, '1 day'::interval) d(day))
                     JOIN cal_workday cw_1 ON (((cw_1.calendar_id = ec.calendar_id) AND (cw_1.dayofweek = ((EXTRACT(isodow FROM d.day))::integer - 1)))))
                     LEFT JOIN holiday h ON (((NOT lv.include_public_holidays_in_duration) AND (h.company_id = ec.company_id) AND (h.calendar_id = ec.calendar_id) AND ((h.tz)::text = (ec.tz)::text) AND (h.day = (d.day)::date))))
                  WHERE (h.day IS NULL)) charge
          GROUP BY charge.employee_id, charge.calendar_id, charge.tz, charge.day
        )
 SELECT row_number() OVER (ORDER BY ed.day DESC, ed.employee_id) AS id,
    ed.day AS date,
    ed.employee_id,
    rc.id AS schedule_id,
    round((COALESCE(att.worked_hours, (0.0)::double precision))::numeric, 2) AS worked_hours,
    round(COALESCE(rc.hours_per_day, 0.0), 2) AS expected_hours,
    round((COALESCE(ld.leave_hours, (0.0)::double precision))::numeric, 2) AS leave_hours,
    ((round((COALESCE(att.worked_hours, (0.0)::double precision))::numeric, 2) - round(COALESCE(rc.hours_per_day, 0.0), 2)) + round((COALESCE(ld.leave_hours, (0.0)::double precision))::numeric, 2)) AS difference_hours
   FROM ((((emp_day ed
     JOIN public.resource_calendar rc ON ((rc.id = ed.resource_calendar_id)))
     JOIN cal_workday cw ON (((cw.calendar_id = ed.resource_calendar_id) AND (cw.dayofweek = ((EXTRACT(isodow FROM ed.day))::integer - 1)))))
     LEFT JOIN attendance att ON (((att.employee_id = ed.employee_id) AND (att.check_date = ed.day))))
     LEFT JOIN leave_day ld ON (((ld.employee_id = ed.employee_id) AND (ld.calendar_id = ed.resource_calendar_id) AND ((ld.tz)::text = (ed.tz)::text) AND (ld.day = ed.day))))
  WHERE (NOT (EXISTS ( SELECT 1
           FROM holiday h
          WHERE ((h.company_id = ed.company_id) AND (h.calendar_id = ed.resource_calendar_id) AND ((h.tz)::text = (ed.tz)::text) AND (h.day = ed.day)))));


--
-- Name: hr_leave_employee_type_report; Type: VIEW; Schema: public; Owner: -
--

CREATE VIEW public.hr_leave_employee_type_report AS
 WITH validated_leaves AS (
         SELECT l.id AS leave_id,
            l.employee_id,
            l.number_of_days,
            l.number_of_hours,
            l.holiday_status_id AS leave_type,
            l.date_from,
            l.date_to
           FROM public.hr_leave l
          WHERE ((l.state)::text = ANY ((ARRAY['validate'::character varying, 'validate1'::character varying])::text[]))
        ), base_allocations AS (
         SELECT allocation.id AS allocation_id,
            allocation.employee_id,
            employee.active AS active_employee,
            allocation.number_of_days,
            allocation.number_of_hours_display AS number_of_hours,
            v.department_id,
            allocation.holiday_status_id AS leave_type,
            allocation.state,
            allocation.date_from,
            allocation.date_to,
            allocation.employee_company_id AS company_id,
                CASE
                    WHEN (allocation.date_from > max(COALESCE(allocation.date_to, 'infinity'::date)) OVER (PARTITION BY allocation.employee_id, allocation.holiday_status_id ORDER BY allocation.date_from, allocation.id ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING)) THEN 1
                    ELSE 0
                END AS is_new_group
           FROM ((public.hr_leave_allocation allocation
             JOIN public.hr_employee employee ON ((allocation.employee_id = employee.id)))
             LEFT JOIN public.hr_version v ON ((v.id = employee.current_version_id)))
          WHERE ((allocation.state)::text = 'validate'::text)
        ), grouped_allocations AS (
         SELECT ba.allocation_id,
            ba.employee_id,
            ba.active_employee,
            ba.number_of_days,
            ba.number_of_hours,
            ba.department_id,
            ba.leave_type,
            ba.state,
            ba.date_from,
            ba.date_to,
            ba.company_id,
            ba.is_new_group,
            sum(ba.is_new_group) OVER (PARTITION BY ba.employee_id, ba.leave_type ORDER BY ba.date_from, ba.allocation_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS overlap_group
           FROM base_allocations ba
        ), ordered_allocations AS (
         SELECT ga.allocation_id,
            ga.employee_id,
            ga.active_employee,
            ga.number_of_days,
            ga.number_of_hours,
            ga.department_id,
            ga.leave_type,
            ga.state,
            ga.date_from,
            ga.date_to,
            ga.company_id,
            ga.overlap_group,
            row_number() OVER (PARTITION BY ga.employee_id, ga.leave_type, ga.overlap_group ORDER BY ga.date_from, ga.allocation_id) AS fifo_rank,
            sum(ga.number_of_days) OVER (PARTITION BY ga.employee_id, ga.leave_type, ga.overlap_group ORDER BY ga.date_from, ga.allocation_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_allocated_days,
            sum(ga.number_of_hours) OVER (PARTITION BY ga.employee_id, ga.leave_type, ga.overlap_group ORDER BY ga.date_from, ga.allocation_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_allocated_hours
           FROM grouped_allocations ga
        ), leave_entry_points AS (
         SELECT vl.leave_id,
            vl.number_of_days,
            vl.number_of_hours,
            vl.employee_id,
            vl.leave_type,
            oa.overlap_group,
            min(oa.fifo_rank) AS entry_rank
           FROM (validated_leaves vl
             JOIN ordered_allocations oa ON (((vl.employee_id = oa.employee_id) AND (vl.leave_type = oa.leave_type) AND (vl.date_from <= COALESCE(oa.date_to, 'infinity'::date)) AND ((oa.date_to IS NULL) OR (vl.date_to >= oa.date_from)))))
          GROUP BY vl.leave_id, vl.number_of_days, vl.number_of_hours, vl.employee_id, vl.leave_type, oa.overlap_group
        ), taken_by_rank AS (
         SELECT leave_entry_points.employee_id,
            leave_entry_points.leave_type,
            leave_entry_points.overlap_group,
            leave_entry_points.entry_rank,
            sum(leave_entry_points.number_of_days) AS rank_days,
            sum(leave_entry_points.number_of_hours) AS rank_hours
           FROM leave_entry_points
          GROUP BY leave_entry_points.employee_id, leave_entry_points.leave_type, leave_entry_points.overlap_group, leave_entry_points.entry_rank
        ), fifo_balances AS (
         SELECT sub.employee_id,
            sub.active_employee,
            GREATEST((sub.cumul_rem_days - COALESCE(lag(sub.cumul_rem_days) OVER w, (0)::double precision)), (0)::double precision) AS number_of_days,
            GREATEST((sub.cumul_rem_hours - COALESCE(lag(sub.cumul_rem_hours) OVER w, (0)::double precision)), (0)::double precision) AS number_of_hours,
            sub.department_id,
            sub.leave_type,
            sub.state,
            sub.date_from,
            sub.date_to,
            sub.company_id
           FROM ( SELECT oa.allocation_id,
                    oa.employee_id,
                    oa.active_employee,
                    oa.number_of_days,
                    oa.number_of_hours,
                    oa.department_id,
                    oa.leave_type,
                    oa.state,
                    oa.date_from,
                    oa.date_to,
                    oa.company_id,
                    oa.overlap_group,
                    oa.fifo_rank,
                    oa.cumulative_allocated_days,
                    oa.cumulative_allocated_hours,
                    GREATEST((oa.cumulative_allocated_days - sum(COALESCE(tbr.rank_days, (0)::double precision)) OVER w), (0)::double precision) AS cumul_rem_days,
                    GREATEST((oa.cumulative_allocated_hours - sum(COALESCE(tbr.rank_hours, (0)::double precision)) OVER w), (0)::double precision) AS cumul_rem_hours
                   FROM (ordered_allocations oa
                     LEFT JOIN taken_by_rank tbr ON (((tbr.employee_id = oa.employee_id) AND (tbr.leave_type = oa.leave_type) AND (tbr.overlap_group = oa.overlap_group) AND (tbr.entry_rank = oa.fifo_rank))))
                  WINDOW w AS (PARTITION BY oa.employee_id, oa.leave_type, oa.overlap_group ORDER BY oa.fifo_rank)) sub
          WINDOW w AS (PARTITION BY sub.employee_id, sub.leave_type, sub.overlap_group ORDER BY sub.fifo_rank)
        )
 SELECT row_number() OVER (ORDER BY employee_id, date_from) AS id,
    employee_id,
    active_employee,
    number_of_days,
    number_of_hours,
    department_id,
    leave_type,
    state,
    date_from,
    date_to,
    holiday_status,
    company_id
   FROM ( SELECT fb.employee_id,
            fb.active_employee,
            fb.number_of_days,
            fb.number_of_hours,
            fb.department_id,
            fb.leave_type,
            fb.state,
            ((fb.date_from)::timestamp without time zone + '12:00:00'::interval) AS date_from,
            ((fb.date_to)::timestamp without time zone + '12:00:00'::interval) AS date_to,
            'left'::text AS holiday_status,
            fb.company_id
           FROM fifo_balances fb
          WHERE (fb.number_of_days >= (0)::double precision)
        UNION ALL
         SELECT request.employee_id,
            employee.active AS active_employee,
            request.number_of_days,
            request.number_of_hours,
            v.department_id,
            request.holiday_status_id AS leave_type,
            request.state,
            request.date_from,
            request.date_to,
                CASE
                    WHEN ((request.state)::text = ANY ((ARRAY['validate'::character varying, 'validate1'::character varying])::text[])) THEN 'taken'::text
                    WHEN ((request.state)::text = 'confirm'::text) THEN 'planned'::text
                    ELSE NULL::text
                END AS holiday_status,
            request.employee_company_id AS company_id
           FROM ((public.hr_leave request
             JOIN public.hr_employee employee ON ((request.employee_id = employee.id)))
             LEFT JOIN public.hr_version v ON ((v.id = employee.current_version_id)))
          WHERE ((request.state)::text = ANY ((ARRAY['confirm'::character varying, 'validate'::character varying, 'validate1'::character varying])::text[]))) leaves;


