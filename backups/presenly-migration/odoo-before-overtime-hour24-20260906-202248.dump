kday" invisible="schedule_type != 'weekly'"/>\n                            <field name="week_type" optional="hide" invisible="schedule_type != 'weekly'"/>\n                            <field name="schedule_date" invisible="schedule_type != 'date'"/>\n                            <field name="hour_from" widget="float_time"/>\n                            <field name="hour_to" widget="float_time"/>\n                            <field name="work_location_id" required="1" domain="[('active', '=', True), ('company_id', '=', company_id)]" options="{'no_create_edit': True}"/>\n                            <field name="calendar_sync_state" widget="badge" decoration-success="calendar_sync_state in ('valid', 'flexible')" decoration-danger="calendar_sync_state in ('outside', 'no_calendar')"/>\n                            <field name="check_in_tolerance_minutes" optional="hide"/>\n                            <field name="date_start" optional="hide" invisible="schedule_type != 'weekly'"/>\n                            <field name="date_end" optional="hide" invisible="schedule_type != 'weekly'"/>\n                            <field name="active" optional="hide"/>\n                        </list>\n                    </field>\n                    <div class="alert alert-info mt-3" role="alert">\n                        Working Hours answers <strong>when</strong> the employee works. Location Slots answer <strong>where</strong>. Split one Working Hours period into multiple rows when the employee changes school during that period.\n                    </div>\n                </page>\n            </xpath>\n        </data>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
