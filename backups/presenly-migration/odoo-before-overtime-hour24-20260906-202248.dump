1282	16	\N	1	1	theme_event_template	\N	mass_mailing_themes.theme_event_template	qweb	mass_mailing_themes/views/mass_mailing_themes_templates.xml	primary	{"en_US": "<t t-name=\\"mass_mailing_themes.theme_event_template\\">\\n        <style id=\\"design-element\\">\\n            .o_layout .o_mail_wrapper .o_mail_wrapper_td {\\n                --h3-color: #2b3b58;\\n                --h3-font-size: 18px;\\n                --h3-font-weight: bolder;\\n            }\\n        </style>\\n        <t t-set=\\"now\\" t-value=\\"datetime.datetime.now()\\"/>\\n        <t t-set=\\"website_url_or_none\\" t-value=\\"(company_id.website) or '#'\\"/>\\n        <section class=\\"s_header_social o_mail_block_header_social o_mail_snippet_general pt16 pb16\\" data-vxml=\\"001\\" data-snippet=\\"s_mail_block_header_social\\" style=\\"background-color: rgb(26, 36, 54) !important;\\" data-name=\\"Header Social\\">\\n            <div class=\\"container\\">\\n                <div class=\\"row\\">\\n                    <div class=\\"col-md-4\\">\\n                        <a style=\\"text-decoration:none;float:none;\\" href=\\"http://www.example.com\\" target=\\"_blank\\">\\n                             <img src=\\"/mass_mailing_themes/static/src/img/theme_event/s_default_image_logo.png\\" style=\\"height: auto; max-width: 100%; width: 194px;\\" width=\\"194\\" alt=\\"Your Logo\\" class=\\"img-fluid\\"/>\\n                        </a>\\n                    </div>\\n                    <div class=\\"col-md-8 o_mail_header_social\\" style=\\"text-align: right;\\" t-translation=\\"off\\">\\n                        <a title=\\"Facebook\\" href=\\"https://www.facebook.com/Odoo\\">\\n                            <span class=\\"fa fa-facebook text-white\\" style=\\"background-color: rgb(43, 59, 88) !important;\\"/>\\n                        </a>&amp;nbsp;&amp;nbsp;\\n                        <a style=\\"margin-left:10px\\" title=\\"LinkedIn\\" href=\\"https://www.linkedin.com/company/odoo\\">\\n                            <span class=\\"fa fa-linkedin text-white\\" style=\\"background-color: rgb(43, 59, 88) !important;\\"/>\\n                        </a>&amp;nbsp;&amp;nbsp;\\n                        <a style=\\"margin-left:10px\\" title=\\"X\\" href=\\"https://twitter.com/Odoo\\">\\n                            <span class=\\"fa fa-twitter text-white\\" style=\\"background-color: rgb(43, 59, 88) !important;\\"/>\\n                        </a>&amp;nbsp;&amp;nbsp;\\n                        <a style=\\"margin-left:10px\\" title=\\"Instagram\\" href=\\"https://www.instagram.com/explore/tags/odoo/\\">\\n                            <span class=\\"fa fa-instagram text-white\\" style=\\"background-color: rgb(43, 59, 88) !important;\\"/>\\n                        </a>&amp;nbsp;&amp;nbsp;\\n                        <a style=\\"margin-left:10px\\" title=\\"TikTok\\" href=\\"https://www.tiktok.com/@odoo\\">\\n                            <span class=\\"fa fa-tiktok text-white\\" style=\\"background-color: rgb(43, 59, 88) !important;\\"/>\\n                        </a>\\n                    </div>\\n                </div>\\n            </div>\\n        </section>\\n        <section class=\\"s_text_block o_mail_snippet_general pb16 pt32\\" data-vxml=\\"001\\" style=\\"background-color: rgb(43, 59, 88) !important; padding-left: 15px; padding-right: 15px;\\" data-snippet=\\"s_text_block\\" data-name=\\"Text\\">\\n            <div class=\\"container s_allow_columns\\">\\n                <p><font style=\\"color: rgb(255, 255, 255);\\">Hi there!</font></p>\\n                <p><font style=\\"color: rgb(255, 255, 255);\\">The next edition of <span style=\\"font-weight: bolder;\\">Odoo Experience Online</span> is coming soon!\\n                    <br/>To stir up your curiosity, have a look at all the great talks scheduled and highlighted in our agenda!</font>\\n                </p>\\n            </div>\\n        </section>\\n        <section class=\\"s_media_list o_mail_snippet_general o_cc o_cc2 pb16 pt0\\" style=\\"background-color: rgb(43, 59, 88) !important; padding-left: 15px; padding-right: 15px;\\" data-snippet=\\"s_media_list\\" data-vcss=\\"001\\" data-vxml=\\"001\\" data-name=\\"Media List\\">\\n            <div class=\\"container\\">\\n                <div class=\\"row s_nb_column_fixed\\">\\n                    <div class=\\"col-md-12 s_media_list_item pt0 pb0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-5 s_media_list_img_wrapper px-0\\">\\n                                <img src=\\"/mass_mailing_themes/static/src/img/theme_event/s_default_image_media_list_1.jpg\\" class=\\"s_media_list_img w-100\\" style=\\"padding: 10px;\\"/>\\n                            </div>\\n                            <div class=\\"col-md-7 s_media_list_body\\">\\n                                <h3>Get 6-months' worth of knowledge<br/>in just 2 days</h3>\\n                                <p>Learn through workshops, product demos, and inspiring talks from Odoo Experts and Partners.</p>\\n                                <p><a class=\\"btn btn-primary\\" t-att-href=\\"website_url_or_none\\">See what we've got planned</a></p>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-md-12 s_media_list_item pt16 pb0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-5 s_media_list_img_wrapper px-0\\">\\n                                <img src=\\"/mass_mailing_themes/static/src/img/theme_event/s_default_image_media_list_2.jpg\\" class=\\"s_media_list_img w-100\\" style=\\"padding: 10px;\\"/>\\n                            </div>\\n                            <div class=\\"col-md-7 s_media_list_body\\">\\n                                <h3>Meet (other) awesome members<br/>of the community</h3>\\n                                <p>Create your very own chat room or join an existing one that sparks your interest.</p>\\n                                <p><a class=\\"btn btn-primary\\" t-att-href=\\"website_url_or_none\\">Go to the chatrooms</a></p>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-md-12 s_media_list_item pt16 pb0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\" col-md-5 s_media_list_img_wrapper px-0\\">\\n                                <img src=\\"/mass_mailing_themes/static/src/img/theme_event/s_default_image_media_list_3.jpg\\" class=\\"s_media_list_img w-100\\" style=\\"padding: 10px;\\"/>\\n                            </div>\\n                            <div class=\\"col-md-7 s_media_list_body\\">\\n                                <h3>An interactive, fun<br/>and comprehensive experience</h3>\\n                                <p>Experience everything from a virtual exhibitor's hall to multiple interactive presentations and demos.</p>\\n                                <p><a class=\\"btn btn-primary\\" t-att-href=\\"website_url_or_none\\">Find out more</a></p>\\n                            </div>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n        </section>\\n        <section class=\\"s_call_to_action o_mail_snippet_general o_cc o_cc3 pt40 pb40\\" data-vxml=\\"001\\" style=\\"background-color: rgb(26, 36, 54) !important;\\" data-snippet=\\"s_call_to_action\\" data-name=\\"Call to Action\\">\\n            <div class=\\"container\\">\\n                <div class=\\"row\\">\\n                    <div class=\\"col-md-12\\" style=\\"border-color: rgb(56, 62, 69) !important;\\">\\n                        <h3 style=\\"text-align: center;\\"><font style=\\"color: rgb(255, 255, 255);\\">And it won't cost you a thing!</font></h3>\\n                        <p style=\\"text-align: center;\\"><font style=\\"color: rgb(255, 255, 255);\\">Zero, zilch, nada! Odoo Experience is free for everyone!</font></p>\\n                    </div>\\n                    <div class=\\"col-md-12\\" style=\\"text-align: center;\\">\\n                        <p><a class=\\"btn btn-primary btn-lg\\" t-att-href=\\"website_url_or_none\\">Register now!</a></p>\\n                    </div>\\n                </div>\\n            </div>\\n        </section>\\n        <section class=\\"s_footer_social o_mail_block_footer_social o_mail_footer_social_center o_mail_snippet_general bg-200 pt16 pb16\\" data-vxml=\\"001\\" data-snippet=\\"s_mail_block_footer_social\\" data-name=\\"Footer Center\\">\\n            <div class=\\"container\\">\\n                <div class=\\"row\\">\\n                    <div class=\\"col-md-12 o_mail_footer_links pt8 pb8\\" style=\\"text-align: center;\\">\\n                        <a role=\\"button\\" href=\\"/unsubscribe_from_list\\" class=\\"btn btn-link \\">Unsubscribe</a>\\n                    </div>\\n                </div>\\n                <div class=\\"row\\">\\n                    <div class=\\"col-md-12\\">\\n                        <p style=\\"text-align: center;\\">\\n                            © <t t-out=\\"now.strftime('%Y')\\"/> All Rights Reserved\\n                        </p>\\n                    </div>\\n                </div>\\n            </div>\\n        </section>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="mass_mailing_themes.theme_event_template">\n        <style id="design-element">\n            .o_layout .o_mail_wrapper .o_mail_wrapper_td {\n                --h3-color: #2b3b58;\n                --h3-font-size: 18px;\n                --h3-font-weight: bolder;\n            }\n        </style>\n        <t t-set="now" t-value="datetime.datetime.now()"/>\n        <t t-set="website_url_or_none" t-value="(company_id.website) or '#'"/>\n        <section class="s_header_social o_mail_block_header_social o_mail_snippet_general pt16 pb16" data-vxml="001" data-snippet="s_mail_block_header_social" style="background-color: rgb(26, 36, 54) !important;" data-name="Header Social">\n            <div class="container">\n                <div class="row">\n                    <div class="col-md-4">\n                        <a style="text-decoration:none;float:none;" href="http://www.example.com" target="_blank">\n                             <img src="/mass_mailing_themes/static/src/img/theme_event/s_default_image_logo.png" style="height: auto; max-width: 100%; width: 194px;" width="194" alt="Your Logo" class="img-fluid"/>\n                        </a>\n                    </div>\n                    <div class="col-md-8 o_mail_header_social" style="text-align: right;" t-translation="off">\n                        <a title="Facebook" href="https://www.facebook.com/Odoo">\n                            <span class="fa fa-facebook text-white" style="background-color: rgb(43, 59, 88) !important;"/>\n                        </a>&amp;nbsp;&amp;nbsp;\n                        <a style="margin-left:10px" title="LinkedIn" href="https://www.linkedin.com/company/odoo">\n                            <span class="fa fa-linkedin text-white" style="background-color: rgb(43, 59, 88) !important;"/>\n                        </a>&amp;nbsp;&amp;nbsp;\n                        <a style="margin-left:10px" title="X" href="https://twitter.com/Odoo">\n                            <span class="fa fa-twitter text-white" style="background-color: rgb(43, 59, 88) !important;"/>\n                        </a>&amp;nbsp;&amp;nbsp;\n                        <a style="margin-left:10px" title="Instagram" href="https://www.instagram.com/explore/tags/odoo/">\n                            <span class="fa fa-instagram text-white" style="background-color: rgb(43, 59, 88) !important;"/>\n                        </a>&amp;nbsp;&amp;nbsp;\n                        <a style="margin-left:10px" title="TikTok" href="https://www.tiktok.com/@odoo">\n                            <span class="fa fa-tiktok text-white" style="background-color: rgb(43, 59, 88) !important;"/>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class="s_text_block o_mail_snippet_general pb16 pt32" data-vxml="001" style="background-color: rgb(43, 59, 88) !important; padding-left: 15px; padding-right: 15px;" data-snippet="s_text_block" data-name="Text">\n            <div class="container s_allow_columns">\n                <p><font style="color: rgb(255, 255, 255);">Hi there!</font></p>\n                <p><font style="color: rgb(255, 255, 255);">The next edition of <span style="font-weight: bolder;">Odoo Experience Online</span> is coming soon!\n                    <br/>To stir up your curiosity, have a look at all the great talks scheduled and highlighted in our agenda!</font>\n                </p>\n            </div>\n        </section>\n        <section class="s_media_list o_mail_snippet_general o_cc o_cc2 pb16 pt0" style="background-color: rgb(43, 59, 88) !important; padding-left: 15px; padding-right: 15px;" data-snippet="s_media_list" data-vcss="001" data-vxml="001" data-name="Media List">\n            <div class="container">\n                <div class="row s_nb_column_fixed">\n                    <div class="col-md-12 s_media_list_item pt0 pb0" data-name="Media item">\n                        <div class="row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1">\n                            <div class="col-md-5 s_media_list_img_wrapper px-0">\n                                <img src="/mass_mailing_themes/static/src/img/theme_event/s_default_image_media_list_1.jpg" class="s_media_list_img w-100" style="padding: 10px;"/>\n                            </div>\n                            <div class="col-md-7 s_media_list_body">\n                                <h3>Get 6-months' worth of knowledge<br/>in just 2 days</h3>\n                                <p>Learn through workshops, product demos, and inspiring talks from Odoo Experts and Partners.</p>\n                                <p><a class="btn btn-primary" t-att-href="website_url_or_none">See what we've got planned</a></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="col-md-12 s_media_list_item pt16 pb0" data-name="Media item">\n                        <div class="row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1">\n                            <div class="col-md-5 s_media_list_img_wrapper px-0">\n                                <img src="/mass_mailing_themes/static/src/img/theme_event/s_default_image_media_list_2.jpg" class="s_media_list_img w-100" style="padding: 10px;"/>\n                            </div>\n                            <div class="col-md-7 s_media_list_body">\n                                <h3>Meet (other) awesome members<br/>of the community</h3>\n                                <p>Create your very own chat room or join an existing one that sparks your interest.</p>\n                                <p><a class="btn btn-primary" t-att-href="website_url_or_none">Go to the chatrooms</a></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="col-md-12 s_media_list_item pt16 pb0" data-name="Media item">\n                        <div class="row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1">\n                            <div class=" col-md-5 s_media_list_img_wrapper px-0">\n                                <img src="/mass_mailing_themes/static/src/img/theme_event/s_default_image_media_list_3.jpg" cla