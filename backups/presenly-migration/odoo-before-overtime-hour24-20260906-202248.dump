      <!-- Tweak as icons aren't directly supported in xml -->\n            </list>\n        	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
899	16	\N	1	1	survey.survey.view.kanban	survey.survey	\N	kanban	survey/views/survey_survey_views.xml	primary	{"en_US": "<kanban highlight_color=\\"color\\" js_class=\\"survey_view_kanban\\">\\n                <field name=\\"active\\"/>\\n                <field name=\\"certification\\"/>\\n                <field name=\\"create_date\\"/>\\n                <field name=\\"scoring_type\\"/>\\n                <field name=\\"session_state\\"/>\\n                <field name=\\"session_available\\"/>\\n                <templates>\\n                    <div t-name=\\"menu\\" t-if=\\"widget.editable\\">\\n                        <a role=\\"menuitem\\" type=\\"open\\" class=\\"dropdown-item\\">Edit Survey</a>\\n                        <a t-if=\\"record.active.raw_value\\" role=\\"menuitem\\" type=\\"object\\" class=\\"dropdown-item\\" name=\\"action_send_survey\\">Share</a>\\n                        <a t-if=\\"widget.deletable\\" role=\\"menuitem\\" type=\\"delete\\" class=\\"dropdown-item\\">Delete</a>\\n                        <div role=\\"separator\\" class=\\"dropdown-divider\\"/>\\n                        <div role=\\"separator\\" class=\\"dropdown-item-text\\">Color</div>\\n                        <field name=\\"color\\" widget=\\"kanban_color_picker\\"/>\\n                    </div>\\n                    <div t-name=\\"card\\" t-attf-class=\\"o_survey_kanban_card #{record.certification.raw_value ? 'o_survey_kanban_card_certification' : ''}\\" class=\\"px-0\\">\\n                        <div class=\\"row mx-4\\">\\n                            <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                            <div class=\\"col-lg-2 col-sm-8 py-0 my-2 my-lg-0 col-12 g-0\\">\\n                                <div class=\\"d-flex flex-grow-1 flex-column my-0 my-lg-2\\">\\n                                    <field name=\\"title\\" class=\\"fw-bold\\"/>\\n                                    <span t-if=\\"!selection_mode\\" class=\\"d-flex align-items-center\\">\\n                                        <field name=\\"user_id\\" widget=\\"many2one_avatar_user\\" options=\\"{'display_avatar_name': True}\\"/>\\n                                            <span class=\\"mx-1\\">-</span>\\n                                        <t t-esc=\\"luxon.DateTime.fromISO(record.create_date.raw_value).toFormat('MMM yyyy')\\"/>\\n                                    </span>\\n                                </div>\\n                            </div>\\n                            <div t-attf-class=\\"col-lg-1 col-sm-4 d-sm-block py-0 my-2 col-#{selection_mode ? '12' : '6'}\\">\\n                                <field name=\\"question_count\\" class=\\"fw-bold\\"/><br t-if=\\"!selection_mode\\"/>\\n                                <span class=\\"text-muted\\">Questions</span>\\n                            </div>\\n                            <div t-if=\\"selection_mode\\" class=\\"col-12 d-flex justify-content-end\\">\\n                                <field name=\\"user_id\\" widget=\\"many2one_avatar_user\\"/>\\n                            </div>\\n                            <div t-if=\\"!selection_mode\\" class=\\"col-lg-1 col-sm-4 col-6 d-none py-0 my-2\\">\\n                                <field name=\\"answer_duration_avg\\" widget=\\"float_time\\" class=\\"fw-bold\\"/>\\n                                <span class=\\"text-muted\\">Average Duration</span>\\n                            </div>\\n                            <div t-if=\\"!selection_mode\\" class=\\"col-lg-1 col-sm-4 col-6 d-none py-0 my-2\\">\\n                                <a type=\\"object\\" name=\\"action_survey_user_input\\" class=\\"fw-bold\\">\\n                                    <field name=\\"answer_count\\"/><br/>\\n                                    <span class=\\"text-muted\\">Registered</span>\\n                                </a>\\n                            </div>\\n                            <div t-if=\\"!selection_mode\\" class=\\"col-lg-1 col-sm-4 col-6 d-sm-block py-0 my-2\\">\\n                                <a type=\\"object\\" name=\\"action_survey_user_input_completed\\" class=\\"fw-bold\\">\\n                                    <field name=\\"answer_done_count\\"/><br/>\\n                                    <span class=\\"text-muted\\">Completed</span>\\n                                </a>\\n                            </div>\\n                            <div t-if=\\"!selection_mode\\" class=\\"col-lg-1 col-sm-4 col-6 py-0 my-2\\" name=\\"o_survey_kanban_card_section_success\\">\\n                                 <a t-if=\\"record.scoring_type.raw_value != 'no_scoring'\\" type=\\"object\\" name=\\"action_survey_user_input_certified\\" class=\\"fw-bold\\">\\n                                    <field name=\\"success_ratio\\" widget=\\"progressbar\\" class=\\"d-block\\" style=\\"word-break: normal;\\"/>\\n                                    <span class=\\"text-muted\\" t-if=\\"!record.certification.raw_value\\">Passed</span>\\n                                    <span class=\\"text-muted\\" t-else=\\"\\">Certified</span>\\n                                </a>\\n                            </div>\\n                            <div t-if=\\"!selection_mode\\" class=\\"col-lg-3 col-sm-12 d-none d-sm-flex justify-content-end gap-1 my-2 ms-auto pb-lg-3 py-0\\">\\n                                <button name=\\"action_send_survey\\" string=\\"Share\\" type=\\"object\\" class=\\"btn btn-secondary text-nowrap\\" invisible=\\"not active\\">\\n                                    Share\\n                                </button>\\n                                <button name=\\"action_test_survey\\" string=\\"Test\\" type=\\"object\\" class=\\"btn btn-secondary text-nowrap\\" invisible=\\"not active\\">\\n                                    Test\\n                                </button>\\n                                <button name=\\"action_result_survey\\" string=\\"See results\\" type=\\"object\\" class=\\"btn btn-secondary\\" invisible=\\"not active\\">\\n                                    See results\\n                                </button>\\n                                <button name=\\"action_start_session\\" string=\\"Start Live Session\\" type=\\"object\\" class=\\"btn btn-secondary\\" invisible=\\"session_state or not active or not session_available\\">\\n                                    Start Live Session\\n                                </button>\\n                                <button name=\\"action_end_session\\" string=\\"End Live Session\\" type=\\"object\\" class=\\"btn btn-secondary\\" invisible=\\"session_state not in ['ready', 'in_progress'] or not active\\">\\n                                    End Live Session\\n                                </button>\\n                            </div>\\n                        </div>\\n                        <!-- Generic -->\\n                        <div t-if=\\"!selection_mode\\" class=\\"o_survey_kanban_card_bottom\\">\\n                            <field name=\\"activity_ids\\" widget=\\"kanban_activity\\"/>\\n                        </div>\\n                    </div>\\n                </templates>\\n            </kanban>"}	<?xml version="1.0"?>\n<kanban highlight_color="color" js_class="survey_view_kanban">\n                <field name="active"/>\n                <field name="certification"/>\n                <field name="create_date"/>\n                <field name="scoring_type"/>\n                <field name="session_state"/>\n                <field name="session_available"/>\n                <templates>\n                    <div t-name="menu" t-if="widget.editable">\n                        <a role="menuitem" type="open" class="dropdown-item">Edit Survey</a>\n                        <a t-if="record.active.raw_value" role="menuitem" type="object" class="dropdown-item" name="action_send_survey">Share</a>\n                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>\n                        <div role="separator" class="dropdown-divider"/>\n                        <div role="separator" class="dropdown-item-text">Color</div>\n                        <field name="color" widget="kanban_color_picker"/>\n                    </div>\n                    <div t-name="card" t-attf-class="o_survey_kanban_card #{record.certification.raw_value ? 'o_survey_kanban_card_certification' : ''}" class="px-0">\n                        <div class="row mx-4">\n                            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                            <div class="col-lg-2 col-sm-8 py-0 my-2 my-lg-0 col-12 g-0">\n                                <div class="d-flex flex-grow-1 flex-column my-0 my-lg-2">\n                                    <field name="title" class="fw-bold"/>\n                                    <span t-if="!selection_mode" class="d-flex align-items-center">\n                                        <field name="user_id" widget="many2one_avatar_user" options="{'display_avatar_name': True}"/>\n                                            <span class="mx-1">-</span>\n                                        <t t-esc="luxon.DateTime.fromISO(record.create_date.raw_value).toFormat('MMM yyyy')"/>\n                                    </span>\n                                </div>\n                            </div>\n                            <div t-attf-class="col-lg-1 col-sm-4 d-sm-block py-0 my-2 col-#{selection_mode ? '12' : '6'}">\n                                <field name="question_count" class="fw-bold"/><br t-if="!selection_mode"/>\n                                <span class="text-muted">Questions</span>\n                            </div>\n                            <div t-if="selection_mode" class="col-12 d-flex justify-content-end">\n                                <field name="user_id" widget="many2one_avatar_user"/>\n                            </div>\n                            <div t-if="!selection_mode" class="col-lg-1 col-sm-4 col-6 d-none py-0 my-2">\n                                <field name="answer_duration_avg" widget="float_time" class="fw-bold"/>\n                                <span class="text-muted">Average Duration</span>\n                            </div>\n                            <div t-if="!selection_mode" class="col-lg-1 col-sm-4 col-6 d-none py-0 my-2">\n                                <a type="object" name="action_survey_user_input" class="fw-bold">\n                                    <field name="answer_count"/><br/>\n                                    <span class="text-muted">Registered</span>\n                                </a>\n                            </div>\n                            <div t-if="!selection_mode" class="col-lg-1 col-sm-4 col-6 d-sm-block py-0 my-2">\n                                <a type="object" name="action_survey_user_input_completed" class="fw-bold">\n                                    <field name="answer_done_count"/><br/>\n                                    <span class="text-muted">Completed</span>\n                                </a>\n                            </div>\n                            <div t-if="!selection_mode" class="col-lg-1 col-sm-4 col-6 py-0 my-2" name="o_survey_kanban_card_section_success">\n                                 <a t-if="record.scoring_type.raw_value != 'no_scoring'" type="object" name="action_survey_user_input_certified" class="fw-bold">\n                                    <field name="success_ratio" widget="progressbar" class="d-block" style="word-break: normal;"/>\n                                    <span class="text-muted" t-if="!record.certification.raw_value">Passed</span>\n                                    <span class="text-muted" t-else="">Certified</span>\n                                </a>\n                            </div>\n                            <div t-if="!selection_mode" class="col-lg-3 col-sm-12 d-none d-sm-flex justify-content-end gap-1 my-2 ms-auto pb-lg-3 py-0">\n                                <button name="action_send_survey" string="Share" type="object" class="btn btn-secondary text-nowrap" invisible="not active">\n                                    Share\n                                </button>\n                                <button name="action_test_survey" string="Test" type="object" class="btn btn-secondary text-nowrap" invisible="not active">\n                                    Test\n                                </button>\n                                <button name="action_result_survey" string="See results" type="object" class="btn btn-secondary" invisible="not active">\n                                    See results\n                                </button>\n                                <button name="action_start_session" string="Start Live Session" type="object" class="btn btn-secondary" invisible="session_state or not active or not session_available">\n                                    Start Live Session\n                                </button>\n                                <button name="action_end_session" string="End Live Session" type="object" class="btn btn-secondary" invisible="session_state not in ['ready', 'in_progress'] or not active">\n                                    End Live Session\n                                </button>\n                            </div>\n                        </div>\n                        <!-- Generic -->\n                        <div t-if="!selection_mode" class="o_survey_kanban_card_bottom">\n                            <field name="activity_ids" widget="kanban_activity"/>\n                        </div>\n                    </div>\n                </templates>\n            </kanban>\n        	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
