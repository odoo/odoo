mic_placeholder_model_reference_field': 'res_model'}" placeholder="Write a message..."/>\n                        <field name="body" widget="sms_widget" invisible="comment_single_recipient or not recipient_single_valid" default_focus="1" options="{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'res_model'}" placeholder="Write a message..."/>\n                        <field name="body" widget="sms_widget" invisible="not comment_single_recipient" placeholder="Write a message..."/>\n                        <field name="mass_keep_log" invisible="1"/>\n                        <field name="use_exclusion_list" invisible="1"/>\n                </sheet>\n                <footer>\n                    <!-- attrs doesn't work for 'disabled'-->\n                    <button string="Send" type="object" class="oe_highlight" name="action_send_sms" data-hotkey="q" invisible="composition_mode not in ('comment', 'numbers') or not recipient_single_valid"/>\n                    <button string="Send" type="object" class="oe_highlight" name="action_send_sms" data-hotkey="q" invisible="composition_mode not in ('comment', 'numbers') or recipient_single_valid" disabled="1"/>\n                    <button string="Put in queue" type="object" class="oe_highlight" name="action_send_sms" data-hotkey="q" invisible="composition_mode != 'mass'"/>\n                    <button string="Send now" type="object" name="action_send_sms_mass_now" data-hotkey="w" invisible="composition_mode != 'mass'"/>\n                    <button string="Discard" class="btn btn-secondary" special="cancel" data-hotkey="x"/>\n                </footer>\n            </form>\n        	f	t	2026-09-05 15:59:47.447069	2026-09-05 15:59:47.447069	f
