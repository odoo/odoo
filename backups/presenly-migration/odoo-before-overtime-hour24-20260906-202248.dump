 o_survey_start">\n            <div class="mb32">\n                <h1 t-out="survey.title" class="o_survey_main_title pb-2"/>\n                <div t-field="survey.description" class="oe_no_empty pb-2 text-break"/>\n                <t t-if="answer.is_session_answer">\n                    <div class="fw-bold">\n                        The session will begin automatically when the host starts.\n                    </div>\n                </t>\n                <t t-else="">\n                    <div t-if="survey.is_time_limited">\n                        <p>\n                            <span t-if="not survey.certification">Time limit for this survey: </span>\n                            <span t-else="">Time limit for this certification: </span>\n                            <span class="fw-bold text-danger" t-field="survey.time_limit" t-options="{'widget': 'duration', 'unit': 'minute'}"/>\n                        </p>\n                    </div>\n                    <button type="submit" value="start" class="btn btn-primary btn-lg disabled">\n                        <t t-if="survey.certification">\n                            Start Certification\n                        </t>\n                        <t t-else="">\n                            Start Survey\n                        </t>\n                    </button>\n                    <span class="o_survey_enter fw-bold text-muted ms-2 d-none d-md-inline">or press Enter</span>\n                </t>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
922	16	\N	1	1	Survey: form with questions	\N	survey.survey_fill_form_in_progress	qweb	survey/views/survey_templates.xml	primary	{"en_US": "<t name=\\"Survey: form with questions\\" t-name=\\"survey.survey_fill_form_in_progress\\">\\n        <div class=\\"o_survey_form_content_data d-none\\" t-att-data-question-time-limit-reached=\\"answer.question_time_limit_reached\\" t-att-data-has-answered=\\"bool(has_answered)\\" t-att-data-is-page-description=\\"bool(question and question.is_page and not is_html_empty(question.description))\\" t-att-data-server-time=\\"server_time\\" t-att-data-survey-last-triggering-answers=\\"survey_last_triggering_answers\\" t-att-data-timer=\\"timer_start\\" t-att-data-time-limit-minutes=\\"time_limit_minutes\\"/>\\n        <t t-if=\\"survey.questions_layout == 'one_page'\\">\\n            <!-- Questions without section -->\\n            <t t-foreach=\\"survey.question_ids.filtered(lambda q: not q.page_id)\\" t-as=\\"question\\">\\n                <t t-if=\\"question in answer.predefined_question_ids\\" t-call=\\"survey.question_container\\"/>\\n            </t>\\n            <!-- Questions with section -->\\n            <t t-foreach=\\"survey.page_ids\\" t-as=\\"page\\">\\n                <t t-set=\\"display_section\\" t-value=\\"page.description or any(not q.triggering_answer_ids for q in page.question_ids)                     or (survey.questions_selection == 'random' and page.question_ids and page.random_questions_count &gt; 0)\\"/>\\n                <div t-attf-class=\\"js_section_wrapper #{'d-none' if not display_section else ''}\\">\\n                    <h2 t-field=\\"page.title\\" class=\\"o_survey_title pb16 text-break\\"/>\\n                    <div t-field=\\"page.description\\" class=\\"o_survey_description text-break\\"/>\\n                    <t t-foreach=\\"page.question_ids\\" t-as=\\"question\\">\\n                        <t t-if=\\"question in answer.predefined_question_ids\\" t-call=\\"survey.question_container\\"/>\\n                    </t>\\n                </div>\\n            </t>\\n\\n            <div class=\\"text-center mt16 mb256\\">\\n                <button type=\\"submit\\" value=\\"finish\\" class=\\"btn btn-secondary disabled\\">Submit</button>\\n                <button id=\\"next_page\\" t-attf-class=\\"btn #{'btn-secondary' if survey_last else 'btn-primary'} d-none\\">Next</button>\\n                <span class=\\"fw-bold text-muted ms-2 d-none d-md-inline\\">\\n                    <span id=\\"enter-tooltip\\">or press CTRL+Enter</span>\\n                </span>\\n            </div>\\n        </t>\\n\\n        <t t-if=\\"survey.questions_layout == 'page_per_section'\\">\\n            <h2 t-field=\\"page.title\\" class=\\"o_survey_title pb16 text-break\\"/>\\n            <div t-field=\\"page.description\\" class=\\"oe_no_empty text-break\\"/>\\n\\n            <input type=\\"hidden\\" name=\\"page_id\\" t-att-value=\\"page.id\\"/>\\n            <t t-foreach=\\"page.question_ids\\" t-as=\\"question\\">\\n                <t t-if=\\"question in answer.predefined_question_ids\\" t-call=\\"survey.question_container\\"/>\\n            </t>\\n\\n            <div class=\\"row\\">\\n                <div class=\\"col-12 text-center mt16\\">\\n                    <t t-set=\\"submit_value\\" t-value=\\"'finish' if survey_last or answer.is_session_answer else 'next_skipped'                         if answer.survey_first_submitted and skipped_questions.page_id and page in skipped_questions.page_id else 'next'\\"/>\\n                    <button type=\\"submit\\" t-att-value=\\"submit_value\\" t-attf-class=\\"btn #{'btn-secondary' if survey_last else 'btn-primary'} disabled\\">\\n                        <t t-if=\\"submit_value == 'finish'\\">Submit</t>\\n                        <t t-elif=\\"submit_value == 'next_skipped'\\">Next Skipped</t>\\n                        <t t-else=\\"\\">Continue</t>\\n                    </button>\\n                    <button id=\\"next_page\\" t-attf-class=\\"btn #{'btn-secondary' if survey_last else 'btn-primary'} d-none\\">Next</button>\\n                    <span class=\\"fw-bold text-muted ms-2 d-none d-md-inline\\" id=\\"enter-tooltip\\"> or press CTRL+Enter</span>\\n                </div>\\n            </div>\\n        </t>\\n\\n        <!-- Minimized display means we display the choices vertically (instead of optimized based on screen space).\\n        An exception is made for options with images, where we always want to optimize screen space.-->\\n        <t t-set=\\"minimized_display\\" t-value=\\"survey.questions_layout == 'page_per_question' and not any(suggestion.value_image for suggestion in question.suggested_answer_ids)\\"/>\\n        <div t-if=\\"survey.questions_layout == 'page_per_question'\\" t-attf-class=\\"o_survey_page_per_question\\">\\n            <input type=\\"hidden\\" name=\\"question_id\\" t-att-value=\\"question.id\\"/>\\n            <!-- User has already answered for this session -->\\n            <t t-if=\\"answer.is_session_answer and (has_answered or answer.question_time_limit_reached)\\">\\n                <div t-if=\\"answer.question_time_limit_reached and not has_answered\\" class=\\"fw-bold\\">Sorry, you have not been fast enough.</div>\\n                <div t-else=\\"\\" class=\\"fw-bold\\">We have registered your answer! Please wait for the host to go to the next question.</div>\\n                <fieldset disabled=\\"disabled\\">\\n                    <t t-set=\\"survey_form_readonly\\" t-value=\\"True\\"/>\\n                    <div class=\\"mt-5\\">\\n                        <t t-call=\\"survey.question_container\\"/>\\n                    </div>\\n                </fieldset>\\n            </t>\\n            <t t-elif=\\"answer.is_session_answer and question.is_page and not is_html_empty(question.description)\\">\\n                <div class=\\"fw-bold mt-5\\">Pay attention to the host screen until the next question.</div>\\n            </t>\\n            <t t-else=\\"\\">\\n                <div class=\\"mt-5\\">\\n                    <t t-call=\\"survey.question_container\\"/>\\n                </div>\\n\\n                <div class=\\"row\\">\\n                    <div class=\\"col-12 text-center mt16\\">\\n                        <t t-set=\\"submit_value\\" t-value=\\"'finish' if survey_last or answer.is_session_answer else                             'next_skipped' if answer.survey_first_submitted and skipped_questions and question in skipped_questions else 'next'\\"/>\\n                        <button type=\\"submit\\" t-att-value=\\"submit_value\\" t-attf-class=\\"btn #{'btn-secondary' if survey_last else 'btn-primary'} disabled\\">\\n                            <t t-if=\\"submit_value == 'finish'\\">Submit</t>\\n                            <t t-elif=\\"submit_value == 'next_skipped'\\">Next Skipped</t>\\n                            <t t-else=\\"\\">Continue</t>\\n                        </button>\\n                        <button id=\\"next_page\\" t-attf-class=\\"btn #{'btn-secondary' if survey_last else 'btn-primary'} d-none\\">Next</button>\\n                        <span class=\\"fw-bold text-muted ms-2 d-none d-md-inline\\">\\n                            <span id=\\"enter-tooltip\\">or press Enter</span>\\n                        </span>\\n                    </div>\\n                </div>\\n            </t>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: form with questions" t-name="survey.survey_fill_form_in_progress">\n        <div class="o_survey_form_content_data d-none" t-att-data-question-time-limit-reached="answer.question_time_limit_reached" t-att-data-has-answered="bool(has_answered)" t-att-data-is-page-description="bool(question and question.is_page and not is_html_empty(question.description))" t-att-data-server-time="server_time" t-att-data-survey-last-triggering-answers="survey_last_triggering_answers" t-att-data-timer="timer_start" t-att-data-time-limit-minutes="time_limit_minutes"/>\n        <t t-if="survey.questions_layout == 'one_page'">\n            <!-- Questions without section -->\n            <t t-foreach="survey.question_ids.filtered(lambda q: not q.page_id)" t-as="question">\n                <t t-if="question in answer.predefined_question_ids" t-call="survey.question_container"/>\n            </t>\n            <!-- Questions with section -->\n            <t t-foreach="survey.page_ids" t-as="page">\n                <t t-set="display_section" t-value="page.description or any(not q.triggering_answer_ids for q in page.question_ids)                     or (survey.questions_selection == 'random' and page.question_ids and page.random_questions_count &gt; 0)"/>\n                <div t-attf-class="js_section_wrapper #{'d-none' if not display_section else ''}">\n                    <h2 t-field="page.title" class="o_survey_title pb16 text-break"/>\n                    <div t-field="page.description" class="o_survey_description text-break"/>\n                    <t t-foreach="page.question_ids" t-as="question">\n                        <t t-if="question in answer.predefined_question_ids" t-call="survey.question_container"/>\n                    </t>\n                </div>\n            </t>\n\n            <div class="text-center mt16 mb256">\n                <button type="submit" value="finish" class="btn btn-secondary disabled">Submit</button>\n                <button id="next_page" t-attf-class="btn #{'btn-secondary' if survey_last else 'btn-primary'} d-none">Next</button>\n                <span class="fw-bold text-muted ms-2 d-none d-md-inline">\n                    <span id="enter-tooltip">or press CTRL+Enter</span>\n                </span>\n            </div>\n        </t>\n\n        <t t-if="survey.questions_layout == 'page_per_section'">\n            <h2 t-field="page.title" class="o_survey_title pb16 text-break"/>\n            <div t-field="page.description" class="oe_no_empty text-break"/>\n\n            <input type="hidden" name="page_id" t-att-value="page.id"/>\n            <t t-foreach="page.question_ids" t-as="question">\n                <t t-if="question in answer.predefined_question_ids" t-call="survey.question_container"/>\n            </t>\n\n            <div class="row">\n                <div class="col-12 text-center mt16">\n                    <t t-set="submit_value" t-value="'finish' if survey_last or answer.is_session_answer else 'next_skipped'                         if answer.survey_first_submitted and skipped_questions.page_id and page in skipped_questions.page_id else 'next'"/>\n                    <button type="submit" t-att-value="submit_value" t-attf-class="btn #{'btn-secondary' if survey_last else 'btn-primary'} disabled">\n                        <t t-if="submit_value == 'finish'">Submit</t>\n                        <t t-elif="submit_value == 'next_skipped'">Next Skipped</t>\n                        <t t-else="">Continue</t>\n                    </button>\n                    <button id="next_page" t-attf-class="btn #{'btn-secondary' if survey_last else 'btn-primary'} d-none">Next</button>\n                    <span class="fw-bold text-muted ms-2 d-none d-md-inline" id="enter-tooltip"> or press CTRL+Enter</span>\n                </div>\n            </div>\n        </t>\n\n        <!-- Minimized display means we display the choices vertically (instead of optimized based on screen space).\n        An exception is made for options with images, where we always want to optimize screen space.-->\n        <t t-set="minimized_display" t-value="survey.questions_layout == 'page_per_question' and not any(suggestion.value_image for suggestion in question.suggested_answer_ids)"/>\n        <div t-if="survey.questions_layout == 'page_per_question'" t-attf-class="o_survey_page_per_question">\n            <input type="hidden" name="question_id" t-att-value="question.id"/>\n            <!-- User has already answered for this session -->\n            <t t-if="answer.is_session_answer and (has_answered or answer.question_time_limit_reached)">\n                <div t-if="answer.question_time_limit_reached and not has_answered" class="fw-bold">Sorry, you have not been fast enough.</div>\n                <div t-else="" class="fw-bold">We have registered your answer! Please wait for the host to go to the next question.</div>\n                <fieldset disabled="disabled">\n                    <t t-set="survey_form_readonly" t-value="True"/>\n                    <div class="mt-5">\n                        <t t-call="survey.question_container"/>\n                    </div>\n                </fieldset>\n            </t>\n            <t t-elif="answer.is_session_answer and question.is_page and not is_html_empty(question.description)">\n                <div class="fw-bold mt-5">Pay attention to the host screen until the next question.</div>\n            </t>\n            <t t-else="">\n                <div class="mt-5">\n                    <t t-call="survey.question_container"/>\n                </div>\n\n                <div class="row">\n                    <div class="col-12 text-center mt16">\n                        <t t-set="submit_value" t-value="'finish' if survey_last or answer.is_session_answer else                             'next_skipped' if answer.survey_first_submitted and skipped_questions and question in skipped_questions else 'next'"/>\n                        <button type="submit" t-att-value="submit_value" t-attf-class="btn #{'btn-secondary' if survey_last else 'btn-primary'} disabled">\n                            <t t-if="submit_value == 'finish'">Submit</t>\n                            <t t-elif="submit_value == 'next_skipped'">Next Skipped</t>\n                            <t t-else="">Continue</t>\n                        </button>\n                        <button id="next_page" t-attf-class="btn #{'btn-secondary' if survey_last else 'btn-primary'} d-none">Next</button>\n                        <span class="fw-bold text-muted ms-2 d-none d-md-inline">\n                            <span id="enter-tooltip">or press Enter</span>\n                        </span>\n                    </div>\n                </div>\n            </t>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
923	16	\N	1	1	Survey: finished	\N	survey.survey_fill_form_done	qweb	survey/views/survey_templates.xml	primary	{"en_US": "<t name=\\"Survey: finished\\" t-name=\\"survey.survey_fill_form_done\\">\\n        <div class=\\"wrap\\">\\n            <div class=\\"o_survey_finished mt32 mb32\\">\\n                <h1 t-out=\\"survey.title\\" class=\\"o_survey_main_title pb-2\\"/>\\n                <h1 class=\\"fs-2\\">\\n                    <t t-if=\\"survey.scoring_type != 'no_scoring'\\">\\n                        You scored <t t-out=\\"answer.scoring_percentage\\"/>%\\n                    </t>\\n                    <t t-else=\\"\\">Thank you!</t>\\n                </h1>\\n                <div t-field=\\"survey.description_done\\" class=\\"oe_no_empty\\"/>\\n                <div class=\\"row\\">\\n                    <div class=\\"col\\">\\n                        <t t-if=\\"survey.scoring_type != 'no_scoring' and survey.scoring_success_min\\">\\n                            <t t-if=\\"answer.scoring_success\\">\\n                                <div>Congratulations, you have passed the test!</div>\\n\\n                                <div t-if=\\"survey.certification\\" class=\\"mt16 mb16\\">\\n                                    <a role=\\"button\\" class=\\"btn btn-primary btn-lg\\" t-att-href=\\"'/survey/%s/get_certification' % survey.id\\">\\n                                        <i class=\\"fa fa-fw fa-trophy\\" role=\\"img\\" aria-label=\\"Download certification\\" title=\\"Download certification\\"/>\\n                                        Download certification\\n                                    </a>\\n                                </div>\\n                            </t>\\n                            <t t-else=\\"\\">\\n                                <div>Unfortunately, you have failed the test.</div>\\n                            </t>\\n                        </t>\\n                        <div class=\\"d-flex gap-3 mt-3\\">\\n                            <t t-call=\\"survey.survey_button_retake\\"/>\\n                            <p t-if=\\"survey.scoring_type != 'scoring_without_answers'\\">\\n                                <a role=\\"button\\" class=\\"o_survey_review btn btn-secondary btn-lg\\" t-att-href=\\"'/survey/print/%s?answer_token=%s&amp;review=True' % (survey.access_token, answer.access_token)\\">\\n                                    Review your answers\\n                                </a>\\n                            </p>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-6 text-center\\" t-if=\\"survey.certification_give_badge and answer.scoring_success\\">\\n                        <img t-att-src=\\"'/web/image/gamification.badge/%s/image_128' % survey.certification_badge_id.id\\"/>\\n                        <div>You received the badge <span class=\\"fw-bold\\" t-esc=\\"survey.certification_badge_id.name\\"/>!</div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: finished" t-name="survey.survey_fill_form_done">\n        <div class="wrap">\n            <div class="o_survey_finished mt32 mb32">\n                <h1 t-out="survey.title" class="o_survey_main_title pb-2"/>\n                <h1 class="fs-2">\n                    <t t-if="survey.scoring_type != 'no_scoring'">\n                        You scored <t t-out="answer.scoring_percentage"/>%\n                    </t>\n                    <t t-else="">Thank you!</t>\n                </h1>\n                <div t-field="survey.description_done" class="oe_no_empty"/>\n                <div class="row">\n                    <div class="col">\n                        <t t-if="survey.scoring_type != 'no_scoring' and survey.scoring_success_min">\n                            <t t-if="answer.scoring_success">\n                                <div>Congratulations, you have passed the test!</div>\n\n                                <div t-if="survey.certification" class="mt16 mb16">\n                                    <a role="button" class="btn btn-primary btn-lg" t-att-href="'/survey/%s/get_certification' % survey.id">\n                                        <i class="fa fa-fw fa-trophy" role="img" aria-label="Download certification" title="Download certification"/>\n                                        Download certification\n                                    </a>\n                                </div>\n                            </t>\n                            <t t-else="">\n                                <div>Unfortunately, you have failed the test.</div>\n                            </t>\n                        </t>\n                        <div class="d-flex gap-3 mt-3">\n                            <t t-call="survey.survey_button_retake"/>\n                            <p t-if="survey.scoring_type != 'scoring_without_answers'">\n                                <a role="button" class="o_survey_review btn btn-secondary btn-lg" t-att-href="'/survey/print/%s?answer_token=%s&amp;review=True' % (survey.access_token, answer.access_token)">\n                                    Review your answers\n                                </a>\n                            </p>\n                        </div>\n                    </div>\n                    <div class="col-6 text-center" t-if="survey.certification_give_badge and answer.scoring_success">\n                        <img t-att-src="'/web/image/gamification.badge/%s/image_128' % survey.certification_badge_id.id"/>\n                        <div>You received the badge <span class="fw-bold" t-esc="survey.certification_badge_id.name"/>!</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
924	16	\N	1	1	Survey: question container	\N	survey.question_container	qweb	survey/views/survey_templates.xml	primary	{"en_US": "<t name=\\"Survey: question container\\" t-name=\\"survey.question_container\\">\\n        <t t-set=\\"display_question\\" t-value=\\"survey.questions_layout == 'page_per_question'                     or survey.questions_selection == 'random'                     or (survey.questions_layout == 'one_page' and not question.triggering_answer_ids)                     or (survey.questions_layout == 'page_per_section' and (not question.triggering_answer_ids                         or any(triggering_answer in selected_answers for triggering_answer in triggering_answers_by_question[question.id])))\\"/>\\n\\n        <t t-set=\\"answer_lines\\" t-value=\\"answer.user_input_line_ids.filtered(lambda line: line.question_id == question)\\"/>\\n        <t t-set=\\"answers_contain_image\\" t-value=\\"any(a.value_image for a in question.suggested_answer_ids)\\"/>\\n        <t t-set=\\"use_half_columns\\" t-value=\\"survey.questions_layout == 'page_per_question' and answers_contain_image\\"/>\\n        <t t-set=\\"use_half_col_lg\\" t-value=\\"'col-lg-6' if (use_half_columns and not survey_form_readonly) or (answer.is_session_answer and answers_contain_image) else ''\\"/>\\n        <!--Use Key selection if number of choices is < 26 to keep Z for other choice if any-->\\n        <t t-set=\\"letters\\" t-value=\\"'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\\"/>\\n        <t t-set=\\"useKeySelection\\" t-value=\\"len(question.suggested_answer_ids) &lt; len(letters) and survey.questions_layout == 'page_per_question'\\"/>\\n        <!-- Extra 'right' margin is added on layouts that are not \\"page_per_question\\" to align with choices questions, since all choices have a me-2 class (pixel perfect yay...) -->\\n        <t t-set=\\"extra_right_margin\\" t-value=\\"survey.questions_layout != 'page_per_question' and question.question_type not in ['simple_choice', 'multiple_choice']\\"/>\\n        <t t-set=\\"default_constr_error_msg\\">This question requires an answer.</t>\\n        <t t-set=\\"default_validation_error_msg\\">The answer you entered is not valid.</t>\\n        <t t-set=\\"default_comments_message\\">If other, please specify:</t>\\n        <t t-set=\\"is_skipped_question\\" t-value=\\"skipped_questions and question in skipped_questions\\"/>\\n        <div t-attf-class=\\"js_question-wrapper pb-4                            #{'d-none' if not display_question else ''}                            #{'me-2' if extra_right_margin else ''}\\" t-att-id=\\"question.id\\" t-att-data-required=\\"bool(question.constr_mandatory and (not survey.users_can_go_back or survey.questions_layout == 'one_page')) or None\\" t-att-data-constr-error-msg=\\"question.constr_error_msg or default_constr_error_msg if question.constr_mandatory else None\\" t-att-data-validation-error-msg=\\"question.validation_error_msg or default_validation_error_msg if question.validation_required else None\\">\\n            <div class=\\"mb-4\\">\\n                <h3 t-if=\\"not hide_question_title\\">\\n                    <span t-field=\\"question.title\\" class=\\"text-break\\"/>\\n                    <span t-if=\\"question.constr_mandatory\\" class=\\"text-danger\\">*</span>\\n                </h3>\\n                <div t-if=\\"not is_html_empty(question.description)\\" t-field=\\"question.description\\" class=\\"text-muted oe_no_empty mt-1 text-break\\"/>\\n            </div>\\n            <t t-if=\\"question.question_type == 'text_box'\\" t-call=\\"survey.question_text_box\\"/>\\n            <t t-if=\\"question.question_type == 'char_box'\\" t-call=\\"survey.question_char_box\\"/>\\n            <t t-if=\\"question.question_type == 'numerical_box'\\" t-call=\\"survey.question_numerical_box\\"/>\\n            <t t-if=\\"question.question_type == 'date'\\" t-call=\\"survey.question_date\\"/>\\n            <t t-if=\\"question.question_type == 'datetime'\\" t-call=\\"survey.question_datetime\\"/>\\n            <t t-if=\\"question.question_type == 'simple_choice'\\" t-call=\\"survey.question_simple_choice\\"/>\\n            <t t-if=\\"question.question_type == 'scale'\\" t-call=\\"survey.question_scale\\"/>\\n            <t t-if=\\"question.question_type == 'multiple_choice'\\" t-call=\\"survey.question_multiple_choice\\"/>\\n            <t t-if=\\"question.question_type == 'matrix'\\" t-call=\\"survey.question_matrix\\"/>\\n            <div t-attf-class=\\"o_survey_question_error d-flex align-items-center justify-content-between overflow-hidden                  border-0 py-0 px-3 alert alert-danger mt-2 #{'slide_in' if is_skipped_question else ''}\\" role=\\"alert\\">\\n                <span t-if=\\"is_skipped_question\\" t-out=\\"question.constr_error_msg or default_constr_error_msg\\"/>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: question container" t-name="survey.question_container">\n        <t t-set="display_question" t-value="survey.questions_layout == 'page_per_question'                     or survey.questions_selection == 'random'                     or (survey.questions_layout == 'one_page' and not question.triggering_answer_ids)                     or (survey.questions_layout == 'page_per_section' and (not question.triggering_answer_ids                         or any(triggering_answer in selected_answers for triggering_answer in triggering_answers_by_question[question.id])))"/>\n\n        <t t-set="answer_lines" t-value="answer.user_input_line_ids.filtered(lambda line: line.question_id == question)"/>\n        <t t-set="answers_contain_image" t-value="any(a.value_image for a in question.suggested_answer_ids)"/>\n        <t t-set="use_half_columns" t-value="survey.questions_layout == 'page_per_question' and answers_contain_image"/>\n        <t t-set="use_half_col_lg" t-value="'col-lg-6' if (use_half_columns and not survey_form_readonly) or (answer.is_session_answer and answers_contain_image) else ''"/>\n        <!--Use Key selection if number of choices is < 26 to keep Z for other choice if any-->\n        <t t-set="letters" t-value="'ABCDEFGHIJKLMNOPQRSTUVWXYZ'"/>\n        <t t-set="useKeySelection" t-value="len(question.suggested_answer_ids) &lt; len(letters) and survey.questions_layout == 'page_per_question'"/>\n        <!-- Extra 'right' margin is added on layouts that are not "page_per_question" to align with choices questions, since all choices have a me-2 class (pixel perfect yay...) -->\n        <t t-set="extra_right_margin" t-value="survey.questions_layout != 'page_per_question' and question.question_type not in ['simple_choice', 'multiple_choice']"/>\n        <t t-set="default_constr_error_msg">This question requires an answer.</t>\n        <t t-set="default_validation_error_msg">The answer you entered is not valid.</t>\n        <t t-set="default_comments_message">If other, please specify:</t>\n        <t t-set="is_skipped_question" t-value="skipped_questions and question in skipped_questions"/>\n        <div t-attf-class="js_question-wrapper pb-4                            #{'d-none' if not display_question else ''}                            #{'me-2' if extra_right_margin else ''}" t-att-id="question.id" t-att-data-required="bool(question.constr_mandatory and (not survey.users_can_go_back or survey.questions_layout == 'one_page')) or None" t-att-data-constr-error-msg="question.constr_error_msg or default_constr_error_msg if question.constr_mandatory else None" t-att-data-validation-error-msg="question.validation_error_msg or default_validation_error_msg if question.validation_required else None">\n            <div class="mb-4">\n                <h3 t-if="not hide_question_title">\n                    <span t-field="question.title" class="text-break"/>\n                    <span t-if="question.constr_mandatory" class="text-danger">*</span>\n                </h3>\n                <div t-if="not is_html_empty(question.description)" t-field="question.description" class="text-muted oe_no_empty mt-1 text-break"/>\n            </div>\n            <t t-if="question.question_type == 'text_box'" t-call="survey.question_text_box"/>\n            <t t-if="question.question_type == 'char_box'" t-call="survey.question_char_box"/>\n            <t t-if="question.question_type == 'numerical_box'" t-call="survey.question_numerical_box"/>\n            <t t-if="question.question_type == 'date'" t-call="survey.question_date"/>\n            <t t-if="question.question_type == 'datetime'" t-call="survey.question_datetime"/>\n            <t t-if="question.question_type == 'simple_choice'" t-call="survey.question_simple_choice"/>\n            <t t-if="question.question_type == 'scale'" t-call="survey.question_scale"/>\n            <t t-if="question.question_type == 'multiple_choice'" t-call="survey.question_multiple_choice"/>\n            <t t-if="question.question_type == 'matrix'" t-call="survey.question_matrix"/>\n            <div t-attf-class="o_survey_question_error d-flex align-items-center justify-content-between overflow-hidden                  border-0 py-0 px-3 alert alert-danger mt-2 #{'slide_in' if is_skipped_question else ''}" role="alert">\n                <span t-if="is_skipped_question" t-out="question.constr_error_msg or default_constr_error_msg"/>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
