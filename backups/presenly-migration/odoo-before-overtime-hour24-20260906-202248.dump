505	16	\N	1	1	Portal Search Bar	\N	portal.portal_searchbar	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t name=\\"Portal Search Bar\\" t-name=\\"portal.portal_searchbar\\">\\n        <nav t-attf-class=\\"navbar navbar-expand-lg flex-wrap mb-4 p-0 o_portal_navbar {{classes if classes else ''}}\\">\\n            <!--  Navbar breadcrumb or title  -->\\n            <t t-if=\\"breadcrumbs_searchbar\\">\\n                <t t-call=\\"portal.portal_breadcrumbs\\"/>\\n            </t>\\n            <span t-else=\\"\\" class=\\"navbar-brand mb-0 h1 me-auto\\" t-esc=\\"title or 'No title'\\"/>\\n\\n            <!--  Collapse button -->\\n            <button t-if=\\"searchbar_sortings or searchbar_filters or searchbar_groupby or searchbar_inputs\\" class=\\"navbar-toggler\\" type=\\"button\\" data-bs-toggle=\\"collapse\\" data-bs-target=\\"#o_portal_navbar_content\\" aria-controls=\\"navbarSupportedContent\\" aria-expanded=\\"false\\" aria-label=\\"Toggle filters\\">\\n                <span class=\\"fa fa-fw fa-bars\\"/>\\n            </button>\\n\\n            <!--  Collapsable content  -->\\n            <div class=\\"collapse navbar-collapse flex-wrap-reverse justify-content-end gap-3\\" id=\\"o_portal_navbar_content\\">\\n                <div class=\\"nav flex-column flex-sm-row gap-2 ms-auto p-0 mb-3 mb-lg-0 mt-1 mt-lg-0\\">\\n                    <div t-if=\\"searchbar_sortings\\">\\n                        <span class=\\"small me-1 navbar-text\\">Sort By:</span>\\n                        <div class=\\"btn-group\\">\\n                            <button id=\\"portal_searchbar_sortby\\" data-bs-toggle=\\"dropdown\\" class=\\"btn btn-light dropdown-toggle\\">\\n                                <t t-esc=\\"searchbar_sortings[sortby].get('label', 'Newest')\\"/>\\n                            </button>\\n                            <div class=\\"dropdown-menu dropdown-menu-end\\" aria-labelledby=\\"portal_searchbar_sortby\\">\\n                                <t t-foreach=\\"searchbar_sortings\\" t-as=\\"option\\">\\n                                    <a t-att-href=\\"request.httprequest.path + '?' + keep_query('*', sortby=option)\\" t-attf-class=\\"dropdown-item#{sortby == option and ' active' or ''}\\">\\n                                        <span t-esc=\\"searchbar_sortings[option].get('label')\\"/>\\n                                    </a>\\n                                </t>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div t-if=\\"searchbar_filters\\" class=\\"ms-lg-2\\">\\n                        <span class=\\"small me-1 navbar-text\\">Filter By:</span>\\n                        <div class=\\"btn-group\\">\\n                            <button id=\\"portal_searchbar_filters\\" data-bs-toggle=\\"dropdown\\" class=\\"btn btn-light dropdown-toggle\\">\\n                                <t t-esc=\\"searchbar_filters.get(filterby,searchbar_filters.get('all')).get('label', 'All')\\"/>\\n                            </button>\\n                            <div class=\\"dropdown-menu dropdown-menu-end\\" aria-labelledby=\\"portal_searchbar_filters\\">\\n                                <t t-foreach=\\"searchbar_filters\\" t-as=\\"option\\">\\n                                    <a t-att-href=\\"default_url + '?' + keep_query('*', filterby=option)\\" t-attf-class=\\"dropdown-item#{filterby == option and ' active' or ''}\\">\\n                                        <span t-esc=\\"searchbar_filters[option].get('label')\\"/>\\n                                    </a>\\n                                </t>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div t-if=\\"searchbar_groupby\\" class=\\"ms-lg-2\\">\\n                        <span class=\\"small me-1 navbar-text\\">Group By:</span>\\n                        <div class=\\"btn-group\\">\\n                            <button id=\\"portal_searchbar_groupby\\" data-bs-toggle=\\"dropdown\\" class=\\"btn btn-light dropdown-toggle\\">\\n                                <t t-esc=\\"searchbar_groupby[groupby].get('label', 'None')\\"/>\\n                            </button>\\n                            <div class=\\"dropdown-menu dropdown-menu-end\\" aria-labelledby=\\"portal_searchbar_groupby\\">\\n                                <t t-foreach=\\"searchbar_groupby\\" t-as=\\"option\\">\\n                                    <a t-att-href=\\"default_url + '?' + keep_query('*', groupby=option)\\" t-attf-class=\\"dropdown-item#{groupby == option and ' active' or ''}\\">\\n                                        <span t-esc=\\"searchbar_groupby[option].get('label')\\"/>\\n                                    </a>\\n                                </t>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <t t-out=\\"0\\"/>\\n                </div>\\n                <form t-if=\\"searchbar_inputs\\" class=\\"o_portal_search_panel col-md-5 col-xl-4 ms-lg-2\\">\\n                    <div class=\\"input-group w-100\\">\\n                        <button type=\\"button\\" class=\\"btn btn-light border-end dropdown-toggle\\" data-bs-toggle=\\"dropdown\\"/>\\n                        <div class=\\"dropdown-menu dropdown-menu-end\\" role=\\"menu\\">\\n                            <t t-foreach=\\"searchbar_inputs\\" t-as=\\"input\\">\\n                                <a t-att-href=\\"'#' + input_value['input']\\" t-attf-class=\\"dropdown-item#{search_in == input_value['input'] and ' active' or ''}\\">\\n                                    <span t-out=\\"input_value['label']\\"/>\\n                                </a>\\n                            </t>\\n                        </div>\\n                        <input type=\\"search\\" class=\\"form-control border-0 bg-light\\" placeholder=\\"Search\\" t-att-value=\\"search\\" name=\\"search\\"/>\\n                        <button class=\\"btn btn-light\\" type=\\"submit\\">\\n                            <span class=\\"oi oi-search\\"/>\\n                        </button>\\n                    </div>\\n                </form>\\n            </div>\\n        </nav>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Portal Search Bar" t-name="portal.portal_searchbar">\n        <nav t-attf-class="navbar navbar-expand-lg flex-wrap mb-4 p-0 o_portal_navbar {{classes if classes else ''}}">\n            <!--  Navbar breadcrumb or title  -->\n            <t t-if="breadcrumbs_searchbar">\n                <t t-call="portal.portal_breadcrumbs"/>\n            </t>\n            <span t-else="" class="navbar-brand mb-0 h1 me-auto" t-esc="title or 'No title'"/>\n\n            <!--  Collapse button -->\n            <button t-if="searchbar_sortings or searchbar_filters or searchbar_groupby or searchbar_inputs" class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#o_portal_navbar_content" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle filters">\n                <span class="fa fa-fw fa-bars"/>\n            </button>\n\n            <!--  Collapsable content  -->\n            <div class="collapse navbar-collapse flex-wrap-reverse justify-content-end gap-3" id="o_portal_navbar_content">\n                <div class="nav flex-column flex-sm-row gap-2 ms-auto p-0 mb-3 mb-lg-0 mt-1 mt-lg-0">\n                    <div t-if="searchbar_sortings">\n                        <span class="small me-1 navbar-text">Sort By:</span>\n                        <div class="btn-group">\n                            <button id="portal_searchbar_sortby" data-bs-toggle="dropdown" class="btn btn-light dropdown-toggle">\n                                <t t-esc="searchbar_sortings[sortby].get('label', 'Newest')"/>\n                            </button>\n                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="portal_searchbar_sortby">\n                                <t t-foreach="searchbar_sortings" t-as="option">\n                                    <a t-att-href="request.httprequest.path + '?' + keep_query('*', sortby=option)" t-attf-class="dropdown-item#{sortby == option and ' active' or ''}">\n                                        <span t-esc="searchbar_sortings[option].get('label')"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                    <div t-if="searchbar_filters" class="ms-lg-2">\n                        <span class="small me-1 navbar-text">Filter By:</span>\n                        <div class="btn-group">\n                            <button id="portal_searchbar_filters" data-bs-toggle="dropdown" class="btn btn-light dropdown-toggle">\n                                <t t-esc="searchbar_filters.get(filterby,searchbar_filters.get('all')).get('label', 'All')"/>\n                            </button>\n                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="portal_searchbar_filters">\n                                <t t-foreach="searchbar_filters" t-as="option">\n                                    <a t-att-href="default_url + '?' + keep_query('*', filterby=option)" t-attf-class="dropdown-item#{filterby == option and ' active' or ''}">\n                                        <span t-esc="searchbar_filters[option].get('label')"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                    <div t-if="searchbar_groupby" class="ms-lg-2">\n                        <span class="small me-1 navbar-text">Group By:</span>\n                        <div class="btn-group">\n                            <button id="portal_searchbar_groupby" data-bs-toggle="dropdown" class="btn btn-light dropdown-toggle">\n                                <t t-esc="searchbar_groupby[groupby].get('label', 'None')"/>\n                            </button>\n                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="portal_searchbar_groupby">\n                                <t t-foreach="searchbar_groupby" t-as="option">\n                                    <a t-att-href="default_url + '?' + keep_query('*', groupby=option)" t-attf-class="dropdown-item#{groupby == option and ' active' or ''}">\n                                        <span t-esc="searchbar_groupby[option].get('label')"/>\n                                    </a>\n                                </t>\n                            </div>\n                        </div>\n                    </div>\n                    <t t-out="0"/>\n                </div>\n                <form t-if="searchbar_inputs" class="o_portal_search_panel col-md-5 col-xl-4 ms-lg-2">\n                    <div class="input-group w-100">\n                        <button type="button" class="btn btn-light border-end dropdown-toggle" data-bs-toggle="dropdown"/>\n                        <div class="dropdown-menu dropdown-menu-end" role="menu">\n                            <t t-foreach="searchbar_inputs" t-as="input">\n                                <a t-att-href="'#' + input_value['input']" t-attf-class="dropdown-item#{search_in == input_value['input'] and ' active' or ''}">\n                                    <span t-out="input_value['label']"/>\n                                </a>\n                            </t>\n                        </div>\n                        <input type="search" class="form-control border-0 bg-light" placeholder="Search" t-att-value="search" name="search"/>\n                        <button class="btn btn-light" type="submit">\n                            <span class="oi oi-search"/>\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </nav>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
506	16	\N	1	1	Contact	\N	portal.portal_contact	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t name=\\"Contact\\" t-name=\\"portal.portal_contact\\">\\n        <div class=\\"o_portal_contact_details mb-5\\">\\n            <h5>Your contact</h5>\\n            <hr class=\\"mt-1\\"/>\\n            <h6 t-esc=\\"sales_user.name\\"/>\\n            <div t-if=\\"sales_user.email_normalized\\" class=\\"d-flex align-items-baseline mb-1\\">\\n                <i class=\\"fa fa-envelope fa-fw me-1 text-600\\"/>\\n                <a class=\\"text-break w-100\\" t-att-href=\\"'mailto:'+sales_user.email\\" t-esc=\\"sales_user.email\\"/>\\n            </div>\\n            <div t-if=\\"sales_user.phone\\" class=\\"d-flex flex-nowrap align-items-center mb-1\\">\\n                <i class=\\"fa fa-phone fa-fw me-1 text-600\\"/>\\n                <span t-esc=\\"sales_user.phone\\"/>\\n            </div>\\n            <div t-if=\\"sales_user.city\\" class=\\"d-flex flex-nowrap align-items-center mb-1\\">\\n                <i class=\\"fa fa-map-marker fa-fw me-1 text-600\\"/>\\n                <span t-esc=\\"sales_user.city\\"/>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Contact" t-name="portal.portal_contact">\n        <div class="o_portal_contact_details mb-5">\n            <h5>Your contact</h5>\n            <hr class="mt-1"/>\n            <h6 t-esc="sales_user.name"/>\n            <div t-if="sales_user.email_normalized" class="d-flex align-items-baseline mb-1">\n                <i class="fa fa-envelope fa-fw me-1 text-600"/>\n                <a class="text-break w-100" t-att-href="'mailto:'+sales_user.email" t-esc="sales_user.email"/>\n            </div>\n            <div t-if="sales_user.phone" class="d-flex flex-nowrap align-items-center mb-1">\n                <i class="fa fa-phone fa-fw me-1 text-600"/>\n                <span t-esc="sales_user.phone"/>\n            </div>\n            <div t-if="sales_user.city" class="d-flex flex-nowrap align-items-center mb-1">\n                <i class="fa fa-map-marker fa-fw me-1 text-600"/>\n                <span t-esc="sales_user.city"/>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
507	16	\N	1	1	portal_my_contact	\N	portal.portal_my_contact	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t t-name=\\"portal.portal_my_contact\\">\\n        <div t-attf-class=\\"o_portal_contact_details d-flex flex-column gap-2 #{_spacingClass}\\">\\n            <div class=\\"d-flex gap-2\\">\\n                <img class=\\"o_avatar rounded\\" t-att-src=\\"_contactAvatar\\" alt=\\"Contact\\"/>\\n                <div>\\n                    <span t-attf-class=\\"d-block lh-1 mb-1 {{ 'pt-1' if not _contactLink else '' }}\\" t-out=\\"_contactName\\"/>\\n                    <a t-if=\\"_contactLink\\" href=\\"#discussion\\" class=\\"d-flex align-items-center gap-2 small lh-1\\">Send message</a>\\n                </div>\\n            </div>\\n            <t t-out=\\"0\\"/>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="portal.portal_my_contact">\n        <div t-attf-class="o_portal_contact_details d-flex flex-column gap-2 #{_spacingClass}">\n            <div class="d-flex gap-2">\n                <img class="o_avatar rounded" t-att-src="_contactAvatar" alt="Contact"/>\n                <div>\n                    <span t-attf-class="d-block lh-1 mb-1 {{ 'pt-1' if not _contactLink else '' }}" t-out="_contactName"/>\n                    <a t-if="_contactLink" href="#discussion" class="d-flex align-items-center gap-2 small lh-1">Send message</a>\n                </div>\n            </div>\n            <t t-out="0"/>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
508	16	\N	1	1	portal_my_security	\N	portal.portal_my_security	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t t-name=\\"portal.portal_my_security\\">\\n        <t t-call=\\"portal.portal_layout\\"><div class=\\"o_portal_security_body w-md-75 w-lg-50 pb-5\\">\\n            <t t-set=\\"additional_title\\">Security</t>\\n            <t t-set=\\"no_breadcrumbs\\" t-value=\\"1\\"/>\\n            <div class=\\"alert alert-danger\\" role=\\"alert\\" t-if=\\"get_error(errors)\\">\\n                <t t-esc=\\"errors\\"/>\\n            </div>\\n            <div class=\\"d-flex gap-2 my-3\\">\\n                <a href=\\"/my/\\" title=\\"Go Back\\" class=\\"btn btn-light px-2\\"><i class=\\"oi oi-chevron-left\\"/></a>\\n                <h3 class=\\"my-0\\">Connection &amp; Security</h3>\\n            </div>\\n            <section name=\\"portal_change_password\\">\\n                <h4>Change Password</h4>\\n                <t t-set=\\"path\\">password</t>\\n                <div class=\\"alert alert-success\\" role=\\"alert\\" t-if=\\"success and success.get('password')\\">\\n                    Password Updated!\\n                </div>\\n                <div class=\\"alert alert-danger\\" role=\\"alert\\" t-if=\\"get_error(errors, 'password')\\">\\n                    <t t-esc=\\"errors['password']\\"/>\\n                </div>\\n                <form action=\\"/my/security\\" method=\\"post\\" class=\\"oe_reset_password_form\\">\\n                    <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                    <input type=\\"hidden\\" name=\\"op\\" value=\\"password\\"/>\\n                    <div class=\\"mb-4\\">\\n                        <label for=\\"current\\">Password:</label>\\n                        <div class=\\"input-group input-group-sm\\">\\n                            <input type=\\"password\\" t-attf-class=\\"form-control {{ 'is-invalid' if get_error(errors, 'password.old') else '' }}\\" id=\\"current\\" name=\\"old\\" autocomplete=\\"current-password\\" required=\\"required\\"/>\\n                            <button class=\\"btn border border-start-0 o_show_password rounded-end\\" type=\\"button\\">\\n                                <i class=\\"fa fa-eye\\"/>\\n                            </button>\\n                            <div class=\\"invalid-feedback\\">\\n                                <t t-out=\\"get_error(errors, 'password.old')\\"/>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"mb-1 o_caps_lock_warning\\">\\n                        <label for=\\"new\\">New Password:</label>\\n                        <div class=\\"input-group input-group-sm mb-1\\">\\n                            <input type=\\"password\\" t-attf-class=\\"form-control {{ 'is-invalid' if get_error(errors, 'password.new1') else '' }}\\" id=\\"new\\" name=\\"new1\\" autocomplete=\\"new-password\\" required=\\"required\\"/>\\n                            <button type=\\"button\\" class=\\"btn border border-start-0 o_show_password rounded-end\\">\\n                                <i class=\\"fa fa-eye\\"/>\\n                            </button>\\n                            <div class=\\"invalid-feedback\\">\\n                                <t t-out=\\"get_error(errors, 'password.new1')\\"/>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"mb-3\\">\\n                        <label for=\\"new2\\">Verify New Password:</label>\\n                        <div class=\\"input-group input-group-sm\\">\\n                            <input type=\\"password\\" t-attf-class=\\"form-control {{ 'is-invalid' if get_error(errors, 'password.new2') else '' }}\\" id=\\"new2\\" name=\\"new2\\" autocomplete=\\"new-password\\" required=\\"required\\"/>\\n                            <button type=\\"button\\" class=\\"btn border border-start-0 o_show_password rounded-end\\">\\n                                <i class=\\"fa fa-eye\\"/>\\n                            </button>\\n                            <div class=\\"invalid-feedback\\">\\n                                <t t-out=\\"get_error(errors, 'password.new2')\\"/>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <button type=\\"submit\\" class=\\"btn btn-light\\">Change Password</button>\\n                </form>\\n            </section>\\n            <section name=\\"portal_revoke_all_devices_popup\\">\\n            <h4>Revoke All Sessions</h4>\\n                <t t-set=\\"path\\"/>\\n                    <button type=\\"button\\" class=\\"btn btn-light\\" id=\\"portal_revoke_all_sessions_popup\\">\\n                        Log out from all devices\\n                    </button>\\n            </section>\\n            <section t-if=\\"debug and allow_api_keys\\">\\n                <h4>\\n                Developer API Keys\\n                    <a href=\\"https://www.odoo.com/documentation/latest/developer/reference/external_api.html#api-key\\" target=\\"_blank\\">\\n                        <i title=\\"Documentation\\" class=\\"fa fa-fw o_button_icon fa-info-circle\\"/>\\n                    </a>\\n                </h4>\\n                <div>\\n                    <table class=\\"table o_main_table\\">\\n                        <thead>\\n                            <tr>\\n                                <th>Description</th>\\n                                <th>Scope</th>\\n                                <th>Added On</th>\\n                                <th>Expiration Date</th>\\n                                <th/>\\n                            </tr>\\n                        </thead>\\n                        <tbody>\\n                            <t t-foreach=\\"request.env.user.api_key_ids\\" t-as=\\"key\\">\\n                                <tr>\\n                                    <td><span t-field=\\"key.name\\"/></td>\\n                                    <td><span t-field=\\"key.scope\\"/></td>\\n                                    <td><span t-field=\\"key.create_date\\"/></td>\\n                                    <td><span t-field=\\"key.expiration_date\\"/></td>\\n                                    <td>\\n                                        <i class=\\"fa fa-trash text-danger o_portal_remove_api_key\\" type=\\"button\\" t-att-id=\\"key.id\\"/>\\n                                    </td>\\n                                </tr>\\n                            </t>\\n                        </tbody>\\n                    </table>\\n                </div>\\n                <div>\\n                    <button type=\\"submit\\" class=\\"btn btn-light o_portal_new_api_key\\">New API Key</button>\\n                </div>\\n            </section>\\n            <section name=\\"portal_deactivate_account\\" groups=\\"base.group_portal\\">\\n                <h4>Delete Account</h4>\\n                <t t-set=\\"deactivate_error\\" t-value=\\"get_error(errors, 'deactivate')\\"/>\\n                <button class=\\"btn btn-light\\" data-bs-toggle=\\"modal\\" data-bs-target=\\"#portal_deactivate_account_modal\\">\\n                    Delete Account\\n                </button>\\n                <div t-attf-class=\\"modal #{'show d-block' if open_deactivate_modal else ''}\\" id=\\"portal_deactivate_account_modal\\" tabindex=\\"-1\\" role=\\"dialog\\">\\n                    <div class=\\"modal-dialog\\" role=\\"document\\">\\n                        <div class=\\"modal-content\\">\\n                            <div class=\\"modal-header bg-danger\\">\\n                                <h5 class=\\"modal-title\\">Are you sure you want to do this?</h5>\\n                                <button type=\\"button\\" class=\\"btn-close\\" data-bs-dismiss=\\"modal\\"/>\\n                            </div>\\n                            <form action=\\"/my/deactivate_account\\" method=\\"post\\" class=\\"modal-body\\" id=\\"portal_deactivate_account_form\\">\\n                                <div>\\n                                    <div class=\\"alert alert-danger\\" t-esc=\\"get_error(errors, 'deactivate.other')\\"/>\\n                                    <p class=\\"text-muted\\">\\n                                        Disable your account, preventing any further login.<br/>\\n                                        <b>\\n                                            <i class=\\"fa fa-exclamation-triangle text-danger\\"/>\\n                                            This action cannot be undone.\\n                                        </b>\\n                                    </p>\\n                                    <hr/>\\n                                    <p>1. Enter your password to confirm you own this account</p>\\n                                    <input name=\\"password\\" type=\\"password\\" required=\\"1\\" t-attf-class=\\"form-control #{'is-invalid' if deactivate_error == 'password' else ''}\\" placeholder=\\"Password\\"/>\\n                                    <div t-if=\\"deactivate_error == 'password'\\" class=\\"invalid-feedback\\">\\n                                        Wrong password.\\n                                    </div>\\n                                    <hr/>\\n                                    <p>\\n                                        2. Confirm you want to delete your account by\\n                                        copying down your login (<t t-esc=\\"env.user.login\\"/>).\\n                                    </p>\\n                                    <input name=\\"validation\\" type=\\"text\\" required=\\"1\\" t-attf-class=\\"form-control #{'is-invalid' if deactivate_error == 'validation' else ''}\\"/>\\n                                    <div t-if=\\"deactivate_error == 'validation'\\" class=\\"invalid-feedback\\">\\n                                        You should enter \\"<t t-esc=\\"env.user.login\\"/>\\" to validate your action.\\n                                    </div>\\n                                    <div class=\\"d-flex flex-row align-items-center\\">\\n                                        <input type=\\"checkbox\\" name=\\"request_blacklist\\" id=\\"request_blacklist\\" checked=\\"1\\"/>\\n                                        <label for=\\"request_blacklist\\" class=\\"ms-2 mw-100 fw-normal mt-3\\">\\n                                            Put my email and phone in a block list to make sure I'm never contacted again\\n                                        </label>\\n                                    </div>\\n                                </div>\\n                                <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                            </form>\\n                            <div class=\\"modal-footer justify-content-start\\">\\n                                <input type=\\"submit\\" class=\\"btn btn-danger\\" form=\\"portal_deactivate_account_form\\" value=\\"Delete Account\\"/>\\n                                <button type=\\"button\\" class=\\"btn\\" data-bs-dismiss=\\"modal\\">\\n                                    Cancel\\n                                </button>\\n                            </div>\\n                        </div>\\n                    </div>\\n                </div>\\n            </section>\\n        </div></t>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="portal.portal_my_security">\n        <t t-call="portal.portal_layout"><div class="o_portal_security_body w-md-75 w-lg-50 pb-5">\n            <t t-set="additional_title">Security</t>\n            <t t-set="no_breadcrumbs" t-value="1"/>\n            <div class="alert alert-danger" role="alert" t-if="get_error(errors)">\n                <t t-esc="errors"/>\n            </div>\n            <div class="d-flex gap-2 my-3">\n                <a href="/my/" title="Go Back" class="btn btn-light px-2"><i class="oi oi-chevron-left"/></a>\n                <h3 class="my-0">Connection &amp; Security</h3>\n            </div>\n            <section name="portal_change_password">\n                <h4>Change Password</h4>\n                <t t-set="path">password</t>\n                <div class="alert alert-success" role="alert" t-if="success and success.get('password')">\n                    Password Updated!\n                </div>\n                <div class="alert alert-danger" role="alert" t-if="get_error(errors, 'password')">\n                    <t t-esc="errors['password']"/>\n                </div>\n                <form action="/my/security" method="post" class="oe_reset_password_form">\n                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                    <input type="hidden" name="op" value="password"/>\n                    <div class="mb-4">\n                        <label for="current">Password:</label>\n                        <div class="input-group input-group-sm">\n                            <input type="password" t-attf-class="form-control {{ 'is-invalid' if get_error(errors, 'password.old') else '' }}" id="current" name="old" autocomplete="current-password" required="required"/>\n                            <button class="btn border border-start-0 o_show_password rounded-end" type="button">\n                                <i class="fa fa-eye"/>\n                            </button>\n                            <div class="invalid-feedback">\n                                <t t-out="get_error(errors, 'password.old')"/>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="mb-1 o_caps_lock_warning">\n                        <label for="new">New Password:</label>\n                        <div class="input-group input-group-sm mb-1">\n                            <input type="password" t-attf-class="form-control {{ 'is-invalid' if get_error(errors, 'password.new1') else '' }}" id="new" name="new1" autocomplete="new-password" required="required"/>\n                            <button type="button" class="btn border border-start-0 o_show_password rounded-end">\n                                <i class="fa fa-eye"/>\n                            </button>\n                            <div class="invalid-feedback">\n                                <t t-out="get_error(errors, 'password.new1')"/>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="mb-3">\n                        <label for="new2">Verify New Password:</label>\n                        <div class="input-group input-group-sm">\n                            <input type="password" t-attf-class="form-control {{ 'is-invalid' if get_error(errors, 'password.new2') else '' }}" id="new2" name="new2" autocomplete="new-password" required="required"/>\n                            <button type="button" class="btn border border-start-0 o_show_password rounded-end">\n                                <i class="fa fa-eye"/>\n                            </button>\n                            <div class="invalid-feedback">\n                                <t t-out="get_error(errors, 'password.new2')"/>\n                            </div>\n                        </div>\n                    </div>\n                    <button type="submit" class="btn btn-light">Change Password</button>\n                </form>\n            </section>\n            <section name="portal_revoke_all_devices_popup">\n            <h4>Revoke All Sessions</h4>\n                <t t-set="path"/>\n                    <button type="button" class="btn btn-light" id="portal_revoke_all_sessions_popup">\n                        Log out from all devices\n                    </button>\n            </section>\n            <section t-if="debug and allow_api_keys">\n                <h4>\n                Developer API Keys\n                    <a href="https://www.odoo.com/documentation/latest/developer/reference/external_api.html#api-key" target="_blank">\n                        <i title="Documentation" class="fa fa-fw o_button_icon fa-info-circle"/>\n                    </a>\n                </h4>\n                <div>\n                    <table class="table o_main_table">\n                        <thead>\n                            <tr>\n                                <th>Description</th>\n                                <th>Scope</th>\n                                <th>Added On</th>\n                                <th>Expiration Date</th>\n                                <th/>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <t t-foreach="request.env.user.api_key_ids" t-as="key">\n                                <tr>\n                                    <td><span t-field="key.name"/></td>\n                                    <td><span t-field="key.scope"/></td>\n                                    <td><span t-field="key.create_date"/></td>\n                                    <td><span t-field="key.expiration_date"/></td>\n                                    <td>\n                                        <i class="fa fa-trash text-danger o_portal_remove_api_key" type="button" t-att-id="key.id"/>\n                                    </td>\n                                </tr>\n                            </t>\n                        </tbody>\n                    </table>\n                </div>\n                <div>\n                    <button type="submit" class="btn btn-light o_portal_new_api_key">New API Key</button>\n                </div>\n            </section>\n            <section name="portal_deactivate_account" groups="base.group_portal">\n                <h4>Delete Account</h4>\n                <t t-set="deactivate_error" t-value="get_error(errors, 'deactivate')"/>\n                <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#portal_deactivate_account_modal">\n                    Delete Account\n                </button>\n                <div t-attf-class="modal #{'show d-block' if open_deactivate_modal else ''}" id="portal_deactivate_account_modal" tabindex="-1" role="dialog">\n                    <div class="modal-dialog" role="document">\n                        <div class="modal-content">\n                            <div class="modal-header bg-danger">\n                                <h5 class="modal-title">Are you sure you want to do this?</h5>\n                                <button type="button" class="btn-close" data-bs-dismiss="modal"/>\n                            </div>\n                            <form action="/my/deactivate_account" method="post" class="modal-body" id="portal_deactivate_account_form">\n                                <div>\n                                    <div class="alert alert-danger" t-esc="get_error(errors, 'deactivate.other')"/>\n                                    <p class="text-muted">\n                                        Disable your account, preventing any further login.<br/>\n                                        <b>\n                                            <i class="fa fa-exclamation-triangle text-danger"/>\n                                            This action cannot be undone.\n                                        </b>\n                                    </p>\n                                    <hr/>\n                                    <p>1. Enter your password to confirm you own this account</p>\n                                    <input name="password" type="password" required="1" t-attf-class="form-control #{'is-invalid' if deactivate_error == 'password' else ''}" placeholder="Password"/>\n                                    <div t-if="deactivate_error == 'password'" class="invalid-feedback">\n                                        Wrong password.\n                                    </div>\n                                    <hr/>\n                                    <p>\n                                        2. Confirm you want to delete your account by\n                                        copying down your login (<t t-esc="env.user.login"/>).\n                                    </p>\n                                    <input name="validation" type="text" required="1" t-attf-class="form-control #{'is-invalid' if deactivate_error == 'validation' else ''}"/>\n                                    <div t-if="deactivate_error == 'validation'" class="invalid-feedback">\n                                        You should enter "<t t-esc="env.user.login"/>" to validate your action.\n                                    </div>\n                                    <div class="d-flex flex-row align-items-center">\n                                        <input type="checkbox" name="request_blacklist" id="request_blacklist" checked="1"/>\n                                        <label for="request_blacklist" class="ms-2 mw-100 fw-normal mt-3">\n                                            Put my email and phone in a block list to make sure I'm never contacted again\n                                        </label>\n                                    </div>\n                                </div>\n                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                            </form>\n                            <div class="modal-footer justify-content-start">\n                                <input type="submit" class="btn btn-danger" form="portal_deactivate_account_form" value="Delete Account"/>\n                                <button type="button" class="btn" data-bs-dismiss="modal">\n                                    Cancel\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div></t>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
