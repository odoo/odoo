CREATE TABLE public.hr_attendance_overtime_rule (
    id integer NOT NULL,
    resource_calendar_id integer,
    sequence integer,
    ruleset_id integer NOT NULL,
    create_uid integer,
    write_uid integer,
    name character varying NOT NULL,
    base_off character varying NOT NULL,
    timing_type character varying,
    quantity_period character varying,
    description text,
    expected_hours_from_contract boolean,
    paid boolean,
    create_date timestamp without time zone,
    write_date timestamp without time zone,
    timing_start double precision,
    timing_stop double precision,
    expected_hours double precision,
    amount_rate double precision,
    employee_tolerance double precision,
    employer_tolerance double precision,
    compensable_as_leave boolean,
    CONSTRAINT hr_attendance_overtime_rule_timing_start_is_hour CHECK ((((0)::double precision <= timing_start) AND (timing_start < (24)::double precision))),
    CONSTRAINT hr_attendance_overtime_rule_timing_stop_is_hour CHECK ((((0)::double precision <= timing_stop) AND (timing_stop <= (24)::double precision)))
);


