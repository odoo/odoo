ly_approval_engine\\" invisible=\\"1\\"/>\\n                <field name=\\"presenly_approval_request_id\\" invisible=\\"1\\"/>\\n                <div class=\\"d-flex flex-wrap gap-2 mb-3 o_presenly_leave_actions\\">\\n                    <button name=\\"action_presenly_submit\\" type=\\"object\\" string=\\"Submit for Approval\\" class=\\"oe_highlight\\" invisible=\\"not presenly_can_submit\\"/>\\n                    <button name=\\"action_presenly_approve\\" type=\\"object\\" string=\\"Approve Current Level\\" class=\\"oe_highlight\\" invisible=\\"not presenly_can_approve\\"/>\\n                    <button name=\\"action_presenly_open_reject_wizard\\" type=\\"object\\" string=\\"Reject\\" class=\\"btn-secondary\\" invisible=\\"not presenly_can_reject\\"/>\\n                    <button name=\\"action_presenly_cancel\\" type=\\"object\\" string=\\"Cancel Request\\" invisible=\\"not presenly_can_cancel\\" confirm=\\"Cancel this request and its pending approval journey?\\"/>\\n                </div>\\n                <div class=\\"alert alert-info d-flex align-items-center my-2\\" role=\\"alert\\" invisible=\\"presenly_approval_state != 'not_started'\\">\\n                    <i class=\\"fa fa-route me-2\\" title=\\"Approval Journey\\"/>\\n                    Submission starts the Presenly Approval Journey. Native Time Off approval cannot bypass these levels.\\n                </div>\\n                <div class=\\"alert alert-warning d-flex align-items-center my-2\\" role=\\"alert\\" invisible=\\"presenly_approval_state != 'pending'\\">\\n                    <i class=\\"fa fa-hourglass-half me-2\\" title=\\"Pending Approval\\"/>\\n                    <div>\\n                        <strong><field name=\\"presenly_approval_progress\\" class=\\"oe_inline\\"/></strong>\\n                        <span class=\\"ms-2\\">Waiting for</span>\\n                        <field name=\\"presenly_current_approver_ids\\" widget=\\"many2many_tags\\" class=\\"oe_inline ms-1\\" options=\