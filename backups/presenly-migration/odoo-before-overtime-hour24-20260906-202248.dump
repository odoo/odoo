1020	16	\N	1	1	mailing.mailing.form	mailing.mailing	\N	form	mass_mailing/views/mailing_mailing_views.xml	primary	{"en_US": "<form string=\\"Mailing\\" class=\\"o_mass_mailing_mailing_form\\">\\n                    <header>\\n                        <button name=\\"action_launch\\" type=\\"object\\" class=\\"oe_highlight\\" string=\\"Send\\" invisible=\\"state in ('in_queue', 'sending', 'done')\\" data-hotkey=\\"q\\" confirm=\\"Once you send these emails, they'll be making a grand entrance in all the inboxes, creating quite the buzz!\\" confirm-title=\\"Ready to unleash emails?\\" confirm-label=\\"Send to all\\"/>\\n                        <button name=\\"action_schedule\\" type=\\"object\\" class=\\"btn-secondary\\" string=\\"Schedule\\" invisible=\\"state in ('in_queue', 'sending', 'done')\\" data-hotkey=\\"v\\"/>\\n                        <button name=\\"action_duplicate\\" type=\\"object\\" class=\\"btn-secondary\\" string=\\"Duplicate\\" data-hotkey=\\"d\\" invisible=\\"state != 'done'\\"/>\\n                        <button name=\\"action_test\\" type=\\"object\\" class=\\"btn-secondary\\" string=\\"Test\\" data-hotkey=\\"k\\"/>\\n                        <button name=\\"action_cancel\\" type=\\"object\\" invisible=\\"state != 'in_queue'\\" class=\\"btn-secondary\\" string=\\"Cancel\\" data-hotkey=\\"x\\"/>\\n                        <button name=\\"action_retry_failed\\" type=\\"object\\" invisible=\\"state != 'done' or failed == 0\\" class=\\"oe_highlight\\" string=\\"Retry\\" data-hotkey=\\"y\\"/>\\n                        <button type=\\"object\\" name=\\"action_set_favorite\\" class=\\"btn-secondary\\" invisible=\\"favorite\\" string=\\"Add to Templates\\"/>\\n                        <button type=\\"object\\" name=\\"action_remove_favorite\\" class=\\"btn-secondary\\" invisible=\\"not favorite\\" string=\\"Remove from Templates\\"/>\\n                        <field name=\\"state\\" readonly=\\"1\\" widget=\\"statusbar\\" statusbar_visible=\\"draft,in_queue,sending,done\\"/>\\n                    </header>\\n                    <div class=\\"alert alert-info o_mass_mailing_alert_message\\" role=\\"alert\\" invisible=\\"state not in ['in_queue', 'done'] and sent == 0 and canceled == 0 and scheduled == 0 and failed == 0 and not warning_message\\">\\n                        <div class=\\"o_mails_canceled\\" invisible=\\"canceled == 0\\">\\n                            <button class=\\"btn btn-link py-0\\" name=\\"action_view_traces_canceled\\" type=\\"object\\">\\n                                <strong>\\n                                    <field name=\\"canceled\\" class=\\"oe_inline me-2\\"/>\\n                                    <span name=\\"canceled_text\\">emails have been cancelled and will not be sent.</span>\\n                                </strong>\\n                            </button>\\n                        </div>\\n                        <div class=\\"o_mails_scheduled\\" invisible=\\"scheduled == 0\\">\\n                            <button class=\\"btn btn-link py-0\\" name=\\"action_view_traces_scheduled\\" type=\\"object\\">\\n                                <strong>\\n                                    <field name=\\"scheduled\\" class=\\"oe_inline me-2\\"/>\\n                                    <span name=\\"scheduled_text\\">emails are in queue and will be sent soon.</span>\\n                                </strong>\\n                            </button>\\n                        </div>\\n                        <div class=\\"o_mails_process\\" invisible=\\"process == 0\\">\\n                            <button class=\\"btn btn-link py-0\\" name=\\"action_view_traces_process\\" type=\\"object\\">\\n                                <strong>\\n                                    <field name=\\"process\\" class=\\"oe_inline me-2\\"/>\\n                                    <span name=\\"process_text\\">emails are being processed.</span>\\n                                </strong>\\n                            </button>\\n                        </div>\\n                        <div class=\\"o_mails_sent\\" invisible=\\"sent == 0 and state in ('draft', 'test', 'in_queue')\\">\\n                            <button class=\\"btn btn-link py-0\\" name=\\"action_view_traces_sent\\" type=\\"object\\">\\n                                <strong>\\n                                    <field name=\\"sent\\" class=\\"oe_inline me-2\\"/>\\n                                    <span name=\\"sent\\">emails have been sent.</span>\\n                                </strong>\\n                            </button>\\n                            <strong class=\\"d-block\\" invisible=\\"mailing_type == 'mail' or not ab_testing_enabled or state != 'done' or sent != 0 or failed != 0 or canceled != 0\\">\\n                                <span name=\\"ab_test_text\\">There wasn't enough recipients given to this mailing. </span>\\n                            </strong>\\n                        </div>\\n                        <div class=\\"o_mails_failed\\" invisible=\\"state != 'done' or failed == 0\\">\\n                            <button class=\\"btn btn-link py-0\\" name=\\"action_view_traces_failed\\" type=\\"object\\">\\n                                <strong>\\n                                    <field name=\\"failed\\" class=\\"oe_inline me-2\\"/>\\n                                    <span name=\\"failed_text\\">emails could not be sent.</span>\\n                            </strong>\\n                            </button>\\n                        </div>\\n\\n                        <div class=\\"o_mails_in_queue\\" invisible=\\"state != 'in_queue'\\">\\n                            <strong invisible=\\"next_departure_is_past or schedule_type == 'now'\\">\\n                                <span name=\\"next_departure_text\\">This mailing is scheduled for </span>\\n                                <field name=\\"next_departure\\" class=\\"oe_inline\\"/>.\\n                            </strong>\\n                            <strong invisible=\\"not next_departure_is_past or schedule_type == 'now'\\" class=\\"d-flex align-items-center\\">\\n                                <field name=\\"next_departure_is_past\\" invisible=\\"1\\"/>\\n                                <span name=\\"refresh_text\\">This mailing will be sent as soon as possible.</span>\\n                                <button name=\\"action_reload\\" type=\\"object\\" class=\\"btn btn-link pe-0\\">\\n                                    <u>Refresh <i class=\\"fa fa-refresh ms-1\\"/></u>\\n                                </button>\\n                            </strong>\\n                            <strong invisible=\\"schedule_type != 'now'\\" class=\\"d-flex align-items-center\\">\\n                                <field name=\\"next_departure_is_past\\" invisible=\\"1\\"/>\\n                                <field name=\\"schedule_type\\" invisible=\\"1\\"/>\\n                                <span name=\\"mailing_schedule_type_now_text\\">This mailing will be sent as soon as possible.</span>\\n                                <button name=\\"action_reload\\" type=\\"object\\" class=\\"btn btn-link pe-0\\">\\n                                    <u>Refresh <i class=\\"fa fa-refresh ms-1\\"/></u>\\n                                </button>\\n                            </strong>\\n                        </div>\\n                        <div invisible=\\"not warning_message\\">\\n                            <strong><field name=\\"warning_message\\"/></strong>\\n                        </div>\\n                    </div>\\n                    <sheet>\\n                        <div class=\\"oe_button_box\\" name=\\"button_box\\">\\n                            <button name=\\"action_view_opened\\" type=\\"object\\" context=\\"{'search_default_filter_opened': True}\\" invisible=\\"state in ('draft', 'test')\\" class=\\"oe_stat_button\\">\\n                                <field name=\\"opened_ratio\\" string=\\"Opened\\" widget=\\"percentpie\\"/>\\n                            </button>\\n                            <button name=\\"action_view_replied\\" type=\\"object\\" context=\\"{'search_default_filter_replied': True}\\" invisible=\\"state in ('draft', 'test')\\" class=\\"oe_stat_button\\">\\n                                <field name=\\"replied_ratio\\" string=\\"Replied\\" widget=\\"percentpie\\"/>\\n                            </button>\\n                            <button name=\\"action_view_clicked\\" type=\\"object\\" context=\\"{'search_default_filter_clicked': True}\\" invisible=\\"state in ('draft', 'test')\\" class=\\"oe_stat_button\\">\\n                                <field name=\\"clicks_ratio\\" string=\\"Clicked\\" widget=\\"percentpie\\"/>\\n                            </button>\\n                            <button name=\\"action_view_delivered\\" id=\\"button_view_delivered\\" type=\\"object\\" context=\\"{'search_default_filter_delivered': True}\\" invisible=\\"state in ('draft', 'test')\\" class=\\"oe_stat_button\\">\\n                                <field name=\\"received_ratio\\" string=\\"Received\\" widget=\\"percentpie\\"/>\\n                            </button>\\n                            <button name=\\"action_view_bounced\\" type=\\"object\\" context=\\"{'search_default_filter_bounced': True}\\" invisible=\\"state in ('draft', 'test')\\" class=\\"oe_stat_button\\">\\n                                <field name=\\"bounced_ratio\\" string=\\"Bounced\\" widget=\\"percentpie\\"/>\\n                            </button>\\n                            <button name=\\"action_view_link_trackers\\" invisible=\\"state != 'done'\\" type=\\"object\\" class=\\"oe_stat_button\\" icon=\\"fa-link\\">\\n                                <field name=\\"link_trackers_count\\" widget=\\"statinfo\\" string=\\"Link Trackers\\"/>\\n                            </button>\\n                        </div>\\n                        <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                        <group class=\\"o_mass_mailing_mailing_group\\">\\n                            <field name=\\"active\\" invisible=\\"1\\"/>\\n                            <field name=\\"create_uid\\" invisible=\\"1\\"/>\\n                            <field name=\\"mailing_type\\" widget=\\"radio\\" options=\\"{'horizontal': true}\\" invisible=\\"1\\" readonly=\\"state != 'draft'\\" force_save=\\"1\\"/>\\n                            <field class=\\"text-break\\" name=\\"subject\\" options=\\"{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'mailing_model_real'}\\" readonly=\\"state in ('sending', 'done')\\" widget=\\"char_emojis\\" placeholder=\\"e.g. New Sale on all T-shirts\\"/>\\n                            <label for=\\"mailing_model_id\\" string=\\"Recipients\\"/>\\n                            <div name=\\"mailing_model_id_container\\">\\n                                <div class=\\"row\\">\\n                                    <div class=\\"col-md-auto\\">\\n                                        <field name=\\"mailing_model_id\\" options=\\"{'no_open': True, 'no_create': True}\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                    </div>\\n                                    <div invisible=\\"not mailing_on_mailing_list\\" class=\\"o_mass_mailing_contact_list_ids col-md-auto pt-1\\">\\n                                        <label for=\\"contact_list_ids\\" string=\\"Mailing Lists:\\" class=\\"oe_edit_only pe-3\\"/>\\n                                        <div class=\\"d-inline-flex flex-row align-items-center\\">\\n                                            <field name=\\"contact_list_ids\\" widget=\\"many2many_tags\\" placeholder=\\"Select recipients...\\" class=\\"oe_inline mb-0\\" context=\\"{'form_view_ref': 'mass_mailing.mailing_list_view_form_simplified'}\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                            <button icon=\\"fa-user-plus\\" type=\\"object\\" class=\\"btn btn-secondary py-0 px-1 ms-1\\" invisible=\\"not contact_list_ids or not contact_list_ids or state in ('sending', 'done')\\" name=\\"action_view_mailing_contacts\\" title=\\"Add Mailing Contacts\\"/>\\n                                        </div>\\n                                    </div>\\n                                    <div invisible=\\"mailing_on_mailing_list\\" class=\\"col-md-auto o_mailing_filter_width\\">\\n                                        <field name=\\"mailing_filter_id\\" placeholder=\\"Reload a favorite filter\\" class=\\"o_mailing_filter_readonly_width\\" widget=\\"mailing_filter\\" options=\\"{'no_create': 1, 'no_open': 1, 'domain_field': 'mailing_domain', 'model_field': 'mailing_model_id'}\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                    </div>\\n                                    <field name=\\"mailing_filter_count\\" invisible=\\"1\\"/>\\n                                </div>\\n\\n                                <field name=\\"mailing_model_name\\" invisible=\\"1\\"/>\\n                                <field name=\\"mailing_on_mailing_list\\" invisible=\\"1\\"/>\\n                                <field name=\\"mailing_model_real\\" invisible=\\"1\\"/>\\n                                <field name=\\"mailing_domain\\" widget=\\"domain\\" options=\\"{'model': 'mailing_model_real', 'foldable': true}\\" invisible=\\"mailing_on_mailing_list\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                            </div>\\n                        </group>\\n                        <notebook>\\n                            <page string=\\"Mail Body\\" name=\\"mail_body\\">\\n                                <div class=\\"position-relative\\">\\n                                    <field name=\\"body_arch\\" class=\\"o_mail_body_mailing\\" widget=\\"mass_mailing_html\\" options=\\"{                                             'inline_field': 'body_html',                                             'dynamic_placeholder': true,                                             'dynamic_placeholder_model_reference_field': 'mailing_model_real',                                         }\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                    <field name=\\"body_html\\" invisible=\\"1\\" required=\\"body_arch\\"/>\\n                                    <field name=\\"is_body_empty\\" invisible=\\"1\\"/>\\n                                </div>\\n                            </page>\\n                            <page string=\\"A/B Tests\\" name=\\"ab_testing\\">\\n                                <group>\\n                                    <group>\\n                                        <label for=\\"ab_testing_enabled\\"/>\\n                                        <span class=\\"d-flex\\">\\n                                            <field name=\\"ab_testing_enabled\\" readonly=\\"state != 'draft'\\" force_save=\\"1\\"/>\\n                                            <span class=\\"d-flex\\" invisible=\\"not ab_testing_enabled\\">\\n                                                on <field name=\\"ab_testing_pc\\" class=\\"mx-1 text-center\\" readonly=\\"state != 'draft'\\"/> %\\n                                            </span>\\n                                        </span>\\n                                        <field name=\\"ab_testing_winner_selection\\" invisible=\\"not ab_testing_enabled or mailing_type != 'mail'\\" readonly=\\"state != 'draft'\\" required=\\"ab_testing_enabled and mailing_type == 'mail'\\"/>\\n                                        <field name=\\"ab_testing_schedule_datetime\\" invisible=\\"not ab_testing_enabled or ab_testing_winner_selection == 'manual'\\" readonly=\\"not ab_testing_enabled or state != 'draft'\\" required=\\"ab_testing_enabled and ab_testing_winner_selection != 'manual'\\"/>\\n                                        <field name=\\"is_ab_test_sent\\" invisible=\\"1\\"/>\\n                                    </group>\\n                                    <div>\\n                                        <field name=\\"ab_testing_mailings_count\\" invisible=\\"1\\"/>\\n                                        <field name=\\"ab_testing_completed\\" invisible=\\"1\\"/>\\n                                        <field name=\\"ab_testing_description\\" nolabel=\\"1\\"/>\\n                                        <div id=\\"mailing_form_ab_buttons\\" invisible=\\"ab_testing_mailings_count &lt; 2 or not ab_testing_enabled\\">\\n                                            <button name=\\"action_compare_versions\\" type=\\"object\\" class=\\"btn btn-link d-block\\">\\n                                                <i class=\\"fa fa-bar-chart\\"/> Compare Version\\n                                            </button>\\n                                            <button name=\\"action_duplicate\\" type=\\"object\\" class=\\"btn btn-link d-block\\" invisible=\\"ab_testing_completed\\">\\n                                                <i class=\\"fa fa-copy\\"/> Create an Alternative\\n                                            </button>\\n                                            <button name=\\"action_send_winner_mailing\\" type=\\"object\\" class=\\"btn btn-link d-block\\" invisible=\\"not is_ab_test_sent or ab_testing_completed or ab_testing_winner_selection == 'manual'\\">\\n                                                <i class=\\"fa fa-envelope\\"/><span name=\\"ab_test_auto\\">\\n                                                    Send Winner Now\\n                                                </span>\\n                                            </button>\\n                                            <button name=\\"action_select_as_winner\\" type=\\"object\\" class=\\"btn btn-link d-block\\" invisible=\\"ab_testing_completed or ab_testing_winner_selection != 'manual'\\">\\n                                                <i class=\\"fa fa-envelope\\"/> Send this as winner\\n                                            </button>\\n                                        </div>\\n                                        <button name=\\"action_duplicate\\" type=\\"object\\" class=\\"btn btn-primary\\" invisible=\\"ab_testing_mailings_count &gt;= 2 or not ab_testing_enabled\\">\\n                                            Create an Alternative Version\\n                                        </button>\\n                                    </div>\\n                                </group>\\n                            </page>\\n                            <page string=\\"Settings\\" name=\\"settings\\">\\n                                <group>\\n                                    <group string=\\"Email Content\\" name=\\"email_content\\" invisible=\\"mailing_type != 'mail'\\">\\n                                        <field class=\\"o_text_overflow\\" name=\\"preview\\" string=\\"Preview Text\\" options=\\"{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'mailing_model_real'}\\" readonly=\\"state in ('sending', 'done')\\" widget=\\"char_emojis\\" placeholder=\\"e.g. Check it out before it's too late!\\"/>\\n                                        <field name=\\"email_from\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                        <label for=\\"reply_to\\"/>\\n                                        <div name=\\"reply_to_details\\">\\n                                            <field name=\\"reply_to_mode\\" widget=\\"radio\\" invisible=\\"mailing_model_name in ['mailing.contact', 'res.partner', 'mailing.list']\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                            <field name=\\"reply_to\\" invisible=\\"reply_to_mode == 'update'\\" readonly=\\"state in ('sending', 'done')\\" required=\\"reply_to_mode == 'new'\\"/>\\n                                            <div style=\\"margin-top:-5px\\">\\n                                                <small class=\\"oe_edit_only text-muted mb-2\\" style=\\"font-size:74%\\" invisible=\\"reply_to_mode == 'update' or mailing_model_name in ['mailing.contact', 'res.partner', 'mailing.list']\\">\\n                                                    To track replies, this address must belong to this database.\\n                                                </small>\\n                                            </div>\\n                                        </div>\\n                                        <label for=\\"attachment_ids\\"/>\\n                                        <div name=\\"attachment_ids_details\\">\\n                                            <field name=\\"attachment_ids\\" widget=\\"many2many_binary\\" string=\\"Attach a file\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                        </div>\\n                                    </group>\\n                                    <group string=\\"Tracking\\">\\n                                        <field name=\\"campaign_id\\" string=\\"Campaign\\" groups=\\"mass_mailing.group_mass_mailing_campaign\\" options=\\"{'create_name_field': 'title'}\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                        <field name=\\"medium_id\\" string=\\"Medium\\" groups=\\"base.group_no_one\\" required=\\"True\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                        <field name=\\"source_id\\" string=\\"Source\\" class=\\"o_text_overflow\\" groups=\\"base.group_no_one\\" readonly=\\"1\\" required=\\"False\\"/>\\n                                        <field name=\\"user_id\\" widget=\\"many2one_avatar_user\\" domain=\\"[('share', '=', False)]\\"/>\\n                                    </group>\\n                                    <group string=\\"Advanced\\" groups=\\"base.group_no_one\\">\\n                                        <field name=\\"mail_server_available\\" invisible=\\"1\\"/>\\n                                        <field name=\\"name\\" string=\\"Name\\" required=\\"False\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                        <field name=\\"mail_server_id\\" invisible=\\"not mail_server_available\\" readonly=\\"state in ('sending', 'done')\\" domain=\\"[('owner_user_id', '=', False)]\\"/>\\n                                        <field name=\\"keep_archives\\" readonly=\\"state in ('sending', 'done')\\"/>\\n                                        <!-- Not using a dedicated server and being set means generic sending, won't allow disabling it. -->\\n                                        <field name=\\"use_exclusion_list\\" invisible=\\"not mail_server_id and use_exclusion_list\\" readonly=\\"state != 'draft'\\"/>\\n                                    </group>\\n                                </group>\\n                            </page>\\n                        </notebook>\\n                    </sheet>\\n                    <chatter/>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Mailing" class="o_mass_mailing_mailing_form">\n                    <header>\n                        <button name="action_launch" type="object" class="oe_highlight" string="Send" invisible="state in ('in_queue', 'sending', 'done')" data-hotkey="q" confirm="Once you send these emails, they'll be making a grand entrance in all the inboxes, creating quite the buzz!" confirm-title="Ready to unleash emails?" confirm-label="Send to all"/>\n                        <button name="action_schedule" type="object" class="btn-secondary" string="Schedule" invisible="state in ('in_queue', 'sending', 'done')" data-hotkey="v"/>\n                        <button name="action_duplicate" type="object" class="btn-secondary" string="Duplicate" data-hotkey="d" invisible="state != 'done'"/>\n                        <button name="action_test" type="object" class="btn-secondary" string="Test" data-hotkey="k"/>\n                        <button name="action_cancel" type="object" invisible="state != 'in_queue'" class="btn-secondary" string="Cancel" data-hotkey="x"/>\n                        <button name="action_retry_failed" type="object" invisible="state != 'done' or failed == 0" class="oe_highlight" string="Retry" data-hotkey="y"/>\n                        <button type="object" name="action_set_favorite" class="btn-secondary" invisible="favorite" string="Add to Templates"/>\n                        <button type="object" name="action_remove_favorite" class="btn-secondary" invisible="not favorite" string="Remove from Templates"/>\n                        <field name="state" readonly="1" widget="statusbar" statusbar_visible="draft,in_queue,sending,done"/>\n                    </header>\n                    <div class="alert alert-info o_mass_mailing_alert_message" role="alert" invisible="state not in ['in_queue', 'done'] and sent == 0 and canceled == 0 and scheduled == 0 and failed == 0 and not warning_message">\n                        <div class="o_mails_canceled" invisible="canceled == 0">\n                            <button class="btn btn-link py-0" name="action_view_traces_canceled" type="object">\n                                <strong>\n                                    <field name="canceled" class="oe_inline me-2"/>\n                                    <span name="canceled_text">emails have been cancelled and will not be sent.</span>\n                                </strong>\n                            </button>\n                        </div>\n                        <div class="o_mails_scheduled" invisible="scheduled == 0">\n                            <button class="btn btn-link py-0" name="action_view_traces_scheduled" type="object">\n                                <strong>\n                                    <field name="scheduled" class="oe_inline me-2"/>\n                                    <span name="scheduled_text">emails are in queue and will be sent soon.</span>\n                                </strong>\n                            </button>\n                        </div>\n                        <div class="o_mails_process" invisible="process == 0">\n                            <button class="btn btn-link py-0" name="action_view_traces_process" type="object">\n                                <strong>\n                                    <field name="process" class="oe_inline me-2"/>\n                                    <span name="process_text">emails are being processed.</span>\n                                </strong>\n                            </button>\n                        </div>\n                        <div class="o_mails_sent" invisible="sent == 0 and state in ('draft', 'test', 'in_queue')">\n                            <button class="btn btn-link py-0" name="action_view_traces_sent" type="object">\n                                <strong>\n                                    <field name="sent" class="oe_inline me-2"/>\n                                    <span name="sent">emails have been sent.</span>\n                                </strong>\n                            </button>\n                            <strong class="d-block" invisible="mailing_type == 'mail' or not ab_testing_enabled or state != 'done' or sent != 0 or failed != 0 or canceled != 0">\n                                <span name="ab_test_text">There wasn't enough recipients given to this mailing. </span>\n                            </strong>\n                        </div>\n                        <div class="o_mails_failed" invisible="state != 'done' or failed == 0">\n                            <button class="btn btn-link py-0" name="action_view_traces_failed" type="object">\n                                <strong>\n                                    <field name="failed" class="oe_inline me-2"/>\n                                    <span name="failed_text">emails could not be sent.</span>\n                            </strong>\n                            </button>\n                        </div>\n\n                        <div class="o_mails_in_queue" invisible="state != 'in_queue'">\n                            <strong invisible="next_departure_is_past or schedule_type == 'now'">\n                                <span name="next_departure_text">This mailing is scheduled for </span>\n                                <field name="next_departure" class="oe_inline"/>.\n                            </strong>\n                            <strong invisible="not next_departure_is_past or schedule_type == 'now'" class="d-flex align-items-center">\n                                <field name="next_departure_is_past" invisible="1"/>\n                                <span name="refresh_text">This mailing will be sent as soon as possible.</span>\n                                <button name="action_reload" type="object" class="btn btn-link pe-0">\n                                    <u>Refresh <i class="fa fa-refresh ms-1"/></u>\n                                </button>\n                            </strong>\n                            <strong invisible="schedule_type != 'now'" class="d-flex align-items-center">\n                                <field name="next_departure_is_past" invisible="1"/>\n                                <field name="schedule_type" invisible="1"/>\n                                <span name="mailing_schedule_type_now_text">This mailing will be sent as soon as possible.</span>\n                                <button name="action_reload" type="object" class="btn btn-link pe-0">\n                                    <u>Refresh <i class="fa fa-refresh ms-1"/></u>\n                                </button>\n                            </strong>\n                        </div>\n                        <div invisible="not warning_message">\n                            <strong><field name="warning_message"/></strong>\n                        </div>\n                    </div>\n                    <sheet>\n                        <div class="oe_button_box" name="button_box">\n                            <button name="action_view_opened" type="object" context="{'search_default_filter_opened': True}" invisible="state in ('draft', 'test')" class="oe_stat_button">\n                                <field name="opened_ratio" string="Opened" widget="percentpie"/>\n                            </button>\n                            <button name="action_view_replied" type="object" context="{'search_default_filter_replied': True}" invisible="state in ('draft', 'test')" class="oe_stat_button">\n                                <field name="replied_ratio" string="Replied" widget="percentpie"/>\n                            </button>\n                            <button name="action_view_clicked" type="object" context="{'search_default_filter_clicked': True}" invisible="state in ('draft', 'test')" class="oe_stat_button">\n                                <field name="clicks_ratio" string="Clicked" widget="percentpie"/>\n                            </button>\n                            <button name="action_view_delivered" id="button_view_delivered" type="object" context="{'search_default_filter_delivered': True}" invisible="state in ('draft', 'test')" class="oe_stat_button">\n                                <field name="received_ratio" string="Received" widget="percentpie"/>\n                            </button>\n                            <button name="action_view_bounced" type="object" context="{'search_default_filter_bounced': True}" invisible="state in ('draft', 'test')" class="oe_stat_button">\n                                <field name="bounced_ratio" string="Bounced" widget="percentpie"/>\n                            </button>\n                            <button name="action_view_link_trackers" invisible="state != 'done'" type="object" class="oe_stat_button" icon="fa-link">\n                                <field name="link_trackers_count" widget="statinfo" string="Link Trackers"/>\n                            </button>\n                        </div>\n                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                        <group class="o_mass_mailing_mailing_group">\n                            <field name="active" invisible="1"/>\n                            <field name="create_uid" invisible="1"/>\n                            <field name="mailing_type" widget="radio" options="{'horizontal': true}" invisible="1" readonly="state != 'draft'" force_save="1"/>\n                            <field class="text-break" name="subject" options="{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'mailing_model_real'}" readonly="state in ('sending', 'done')" widget="char_emojis" placeholder="e.g. New Sale on all T-shirts"/>\n                            <label for="mailing_model_id" string="Recipients"/>\n                            <div name="mailing_model_id_container">\n                                <div class="row">\n                                    <div class="col-md-auto">\n                                        <field name="mailing_model_id" options="{'no_open': True, 'no_create': True}" readonly="state in ('sending', 'done')"/>\n                                    </div>\n                                    <div invisible="not mailing_on_mailing_list" class="o_mass_mailing_contact_list_ids col-md-auto pt-1">\n                                        <label for="contact_list_ids" string="Mailing Lists:" class="oe_edit_only pe-3"/>\n                                        <div class="d-inline-flex flex-row align-items-center">\n                                            <field name="contact_list_ids" widget="many2many_tags" placeholder="Select recipients..." class="oe_inline mb-0" context="{'form_view_ref': 'mass_mailing.mailing_list_view_form_simplified'}" readonly="state in ('sending', 'done')"/>\n                                            <button icon="fa-user-plus" type="object" class="btn btn-secondary py-0 px-1 ms-1" invisible="not contact_list_ids or not contact_list_ids or state in ('sending', 'done')" name="action_view_mailing_contacts" title="Add Mailing Contacts"/>\n                                        </div>\n                                    </div>\n                                    <div invisible="mailing_on_mailing_list" class="col-md-auto o_mailing_filter_width">\n                                        <field name="mailing_filter_id" placeholder="Reload a favorite filter" class="o_mailing_filter_readonly_width" widget="mailing_filter" options="{'no_create': 1, 'no_open': 1, 'domain_field': 'mailing_domain', 'model_field': 'mailing_model_id'}" readonly="state in ('sending', 'done')"/>\n                                    </div>\n                                    <field name="mailing_filter_count" invisible="1"/>\n                                </div>\n\n                                <field name="mailing_model_name" invisible="1"/>\n                                <field name="mailing_on_mailing_list" invisible="1"/>\n                                <field name="mailing_model_real" invisible="1"/>\n                                <field name="mailing_domain" widget="domain" options="{'model': 'mailing_model_real', 'foldable': true}" invisible="mailing_on_mailing_list" readonly="state in ('sending', 'done')"/>\n                            </div>\n                        </group>\n                        <notebook>\n                            <page string="Mail Body" name="mail_body">\n                                <div class="position-relative">\n                                    <field name="body_arch" class="o_mail_body_mailing" widget="mass_mailing_html" options="{                                             'inline_field': 'body_html',                                             'dynamic_placeholder': true,                                             'dynamic_placeholder_model_reference_field': 'mailing_model_real',                                         }" readonly="state in ('sending', 'done')"/>\n                                    <field name="body_html" invisible="1" required="body_arch"/>\n                                    <field name="is_body_empty" invisible="1"/>\n                                </div>\n                            </page>\n                            <page string="A/B Tests" name="ab_testing">\n                                <group>\n                                    <group>\n                                        <label for="ab_testing_enabled"/>\n                                        <span class="d-flex">\n                                            <field name="ab_testing_enabled" readonly="state != 'draft'" force_save="1"/>\n                                            <span class="d-flex" invisible="not ab_testing_enabled">\n                                                on <field name="ab_testing_pc" class="mx-1 text-center" readonly="state != 'draft'"/> %\n                                            </span>\n                                        </span>\n                                        <field name="ab_testing_winner_selection" invisible="not ab_testing_enabled or mailing_type != 'mail'" readonly="state != 'draft'" required="ab_testing_enabled and mailing_type == 'mail'"/>\n                                        <field name="ab_testing_schedule_datetime" invisible="not ab_testing_enabled or ab_testing_winner_selection == 'manual'" readonly="not ab_testing_enabled or state != 'draft'" required="ab_testing_enabled and ab_testing_winner_selection != 'manual'"/>\n                                        <field name="is_ab_test_sent" invisible="1"/>\n                                    </group>\n                                    <div>\n                                        <field name="ab_testing_mailings_count" invisible="1"/>\n                                        <field name="ab_testing_completed" invisible="1"/>\n                                        <field name="ab_testing_description" nolabel="1"/>\n                                        <div id="mailing_form_ab_buttons" invisible="ab_testing_mailings_count &lt; 2 or not ab_testing_enabled">\n                                            <button name="action_compare_versions" type="object" class="btn btn-link d-block">\n                                                <i class="fa fa-bar-chart"/> Compare Version\n                                            </button>\n                                            <button name="action_duplicate" type="object" class="btn btn-link d-block" invisible="ab_testing_completed">\n                                                <i class="fa fa-copy"/> Create an Alternative\n                                            </button>\n                                            <button name="action_send_winner_mailing" type="object" class="btn btn-link d-block" invisible="not is_ab_test_sent or ab_testing_completed or ab_testing_winner_selection == 'manual'">\n                                                <i class="fa fa-envelope"/><span name="ab_test_auto">\n                                                    Send Winner Now\n                                                </span>\n                                            </button>\n                                            <button name="action_select_as_winner" type="object" class="btn btn-link d-block" invisible="ab_testing_completed or ab_testing_winner_selection != 'manual'">\n                                                <i class="fa fa-envelope"/> Send this as winner\n                                            </button>\n                                        </div>\n                                        <button name="action_duplicate" type="object" class="btn btn-primary" invisible="ab_testing_mailings_count &gt;= 2 or not ab_testing_enabled">\n                                            Create an Alternative Version\n                                        </button>\n                                    </div>\n                                </group>\n                            </page>\n                            <page string="Settings" name="settings">\n                                <group>\n                                    <group string="Email Content" name="email_content" invisible="mailing_type != 'mail'">\n                                        <field class="o_text_overflow" name="preview" string="Preview Text" options="{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'mailing_model_real'}" readonly="state in ('sending', 'done')" widget="char_emojis" placeholder="e.g. Check it out before it's too late!"/>\n                                        <field name="email_from" readonly="state in ('sending', 'done')"/>\n                                        <label for="reply_to"/>\n                                        <div name="reply_to_details">\n                                            <field name="reply_to_mode" widget="radio" invisible="mailing_model_name in ['mailing.contact', 'res.partner', 'mailing.list']" readonly="state in ('sending', 'done')"/>\n                                            <field name="reply_to" invisible="reply_to_mode == 'update'" readonly="state in ('sending', 'done')" required="reply_to_mode == 'new'"/>\n                                            <div style="margin-top:-5px">\n                                                <small class="oe_edit_only text-muted mb-2" style="font-size:74%" invisible="reply_to_mode == 'update' or mailing_model_name in ['mailing.contact', 'res.partner', 'mailing.list']">\n                                                    To track replies, this address must belong to this database.\n                                                </small>\n                                            </div>\n                                        </div>\n                                        <label for="attachment_ids"/>\n                                        <div name="attachment_ids_details">\n                                            <field name="attachment_ids" widget="many2many_binary" string="Attach a file" readonly="state in ('sending', 'done')"/>\n                                        </div>\n                                    </group>\n                                    <group string="Tracking">\n                                        <field name="campaign_id" string="Campaign" groups="mass_mailing.group_mass_mailing_campaign" options="{'create_name_field': 'title'}" readonly="state in ('sending', 'done')"/>\n                                        <field name="medium_id" string="Medium" groups="base.group_no_one" required="True" readonly="state in ('sending', 'done')"/>\n                                        <field name="source_id" string="Source" class="o_text_overflow" groups="base.group_no_one" readonly="1" required="False"/>\n                                        <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>\n                                    </group>\n                                    <group string="Advanced" groups="base.group_no_one">\n                                        <field name="mail_server_available" invisible="1"/>\n                                        <field name="name" string="Name" required="False" readonly="state in ('sending', 'done')"/>\n                                        <field name="mail_server_id" invisible="not mail_server_available" readonly="state in ('sending', 'done')" domain="[('owner_user_id', '=', False)]"/>\n                                        <field name="keep_archives" readonly="state in ('sending', 'done')"/>\n                                        <!-- Not using a dedicated server and being set means generic sending, won't allow disabling it. -->\n                                        <field name="use_exclusion_list" invisible="not mail_server_id and use_exclusion_list" readonly="state != 'draft'"/>\n                                    </group>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                    <chatter/>\n                </form>\n            	f	t	2026-09-05 15:59:52.12261	2026-09-05 15:59:52.12261	f
