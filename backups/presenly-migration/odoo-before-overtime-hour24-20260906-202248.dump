109	16	\N	1	1	Uninstall module	base.module.uninstall	\N	form	base/wizard/base_module_uninstall_views.xml	primary	{"en_US": "<form string=\\"Uninstall module\\">\\n                    <div class=\\"alert alert-warning oe_button_box\\" role=\\"alert\\">\\n                        <p class=\\"mt-3\\">\\n                            Uninstalling modules can be risky, we recommend you to try it on a duplicate or test database first.\\n                        </p>\\n                    </div>\\n                    <div class=\\"d-flex bd-highlight\\">\\n                        <div class=\\"me-auto p-2 bd-highlight\\"><h3>Apps to Uninstall</h3></div>\\n                        <div class=\\"p-2 bd-highlight\\"><field name=\\"show_all\\"/> Show All</div>\\n                    </div>\\n                    <field name=\\"impacted_module_ids\\" mode=\\"kanban\\" class=\\"o_modules_field\\">\\n                        <kanban create=\\"false\\" class=\\"o_modules_kanban\\">\\n                            <field name=\\"state\\"/>\\n                                <templates>\\n                                    <t t-name=\\"card\\" class=\\"flex-row align-items-center\\">\\n                                        <aside>\\n                                            <field name=\\"icon\\" widget=\\"image_url\\" options=\\"{'size': [50, 50]}\\" alt=\\"Icon\\"/>\\n                                        </aside>\\n                                        <main t-att-title=\\"record.shortdesc.value\\">\\n                                            <field class=\\"fw-bold fs-5 mb-0\\" name=\\"shortdesc\\"/>\\n                                            <p class=\\"text-muted small my-1 lh-sm\\">\\n                                                <field groups=\\"!base.group_no_one\\" name=\\"summary\\"/>\\n                                                <code groups=\\"base.group_no_one\\">\\n                                                    <field name=\\"name\\"/>\\n                                                </code>\\n                                            </p>\\n                                        </main>\\n                                    </t>\\n                                </templates>\\n                        </kanban>\\n                    </field>\\n                    <h3>Documents to Delete</h3>\\n                    <field name=\\"model_ids\\" string=\\"Models\\" nolabel=\\"1\\">\\n                        <list string=\\"Models\\">\\n                            <field name=\\"name\\" string=\\"Document\\"/>\\n                            <field name=\\"count\\"/>\\n                        </list>\\n                    </field>\\n                    <footer>\\n                        <button string=\\"Uninstall\\" class=\\"btn-secondary\\" type=\\"object\\" name=\\"action_uninstall\\" data-hotkey=\\"q\\"/>\\n                        <button string=\\"Discard\\" class=\\"btn-primary\\" special=\\"cancel\\" data-hotkey=\\"x\\"/>\\n                    </footer>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Uninstall module">\n                    <div class="alert alert-warning oe_button_box" role="alert">\n                        <p class="mt-3">\n                            Uninstalling modules can be risky, we recommend you to try it on a duplicate or test database first.\n                        </p>\n                    </div>\n                    <div class="d-flex bd-highlight">\n                        <div class="me-auto p-2 bd-highlight"><h3>Apps to Uninstall</h3></div>\n                        <div class="p-2 bd-highlight"><field name="show_all"/> Show All</div>\n                    </div>\n                    <field name="impacted_module_ids" mode="kanban" class="o_modules_field">\n                        <kanban create="false" class="o_modules_kanban">\n                            <field name="state"/>\n                                <templates>\n                                    <t t-name="card" class="flex-row align-items-center">\n                                        <aside>\n                                            <field name="icon" widget="image_url" options="{'size': [50, 50]}" alt="Icon"/>\n                                        </aside>\n                                        <main t-att-title="record.shortdesc.value">\n                                            <field class="fw-bold fs-5 mb-0" name="shortdesc"/>\n                                            <p class="text-muted small my-1 lh-sm">\n                                                <field groups="!base.group_no_one" name="summary"/>\n                                                <code groups="base.group_no_one">\n                                                    <field name="name"/>\n                                                </code>\n                                            </p>\n                                        </main>\n                                    </t>\n                                </templates>\n                        </kanban>\n                    </field>\n                    <h3>Documents to Delete</h3>\n                    <field name="model_ids" string="Models" nolabel="1">\n                        <list string="Models">\n                            <field name="name" string="Document"/>\n                            <field name="count"/>\n                        </list>\n                    </field>\n                    <footer>\n                        <button string="Uninstall" class="btn-secondary" type="object" name="action_uninstall" data-hotkey="q"/>\n                        <button string="Discard" class="btn-primary" special="cancel" data-hotkey="x"/>\n                    </footer>\n                </form>\n            	f	t	2026-09-05 15:58:45.179291	2026-09-05 15:58:45.179291	\N
