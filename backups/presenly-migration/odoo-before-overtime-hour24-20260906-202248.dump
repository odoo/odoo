685	16	\N	1	1	hr.leave.allocation.view.activity	hr.leave.allocation	\N	activity	hr_holidays/views/hr_leave_allocation_views.xml	primary	{"en_US": "<activity string=\\"Allocation Requests\\">\\n                <field name=\\"employee_id\\"/>\\n                <templates>\\n                    <div t-name=\\"activity-box\\">\\n                        <img class=\\"rounded\\" t-att-src=\\"activity_image('hr.employee', 'avatar_128', record.employee_id.raw_value)\\" t-att-title=\\"record.employee_id.value\\" t-att-alt=\\"record.employee_id.value\\"/>\\n                        <div class=\\"ms-2\\">\\n                            <field name=\\"employee_id\\" class=\\"o_text_block o_text_bold\\"/> <span class=\\"text-muted\\">(<field name=\\"number_of_days\\"/> days)</span>\\n                            <field name=\\"holiday_status_id\\" muted=\\"1\\" display=\\"full\\"/>\\n                        </div>\\n                    </div>\\n                </templates>\\n            </activity>"}	<?xml version="1.0"?>\n<activity string="Allocation Requests">\n                <field name="employee_id"/>\n                <templates>\n                    <div t-name="activity-box">\n                        <img class="rounded" t-att-src="activity_image('hr.employee', 'avatar_128', record.employee_id.raw_value)" t-att-title="record.employee_id.value" t-att-alt="record.employee_id.value"/>\n                        <div class="ms-2">\n                            <field name="employee_id" class="o_text_block o_text_bold"/> <span class="text-muted">(<field name="number_of_days"/> days)</span>\n                            <field name="holiday_status_id" muted="1" display="full"/>\n                        </div>\n                    </div>\n                </templates>\n            </activity>\n        	f	t	2026-09-05 15:59:49.146439	2026-09-05 15:59:49.146439	f
686	16	\N	1	1	hr.leave.accrual.level.form	hr.leave.accrual.level	\N	form	hr_holidays/views/hr_leave_accrual_views.xml	primary	{"en_US": "<form string=\\"Accrual Level\\">\\n                <sheet>\\n                    <div colspan=\\"2\\">\\n                        <field name=\\"can_modify_value_type\\" invisible=\\"1\\"/>\\n                    </div>\\n                    <div class=\\"o_accrual_level_form\\">\\n                        <group class=\\"o_accrual\\" string=\\"Accrual Level Options\\">\\n                            <label class=\\"fw-bold\\" for=\\"added_value\\" string=\\"Set the employee accrual frequency :\\"/>\\n                            <span>\\n                                <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"added_value\\" widget=\\"float_without_trailing_zeros\\"/>\\n                                <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"added_value_type\\" readonly=\\"not can_modify_value_type\\"/>\\n                                <field nolabel=\\"1\\" class=\\"o_field_accrual\\" name=\\"frequency\\"/>\\n                                <span name=\\"weekly\\" invisible=\\"frequency != 'weekly'\\">\\n                                    on\\n                                    <field nolabel=\\"1\\" name=\\"week_day\\" class=\\"o_field_accrual\\" required=\\"frequency == 'weekly'\\" placeholder=\\"select a weekday\\"/>\\n                                </span>\\n                                <span name=\\"monthly\\" invisible=\\"frequency != 'monthly'\\">\\n                                    on the\\n                                    <field nolabel=\\"1\\" name=\\"first_day\\" class=\\"o_field_accrual\\" required=\\"frequency == 'monthly'\\" placeholder=\\"select a day\\"/>\\n                                    of the month.\\n                                </span>\\n                                <span name=\\"bimonthly\\" invisible=\\"frequency != 'bimonthly'\\" style=\\"width: 100%\\">\\n                                    on the\\n                                    <field nolabel=\\"1\\" name=\\"first_day\\" class=\\"o_field_accrual\\" required=\\"frequency == 'bimonthly'\\" placeholder=\\"select a day\\"/>\\n                                    and the\\n                                    <field nolabel=\\"1\\" name=\\"second_day\\" class=\\"o_field_accrual\\" required=\\"frequency == 'bimonthly'\\" placeholder=\\"select a day\\"/>\\n                                    of the month\\n                                </span>\\n                                <span name=\\"biyearly\\" invisible=\\"frequency != 'biyearly'\\">\\n                                    on the\\n                                    <field nolabel=\\"1\\" name=\\"first_month_day\\" class=\\"o_field_accrual\\" widget=\\"day_selection\\" month_field=\\"first_month\\" placeholder=\\"select a day\\" required=\\"frequency == 'biyearly'\\"/>\\n                                    of\\n                                    <field name=\\"first_month\\" class=\\"o_field_accrual\\" placeholder=\\"select a month\\" required=\\"frequency == 'biyearly'\\"/>\\n                                    and the\\n                                    <field nolabel=\\"1\\" name=\\"second_month_day\\" class=\\"o_field_accrual\\" widget=\\"day_selection\\" month_field=\\"second_month\\" placeholder=\\"select a day\\" required=\\"frequency == 'biyearly'\\"/>\\n                                    of\\n                                    <field nolabel=\\"1\\" name=\\"second_month\\" class=\\"o_field_accrual\\" placeholder=\\"select a month\\" required=\\"frequency == 'biyearly'\\"/>\\n                                </span>\\n                                <span name=\\"yearly\\" invisible=\\"frequency != 'yearly'\\">\\n                                    on the\\n                                    <field nolabel=\\"1\\" name=\\"yearly_day\\" class=\\"o_field_accrual\\" widget=\\"day_selection\\" month_field=\\"yearly_month\\" required=\\"frequency == 'yearly'\\" placeholder=\\"select a day\\"/>\\n                                    of\\n                                    <field nolabel=\\"1\\" name=\\"yearly_month\\" class=\\"o_field_accrual\\" required=\\"frequency == 'yearly'\\" placeholder=\\"select a month\\"/>\\n                                </span>\\n                            </span>\\n                            <label class=\\"fw-bold\\" for=\\"milestone_date\\" string=\\"This milestone will be reached :\\"/>\\n                            <span name=\\"milestone_date\\">\\n                                <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"milestone_date\\" widget=\\"radio_followed_by_element\\" options=\\"{'links': {'after': 'milestone_date_after'}, 'observe': 'milestone_date'}\\"/>\\n                                <span id=\\"milestone_date_after\\">\\n                                    <field nolabel=\\"1\\" class=\\"ms-1 me-1 o_field_accrual\\" name=\\"start_count\\"/>\\n                                    <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"start_type\\"/>\\n                                    from the start of allocation\\n                                </span>\\n                            </span>\\n                        </group>\\n                        <group class=\\"o_accrual\\" invisible=\\"not can_be_carryover\\" string=\\"Carry Over Options\\">\\n                            <label class=\\"fw-bold\\" for=\\"action_with_unused_accruals\\" string=\\"After a year, unused time off will be :\\"/>\\n                            <span>\\n                                <span name=\\"unused_accruals\\">\\n                                    <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"action_with_unused_accruals\\" widget=\\"radio\\" readonly=\\"not can_be_carryover\\"/>\\n                                </span>\\n                            </span>\\n                            <label class=\\"fw-bold\\" invisible=\\"action_with_unused_accruals == 'lost'\\" for=\\"carryover_options\\" string=\\"How much time can be carried over :\\"/>\\n                            <span invisible=\\"action_with_unused_accruals == 'lost'\\" id=\\"unused_accruals_all\\">\\n                                <span name=\\"carryover_options\\">\\n                                    <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"carryover_options\\" widget=\\"radio_followed_by_element\\" options=\\"{'links': {'limited': 'carryover_options_limited'}, 'observe': 'carryover_options'}\\"/>\\n                                    <span id=\\"carryover_options_limited\\" readonly=\\"1\\">\\n                                        <field nolabel=\\"1\\" class=\\"ms-1 me-1 o_field_accrual\\" name=\\"postpone_max_days\\"/>\\n                                        <field nolabel=\\"1\\" class=\\"o_field_accrual\\" name=\\"added_value_type\\" readonly=\\"1\\"/>\\n                                    </span>\\n                                </span>\\n                            </span>\\n                            <label class=\\"fw-bold\\" invisible=\\"action_with_unused_accruals == 'lost'\\" for=\\"accrual_validity\\" string=\\"Define a carry over validity?\\"/>\\n                            <span invisible=\\"action_with_unused_accruals == 'lost'\\" class=\\"d-flex\\">\\n                                <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"accrual_validity\\"/>\\n                                <span invisible=\\"not accrual_validity\\">\\n                                    The days carried over will be effective for\\n                                    <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"accrual_validity_count\\"/>\\n                                    <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"accrual_validity_type\\"/>\\n                                </span>\\n                            </span>\\n                        </group>\\n                        <group string=\\"Cap Options\\" class=\\"o_accrual\\">\\n                            <label class=\\"fw-bold\\" for=\\"cap_accrued_time_yearly\\" string=\\"Define a yearly cap?\\"/>\\n                            <span>\\n                                <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"cap_accrued_time_yearly\\"/>\\n                                <span invisible=\\"not cap_accrued_time_yearly\\">\\n                                    Accrual will stop until next carry-over date if accrued time's reach\\n                                    <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"maximum_leave_yearly\\" widget=\\"float_without_trailing_zeros\\"/>\\n                                    <field nolabel=\\"1\\" class=\\"o_field_accrual\\" name=\\"added_value_type\\" readonly=\\"1\\"/>.\\n                                </span>\\n                            </span>\\n                            <label class=\\"fw-bold\\" for=\\"cap_accrued_time\\" string=\\"Define a balance cap?\\"/>\\n                            <span>\\n                                <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"cap_accrued_time\\"/>\\n                                <span invisible=\\"not cap_accrued_time\\">\\n                                    The plan will be on hold if the balance reach\\n                                    <field nolabel=\\"1\\" class=\\"me-1 o_field_accrual\\" name=\\"maximum_leave\\" widget=\\"float_without_trailing_zeros\\"/>\\n                                    <field nolabel=\\"1\\" class=\\"o_field_accrual\\" name=\\"added_value_type\\" readonly=\\"1\\"/> of available time.\\n                                </span>\\n                            </span>\\n                        </group>\\n                    </div>\\n                </sheet>\\n                <footer>\\n                    <button string=\\"Save\\" type=\\"object\\" special=\\"save\\" class=\\"btn btn-primary\\"/>\\n                    <button string=\\"Save &amp; New\\" type=\\"object\\" name=\\"action_save_new\\" class=\\"btn btn-primary\\" invisible=\\"not context.get('new')\\"/>\\n                    <button string=\\"Discard\\" special=\\"cancel\\" class=\\"btn btn-secondary\\"/>\\n                    <button string=\\"Delete\\" type=\\"object\\" name=\\"unlink\\" class=\\"btn btn-danger ms-auto\\" invisible=\\"context.get('new')\\"/>\\n                </footer>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Accrual Level">\n                <sheet>\n                    <div colspan="2">\n                        <field name="can_modify_value_type" invisible="1"/>\n                    </div>\n                    <div class="o_accrual_level_form">\n                        <group class="o_accrual" string="Accrual Level Options">\n                            <label class="fw-bold" for="added_value" string="Set the employee accrual frequency :"/>\n                            <span>\n                                <field nolabel="1" class="me-1 o_field_accrual" name="added_value" widget="float_without_trailing_zeros"/>\n                                <field nolabel="1" class="me-1 o_field_accrual" name="added_value_type" readonly="not can_modify_value_type"/>\n                                <field nolabel="1" class="o_field_accrual" name="frequency"/>\n                                <span name="weekly" invisible="frequency != 'weekly'">\n                                    on\n                                    <field nolabel="1" name="week_day" class="o_field_accrual" required="frequency == 'weekly'" placeholder="select a weekday"/>\n                                </span>\n                                <span name="monthly" invisible="frequency != 'monthly'">\n                                    on the\n                                    <field nolabel="1" name="first_day" class="o_field_accrual" required="frequency == 'monthly'" placeholder="select a day"/>\n                                    of the month.\n                                </span>\n                                <span name="bimonthly" invisible="frequency != 'bimonthly'" style="width: 100%">\n                                    on the\n                                    <field nolabel="1" name="first_day" class="o_field_accrual" required="frequency == 'bimonthly'" placeholder="select a day"/>\n                                    and the\n                                    <field nolabel="1" name="second_day" class="o_field_accrual" required="frequency == 'bimonthly'" placeholder="select a day"/>\n                                    of the month\n                                </span>\n                                <span name="biyearly" invisible="frequency != 'biyearly'">\n                                    on the\n                                    <field nolabel="1" name="first_month_day" class="o_field_accrual" widget="day_selection" month_field="first_month" placeholder="select a day" required="frequency == 'biyearly'"/>\n                                    of\n                                    <field name="first_month" class="o_field_accrual" placeholder="select a month" required="frequency == 'biyearly'"/>\n                                    and the\n                                    <field nolabel="1" name="second_month_day" class="o_field_accrual" widget="day_selection" month_field="second_month" placeholder="select a day" required="frequency == 'biyearly'"/>\n                                    of\n                                    <field nolabel="1" name="second_month" class="o_field_accrual" placeholder="select a month" required="frequency == 'biyearly'"/>\n                                </span>\n                                <span name="yearly" invisible="frequency != 'yearly'">\n                                    on the\n                                    <field nolabel="1" name="yearly_day" class="o_field_accrual" widget="day_selection" month_field="yearly_month" required="frequency == 'yearly'" placeholder="select a day"/>\n                                    of\n                                    <field nolabel="1" name="yearly_month" class="o_field_accrual" required="frequency == 'yearly'" placeholder="select a month"/>\n                                </span>\n                            </span>\n                            <label class="fw-bold" for="milestone_date" string="This milestone will be reached :"/>\n                            <span name="milestone_date">\n                                <field nolabel="1" class="ms-1" name="milestone_date" widget="radio_followed_by_element" options="{'links': {'after': 'milestone_date_after'}, 'observe': 'milestone_date'}"/>\n                                <span id="milestone_date_after">\n                                    <field nolabel="1" class="ms-1 me-1 o_field_accrual" name="start_count"/>\n                                    <field nolabel="1" class="me-1 o_field_accrual" name="start_type"/>\n                                    from the start of allocation\n                                </span>\n                            </span>\n                        </group>\n                        <group class="o_accrual" invisible="not can_be_carryover" string="Carry Over Options">\n                            <label class="fw-bold" for="action_with_unused_accruals" string="After a year, unused time off will be :"/>\n                            <span>\n                                <span name="unused_accruals">\n                                    <field nolabel="1" class="ms-1" name="action_with_unused_accruals" widget="radio" readonly="not can_be_carryover"/>\n                                </span>\n                            </span>\n                            <label class="fw-bold" invisible="action_with_unused_accruals == 'lost'" for="carryover_options" string="How much time can be carried over :"/>\n                            <span invisible="action_with_unused_accruals == 'lost'" id="unused_accruals_all">\n                                <span name="carryover_options">\n                                    <field nolabel="1" class="ms-1" name="carryover_options" widget="radio_followed_by_element" options="{'links': {'limited': 'carryover_options_limited'}, 'observe': 'carryover_options'}"/>\n                                    <span id="carryover_options_limited" readonly="1">\n                                        <field nolabel="1" class="ms-1 me-1 o_field_accrual" name="postpone_max_days"/>\n                                        <field nolabel="1" class="o_field_accrual" name="added_value_type" readonly="1"/>\n                                    </span>\n                                </span>\n                            </span>\n                            <label class="fw-bold" invisible="action_with_unused_accruals == 'lost'" for="accrual_validity" string="Define a carry over validity?"/>\n                            <span invisible="action_with_unused_accruals == 'lost'" class="d-flex">\n                                <field nolabel="1" class="ms-1" name="accrual_validity"/>\n                                <span invisible="not accrual_validity">\n                                    The days carried over will be effective for\n                                    <field nolabel="1" class="me-1 o_field_accrual" name="accrual_validity_count"/>\n                                    <field nolabel="1" class="me-1 o_field_accrual" name="accrual_validity_type"/>\n                                </span>\n                            </span>\n                        </group>\n                        <group string="Cap Options" class="o_accrual">\n                            <label class="fw-bold" for="cap_accrued_time_yearly" string="Define a yearly cap?"/>\n                            <span>\n                                <field nolabel="1" class="ms-1" name="cap_accrued_time_yearly"/>\n                                <span invisible="not cap_accrued_time_yearly">\n                                    Accrual will stop until next carry-over date if accrued time's reach\n                                    <field nolabel="1" class="me-1 o_field_accrual" name="maximum_leave_yearly" widget="float_without_trailing_zeros"/>\n                                    <field nolabel="1" class="o_field_accrual" name="added_value_type" readonly="1"/>.\n                                </span>\n                            </span>\n                            <label class="fw-bold" for="cap_accrued_time" string="Define a balance cap?"/>\n                            <span>\n                                <field nolabel="1" class="ms-1" name="cap_accrued_time"/>\n                                <span invisible="not cap_accrued_time">\n                                    The plan will be on hold if the balance reach\n                                    <field nolabel="1" class="me-1 o_field_accrual" name="maximum_leave" widget="float_without_trailing_zeros"/>\n                                    <field nolabel="1" class="o_field_accrual" name="added_value_type" readonly="1"/> of available time.\n                                </span>\n                            </span>\n                        </group>\n                    </div>\n                </sheet>\n                <footer>\n                    <button string="Save" type="object" special="save" class="btn btn-primary"/>\n                    <button string="Save &amp; New" type="object" name="action_save_new" class="btn btn-primary" invisible="not context.get('new')"/>\n                    <button string="Discard" special="cancel" class="btn btn-secondary"/>\n                    <button string="Delete" type="object" name="unlink" class="btn btn-danger ms-auto" invisible="context.get('new')"/>\n                </footer>\n            </form>\n        	f	t	2026-09-05 15:59:49.146439