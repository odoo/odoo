onal="hide"/>\n                <field name="date_from"/>\n                <field name="date_to" optional="show"/>\n                <field name="duration_display" string="Duration" optional="show"/>\n                <field name="approval_progress_display" string="Approval" optional="hide"/>\n                <field name="state" widget="badge" decoration-muted="state in ('draft', 'cancelled')" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>\n                <field name="company_id" groups="base.group_multi_company" optional="hide"/>\n            </list>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
