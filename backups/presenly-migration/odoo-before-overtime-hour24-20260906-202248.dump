120	16	\N	1	1	res.company.kanban	res.company	\N	kanban	base/views/res_company_views.xml	primary	{"en_US": "<kanban>\\n                    <templates>\\n                        <t t-name=\\"card\\">\\n                            <div t-attf-class=\\"#{!selection_mode ? 'text-center' : ''}\\">\\n                                <i class=\\"fa fa-building\\" role=\\"img\\" aria-label=\\"Enterprise\\" title=\\"Enterprise\\"/> <field class=\\"fw-bold fs-5\\" name=\\"name\\"/>\\n                            </div>\\n                            <hr class=\\"mt4 mb4\\"/>\\n                            <div class=\\"row\\" t-if=\\"!selection_mode\\">\\n                                <div t-if=\\"record.email.value\\" class=\\"col-6 text-center\\">\\n                                    <strong>Email:</strong>\\n                                </div>\\n                                <div t-if=\\"record.phone.value\\" class=\\"col-6 text-center\\">\\n                                    <strong>Phone</strong>\\n                                </div>\\n                                <div t-if=\\"record.email.value\\" class=\\"col-6 text-center\\">\\n                                    <field name=\\"email\\"/>\\n                                </div>\\n                                <div t-if=\\"record.phone.value\\" class=\\"col-6 text-center o_force_ltr\\">\\n                                    <field name=\\"phone\\"/>\\n                                </div>\\n                            </div>\\n                            <div t-else=\\"\\">\\n                                <div t-if=\\"record.email.value\\">\\n                                    <strong>Email:</strong>\\n                                    <field name=\\"email\\"/>\\n                                </div>\\n                                <div t-if=\\"record.phone.value\\" class=\\"o_force_ltr\\">\\n                                    <strong>Phone:</strong>\\n                                    <field name=\\"phone\\"/>\\n                                </div>\\n                            </div>\\n                        </t>\\n                    </templates>\\n                </kanban>"}	<?xml version="1.0"?>\n<kanban>\n                    <templates>\n                        <t t-name="card">\n                            <div t-attf-class="#{!selection_mode ? 'text-center' : ''}">\n                                <i class="fa fa-building" role="img" aria-label="Enterprise" title="Enterprise"/> <field class="fw-bold fs-5" name="name"/>\n                            </div>\n                            <hr class="mt4 mb4"/>\n                            <div class="row" t-if="!selection_mode">\n                                <div t-if="record.email.value" class="col-6 text-center">\n                                    <strong>Email:</strong>\n                                </div>\n                                <div t-if="record.phone.value" class="col-6 text-center">\n                                    <strong>Phone</strong>\n                                </div>\n                                <div t-if="record.email.value" class="col-6 text-center">\n                                    <field name="email"/>\n                                </div>\n                                <div t-if="record.phone.value" class="col-6 text-center o_force_ltr">\n                                    <field name="phone"/>\n                                </div>\n                            </div>\n                            <div t-else="">\n                                <div t-if="record.email.value">\n                                    <strong>Email:</strong>\n                                    <field name="email"/>\n                                </div>\n                                <div t-if="record.phone.value" class="o_force_ltr">\n                                    <strong>Phone:</strong>\n                                    <field name="phone"/>\n         