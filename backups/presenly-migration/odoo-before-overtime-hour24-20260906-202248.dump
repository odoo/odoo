510	16	\N	1	1	Pager	\N	portal.pager	qweb	portal/views/portal_templates.xml	primary	{"en_US": "<t name=\\"Pager\\" t-name=\\"portal.pager\\">\\n        <ul t-if=\\"pager['page_count'] &gt; 1\\" t-attf-class=\\"#{ classname or '' } pagination m-0 #{_classes}\\" t-att-style=\\"style or None\\">\\n            <li t-attf-class=\\"page-item #{'disabled' if pager['page']['num'] == 1 else ''}\\">\\n                <a t-att-href=\\" pager['page_previous']['url'] if pager['page']['num'] != 1 else None\\" t-attf-class=\\"page-link #{extraLinkClass}\\">\\n                    <span class=\\"oi oi-chevron-left\\" role=\\"img\\" aria-label=\\"Previous\\" title=\\"Previous\\"/>\\n                </a>\\n            </li>\\n            <t t-foreach=\\"pager['pages']\\" t-as=\\"page\\">\\n                <li t-attf-class=\\"page-item #{'active' if page['num'] == pager['page']['num'] else ''} #{'disabled' if page['num'] == '…' else ''}\\">\\n                    <a t-att-href=\\"page['url']\\" t-attf-class=\\"page-link #{extraLinkClass} #{'px-0' if page['num'] == '…' else ''}\\" t-out=\\"page['num']\\"/>\\n                </li>\\n            </t>\\n            <li t-attf-class=\\"page-item #{'disabled' if pager['page']['num'] == pager['page_count'] else ''}\\">\\n                <a t-att-href=\\"pager['page_next']['url'] if pager['page']['num'] != pager['page_count'] else None\\" t-attf-class=\\"page-link #{extraLinkClass}\\">\\n                    <span class=\\"oi oi-chevron-right\\" role=\\"img\\" aria-label=\\"Next\\" title=\\"Next\\"/>\\n                </a>\\n            </li>\\n        </ul>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Pager" t-name="portal.pager">\n        <ul t-if="pager['page_count'] &gt; 1" t-attf-class="#{ classname or '' } pagination m-0 #{_classes}" t-att-style="style or None">\n            <li t-attf-class="page-item #{'disabled' if pager['page']['num'] == 1 else ''}">\n                <a t-att-href=" pager['page_previous']['url'] if pager['page']['num'] != 1 else None" t-attf-class="page-link #{extraLinkClass}">\n                    <span class="oi oi-chevron-left" role="img" aria-label="Previous" title="Previous"/>\n                </a>\n            </li>\n            <t t-foreach="pager['pages']" t-as="page">\n                <li t-attf-class="page-item #{'active' if page['num'] == pager['page']['num'] else ''} #{'disabled' if page['num'] == '…' else ''}">\n                    <a t-att-href="page['url']" t-attf-class="page-link #{extraLinkClass} #{'px-0' if page['num'] == '…' else ''}" t-out="page['num']"/>\n                </li>\n            </t>\n            <li t-attf-class="page-item #{'disabled' if pager['page']['num'] == pager['page_count'] else ''}">\n                <a t-att-href="pager['page_next']['url'] if pager['page']['num'] != pager['page_count'] else None" t-attf-class="page-link #{extraLinkClass}">\n                    <span class="oi oi-chevron-right" role="img" aria-label="Next" title="Next"/>\n                </a>\n            </li>\n        </ul>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
