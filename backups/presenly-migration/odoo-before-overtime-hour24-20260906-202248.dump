1246	40	494	1	1	Portal layout: project menu entry	\N	project.portal_layout	qweb	project/views/project_portal_project_project_templates.xml	extension	{"en_US": "<data name=\\"Portal layout: project menu entry\\" inherit_id=\\"portal.portal_breadcrumbs\\" priority=\\"40\\">\\n        <xpath expr=\\"//ol[hasclass('o_portal_submenu')]\\" position=\\"inside\\">\\n            <li t-if=\\"page_name == 'project' or project\\" class=\\"col-lg-2\\" t-attf-class=\\"breadcrumb-item #{'active ' if not project else ''}\\">\\n                <a t-if=\\"project\\" t-attf-href=\\"/my/projects\\">Projects</a>\\n                <t t-else=\\"\\">Projects</t>\\n            </li>\\n            <li t-if=\\"page_name in ['project_task', 'project_subtasks', 'project_recurrent_tasks'] and project\\" class=\\"breadcrumb-item active\\">\\n                <a t-if=\\"project\\" t-attf-href=\\"/my/projects/{{ project.id }}?{{ keep_query() }}\\"><t t-esc=\\"project.name\\"/></a>\\n            </li>\\n            <li t-elif=\\"project\\" t-attf-class=\\"breadcrumb-item #{'active ' if not project else ''} text-truncate col-8 col-lg-10\\">\\n                <t t-esc=\\"project.name\\"/>\\n            </li>\\n            <li t-if=\\"page_name == 'task' or (task and not project)\\" t-attf-class=\\"breadcrumb-item #{'active ' if not task else ''}\\">\\n                <a t-if=\\"task\\" t-attf-href=\\"/my/tasks?{{ keep_query() }}\\">Tasks</a>\\n                <t t-else=\\"\\">Tasks</t>\\n            </li>\\n            <li t-if=\\"page_name == 'project_subtasks' and task and project\\" class=\\"breadcrumb-item active\\">\\n                <a t-attf-href=\\"/my/projects/{{ project.id }}/task/{{ task.id }}\\"><t t-esc=\\"task.name\\"/></a>\\n            </li>\\n            <li t-elif=\\"page_name == 'project_recurrent_tasks' and task and project\\" class=\\"breadcrumb-item active text-truncate\\">\\n                <a t-attf-href=\\"/my/projects/{{ project.id }}/task/{{ task.id }}?{{ keep_query() }}\\"><t t-esc=\\"task.name\\"/></a>\\n            </li>\\n            <li t-elif=\\"task\\" class=\\"breadcrumb-item active text-break\\">\\n                <span t-field=\\"task.name\\"/>\\n            </li>\\n            <li t-if=\\"page_name == 'project_subtasks' or (task and subtask and project)\\" t-attf-class=\\"breadcrumb-item text-truncate #{'active ' if not subtask else ''}\\">\\n                <a t-if=\\"subtask\\" t-attf-href=\\"/my/tasks/{{ task.id }}/subtasks?{{ keep_query() }}\\">Sub-tasks</a>\\n                <t t-else=\\"\\">Sub-tasks</t>\\n            </li>\\n            <li t-elif=\\"page_name == 'project_recurrent_tasks' and task and project\\" t-attf-class=\\"breadcrumb-item text-truncate\\">\\n                Recurrent tasks\\n            </li>\\n            <li t-if=\\"subtask\\" class=\\"breadcrumb-item active text-break\\">\\n                <span t-field=\\"subtask.name\\"/>\\n            </li>\\n        </xpath>\\n    </data>"}	<?xml version="1.0"?>\n<data name="Portal layout: project menu entry" inherit_id="portal.portal_breadcrumbs" priority="40">\n        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">\n            <li t-if="page_name == 'project' or project" class="col-lg-2" t-attf-class="breadcrumb-item #{'active ' if not project else ''}">\n                <a t-if="project" t-attf-href="/my/projects">Projects</a>\n                <t t-else="">Projects</t>\n            </li>\n            <li t-if="page_name in ['project_task', 'project_subtasks', 'project_recurrent_tasks'] and project" class="breadcrumb-item active">\n                <a t-if="project" t-attf-href="/my/projects/{{ project.id }}?{{ keep_query() }}"><t t-esc="project.name"/></a>\n            </li>\n            <li t-elif="project" t-attf-class="breadcrumb-item #{'active ' if not project else ''} text-truncate col-8 col-lg-10">\n                <t t-esc="project.name"/>\n            </li>\n            <li t-if="page_name == 'task' or (task and not project)" t-attf-class="breadcrumb-item #{'active ' if not task else ''}">\n                <a t-if="task" t-attf-href="/my/tasks?{{ keep_query() }}">Tasks</a>\n                <t t-else="">Tasks</t>\n            </li>\n            <li t-if="page_name == 'project_subtasks' and task and project" class="breadcrumb-item active">\n                <a t-attf-href="/my/projects/{{ project.id }}/task/{{ task.id }}"><t t-esc="task.name"/></a>\n            </li>\n            <li t-elif="page_name == 'project_recurrent_tasks' and task and project" class="breadcrumb-item active text-truncate">\n                <a t-attf-href="/my/projects/{{ project.id }}/task/{{ task.id }}?{{ keep_query() }}"><t t-esc="task.name"/></a>\n            </li>\n            <li t-elif="task" class="breadcrumb-item active text-break">\n                <span t-field="task.name"/>\n            </li>\n            <li t-if="page_name == 'project_subtasks' or (task and subtask and project)" t-attf-class="breadcrumb-item text-truncate #{'active ' if not subtask else ''}">\n                <a t-if="subtask" t-attf-href="/my/tasks/{{ task.id }}/subtasks?{{ keep_query() }}">Sub-tasks</a>\n                <t t-else="">Sub-tasks</t>\n            </li>\n            <li t-elif="page_name == 'project_recurrent_tasks' and task and project" t-attf-class="breadcrumb-item text-truncate">\n                Recurrent tasks\n            </li>\n            <li t-if="subtask" class="breadcrumb-item active text-break">\n                <span t-field="subtask.name"/>\n            </li>\n        </xpath>\n    </data>\n\n    	f	t	2026-09-05 15:59:52.742806	2026-09-05 15:59:52.742806	f
