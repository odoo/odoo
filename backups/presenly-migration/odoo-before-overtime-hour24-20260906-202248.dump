399	16	\N	1	1	email.template.form	mail.template	\N	form	mail/views/mail_template_views.xml	primary	{"en_US": "<form string=\\"Templates\\" class=\\"o_mail_template_form_view\\">\\n                    <header>\\n                        <field name=\\"ref_ir_act_window\\" invisible=\\"1\\"/>\\n                        <field name=\\"template_fs\\" invisible=\\"1\\"/>\\n                        <field name=\\"is_template_editor\\" invisible=\\"1\\"/>\\n                        <button string=\\"Preview\\" name=\\"action_open_mail_preview\\" type=\\"object\\" class=\\"btn-primary\\" target=\\"new\\"/>\\n                        <button string=\\"Reset Template\\" name=\\"100\\" type=\\"action\\" groups=\\"mail.group_mail_template_editor\\" invisible=\\"not template_fs\\"/>\\n                        <t groups=\\"base.group_no_one\\">\\n                            <button string=\\"Add Context Action\\" class=\\"btn btn-secondary\\" name=\\"create_action\\" type=\\"object\\" groups=\\"base.group_system\\" invisible=\\"ref_ir_act_window\\" help=\\"Display an option on related documents to open a composition wizard with this template\\"/>\\n                            <button string=\\"Remove Context Action\\" class=\\"btn btn-secondary\\" name=\\"unlink_action\\" type=\\"object\\" invisible=\\"not ref_ir_act_window\\" help=\\"Remove the contextual action to use this template on related documents\\"/>\\n                        </t>\\n                    </header>\\n                    <sheet>\\n                        <div class=\\"oe_title\\">\\n                            <label for=\\"name\\"/>\\n                            <h1><field name=\\"name\\" class=\\"w-100\\" string=\\"Template Name\\" required=\\"1\\" placeholder=\\"e.g. &quot;Welcome email&quot;\\"/></h1>\\n                            <group>\\n                                <field name=\\"model_id\\" groups=\\"!base.group_no_one\\" invisible=\\"context.get('default_model')\\" placeholder=\\"e.g. Contact\\" required=\\"1\\" options=\\"{'no_create': True}\\"/>\\n                                <field name=\\"model_id\\" groups=\\"base.group_no_one\\" placeholder=\\"e.g. Contact\\" required=\\"1\\" options=\\"{'no_create': True}\\"/>\\n                                <field name=\\"subject\\" options=\\"{'dynamic_placeholder': true}\\" placeholder=\\"e.g. &quot;Welcome to MyCompany&quot; or &quot;Nice to meet you, {{ object.name }}&quot;\\"/>\\n                                <field name=\\"model\\" invisible=\\"1\\"/>\\n                            </group>\\n                        </div>\\n                        <notebook>\\n                            <page string=\\"Body\\" name=\\"content\\">\\n                                <field name=\\"can_write\\" invisible=\\"1\\"/>\\n                                <field name=\\"body_html\\" widget=\\"html_mail\\" class=\\"oe-bordered-editor\\" placeholder=\\"Write your message here...\\" options=\\"{'codeview': true, 'dynamic_placeholder': true, 'allowCommandVideo': false}\\" readonly=\\"not can_write and id\\"/>\\n                                <div invisible=\\"not can_write\\" class=\\"fst-italic text-muted\\">Tip: Write /field to insert dynamic content!</div>\\n                            </page>\\n                            <page string=\\"Settings\\" name=\\"email_configuration\\" groups=\\"base.group_no_one\\">\\n                                <group col=\\"2\\">\\n                                    <group>\\n                                        <separator string=\\"Sender &amp; Recipients\\"/>\\n                                        <field name=\\"email_from\\" placeholder=\\"Sender's email\\"/>\\n                                        <field name=\\"use_default_to\\"/>\\n                                        <field name=\\"email_to\\" invisible=\\"use_default_to\\" placeholder=\\"Comma-separated recipient addresses\\"/>\\n                                        <field name=\\"partner_to\\" invisible=\\"use_default_to\\" placeholder=\\"Comma-separated ids of recipient partners\\"/>\\n                                        <field name=\\"email_cc\\" invisible=\\"use_default_to\\" placeholder=\\"Comma-separated carbon copy of recipients addresses\\"/>\\n                                        <field name=\\"reply_to\\" placeholder=\\"Capture replies in the chatter\\"/>\\n                                    </group>\\n                                    <group>\\n                                        <separator string=\\"Technical\\"/>\\n                                        <field name=\\"lang\\" placeholder=\\"Main partner's language\\" options=\\"{'dynamic_placeholder': true}\\"/>\\n                                        <field name=\\"has_mail_server\\" invisible=\\"1\\"/>\\n                                        <field name=\\"mail_server_id\\" invisible=\\"not has_mail_server\\" placeholder=\\"By order of server priority\\"/>\\n                                        <field name=\\"auto_delete\\"/>\\n                                        <field name=\\"scheduled_date\\" string=\\"Scheduled Send Date\\" placeholder=\\"Send Instantly\\" options=\\"{'dynamic_placeholder': true}\\"/>\\n                                    </group>\\n                                </group>\\n                            </page>\\n                            <page string=\\"Options\\" name=\\"email_settings\\">\\n                                <group col=\\"2\\">\\n                                    <group>\\n                                        <field name=\\"has_dynamic_reports\\" invisible=\\"1\\"/>\\n                                        <field name=\\"attachment_ids\\" widget=\\"many2many_binary\\"/>\\n                                        <field name=\\"report_template_ids\\" widget=\\"many2many_tags\\" domain=\\"[('model','=',model)]\\" invisible=\\"not has_dynamic_reports\\" options=\\"{'no_create': True}\\" placeholder=\\"None\\"/>\\n                            