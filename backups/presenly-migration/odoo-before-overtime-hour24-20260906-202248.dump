auto">\n                <table class="table table-hover table-sm o_survey_results_table_indexed" t-att-id="'survey_table_question_%d' % question.id">\n                    <thead>\n                        <tr>\n                            <th>#</th>\n                            <th>User Responses</th>\n                        </tr>\n                    </thead>\n                    <!-- The following tbody tag is populated by the interaction survey_result_pagination\n                    (see also the template survey.paginated_results_rows) -->\n                    <tbody/>\n                </table>\n            </div>\n            <t t-call="survey.question_table_pagination"/>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
954	16	\N	1	1	Question: number or date (and time) result (numerical_box or date or datetime)	\N	survey.question_result_number_or_date_or_datetime	qweb	survey/views/survey_templates_statistics.xml	primary	{"en_US": "<t name=\\"Question: number or date (and time) result (numerical_box or date or datetime)\\" t-name=\\"survey.question_result_number_or_date_or_datetime\\">\\n        <div class=\\"tab-content\\">\\n            <div role=\\"tabpanel\\" class=\\"tab-pane active with-3d-shadow with-transitions\\" t-att-id=\\"'survey_stats_question_%d' % question.id\\">\\n                <table class=\\"table table-hover table-sm\\">\\n                    <thead>\\n                        <tr>\\n                            <th>Top User Responses</th>\\n                            <th>Occurrence</th>\\n                            <th t-if=\\"question.is_scored_question\\">Score</th>\\n                        </tr>\\n                    </thead>\\n                    <tbody>\\n                        <tr t-foreach=\\"question_data['common_lines']\\" t-as=\\"common_line\\">\\n                            <td>\\n                                <t t-if=\\"question.question_type == 'numerical_box'\\">\\n                                    <t t-set=\\"right_answer\\" t-value=\\"common_line[0] == question.answer_numerical_box\\"/>\\n                                    <span><t t-call=\\"survey.survey_remove_unnecessary_decimals\\" value_to_format=\\"common_line[0]\\"/></span>\\n                                    <i t-if=\\"right_answer\\" class=\\"fa fa-check\\"/>\\n                                </t>\\n                                <t t-elif=\\"question.question_type == 'date'\\">\\n                                    <t t-set=\\"right_answer\\" t-value=\\"common_line[0] == question.answer_date\\"/>\\n                                    <span t-esc=\\"common_line[0]\\" t-options=\\"{&quot;widget&quot;: &quot;date&quot;}\\"/>\\n                                    <i t-if=\\"right_answer\\" class=\\"fa fa-check\\"/>\\n                                </t>\\n                                <t t-elif=\\"question.question_type == 'datetime'\\">\\n                                    <t t-set=\\"right_answer\\" t-value=\\"common_line[0] == question.answer_datetime\\"/>\\n                                    <span t-esc=\\"common_line[0]\\" t-options=\\"{&quot;widget&quot;: &quot;datetime&quot;}\\"/>\\n                                    <i t-if=\\"right_answer\\" class=\\"fa fa-check\\"/>\\n                                </t>\\n                            </td>\\n                            <td><span t-esc=\\"common_line[1]\\"/></td>\\n                            <td t-if=\\"question.is_scored_question\\">\\n                                <span t-if=\\"right_answer\\">\\n                                    <t t-call=\\"survey.survey_remove_unnecessary_decimals\\" value_to_format=\\"question.answer_score\\"/>\\n                                </span>\\n                                <span t-else=\\"\\">0</span>\\n                            </td>\\n                        </tr>\\n                    </tbody>\\n                </table>\\n            </div>\\n            <div role=\\"tabpanel\\" class=\\"tab-pane\\" t-att-id=\\"'survey_data_question_%d' % question.id\\">\\n                <t t-set=\\"answers_json\\" t-value=\\"question_data['answers_data']\\"/>\\n                <t t-set=\\"hide_filter\\" t-value=\\"question.id in already_filtered_questions or len(table_data) == 1\\"/>\\n                <div class=\\"survey_table_with_pagination\\" t-att-data-answers-json=\\"answers_json\\" t-att-data-hide-filter=\\"hide_filter\\" t-att-data-record_limit=\\"page_record_limit\\">   \\n                    <div class=\\"o_survey_results_table_wrapper overflow-auto\\">\\n                        <table class=\\"table table-hover table-sm o_survey_results_table_indexed\\" t-att-id=\\"'survey_table_question_%d' % question.id\\">\\n                            <thead>\\n                                <tr>\\n                                    <th>#</th>\\n                                    <th>User Responses</th>\\n                                </tr>\\n                            </thead>\\n                            <!-- The following tbody tag is populated by the interaction survey_result_pagination\\n                            (see also the template survey.paginated_results_rows) -->\\n                            <tbody/>\\n                        </table>\\n                    </div>\\n                    <t t-call=\\"survey.question_table_pagination\\"/>\\n                </div>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Question: number or date (and time) result (numerical_box or date or datetime)" t-name="survey.question_result_number_or_date_or_datetime">\n        <div class="tab-content">\n            <div role="tabpanel" class="tab-pane active with-3d-shadow with-transitions" t-att-id="'survey_stats_question_%d' % question.id">\n                <table class="table table-hover table-sm">\n                    <thead>\n                        <tr>\n                            <th>Top User Responses</th>\n                            <th>Occurrence</th>\n                            <th t-if="question.is_scored_question">Score</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr t-foreach="question_data['common_lines']" t-as="common_line">\n                            <td>\n                                <t t-if="question.question_type == 'numerical_box'">\n                                    <t t-set="right_answer" t-value="common_line[0] == question.answer_numerical_box"/>\n                                    <span><t t-call="survey.survey_remove_unnecessary_decimals" value_to_format="common_line[0]"/></span>\n                                    <i t-if="right_answer" class="fa fa-check"/>\n                                </t>\n                                <t t-elif="question.question_type == 'date'">\n                                    <t t-set="right_answer" t-value="common_line[0] == question.answer_date"/>\n                                    <span t-esc="common_line[0]" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>\n                                    <i t-if="right_answer" class="fa fa-check"/>\n                                </t>\n                                <t t-elif="question.question_type == 'datetime'">\n                                    <t t-set="right_answer" t-value="common_line[0] == question.answer_datetime"/>\n                                    <span t-esc="common_line[0]" t-options="{&quot;widget&quot;: &quot;datetime&quot;}"/>\n                                    <i t-if="right_answer" class="fa fa-check"/>\n                                </t>\n                            </td>\n                            <td><span t-esc="common_line[1]"/></td>\n                            <td t-if="question.is_scored_question">\n                                <span t-if="right_answer">\n                                    <t t-call="survey.survey_remove_unnecessary_decimals" value_to_format="question.answer_score"/>\n                                </span>\n                                <span t-else="">0</span>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <div role="tabpanel" class="tab-pane" t-att-id="'survey_data_question_%d' % question.id">\n                <t t-set="answers_json" t-value="question_data['answers_data']"/>\n                <t t-set="hide_filter" t-value="question.id in already_filtered_questions or len(table_data) == 1"/>\n                <div class="survey_table_with_pagination" t-att-data-answers-json="answers_json" t-att-data-hide-filter="hide_filter" t-att-data-record_limit="page_record_limit">   \n                    <div class="o_survey_results_table_wrapper overflow-auto">\n                        <table class="table table-hover table-sm o_survey_results_table_indexed" t-att-id="'survey_table_question_%d' % question.id">\n                            <thead>\n                                <tr>\n                                    <th>#</th>\n                                    <th>User Responses</th>\n                                </tr>\n                            </thead>\n                            <!-- The following tbody tag is populated by the interaction survey_result_pagination\n                            (see also the template survey.paginated_results_rows) -->\n                            <tbody/>\n                        </table>\n                    </div>\n                    <t t-call="survey.question_table_pagination"/>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
955	16	\N	1	1	Question: choice result (simple_choice, multiple_choice, scale)	\N	survey.question_result_choice	qweb	survey/views/survey_templates_statistics.xml	primary	{"en_US": "<t name=\\"Question: choice result (simple_choice, multiple_choice, scale)\\" t-name=\\"survey.question_result_choice\\">\\n        <div class=\\"tab-content\\">\\n            <div t-if=\\"question_answered\\" role=\\"tabpanel\\" class=\\"tab-pane active survey_graph\\" t-att-id=\\"'survey_graph_question_%d' % question.id\\" t-att-data-question-id=\\"question.id\\" t-att-data-graph-type=\\"'pie' if question.question_type == 'simple_choice' else 'bar'\\" t-att-data-graph-data=\\"graph_data\\" t-att-data-right-answers=\\"list(question_data['answer_line_done_ids'].mapped('value_scale')) if question.question_type in ['scale'] else list(question_data['right_answers'].mapped('value'))\\">\\n                <!-- canvas element for drawing bar chart -->\\n                <canvas class=\\"mx-auto w-100 h-auto\\"/>\\n            </div>\\n            <div role=\\"tabpanel\\" t-att-id=\\"'survey_data_question_%d' % question.id\\" t-attf-class=\\"tab-pane #{'active' if not question_answered else ''} table-responsive\\">\\n                <table class=\\"table table-hover table-sm\\">\\n                    <thead>\\n                        <tr>\\n                            <th>Answer</th>\\n                            <th t-if=\\"question_has_image_answers\\">Image</th>\\n                            <th>User Choice</th>\\n                            <th t-if=\\"question.is_scored_question\\">Score</th>\\n                        </tr>\\n                    </thead>\\n                    <tbody>\\n                        <tr t-foreach=\\"table_data\\" t-as=\\"choice_data\\">\\n                            <td>\\n                                <p class=\\"text-nowrap my-0\\">\\n                                    <span t-if=\\"question.question_type == 'numerical_box'\\">\\n                                        <t t-call=\\"survey.survey_remove_unnecessary_decimals\\" value_to_format=\\"choice_data['value']\\"/>\\n                                    </span>\\n                                    <span t-else=\\"\\" t-esc=\\"choice_data['value']\\"/>\\n                                    <i t-if=\\"question.is_scored_question and choice_data['suggested_answer'].is_correct\\" class=\\"fa fa-check\\"/>\\n                                </p>\\n                            </td>\\n                            <td t-if=\\"question_has_image_answers\\">\\n                               <div t-if=\\"choice_data['suggested_answer'].value_image\\" t-field=\\"choice_data['suggested_answer'].value_image\\" t-options=\\"{&quot;widget&quot;: &quot;image&quot;, &quot;qweb_img_responsive&quot;: False, &quot;class&quot;: &quot;o_image_64_max o_survey_answer_image&quot;, &quot;alt-field&quot;: &quot;name&quot;, &quot;itemprop&quot;: &quot;image&quot;}\\"/>\\n                            </td>\\n                            <td class=\\"o_survey_answer d-flex align-items-center gap-1\\">\\n                                <span t-esc=\\"round(choice_data['count'] * 100.0/ (len(question_data['answer_line_done_ids']) or 1), 2)\\"/> %\\n                                <span t-out=\\"choice_data['count_text']\\" class=\\"badge text-bg-primary\\"/>\\n                                <i t-if=\\"choice_data['suggested_answer'].id and choice_data['count']\\" class=\\"fa fa-filter text-primary filter-add-answer d-print-none\\" data-model-short-key=\\"A\\" t-att-data-record-id=\\"choice_data['suggested_answer'].id\\" role=\\"img\\" aria-label=\\"Filter surveys\\" title=\\"Only show survey results having selected this answer\\"/>\\n                            </td>\\n                            <td t-if=\\"question.is_scored_question\\">\\n                                <t t-call=\\"survey.survey_remove_unnecessary_decimals\\" value_to_format=\\"choice_data['suggested_answer'].answer_score\\"/>\\n                            </td>\\n                        </tr>\\n                    </tbody>\\n                </table>\\n            </div>\\n        </div>\\n        <div t-if=\\"comment_lines\\"><t t-call=\\"survey.question_result_comments\\"/></div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Question: choice result (simple_choice, multiple_choice, scale)" t-name="survey.question_result_choice">\n        <div class="tab-content">\n            <div t-if="question_answered" role="tabpanel" class="tab-pane active survey_graph" t-att-id="'survey_graph_question_%d' % question.id" t-att-data-question-id="question.id" t-att-data-graph-type="'pie' if question.question_type == 'simple_choice' else 'bar'" t-att-data-graph-data="graph_data" t-att-data-right-answers="list(question_data['answer_line_done_ids'].mapped('value_scale')) if question.question_type in ['scale'] else list(question_data['right_answers'].mapped('value'))">\n                <!-- canvas element for drawing bar chart -->\n                <canvas class="mx-auto w-100 h-auto"/>\n            </div>\n            <div role="tabpanel" t-att-id="'survey_data_question_%d' % question.id" t-attf-class="tab-pane #{'active' if not question_answered else ''} table-responsive">\n                <table class="table table-hover table-sm">\n                    <thead>\n                        <tr>\n                            <th>Answer</th>\n                            <th t-if="question_has_image_answers">Image</th>\n                            <th>User Choice</th>\n                            <th t-if="question.is_scored_question">Score</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr t-foreach="table_data" t-as="choice_data">\n                            <td>\n                                <p class="text-nowrap my-0">\n                                    <span t-if="question.question_type == 'numerical_box'">\n                            