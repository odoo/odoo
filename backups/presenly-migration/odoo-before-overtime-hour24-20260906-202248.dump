me is accrued?\\"/>\\n                                    <field nolabel=\\"1\\" class=\\"ms-1\\" name=\\"accrued_gain_time\\" widget=\\"radio\\"/>\\n                                    <label class=\\"fw-bold\\" invisible=\\"accrued_gain_time == 'start'\\" for=\\"is_based_on_worked_time\\" string=\\"It is based on worked time?\\"/>\\n                                    <span invisible=\\"accrued_gain_time == 'start'\\">\\n                                        <field class=\\"o_field_radio ms-1\\" name=\\"is_based_on_worked_time\\" widget=\\"boolean_radio\\" options=\\"{                                                     'yes_label_element_id': 'is_based_on_worked_time_yes',                                                     'no_label_element_id': 'is_based_on_worked_time_no'                                                 }\\" readonly=\\"accrued_gain_time == 'start'\\"/>\\n                                        <template id=\\"is_based_on_worked_time_yes\\">Yes, consider the worked hours, excluding any time off taken during that period.\\n                                        </template>\\n                                        <template id=\\"is_based_on_worked_time_no\\">No, always consider the entire accrual period (whole calendar days).\\n                                        </template>\\n                                    </span>\\n                                    <label class=\\"fw-bold\\" for=\\"can_be_carryover\\" string=\\"Do you need a carry-over of the accrued days from one year to another?\\"/>\\n                                    <span>\\n                                        <field class=\\"ms-1\\" name=\\"can_be_carryover\\"/>\\n                                    </span>\\n                                    <label class=\\"fw-bold\\" invisible=\\"not can_be_carryover\\" for=\\"carryover_date\\" string=\\"When do you want the accrued time left to be carried-over?\\"/>\\n                                    <span name=\\"carryover\\" invisible=\\"not can_be_carryover\\">\\n                                        <field class=\\"ms-1\\" name=\\"carryover_date\\" widget=\\"radio_followed_by_element\\" options=\\"{'links': {'other': 'carryover_custom_date'}, 'observe': 'carryover'}\\"/>\\n                                        <span id=\\"carryover_custom_date\\">\\n                                            : the\\n                                            <field name=\\"carryover_day\\" widget=\\"day_selection\\" month_field=\\"carryover_month\\" placeholder=\\"select a day\\" required=\\"carryover_date == 'other'\\"/>\\n                                            of\\n                                            <field name=\\"carryover_month\\" placeholder=\\"select a month\\" required=\\"carryover_date == 'other'\\"/>\\n                                        </span>\\n                                    </span>\\n                                    <label class=\\"fw-bold\\" invisible=\\"not show_transition_mode\\" for=\\"transition_mode\\" string=\\"Switch employees to the new accrual level:\\"/>\\n                                    <span invisible=\\"not show_transition_mode\\">\\n                                        <field class=\\"ms-1\\" name=\\"transition_mode\\" widget=\\"radio\\"/>\\n                                    </span>\\n                                </group>\\n                            </div>\\n                        </div>\\n                        <div class=\\"o_accrual_plan_levels border rounded-3 d-flex mt-2 flex-direction-column align-items-center flex-1 overflow-hidden\\">\\n                            <div class=\\"o_accrual_levels_scrollable w-100 h-100 d-flex align-content-center\\">\\n                                <div class=\\"o_view_nocontent top-0\\" style=\\"position: relative;\\" invisible=\\"level_ids\\">\\n                                    <div class=\\"o_nocontent_help\\">\\n                                        <p class=\\"o_view_nocontent_smiling_face\\">\\n                                            No milestones on the plan yet. Let's create a new one\\n                                        </p>\\n                                        <button name=\\"action_create_accrual_plan_level\\" type=\\"object\\" class=\\"btn btn-primary\\" string=\\"Create a milestone\\"/>\\n                                    </div>\\n                                </div>\\n                                <field name=\\"level_ids\\" widget=\\"accrual_levels\\" invisible=\\"not level_ids\\"/>\\n                            </div>\\n                        </div>\\n                    </div>\\n                </sheet>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Accrual Plan" class="o_accrual_plan_form">\n                <field name="active" invisible="1"/>\n                <field name="show_transition_mode" invisible="1"/>\n                <sheet>\n                    <div class="oe_button_box" name="button_box" invisible="not id">\n                        <button name="action_open_accrual_plan_employees" type="object" class="oe_stat_button" icon="fa-users" invisible="employees_count == 0" groups="hr.group_hr_user">\n                            <field name="employees_count" widget="statinfo"/>\n                        </button>\n                    </div>\n                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>\n                    <div>\n                        <div class="d-flex flex-direction-row o_accrual_plan_settings">\n                            <div class="w-100">\n                                <div class="oe_title w-50">\n                                    <label class="fw-bold" for="name" string="Title"/>\n                                    <h1><field name="name" placeholder="e.g. Seniority Plan, PTO, RTT, ..." required="id"/></h1>\n                                    <group groups="base.group_multi_company">\n                                        <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" placeholder="Visible to all"/>\n                                    </group>\n                                </div>\n                                <group string="Configuration" class="mt-0 o_accrual">\n                                    <label class="fw-bold" for="accrued_gain_time" string="When the time is accrued?"/>\n                                    <field nolabel="1" class="ms-1" name="accrued_gain_time" widget="radio"/>\n                                    <label class="fw-bold" invisible="accrued_gain_time == 'start'" for="is_based_on_worked_time" string="It is based on worked time?"/>\n                                    <span invisible="accrued_gain_time == 'start'">\n                                        <field class="o_field_radio ms-1" name="is_based_on_worked_time" widget="boolean_radio" options="{                                                     'yes_label_element_id': 'is_based_on_worked_time_yes',                                                     'no_label_element_id': 'is_based_on_worked_time_no'                                                 }" readonly="accrued_gain_time == 'start'"/>\n                                        <template id="is_based_on_worked_time_yes">Yes, consider the worked hours, excluding any time off taken during that period.\n                                        </template>\n                                        <template id="is_based_on_worked_time_no">No, always consider the entire accrual period (whole calendar days).\n                                        </template>\n                                    </span>\n                                    <label class="fw-bold" for="can_be_carryover" string="Do you need a carry-over of the accrued days from one year to another?"/>\n                                    <span>\n                                        <field class="ms-1" name="can_be_carryover"/>\n                                    </span>\n                                    <label class="fw-bold" invisible="not can_be_carryover" for="carryover_date" string="When do you want the accrued time left to be carried-over?"/>\n                                    <span name="carryover" invisible="not can_be_carryover">\n                                        <field class="ms-1" name="carryover_date" widget="radio_followed_by_element" options="{'links': {'other': 'carryover_custom_date'}, 'observe': 'carryover'}"/>\n                                        <span id="carryover_custom_date">\n                                            : the\n                                            <field name="carryover_day" widget="day_selection" month_field="carryover_month" placeholder="select a day" required="carryover_date == 'other'"/>\n                                            of\n                                            <field name="carryover_month" placeholder="select a month" required="carryover_date == 'other'"/>\n                                        </span>\n                                    </span>\n                                    <label class="fw-bold" invisible="not show_transition_mode" for="transition_mode" string="Switch employees to the new accrual level:"/>\n                                    <span invisible="not show_transition_mode">\n                                        <field class="ms-1" name="transition_mode" widget="radio"/>\n                                    </span>\n                                </group>\n                            </div>\n                        </div>\n                        <div class="o_accrual_plan_levels border rounded-3 d-flex mt-2 flex-direction-column align-items-center flex-1 overflow-hidden">\n                            <div class="o_accrual_levels_scrollable w-100 h-100 d-flex align-content-center">\n                                <div class="o_view_nocontent top-0" style="position: relative;" i