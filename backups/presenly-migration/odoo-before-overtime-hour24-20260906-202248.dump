ield name="state" invisible="1"/>\n                    <p class="alert alert-warning" role="alert" invisible="state == 'done' or context.get('data_module')">Note: you can only import data modules (.xml files, i18n files and static assets)</p>\n                    <field name="modules_dependencies" readonly="1" nolabel="1" invisible="state == 'done'"/>\n                    <group invisible="state != 'init'">\n                        <field name="module_file" string="Module file (.zip)" options="{'accepted_file_extensions': '.zip'}" invisible="context.get('data_module')"/>\n                        <field name="force" groups="base.group_no_one"/>\n                        <field name="with_demo" string="Load demo data"/>\n                    </group>\n                    <group invisible="state != 'done'">\n                        <field name="import_message" nolabel="1" readonly="1"/>\n                    </group>\n                    <footer>\n                        <div invisible="state != 'init'">\n                            <button name="import_module" string="Install" type="object" class="btn-primary" data-hotkey="q"/>\n                            <button special="cancel" data-hotkey="x" string="Cancel" class="btn-secondary"/>\n                        </div>\n                        <div invisible="state != 'done'">\n                            <button special="cancel" data-hotkey="x" string="Close" class="btn-secondary"/>\n                        </div>\n                    </footer>\n                </form>\n            	f	t	2026-09-05 15:58:48.295304	2026-09-05 15:58:48.295304	\N
232	16	101	1	1	Apps Kanban Data Modules	ir.module.module	\N	kanban	base_import_module/views/ir_module_views.xml	extension	{"en_US": "<data><xpath expr=\\"//field[@name='application']\\" position=\\"after\\">\\n                    <field name=\\"module_type\\"/>\\n                </xpath>\\n                <xpath expr=\\"//button[@name='button_immediate_install']\\" position=\\"after\\">\\n                    <button type=\\"object\\" class=\\"btn btn-primary btn-sm\\" name=\\"button_immediate_install_app\\" invisible=\\"state != 'uninstalled' or module_type in ('official', False)\\" groups=\\"base.group_system\\" context=\\"{'module_name':name}\\">Activate</button>\\n                    <button type=\\"object\\" class=\\"btn btn-primary btn-sm\\" name=\\"button_immediate_install_app\\" invisible=\\"state == 'uninstalled' or module_type in ('official', False)\\" groups=\\"base.group_system\\" context=\\"{'module_name':name}\\">Upgrade</button>\\n                </xpath>\\n                <xpath expr=\\"//button[@name='button_immediate_install']\\" position=\\"attributes\\">\\n                    <attribute name=\\"invisible\\">state != 'uninstalled' or (module_type and module_type != 'official')</attribute>\\n                </xpath>\\n                <xpath expr=\\"//a[@name='button_immediate_upgrade']\\" position=\\"attributes\\">\\n                    <attribute name=\\"invisible\\">state != 'installed' or imported</attribute>\\n                </xpath>\\n                <xpath expr=\\"//t[@t-name='menu']/a[@type='open']\\" position=\\"attributes\\">\\n                    <attribute name=\\"context\\">{'module_type': module_type, 'module_name':name}</attribute>\\n                    <attribute name=\\"type\\">object</attribute>\\n                    <attribute name=\\"name\\">more_info</attribute>\\n                </xpath>\\n                <xpath expr=\\"//footer/a[@type='open']\\" position=\\"attributes\\">\\n                    <attribute name=\\"context\\">{'