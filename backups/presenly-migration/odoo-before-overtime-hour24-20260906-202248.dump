944	16	\N	1	1	Survey: Access Code page	\N	survey.survey_session_code	qweb	survey/views/survey_templates_management.xml	primary	{"en_US": "<t name=\\"Survey: Access Code page\\" t-name=\\"survey.survey_session_code\\">\\n        <t t-call=\\"survey.layout\\">\\n            <div class=\\"wrap o_survey_wrap pb16 d-flex\\">\\n                <div class=\\"container o_survey_quick_access d-flex flex-column\\">\\n                    <div class=\\"d-flex flex-grow-1 align-items-center\\">\\n                        <div class=\\"w-100 px-4 px-md-0\\">\\n                            <div class=\\"text-center mb32\\">\\n                                <h3>Enter Session Code</h3>\\n                            </div>\\n                            <div class=\\"row\\">\\n                                <div class=\\"col-12 col-md-4 offset-md-4 text-center\\">\\n                                    <input id=\\"session_code\\" type=\\"text\\" placeholder=\\"e.g. 4812\\" autocomplete=\\"off\\" t-attf-value=\\"{{session_code if session_code else ''}}\\" class=\\"form-control o_survey_question_text_box fw-bold bg-transparent text-primary text-center rounded-0 p-2 w-100\\"/>\\n                                </div>\\n                                <div class=\\"col-12 col-md-4 offset-md-4 text-center o_survey_error text-danger h4 pt-2 px-0\\" role=\\"alert\\">\\n                                    <span t-attf-class=\\"o_survey_session_error_invalid_code {{'d-none' if error != 'survey_wrong' else ''}}\\">Oops! No survey matches this code.</span>\\n                                    <span t-attf-class=\\"o_survey_session_error_not_launched {{'d-none' if error != 'survey_session_not_launched' else ''}}\\">The session did not start yet.</span>\\n                                </div>\\n                            </div>\\n                            <div class=\\"text-center mt32 p-2\\">\\n                                <button groups=\\"survey.group_survey_user\\" type=\\"button\\" t-attf-class=\\"o_survey_launch_session btn btn-primary {{'d-none' if error != 'survey_session_not_launched' else ''}}\\" t-att-data-survey-id=\\"survey_id\\">Launch Session</button>\\n                                <button type=\\"submit\\" t-attf-class=\\"btn btn-primary {{'d-none' if error == 'survey_session_not_launched' and request.env.user.has_group('survey.group_survey_user') else ''}}\\">Join Session</button>\\n                            </div>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: Access Code page" t-name="survey.survey_session_code">\n        <t t-call="survey.layout">\n            <div class="wrap o_survey_wrap pb16 d-flex">\n                <div class="container o_survey_quick_access d-flex flex-column">\n                    <div class="d-flex flex-grow-1 align-items-center">\n                        <div class="w-100 px-4 px-md-0">\n                            <div class="text-center mb32">\n                                <h3>Enter Session Code</h3>\n                            </div>\n                            <div class="row">\n                                <div class="col-12 col-md-4 offset-md-4 text-center">\n                                    <input id="session_code" type="text" placeholder="e.g. 4812" autocomplete="off" t-attf-value="{{session_code if session_code else ''}}" class="form-control o_survey_question_text_box fw-bold bg-transparent text-primary text-center rounded-0 p-2 w-100"/>\n                                </div>\n                                <div class="col-12 col-md-4 offset-md-4 text-center o_survey_error text-danger h4 pt-2 px-0" role="alert">\n                                    <span t-attf-class="o_survey_session_error_invalid_code {{'d-none' if error != 'survey_wrong' else ''}}">Oops! No survey matches this code.</span>\n                                    <span t-attf-class="o_survey_session_error_not_launched {{'d-none' if error != 'survey_session_not_launched' else ''}}">The session did not start yet.</span>\n                                </div>\n                            </div>\n                            <div class="text-center mt32 p-2">\n                                <button groups="survey.group_survey_user" type="button" t-attf-class="o_survey_launch_session btn btn-primary {{'d-none' if error != 'survey_session_not_launched' else ''}}" t-att-data-survey-id="survey_id">Launch Session</button>\n                                <button type="submit" t-attf-class="btn btn-primary {{'d-none' if error == 'survey_session_not_launched' and request.env.user.has_group('survey.group_survey_user') else ''}}">Join Session</button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
952	16	\N	1	1	Survey: Filter results	\N	survey.survey_results_filters	qweb	survey/views/survey_templates_statistics.xml	primary	{"en_US": "<t name=\\"Survey: Filter results\\" t-name=\\"survey.survey_results_filters\\">\\n        <t t-set=\\"search_passed_or_failed\\" t-value=\\"search_failed or search_passed\\"/>\\n        <div class=\\"question_and_page_data o_survey_result p-0\\">\\n            <nav class=\\"navbar navbar-light rounded p-0\\">\\n                <div t-if=\\"question_and_page_data\\" class=\\"justify-content-between w-100\\">\\n                    <ul class=\\"nav o_survey_results_topbar_dropdown_filters align-items-center\\">\\n                        <t t-set=\\"dropdown_item_classes\\" t-translation=\\"off\\">dropdown-item d-flex align-items-center justify-content-between</t>\\n                        <li class=\\"nav-item dropdown me-2 my-1\\">\\n                            <a href=\\"#\\" role=\\"button\\" data-bs-toggle=\\"dropdown\\" t-attf-class=\\"btn btn-outline-primary dropdown-toggle #{'active' if search_finished else ''}\\">\\n                                <span t-if=\\"search_finished\\">Completed surveys</span>\\n                                <span t-else=\\"\\">All surveys</span>\\n                            </a>\\n                            <div class=\\"dropdown-menu\\">\\n                                <a t-attf-class=\\"#{dropdown_item_classes} filter-finished-or-not #{'active' if not search_finished else ''}\\">\\n                                    <span>All surveys</span>\\n                                    <span t-if=\\"not search_finished\\" t-esc=\\"survey_data['count_all']\\" class=\\"badge rounded-pill text-bg-primary ms-3\\"/>\\n                                </a>\\n                                <a t-attf-class=\\"#{dropdown_item_classes} filter-finished #{'active' if search_finished else ''}\\">\\n                                    <span>Completed surveys</span>\\n                                    <span t-if=\\"not search_finished\\" t-esc=\\"survey_data['count_finished']\\" class=\\"badge rounded-pill text-bg-primary ms-3\\"/>\\n                                </a>\\n                            </div>\\n                        </li>\\n                        <li t-if=\\"survey.scoring_type != 'no_scoring'\\" class=\\"nav-item dropdown me-2 my-1\\">\\n                            <a href=\\"#\\" role=\\"button\\" data-bs-toggle=\\"dropdown\\" t-attf-class=\\"btn btn-outline-primary dropdown-toggle #{'active' if search_passed_or_failed else ''}\\">\\n                                <span t-if=\\"search_failed\\">Failed only</span>\\n                                <span t-elif=\\"search_passed\\">Passed only</span>\\n                                <span t-else=\\"\\">Passed and Failed</span>\\n                            </a>\\n                            <div class=\\"dropdown-menu\\">\\n                                <a t-attf-class=\\"#{dropdown_item_classes} filter-passed-and-failed #{'active' if not search_passed_or_failed else ''}\\">\\n                                    <span>Passed and Failed</span>\\n                                    <span t-if=\\"not search_passed_or_failed\\" t-esc=\\"survey_data['count_all']\\" class=\\"badge rounded-pill text-bg-primary ms-3\\"/>\\n                                </a>\\n                                <a t-attf-class=\\"#{dropdown_item_classes} filter-passed #{'active' if search_passed else ''}\\">\\n                                    <span>Passed only</span>\\n                                    <span t-if=\\"not search_passed_or_failed\\" t-esc=\\"survey_data['count_passed']\\" class=\\"badge rounded-pill text-bg-primary ms-3\\"/>\\n                                </a>\\n                                <a t-attf-class=\\"#{dropdown_item_classes} filter-failed #{'active' if search_failed else ''}\\">\\n                                    <span>Failed only</span>\\n                                    <span t-if=\\"not search_passed_or_failed\\" t-esc=\\"survey_data['count_failed']\\" class=\\"badge rounded-pill text-bg-primary ms-3\\"/>\\n                                </a>\\n                            </div>\\n                        </li>\\n                        <li t-if=\\"search_filters or search_finished or search_passed_or_failed\\" class=\\"my-2\\">\\n                            <span class=\\"o_survey_results_topbar_clear_filters text-primary\\">\\n                                <i class=\\"fa fa-trash me-1\\"/>Remove all filters\\n                            </span>\\n                        </li>\\n                    </ul>\\n                    <ul class=\\"nav o_survey_results_topbar_answer_filters\\">\\n                        <t t-if=\\"search_filters\\">\\n                            <li t-foreach=\\"search_filters\\" t-as=\\"filter_data\\" class=\\"nav-item me-2 my-1\\">\\n                                <span t-attf-class=\\"btn btn-light filter-remove-answer cursor-default\\">\\n                                    <span t-esc=\\"filter_data['question']\\"/> | <span t-esc=\\"filter_data['answer']\\"/>\\n                                    <i class=\\"fa fa-times filter-remove-answer text-primary\\" t-att-data-model-short-key=\\"filter_data['model_short_key']\\" t-att-data-row-id=\\"filter_data['row_id']\\" t-att-data-record-id=\\"filter_data['record_id']\\"/>\\n                                </span>\\n                            </li>\\n                        </t>\\n                    </ul>\\n                </div>\\n            </nav>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: Filter results" t-name="survey.survey_results_filters">\n        <t t-set="search_passed_or_failed" t-value="search_failed or search_passed"/>\n        <div class="question_and_page_data o_survey_result p-0">\n            <nav class="navbar navbar-light rounded p-0">\n                <div t-if="question_and_page_data" class="justify-content-between w-100">\n                    <ul class="nav o_survey_results_topbar_dropdown_filters align-items-center">\n                        <t t-set="dropdown_item_classes" t-translation="off">dropdown-item d-flex align-items-center justify-content-between</t>\n                        <li class="nav-item dropdown me-2 my-1">\n                            <a href="#" role="button" data-bs-toggle="dropdown" t-attf-class="btn btn-outline-primary dropdown-toggle #{'active' if search_finished else ''}">\n                                <span t-if="search_finished">Completed surveys</span>\n                                <span t-else="">All surveys</span>\n                            </a>\n                            <div class="dropdown-menu">\n                                <a t-attf-class="#{dropdown_item_classes} filter-finished-or-not #{'active' if not search_finished else ''}">\n                                    <span>All surveys</span>\n                                    <span t-if="not search_finished" t-esc="survey_data['count_all']" class="badge rounded-pill text-bg-primary ms-3"/>\n                                </a>\n                                <a t-attf-class="#{dropdown_item_classes} filter-finished #{'active' if search_finished else ''}">\n                                    <span>Completed surveys</span>\n                                    <span t-if="not search_finished" t-esc="survey_data['count_finished']" class="badge rounded-pill text-bg-primary ms-3"/>\n                                </a>\n                            </div>\n                        </li>\n                        <li t-if="survey.scoring_type != 'no_scoring'" class="nav-item dropdown me-2 my-1">\n                            <a href="#" role="button" data-bs-toggle="dropdown" t-attf-class="btn btn-outline-primary dropdown-toggle #{'active' if search_passed_or_failed else ''}">\n                                <span t-if="search_failed">Failed only</span>\n                                <span t-elif="search_passed">Passed only</span>\n                                <span t-else="">Passed and Failed</span>\n                            </a>\n                            <div class="dropdown-menu">\n                                <a t-attf-class="#{dropdown_item_classes} filter-passed-and-failed #{'active' if not search_passed_or_failed else ''}">\n                                    <span>Passed and Failed</span>\n                                    <span t-if="not search_passed_or_failed" t-esc="survey_data['count_all']" class="badge rounded-pill text-bg-primary ms-3"/>\n                                </a>\n                                <a t-attf-class="#{dropdown_item_classes} filter-passed #{'active' if search_passed else ''}">\n                                    <span>Passed only</span>\n                                    <span t-if="not search_passed_or_failed" t-esc="survey_data['count_passed']" class="badge rounded-pill text-bg-primary ms-3"/>\n                                </a>\n                                <a t-attf-class="#{dropdown_item_classes} filter-failed #{'active' if search_failed else ''}">\n                                    <span>Failed only</span>\n                                    <span t-if="not search_passed_or_failed" t-esc="survey_data['count_failed']" class="badge rounded-pill text-bg-primary ms-3"/>\n                                </a>\n                            </div>\n                        </li>\n                        <li t-if="search_filters or search_finished or search_passed_or_failed" class="my-2">\n                            <span class="o_survey_results_topbar_clear_filters text-primary">\n                                <i class="fa fa-trash me-1"/>Remove all filters\n                            </span>\n                        </li>\n                    </ul>\n                    <ul class="nav o_survey_results_topbar_answer_filters">\n                        <t t-if="search_filters">\n                            <li t-foreach="search_filters" t-as="filter_data" class="nav-item me-2 my-1">\n                                <span t-attf-class="btn btn-light filter-remove-answer cursor-default">\n                                    <span t-esc="filter_data['question']"/> | <span t-esc="filter_data['answer']"/>\n                                    <i class="fa fa-times filter-remove-answer text-primary" t-att-data-model-short-key="filter_data['model_short_key']" t-att-data-row-id="filter_data['row_id']" t-att-data-record-id="filter_data['record_id']"/>\n                                </span>\n                            </li>\n                        </t>\n                    </ul>\n                </div>\n            </nav>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
945	16	\N	1	1	Survey: Navigation	\N	survey.survey_navigation	qweb	survey/views/survey_templates_management.xml	primary	{"en_US": "<t name=\\"Survey: Navigation\\" t-name=\\"survey.survey_navigation\\">\\n        <div class=\\"d-inline-block\\">\\n            <button t-if=\\"survey and survey.users_can_go_back\\" t-att-disabled=\\"not can_go_back\\" type=\\"submit\\" class=\\"btn border-0 p-0 shadow-none o_survey_navigation_submit\\" name=\\"button_submit\\" value=\\"previous\\" t-att-data-previous-page-id=\\"previous_page_id\\">\\n                <i class=\\"oi oi-chevron-left p-2\\"/>\\n            </button>\\n            <t t-set=\\"can_go_forward\\" t-value=\\"survey and survey.questions_layout in ['page_per_question', 'page_per_section'] and answer and answer.state != 'done' and not answer.is_session_answer\\"/>\\n            <button t-att-disabled=\\"not can_go_forward\\" type=\\"submit\\" class=\\"btn border-0 p-0 shadow-none o_survey_navigation_submit\\" t-att-value=\\"'next' if not survey_last else 'finish'\\">\\n                <t t-if=\\"survey_last\\">Submit</t>\\n                <i class=\\"oi oi-chevron-right p-2\\"/>\\n            </button>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: Navigation" t-name="survey.survey_navigation">\n        <div class="d-inline-block">\n            <button t-if="survey and survey.users_can_go_back" t-att-disabled="not can_go_back" type="submit" class="btn border-0 p-0 shadow-none o_survey_navigation_submit" name="button_submit" value="previous" t-att-data-previous-page-id="previous_page_id">\n                <i class="oi oi-chevron-left p-2"/>\n            </button>\n            <t t-set="can_go_forward" t-value="survey and survey.questions_layout in ['page_per_question', 'page_per_section'] and answer and answer.state != 'done' and not answer.is_session_answer"/>\n            <button t-att-disabled="not can_go_forward" type="submit" class="btn border-0 p-0 shadow-none o_survey_navigation_submit" t-att-value="'next' if not survey_last else 'finish'">\n                <t t-if="survey_last">Submit</t>\n                <i class="oi oi-chevron-right p-2"/>\n            </button>\n        </div>\n    </t>\n\n	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
946	16	\N	1	1	Survey: print page	\N	survey.survey_page_print	qweb	survey/views/survey_templates_print.xml	primary	{"en_US": "<t name=\\"Survey: print page\\" t-name=\\"survey.survey_page_print\\">\\n        <t t-call=\\"survey.layout\\">\\n            <t t-set=\\"survey_form_readonly\\" t-value=\\"true\\"/>\\n            <t t-if=\\"answer.test_entry\\" t-call=\\"survey.survey_button_form_view\\"/>\\n            <div class=\\"wrap\\">\\n                <div class=\\"o_survey_print o_container_small\\">\\n                    <div class=\\"pt-5 mt32\\">\\n                        <h1><span t-field=\\"survey.title\\" class=\\"text-break\\"/></h1>\\n                        <t t-if=\\"survey.description\\"><div t-field=\\"survey.description\\" class=\\"oe_no_empty text-break\\"/></t>\\n                        <div class=\\"d-flex gap-2\\">\\n                            <t t-if=\\"review\\" t-call=\\"survey.survey_button_retake\\"/>\\n                            <p><a role=\\"button\\" title=\\"Print Results\\" class=\\"btn btn-secondary btn-lg d-print-none o_survey_user_results_print\\">\\n                                <i class=\\"fa fa-print\\"/>\\n                            </a></p>\\n                        </div>\\n                    </div>\\n                    <div t-if=\\"graph_data\\" class=\\"o_survey_result px-4\\">\\n                        <div class=\\"survey_graph mb-4\\" data-graph-type=\\"doughnut\\" t-att-data-graph-data=\\"graph_data\\">\\n                            <canvas id=\\"doughnut_chart\\" class=\\"w-100 h-auto mx-auto\\"/>\\n                        </div>\\n                        <div t-if=\\"survey.page_ids\\" class=\\"survey_graph d-none d-md-block\\" data-graph-type=\\"by_section\\" t-att-data-graph-data=\\"graph_data\\">\\n                            <canvas id=\\"by_section_chart\\" class=\\"w-100 h-auto mx-auto\\"/>\\n                        </div>\\n                    </div>\\n                    <div class=\\"mt-5\\">\\n                        <fieldset disabled=\\"disabled\\">\\n                            <t t-set=\\"question\\" t-value=\\"False\\"/>\\n                            <t t-foreach=\\"survey.question_and_page_ids\\" t-as=\\"question\\">\\n                                <t t-if=\\"question.is_page and                                             (any(q in questions_to_display for q in question.question_ids)                                             or not is_html_empty(question.description))\\">\\n                                    <hr t-if=\\"question != survey.page_ids[0]\\" class=\\"my-5\\"/>\\n                                    <div class=\\"o_page_header mb-5\\">\\n                                        <h1 t-field=\\"question.title\\" class=\\"text-break fs-2\\"/>\\n                                        <div t-if=\\"question.description\\" t-field=\\"question.description\\" class=\\"oe_no_empty\\"/>\\n                                    </div>\\n                                </t>\\n                                <t t-if=\\"not question.is_page and not answer or (question in answer.predefined_question_ids &amp; questions_to_display)\\">\\n                                    <t t-set=\\"answer_lines\\" t-value=\\"answer.user_input_line_ids.filtered(lambda line: line.question_id == question)\\"/>\\n                                    <div class=\\"js_question-wrapper\\" t-att-id=\\"question.id\\">\\n                                        <h2 class=\\"fs-4\\">\\n                                            <span t-field=\\"question.title\\" class=\\"text-break\\"/>\\n                                            <span t-if=\\"question.constr_mandatory\\" class=\\"text-danger\\">*</span>\\n                                            <span t-if=\\"scoring_display_correction\\" class=\\"badge rounded-pill\\" t-att-data-score-question=\\"question.id\\"/>\\n                                        </h2>\\n                                        <div class=\\"text-muted oe_no_empty mt-1 text-break\\" t-if=\\"not is_html_empty(question.description)\\" t-field=\\"question.description\\"/>\\n                                        <t t-if=\\"question.question_type in ['numerical_box', 'date', 'datetime', 'text_box', 'char_box']\\">\\n                                            <t t-if=\\"answer_lines\\">\\n                                                <t t-set=\\"answer_line\\" t-value=\\"answer_lines[0]\\"/>\\n                                                <t t-if=\\"answer_line.skipped\\">\\n                                                    <!-- question was skipped, display an orange block with the text \\"Skipped\\" in place of the answer -->\\n                                                    <div class=\\"row g-0\\">\\n                                                        <div class=\\"col-12 col-md-6 col-lg-4 rounded ps-4 o_survey_question_skipped\\">\\n                                                            <input type=\\"text\\" t-attf-class=\\"form-control fst-italic o_survey_question_{{question.question_type}} bg-transparent rounded-0 p-0\\" value=\\"Skipped\\"/>\\n                                                        </div>\\n                                                    </div>\\n                                                </t>\\n                                                <t t-elif=\\"answer_line.survey_id.scoring_type != 'no_scoring' and question.question_type in ['numerical_box', 'date', 'datetime'] and question['answer_%s' % question.question_type]\\">\\n                                                    <div class=\\"row g-0\\">\\n                                                        <div t-attf-class=\\"col-12 col-md-6 col-lg-4 rounded ps-4 #{'bg-success' if answer_line.answer_is_correct else 'bg-danger'}\\">\\n                                                            <t t-if=\\"question.question_type == 'numerical_box'\\" t-call=\\"survey.question_numerical_box\\"/>\\n                                                            <t t-if=\\"question.question_type == 'date'\\" t-call=\\"survey.question_date\\"/>\\n                                                            <t t-if=\\"question.question_type == 'datetime'\\" t-call=\\"survey.question_datetime\\"/>\\n                                                        </div>\\n                                                    </div>\\n                                                </t>\\n                                                <t t-else=\\"\\">\\n                                                    <t t-if=\\"question.question_type == 'text_box'\\" t-call=\\"survey.question_text_box\\"/>\\n                                                    <t t-if=\\"question.question_type == 'char_box'\\" class=\\"o_survey_print o_survey_comment_container p-0\\">\\n                                                        <span t-out=\\"answer_lines[0].value_char_box or None\\"/>\\n                                                    </t>\\n                                                    <t t-if=\\"question.question_type == 'numerical_box'\\" t-call=\\"survey.question_numerical_box\\"/>\\n                                                    <t t-if=\\"question.question_type == 'date'\\" t-call=\\"survey.question_date\\"/>\\n                                                    <t t-if=\\"question.question_type == 'datetime'\\" t-call=\\"survey.question_datetime\\"/>\\n                                                </t>\\n                                                <t t-if=\\"answer_lines.survey_id.scoring_type != 'no_scoring'                                                     and question.question_type in ['numerical_box', 'date', 'datetime']                                                     and question['answer_%s' % question.question_type]                                                     and not answer_line.answer_is_correct\\">\\n                                                    <div class=\\"row g-0\\">\\n                                                        <t t-set=\\"correct_answer\\" t-value=\\"question['answer_%s' % question.question_type ]\\"/>\\n                                                        <div class=\\"col-12 text-success mt-1\\">\\n                                                            The correct answer was:\\n                                                            <strong t-esc=\\"correct_answer\\" t-if=\\"question.question_type == 'numerical_box'\\"/>\\n                                                            <strong t-esc=\\"format_date(correct_answer)\\" t-if=\\"question.question_type == 'date'\\"/>\\n                                                            <strong t-esc=\\"format_datetime(correct_answer)\\" t-if=\\"question.question_type == 'datetime'\\"/>\\n                                                        </div>\\n                                                    </div>\\n                                                </t>\\n                                            </t>\\n                                            <t t-else=\\"\\">\\n                                                <t t-if=\\"question.question_type == 'text_box'\\" t-call=\\"survey.question_text_box\\"/>\\n                                                <t t-if=\\"question.question_type == 'char_box'\\" t-call=\\"survey.question_char_box\\"/>\\n                                                <t t-if=\\"question.question_type == 'numerical_box'\\" t-call=\\"survey.question_numerical_box\\"/>\\n                                                <t t-if=\\"question.question_type == 'date'\\" t-call=\\"survey.question_date\\"/>\\n                                                <t t-if=\\"question.question_type == 'datetime'\\" t-call=\\"survey.question_datetime\\"/>\\n                                            </t>\\n                                        </t>\\n                                        <t t-if=\\"question.question_type == 'simple_choice'\\" t-call=\\"survey.question_simple_choice\\"/>\\n                                        <t t-if=\\"question.question_type == 'scale'\\" t-call=\\"survey.question_scale\\"/>\\n                                        <t t-if=\\"question.question_type == 'multiple_choice'\\" t-call=\\"survey.question_multiple_choice\\"/>\\n                                        <t t-if=\\"question.question_type == 'matrix'\\" t-call=\\"survey.question_matrix\\"/>\\n                                        <t t-if=\\"question.question_type in ['simple_choice', 'multiple_choice', 'matrix', 'scale']\\">\\n                                            <t t-if=\\"answer_lines\\">\\n                                                <t t-if=\\"answer_lines[0].skipped\\">\\n                                                    <div class=\\"row g-0\\">\\n                                                        <div class=\\"col-12 o_survey_choice_question_skipped mt-1\\">\\n                                                            This question was skipped\\n                                                        </div>\\n                                                    </div>\\n                                                </t>\\n                                            </t>\\n                                        </t>\\n                                        <div class=\\"o_survey_question_error overflow-hidden border-0 py-0 px-3 alert alert-danger\\" role=\\"alert\\"/>\\n                                    </div>\\n                                </t>\\n                            </t>\\n                            <!--Set question to false to avoid background miss match as last question is still in context and is used in survey.layout t-call.-->\\n                            <t t-set=\\"question\\" t-value=\\"False\\"/>\\n                        </fieldset>\\n                    </div>\\n                </div>\\n            </div>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: print page" t-name="survey.survey_page_print">\n        <t t-call="survey.layout">\n            <t t-set="survey_form_readonly" t-value="true"/>\n            <t t-if="answer.test_entry" t-call="survey.survey_button_form_view"/>\n            <div class="wrap">\n                <div class="o_survey_print o_container_small">\n                    <div class="pt-5 mt32">\n                        <h1><span t-field="survey.title" class="text-break"/></h1>\n                        <t t-if="survey.description"><div t-field="survey.description" class="oe_no_empty text-break"/></t>\n                        <div class="d-flex gap-2">\n                            <t t-if="review" t-call="survey.survey_button_retake"/>\n                            <p><a role="button" title="Print Results" class="btn btn-secondary btn-lg d-print-none o_survey_user_results_print">\n                                <i class="fa fa-print"/>\n                            </a></p>\n                        </div>\n                    </div>\n                    <div t-if="graph_data" class="o_survey_result px-4">\n                        <div class="survey_graph mb-4" data-graph-type="doughnut" t-att-data-graph-data="graph_data">\n                            <canvas id="doughnut_chart" class="w-100 h-auto mx-auto"/>\n                        </div>\n                        <div t-if="survey.page_ids" class="survey_graph d-none d-md-block" data-graph-type="by_section" t-att-data-graph-data="graph_data">\n                            <canvas id="by_section_chart" class="w-100 h-auto mx-auto"/>\n                        </div>\n                    </div>\n                    <div class="mt-5">\n                        <fieldset disabled="disabled">\n                            <t t-set="question" t-value="False"/>\n                            <t t-foreach="survey.question_and_page_ids" t-as="question">\n                                <t t-if="question.is_page and                                             (any(q in questions_to_display for q in question.question_ids)                                             or not is_html_empty(question.description))">\n                                    <hr t-if="question != survey.page_ids[0]" class="my-5"/>\n                                    <div class="o_page_header mb-5">\n                                        <h1 t-field="question.title" class="text-break fs-2"/>\n                                        <div t-if="question.description" t-field="question.description" class="oe_no_empty"/>\n                                    </div>\n                                </t>\n                                <t t-if="not question.is_page and not answer or (question in answer.predefined_question_ids &amp; questions_to_display)">\n                                    <t t-set="answer_lines" t-value="answer.user_input_line_ids.filtered(lambda line: line.question_id == question)"/>\n                                    <div class="js_question-wrapper" t-att-id="question.id">\n                                        <h2 class="fs-4">\n                                            <span t-field="question.title" class="text-break"/>\n                                            <span t-if="question.constr_mandatory" class="text-danger">*</span>\n                                            <span t-if="scoring_display_correction" class="badge rounded-pill" t-att-data-score-question="question.id"/>\n                                        </h2>\n                                        <div class="text-muted oe_no_empty mt-1 text-break" t-if="not is_html_empty(question.description)" t-field="question.description"/>\n                                        <t t-if="question.question_type in ['numerical_box', 'date', 'datetime', 'text_box', 'char_box']">\n                                            <t t-if="answer_lines">\n                                                <t t-set="answer_line" t-value="answer_lines[0]"/>\n                                                <t t-if="answer_line.skipped">\n                                                    <!-- question was skipped, display an orange block with the text "Skipped" in place of the answer -->\n                                                    <div class="row g-0">\n                                                        <div class="col-12 col-md-6 col-lg-4 rounded ps-4 o_survey_question_skipped">\n                                                            <input type="text" t-attf-class="form-control fst-italic o_survey_question_{{question.question_type}} bg-transparent rounded-0 p-0" value="Skipped"/>\n                                                        </div>\n                                                    </div>\n                                                </t>\n                                                <t t-elif="answer_line.survey_id.scoring_type != 'no_scoring' and question.question_type in ['numerical_box', 'date', 'datetime'] and question['answer_%s' % question.question_type]">\n                                                    <div class="row g-0">\n                                                        <div t-attf-class="col-12 col-md-6 col-lg-4 rounded ps-4 #{'bg-success' if answer_line.answer_is_correct else 'bg-danger'}">\n                                                            <t t-if="question.question_type == 'numerical_box'" t-call="survey.question_numerical_box"/>\n                                                            <t t-if="question.question_type == 'date'" t-call="survey.question_date"/>\n                                                            <t t-if="question.question_type == 'datetime'" t-call="survey.question_datetime"/>\n                                                        </div>\n                                                    </div>\n                                                </t>\n                                                <t t-else="">\n                                                    <t t-if="question.question_type == 'text_box'" t-call="survey.question_text_box"/>\n                                                    <t t-if="question.question_type == 'char_box'" class="o_survey_print o_survey_comment_container p-0">\n                                                        <span t-out="answer_lines[0].value_char_box or None"/>\n                                                    </t>\n                                                    <t t-if="question.question_type == 'numerical_box'" t-call="survey.question_numerical_box"/>\n                                                    <t t-if="question.question_type == 'date'" t-call="survey.question_date"/>\n                                                    <t t-if="question.question_type == 'datetime'" t-call="survey.question_datetime"/>\n                                                </t>\n                                                <t t-if="answer_lines.survey_id.scoring_type != 'no_scoring'                                                     and question.question_type in ['numerical_box', 'date', 'datetime']                                                     and question['answer_%s' % question.question_type]                                                     and not answer_line.answer_is_correct">\n                                                    <div class="row g-0">\n                                                        <t t-set="correct_answer" t-value="question['answer_%s' % question.question_type ]"/>\n                                                        <div class="col-12 text-success mt-1">\n                                                            The correct answer was:\n                                                            <strong t-esc="correct_answer" t-if="question.question_type == 'numerical_box'"/>\n                                                            <strong t-esc="format_date(correct_answer)" t-if="question.question_type == 'date'"/>\n                                                            <strong t-esc="format_datetime(correct_answer)" t-if="question.question_type == 'datetime'"/>\n                                                        </div>\n                                                    </div>\n                                                </t>\n                                            </t>\n                                            <t t-else="">\n                                                <t t-if="question.question_type == 'text_box'" t-call="survey.question_text_box"/>\n                                                <t t-if="question.question_type == 'char_box'" t-call="survey.question_char_box"/>\n                                                <t t-if="question.question_type == 'numerical_box'" t-call="survey.question_numerical_box"/>\n                                                <t t-if="question.question_type == 'date'" t-call="survey.question_date"/>\n                                                <t t-if="question.question_type == 'datetime'" t-call="survey.question_datetime"/>\n                                            </t>\n                                        </t>\n                                        <t t-if="question.question_type == 'simple_choice'" t-call="survey.question_simple_choice"/>\n                                        <t t-if="question.question_type == 'scale'" t-call="survey.question_scale"/>\n                                        <t t-if="question.question_type == 'multiple_choice'" t-call="survey.question_multiple_choice"/>\n                                        <t t-if="question.question_type == 'matrix'" t-call="survey.question_matrix"/>\n                                        <t t-if="question.question_type in ['simple_choice', 'multiple_choice', 'matrix', 'scale']">\n                                            <t t-if="answer_lines">\n                                                <t t-if="answer_lines[0].skipped">\n                                                    <div class="row g-0">\n                                                        <div class="col-12 o_survey_choice_question_skipped mt-1">\n                                                            This question was skipped\n                                                        </div>\n                                                    </div>\n                                                </t>\n                                            </t>\n                                        </t>\n                                        <div class="o_survey_question_error overflow-hidden border-0 py-0 px-3 alert alert-danger" role="alert"/>\n                                    </div>\n                                </t>\n                            </t>\n                            <!--Set question to false to avoid background miss match as last question is still in context and is used in survey.layout t-call.-->\n                            <t t-set="question" t-value="False"/>\n                        </fieldset>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
