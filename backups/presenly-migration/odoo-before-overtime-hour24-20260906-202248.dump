ny-country-code="res_company.country_id.code" t-att-data-submit-url="'/my/address/submit'">\n                                <div name="address_details" class="row">\n                                    <t t-call="portal.address_form_fields"/>\n                                </div>\n                                <t t-call="portal.address_footer"/>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
