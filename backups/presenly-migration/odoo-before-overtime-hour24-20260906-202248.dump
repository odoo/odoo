1041	16	\N	1	1	unsubscribe_form	\N	mass_mailing.unsubscribe_form	qweb	mass_mailing/views/mailing_templates_portal_unsubscribe.xml	primary	{"en_US": "<t t-name=\\"mass_mailing.unsubscribe_form\\">\\n        <div id=\\"o_mailing_portal_subscription\\" class=\\"container o_mailing_portal_body\\" t-att-data-blocklist-enabled=\\"blocklist_enabled\\" t-att-data-blocklist-possible=\\"blocklist_possible\\" t-att-data-document-id=\\"document_id\\" t-att-data-feedback-enabled=\\"feedback_enabled\\" t-att-data-feedback-readonly=\\"feedback_readonly\\" t-att-data-hash-token=\\"hash_token\\" t-att-data-last-action=\\"last_action\\" t-att-data-email=\\"email\\" t-att-data-email-valid=\\"email_valid\\" t-att-data-is-blocklisted=\\"is_blocklisted\\" t-att-data-mailing-id=\\"mailing_id\\">\\n            <div class=\\"row\\">\\n                <div class=\\"col-lg-6 offset-lg-3 mt-4\\">\\n                    <div id=\\"o_mailing_subscription_form\\">\\n                        <form action=\\"/mailing/list/update\\" method=\\"POST\\">\\n                            <h1 class=\\"o_page_header\\">Mailing Subscriptions</h1>\\n\\n                            <div id=\\"o_mailing_subscription_form_blocklisted\\" t-att-class=\\"'' if is_blocklisted else 'd-none'\\">\\n                                <p>\\n                                    Your email is currently <strong>in our block list</strong>.\\n                                    <t t-if=\\"lists_optin\\">\\n                                        You will not receive any news from those mailing lists you are a member of:\\n                                    </t>\\n                                    <t t-else=\\"\\">\\n                                        You will not hear from us anymore.\\n                                    </t>\\n                                </p>\\n                                <ul class=\\"list-group mb-4\\" t-if=\\"lists_optin\\">\\n                                    <t t-foreach=\\"lists_optin\\" t-as=\\"mailing_list\\">\\n                                        <li class=\\"list-group-item d-flex align-items-center\\">\\n                                            <strong>\\n                                                <t t-if=\\"mailing_list.is_public\\" t-esc=\\"mailing_list.name\\"/>\\n                                                <t t-else=\\"\\">Mailing List #<t t-esc=\\"mailing_list.id\\"/></t>\\n                                            </strong>\\n                                        </li>\\n                                    </t>\\n                                </ul>\\n                            </div>\\n\\n                            <div id=\\"o_mailing_subscription_form_manage\\" t-att-class=\\"'d-none' if is_blocklisted else ''\\">\\n                                <p t-if=\\"lists_optin + lists_optout\\">\\n                                    Choose your mailing subscriptions\\n                                </p>\\n                                <ul id=\\"o_mailing_subscription_form_lists\\" t-if=\\"lists_optin + lists_optout\\" class=\\"list-group\\">\\n                                    <li t-foreach=\\"(lists_optin + lists_optout)\\" t-as=\\"mailing_list\\" class=\\"list-group-item d-flex align-items-center\\" t-if=\\"mailing_list not in lists_optout or mailing_list.is_public\\">\\n                                        <t t-set=\\"title\\" t-value=\\"mailing_list.name\\"/>\\n                                        <input type=\\"checkbox\\" name=\\"mailing_list_ids\\" t-att-data-member=\\"1\\" t-att-disabled=\\"'disabled' if is_blocklisted else None\\" t-att-value=\\"mailing_list.id\\" t-att-checked=\\"None if mailing_list in lists_optout else 'checked'\\" t-att-title=\\"title\\"/>\\n                                        <span class=\\"ms-1\\" t-out=\\"title\\"/>\\n                                        <span class=\\"o_mailing_list_unsubscribed ms-auto\\">\\n                                            <t t-if=\\"mailing_list in lists_optout\\">\\n                                                Not subscribed\\n                                            </t>\\n                                            <t t-else=\\"\\">\\n                                                Subscribed\\n                                            </t>\\n                                        </span>\\n                                    </li>\\n                                </ul>\\n                                <p t-if=\\"lists_public\\">\\n                                    You may also be interested in\\n                                </p>\\n                                <ul id=\\"o_mailing_subscription_form_lists_additional\\" t-if=\\"lists_public\\" class=\\"list-group\\">\\n                                    <li t-foreach=\\"lists_public\\" t-as=\\"mailing_list\\" class=\\"list-group-item\\">\\n                                        <input type=\\"checkbox\\" name=\\"mailing_list_ids\\" t-att-disabled=\\"'disabled' if is_blocklisted else None\\" t-att-value=\\"mailing_list.id\\" t-att-title=\\"mailing_list.name\\"/>\\n                                        <span class=\\"ms-1\\" t-out=\\"mailing_list.name\\"/>\\n                                    </li>\\n                                </ul>\\n                                <p t-if=\\"not lists_optin and not lists_optout and not lists_public\\">\\n                                    You are not subscribed to any of our mailing list.\\n                                </p>\\n                            </div>\\n                            <div id=\\"o_mailing_subscription_blocklist\\" class=\\"d-flex align-items-center mb-4 pt-3\\">\\n                                <button type=\\"submit\\" id=\\"button_form_send\\" t-att-disabled=\\"'disabled' if is_blocklisted else None\\" t-att-class=\\"'btn btn-primary ' + ('' if lists_optin or lists_optout or lists_public else 'd-none')\\">\\n                                    Apply changes\\n                                </button>\\n                                <div class=\\"btn btn-link me-2 text-uppercase d-none\\" t-if=\\"blocklist_enabled and blocklist_possible\\" id=\\"button_blocklist_add\\">Exclude Me</div>\\n                                <div class=\\"btn btn-link text-uppercase d-none\\" id=\\"button_blocklist_remove\\">Come Back</div>\\n                                <div id=\\"o_mailing_subscription_update_info\\" class=\\"d-none\\"/>\\n                            </div>\\n                        </form>\\n                    </div>\\n\\n                    <div id=\\"o_mailing_subscription_info\\" class=\\"mb-4\\" role=\\"status\\">\\n                        <t t-if=\\"unsubscribed_name\\">\\n                            <h1 class=\\"o_page_header\\">Successfully Unsubscribed</h1>\\n                            <span t-out=\\"unsubscribed_name\\"/>\\n                        </t>\\n                        <div id=\\"o_mailing_subscription_feedback\\" t-att-class=\\"'' if feedback_enabled else 'd-none'\\">\\n                            <form action=\\"/mail/mailing/feedback\\" method=\\"POST\\" class=\\"mt-3\\">\\n                                <p>\\n                                    Please let us know why you updated your subscription.\\n                                </p>\\n                                <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                                <fieldset>\\n                                    <div class=\\"form-check\\" t-foreach=\\"opt_out_reasons\\" t-as=\\"opt_out_reason\\">\\n                                        <input class=\\"form-check-input o_mailing_subscription_opt_out_reason\\" type=\\"radio\\" name=\\"opt_out_reason_id\\" t-att-id=\\"'opt_out_reason_id' + str(opt_out_reason.id)\\" t-att-data-is-feedback=\\"opt_out_reason.is_feedback\\" t-att-value=\\"opt_out_reason.id\\"/>\\n                                        <label class=\\"form-check-label\\" t-att-for=\\"'opt_out_reason_id' + str(opt_out_reason.id)\\" t-out=\\"opt_out_reason.name\\"/>\\n                                    </div>\\n                                </fieldset>\\n                                <textarea class=\\"form-control d-none\\" name=\\"feedback\\" cols=\\"60\\" rows=\\"3\\"/>\\n                                <div class=\\"d-flex align-items-center mt-2\\">\\n                                    <button type=\\"submit\\" id=\\"button_feedback\\" class=\\"btn btn-primary text-start me-2\\">Send</button>\\n                                    <div id=\\"o_mailing_subscription_feedback_info\\" class=\\"d-none\\"/>\\n                                </div>\\n                            </form>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n            <div id=\\"o_mailing_portal_subscription_editor\\" class=\\"oe_structure oe_empty\\"/>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="mass_mailing.unsubscribe_form">\n        <div id="o_mailing_portal_subscription" class="container o_mailing_portal_body" t-att-data-blocklist-enabled="blocklist_enabled" t-att-data-blocklist-possible="blocklist_possible" t-att-data-document-id="document_id" t-att-data-feedback-enabled="feedback_enabled" t-att-data-feedback-readonly="feedback_readonly" t-att-data-hash-token="hash_token" t-att-data-last-action="last_action" t-att-data-email="email" t-att-data-email-valid="email_valid" t-att-data-is-blocklisted="is_blocklisted" t-att-data-mailing-id="mailing_id">\n            <div class="row">\n                <div class="col-lg-6 offset-lg-3 mt-4">\n                    <div id="o_mailing_subscription_form">\n                        <form action="/mailing/list/update" method="POST">\n                            <h1 class="o_page_header">Mailing Subscriptions</h1>\n\n                            <div id="o_mailing_subscription_form_blocklisted" t-att-class="'' if is_blocklisted else 'd-none'">\n                                <p>\n                                    Your email is currently <strong>in our block list</strong>.\n                                    <t t-if="lists_optin">\n                                        You will not receive any news from those mailing lists you are a member of:\n                                    </t>\n                                    <t t-else="">\n                                        You will not hear from us anymore.\n                                    </t>\n                                </p>\n                                <ul class="list-group mb-4" t-if="lists_optin">\n                                    <t t-foreach="lists_optin" t-as="mailing_list">\n                                        <li class="list-group-item d-flex align-items-center">\n                                            <strong>\n                                                <t t-if="mailing_list.is_public" t-esc="mailing_list.name"/>\n                                                <t t-else="">Mailing List #<t t-esc="mailing_list.id"/></t>\n                                            </strong>\n                                        </li>\n                                    </t>\n                                </ul>\n                            </div>\n\n                            <div id="o_mailing_subscription_form_manage" t-att-class="'d-none' if is_blocklisted else ''">\n                                <p t-if="lists_optin + lists_optout">\n                                    Choose your mailing subscriptions\n                                </p>\n                                <ul id="o_mailing_subscription_form_lists" t-if="lists_optin + lists_optout" class="list-group">\n                                    <li t-foreach="(lists_optin + lists_optout)" t-as="mailing_list" class="list-group-item d-flex align-items-center" t-if="mailing_list not in lists_optout or mailing_list.is_public">\n                                        <t t-set="title" t-value="mailing_list.name"/>\n                                        <input type="checkbox" name="mailing_list_ids" t-att-data-member="1" t-att-disabled="'disabled' if is_blocklisted else None" t-att-value="mailing_list.id" t-att-checked="None if mailing_list in lists_optout else 'checked'" t-att-title="title"/>\n                                        <span class="ms-1" t-out="title"/>\n                                        <span class="o_mailing_list_unsubscribed ms-auto">\n                                            <t t-if="mailing_list in lists_optout">\n                                                Not subscribed\n                                            </t>\n                                            <t t-else="">\n                                                Subscribed\n                                            </t>\n                                        </span>\n                                    </li>\n                                </ul>\n                                <p t-if="lists_public">\n                                    You may also be interested in\n                                </p>\n                                <ul id="o_mailing_subscription_form_lists_additional" t-if="lists_public" class="list-group">\n                                    <li t-foreach="lists_public" t-as="mailing_list" class="list-group-item">\n                                        <input type="checkbox" name="mailing_list_ids" t-att-disabled="'disabled' if is_blocklisted else None" t-att-value="mailing_list.id" t-att-title="mailing_list.name"/>\n                                        <span class="ms-1" t-out="mailing_list.name"/>\n                                    </li>\n                                </ul>\n                                <p t-if="not lists_optin and not lists_optout and not lists_public">\n                                    You are not subscribed to any of our mailing list.\n                                </p>\n                            </div>\n                            <div id="o_mailing_subscription_blocklist" class="d-flex align-items-center mb-4 pt-3">\n                                <button type="submit" id="button_form_send" t-att-disabled="'disabled' if is_blocklisted else None" t-att-class="'btn btn-primary ' + ('' if lists_optin or lists_optout or lists_public else 'd-none')">\n                                    Apply changes\n                                </button>\n                                <div class="btn btn-link me-2 text-uppercase d-none" t-if="blocklist_enabled and blocklist_possible" id="button_blocklist_add">Exclude Me</div>\n                                <div class="btn btn-link text-uppercase d-none" id="button_blocklist_remove">Come Back</div>\n                                <div id="o_mailing_subscription_update_info" class="d-none"/>\n                            </div>\n                        </form>\n                    </div>\n\n                    <div id="o_mailing_subscription_info" class="mb-4" role="status">\n                        <t t-if="unsubscribed_name">\n                            <h1 class="o_page_header">Successfully Unsubscribed</h1>\n                            <span t-out="unsubscribed_name"/>\n                        </t>\n                        <div id="o_mailing_subscription_feedback" t-att-class="'' if feedback_enabled else 'd-none'">\n                            <form action="/mail/mailing/feedback" method="POST" class="mt-3">\n                                <p>\n                                    Please let us know why you updated your subscription.\n                                </p>\n                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                                <fieldset>\n                                    <div class="form-check" t-foreach="opt_out_reasons" t-as="opt_out_reason">\n                                        <input class="form-check-input o_mailing_subscription_opt_out_reason" type="radio" name="opt_out_reason_id" t-att-id="'opt_out_reason_id' + str(opt_out_reason.id)" t-att-data-is-feedback="opt_out_reason.is_feedback" t-att-value="opt_out_reason.id"/>\n                                        <label class="form-check-label" t-att-for="'opt_out_reason_id' + str(opt_out_reason.id)" t-out="opt_out_reason.name"/>\n                                    </div>\n                                </fieldset>\n                                <textarea class="form-control d-none" name="feedback" cols="60" rows="3"/>\n                                <div class="d-flex align-items-center mt-2">\n                                    <button type="submit" id="button_feedback" class="btn btn-primary text-start me-2">Send</button>\n                                    <div id="o_mailing_subscription_feedback_info" class="d-none"/>\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div id="o_mailing_portal_subscription_editor" class="oe_structure oe_empty"/>\n        </div>\n    </t>\n	f	t	2026-09-05 15:59:52.12261	2026-09-05 15:59:52.12261	f
