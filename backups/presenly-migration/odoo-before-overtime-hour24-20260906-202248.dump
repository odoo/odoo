973	16	\N	1	1	mass_mailing_mail_layout	\N	mass_mailing.mass_mailing_mail_layout	qweb	mass_mailing/data/mailing_data_templates.xml	primary	{"en_US": "<t t-name=\\"mass_mailing.mass_mailing_mail_layout\\">\\n        &lt;!DOCTYPE html&gt;\\n        <html xmlns=\\"http://www.w3.org/1999/xhtml\\" xmlns:v=\\"urn:schemas-microsoft-com:vml\\" xmlns:o=\\"urn:schemas-microsoft-com:office:office\\">\\n            <head>\\n                <meta http-equiv=\\"Content-Type\\" content=\\"text/html; charset=UTF-8\\"/>\\n                <meta name=\\"format-detection\\" content=\\"telephone=no\\"/>\\n                <meta name=\\"viewport\\" content=\\"width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=no;\\"/>\\n                <meta http-equiv=\\"X-UA-Compatible\\" content=\\"IE=9; IE=8; IE=7; IE=EDGE\\"/>\\n\\n                <t t-out=\\"mailing_style\\"/>\\n\\n                <!--\\n                    Prevent Outlook from distorting images with DPI scaling (see\\n                    https://www.htmlemailcheck.com/knowledge-base/dpi-scaling-in-outlook-2007-2013/):\\n                -->\\n                <!--[if mso]>\\n                    <xml>\\n                        <o:OfficeDocumentSettings>\\n                            <o:AllowPNG/>\\n                            <o:PixelsPerInch>96</o:PixelsPerInch>\\n                        </o:OfficeDocumentSettings>\\n                    </xml>\\n                <![endif]-->\\n            </head>\\n            <body>\\n                <t t-out=\\"body\\"/>\\n            </body>\\n        </html>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="mass_mailing.mass_mailing_mail_layout">\n        &lt;!DOCTYPE html&gt;\n        <html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">\n            <head>\n                <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>\n                <meta name="format-detection" content="telephone=no"/>\n                <meta name="viewport" content="width=device-width; initial-scale=1.0; maximum-scale=1.0; user-scalable=no;"/>\n                <meta http-equiv="X-UA-Compatible" content="IE=9; IE=8; IE=7; IE=EDGE"/>\n\n                <t t-out="mailing_style"/>\n\n                <!--\n                    Prevent Outlook from distorting images with DPI scaling (see\n                    https://www.htmlemailcheck.com/knowledge-base/dpi-scaling-in-outlook-2007-2013/):\n                -->\n                <!--[if mso]>\n                    <xml>\n                        <o:OfficeDocumentSettings>\n                            <o:AllowPNG/>\n                            <o:PixelsPerInch>96</o:PixelsPerInch>\n                        </o:OfficeDocumentSettings>\n                    </xml>\n                <![endif]-->\n            </head>\n            <body>\n                <t t-out="body"/>\n            </body>\n        </html>\n    </t>\n	f	t	2026-09-05 15:59:52.12261	2026-09-05 15:59:52.12261	f
974	16	\N	1	1	Mass Mailing: A/B Test Description	\N	mass_mailing.ab_testing_description	qweb	mass_mailing/data/mailing_data_templates.xml	primary	{"en_US": "<t name=\\"Mass Mailing: A/B Test Description\\" t-name=\\"mass_mailing.ab_testing_description\\">\\n        <div name=\\"ab_testing_description\\" class=\\"mb-2\\">\\n            <t t-if=\\"mailing.state == 'done' and mailing.sent == 0 and mailing.failed == 0 and mailing.canceled == 0\\">\\n                <span>There wasn't enough recipients left for this mailing</span>\\n            </t>\\n            <t t-if=\\"mailing.ab_testing_completed\\">\\n                <p t-if=\\"mailing.ab_testing_is_winner_mailing\\">\\n                    This <t t-out=\\"mailing.mailing_type_description\\"/> is the winner of the A/B testing campaign and has been sent to all remaining recipients.\\n                </p>\\n                <p t-else=\\"\\">The winner has already been sent. Use <b>Compare Version</b> to get an overview of this A/B testing campaign.</p>\\n            </t>\\n            <t t-elif=\\"ab_testing_count &gt;= 2\\">\\n                <p>\\n                    A sample of <b><t t-out=\\"mailing.ab_testing_pc\\"/>% of recipients</b> will receive this version.<br/>\\n                    <t t-if=\\"total_ab_testing_pc &gt; 100 and mailing.active\\">\\n                        <i class=\\"fa fa-exclamation-triangle text-danger\\" aria-hidden=\\"true\\"/>\\n                        The sum of all percentages for this A/B campaign totals <b class=\\"text-danger\\"><t t-out=\\"total_ab_testing_pc\\"/>%</b> of all potential recipients.<br/>\\n                        <b class=\\"text-danger\\">Some of the mailings will not be sent</b>, as only 1 email will be sent for each unique recipient in this campaign.\\n                    </t>\\n                </p>\\n                <p>\\n\\t\\t    <t t-if=\\"mailing.ab_testing_winner_selection == 'manual'\\">Don't forget to send your preferred version</t>\\n\\t\\t    <t t-elif=\\"not mailing.ab_testing_schedule_datetime\\">Since the date and time for this test has not been scheduled, don't forget to manually send your preferred version.</t>\\n                    <t t-else=\\"\\">\\n                        Then on <b><t t-out=\\"mailing.ab_testing_schedule_datetime.strftime('%b %d, %Y')\\"/></b> the <t t-out=\\"mailing.mailing_type_description\\"/> having the <b><t t-out=\\"ab_testing_winner_selection_description\\"/></b> will be sent\\n                    </t> to the remaining recipients.\\n                </p>\\n            </t>\\n            <t t-else=\\"\\">\\n                <p>\\n                    A sample of <b><t t-out=\\"mailing.ab_testing_pc\\"/>% of recipients</b> will receive this version.\\n                </p>\\n                <t t-if=\\"mailing.ab_testing_winner_selection != 'manual'\\">\\n                    <p>Try different variations in the campaign to compare their <t t-out=\\"ab_testing_winner_selection_description\\"/>.</p>\\n                    <p>Once the best version is identified, we will send the best one to the remaining recipients.</p>\\n                </t>\\n                <p t-else=\\"\\">Use alternative versions to be able to select the winner.</p>\\n            </t>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Mass Mailing: A/B Test Description" t-name="mass_mailing.ab_testing_description">\n        <div name="ab_testing_description" class="mb-2">\n            <t t-if="mailing.state == 'done' and mailing.sent == 0 and mailing.failed == 0 and mailing.canceled == 0">\n                <span>There wasn't enough recipients left for this mailing</span>\n            </t>\n            <t t-if="mailing.ab_testing_completed">\n                <p t-if="mailing.ab_testing_is_winner_mailing">\n                    This <t t-out="mailing.mailing_type_description"/> is the winner of the A/B testing campaign and has been sent to all remaining recipients.\n                </p>\n                <p t-else="">The winner has already been sent. Use <b>Compare Version</b> to get an overview of this A/B testing campaign.</p>\n            </t>\n            <t t-elif="ab_testing_count &gt;= 2">\n                <p>\n                    A sample of <b><t t-out="mailing.ab_testing_pc"/>% of recipients</b> will receive this version.<br/>\n                    <t t-if="total_ab_testing_pc &gt; 100 and mailing.active">\n                        <i class="fa fa-exclamation-triangle text-danger" aria-hidden="true"/>\n                        The sum of all percentages for this A/B campaign totals <b class="text-danger"><t t-out="total_ab_testing_pc"/>%</b> of all potential recipients.<br/>\n                        <b class="text-danger">Some of the mailings will not be sent</b>, as only 1 email will be sent for each unique recipient in this campaign.\n                    </t>\n                </p>\n                <p>\n\t\t    <t t-if="mailing.ab_testing_winner_selection == 'manual'">Don't forget to send your preferred version</t>\n\t\t    <t t-elif="not mailing.ab_testing_schedule_datetime">Since the date and time for this test has not been scheduled, don't forget to manually send your preferred version.</t>\n                    <t t-else="">\n                        Then on <b><t t-out="mailing.ab_testing_schedule_datetime.strftime('%b %d, %Y')"/></b> the <t t-out="mailing.mailing_type_description"/> having the <b><t t-out="ab_testing_winner_selection_description"/></b> will be sent\n                    </t> to the remaining recipients.\n                </p>\n            </t>\n            <t t-else="">\n                <p>\n                    A sample of <b><t t-out="mailing.ab_testing_pc"/>% of recipients</b> will receive this version.\n                </p>\n                <t t-if="mailing.ab_testing_winner_selection != 'manual'">\n                    <p>Try different variations in the campaign to compare their <t t-out="ab_testing_winner_selection_description"/>.</p>\n                    <p>Once the best version is identified, we will send the best one to the remaining recipients.</p>\n                </t>\n                <p t-else="">Use alternative versions to be able to select the winner.</p>\n            </t>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:52.12261	2026-09-05 15:59:52.12261	f
