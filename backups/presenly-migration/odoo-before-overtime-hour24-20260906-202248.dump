n\\" icon=\\"fa-camera\\" invisible=\\"not presenly_evidence_count\\" groups=\\"presenly.group_presenly_hr\\">\\n                        <field name=\\"presenly_evidence_count\\" widget=\\"statinfo\\" string=\\"Evidence\\"/>\\n                    </button>\\n                </div>\\n            </xpath>\\n\\n            <!-- Employee is identity, not an employee self-service selector. -->\\n            <xpath expr=\\"//group[@name='group_employee']\\" position=\\"inside\\">\\n                <field name=\\"presenly_can_change_employee\\" invisible=\\"1\\"/>\\n            </xpath>\\n            <xpath expr=\\"//field[@id='employee_no_officer']\\" position=\\"attributes\\">\\n                <attribute name=\\"options\\">{'no_create': True, 'no_open': True}</attribute>\\n            </xpath>\\n            <xpath expr=\\"//field[@id='employee_no_manager']\\" position=\\"attributes\\">\\n                <attribute name=\\"readonly\\">not presenly_can_change_employee</attribute>\\n                <attribute name=\\"options\\">{'no_create': True, 'no_open': True}</attribute>\\n            </xpath>\\n            <xpath expr=\\"//field[@id='employee_manager']\\" position=\\"attributes\\">\\n                <attribute name=\\"readonly\\">not presenly_can_change_employee</attribute>\\n                <attribute name=\\"options\\">{'no_create': True, 'no_open': True}</attribute>\\n            </xpath>\\n\\n            <!-- Context appears once. Check-in/out timestamps remain only in the\\n                 native summary above; event sections below contain evidence. -->\\n            <xpath expr=\\"//separator[following-sibling::group[@name='check_in_group']][1]\\" position=\\"replace\\">\\n                <separator string=\\"Attendance Context\\"/>\\n                <group name=\\"presenly_attendance_metadata\\" colspan=\\"2\\">\\n                    <group>\\n                        <field name=\\"presenly_attendance_mode\\" readonly=\\"1\\"/>\\n                        <field name=\\"presenly_source\\" readonly=\\"1\\"/>\\n                    </group>\\n                    <group>\\n                        <field name=\\"presenly_company_id\\" readonly=\\"1\\" groups=\\"base.group_multi_company\\"/>\\n                        <field name=\\"presenly_work_location_id\\" readonly=\\"1\\" options=\\"{'no_open': True}\\"/>\\n                    </group>\\n                    <group>\\n                        <field name=\\"presenly_schedule_id\\" readonly=\\"1\\" options=\\"{'no_open': True}\\"/>\\n                    </group>\\n                </group>\\n                <separator string=\\"Check-In Evidence\\"/>\\n            </xpath>\\n            <xpath expr=\\"//separator[@name='check_out_separator']\\" position=\\"attributes\\">\\n                <attribute name=\\"string\\">Check-Out Evidence</attribute>\\n            </xpath>\\n\\n            <xpath expr=\\"//group[@name='check_in_group']\\" position=\\"replace\\">\\n                <group name=\\"check_in_group\\" colspan=\\"2\\">\\n                    <group string=\\"Device and Validation\\">\\n                        <field name=\\"in_mode\\" readonly=\\"1\\"/>\\n                        <field name=\\"in_ip_address\\" readonly=\\"1\\" invisible=\\"presenly_source == 'mobile' or in_mode == 'manual' or not device_tracking_enabled\\"/>\\n                        <field name=\\"in_browser\\" readonly=\\"1\\" invisible=\\"presenly_source == 'mobile' or in_mode == 'manual' or not device_tracking_enabled\\"/>\\n                        <field name=\\"presenly_check_in_distance\\" string=\\"Distance from Work Location (m)\\" readonly=\\"1\\" invisible=\\"presenly_source != 'mobile'\\"/>\\n                        <field name=\\"presenly_check_in_accuracy\\" readonly=\\"1\\" invisible=\\"presenly_source != 'mobile'\\"/>\\n                    </group>\\n                    <group string=\\"Location and Selfie\\" invisible=\\"in_mode == 'manual' or (presenly_source != 'mobile' and not device_tracking_enabled)\\">\\n                        <field name=\\"in_location\\" readonly=\\"1\\" invisible=\\"presenly_source == 'mobile'\\"/>\\n                        <label for=\\"in_latitude\\" string=\\"GPS Coordinates\\"/>\\n                        <div>\\n                            <div class=\\"o_row\\">\\n                                <span><field name=\\"in_latitude\\" readonly=\\"1\\"/></span>,\\n                                <span><field name=\\"in_longitude\\" nolabel=\\"1\\" readonly=\\"1\\"/></span>\\n                            </div>\\n                            <button name=\\"action_in_attendance_maps\\" type=\\"object\\" class=\\"btn btn-link ps-0 pt-0 pb-2\\" icon=\\"oi-arrow-right\\" string=\\"View on Maps\\" invisible=\\"not in_latitude and not in_longitude\\"/>\\n                        </div>\\n                        <field name=\\"presenly_selfie_in_attachment_id\\" widget=\\"presenly_attachment_image_viewer\\" readonly=\\"1\\" nolabel=\\"1\\" invisible=\\"not presenly_selfie_in_attachment_id\\"/>\\n                    </group>\\n                </group>\\n            </xpath>\\n\\n            <xpath expr=\\"//group[@name='check_out_group']\\" position=\\"replace\\">\\n                <group colspan=\\"2\\" name=\\"check_out_group\\" invisible=\\"not check_out\\">\\n                    <group string=\\"Device and Validation\\">\\n                        <field name=\\"out_mode\\" string=\\"Mode\\" readonly=\\"1\\"/>\\n                        <field name=\\"out_ip_address\\" string=\\"IP Address\\" readonly=\\"1\\" invisible=\\"presenly_source == 'mobile' or out_mode == 'manual' or not device_tracking_enabled\\"/>\\n                        <field name=\\"out_browser\\" string=\\"Browser\\" readonly=\\"1\\" invisible=\\"presenly_source == 'mobile' or out_mode == 'manual' or not device_tracking_enabled\\"/>\\n                        <field name=\\"presenly_check_out_distance\\" string=\\"Distance from Work Location (m)\\" readonly=\\"1\\"