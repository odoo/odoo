1253	16	\N	1	1	Tasks List	\N	project.portal_tasks_list	qweb	project/views/project_portal_project_task_templates.xml	primary	{"en_US": "<t name=\\"Tasks List\\" t-name=\\"project.portal_tasks_list\\">\\n        <t t-if=\\"grouped_tasks\\">\\n            <t t-call=\\"portal.portal_table\\">\\n                <thead>\\n                    <tr>\\n                        <!-- Allows overrides in modules -->\\n                        <t t-set=\\"group_by_in_header_list\\" t-value=\\"['priority', 'milestone_id']\\"/>\\n                        <t t-if=\\"multiple_projects\\" t-set=\\"group_by_in_header_list\\" t-value=\\"group_by_in_header_list + ['project_id']\\"/>\\n                        <!-- Computes the right colspan once and use it everywhere -->\\n                        <t t-set=\\"grouped_tasks_colspan\\" t-value=\\"5 if groupby in group_by_in_header_list else 6\\"/>\\n                        <t t-set=\\"grouped_tasks_colspan\\" t-if=\\"not allow_milestone\\" t-value=\\"grouped_tasks_colspan - 1\\"/>\\n                        <t t-set=\\"grouped_tasks_colspan\\" t-if=\\"not multiple_projects\\" t-value=\\"grouped_tasks_colspan - 1\\"/>\\n                        <th t-attf-colspan=\\"{{2 if groupby != 'priority' else 1}}\\"/>\\n                        <th>Name</th>\\n                        <th>Assignees</th>\\n                        <th t-if=\\"groupby != 'project_id' and multiple_projects\\">Project</th>\\n                        <th t-if=\\"groupby != 'milestone_id' and allow_milestone\\" name=\\"project_portal_milestones\\">Milestone</th>\\n                        <th t-if=\\"groupby != 'state'\\"/>\\n                        <th t-if=\\"groupby != 'stage_id'\\" class=\\"text-end\\">Stage</th>\\n                    </tr>\\n                </thead>\\n                <t t-foreach=\\"grouped_tasks\\" t-as=\\"tasks\\">\\n                    <tbody t-if=\\"tasks\\">\\n                        <tr name=\\"grouped_tasks_groupby_columns\\" t-if=\\"groupby != 'none'\\" class=\\"table-light\\">\\n                            <th name=\\"groupby_name_col\\" t-att-colspan=\\"grouped_tasks_colspan\\">\\n                                <t t-if=\\"groupby == 'project_id' and multiple_projects\\">\\n                                    <!-- This div is necessary for documents_project_sale -->\\n                                    <div name=\\"project_name\\" class=\\"d-flex w-100 align-items-center\\">\\n                                        <span t-if=\\"tasks[0].sudo().project_id\\" t-field=\\"tasks[0].sudo().project_id.name\\"/>\\n                                        <span t-else=\\"\\">No Project</span>\\n                                    </div>\\n                                </t>\\n                                <t t-elif=\\"groupby == 'milestone_id'\\">\\n                                    <span t-if=\\"tasks[0].sudo().milestone_id and tasks[0].sudo().allow_milestones\\" class=\\"text-truncate\\" t-field=\\"tasks[0].sudo().milestone_id.name\\"/>\\n                                    <span t-else=\\"\\">No Milestone</span>\\n                                </t>\\n                                <t t-if=\\"groupby == 'stage_id'\\">\\n                                    <!-- This div is necessary for documents_project_sale -->\\n                                    <div name=\\"stage_name\\" class=\\"d-flex w-100 align-items-center\\">\\n                                        <span class=\\"text-truncate\\" t-field=\\"tasks[0].sudo().stage_id.name\\"/>\\n                                    </div>\\n                                </t>\\n                                <t t-if=\\"groupby == 'priority'\\">\\n                                    <span class=\\"text-truncate\\" t-field=\\"tasks[0].sudo().priority\\"/>\\n                                </t>\\n                                <t t-if=\\"groupby == 'state'\\">\\n                                    <span class=\\"text-truncate\\" t-field=\\"tasks[0].sudo().state\\"/>\\n                                </t>\\n                                <t t-if=\\"groupby == 'partner_id'\\">\\n                                    <span t-if=\\"tasks[0].sudo().partner_id\\" class=\\"text-truncate\\" t-field=\\"tasks[0].sudo().partner_id.name\\"/>\\n                                    <span t-else=\\"\\">No Customer</span>\\n                                </t>\\n                            </th>\\n                            <th name=\\"state_col\\" t-if=\\"groupby != 'state'\\"/>\\n                            <th name=\\"stage_id_col\\" t-if=\\"groupby != 'stage_id'\\"/>\\n                        </tr>\\n                    </tbody>\\n                    <tbody t-if=\\"tasks\\">\\n                        <t t-foreach=\\"tasks\\" t-as=\\"task\\">\\n                            <tr>\\n                                <td class=\\"text-start\\">\\n                                    #<span t-esc=\\"task.id\\"/>\\n                                </td>\\n                                <td t-if=\\"groupby != 'priority'\\" class=\\"text-end\\">\\n                                    <t t-call=\\"project.portal_my_tasks_priority_widget_template\\"/>\\n                                </td>\\n                                <td>\\n                                    <a t-attf-href=\\"/my/#{task_url}/#{task.id}?{{ keep_query() }}\\"><span t-att-title=\\"task.name\\" t-field=\\"task.name\\"/></a>\\n                                </td>\\n                                <td>\\n                                    <t t-set=\\"assignees\\" t-value=\\"task.sudo().user_ids\\"/>\\n                                    <div t-if=\\"assignees\\" class=\\"flex-nowrap ps-3\\">\\n                                        <img class=\\"o_avatar rounded\\" t-attf-src=\\"#{image_data_uri(assignees[:1].avatar_128)}\\" alt=\\"User\\"/>\\n                                        <span class=\\"align-middle\\" t-att-title=\\"'\\\\n'.join(assignees.mapped('name'))\\">\\n                                            <span t-field=\\"assignees[:1].name\\"/><span t-if=\\"len(assignees) &gt; 1\\" class=\\"badge ms-1 rounded-pill bg-light\\"> +<span t-out=\\"len(assignees) - 1\\"/></span>\\n                                        </span>\\n                                    </div>\\n                                </td>\\n                                <td t-if=\\"groupby != 'project_id' and multiple_projects\\">\\n                                    <span title=\\"Current project of the task\\" t-out=\\"task.project_id.name\\"/>\\n                                </td>\\n                                <td t-if=\\"groupby != 'milestone_id' and allow_milestone\\" name=\\"project_portal_milestones\\">\\n                                    <t t-if=\\"task.milestone_id and task.allow_milestones\\">\\n                                        <span t-esc=\\"task.milestone_id.name\\"/>\\n                                    </t>\\n                                </td>\\n                                <td t-if=\\"groupby != 'state'\\" align=\\"right\\" class=\\"align-middle\\">\\n                                    <t t-call=\\"project.portal_my_tasks_state_widget_template\\">\\n                                        <t t-set=\\"path\\" t-value=\\"'tasks'\\"/>\\n                                    </t>\\n                                </td>\\n                                <td t-if=\\"groupby != 'stage_id'\\" class=\\"text-end lh-1\\">\\n                                    <t t-call=\\"project.portal_my_tasks_badge_widget_template\\"/>\\n                                </td>\\n                            </tr>\\n                        </t>\\n                    </tbody>\\n                </t>\\n            </t>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Tasks List" t-name="project.portal_tasks_list">\n        <t t-if="grouped_tasks">\n            <t t-call="portal.portal_table">\n                <thead>\n                    <tr>\n                        <!-- Allows overrides in modules -->\n                        <t t-set="group_by_in_header_list" t-value="['priority', 'milestone_id']"/>\n                        <t t-if="multiple_projects" t-set="group_by_in_header_list" t-value="group_by_in_header_list + ['project_id']"/>\n                        <!-- Computes the right colspan once and use it everywhere -->\n                        <t t-set="grouped_tasks_colspan" t-value="5 if groupby in group_by_in_header_list else 6"/>\n                        <t t-set="grouped_tasks_colspan" t-if="not allow_milestone" t-value="grouped_tasks_colspan - 1"/>\n                        <t t-set="grouped_tasks_colspan" t-if="not multiple_projects" t-value="grouped_tasks_colspan - 1"/>\n                        <th t-attf-colspan="{{2 if groupby != 'priority' else 1}}"/>\n                        <th>Name</th>\n                        <th>Assignees</th>\n                        <th t-if="groupby != 'project_id' and multiple_projects">Project</th>\n                        <th t-if="groupby != 'milestone_id' and allow_milestone" name="project_portal_milestones">Milestone</th>\n                        <th t-if="groupby != 'state'"/>\n                        <th t-if="groupby != 'stage_id'" class="text-end">Stage</th>\n                    </tr>\n                </thead>\n                <t t-foreach="grouped_tasks" t-as="tasks">\n                    <tbody t-if="tasks">\n                        <tr name="grouped_tasks_groupby_columns" t-if="groupby != 'none'" class="table-light">\n                            <th name="groupby_name_col" t-att-colspan="grouped_tasks_colspan">\n                                <t t-if="groupby == 'project_id' and multiple_projects">\n                                    <!-- This div is necessary for documents_project_sale -->\n                                    <div name="project_name" class="d-flex w-100 align-items-center">\n                                        <span t-if="tasks[0].sudo().project_id" t-field="tasks[0].sudo().project_id.name"/>\n                                        <span t-else="">No Project</span>\n                                    </div>\n                                </t>\n                                <t t-elif="groupby == 'milestone_id'">\n                                    <span t-if="tasks[0].sudo().milestone_id and tasks[0].sudo().allow_milestones" class="text-truncate" t-field="tasks[0].sudo().milestone_id.name"/>\n                                    <span t-else="">No Milestone</span>\n                                </t>\n                                <t t-if="groupby == 'stage_id'">\n                                    <!-- This div is necessary for documents_project_sale -->\n                                    <div name="stage_name" class="d-flex w-100 align-items-center">\n                                        <span class="text-truncate" t-field="tasks[0].sudo().stage_id.name"/>\n                                    </div>\n                                </t>\n                                <t t-if="groupby == 'priority'">\n                                    <span class="text-truncate" t-field="tasks[0].sudo().priority"/>\n                                </t>\n                                <t t-if="groupby == 'state'">\n                                    <span class="text-truncate" t-field="tasks[0].sudo().state"/>\n                                </t>\n                                <t t-if="groupby == 'partner_id'">\n                                    <span t-if="tasks[0].sudo().partner_id" class="text-truncate" t-field="tasks[0].sudo().partner_id.name"/>\n                                    <span t-else="">No Customer</span>\n                                </t>\n                            </th>\n                            <th name="state_col" t-if="groupby != 'state'"/>\n                            <th name="stage_id_col" t-if="groupby != 'stage_id'"/>\n                        </tr>\n                    </tbody>\n                    <tbody t-if="tasks">\n                        <t t-foreach="tasks" t-as="task">\n                            <tr>\n                                <td class="text-start">\n                                    #<span t-esc="task.id"/>\n                                </td>\n                                <td t-if="groupby != 'priority'" class="text-end">\n                                    <t t-call="project.portal_my_tasks_priority_widget_template"/>\n                                </td>\n                                <td>\n                                    <a t-attf-href="/my/#{task_url}/#{task.id}?{{ keep_query() }}"><span t-att-title="task.name" t-field="task.name"/></a>\n                                </td>\n                                <td>\n                                    <t t-set="assignees" t-value="task.sudo().user_ids"/>\n                                    <div t-if="assignees" class="flex-nowrap ps-3">\n                                        <img class="o_avatar rounded" t-attf-src="#{image_data_uri(assignees[:1].avatar_128)}" alt="User"/>\n                                        <span class="align-middle" t-att-title="'\\n'.join(assignees.mapped('name'))">\n                                            <span t-field="assignees[:1].name"/><span t-if="len(assignees) &gt; 1" class="badge ms-1 rounded-pill bg-light"> +<span t-out="len(assignees) - 1"/></span>\n                                        </span>\n                                    </div>\n                                </td>\n                                <td t-if="groupby != 'project_id' and multiple_projects">\n                                    <span title="Current project of the task" t-out="task.project_id.name"/>\n                                </td>\n                                <td t-if="groupby != 'milestone_id' and allow_milestone" name="project_portal_milestones">\n                                    <t t-if="task.milestone_id and task.allow_milestones">\n                                        <span t-esc="task.milestone_id.name"/>\n                                    </t>\n                                </td>\n                                <td t-if="groupby != 'state'" align="right" class="align-middle">\n                                    <t t-call="project.portal_my_tasks_state_widget_template">\n                                        <t t-set="path" t-value="'tasks'"/>\n                                    </t>\n                                </td>\n                                <td t-if="groupby != 'stage_id'" class="text-end lh-1">\n                                    <t t-call="project.portal_my_tasks_badge_widget_template"/>\n                                </td>\n                            </tr>\n                        </t>\n                    </tbody>\n                </t>\n            </t>\n        </t>\n    </t>\n\n    	f	t	2026-09-05 15:59:52.742806	2026-09-05 15:59:52.742806	f
1255	16	490	1	1	task_link_preview_front_end	\N	project.task_link_preview_front_end	qweb	project/views/project_portal_project_task_templates.xml	primary	{"en_US": "<data inherit_id=\\"portal.frontend_layout\\" primary=\\"True\\">\\n        <xpath expr=\\"//t[@t-if='not_uses_default_logo'][1]\\" position=\\"before\\">\\n            <t t-if=\\"preview_object.displayed_image_id\\">\\n                <meta property=\\"og:image\\" t-attf-content=\\"/web/image/{{ preview_object.displayed_image_id.id }}/300x200?access_token={{ preview_object.displayed_image_id.generate_access_token()[0] }}\\"/>\\n            </t>\\n        </xpath>\\n        <xpath expr=\\"//t[@t-if='not_uses_default_logo'][2]\\" position=\\"before\\">\\n            <t t-if=\\"preview_object.displayed_image_id\\">\\n                <meta property=\\"twitter:image\\" t-attf-content=\\"/web/image/{{ preview_object.displayed_image_id.id }}/300x200?access_token={{ preview_object.displayed_image_id.generate_access_token()[0] }}\\"/>\\n            </t>\\n        </xpath>\\n    <xpath expr=\\".\\" position=\\"attributes\\"><attribute name=\\"t-name\\">project.task_link_preview_front_end</attribute></xpath></data>"}	<?xml version="1.0"?>\n<data inherit_id="portal.frontend_layout" primary="True">\n        <xpath expr="//t[@t-if='not_uses_default_logo'][1]" position="before">\n            <t t-if="preview_object.displayed_image_id">\n                <meta property="og:image" t-attf-content="/web/image/{{ preview_object.displayed_image_id.id }}/300x200?access_token={{ preview_object.displayed_image_id.generate_access_token()[0] }}"/>\n            </t>\n        </xpath>\n        <xpath expr="//t[@t-if='not_uses_default_logo'][2]" position="before">\n            <t t-if="preview_object.displayed_image_id">\n                <meta property="twitter:image" t-attf-content="/web/image/{{ preview_object.displayed_image_id.id }}/300x200?access_token={{ preview_object.displayed_image_id.generate_access_token()[0] }}"/>\n       