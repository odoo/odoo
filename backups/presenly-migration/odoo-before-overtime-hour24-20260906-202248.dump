948	16	\N	1	1	Survey: result statistics page	\N	survey.survey_page_statistics	qweb	survey/views/survey_templates_statistics.xml	primary	{"en_US": "<t name=\\"Survey: result statistics page\\" t-name=\\"survey.survey_page_statistics\\">\\n        <t t-set=\\"no_livechat\\" t-value=\\"True\\"/>\\n        <t t-set=\\"no_survey_navigation\\" t-value=\\"True\\"/>\\n        <t t-call=\\"survey.layout\\">\\n            <t t-call=\\"survey.survey_button_form_view\\"/>\\n            <t t-set=\\"page_record_limit\\" t-value=\\"10\\"/><!-- Change this record_limit to change number of record  per page-->\\n            <div class=\\"o_container_small o_survey_result\\">\\n                <t t-call=\\"survey.survey_page_statistics_header\\"/>\\n                <t t-call=\\"survey.survey_page_statistics_inner\\"/>\\n            </div>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: result statistics page" t-name="survey.survey_page_statistics">\n        <t t-set="no_livechat" t-value="True"/>\n        <t t-set="no_survey_navigation" t-value="True"/>\n        <t t-call="survey.layout">\n            <t t-call="survey.survey_button_form_view"/>\n            <t t-set="page_record_limit" t-value="10"/><!-- Change this record_limit to change number of record  per page-->\n            <div class="o_container_small o_survey_result">\n                <t t-call="survey.survey_page_statistics_header"/>\n                <t t-call="survey.survey_page_statistics_inner"/>\n            </div>\n        </t>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
