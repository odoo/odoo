iv class=\\"s_hr o_mail_snippet_general pt0 pb0\\" data-snippet=\\"s_hr\\" data-name=\\"Separator\\">\\n            <hr class=\\"s_hr_1px s_hr_solid\\"/>\\n        </div>\\n        <section class=\\"s_text_image o_mail_snippet_general\\" data-vxml=\\"001\\" data-snippet=\\"s_text_image\\" data-name=\\"Text - Image\\">\\n            <div class=\\"container\\">\\n                <div class=\\"row align-items-center\\">\\n                    <div class=\\"col-md-7 pt16 pb16\\">\\n                        <h1>Breaking IT news\\n                            <br/>and Analysis</h1>\\n                        <p style=\\"text-align: left;\\">Our roundup of the most popular and latest tech related videos from last week.<br/></p>\\n                        <p style=\\"text-align:left;\\"><a class=\\"btn btn-primary\\" href=\\"#\\">VISIT OUR WEBSITE</a></p>\\n                    </div>\\n                    <div class=\\"col-md-5 px-0\\">\\n                        <img class=\\"img-fluid o_we_custom_image\\" src=\\"/html_editor/image_shape/mass_mailing_themes.s_tech_default_image/html_builder/geometric/geo_cornered_triangle.svg\\" data-shape=\\"html_builder/geometric/geo_cornered_triangle\\" data-file-name=\\"text_image-cornered_triangle.svg\\" data-shape-colors=\\";;;;\\" data-format-mimetype=\\"image/jpeg\\"/>\\n                    </div>\\n                </div>\\n            </div>\\n        </section>\\n        <div class=\\"s_hr o_mail_snippet_general pt0 pb16\\" data-vxml=\\"001\\" data-snippet=\\"s_hr\\" data-name=\\"Separator\\">\\n            <hr class=\\"s_hr_1px s_hr_solid\\"/>\\n        </div>\\n        <section class=\\"s_media_list o_mail_snippet_general o_cc o_cc2 pb0 pt0 bg-white\\" style=\\"padding-left: 15px; padding-right: 15px;\\" data-snippet=\\"s_media_list\\" data-vxml=\\"001\\" data-vcss=\\"001\\" data-name=\\"Media List\\">\\n            <div class=\\"container\\">\\n                <div class=\\"row s_nb_column_fixed o_mail_no_colorpicker\\">\\n                    <div class=\\"col-md-12 s_media_list_item pb0 pt0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-4 s_media_list_img_wrapper px-0\\">\\n                                <img src=\\"/mass_mailing_themes/static/src/img/theme_blogging/s_default_image_media_list_1.jpg\\" class=\\"s_media_list_img w-100\\"/>\\n                            </div>\\n                            <div class=\\"col-md-8 s_media_list_body\\">\\n                                <h3>The future of smartphone video production</h3>\\n                                <p>Modern smartphones have all the built-in tech equal to a majority of the current professional cameras.</p>\\n                                <p><a class=\\"btn btn-primary\\" t-att-href=\\"website_url_or_none\\"><span class=\\"fa fa-play\\"/>&amp;nbsp;&amp;nbsp;WATCH VIDEO</a>\\n                                &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;\\n                                <a class=\\"btn btn-link\\" href=\\"#\\">READ MORE</a></p>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-md-12 s_media_list_item pt0 pb0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-12 s_media_list_img_wrapper align-self-stretch px-0\\">\\n                                <div class=\\"s_hr o_mail_snippet_general pt16 pb16\\" data-snippet=\\"s_hr\\" data-name=\\"Separator\\">\\n                                    <hr class=\\"s_hr_1px s_hr_solid\\"/>\\n                                </div>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-md-12 s_media_list_item pb0 pt0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-4 s_media_list_img_wrapper px-0\\">\\n                                <img src=\\"/mass_mailing_themes/static/src/img/theme_blogging/s_default_image_media_list_2.jpg\\" class=\\"s_media_list_img w-100\\"/>\\n                            </div>\\n                            <div class=\\"col-md-8 s_media_list_body pt16 pb16\\">\\n                                <h3>5 Ways Drones Can Better Your Live Events</h3>\\n                                <p>One clever use of drones is for delivering gifts — but another that's becoming popular for event safety purposes.</p>\\n                                <p><a class=\\"btn btn-primary\\" t-att-href=\\"website_url_or_none\\">READ MORE</a></p>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-md-12 s_media_list_item pt0 pb0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-12 s_media_list_img_wrapper align-self-stretch px-0\\">\\n                                <div class=\\"s_hr o_mail_snippet_general pt16 pb16\\" data-snippet=\\"s_hr\\" data-name=\\"Separator\\">\\n                                    <hr class=\\"s_hr_1px s_hr_solid\\"/>\\n                                </div>\\n                            </div>\\n                        </div>\\n                    </div>\\n                    <div class=\\"col-md-12 s_media_list_item pt0 pb0\\" data-name=\\"Media item\\">\\n                        <div class=\\"row s_col_no_resize o_mail_no_colorpicker align-items-center o_cc o_cc1\\">\\n                            <div class=\\"col-md-4 s_media_list_img_wrapper px-0\\">\\n                        