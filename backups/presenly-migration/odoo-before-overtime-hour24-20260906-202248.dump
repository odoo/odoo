 </a>\\n                </div>\\n                <div class=\\"form-check form-switch mt-2\\">\\n                    <label id=\\"use_delivery_as_billing_label\\">\\n                        <input type=\\"checkbox\\" id=\\"use_delivery_as_billing\\" class=\\"form-check-input\\" t-att-checked=\\"use_delivery_as_billing\\"/> Same as delivery address\\n                    </label>\\n                </div>\\n                <div id=\\"billing_container\\" t-attf-class=\\"mt-3 {{'d-none' if use_delivery_as_billing else ''}}\\">\\n                    <t t-call=\\"portal.address_list\\">\\n                        <t t-set=\\"addresses\\" t-value=\\"billing_addresses\\"/>\\n                    </t>\\n                </div>\\n            </section>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="portal.my_addresses">\n        <t t-set="additional_title">My addresses</t>\n        <t t-call="portal.portal_layout">\n            <t t-set="address_type" t-valuef="delivery"/>\n            <t t-set="new_address_url" t-valuef="{{address_url}}?address_type={{address_type}}&amp;use_delivery_as_billing={{use_delivery_as_billing}}"/>\n            <section class="o_portal_addresses">\n                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">\n                    <h5 class="mb-0">Delivery address</h5>\n                    <a role="button" t-att-href="new_address_url" t-att-data-address-type="address_type" class="o_address_card_add_new btn btn-outline-primary btn-sm" title="Add an address" aria-label="Add an address">\n                        <i class="oi oi-plus me-2"/>Add Address\n                    </a>\n                </div>\n                <t t-call="portal.address_list">\n                    <t t-set="addresses" t-value="delivery_addresses"/>\n                </t>\n                <t t-set="address_type" t-valuef="billing"/>\n                <t t-set="new_address_url" t-valuef="{{address_url}}?address_type={{address_type}}"/>\n                <div class="d-flex justify-content-between align-items-start gap-3 mt-4 pt-2">\n                    <h5 class="mb-0">Billing address</h5>\n                    <a role="button" t-att-href="new_address_url" t-att-data-address-type="address_type" t-attf-class="o_address_card_add_new o_add_billing_address_btn btn btn-outline-primary btn-sm {{'d-none' if use_delivery_as_billing else ''}}" title="Add an address" aria-label="Add an address">\n                        <i class="oi oi-plus me-2"/>Add Address\n                    </a>\n                </div>\n                <div class="form-check form-switch mt-2">\n                    <label id="use_delivery_as_billing_label">\n                        <input type="checkbox" id="use_delivery_as_billing" class="form-check-input" t-att-checked="use_delivery_as_billing"/> Same as delivery address\n                    </label>\n                </div>\n                <div id="billing_container" t-attf-class="mt-3 {{'d-none' if use_delivery_as_billing else ''}}">\n                    <t t-call="portal.address_list">\n                        <t t-set="addresses" t-value="billing_addresses"/>\n                    </t>\n                </div>\n            </section>\n        </t>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
483	16	\N	1	1	portal.address_list	\N	portal.address_list	qweb	portal/views/address_templates.xml	primary	{"en_US": "<t t-name=\\"portal.address_list\\">\\n        <div name=\\"address_list\\" t-attf-class=\\"o_portal_address_list d-flex flex-column gap-2\\">\\n            <t t-foreach=\\"addresses\\" t-as=\\"address\\">\\n                <t t-call=\\"portal.address_card\\">\\n                    <t t-set=\\"contact\\" t-value=\\"address\\"/>\\n                    <t t-set=\\"is_user_address\\" t-value=\\"address == request.env.user.partner_id\\"/>\\n                    <t t-if=\\"is_user_address\\">\\n                        <!-- Edition of main address should go through dedicated page -->\\n                        <t t-set=\\"address_update_url\\" t-valuef=\\"/my/account?redirect=/my/addresses\\"/>\\n                    </t>\\n                    <t t-set=\\"can_be_edited\\" t-value=\\"address._can_be_edited_by_current_customer()\\"/>\\n                    <t t-set=\\"selected\\" t-value=\\"address == selected_address\\"/>\\n                    <t t-set=\\"show_removal\\" t-value=\\"can_be_edited and not selected and not is_user_address\\"/>\\n                </t>\\n            </t>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t t-name="portal.address_list">\n        <div name="address_list" t-attf-class="o_portal_address_list d-flex flex-column gap-2">\n            <t t-foreach="addresses" t-as="address">\n                <t t-call="portal.address_card">\n                    <t t-set="contact" t-value="address"/>\n                    <t t-set="is_user_address" t-value="address == request.env.user.partner_id"/>\n                    <t t-if="is_user_address">\n                        <!-- Edition of main address should go through dedicated page -->\n                        <t t-set="address_update_url" t-valuef="/my/account?redirect=/my/addresses"/>\n                    </t>\n                    <t t-set="can_be_edited" t-value="address._can_be_edited_by_current_customer()"/>\n                    <t t-set="selected" t-value="address == selected_address"/>\n                    <t t-set="show_removal" t-value="can_be_edited and not selected and not is_user_address"/>\n                </t>\n            </t>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
484	16	\N	1	1	Address Card	\N	portal.address_card	qweb	portal/views/address_templates.xml	primary	{"en_US": "<t name=\\"Address Card\\" t-name=\\"portal.address_card\\">\\n        <div name=\\"address_card\\" t-attf-class=\\"card o_address_card position-relative h-100 #{                 selected and 'bg-400 border border-primary'             }\\" t-att-data-address-type=\\"address_type\\" t-att-data-partner-id=\\"contact.id\\">\\n            <div class=\\"card-body d-flex flex-column flex-md-row justify-content-between gap-2\\">\\n                <t t-out=\\"contact\\" t-options=\\"dict(widget='contact', fields=['name', 'address'], no_marker=True, no_tag_br=True)\\"/>\\n                <t t-set=\\"badge_classes\\" t-value=\\"'badge text-bg-info'\\"/>\\n                <div class=\\"d-flex flex-row-reverse flex-md-column justify-content-between align-items-end\\">\\n                    <span t-if=\\"is_user_address\\" t-att-class=\\" badge_classes \\">\\n                        Main Address\\n                    </span>\\n                    <span t-elif=\\"contact.type=='delivery'\\" t-att-class=\\" badge_classes \\">\\n                        Delivery Address\\n                    </span>\\n                    <span t-elif=\\"contact.type=='invoice'\\" t-att-class=\\" badge_classes \\">\\n                        Billing Address\\n                    </span>\\n                    <div t-if=\\"can_be_edited\\" class=\\"d-flex gap-1 mt-auto ms-n2 ms-md-auto me-auto me-md-n2 mb-n2\\">\\n                        <t t-set=\\"address_update_url\\" t-value=\\"address_update_url or (new_address_url + '&amp;partner_id=' + str(contact.id))\\"/>\\n                        <a name=\\"card_address_ref\\" t-att-href=\\"address_update_url\\" class=\\"js_edit_address p-2\\" role=\\"button\\" title=\\"Edit this address\\" aria-label=\\"Edit this address\\">\\n                            <i class=\\"fa fa-fw fa-pencil\\"/>\\n                        </a>\\n                        <t t-if=\\"show_removal\\">\\n                            <span class=\\"d-block border-start border-2 my-2\\"/>\\n                            <a class=\\"o_remove_address p-2 text-danger\\" role=\\"button\\" title=\\"Remove this address\\" aria-label=\\"Remove this address\\" t-att-data-partner-id=\\"contact.id\\">\\n                                <i class=\\"fa fa-fw fa-trash\\"/>\\n                            </a>\\n                        </t>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Address Card" t-name="portal.address_card">\n        <div name="address_card" t-attf-class="card o_address_card position-relative h-100 #{                 selected and 'bg-400 border border-primary'             }" t-att-data-address-type="address_type" t-att-data-partner-id="contact.id">\n            <div class="card-body d-flex flex-column flex-md-row justify-content-between gap-2">\n                <t t-out="contact" t-options="dict(widget='contact', fields=['name', 'address'], no_marker=True, no_tag_br=True)"/>\n                <t t-set="badge_classes" t-value="'badge text-bg-info'"/>\n                <div class="d-flex flex-row-reverse flex-md-column justify-content-between align-items-end">\n                    <span t-if="is_user_address" t-att-class=" badge_classes ">\n                        Main Address\n                    </span>\n                    <span t-elif="contact.type=='delivery'" t-att-class=" badge_classes ">\n                        Delivery Address\n                    </span>\n                    <span t-elif="contact.type=='invoice'" t-att-class=" badge_classes ">\n                        Billing Address\n                    </span>\n                    <div t-if="can_be_edited" class="d-flex gap-1 mt-auto ms-n2 ms-md-auto me-auto me-md-n2 mb-n2">\n                        <t t-set="address_update_url" t-value="address_update_url or (new_address_url + '&amp;partner_id=' + str(contact.id))"/>\n                        <a name="card_address_ref" t-att-href="address_update_url" class="js_edit_address p-2" role="button" title="Edit this address" aria-label="Edit this address">\n                            <i class="fa fa-fw fa-pencil"/>\n                        </a>\n                        <t t-if="show_removal">\n                            <span class="d-block border-start border-2 my-2"/>\n                            <a class="o_remove_address p-2 text-danger" role="button" title="Remove this address" aria-label="Remove this address" t-att-data-partner-id="contact.id">\n                                <i class="fa fa-fw fa-trash"/>\n                            </a>\n                        </t>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
485	16	\N	1	1	Address Details	\N	portal.address_form_fields	qweb	portal/views/address_templates.xml	primary	{"en_US": "<t name=\\"Address Details\\" t-name=\\"portal.address_form_fields\\">\\n        <div id=\\"div_name\\" class=\\"col-lg-12 mb-2\\">\\n            <label class=\\"col-form-label\\" for=\\"o_name\\">Your name</label>\\n            <input id=\\"o_name\\" type=\\"text\\" name=\\"name\\" t-att-value=\\"partner_sudo.name\\" class=\\"form-control\\"/>\\n        </div>\\n        <div class=\\"w-100\\"/>\\n        <div id=\\"div_email\\" class=\\"col-lg-6 mb-2\\">\\n            <label class=\\"col-form-label\\" for=\\"o_email\\">Email</label>\\n            <input id=\\"o_email\\" type=\\"email\\" name=\\"email\\" t-att-value=\\"partner_sudo.email\\" class=\\"form-control\\"/>\\n        </div>\\n        <div id=\\"div_phone\\" class=\\"col-lg-6 mb-2\\">\\n            <label class=\\"col-form-label\\" for=\\"o_phone\\">Phone</label>\\n            <input id=\\"o_phone\\" type=\\"tel\\" name=\\"phone\\" t-att-value=\\"partner_sudo.phone\\" class=\\"form-control\\"/>\\n        </div>\\n        <t name=\\"b2b_fields\\">\\n            <div class=\\"w-100\\"/>\\n            <t t-if=\\"is_used_as_billing\\">\\n                <t t-set=\\"vat_warning\\" t-value=\\"current_partner.vat and not current_partner.can_edit_vat()\\"/>\\n                <div id=\\"company_name_div\\" class=\\"col-lg-6 mb-2\\">\\n                    <label class=\\"col-form-label fw-normal label-optional\\" for=\\"o_company_name\\">\\n                        Company Name\\n                    </label>\\n                    <input id=\\"o_company_name\\" type=\\"text\\" name=\\"company_name\\" t-att-value=\\"current_partner.commercial_company_name\\" t-att-readonly=\\"'1' if not is_main_address else None\\" class=\\"form-control\\"/>\\n                </div>\\n                <div id=\\"div_vat\\" class=\\"col-lg-6 mb-2\\">\\n                    <label class=\\"col-form-label fw-normal label-optional\\" for=\\"o_vat\\">\\n                        <t t-out=\\"vat_label\\"/>\\n                    </label>\\n                    <input type=\\"text\\" id=\\"o_vat\\" name=\\"vat\\" t-att-value=\\"current_partner.vat\\" t-att-readonly=\\"'1' if (not is_commercial_address or vat_warning) else None\\" class=\\"form-control\\"/>\\n                    <!-- Even on new addresses, first tell the customer if their VAT cannot be changed,\\n                        then tell them to update it elsewhere if it can be. -->\\n                    <div t-if=\\"not is_commercial_address and commercial_partner.is_company and is_main_address\\" class=\\"col-12 d-none d-lg-block mb-1\\">\\n                        <small class=\\"form-text text-muted\\">\\n                            The VAT number can only be updated on the company account.\\n                        </small>\\n                    </div>\\n                    <div t-elif=\\"vat_warning and is_main_address\\" class=\\"col-12 d-none d-lg-block mb-1\\">\\n                        <small class=\\"form-text text-muted\\">\\n                            Changing VAT number is not allowed once document(s) have\\n                            been issued for your account. Please contact us directly for this\\n                            operation.\\n                        </small>\\n                    </div>\\n                </div>\\n                <div t-if=\\"not (is_commercial_address or is_main_address)\\" class=\\"col-12 d-none d-lg-block mb-1\\">\\n                    <small class=\\"form-text text-muted\\">\\n                        The company name and VAT number can only be updated on your main account.\\n                        <t t-if=\\"commercial_address_update_url\\">\\n                            If you want to modify it, update\\n                            <a t-att-href=\\"commercial_address_update_url\\">your account details</a>.\\n                        </t>\\n                    </small>\\n                </div>\\n            </t>\\n        </t>\\n        <div id=\\"div_street\\" class=\\"col-lg-12 mb-2\\">\\n            <label class=\\"col-form-label\\" for=\\"o_street\\">\\n                Street and Number\\n            </label>\\n            <input name=\\"street\\" id=\\"o_street\\" type=\\"text\\" class=\\"form-control\\" t-att-value=\\"partner_sudo.street\\"/>\\n        </div>\\n        <div id=\\"div_street2\\" class=\\"col-lg-12 mb-2\\">\\n            <label class=\\"col-form-label label-optional\\" for=\\"o_street2\\">\\n                Apartment, suite, etc.\\n            </label>\\n            <input id=\\"o_street2\\" type=\\"text\\" name=\\"street2\\" class=\\"form-control\\" t-att-value=\\"partner_sudo.street2\\"/>\\n        </div>\\n        <div class=\\"w-100\\"/>\\n        <t t-if=\\"zip_before_city\\">\\n            <div id=\\"div_zip\\" class=\\"col-md-4 mb-2\\">\\n                <label class=\\"col-form-label\\" for=\\"o_zip\\">\\n                    Zip Code\\n                </label>\\n                <input id=\\"o_zip\\" type=\\"text\\" name=\\"zip\\" class=\\"form-control\\" t-att-value=\\"partner_sudo.zip\\"/>\\n            </div>\\n        </t>\\n        <div id=\\"div_city\\" class=\\"col-md-8 mb-2\\">\\n            <label class=\\"col-form-label\\" for=\\"o_city\\">City</label>\\n            <input id=\\"o_city\\" type=\\"text\\" name=\\"city\\" class=\\"form-control\\" t-att-value=\\"partner_sudo.city\\"/>\\n        </div>\\n        <t t-if=\\"not zip_before_city\\">\\n            <div id=\\"div_zip\\" class=\\"col-md-4 mb-2\\">\\n                <label class=\\"col-form-label\\" for=\\"o_zip\\">\\n                    Zip Code\\n                </label>\\n                <input id=\\"o_zip\\" type=\\"text\\" name=\\"zip\\" class=\\"form-control\\" t-att-value=\\"partner_sudo.zip\\"/>\\n            </div>\\n        </t>\\n        <div class=\\"w-100\\"/>\\n        <div id=\\"div_country\\" class=\\"col-lg-6 mb-2\\">\\n            <label class=\\"col-form-label\\" for=\\"o_country_id\\">\\n                Country\\n            </label>\\n            <select id=\\"o_country_id\\" name=\\"country_id\\" t-att-class=\\"'pe-none opacity-50 form-select' if not can_edit_country else 'form-select'\\">\\n                <option value=\\"\\">Country...</option>\\n                <option t-foreach=\\"countries\\" t-as=\\"c\\" t-att-value=\\"c.id\\" t-att-selected=\\"c.id == (country.id if country else partner_sudo.country_id.id)\\" t-att-code=\\"c.code\\" t-out=\\"c.name\\"/>\\n            </select>\\n            <div t-if=\\"not can_edit_country\\" class=\\"col-12 d-none d-lg-block mb-1\\">\\n                <small class=\\"form-text text-muted\\">\\n                    Changing country is not allowed once document(s) have\\n                    been issued for your account. Please contact us directly for this\\n                    operation.\\n                </small>\\n            </div>\\n        </div>\\n        <div id=\\"div_state\\" class=\\"col-lg-6 mb-2\\" t-att-style=\\"not country_states and 'display: none'\\">\\n            <label class=\\"col-form-label label-optional\\" for=\\"o_state_id\\">\\n                State / Province\\n            </label>\\n            <select id=\\"o_state_id\\" name=\\"state_id\\" class=\\"form-select\\">\\n                <option value=\\"\\">State / Province...</option>\\n                <option t-foreach=\\"country_states\\" t-as=\\"s\\" t-att-value=\\"s.id\\" t-att-selected=\\"s.id == (int(state_id) if state_id else partner_sudo.state_id.id)\\" t-out=\\"s.name\\"/>\\n            </select>\\n        </div>\\n        <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n        <input type=\\"hidden\\" name=\\"address_type\\" t-att-value=\\"address_type\\"/>\\n        <input type=\\"hidden\\" name=\\"use_delivery_as_billing\\" t-att-value=\\"use_delivery_as_billing\\"/>\\n        <input type=\\"hidden\\" name=\\"parent_id\\" t-att-value=\\"parent_id\\"/>\\n        <t t-if=\\"partner_id\\">\\n            <input type=\\"hidden\\" name=\\"partner_id\\" t-att-value=\\"partner_id\\"/>\\n        </t>\\n        <t t-if=\\"callback\\">\\n            <input type=\\"hidden\\" name=\\"callback\\" t-att-value=\\"callback\\"/>\\n        </t>\\n        <input type=\\"hidden\\" name=\\"required_fields\\" t-att-value=\\"'name,email'\\"/>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Address Details" t-name="portal.address_form_fields">\n        <div id="div_name" class="col-lg-12 mb-2">\n            <label class="col-form-label" for="o_name">Your name</label>\n            <input id="o_name" type="text" name="name" t-att-value="partner_sudo.name" class="form-control"/>\n        </div>\n        <div class="w-100"/>\n        <div id="div_email" class="col-lg-6 mb-2">\n            <label class="col-form-label" for="o_email">Email</label>\n            <input id="o_email" type="email" name="email" t-att-value="partner_sudo.email" class="form-control"/>\n        </div>\n        <div id="div_phone" class="col-lg-6 mb-2">\n            <label class="col-form-label" for="o_phone">Phone</label>\n            <input id="o_phone" type="tel" name="phone" t-att-value="partner_sudo.phone" class="form-control"/>\n        </div>\n        <t name="b2b_fields">\n            <div class="w-100"/>\n            <t t-if="is_used_as_billing">\n                <t t-set="vat_warning" t-value="current_partner.vat and not current_partner.can_edit_vat()"/>\n                <div id="company_name_div" class="col-lg-6 mb-2">\n                    <label class="col-form-label fw-normal label-optional" for="o_company_name">\n                        Company Name\n                    </label>\n                    <input id="o_company_name" type="text" name="company_name" t-att-value="current_partner.commercial_company_name" t-att-readonly="'1' if not is_main_address else None" class="form-control"/>\n                </div>\n                <div id="div_vat" class="col-lg-6 mb-2">\n                    <label class="col-form-label fw-normal label-optional" for="o_vat">\n                        <t t-out="vat_label"/>\n                    </label>\n                    <input type="text" id="o_vat" name="vat" t-att-value="current_partner.vat" t-att-readonly="'1' if (not is_commercial_address or vat_warning) else None" class="form-control"/>\n                    <!-- Even on new addresses, first tell the customer if their VAT cannot be changed,\n                        then tell them to update it elsewhere if it can be. -->\n                    <div t-if="not is_commercial_address and commercial_partner.is_company and is_main_address" class="col-12 d-none d-lg-block mb-1">\n                        <small class="form-text text-muted">\n                            The VAT number can only be updated on the company account.\n                        </small>\n                    </div>\n                    <div t-elif="vat_warning and is_main_address" class="col-12 d-none d-lg-block mb-1">\n                        <small class="form-text text-muted">\n                            Changing VAT number is not allowed once document(s) have\n                            been issued for your account. Please contact us directly for this\n                            operation.\n                        </small>\n                    </div>\n                </div>\n                <div t-if="not (is_commercial_address or is_main_address)" class="col-12 d-none d-lg-block mb-1">\n                    <small class="form-text text-muted">\n                        The company name and VAT number can only be updated on your main account.\n                        <t t-if="commercial_address_update_url">\n                            If you want to modify it, update\n                            <a t-att-href="commercial_address_update_url">your account details</a>.\n                        </t>\n                    </small>\n                </div>\n            </t>\n        </t>\n        <div id="div_street" class="col-lg-12 mb-2">\n            <label class="col-form-label" for="o_street">\n                Street and Number\n            </label>\n            <input name="street" id="o_street" type="text" class="form-control" t-att-value="partner_sudo.street"/>\n        </div>\n        <div id="div_street2" class="col-lg-12 mb-2">\n            <label class="col-form-label label-optional" for="o_street2">\n                Apartment, suite, etc.\n            </label>\n            <input id="o_street2" type="text" name="street2" class="form-control" t-att-value="partner_sudo.street2"/>\n        </div>\n        <div class="w-100"/>\n        <t t-if="zip_before_city">\n            <div id="div_zip" class="col-md-4 mb-2">\n                <label class="col-form-label" for="o_zip">\n                    Zip Code\n                </label>\n                <input id="o_zip" type="text" name="zip" class="form-control" t-att-value="partner_sudo.zip"/>\n            </div>\n        </t>\n        <div id="div_city" class="col-md-8 mb-2">\n            <label class="col-form-label" for="o_city">City</label>\n            <input id="o_city" type="text" name="city" class="form-control" t-att-value="partner_sudo.city"/>\n        </div>\n        <t t-if="not zip_before_city">\n            <div id="div_zip" class="col-md-4 mb-2">\n                <label class="col-form-label" for="o_zip">\n                    Zip Code\n                </label>\n                <input id="o_zip" type="text" name="zip" class="form-control" t-att-value="partner_sudo.zip"/>\n            </div>\n        </t>\n        <div class="w-100"/>\n        <div id="div_country" class="col-lg-6 mb-2">\n            <label class="col-form-label" for="o_country_id">\n                Country\n            </label>\n            <select id="o_country_id" name="country_id" t-att-class="'pe-none opacity-50 form-select' if not can_edit_country else 'form-select'">\n                <option value="">Country...</option>\n                <option t-foreach="countries" t-as="c" t-att-value="c.id" t-att-selected="c.id == (country.id if country else partner_sudo.country_id.id)" t-att-code="c.code" t-out="c.name"/>\n            </select>\n            <div t-if="not can_edit_country" class="col-12 d-none d-lg-block mb-1">\n                <small class="form-text text-muted">\n                    Changing country is not allowed once document(s) have\n                    been issued for your account. Please contact us directly for this\n                    operation.\n                </small>\n            </div>\n        </div>\n        <div id="div_state" class="col-lg-6 mb-2" t-att-style="not country_states and 'display: none'">\n            <label class="col-form-label label-optional" for="o_state_id">\n                State / Province\n            </label>\n            <select id="o_state_id" name="state_id" class="form-select">\n                <option value="">State / Province...</option>\n                <option t-foreach="country_states" t-as="s" t-att-value="s.id" t-att-selected="s.id == (int(state_id) if state_id else partner_sudo.state_id.id)" t-out="s.name"/>\n            </select>\n        </div>\n        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n        <input type="hidden" name="address_type" t-att-value="address_type"/>\n        <input type="hidden" name="use_delivery_as_billing" t-att-value="use_delivery_as_billing"/>\n        <input type="hidden" name="parent_id" t-att-value="parent_id"/>\n        <t t-if="partner_id">\n            <input type="hidden" name="partner_id" t-att-value="partner_id"/>\n        </t>\n        <t t-if="callback">\n            <input type="hidden" name="callback" t-att-value="callback"/>\n        </t>\n        <input type="hidden" name="required_fields" t-att-value="'name,email'"/>\n    </t>\n\n    	f	t	2026-09-05 15:59:47.288958	2026-09-05 15:59:47.288958	f
