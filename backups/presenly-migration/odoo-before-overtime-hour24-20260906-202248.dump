1315	16	\N	1	1	presenly.overtime.request.form	presenly.overtime.request	\N	form	presenly/views/presenly_overtime_views.xml	primary	{"en_US": "<form string=\\"Overtime / Lembur\\">\\n                <header>\\n                    <field name=\\"state\\" widget=\\"statusbar\\" statusbar_visible=\\"draft,submitted,approved,rejected,cancelled\\"/>\\n                </header>\\n                <sheet>\\n                    <div class=\\"d-flex flex-wrap gap-2 mb-3 o_presenly_overtime_actions\\">\\n                        <button name=\\"action_submit\\" type=\\"object\\" string=\\"Submit for Approval\\" class=\\"oe_highlight\\" invisible=\\"not can_submit\\"/>\\n                        <button name=\\"action_presenly_approve\\" type=\\"object\\" string=\\"Approve Current Level\\" class=\\"oe_highlight\\" invisible=\\"not can_approve\\"/>\\n                        <button name=\\"action_presenly_open_reject_wizard\\" type=\\"object\\" string=\\"Reject\\" class=\\"btn-secondary\\" invisible=\\"not can_reject\\"/>\\n                        <button name=\\"action_cancel\\" type=\\"object\\" string=\\"Cancel Request\\" invisible=\\"not can_cancel\\" confirm=\\"Cancel this overtime request and its pending approval journey?\\"/>\\n                    </div>\\n                    <div class=\\"alert alert-info d-flex align-items-center my-2\\" role=\\"alert\\" invisible=\\"state != 'draft'\\">\\n                        <i class=\\"fa fa-clock-o me-2\\"/>\\n                        Overtime duration is computed server-side. Only one request per employee per day is allowed and attendance evidence is required.\\n                    </div>\\n                    <div class=\\"alert alert-warning d-flex align-items-center my-2\\" role=\\"alert\\" invisible=\\"state != 'submitted'\\">\\n                        <i class=\\"fa fa-hourglass-half me-2\\"/>\\n                        <div>\\n                            <strong><field name=\\"approval_level\\" class=\\"oe_inline\\"/></strong>\\n                            <span class=\\"ms-2\\">Waiting for</span>\\n                            <field name=\\"presenly_pending_approver_ids\\" widget=\\"many2many_tags\\" class=\\"oe_inline ms-1\\" options=\\"{'no_open': True}\\"/>\\n                        </div>\\n                    </div>\\n                    <div class=\\"alert alert-danger my-2\\" role=\\"alert\\" invisible=\\"not rejection_reason\\">\\n                        <strong>Rejection reason:</strong>\\n                        <field name=\\"rejection_reason\\" readonly=\\"1\\" nolabel=\\"1\\"/>\\n                    </div>\\n\\n                    <group string=\\"Overtime Details\\">\\n                        <group>\\n                            <field name=\\"employee_id\\" widget=\\"many2one_avatar_employee\\" readonly=\\"state != 'draft' or not can_change_employee\\" options=\\"{'no_create': True, 'no_open': True}\\"/>\\n                            <field name=\\"company_id\\" readonly=\\"1\\"/>\\n                            <field name=\\"date\\" readonly=\\"1\\"/>\\n                        </group>\\n                        <group>\\n                            <field name=\\"work_location_id\\" groups=\\"presenly.group_presenly_manager\\" invisible=\\"1\\"/>\\n                            <field name=\\"work_location_id\\" domain=\\"[('active', '=', True), ('company_id', '=', company_id)]\\" readonly=\\"state != 'draft'\\"/>\\n                        </group>\\n                    </group>\\n                    <group string=\\"Waktu dan Uang Makan\\">\\n                        <group>\\n                            <field name=\\"datetime_from\\" readonly=\\"state != 'draft'\\"/>\\n                            <field name=\\"datetime_to\\" readonly=\\"state != 'draft'\\"/>\\n                            <field name=\\"duration_hours\\" readonly=\\"1\\"/>\\n                        </group>\\n                        <group>\\n                            <field name=\\"meal_allowance\\" readonly=\\"state != 'draft' or not can_claim_meal_allowance\\"/>\\n                            <field name=\\"reason\\" readonly=\\"state != 'draft'\\"/>\\n                        </group>\\n                    </group>\\n                    <div class=\\"alert alert-warning\\" role=\\"alert\\" invisible=\\"can_claim_meal_allowance or state != 'draft'\\">\\n                        Uang makan (meal allowance) hanya berlaku untuk lembur lebih dari 3 jam.\\n                    </div>\\n                    <group string=\\"Bukti Kehadiran\\">\\n                        <field name=\\"has_attendance_evidence\\"/>\\n                    </group>\\n\\n                    <group string=\\"Approval Journey\\" class=\\"mt-3\\" invisible=\\"not presenly_approval_request_id\\">\\n                        <field name=\\"presenly_approval_step_ids\\" nolabel=\\"1\\" readonly=\\"1\\" colspan=\\"2\\">\\n                            <list create=\\"0\\" edit=\\"0\\" delete=\\"0\\" decoration-info=\\"state == 'pending'\\" decoration-success=\\"state == 'approved'\\" decoration-danger=\\"state == 'rejected'\\" decoration-muted=\\"state in ('waiting', 'cancelled')\\">\\n                                <field name=\\"level\\"/>\\n                                <field name=\\"name\\"/>\\n                                <field name=\\"assigned_user_ids\\" widget=\\"many2many_tags\\"/>\\n                                <field name=\\"state\\" widget=\\"badge\\" decoration-info=\\"state == 'pending'\\" decoration-success=\\"state == 'approved'\\" decoration-danger=\\"state == 'rejected'\\" decoration-muted=\\"state in ('waiting', 'cancelled')\\"/>\\n                                <field name=\\"decision_user_id\\" widget=\\"many2one_avatar_user\\" optional=\\"show\\"/>\\n                                <field name=\\"decision_date\\" optional=\\"show\\"/>\\n                                <field name=\\"decision_note\\" optional=\\"hide\\"/>\\n                            </list>\\n                        </field>\\n                    </group>\\n                </sheet>\\n                <chatter/>\\n            </form>"}	<form string="Overtime / Lembur">\n                <header>\n                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,cancelled"/>\n                </header>\n                <sheet>\n                    <div class="d-flex flex-wrap gap-2 mb-3 o_presenly_overtime_actions">\n                        <button name="action_submit" type="object" string="Submit for Approval" class="oe_highlight" invisible="not can_submit"/>\n                        <button name="action_presenly_approve" type="object" string="Approve Current Level" class="oe_highlight" invisible="not can_approve"/>\n                        <button name="action_presenly_open_reject_wizard" type="object" string="Reject" class="btn-secondary" invisible="not can_reject"/>\n                        <button name="action_cancel" type="object" string="Cancel Request" invisible="not can_cancel" confirm="Cancel this overtime request and its pending approval journey?"/>\n                    </div>\n                    <div class="alert alert-info d-flex align-items-center my-2" role="alert" invisible="state != 'draft'">\n                        <i class="fa fa-clock-o me-2"/>\n                        Overtime duration is computed server-side. Only one request per employee per day is allowed and attendance evidence is required.\n                    </div>\n                    <div class="alert alert-warning d-flex align-items-center my-2" role="alert" invisible="state != 'submitted'">\n                        <i class="fa fa-hourglass-half me-2"/>\n                        <div>\n                            <strong><field name="approval_level" class="oe_inline"/></strong>\n                            <span class="ms-2">Waiting for</span>\n                            <field name="presenly_pending_approver_ids" widget="many2many_tags" class="oe_inline ms-1" options="{'no_open': True}"/>\n                        </div>\n                    </div>\n                    <div class="alert alert-danger my-2" role="alert" invisible="not rejection_reason">\n                        <strong>Rejection reason:</strong>\n                        <field name="rejection_reason" readonly="1" nolabel="1"/>\n                    </div>\n\n                    <group string="Overtime Details">\n                        <group>\n                            <field name="employee_id" readonly="state != 'draft'"/>\n                            <field name="company_id" readonly="1"/>\n                            <field name="date" readonly="1"/>\n                        </group>\n                        <group>\n                            <field name="work_location_id" groups="presenly.group_presenly_manager" invisible="1"/>\n                            <field name="work_location_id" domain="[('active', '=', True), ('company_id', '=', company_id)]" readonly="state != 'draft'"/>\n                        </group>\n                    </group>\n                    <group string="Waktu dan Uang Makan">\n                        <group>\n                            <field name="datetime_from" readonly="state != 'draft'"/>\n                            <field name="datetime_to" readonly="state != 'draft'"/>\n                            <field name="duration_hours" readonly="1"/>\n                        </group>\n                        <group>\n                            <field name="meal_allowance" readonly="state != 'draft'"/>\n                            <field name="reason" readonly="state != 'draft'"/>\n                        </group>\n                    </group>\n                    <group string="Bukti Kehadiran">\n                        <field name="has_attendance_evidence"/>\n                    </group>\n\n                    <group string="Approval Journey" class="mt-3" invisible="not presenly_approval_request_id">\n                        <field name="presenly_approval_step_ids" nolabel="1" readonly="1" colspan="2">\n                            <list create="0" edit="0" delete="0" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state in ('waiting', 'cancelled')">\n                                <field name="level"/>\n                                <field name="name"/>\n                                <field name="assigned_user_ids" widget="many2many_tags"/>\n                                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state in ('waiting', 'cancelled')"/>\n                                <field name="decision_user_id" widget="many2one_avatar_user" optional="show"/>\n                                <field name="decision_date" optional="show"/>\n                                <field name="decision_note" optional="hide"/>\n                            </list>\n                        </field>\n                    </group>\n                </sheet>\n                <chatter/>\n            </form>	f	t	2026-09-06 12:47:20.078249	2026-09-06 13:13:14.705541	f
