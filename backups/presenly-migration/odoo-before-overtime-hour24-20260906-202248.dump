                 <field name=\\"started_at\\"/>\\n                            <field name=\\"completed_at\\" invisible=\\"not completed_at\\"/>\\n                        </group>\\n                    </group>\\n                    <separator string=\\"Approval Journey\\"/>\\n                    <field name=\\"step_ids\\" nolabel=\\"1\\" readonly=\\"1\\">\\n                        <list create=\\"0\\" edit=\\"0\\" delete=\\"0\\" decoration-info=\\"state == 'pending'\\" decoration-success=\\"state == 'approved'\\" decoration-danger=\\"state == 'rejected'\\" decoration-muted=\\"state in ('waiting', 'cancelled')\\">\\n                            <field name=\\"level\\"/>\\n                            <field name=\\"name\\"/>\\n                            <field name=\\"assigned_user_ids\\" widget=\\"many2many_tags\\"/>\\n                            <field name=\\"state\\" widget=\\"badge\\" decoration-info=\\"state == 'pending'\\" decoration-success=\\"state == 'approved'\\" decoration-danger=\\"state == 'rejected'\\" decoration-muted=\\"state in ('waiting', 'cancelled')\\"/>\\n                            <field name=\\"decision_user_id\\" widget=\\"many2one_avatar_user\\" optional=\\"show\\"/>\\n                            <field name=\\"decision_date\\" optional=\\"show\\"/>\\n                            <field name=\\"decision_note\\" optional=\\"hide\\"/>\\n                        </list>\\n                    </field>\\n                </sheet>\\n            </form>"}	<form string="Approval Journey" create="0" edit="0" delete="0" duplicate="false">\n                <header>\n                    <button name="action_open_target" type="object" string="Review Request" class="oe_highlight"/>\n                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected,cancelled"/>\n                </header>\n                <sheet>\n                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 