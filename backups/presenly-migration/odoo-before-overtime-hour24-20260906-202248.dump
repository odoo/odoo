1241	999	\N	1	1	project.sharing.project.task.view.kanban	project.task	\N	kanban	project/views/project_sharing_project_task_views.xml	primary	{"en_US": "<kanban highlight_color=\\"color\\" class=\\"o_kanban_small_column o_kanban_project_tasks\\" default_group_by=\\"stage_id\\" on_create=\\"quick_create\\" quick_create_view=\\"project.project_sharing_quick_create_task_form\\" archivable=\\"0\\" import=\\"0\\" groups_draggable=\\"0\\" group_edit=\\"0\\" default_order=\\"priority desc, sequence, state, date_deadline asc, id desc\\">\\n                <field name=\\"state\\"/>\\n                <field name=\\"allow_milestones\\"/>\\n                <field name=\\"has_late_and_unreached_milestone\\"/>\\n                <progressbar field=\\"state\\" colors=\\"{&quot;1_done&quot;: &quot;success-done&quot;, &quot;1_canceled&quot;: &quot;danger&quot;, &quot;03_approved&quot;: &quot;success&quot;, &quot;02_changes_requested&quot;: &quot;warning&quot;, &quot;04_waiting_normal&quot;: &quot;info&quot;, &quot;01_in_progress&quot;: &quot;200&quot;}\\"/>\\n                <templates>\\n                <t t-name=\\"menu\\" t-if=\\"!selection_mode\\">\\n                    <div role=\\"separator\\" class=\\"dropdown-divider\\"/>\\n                    <field name=\\"color\\" widget=\\"kanban_color_picker\\"/>\\n                </t>\\n                <t t-name=\\"card\\">\\n                    <div t-att-class=\\"{'opacity-50': ['1_done', '1_canceled'].includes(record.state.raw_value)}\\">\\n                        <field name=\\"name\\" class=\\"fw-bolder fs-5\\" widget=\\"name_with_subtask_count\\"/>\\n                        <field name=\\"project_id\\" invisible=\\"context.get('default_project_id', False)\\" required=\\"1\\" class=\\"text-muted\\"/>\\n                        <span t-if=\\"record.allow_milestones.raw_value and record.milestone_id.raw_value\\" t-attf-class=\\"{{record.has_late_and_unreached_milestone.raw_value and !record.state.raw_value.startsWith('1_') ? 'text-danger' : ''}}\\">\\n                            <field name=\\"milestone_id\\" class=\\"text-muted\\"/>\\n                        </span>\\n                        <field t-if=\\"record.partner_id.value\\" name=\\"partner_id\\" class=\\"text-truncate text-muted d-block\\"/>\\n                    </div>\\n                    <field name=\\"tag_ids\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color'}\\" context=\\"{'project_id': project_id}\\"/>\\n                    <field t-if=\\"record.date_deadline.raw_value\\" name=\\"date_deadline\\" invisible=\\"state in ['1_done', '1_canceled']\\" widget=\\"remaining_days\\"/>\\n                    <field t-if=\\"record.displayed_image_id.value\\" groups=\\"base.group_user\\" name=\\"displayed_image_id\\" widget=\\"attachment_image\\"/>\\n                    <footer t-if=\\"!selection_mode\\">\\n                        <field name=\\"priority\\" class=\\"pt-1\\" widget=\\"priority\\"/>\\n                        <div class=\\"d-flex ms-auto text-truncate\\">\\n                            <span t-if=\\"record.portal_user_names.raw_value.length &gt; 0\\" class=\\"pe-2 text-truncate\\" t-att-title=\\"record.portal_user_names.raw_value\\">\\n                                <t t-set=\\"user_count\\" t-value=\\"record.portal_user_names.raw_value.split(',').length\\"/>\\n                                <t t-if=\\"user_count &gt; 1\\"><t t-out=\\"user_count\\"/> assignees</t>\\n                                <field t-else=\\"\\" name=\\"portal_user_names\\"/>\\n                            </span>\\n                            <field name=\\"state\\" widget=\\"project_task_state_selection\\" options=\\"{'is_toggle_mode': false}\\"/>\\n                        </div>\\n                    </footer>\\n                </t>\\n                </templates>\\n            </kanban>"}	<?xml version="1.0"?>\n<kanban highlight_color="color" class="o_kanban_small_column o_kanban_project_tasks" default_group_by="stage_id" on_create="quick_create" quick_create_view="project.project_sharing_quick_create_task_form" archivable="0" import="0" groups_draggable="0" group_edit="0" default_order="priority desc, sequence, state, date_deadline asc, id desc">\n                <field name="state"/>\n                <field name="allow_milestones"/>\n                <field name="has_late_and_unreached_milestone"/>\n                <progressbar field="state" colors="{&quot;1_done&quot;: &quot;success-done&quot;, &quot;1_canceled&quot;: &quot;danger&quot;, &quot;03_approved&quot;: &quot;success&quot;, &quot;02_changes_requested&quot;: &quot;warning&quot;, &quot;04_waiting_normal&quot;: &quot;info&quot;, &quot;01_in_progress&quot;: &quot;200&quot;}"/>\n                <templates>\n                <t t-name="menu" t-if="!selection_mode">\n                    <div role="separator" class="dropdown-divider"/>\n                    <field name="color" widget="kanban_color_picker"/>\n                </t>\n                <t t-name="card">\n                    <div t-att-class="{'opacity-50': ['1_done', '1_canceled'].includes(record.state.raw_value)}">\n                        <field name="name" class="fw-bolder fs-5" widget="name_with_subtask_count"/>\n                        <field name="project_id" invisible="context.get('default_project_id', False)" required="1" class="text-muted"/>\n                        <span t-if="record.allow_milestones.raw_value and record.milestone_id.raw_value" t-attf-class="{{record.has_late_and_unreached_milestone.raw_value and !record.state.raw_value.startsWith('1_') ? 'text-danger' : ''}}">\n                            <field name="milestone_id" class="text-muted"/>\n                        </span>\n                        <field t-if="record.partner_id.value" name="partner_id" class="text-truncate text-muted d-block"/>\n                    </div>\n                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" context="{'project_id': project_id}"/>\n                    <field t-if="record.date_deadline.raw_value" name="date_deadline" invisible="state in ['1_done', '1_canceled']" widget="remaining_days"/>\n                    <field t-if="record.displayed_image_id.value" groups="base.group_user" name="displayed_image_id" widget="attachment_image"/>\n                    <footer t-if="!selection_mode">\n                        <field name="priority" class="pt-1" widget="priority"/>\n                        <div class="d-flex ms-auto text-truncate">\n                            <span t-if="record.portal_user_names.raw_value.length &gt; 0" class="pe-2 text-truncate" t-att-title="record.portal_user_names.raw_value">\n                                <t t-set="user_count" t-value="record.portal_user_names.raw_value.split(',').length"/>\n                                <t t-if="user_count &gt; 1"><t t-out="user_count"/> assignees</t>\n                                <field t-else="" name="portal_user_names"/>\n                            </span>\n                            <field name="state" widget="project_task_state_selection" options="{'is_toggle_mode': false}"/>\n                        </div>\n                    </footer>\n                </t>\n                </templates>\n            </kanban>\n        	f	t	2026-09-05 15:59:52.742806	2026-09-05 15:59:52.742806	f
