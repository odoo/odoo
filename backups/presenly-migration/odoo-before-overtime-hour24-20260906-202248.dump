806	16	589	1	1	hr.employee.form.presenly.tools	hr.employee	\N	form	presenly/views/hr_employee_integration_views.xml	extension	{"en_US": "<data><xpath expr=\\"//div[@name='button_box']\\" position=\\"inside\\">\\n                <button name=\\"action_open_presenly_schedules\\" type=\\"object\\" class=\\"oe_stat_button\\" icon=\\"fa-map-marker\\" groups=\\"presenly.group_presenly_manager\\">\\n                    <field name=\\"presenly_schedule_count\\" widget=\\"statinfo\\" string=\\"Location Slots\\"/>\\n                </button>\\n            </xpath>\\n            <xpath expr=\\"//notebook\\" position=\\"inside\\">\\n                <page name=\\"presenly_working_hours_locations\\" string=\\"Working Hours &amp; Locations\\" groups=\\"presenly.group_presenly_manager\\">\\n                    <field name=\\"company_id\\" invisible=\\"1\\"/>\\n                    <div class=\\"d-flex flex-wrap gap-2 mb-3\\">\\n                        <button name=\\"action_open_presenly_working_hours\\" type=\\"object\\" string=\\"Open Working Hours\\" icon=\\"fa-clock-o\\" class=\\"btn-secondary\\"/>\\n                        <button name=\\"action_generate_presenly_schedules\\" type=\\"object\\" string=\\"Generate from Working Hours\\" icon=\\"fa-magic\\" class=\\"btn-primary\\" invisible=\\"not id\\"/>\\n                        <button name=\\"action_open_presenly_schedules\\" type=\\"object\\" string=\\"Open Full Schedule\\" icon=\\"fa-external-link\\" class=\\"btn-secondary\\" invisible=\\"not id\\"/>\\n                    </div>\\n                    <group>\\n                        <group string=\\"Authoritative Working Time\\">\\n                            <field name=\\"resource_calendar_id\\" help=\\"Defines when this employee works. Location slots must stay inside these periods.\\"/>\\n                            <field name=\\"work_location_id\\" string=\\"Primary / Fallback Work Location\\"/>\\n                        </group>\\n                        <group string=\\"Location Coverage\\">\\n                            <field name=\\"presenly_schedule_health\\" widget=\\"badge\\" decoration-success=\\"presenly_schedule_health == 'synced'\\" decoration-warning=\\"presenly_schedule_health in ('partial', 'flexible')\\" decoration-danger=\\"presenly_schedule_health in ('conflict', 'no_calendar')\\"/>\\n                            <field name=\\"presenly_schedule_gap_count\\" readonly=\\"1\\"/>\\n                            <field name=\\"presenly_schedule_conflict_count\\" readonly=\\"1\\"/>\\n                            <field name=\\"presenly_schedule_health_message\\" readonly=\\"1\\"/>\\n                        </group>\\n                    </group>\\n                    <div class=\\"alert alert-danger\\" role=\\"alert\\" invisible=\\"presenly_schedule_health != 'conflict'\\">\\n                        One or more location slots are outside the current Working Hours. They are ignored during attendance resolution. Fix them below or regenerate the weekly schedule.\\n                    </div>\\n                    <div class=\\"alert alert-warning\\" role=\\"alert\\" invisible=\\"presenly_schedule_health != 'partial'\\">\\n                        Some Working Hours periods have no location assignment. Use Generate from Working Hours to fill only the gaps.\\n                    </div>\\n                    <div class=\\"alert alert-success\\" role=\\"alert\\" invisible=\\"presenly_schedule_health != 'synced'\\">\\n                        Working Hours and regular Work Location slots are fully synchronized.\\n                    </div>\\n                    <separator string=\\"Location Slots\\"/>\\n                    <field name=\\"presenly_schedule_ids\\" context=\\"{'default_employee_id': id}\\" domain=\\"[('employee_id', '=', id)]\\" nolabel=\\"1\\">\\n                        <list editable=\\"bottom\\" decoration-muted=\\"not active\\" decoration-success=\\"calendar_sync_state in ('valid', 'flexible')\\" decoration-danger=\\"calendar_sync_state in ('outside', 'no_calendar')\\">\\n                            <field name=\\"company_id\\" column_invisible=\\"True\\"/>\\n                            <field name=\\"calendar_two_weeks\\" column_invisible=\\"True\\"/>\\n                            <field name=\\"schedule_type\\"/>\\n                            <field name=\\"weekday\\" invisible=\\"schedule_type != 'weekly'\\"/>\\n                            <field name=\\"week_type\\" optional=\\"hide\\" invisible=\\"schedule_type != 'weekly'\\"/>\\n                            <field name=\\"schedule_date\\" invisible=\\"schedule_type != 'date'\\"/>\\n                            <field name=\\"hour_from\\" widget=\\"float_time\\"/>\\n                            <field name=\\"hour_to\\" widget=\\"float_time\\"/>\\n                            <field name=\\"work_location_id\\" required=\\"1\\" domain=\\"[('active', '=', True), ('company_id', '=', company_id)]\\" options=\\"{'no_create_edit': True}\\"/>\\n                            <field name=\\"calendar_sync_state\\" widget=\\"badge\\" decoration-success=\\"calendar_sync_state in ('valid', 'flexible')\\" decoration-danger=\\"calendar_sync_state in ('outside', 'no_calendar')\\"/>\\n                            <field name=\\"check_in_tolerance_minutes\\" optional=\\"hide\\"/>\\n                            <field name=\\"date_start\\" optional=\\"hide\\" invisible=\\"schedule_type != 'weekly'\\"/>\\n                            <field name=\\"date_end\\" optional=\\"hide\\" invisible=\\"schedule_type != 'weekly'\\"/>\\n                            <field name=\\"active\\" optional=\\"hide\\"/>\\n                        </list>\\n                    </field>\\n                    <div class=\\"alert alert-info mt-3\\" role=\\"alert\\">\\n                        Working Hours answers <strong>when</strong> the employee works. Location Slots answer <strong>where</strong>. Split one Working Hours period into multiple rows when the employee changes school during that period.\\n                    </div>\\n                </page>\\n            </xpath>\\n        </data>"}	<data><xpath expr="//div[@name='button_box']" position="inside">\n                <button name="action_open_presenly_schedules" type="object" class="oe_stat_button" icon="fa-map-marker" groups="presenly.group_presenly_manager">\n                    <field name="presenly_schedule_count" widget="statinfo" string="Location Slots"/>\n                </button>\n            </xpath>\n            <xpath expr="//notebook" position="inside">\n                <page name="presenly_working_hours_locations" string="Working Hours &amp; Locations" groups="presenly.group_presenly_manager">\n                    <field name="company_id" invisible="1"/>\n                    <div class="d-flex flex-wrap gap-2 mb-3">\n                        <button name="action_open_presenly_working_hours" type="object" string="Open Working Hours" icon="fa-clock-o" class="btn-secondary"/>\n                        <button name="action_generate_presenly_schedules" type="object" string="Generate from Working Hours" icon="fa-magic" class="btn-primary" invisible="not id"/>\n                        <button name="action_open_presenly_schedules" type="object" string="Open Full Schedule" icon="fa-external-link" class="btn-secondary" invisible="not id"/>\n                    </div>\n                    <group>\n                        <group string="Authoritative Working Time">\n                            <field name="resource_calendar_id" help="Defines when this employee works. Location slots must stay inside these periods."/>\n                            <field name="work_location_id" string="Primary / Fallback Work Location"/>\n                        </group>\n                        <group string="Location Coverage">\n                            <field name="presenly_schedule_health" widget="badge" decoration-success="presenly_schedule_health == 'synced'" decoration-warning="presenly_