et=\\"todo_done_checkmark\\" class=\\"o_task_state_widget\\"/>\\n                        </div>\\n                    </div>\\n                    <group>\\n                        <group>\\n                            <field name=\\"user_ids\\" widget=\\"many2many_avatar_user\\" required=\\"1\\" placeholder=\\"Assignees\\"/>\\n                        </group>\\n                        <group>\\n                            <field name=\\"tag_ids\\" widget=\\"many2many_tags\\" options=\\"{'color_field': 'color', 'no_create_edit': True}\\" class=\\"me-2\\"/>\\n                            <field name=\\"date_deadline\\" decoration-danger=\\"date_deadline &lt; current_date\\"/>\\n                        </group>\\n                    </group>\\n                    <field name=\\"description\\" type=\\"html\\" class=\\"oe_description\\" default_focus=\\"1\\" options=\\"{'resizable': false, 'collaborative': true}\\" placeholder=\\"Type Here...\\"/>\\n                </sheet>\\n                <widget name=\\"todo_chatter_panel\\"/>\\n            </form>"}	<?xml version="1.0"?>\n<form string="To-do" class="o_todo_form_view" js_class="todo_form">\n                <field name="html_field_history_metadata" invisible="1"/>\n                <field name="company_id" invisible="1"/>\n                <field name="project_id" invisible="1"/>\n                <header>\n                    <field name="personal_stage_type_id" domain="[('user_id','=',uid)]" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>\n                    <field name="active" invisible="1"/>\n                </header>\n                <sheet class="o_todo_form_sheet_bg">\n                    <widget name="web_ribbon" class="todo_archived" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                    <div class="d-flex justify-content-between align-items-center">\n                        <h1 class="d-flex w-100">\n                            <field name="name" options="{'line_breaks': False}" widget="text" class="o_task_name text-truncate w-md-75 w-100 pe-2" placeholder="Task Title..."/>\n                        </h1>\n                        <div class="d-flex justify-content-end align-items-center px-1" invisible="not active">\n                            <field name="priority" class="h3 pe-2" widget="priority_switch"/>\n                            <field name="state" widget="todo_done_checkmark" class="o_task_state_widget"/>\n                        </div>\n                        <div class="d-flex justify-content-start align-items-center w-100 w-md-50 w-lg-25" invisible="active">\n                            <field name="priority" class="h3 pe-2" widget="priority_switch"/>\n                            <field name="state" widget="todo_done_checkmark" class="o_task_state_widget"/>\n                        </div>\n                    </div>\n                    <group>\n                        <group>\n                            <field name="user_ids" widget="many2many_avatar_user" required="1" placeholder="Assignees"/>\n                        </group>\n                        <group>\n                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" class="me-2"/>\n                            <field name="date_deadline" decoration-danger="date_deadline &lt; current_date"/>\n                        </group>\n                    </group>\n                    <field name="description" type="html" class="oe_description" default_focus="1" options="{'resizable': false, 'collaborative': true}" placeholder="Type Here..."/>\n                </sheet>\n                <widget name="todo_chatter_panel"/>\n            </form>\n        	f	t	2026-09-05 15:59:53.744877	2026-09-05 15:59:53.744877	f
