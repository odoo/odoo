                     <field name="email_to" invisible="use_default_to" placeholder="Comma-separated recipient addresses"/>\n                                        <field name="partner_to" invisible="use_default_to" placeholder="Comma-separated ids of recipient partners"/>\n                                        <field name="email_cc" invisible="use_default_to" placeholder="Comma-separated carbon copy of recipients addresses"/>\n                                        <field name="reply_to" placeholder="Capture replies in the chatter"/>\n                                    </group>\n                                    <group>\n                                        <separator string="Technical"/>\n                                        <field name="lang" placeholder="Main partner's language" options="{'dynamic_placeholder': true}"/>\n                                        <field name="has_mail_server" invisible="1"/>\n                                        <field name="mail_server_id" invisible="not has_mail_server" placeholder="By order of server priority"/>\n                                        <field name="auto_delete"/>\n                                        <field name="scheduled_date" string="Scheduled Send Date" placeholder="Send Instantly" options="{'dynamic_placeholder': true}"/>\n                                    </group>\n                                </group>\n                            </page>\n                            <page string="Options" name="email_settings">\n                                <group col="2">\n                                    <group>\n                                        <field name="has_dynamic_reports" invisible="1"/>\n                                        <field name="attachment_ids" widget="many2many_binary"/>\n                                        <field name="report_template_ids" widget="many2many_tags" domain="[('model','=',model)]" invisible="not has_dynamic_reports" options="{'no_create': True}" placeholder="None"/>\n                                    </group>\n                                    <group>\n                                        <field name="user_id" widget="many2one_avatar_user" readonly="not is_template_editor" invisible="not is_template_editor" placeholder="Shared with all users"/>\n                                        <field name="description" placeholder="Describe when this template should be used"/>\n                                    </group>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                </form>\n            	f	t	2026-09-05 15:59:45.191692	2026-09-05 15:59:45.191692	\N
