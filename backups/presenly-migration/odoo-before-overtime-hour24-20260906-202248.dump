\\"/>\\n                    <filter string=\\"Tags\\" name=\\"tags\\" help=\\"By assigned tags\\" context=\\"{'group_by':'tag_ids'}\\"/>\\n                    <filter string=\\"Assignees\\" name=\\"user_ids\\" context=\\"{'group_by': 'user_ids'}\\"/>\\n                    <filter string=\\"Stage\\" name=\\"stage\\" help=\\"By personal stages\\" context=\\"{'group_by':'personal_stage_type_id'}\\"/>\\n                    <filter string=\\"Deadline\\" name=\\"deadline\\" context=\\"{'group_by': 'date_deadline'}\\"/>\\n                </group>\\n            </search>"}	<?xml version="1.0"?>\n<search string="Todos">\n                <field name="name"/>\n                <field name="tag_ids"/>\n                <field name="user_ids"/>\n                <field name="personal_stage_type_ids" string="Stage"/>\n                <separator/>\n                <filter name="open_tasks" string="Open" domain="[('is_closed', '=', False)]"/>\n                <filter name="closed_tasks" string="Closed" domain="[('is_closed', '=', True)]"/>\n                <filter string="Closed On" name="closed_on" domain="[('is_closed', '=', True)]" date="date_last_stage_update"/>\n                <separator/>\n                <filter name="date_deadline" string="Deadline" domain="[('date_deadline', '!=', False)]" date="date_deadline"/>\n                <separator/>\n                <filter name="active_false" string="Archived" domain="[('active', '=', False)]"/>\n                <filter invisible="1" string="My Activities" name="filter_activities_my" domain="[('activity_user_id', '=', uid)]"/>\n                <separator invisible="1"/>\n                <filter invisible="1" string="Late Activities" name="activities_overdue" domain="[('my_activity_date_deadline', '&lt;', 'today')]" help="Show all records whose next activity date is past"/>\n                <filter invisible="1" string="Today Activities" name="activities_today" domain="[('my_activity_date_deadline', '=', 'today')]"/>\n              