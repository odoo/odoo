950	16	\N	1	1	Survey: result statistics content	\N	survey.survey_page_statistics_inner	qweb	survey/views/survey_templates_statistics.xml	primary	{"en_US": "<t name=\\"Survey: result statistics content\\" t-name=\\"survey.survey_page_statistics_inner\\">\\n        <t t-set=\\"already_filtered_questions\\" t-value=\\"{filter['question_id'] for filter in search_filters}\\"/>\\n        <div t-if=\\"survey.session_show_leaderboard and leaderboard\\" class=\\"o_survey_session_leaderboard mb-5 mt-1\\">\\n            <h2 class=\\"mt16 text-uppercase text-muted\\">Leaderboard</h2>\\n            <t t-call=\\"survey.user_input_session_leaderboard\\"/>\\n        </div>\\n        <div t-if=\\"survey.scoring_type in ['scoring_with_answers', 'scoring_without_answers']\\">\\n            <hr class=\\"my-2\\"/>\\n            <div class=\\"row mt-2\\">\\n                <div class=\\"col\\">\\n                    <h4 class=\\"text-primary\\" t-out=\\"survey.question_count\\"/>\\n                    <h6>Questions</h6>\\n                </div>\\n                <div class=\\"col\\">\\n                    <h4 class=\\"text-primary\\" t-out=\\"survey.answer_count\\"/>\\n                    <h6>Registered</h6>\\n                </div>\\n                <div class=\\"col\\">\\n                    <h4 class=\\"text-primary\\" t-out=\\"survey.answer_done_count\\"/>\\n                    <h6>Completed</h6>\\n                </div>\\n                <div class=\\"d-sm-none w-100\\"/>\\n                <div class=\\"col\\">\\n                    <h4 class=\\"text-primary\\"><t t-call=\\"survey.survey_remove_unnecessary_decimals\\">\\n                        <t t-set=\\"value_to_format\\" t-value=\\"survey_data['global_success_rate']\\"/></t>%</h4>\\n                    <h6>Success rate</h6>\\n                </div>\\n                <div t-if=\\"survey.answer_duration_avg\\" class=\\"col\\">\\n                    <h4 class=\\"text-primary\\" t-out=\\"survey.answer_duration_avg\\" t-options=\\"{'widget': 'float_time'}\\"/>\\n                    <h6>Average Duration</h6>\\n                </div>\\n                <div t-if=\\"survey.answer_score_avg\\" class=\\"col\\">\\n                    <h4 class=\\"text-primary\\"><t t-out=\\"round(survey.answer_score_avg, 2)\\"/>%</h4>\\n                    <h6>Average Score</h6>\\n                </div>\\n           </div>\\n            <hr/>\\n        </div>\\n\\n        <div t-foreach=\\"question_and_page_data\\" t-as=\\"question_data\\">\\n            <t t-set=\\"question\\" t-value=\\"question_data['question']\\"/>\\n            <div t-if=\\"question_data['is_page']\\" class=\\"o_survey_question_page\\">\\n                <h3 class=\\"mt16 text-uppercase\\" t-field=\\"question.title\\"/>\\n                <hr class=\\"mt-2 mb-4\\"/>\\n            </div>\\n            <div t-else=\\"\\" class=\\"mt-2 o_survey_results_question_wrapper\\"><t t-call=\\"survey.survey_page_statistics_question\\"/></div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Survey: result statistics content" t-name="survey.survey_page_statistics_inner">\n        <t t-set="already_filtered_questions" t-value="{filter['question_id'] for filter in search_filters}"/>\n        <div t-if="survey.session_show_leaderboard and leaderboard" class="o_survey_session_leaderboard mb-5 mt-1">\n            <h2 class="mt16 text-uppercase text-muted">Leaderboard</h2>\n            <t t-call="survey.user_input_session_leaderboard"/>\n        </div>\n        <div t-if="survey.scoring_type in ['scoring_with_answers', 'scoring_without_answers']">\n            <hr class="my-2"/>\n            <div class="row mt-2">\n                <div class="col">\n                    <h4 class="text-primary" t-out="survey.question_count"/>\n                    <h6>Questions</h6>\n                </div>\n                <div class="col">\n                    <h4 class="text-primary" t-out="survey.answer_count"/>\n                    <h6>Registered</h6>\n                </div>\n                <div class="col">\n                    <h4 class="text-primary" t-out="survey.answer_done_count"/>\n                    <h6>Completed</h6>\n                </div>\n                <div class="d-sm-none w-100"/>\n                <div class="col">\n                    <h4 class="text-primary"><t t-call="survey.survey_remove_unnecessary_decimals">\n                        <t t-set="value_to_format" t-value="survey_data['global_success_rate']"/></t>%</h4>\n                    <h6>Success rate</h6>\n                </div>\n                <div t-if="survey.answer_duration_avg" class="col">\n                    <h4 class="text-primary" t-out="survey.answer_duration_avg" t-options="{'widget': 'float_time'}"/>\n                    <h6>Average Duration</h6>\n                </div>\n                <div t-if="survey.answer_score_avg" class="col">\n                    <h4 class="text-primary"><t t-out="round(survey.answer_score_avg, 2)"/>%</h4>\n                    <h6>Average Score</h6>\n                </div>\n           </div>\n            <hr/>\n        </div>\n\n        <div t-foreach="question_and_page_data" t-as="question_data">\n            <t t-set="question" t-value="question_data['question']"/>\n            <div t-if="question_data['is_page']" class="o_survey_question_page">\n                <h3 class="mt16 text-uppercase" t-field="question.title"/>\n                <hr class="mt-2 mb-4"/>\n            </div>\n            <div t-else="" class="mt-2 o_survey_results_question_wrapper"><t t-call="survey.survey_page_statistics_question"/></div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
951	16	\N	1	1	Question: result statistics	\N	survey.survey_page_statistics_question	qweb	survey/views/survey_templates_statistics.xml	primary	{"en_US": "<t name=\\"Question: result statistics\\" t-name=\\"survey.survey_page_statistics_question\\">\\n        <t t-set=\\"comment_lines\\" t-value=\\"question_data['comment_line_ids']\\"/>\\n        <t t-set=\\"graph_data\\" t-value=\\"question_data['graph_data']\\"/>\\n        <t t-set=\\"table_data\\" t-value=\\"question_data['table_data']\\"/>\\n        <t t-set=\\"question_has_image_answers\\" t-value=\\"any(answer.value_image_filename for answer in question.suggested_answer_ids)\\"/>\\n\\n        <div class=\\"o_survey_results_question pb-3\\">\\n            <t t-set=\\"question_answered\\" t-value=\\"question_data['answer_input_done_ids']\\"/>\\n            <div class=\\"o_survey_results_question_header\\">\\n                <div class=\\"d-inline-flex flex-nowrap align-items-center cursor-pointer user-select-none\\" aria-expanded=\\"true\\" data-bs-toggle=\\"collapse\\" t-attf-data-bs-target=\\".o_survey_results_question_#{question.id}\\">\\n                    <i class=\\"fa fa-caret-right d-print-none me-3\\" role=\\"img\\"/>\\n                    <i class=\\"fa fa-caret-down d-print-none me-3\\" role=\\"img\\"/>\\n                    <h5 t-field=\\"question.title\\" class=\\"mb-1\\"/>\\n                </div>\\n                <div t-attf-class=\\"d-flex flex-wrap align-items-center mb-1 collapse show o_survey_results_question_#{question.id}\\">\\n                    <!-- Question info -->\\n                    <div class=\\"d-flex align-items-center my-1 me-2\\">\\n                        <!-- Scoring info -->\\n                        <t t-if=\\"survey.scoring_type != 'no_scoring' and (question.answer_numerical_box or question.answer_date or                             question.answer_datetime or any([a.is_correct for a in question.suggested_answer_ids]))\\">\\n                            <span t-if=\\"question.question_type in ['numerical_box', 'date', 'datetime', 'simple_choice', 'multiple_choice']\\" class=\\"badge d-flex gap-1 ms-0 me-1 text-info text-start border rounded\\">\\n                                <span t-out=\\"question_data['right_inputs_count']\\"/>\\n                                <span class=\\"text-success\\">Correct</span>\\n                            </span>\\n                            <span t-if=\\"question.question_type == 'multiple_choice'\\" class=\\"badge d-flex gap-1 ms-0 me-1 text-info text-start border rounded\\">\\n                                <span t-esc=\\"question_data['partial_inputs_count']\\"/>\\n                                <span class=\\"text-warning\\">Partial</span>\\n                            </span>\\n                        </t>\\n                        <!-- Inputs info -->\\n                        <span class=\\"badge d-flex gap-1 ms-0 me-1 text-info text-start border rounded\\">\\n                            <span t-out=\\"len(question_data['answer_input_done_ids'])\\"/>/\\n                            <span t-out=\\"len(question_data['answer_input_ids'])\\"/>\\n                            <span class=\\"text-muted\\">Responded</span>\\n                        </span>\\n                    </div>\\n                    <!-- Numerical KPIs -->\\n                    <span t-if=\\"question.question_type in ['numerical_box', 'scale']\\" class=\\"d-flex gap-1 my-1 me-2\\">\\n                        <div class=\\"btn-group o_survey_results_question_pill\\" role=\\"group\\" aria-label=\\"Maximum\\">\\n                            <span class=\\"badge text-bg-secondary only_left_radius px-2 pt-1\\">Max</span>\\n                            <span class=\\"badge text-bg-success only_right_radius px-2 pt-1\\" t-esc=\\"question_data['numerical_max']\\"/>\\n                        </div>\\n                        <div class=\\"btn-group o_survey_results_question_pill\\" role=\\"group\\" aria-label=\\"Minimum\\">\\n                            <span class=\\"badge text-bg-secondary only_left_radius px-2 pt-1\\">Min</span>\\n                            <span class=\\"badge text-bg-danger only_right_radius px-2 pt-1\\" t-esc=\\"question_data['numerical_min']\\"/>\\n                        </div>\\n                        <div class=\\"btn-group o_survey_results_question_pill\\" role=\\"group\\" aria-label=\\"Average\\">\\n                            <span class=\\"badge text-bg-secondary only_left_radius px-2 pt-1\\">Avg</span>\\n                            <span class=\\"badge text-bg-warning only_right_radius px-2 pt-1\\" t-esc=\\"question_data['numerical_average']\\"/>\\n                        </div>\\n                    </span>\\n                    <!-- Data buttons -->\\n                    <ul t-if=\\"question.question_type not in ['text_box', 'char_box'] and question_answered\\" class=\\"nav btn-group flex-nowrap d-print-none ms-auto\\" role=\\"tablist\\">\\n                        <li t-if=\\"question.question_type in ['simple_choice', 'multiple_choice', 'matrix', 'scale']\\" class=\\"nav-item btn-group\\">\\n                            <a t-att-href=\\"'#survey_graph_question_%d' % question.id\\" t-att-aria-controls=\\"'survey_graph_question_%d' % question.id\\" data-bs-toggle=\\"tab\\" role=\\"tab\\" class=\\"o_survey_results_data_tab nav-link btn btn-light py-1 px-2 active\\">\\n                                <i t-if=\\"question.question_type == 'simple_choice'\\" class=\\"fa fa-pie-chart\\"/>\\n                                <i t-else=\\"\\" class=\\"fa fa-bar-chart-o\\"/>\\n                            </a>\\n                        </li>\\n                        <li t-elif=\\"question.question_type in ['numerical_box', 'date', 'datetime']\\" class=\\"nav-item btn-group\\">\\n                            <a t-att-href=\\"'#survey_stats_question_%d' % question.id\\" t-att-aria-controls=\\"'survey_stats_question_%d' % question.id\\" data-bs-toggle=\\"tab\\" role=\\"tab\\" class=\\"o_survey_results_data_tab nav-link btn btn-light py-1 px-2 active\\">\\n                                <i class=\\"fa fa-trophy\\"/>\\n                            </a>\\n                        </li>\\n                        <li class=\\"nav-item btn-group\\">\\n                            <a t-att-href=\\"'#survey_data_question_%d' % question.id\\" t-att-aria-controls=\\"'survey_data_question_%d' % question.id\\" data-bs-toggle=\\"tab\\" role=\\"tab\\" class=\\"o_survey_results_data_tab nav-link btn btn-light py-1 px-2\\">\\n                                <i class=\\"fa fa-bars\\"/>\\n                            </a>\\n                        </li>\\n                    </ul>\\n                </div>\\n            </div>\\n            <div t-attf-class=\\"collapse show o_survey_results_question_#{question.id}\\">\\n                <!-- Question Description -->\\n                <div class=\\"o_survey_question_description ms-3 text-muted d-none\\" t-field=\\"question.description\\"/>\\n    \\n                <!-- Answers -->\\n                <div t-if=\\"not question_answered\\" class=\\"o_survey_no_answers text-center fw-bold\\">\\n                    <p>No answers yet!</p>\\n                </div>\\n                <t t-elif=\\"question.question_type in ['text_box', 'char_box']\\" t-call=\\"survey.question_result_text\\"/>\\n                <t t-elif=\\"question.question_type in ['numerical_box', 'date', 'datetime']\\" t-call=\\"survey.question_result_number_or_date_or_datetime\\"/>\\n                <t t-elif=\\"question.question_type in ['simple_choice', 'multiple_choice', 'scale']\\" t-call=\\"survey.question_result_choice\\"/>\\n                <t t-elif=\\"question.question_type in ['matrix']\\" t-call=\\"survey.question_result_matrix\\"/>\\n            </div>\\n        </div>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Question: result statistics" t-name="survey.survey_page_statistics_question">\n        <t t-set="comment_lines" t-value="question_data['comment_line_ids']"/>\n        <t t-set="graph_data" t-value="question_data['graph_data']"/>\n        <t t-set="table_data" t-value="question_data['table_data']"/>\n        <t t-set="question_has_image_answers" t-value="any(answer.value_image_filename for answer in question.suggested_answer_ids)"/>\n\n        <div class="o_survey_results_question pb-3">\n            <t t-set="question_answered" t-value="question_data['answer_input_done_ids']"/>\n            <div class="o_survey_results_question_header">\n                <div class="d-inline-flex flex-nowrap align-items-center cursor-pointer user-select-none" aria-expanded="true" data-bs-toggle="collapse" t-attf-data-bs-target=".o_survey_results_question_#{question.id}">\n                    <i class="fa fa-caret-right d-print-none me-3" role="img"/>\n                    <i class="fa fa-caret-down d-print-none me-3" role="img"/>\n                    <h5 t-field="question.title" class="mb-1"/>\n                </div>\n                <div t-attf-class="d-flex flex-wrap align-items-center mb-1 collapse show o_survey_results_question_#{question.id}">\n                    <!-- Question info -->\n                    <div class="d-flex align-items-center my-1 me-2">\n                        <!-- Scoring info -->\n                        <t t-if="survey.scoring_type != 'no_scoring' and (question.answer_numerical_box or question.answer_date or                             question.answer_datetime or any([a.is_correct for a in question.suggested_answer_ids]))">\n                            <span t-if="question.question_type in ['numerical_box', 'date', 'datetime', 'simple_choice', 'multiple_choice']" class="badge d-flex gap-1 ms-0 me-1 text-info text-start border rounded">\n                                <span t-out="question_data['right_inputs_count']"/>\n                                <span class="text-success">Correct</span>\n                            </span>\n                            <span t-if="question.question_type == 'multiple_choice'" class="badge d-flex gap-1 ms-0 me-1 text-info text-start border rounded">\n                                <span t-esc="question_data['partial_inputs_count']"/>\n                                <span class="text-warning">Partial</span>\n                            </span>\n                        </t>\n                        <!-- Inputs info -->\n                        <span class="badge d-flex gap-1 ms-0 me-1 text-info text-start border rounded">\n                            <span t-out="len(question_data['answer_input_done_ids'])"/>/\n                            <span t-out="len(question_data['answer_input_ids'])"/>\n                            <span class="text-muted">Responded</span>\n                        </span>\n                    </div>\n                    <!-- Numerical KPIs -->\n                    <span t-if="question.question_type in ['numerical_box', 'scale']" class="d-flex gap-1 my-1 me-2">\n                        <div class="btn-group o_survey_results_question_pill" role="group" aria-label="Maximum">\n                            <span class="badge text-bg-secondary only_left_radius px-2 pt-1">Max</span>\n                            <span class="badge text-bg-success only_right_radius px-2 pt-1" t-esc="question_data['numerical_max']"/>\n                        </div>\n                        <div class="btn-group o_survey_results_question_pill" role="group" aria-label="Minimum">\n                            <span class="badge text-bg-secondary only_left_radius px-2 pt-1">Min</span>\n                            <span class="badge text-bg-danger only_right_radius px-2 pt-1" t-esc="question_data['numerical_min']"/>\n                        </div>\n                        <div class="btn-group o_survey_results_question_pill" role="group" aria-label="Average">\n                            <span class="badge text-bg-secondary only_left_radius px-2 pt-1">Avg</span>\n                            <span class="badge text-bg-warning only_right_radius px-2 pt-1" t-esc="question_data['numerical_average']"/>\n                        </div>\n                    </span>\n                    <!-- Data buttons -->\n                    <ul t-if="question.question_type not in ['text_box', 'char_box'] and question_answered" class="nav btn-group flex-nowrap d-print-none ms-auto" role="tablist">\n                        <li t-if="question.question_type in ['simple_choice', 'multiple_choice', 'matrix', 'scale']" class="nav-item btn-group">\n                            <a t-att-href="'#survey_graph_question_%d' % question.id" t-att-aria-controls="'survey_graph_question_%d' % question.id" data-bs-toggle="tab" role="tab" class="o_survey_results_data_tab nav-link btn btn-light py-1 px-2 active">\n                                <i t-if="question.question_type == 'simple_choice'" class="fa fa-pie-chart"/>\n                                <i t-else="" class="fa fa-bar-chart-o"/>\n                            </a>\n                        </li>\n                        <li t-elif="question.question_type in ['numerical_box', 'date', 'datetime']" class="nav-item btn-group">\n                            <a t-att-href="'#survey_stats_question_%d' % question.id" t-att-aria-controls="'survey_stats_question_%d' % question.id" data-bs-toggle="tab" role="tab" class="o_survey_results_data_tab nav-link btn btn-light py-1 px-2 active">\n                                <i class="fa fa-trophy"/>\n                            </a>\n                        </li>\n                        <li class="nav-item btn-group">\n                            <a t-att-href="'#survey_data_question_%d' % question.id" t-att-aria-controls="'survey_data_question_%d' % question.id" data-bs-toggle="tab" role="tab" class="o_survey_results_data_tab nav-link btn btn-light py-1 px-2">\n                                <i class="fa fa-bars"/>\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div t-attf-class="collapse show o_survey_results_question_#{question.id}">\n                <!-- Question Description -->\n                <div class="o_survey_question_description ms-3 text-muted d-none" t-field="question.description"/>\n    \n                <!-- Answers -->\n                <div t-if="not question_answered" class="o_survey_no_answers text-center fw-bold">\n                    <p>No answers yet!</p>\n                </div>\n                <t t-elif="question.question_type in ['text_box', 'char_box']" t-call="survey.question_result_text"/>\n                <t t-elif="question.question_type in ['numerical_box', 'date', 'datetime']" t-call="survey.question_result_number_or_date_or_datetime"/>\n                <t t-elif="question.question_type in ['simple_choice', 'multiple_choice', 'scale']" t-call="survey.question_result_choice"/>\n                <t t-elif="question.question_type in ['matrix']" t-call="survey.question_result_matrix"/>\n            </div>\n        </div>\n    </t>\n\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
