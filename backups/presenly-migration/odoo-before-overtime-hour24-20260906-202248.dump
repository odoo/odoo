rect\\"/>\\n                    <input type=\\"hidden\\" name=\\"token\\" t-att-value=\\"token\\"/>\\n                    <div class=\\"clearfix oe_login_buttons d-grid mt-3\\">\\n                        <button type=\\"submit\\" class=\\"btn btn-primary\\">Reset Password</button>\\n                        <div class=\\"d-flex justify-content-between align-items-center small mt-2\\">\\n                            <a t-if=\\"not token\\" t-attf-href=\\"/web/login?{{ keep_query() }}\\">Back to Login</a>\\n                            <a t-if=\\"invalid_token\\" href=\\"/web/login\\">Back to Login</a>\\n                        </div>\\n                        <t t-call=\\"web.login_oauth\\"/>\\n                    </div>\\n\\n                </form>\\n                <div class=\\"oe_structure\\" id=\\"oe_structure_reset_password_bottom\\"/>\\n\\n            </t>\\n        </t>"}	<?xml version="1.0"?>\n<t name="Reset password" t-name="auth_signup.reset_password">\n            <t t-call="web.login_layout">\n                <div class="oe_structure" id="oe_structure_reset_password_top"/>\n                <div t-if="message" class="oe_login_form clearfix">\n                    <p class="alert alert-success" t-if="message" role="status">\n                        <t t-esc="message"/>\n                    </p>\n                    <a href="/web/login" class="btn btn-link btn-sm float-start" role="button">Back to Login</a>\n                </div>\n\n                <form class="oe_reset_password_form" role="form" method="post" t-if="not message" data-captcha="password_reset">\n                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n\n                    <t t-if="token and not invalid_token">\n                        <t t-call="auth_signup.fields">\n                            <t t-set="autofocus" t-value="1"/>\n                        </t>\n                    </t>\n\n                    <t t-if="not token">\n                        <div 