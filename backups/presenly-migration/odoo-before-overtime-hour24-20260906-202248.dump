895	16	\N	1	1	certification_report_view_general	\N	survey.certification_report_view_general	qweb	survey/report/survey_templates.xml	primary	{"en_US": "<t t-name=\\"survey.certification_report_view_general\\">\\n            <!-- Style classes to be applied to '#o_survey_certification': [no class](purple), gold, blue -->\\n            <div id=\\"o_survey_certification\\" t-att-data-oe-model=\\"user_input._name\\" t-att-data-oe-id=\\"user_input.id\\" t-attf-class=\\"#{'article certification-wrapper ' + layout_template + ' ' + layout_color}\\">\\n                <div class=\\"certification\\">\\n                    <div class=\\"certification-seal\\" t-if=\\"user_input.scoring_success and layout_template == 'modern'\\"/>\\n                    <div class=\\"certification-top\\">\\n                        <h1><b>Certificate</b>\\n                            <br/><span t-if=\\"user_input.scoring_success\\">of achievement</span>\\n                        </h1>\\n                    </div>\\n\\n                    <div class=\\"page certification-content\\">\\n                        <div class=\\"oe_structure\\"/>\\n                        <div t-if=\\"user_input.scoring_success\\">\\n                        <div class=\\"oe_structure\\"/>\\n                            <p> <span>This certificate is presented to</span>\\n                                <br/>\\n                                <t t-set=\\"certif_style\\" t-value=\\"''\\"/>\\n                                <t t-set=\\"certified_name\\" t-value=\\"user_input.partner_id.name or user_input.email or ''\\"/>\\n                                <t t-if=\\"len(certified_name) &gt; 35 and layout_template == 'classic'\\">\\n                                    <t t-set=\\"certif_style\\" t-value=\\"certif_style + 'font-size: 20px; line-height: 4; font-family: certification-serif;'\\"/>\\n                                </t>\\n                                <t t-elif=\\"layout_template == 'modern'\\">\\n                                    <t t-if=\\"len(certified_name) &gt; 45\\">\\n                                        <t t-set=\\"certif_style\\" t-value=\\"certif_style + 'font-size: 20px; line-height: 4;'\\"/>\\n                                    </t>\\n                                    <t t-elif=\\"len(certified_name) &gt; 35\\">\\n                                        <t t-set=\\"certif_style\\" t-value=\\"certif_style + 'font-size: 30px; line-height: 4;'\\"/>\\n                                    </t>\\n                                    <t t-elif=\\"len(certified_name) &gt; 20\\">\\n                                        <t t-set=\\"certif_style\\" t-value=\\"certif_style + 'font-size: 40px; line-height: 4;'\\"/>\\n                                    </t>\\n                                </t>\\n                                <t t-else=\\"\\">\\n                                    <t t-set=\\"certif_style\\" t-value=\\"certif_style + 'font-size: 30px; line-height: 4;'\\"/>\\n                                </t>\\n                                <span t-att-style=\\"certif_style\\" class=\\"user-name\\" t-out=\\"certified_name\\">DEMO_CERTIFIED_NAME</span>\\n\\n                                <br/> <span>by</span> <span class=\\"certification-company\\" t-field=\\"user_input.create_uid.sudo().company_id.display_name\\">Odoo</span> <span>for successfully completing</span>\\n                                <br/><b><span class=\\"certification-name\\" t-field=\\"user_input.survey_id.display_name\\">Functional Training</span></b>\\n                             </p>\\n                            <div class=\\"oe_structure\\"/>\\n                        </div>\\n                        <div t-else=\\"\\" class=\\"certification-failed\\">\\n                            <p>Certification Failed</p>\\n                            <div class=\\"oe_structure\\"/>\\n                        </div>\\n                        <div class=\\"oe_structure\\"/>\\n                    </div>\\n\\n                    <div class=\\"certification-bottom\\">\\n                        <div class=\\"oe_structure\\"/>\\n                        <div class=\\"certification-date-wrapper\\">\\n                            <span class=\\"certification-date\\" t-field=\\"user_input.create_date\\" t-options=\\"{&quot;widget&quot;: &quot;date&quot;}\\">2023-08-18</span>\\n                            <span>Date</span>\\n                        </div>\\n                        <div class=\\"certification-company\\">\\n                            <span class=\\"certification-company-logo\\" t-field=\\"user_input.create_uid.sudo().company_id.logo\\" t-options=\\"{'widget': 'image'}\\" role=\\"img\\"/>\\n                        </div>\\n                    </div>\\n                    <div t-if=\\"user_input.test_entry\\" class=\\"test-entry\\"/>\\n                    <div class=\\"certification-number\\" t-if=\\"user_input.scoring_success\\">\\n                        Certification n°<span t-out=\\"str(user_input.id).rjust(10, '0')\\">0000000010</span>\\n                    </div>\\n                </div>\\n            </div>\\n        </t>"}	<?xml version="1.0"?>\n<t t-name="survey.certification_report_view_general">\n            <!-- Style classes to be applied to '#o_survey_certification': [no class](purple), gold, blue -->\n            <div id="o_survey_certification" t-att-data-oe-model="user_input._name" t-att-data-oe-id="user_input.id" t-attf-class="#{'article certification-wrapper ' + layout_template + ' ' + layout_color}">\n                <div class="certification">\n                    <div class="certification-seal" t-if="user_input.scoring_success and layout_template == 'modern'"/>\n                    <div class="certification-top">\n                        <h1><b>Certificate</b>\n                            <br/><span t-if="user_input.scoring_success">of achievement</span>\n                        </h1>\n                    </div>\n\n                    <div class="page certification-content">\n                        <div class="oe_structure"/>\n                        <div t-if="user_input.scoring_success">\n                        <div class="oe_structure"/>\n                            <p> <span>This certificate is presented to</span>\n                                <br/>\n                                <t t-set="certif_style" t-value="''"/>\n                                <t t-set="certified_name" t-value="user_input.partner_id.name or user_input.email or ''"/>\n                                <t t-if="len(certified_name) &gt; 35 and layout_template == 'classic'">\n                                    <t t-set="certif_style" t-value="certif_style + 'font-size: 20px; line-height: 4; font-family: certification-serif;'"/>\n                                </t>\n                                <t t-elif="layout_template == 'modern'">\n                                    <t t-if="len(certified_name) &gt; 45">\n                                        <t t-set="certif_style" t-value="certif_style + 'font-size: 20px; line-height: 4;'"/>\n                                    </t>\n                                    <t t-elif="len(certified_name) &gt; 35">\n                                        <t t-set="certif_style" t-value="certif_style + 'font-size: 30px; line-height: 4;'"/>\n                                    </t>\n                                    <t t-elif="len(certified_name) &gt; 20">\n                                        <t t-set="certif_style" t-value="certif_style + 'font-size: 40px; line-height: 4;'"/>\n                                    </t>\n                                </t>\n                                <t t-else="">\n                                    <t t-set="certif_style" t-value="certif_style + 'font-size: 30px; line-height: 4;'"/>\n                                </t>\n                                <span t-att-style="certif_style" class="user-name" t-out="certified_name">DEMO_CERTIFIED_NAME</span>\n\n                                <br/> <span>by</span> <span class="certification-company" t-field="user_input.create_uid.sudo().company_id.display_name">Odoo</span> <span>for successfully completing</span>\n                                <br/><b><span class="certification-name" t-field="user_input.survey_id.display_name">Functional Training</span></b>\n                             </p>\n                            <div class="oe_structure"/>\n                        </div>\n                        <div t-else="" class="certification-failed">\n                            <p>Certification Failed</p>\n                            <div class="oe_structure"/>\n                        </div>\n                        <div class="oe_structure"/>\n                    </div>\n\n                    <div class="certification-bottom">\n                        <div class="oe_structure"/>\n                        <div class="certification-date-wrapper">\n                            <span class="certification-date" t-field="user_input.create_date" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-08-18</span>\n                            <span>Date</span>\n                        </div>\n                        <div class="certification-company">\n                            <span class="certification-company-logo" t-field="user_input.create_uid.sudo().company_id.logo" t-options="{'widget': 'image'}" role="img"/>\n                        </div>\n                    </div>\n                    <div t-if="user_input.test_entry" class="test-entry"/>\n                    <div class="certification-number" t-if="user_input.scoring_success">\n                        Certification n°<span t-out="str(user_input.id).rjust(10, '0')">0000000010</span>\n                    </div>\n                </div>\n            </div>\n        </t>\n\n        	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
896	16	\N	1	1	certification_report_view	\N	survey.certification_report_view	qweb	survey/report/survey_templates.xml	primary	{"en_US": "<t t-name=\\"survey.certification_report_view\\">\\n            <t t-call=\\"web.html_container\\">\\n                <t t-foreach=\\"docs\\" t-as=\\"user_input\\">\\n                    <t t-set=\\"layout_values\\" t-value=\\"user_input.survey_id.certification_report_layout.split('_') if user_input.survey_id.certification_report_layout else ['modern', 'purple']\\"/>\\n                    <t t-set=\\"layout_template\\" t-value=\\"layout_values[0]\\"/>\\n                    <t t-set=\\"layout_color\\" t-value=\\"layout_values[1]\\"/>\\n                    <t t-call=\\"survey.certification_report_view_general\\"/>\\n                </t>\\n            </t>\\n        </t>"}	<?xml version="1.0"?>\n<t t-name="survey.certification_report_view">\n            <t t-call="web.html_container">\n                <t t-foreach="docs" t-as="user_input">\n                    <t t-set="layout_values" t-value="user_input.survey_id.certification_report_layout.split('_') if user_input.survey_id.certification_report_layout else ['modern', 'purple']"/>\n                    <t t-set="layout_template" t-value="layout_values[0]"/>\n                    <t t-set="layout_color" t-value="layout_values[1]"/>\n                    <t t-call="survey.certification_report_view_general"/>\n                </t>\n            </t>\n        </t>\n    	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
897	16	\N	1	1	survey.survey.view.form	survey.survey	\N	form	survey/views/survey_survey_views.xml	primary	{"en_US": "<form string=\\"Survey\\" class=\\"o_survey_form\\">\\n                <field name=\\"id\\" invisible=\\"1\\"/>\\n                <field name=\\"session_state\\" invisible=\\"1\\"/>\\n                <field name=\\"question_ids\\" invisible=\\"1\\"/>\\n                <field name=\\"session_available\\" invisible=\\"1\\"/>\\n                <header>\\n                    <button name=\\"action_send_survey\\" string=\\"Share\\" type=\\"object\\" class=\\"oe_highlight\\" invisible=\\"not active\\"/>\\n                    <button name=\\"action_result_survey\\" string=\\"See results\\" type=\\"object\\" class=\\"oe_highlight\\" invisible=\\"answer_done_count &lt;= 0\\"/>\\n                    <button name=\\"action_start_session\\" string=\\"Create Live Session\\" type=\\"object\\" class=\\"d-none d-sm-block\\" invisible=\\"session_state or not active or not session_available\\"/>\\n                    <button name=\\"action_open_session_manager\\" string=\\"Open Session Manager\\" type=\\"object\\" class=\\"d-none d-sm-block\\" invisible=\\"not session_state\\"/>\\n                    <button name=\\"action_end_session\\" string=\\"Close Live Session\\" type=\\"object\\" class=\\"d-none d-sm-block\\" invisible=\\"session_state not in ['ready', 'in_progress']\\"/>\\n                    <button name=\\"action_test_survey\\" string=\\"Test\\" type=\\"object\\" invisible=\\"not active or not question_ids\\"/>\\n                    <button name=\\"action_unarchive\\" string=\\"Reopen\\" class=\\"btn-primary\\" type=\\"object\\" invisible=\\"active\\"/>\\n                    <button name=\\"action_archive\\" string=\\"Close\\" type=\\"object\\" invisible=\\"not active\\"/>\\n                </header>\\n                <sheet>\\n                    <div class=\\"oe_button_box\\" name=\\"button_box\\">\\n                        <button name=\\"action_survey_user_input\\" type=\\"object\\" class=\\"oe_stat_button\\" invisible=\\"access_mode == 'public'\\" icon=\\"fa-envelope-o\\">\\n                            <field string=\\"Registered\\" name=\\"answer_count\\" widget=\\"statinfo\\"/>\\n                        </button>\\n                        <button name=\\"action_survey_user_input_certified\\" type=\\"object\\" class=\\"oe_stat_button\\" invisible=\\"not certification\\" icon=\\"fa-trophy\\">\\n                            <field string=\\"Certified\\" name=\\"success_count\\" widget=\\"statinfo\\"/>\\n                        </button>\\n                        <button name=\\"action_survey_user_input_completed\\" type=\\"object\\" class=\\"oe_stat_button\\" icon=\\"fa-check-square-o\\">\\n                            <field string=\\"Participants\\" name=\\"answer_done_count\\" widget=\\"statinfo\\"/>\\n                        </button>\\n                    </div>\\n                    <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                    <field name=\\"background_image\\" widget=\\"image\\" class=\\"oe_avatar\\"/>\\n                    <field name=\\"allowed_survey_types\\" invisible=\\"True\\"/>\\n                    <field name=\\"survey_type\\" widget=\\"radio_selection_with_filter\\" options=\\"{'horizontal': True, 'allowed_selection_field': 'allowed_survey_types'}\\" class=\\"o_field_radio\\" invisible=\\"not allowed_survey_types\\"/>\\n                    <div class=\\"oe_title\\" style=\\"width: 100%;\\">\\n                        <h1>\\n                            <field name=\\"title\\" options=\\"{'line_breaks': False}\\" widget=\\"text\\" placeholder=\\"e.g. Satisfaction Survey\\"/>\\n                        </h1>\\n                    </div>\\n                    <group>\\n                        <group class=\\"ps-md-0\\">\\n                            <field name=\\"user_id\\" domain=\\"[('share', '=', False)]\\" widget=\\"many2one_avatar_user\\"/>\\n                            <field name=\\"active\\" invisible=\\"1\\"/>\\n                            <field name=\\"has_conditional_questions\\" invisible=\\"1\\"/>\\n                            <field name=\\"lang_ids\\" widget=\\"many2many_tags\\" placeholder=\\"All installed languages\\" options=\\"{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}\\"/>\\n                        </group>\\n                        <group class=\\"ps-3 ps-md-0 ps-lg-3\\">\\n                            <field name=\\"restrict_user_ids\\" widget=\\"many2many_tags_avatar\\"/>\\n                        </group>\\n                    </group>\\n                    <notebook>\\n                        <page string=\\"Questions\\" name=\\"questions\\">\\n                            <field name=\\"question_and_page_ids\\" nolabel=\\"1\\" widget=\\"question_page_one2many\\" mode=\\"list,kanban\\" context=\\"{'default_survey_id': id}\\">\\n                                <list decoration-bf=\\"is_page\\">\\n                                    <field name=\\"sequence\\" widget=\\"handle\\"/>\\n                                    <field name=\\"title\\" widget=\\"survey_description_page\\"/>\\n                                    <field name=\\"background_image\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"question_type\\"/>\\n                                    <field name=\\"is_time_limited\\" string=\\"Time Limit\\" optional=\\"hide\\" column_invisible=\\"not parent.session_available\\"/>\\n                                    <field name=\\"time_limit\\" optional=\\"hide\\" invisible=\\"not is_time_limited\\" column_invisible=\\"not parent.session_available\\"/>\\n                                    <field name=\\"is_time_customized\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"constr_mandatory\\" optional=\\"hide\\"/>\\n                                    <field name=\\"is_page\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"questions_selection\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"survey_id\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"random_questions_count\\" column_invisible=\\"parent.questions_selection == 'all'\\" invisible=\\"not is_page\\"/>\\n                                    <field name=\\"triggering_question_ids\\" column_invisible=\\"True\\"/>\\n                                    <field name=\\"triggering_answer_ids\\" column_invisible=\\"True\\" widget=\\"many2many_tags\\"/> <!-- widget to fetch display_name -->\\n                                    <widget name=\\"survey_question_trigger\\" width=\\"30px\\"/>\\n                                    <button name=\\"copy\\" type=\\"object\\" icon=\\"fa-clone\\" title=\\"Duplicate Question\\"/>\\n                                    <control>\\n                                        <create name=\\"add_question_control\\" string=\\"Add a question\\"/>\\n                                        <create name=\\"add_section_control\\" string=\\"Add a section\\" context=\\"{'default_is_page': True, 'default_questions_selection': 'all'}\\"/>\\n                                    </control>\\n                                </list>\\n                            </field>\\n                        </page>\\n                        <page string=\\"Options\\" name=\\"options\\">\\n                            <group name=\\"options\\">\\n                                <group string=\\"Questions\\" name=\\"questions\\">\\n                                    <field name=\\"questions_layout\\" widget=\\"radio\\" force_save=\\"1\\" readonly=\\"session_state in ['ready', 'in_progress'] or survey_type == 'live_session'\\"/>\\n                                    <field name=\\"progression_mode\\" widget=\\"radio\\" invisible=\\"questions_layout == 'one_page' or survey_type == 'live_session'\\"/>\\n                                    <field name=\\"questions_selection\\" widget=\\"radio\\" invisible=\\"survey_type == 'live_session'\\"/>\\n                                    <field name=\\"users_can_go_back\\" string=\\"Allow Roaming\\" invisible=\\"questions_layout == 'one_page' or survey_type == 'live_session'\\"/>\\n                                </group>\\n                                <group string=\\"Participants\\" name=\\"participants\\">\\n                                    <field name=\\"access_mode\\" force_save=\\"1\\" readonly=\\"survey_type == 'live_session'\\"/>\\n                                    <field name=\\"users_login_required\\"/>\\n                                    <label for=\\"is_attempts_limited\\" string=\\"Limit Attempts\\" invisible=\\"survey_type == 'live_session' or access_mode == 'public' and not users_login_required\\"/>\\n                                    <div class=\\"o_checkbox_optional_field\\" invisible=\\"survey_type == 'live_session' or access_mode == 'public' and not users_login_required\\">\\n                                        <field name=\\"is_attempts_limited\\" nolabel=\\"1\\"/>\\n                                        <div invisible=\\"not is_attempts_limited\\">\\n                                            to <field name=\\"attempts_limit\\" nolabel=\\"1\\" class=\\"oe_inline\\"/> attempts\\n                                        </div>\\n                                    </div>\\n                                </group>\\n                                <group string=\\"Time &amp; Scoring\\" name=\\"scoring\\" invisible=\\"survey_type == 'survey'\\">\\n                                    <!-- Time -->\\n                                    <label for=\\"is_time_limited\\" string=\\"Survey Time Limit\\" invisible=\\"survey_type == 'live_session'\\"/>\\n                                    <div class=\\"o_checkbox_optional_field\\" name=\\"is_time_limited\\" invisible=\\"survey_type == 'live_session'\\">\\n                                        <field name=\\"is_time_limited\\" nolabel=\\"1\\"/>\\n                                        <div invisible=\\"not is_time_limited\\">\\n                                            <field name=\\"time_limit\\" widget=\\"float_time\\" nolabel=\\"1\\" class=\\"oe_inline\\"/> minutes\\n                                        </div>\\n                                    </div>\\n                                    <!-- Scoring -->\\n                                    <field name=\\"scoring_type\\" widget=\\"radio\\" force_save=\\"1\\"/>\\n                                    <field name=\\"scoring_success_min\\" invisible=\\"scoring_type == 'no_scoring'\\"/>\\n                                    <label for=\\"certification\\" invisible=\\"survey_type == 'live_session' or scoring_type == 'no_scoring'\\"/>\\n                                    <div class=\\"o_checkbox_optional_field\\" name=\\"certification\\" invisible=\\"survey_type == 'live_session'\\">\\n                                        <field name=\\"certification\\" invisible=\\"scoring_type == 'no_scoring'\\"/>\\n                                        <div invisible=\\"not certification\\" class=\\"w-100\\">\\n                                            <field name=\\"certification_report_layout\\" placeholder=\\"Pick a Style...\\" class=\\"w-50\\"/>\\n                                            <button name=\\"action_survey_preview_certification_template\\" string=\\"Preview\\" type=\\"object\\" icon=\\"fa-external-link\\" target=\\"_blank\\" class=\\"btn-link pt-0\\"/>\\n                                        </div>\\n                                    </div>\\n                                    <field name=\\"certification_mail_template_id\\" placeholder=\\"Pick a Template...\\" invisible=\\"not certification\\"/>\\n                                    <label for=\\"certification_give_badge\\" invisible=\\"not certification or not users_login_required\\"/>\\n                                    <div class=\\"float-start o_checkbox_optional_field\\" invisible=\\"not certification or not users_login_required\\">\\n                                        <field name=\\"certification_give_badge\\"/>\\n                                        <div invisible=\\"not certification_give_badge\\">\\n                                            <field name=\\"certification_badge_id\\" placeholder=\\"Pick a Badge...\\" invisible=\\"not certification_give_badge or certification_badge_id\\" required=\\"certification_give_badge\\" domain=\\"[('survey_id', '=', id), ('survey_id', '!=', False)]\\" context=\\"{'default_name': title,                                                         'default_description': 'Congratulations, you have succeeded this certification',                                                         'default_rule_auth': 'nobody',                                                         'default_level': None,                                                         'form_view_ref': 'survey.gamification_badge_form_view_simplified'}\\"/>\\n                                            <field name=\\"certification_badge_id_dummy\\" invisible=\\"not certification_give_badge or not certification_badge_id\\" placeholder=\\"Pick a Badge...\\" options=\\"{'no_create': True}\\" context=\\"{'form_view_ref': 'survey.gamification_badge_form_view_simplified'}\\"/>\\n                                        </div>\\n                                    </div>\\n                                </group>\\n                                <group string=\\"Live Session\\" name=\\"live_session\\" invisible=\\"not session_available\\">\\n                                    <field name=\\"access_token\\" invisible=\\"1\\"/>  <!-- dependency of 'session_code' -->\\n                                    <field name=\\"session_code\\"/>\\n                                    <field name=\\"session_link\\" widget=\\"CopyClipboardChar\\"/>\\n                                    <field name=\\"session_speed_rating\\" invisible=\\"scoring_type == 'no_scoring'\\"/>\\n                                    <field name=\\"session_speed_rating_time_limit\\" invisible=\\"scoring_type == 'no_scoring' or not session_speed_rating\\"/>\\n                                </group>\\n                            </group>\\n                        </page>\\n                        <page string=\\"Description\\" name=\\"description\\">\\n                            <field name=\\"description\\" placeholder=\\"e.g. &quot;The following Survey will help us...&quot;\\" options=\\"{'embedded_components': false}\\" nolabel=\\"1\\"/>\\n                        </page>\\n                        <page string=\\"End Message\\" name=\\"description_done\\">\\n                            <field name=\\"description_done\\" placeholder=\\"e.g. &quot;Thank you very much for your feedback!&quot;\\" options=\\"{'embedded_components': false}\\" nolabel=\\"1\\"/>\\n                        </page>\\n                    </notebook>\\n                </sheet>\\n                <chatter/>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Survey" class="o_survey_form">\n                <field name="id" invisible="1"/>\n                <field name="session_state" invisible="1"/>\n                <field name="question_ids" invisible="1"/>\n                <field name="session_available" invisible="1"/>\n                <header>\n                    <button name="action_send_survey" string="Share" type="object" class="oe_highlight" invisible="not active"/>\n                    <button name="action_result_survey" string="See results" type="object" class="oe_highlight" invisible="answer_done_count &lt;= 0"/>\n                    <button name="action_start_session" string="Create Live Session" type="object" class="d-none d-sm-block" invisible="session_state or not active or not session_available"/>\n                    <button name="action_open_session_manager" string="Open Session Manager" type="object" class="d-none d-sm-block" invisible="not session_state"/>\n                    <button name="action_end_session" string="Close Live Session" type="object" class="d-none d-sm-block" invisible="session_state not in ['ready', 'in_progress']"/>\n                    <button name="action_test_survey" string="Test" type="object" invisible="not active or not question_ids"/>\n                    <button name="action_unarchive" string="Reopen" class="btn-primary" type="object" invisible="active"/>\n                    <button name="action_archive" string="Close" type="object" invisible="not active"/>\n                </header>\n                <sheet>\n                    <div class="oe_button_box" name="button_box">\n                        <button name="action_survey_user_input" type="object" class="oe_stat_button" invisible="access_mode == 'public'" icon="fa-envelope-o">\n                            <field string="Registered" name="answer_count" widget="statinfo"/>\n                        </button>\n                        <button name="action_survey_user_input_certified" type="object" class="oe_stat_button" invisible="not certification" icon="fa-trophy">\n                            <field string="Certified" name="success_count" widget="statinfo"/>\n                        </button>\n                        <button name="action_survey_user_input_completed" type="object" class="oe_stat_button" icon="fa-check-square-o">\n                            <field string="Participants" name="answer_done_count" widget="statinfo"/>\n                        </button>\n                    </div>\n                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                    <field name="background_image" widget="image" class="oe_avatar"/>\n                    <field name="allowed_survey_types" invisible="True"/>\n                    <field name="survey_type" widget="radio_selection_with_filter" options="{'horizontal': True, 'allowed_selection_field': 'allowed_survey_types'}" class="o_field_radio" invisible="not allowed_survey_types"/>\n                    <div class="oe_title" style="width: 100%;">\n                        <h1>\n                            <field name="title" options="{'line_breaks': False}" widget="text" placeholder="e.g. Satisfaction Survey"/>\n                        </h1>\n                    </div>\n                    <group>\n                        <group class="ps-md-0">\n                            <field name="user_id" domain="[('share', '=', False)]" widget="many2one_avatar_user"/>\n                            <field name="active" invisible="1"/>\n                            <field name="has_conditional_questions" invisible="1"/>\n                            <field name="lang_ids" widget="many2many_tags" placeholder="All installed languages" options="{'no_quick_create': True, 'no_create_edit': True, 'no_open': True}"/>\n                        </group>\n                        <group class="ps-3 ps-md-0 ps-lg-3">\n                            <field name="restrict_user_ids" widget="many2many_tags_avatar"/>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page string="Questions" name="questions">\n                            <field name="question_and_page_ids" nolabel="1" widget="question_page_one2many" mode="list,kanban" context="{'default_survey_id': id}">\n                                <list decoration-bf="is_page">\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="title" widget="survey_description_page"/>\n                                    <field name="background_image" column_invisible="True"/>\n                                    <field name="question_type"/>\n                                    <field name="is_time_limited" string="Time Limit" optional="hide" column_invisible="not parent.session_available"/>\n                                    <field name="time_limit" optional="hide" invisible="not is_time_limited" column_invisible="not parent.session_available"/>\n                                    <field name="is_time_customized" column_invisible="True"/>\n                                    <field name="constr_mandatory" optional="hide"/>\n                                    <field name="is_page" column_invisible="True"/>\n                                    <field name="questions_selection" column_invisible="True"/>\n                                    <field name="survey_id" column_invisible="True"/>\n                                    <field name="random_questions_count" column_invisible="parent.questions_selection == 'all'" invisible="not is_page"/>\n                                    <field name="triggering_question_ids" column_invisible="True"/>\n                                    <field name="triggering_answer_ids" column_invisible="True" widget="many2many_tags"/> <!-- widget to fetch display_name -->\n                                    <widget name="survey_question_trigger" width="30px"/>\n                                    <button name="copy" type="object" icon="fa-clone" title="Duplicate Question"/>\n                                    <control>\n                                        <create name="add_question_control" string="Add a question"/>\n                                        <create name="add_section_control" string="Add a section" context="{'default_is_page': True, 'default_questions_selection': 'all'}"/>\n                                    </control>\n                                </list>\n                            </field>\n                        </page>\n                        <page string="Options" name="options">\n                            <group name="options">\n                                <group string="Questions" name="questions">\n                                    <field name="questions_layout" widget="radio" force_save="1" readonly="session_state in ['ready', 'in_progress'] or survey_type == 'live_session'"/>\n                                    <field name="progression_mode" widget="radio" invisible="questions_layout == 'one_page' or survey_type == 'live_session'"/>\n                                    <field name="questions_selection" widget="radio" invisible="survey_type == 'live_session'"/>\n                                    <field name="users_can_go_back" string="Allow Roaming" invisible="questions_layout == 'one_page' or survey_type == 'live_session'"/>\n                                </group>\n                                <group string="Participants" name="participants">\n                                    <field name="access_mode" force_save="1" readonly="survey_type == 'live_session'"/>\n                                    <field name="users_login_required"/>\n                                    <label for="is_attempts_limited" string="Limit Attempts" invisible="survey_type == 'live_session' or access_mode == 'public' and not users_login_required"/>\n                                    <div class="o_checkbox_optional_field" invisible="survey_type == 'live_session' or access_mode == 'public' and not users_login_required">\n                                        <field name="is_attempts_limited" nolabel="1"/>\n                                        <div invisible="not is_attempts_limited">\n                                            to <field name="attempts_limit" nolabel="1" class="oe_inline"/> attempts\n                                        </div>\n                                    </div>\n                                </group>\n                                <group string="Time &amp; Scoring" name="scoring" invisible="survey_type == 'survey'">\n                                    <!-- Time -->\n                                    <label for="is_time_limited" string="Survey Time Limit" invisible="survey_type == 'live_session'"/>\n                                    <div class="o_checkbox_optional_field" name="is_time_limited" invisible="survey_type == 'live_session'">\n                                        <field name="is_time_limited" nolabel="1"/>\n                                        <div invisible="not is_time_limited">\n                                            <field name="time_limit" widget="float_time" nolabel="1" class="oe_inline"/> minutes\n                                        </div>\n                                    </div>\n                                    <!-- Scoring -->\n                                    <field name="scoring_type" widget="radio" force_save="1"/>\n                                    <field name="scoring_success_min" invisible="scoring_type == 'no_scoring'"/>\n                                    <label for="certification" invisible="survey_type == 'live_session' or scoring_type == 'no_scoring'"/>\n                                    <div class="o_checkbox_optional_field" name="certification" invisible="survey_type == 'live_session'">\n                                        <field name="certification" invisible="scoring_type == 'no_scoring'"/>\n                                        <div invisible="not certification" class="w-100">\n                                            <field name="certification_report_layout" placeholder="Pick a Style..." class="w-50"/>\n                                            <button name="action_survey_preview_certification_template" string="Preview" type="object" icon="fa-external-link" target="_blank" class="btn-link pt-0"/>\n                                        </div>\n                                    </div>\n                                    <field name="certification_mail_template_id" placeholder="Pick a Template..." invisible="not certification"/>\n                                    <label for="certification_give_badge" invisible="not certification or not users_login_required"/>\n                                    <div class="float-start o_checkbox_optional_field" invisible="not certification or not users_login_required">\n                                        <field name="certification_give_badge"/>\n                                        <div invisible="not certification_give_badge">\n                                            <field name="certification_badge_id" placeholder="Pick a Badge..." invisible="not certification_give_badge or certification_badge_id" required="certification_give_badge" domain="[('survey_id', '=', id), ('survey_id', '!=', False)]" context="{'default_name': title,                                                         'default_description': 'Congratulations, you have succeeded this certification',                                                         'default_rule_auth': 'nobody',                                                         'default_level': None,                                                         'form_view_ref': 'survey.gamification_badge_form_view_simplified'}"/>\n                                            <field name="certification_badge_id_dummy" invisible="not certification_give_badge or not certification_badge_id" placeholder="Pick a Badge..." options="{'no_create': True}" context="{'form_view_ref': 'survey.gamification_badge_form_view_simplified'}"/>\n                                        </div>\n                                    </div>\n                                </group>\n                                <group string="Live Session" name="live_session" invisible="not session_available">\n                                    <field name="access_token" invisible="1"/>  <!-- dependency of 'session_code' -->\n                                    <field name="session_code"/>\n                                    <field name="session_link" widget="CopyClipboardChar"/>\n                                    <field name="session_speed_rating" invisible="scoring_type == 'no_scoring'"/>\n                                    <field name="session_speed_rating_time_limit" invisible="scoring_type == 'no_scoring' or not session_speed_rating"/>\n                                </group>\n                            </group>\n                        </page>\n                        <page string="Description" name="description">\n                            <field name="description" placeholder="e.g. &quot;The following Survey will help us...&quot;" options="{'embedded_components': false}" nolabel="1"/>\n                        </page>\n                        <page string="End Message" name="description_done">\n                            <field name="description_done" placeholder="e.g. &quot;Thank you very much for your feedback!&quot;" options="{'embedded_components': false}" nolabel="1"/>\n                        </page>\n                    </notebook>\n                </sheet>\n                <chatter/>\n            </form>\n        	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
