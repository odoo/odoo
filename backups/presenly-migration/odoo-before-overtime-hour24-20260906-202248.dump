ate == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state in ('waiting', 'cancelled')"/>\n                            <field name="decision_user_id" widget="many2one_avatar_user" optional="show"/>\n                            <field name="decision_date" optional="show"/>\n                            <field name="decision_note" optional="hide"/>\n                        </list>\n                    </field>\n                </sheet>\n            </form>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
