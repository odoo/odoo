911	16	\N	1	1	Form view for survey question	survey.question	\N	form	survey/views/survey_question_views.xml	primary	{"en_US": "<form string=\\"Survey Question\\" create=\\"false\\" class=\\"o_survey_question_view_form\\">\\n                <field name=\\"is_placed_before_trigger\\" invisible=\\"1\\"/>\\n                <div class=\\"alert alert-warning text-center\\" role=\\"alert\\" invisible=\\"not is_placed_before_trigger\\">\\n                    ⚠️ This question is positioned before some or all of its triggers and could be skipped.\\n                </div>\\n                <field name=\\"is_page\\" invisible=\\"1\\"/>\\n                <field name=\\"page_id\\" invisible=\\"1\\" required=\\"False\\"/>\\n                <field name=\\"sequence\\" invisible=\\"1\\"/>\\n                <field name=\\"scoring_type\\" invisible=\\"1\\"/>\\n                <field name=\\"has_image_only_suggested_answer\\" invisible=\\"1\\"/>\\n                <sheet>\\n                    <field name=\\"survey_id\\" invisible=\\"not context.get('show_survey_field')\\" readonly=\\"1\\"/>\\n                    <div class=\\"float-end d-flex flex-column text-center\\" invisible=\\"not is_page\\">\\n                        <label for=\\"background_image\\"/>\\n                        <field name=\\"background_image\\" widget=\\"image\\" class=\\"oe_avatar\\"/>\\n                    </div>\\n                    <div class=\\"oe_title\\" style=\\"width: 100%;\\">\\n                        <label for=\\"title\\" string=\\"Section\\" invisible=\\"not is_page\\"/>\\n                        <label for=\\"title\\" string=\\"Question\\" invisible=\\"is_page\\"/><br/>\\n                        <field name=\\"title\\" placeholder=\\"e.g. &quot;What is the...&quot;\\" colspan=\\"4\\"/>\\n                        <field name=\\"questions_selection\\" invisible=\\"1\\"/>\\n                    </div>\\n                    <group class=\\"o_label_nowrap\\" invisible=\\"not is_page or questions_selection == 'all'\\">\\n                        <field name=\\"random_questions_count\\"/>\\n                    </group>\\n                    <group invisible=\\"is_page\\">\\n                        <group>\\n                            <field name=\\"question_type\\" widget=\\"radio\\" required=\\"not is_page\\"/>\\n                        </group>\\n                        <group>\\n                            <div class=\\"mx-lg-auto w-lg-50 d-none d-sm-block o_preview_questions bg-light\\" colspan=\\"2\\">\\n                                <!-- Multiple choice: only one answer -->\\n                                <div invisible=\\"question_type != 'simple_choice'\\" role=\\"img\\" aria-label=\\"Multiple choice with one answer\\" title=\\"Multiple choice with one answer\\">\\n                                    <span>Which is yellow?</span><br/>\\n                                    <div class=\\"o_preview_questions_choice mb-2\\"><i class=\\"fa fa-circle-o  fa-lg me-2\\"/>answer</div>\\n                                    <div class=\\"o_preview_questions_choice mb-2\\"><i class=\\"fa fa-dot-circle-o fa-lg me-2\\"/>answer</div>\\n                                    <div class=\\"o_preview_questions_choice\\"><i class=\\"fa fa-circle-o  fa-lg me-2\\"/>answer</div>\\n                                </div>\\n                                <!-- Multiple choice: multiple answers allowed -->\\n                                <div invisible=\\"question_type != 'multiple_choice'\\" role=\\"img\\" aria-label=\\"Multiple choice with multiple answers\\" title=\\"Multiple choice with multiple answers\\">\\n                                    <span>Which are yellow?</span><br/>\\n                                    <div class=\\"o_preview_questions_choice mb-2\\"><i class=\\"fa fa-square-o fa-lg me-2\\"/>answer</div>\\n                                    <div class=\\"o_preview_questions_choice mb-2\\"><i class=\\"fa fa-check-square-o fa-lg me-2\\"/>answer</div>\\n                                    <div class=\\"o_preview_questions_choice\\"><i class=\\"fa fa-check-square-o fa-lg me-2\\"/>answer</div>\\n                                </div>\\n                                <!-- Multiple Lines Text Zone -->\\n                                <div invisible=\\"question_type != 'text_box'\\">\\n                                    <span>Name all the animals</span><br/>\\n                                    <i class=\\"fa fa-align-justify fa-4x\\" role=\\"img\\" aria-label=\\"Multiple lines\\" title=\\"Multiple Lines\\"/>\\n                                </div>\\n                                <!-- Single Line Text Zone -->\\n                                <div invisible=\\"question_type != 'char_box'\\">\\n                                    <span>Name one animal</span><br/>\\n                                    <i class=\\"fa fa-minus fa-4x\\" role=\\"img\\" aria-label=\\"Single Line\\" title=\\"Single Line\\"/>\\n                                </div>\\n                                <!-- Numerical Value -->\\n                                <div invisible=\\"question_type != 'numerical_box'\\">\\n                                    <span>How many ...?</span><br/>\\n                                    <i class=\\"fa fa-2x\\" role=\\"img\\" aria-label=\\"Numeric\\" title=\\"Numeric\\">123 </i>\\n                                    <i class=\\"fa fa-2x fa-sort\\" role=\\"img\\" aria-label=\\"Numeric\\"/>\\n                                </div>\\n                                <!-- Date -->\\n                                <div invisible=\\"question_type != 'date'\\">\\n                                    <span>When is Christmas?</span><br/>\\n                                    <p class=\\"o_datetime border-0\\">YYYY-MM-DD\\n                                        <i class=\\"fa fa-calendar\\" role=\\"img\\" aria-label=\\"Calendar\\" title=\\"Calendar\\"/>\\n                                    </p>\\n                                </div>\\n                                <!-- Date and Time -->\\n                                <div invisible=\\"question_type != 'datetime'\\">\\n                                    <span>When does ... start?</span><br/>\\n                                    <p class=\\"o_datetime border-0\\">YYYY-MM-DD hh:mm:ss\\n                                        <i class=\\"fa fa-calendar\\" role=\\"img\\" aria-label=\\"Calendar\\" title=\\"Calendar\\"/>\\n                                    </p>\\n                                </div>\\n                                <!-- Matrix -->\\n                                <div invisible=\\"question_type != 'matrix'\\">\\n                                    <div class=\\"row o_matrix_head\\">\\n                                        <div class=\\"col-3\\"/>\\n                                        <div class=\\"col-3\\">ans</div>\\n                                        <div class=\\"col-3\\">ans</div>\\n                                        <div class=\\"col-3\\">ans</div>\\n                                    </div>\\n                                    <div class=\\"row o_matrix_row\\">\\n                                        <div class=\\"col-3\\">Row1</div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Not checked\\" title=\\"Not checked\\"/></div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-dot-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Checked\\" title=\\"Checked\\"/></div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Not checked\\" title=\\"Not checked\\"/></div>\\n                                    </div>\\n                                    <div class=\\"row o_matrix_row\\">\\n                                        <div class=\\"col-3\\">Row2</div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Not checked\\" title=\\"Not checked\\"/></div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Not checked\\" title=\\"Not checked\\"/></div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-dot-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Checked\\" title=\\"Checked\\"/></div>\\n                                    </div>\\n                                    <div class=\\"row o_matrix_row\\">\\n                                        <div class=\\"col-3\\">Row3</div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-dot-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Checked\\" title=\\"Checked\\"/></div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Not checked\\" title=\\"Not checked\\"/></div>\\n                                        <div class=\\"col-3\\"><i class=\\"fa fa-circle-o fa-lg\\" role=\\"img\\" aria-label=\\"Not checked\\" title=\\"Not checked\\"/></div>\\n                                    </div>\\n                                </div>\\n                                <!-- Scale -->\\n                                <div invisible=\\"question_type != 'scale'\\">\\n                                    <span>Do you like it?</span><br/>\\n                                    <div class=\\"btn-group w-100\\" role=\\"group\\" aria-label=\\"Scale\\">\\n                                        <a role=\\"button\\" type=\\"button\\" class=\\"btn btn-secondary disabled o_preview_questions_choice\\">1</a>\\n                                        <a role=\\"button\\" type=\\"button\\" class=\\"btn btn-secondary disabled o_preview_questions_choice\\">2</a>\\n                                        <a role=\\"button\\" type=\\"button\\" class=\\"btn btn-secondary disabled o_preview_questions_choice\\">3</a>\\n                                    </div>\\n                                    <div class=\\"d-flex justify-content-between\\">\\n                                        <div>Label</div>\\n                                        <div>Label</div>\\n                                        <div>Label</div>\\n                                    </div>\\n                                </div>\\n                            </div>\\n                        </group>\\n                    </group>\\n                    <notebook>\\n                        <page string=\\"Answers\\" name=\\"answers\\" invisible=\\"is_page or question_type == 'text_box' or scoring_type == 'no_scoring' and question_type in ['numerical_box', 'date', 'datetime']\\">\\n                            <group>\\n                                <group invisible=\\"question_type != 'scale'\\">\\n                                    <field name=\\"scale_min\\" placeholder=\\"Scale Minimum Value (0 to 10)\\"/>\\n                                    <field name=\\"scale_max\\" placeholder=\\"Scale Maximum Value (0 to 10)\\"/>\\n                                </group>\\n                                <group invisible=\\"question_type != 'scale'\\">\\n                                    <field name=\\"scale_min_label\\" placeholder=\\"Not likely at all\\"/>\\n                                    <field name=\\"scale_mid_label\\" placeholder=\\"Neutral\\"/>\\n                                    <field name=\\"scale_max_label\\" placeholder=\\"Extremely likely\\"/>\\n                                </group>\\n                                <group invisible=\\"question_type not in ['char_box', 'numerical_box', 'date', 'datetime']\\">\\n                                    <field name=\\"answer_numerical_box\\" string=\\"Correct Answer\\" class=\\"oe_inline\\" invisible=\\"question_type != 'numerical_box'\\" required=\\"is_scored_question and question_type == 'numerical_box'\\"/>\\n                                    <field name=\\"answer_date\\" string=\\"Correct Answer\\" class=\\"oe_inline\\" invisible=\\"question_type != 'date'\\" required=\\"is_scored_question and question_type == 'date'\\"/>\\n                                    <field name=\\"answer_datetime\\" string=\\"Correct Answer\\" class=\\"oe_inline\\" invisible=\\"question_type != 'datetime'\\" required=\\"is_scored_question and question_type == 'datetime'\\"/>\\n\\n                                    <field name=\\"validation_email\\" invisible=\\"question_type != 'char_box'\\"/>\\n                                    <field name=\\"save_as_email\\" invisible=\\"not validation_email or question_type != 'char_box'\\"/>\\n                                    <field name=\\"save_as_nickname\\" invisible=\\"question_type != 'char_box'\\"/>\\n                                </group>\\n\\n                                <group invisible=\\"scoring_type == 'no_scoring' or question_type not in ['numerical_box', 'date', 'datetime']\\">\\n                                    <label for=\\"is_scored_question\\"/>\\n                                    <div name=\\"survey_scored_question\\">\\n                                        <field name=\\"is_scored_question\\" nolabel=\\"1\\"/>\\n                                        <field name=\\"answer_score\\" class=\\"w-50 mx-2\\" invisible=\\"not is_scored_question\\" nolabel=\\"1\\"/>\\n                                        <span invisible=\\"not is_scored_question\\">Points</span>\\n                                    </div>\\n                                </group>\\n                            </group>\\n                            <field name=\\"suggested_answer_ids\\" context=\\"{'default_question_id': id}\\" invisible=\\"question_type not in ['simple_choice', 'multiple_choice', 'matrix']\\">\\n                                <list editable=\\"bottom\\">\\n                                    <field name=\\"sequence\\" widget=\\"handle\\"/>\\n                                    <field name=\\"value\\" string=\\"Choices\\" required=\\"not value_image\\"/>\\n                                    <field name=\\"is_correct\\" column_invisible=\\"parent.scoring_type == 'no_scoring' or parent.question_type == 'matrix'\\"/>\\n                                    <field name=\\"answer_score\\" column_invisible=\\"parent.scoring_type == 'no_scoring' or parent.question_type == 'matrix'\\"/>\\n                                    <field name=\\"value_image_filename\\" column_invisible=\\"not parent.has_image_only_suggested_answer\\"/>\\n                                    <field name=\\"value_image\\" width=\\"200px\\" filename=\\"value_image_filename\\" options=\\"{'accepted_file_extensions': 'image/*'}\\" column_invisible=\\"parent.question_type in ['matrix', 'scale']\\" required=\\"not value\\"/>\\n                                </list>\\n                            </field>\\n\\n                            <field name=\\"matrix_row_ids\\" context=\\"{'default_matrix_question_id': id}\\" invisible=\\"question_type != 'matrix'\\">\\n                                <list editable=\\"bottom\\">\\n                                    <field name=\\"sequence\\" widget=\\"handle\\"/>\\n                                    <field name=\\"value\\" string=\\"Rows\\"/>\\n                                </list>\\n                            </field>\\n                        </page>\\n                        <page string=\\"Description\\" name=\\"survey_description\\">\\n                            <field name=\\"description\\" widget=\\"html\\" options=\\"{'embedded_components': false}\\" placeholder=\\"e.g. Guidelines, instructions, picture, ... to help attendees answer\\"/>\\n                        </page>\\n                        <page string=\\"Options\\" name=\\"options\\" invisible=\\"is_page\\">\\n                            <group>\\n                                <group string=\\"Answers\\" invisible=\\"question_type == 'scale'\\">\\n                                    <!-- Global validation setting -->\\n                                    <field name=\\"validation_required\\" invisible=\\"question_type not in ['char_box', 'numerical_box', 'date', 'datetime']\\"/>\\n                                    <div class=\\"o_wrap_label o_form_label\\" invisible=\\"not validation_required\\">Min/Max Limits</div>\\n                                    <div class=\\"o_survey_question_validation_parameters\\" invisible=\\"not validation_required\\">\\n                                        <!-- Minima -->\\n                                        <field name=\\"validation_length_min\\" class=\\"o_survey_question_validation_inline\\" nolabel=\\"1\\" placeholder=\\"Minimum\\" invisible=\\"question_type != 'char_box'\\" required=\\"validation_required and question_type == 'char_box'\\"/>\\n                                        <field name=\\"validation_min_float_value\\" class=\\"o_survey_question_validation_inline\\" nolabel=\\"1\\" placeholder=\\"Minimum\\" invisible=\\"question_type != 'numerical_box'\\" required=\\"validation_required and question_type == 'numerical_box'\\"/>\\n                                        <field name=\\"validation_min_date\\" nolabel=\\"1\\" placeholder=\\"Minimum\\" invisible=\\"question_type != 'date'\\" required=\\"validation_required and question_type == 'date' and not validation_max_date\\"/>\\n                                        <field name=\\"validation_min_datetime\\" nolabel=\\"1\\" placeholder=\\"Minimum\\" invisible=\\"question_type != 'datetime'\\" required=\\"validation_required and question_type == 'datetime' and not validation_max_datetime\\"/>\\n\\n                                        <i class=\\"fa fa-long-arrow-right mx-2\\" aria-label=\\"Arrow icon\\" title=\\"Arrow\\"/>\\n                                        <!-- Maxima -->\\n                                        <field name=\\"validation_length_max\\" class=\\"o_survey_question_validation_inline\\" nolabel=\\"1\\" placeholder=\\"Maximum\\" invisible=\\"question_type != 'char_box'\\" required=\\"validation_required and question_type == 'char_box'\\"/>\\n                                        <field name=\\"validation_max_float_value\\" class=\\"o_survey_question_validation_inline\\" nolabel=\\"1\\" placeholder=\\"Maximum\\" invisible=\\"question_type != 'numerical_box'\\" required=\\"validation_required and question_type == 'numerical_box'\\"/>\\n                                        <field name=\\"validation_max_date\\" nolabel=\\"1\\" placeholder=\\"Maximum\\" invisible=\\"question_type != 'date'\\" required=\\"validation_required and question_type == 'date' and not validation_min_date\\"/>\\n                                        <field name=\\"validation_max_datetime\\" nolabel=\\"1\\" placeholder=\\"Maximum\\" invisible=\\"question_type != 'datetime'\\" required=\\"validation_required and question_type == 'datetime' and not validation_min_datetime\\"/>\\n                                    </div>\\n                                    <field name=\\"validation_error_msg\\" invisible=\\"not validation_required\\" placeholder=\\"Displayed when the answer entered is not valid.\\"/>\\n\\n                                    <field name=\\"matrix_subtype\\" invisible=\\"question_type != 'matrix'\\" required=\\"question_type == 'matrix'\\"/>\\n                                    <field name=\\"question_placeholder\\" invisible=\\"question_type not in ['text_box', 'char_box', 'date', 'datetime', 'numerical_box']\\" placeholder=\\"Help Participants know what to write\\"/>\\n                                    <field name=\\"comments_allowed\\" invisible=\\"question_type not in ['simple_choice', 'multiple_choice', 'matrix']\\"/>\\n                                    <field name=\\"comments_message\\" invisible=\\"question_type not in ['simple_choice', 'multiple_choice', 'matrix'] or not comments_allowed\\" placeholder=\\"If other, please specify:\\"/>\\n                                    <field name=\\"comment_count_as_answer\\" invisible=\\"question_type not in ['simple_choice', 'multiple_choice', 'matrix'] or not comments_allowed\\"/>\\n                                </group>\\n                                <group string=\\"Conditional display\\">\\n                                    <p class=\\"text-muted\\" colspan=\\"2\\" invisible=\\"questions_selection == 'all'\\">\\n                                        Conditional display is not available when questions are randomly picked.\\n                                    </p>\\n                                    <field name=\\"allowed_triggering_question_ids\\" invisible=\\"1\\"/>\\n                                    <field name=\\"triggering_answer_ids\\" widget=\\"many2many_tags\\" options=\\"{'no_open': True, 'no_create': True}\\" domain=\\"[('question_id', 'in', allowed_triggering_question_ids)]\\" invisible=\\"questions_selection == 'random'\\" placeholder=\\"Optional previous answers required\\"/>\\n                                </group>\\n                            </group>\\n                            <group>\\n                                <group string=\\"Constraints\\">\\n                                    <field name=\\"constr_mandatory\\" string=\\"Mandatory Answer\\"/>\\n                                    <field name=\\"constr_error_msg\\" invisible=\\"not constr_mandatory\\" placeholder=\\"This question requires an answer.\\"/>\\n                                </group>\\n                                <group string=\\"Live Sessions\\">\\n                                    <field name=\\"is_time_customized\\" invisible=\\"True\\"/>\\n                                    <field name=\\"session_available\\" invisible=\\"True\\"/>\\n                                    <p class=\\"text-muted\\" colspan=\\"2\\" invisible=\\"session_available\\">\\n                                        Time limits are only available for Live Sessions.\\n                                    </p>\\n                                    <label for=\\"is_time_limited\\" string=\\"Time Limit (seconds)\\" invisible=\\"not session_available\\"/>\\n                                    <div invisible=\\"not session_available\\">\\n                                        <field name=\\"is_time_limited\\" nolabel=\\"1\\" class=\\"oe_inline\\" widget=\\"boolean_update_flag\\" options=\\"{'flagFieldName': 'is_time_customized'}\\" context=\\"{'referenceValue': survey_session_speed_rating}\\"/>\\n                                        <field name=\\"time_limit\\" nolabel=\\"1\\" class=\\"oe_inline\\" widget=\\"integer_update_flag\\" options=\\"{'flagFieldName': 'is_time_customized'}\\" context=\\"{'referenceValue': survey_session_speed_rating_time_limit}\\" invisible=\\"not is_time_limited\\"/>\\n                                    </div>\\n                                </group>\\n                            </group>\\n                        </page>\\n                    </notebook>\\n                </sheet>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Survey Question" create="false" class="o_survey_question_view_form">\n                <field name="is_placed_before_trigger" invisible="1"/>\n                <div class="alert alert-warning text-center" role="alert" invisible="not is_placed_before_trigger">\n                    ⚠️ This question is positioned before some or all of its triggers and could be skipped.\n                </div>\n                <field name="is_page" invisible="1"/>\n                <field name="page_id" invisible="1" required="False"/>\n                <field name="sequence" invisible="1"/>\n                <field name="scoring_type" invisible="1"/>\n                <field name="has_image_only_suggested_answer" invisible="1"/>\n                <sheet>\n                    <field name="survey_id" invisible="not context.get('show_survey_field')" readonly="1"/>\n                    <div class="float-end d-flex flex-column text-center" invisible="not is_page">\n                        <label for="background_image"/>\n                        <field name="background_image" widget="image" class="oe_avatar"/>\n                    </div>\n                    <div class="oe_title" style="width: 100%;">\n                        <label for="title" string="Section" invisible="not is_page"/>\n                        <label for="title" string="Question" invisible="is_page"/><br/>\n                        <field name="title" placeholder="e.g. &quot;What is the...&quot;" colspan="4"/>\n                        <field name="questions_selection" invisible="1"/>\n                    </div>\n                    <group class="o_label_nowrap" invisible="not is_page or questions_selection == 'all'">\n                        <field name="random_questions_count"/>\n                    </group>\n                    <group invisible="is_page">\n                        <group>\n                            <field name="question_type" widget="radio" required="not is_page"/>\n                        </group>\n                        <group>\n                            <div class="mx-lg-auto w-lg-50 d-none d-sm-block o_preview_questions bg-light" colspan="2">\n                                <!-- Multiple choice: only one answer -->\n                                <div invisible="question_type != 'simple_choice'" role="img" aria-label="Multiple choice with one answer" title="Multiple choice with one answer">\n                                    <span>Which is yellow?</span><br/>\n                                    <div class="o_preview_questions_choice mb-2"><i class="fa fa-circle-o  fa-lg me-2"/>answer</div>\n                                    <div class="o_preview_questions_choice mb-2"><i class="fa fa-dot-circle-o fa-lg me-2"/>answer</div>\n                                    <div class="o_preview_questions_choice"><i class="fa fa-circle-o  fa-lg me-2"/>answer</div>\n                                </div>\n                                <!-- Multiple choice: multiple answers allowed -->\n                                <div invisible="question_type != 'multiple_choice'" role="img" aria-label="Multiple choice with multiple answers" title="Multiple choice with multiple answers">\n                                    <span>Which are yellow?</span><br/>\n                                    <div class="o_preview_questions_choice mb-2"><i class="fa fa-square-o fa-lg me-2"/>answer</div>\n                                    <div class="o_preview_questions_choice mb-2"><i class="fa fa-check-square-o fa-lg me-2"/>answer</div>\n                                    <div class="o_preview_questions_choice"><i class="fa fa-check-square-o fa-lg me-2"/>answer</div>\n                                </div>\n                                <!-- Multiple Lines Text Zone -->\n                                <div invisible="question_type != 'text_box'">\n                                    <span>Name all the animals</span><br/>\n                                    <i class="fa fa-align-justify fa-4x" role="img" aria-label="Multiple lines" title="Multiple Lines"/>\n                                </div>\n                                <!-- Single Line Text Zone -->\n                                <div invisible="question_type != 'char_box'">\n                                    <span>Name one animal</span><br/>\n                                    <i class="fa fa-minus fa-4x" role="img" aria-label="Single Line" title="Single Line"/>\n                                </div>\n                                <!-- Numerical Value -->\n                                <div invisible="question_type != 'numerical_box'">\n                                    <span>How many ...?</span><br/>\n                                    <i class="fa fa-2x" role="img" aria-label="Numeric" title="Numeric">123 </i>\n                                    <i class="fa fa-2x fa-sort" role="img" aria-label="Numeric"/>\n                                </div>\n                                <!-- Date -->\n                                <div invisible="question_type != 'date'">\n                                    <span>When is Christmas?</span><br/>\n                                    <p class="o_datetime border-0">YYYY-MM-DD\n                                        <i class="fa fa-calendar" role="img" aria-label="Calendar" title="Calendar"/>\n                                    </p>\n                                </div>\n                                <!-- Date and Time -->\n                                <div invisible="question_type != 'datetime'">\n                                    <span>When does ... start?</span><br/>\n                                    <p class="o_datetime border-0">YYYY-MM-DD hh:mm:ss\n                                        <i class="fa fa-calendar" role="img" aria-label="Calendar" title="Calendar"/>\n                                    </p>\n                                </div>\n                                <!-- Matrix -->\n                                <div invisible="question_type != 'matrix'">\n                                    <div class="row o_matrix_head">\n                                        <div class="col-3"/>\n                                        <div class="col-3">ans</div>\n                                        <div class="col-3">ans</div>\n                                        <div class="col-3">ans</div>\n                                    </div>\n                                    <div class="row o_matrix_row">\n                                        <div class="col-3">Row1</div>\n                                        <div class="col-3"><i class="fa fa-circle-o fa-lg" role="img" aria-label="Not checked" title="Not checked"/></div>\n                                        <div class="col-3"><i class="fa fa-dot-circle-o fa-lg" role="img" aria-label="Checked" title="Checked"/></div>\n                                        <div class="col-3"><i class="fa fa-circle-o fa-lg" role="img" aria-label="Not checked" title="Not checked"/></div>\n                                    </div>\n                                    <div class="row o_matrix_row">\n                                        <div class="col-3">Row2</div>\n                                        <div class="col-3"><i class="fa fa-circle-o fa-lg" role="img" aria-label="Not checked" title="Not checked"/></div>\n                                        <div class="col-3"><i class="fa fa-circle-o fa-lg" role="img" aria-label="Not checked" title="Not checked"/></div>\n                                        <div class="col-3"><i class="fa fa-dot-circle-o fa-lg" role="img" aria-label="Checked" title="Checked"/></div>\n                                    </div>\n                                    <div class="row o_matrix_row">\n                                        <div class="col-3">Row3</div>\n                                        <div class="col-3"><i class="fa fa-dot-circle-o fa-lg" role="img" aria-label="Checked" title="Checked"/></div>\n                                        <div class="col-3"><i class="fa fa-circle-o fa-lg" role="img" aria-label="Not checked" title="Not checked"/></div>\n                                        <div class="col-3"><i class="fa fa-circle-o fa-lg" role="img" aria-label="Not checked" title="Not checked"/></div>\n                                    </div>\n                                </div>\n                                <!-- Scale -->\n                                <div invisible="question_type != 'scale'">\n                                    <span>Do you like it?</span><br/>\n                                    <div class="btn-group w-100" role="group" aria-label="Scale">\n                                        <a role="button" type="button" class="btn btn-secondary disabled o_preview_questions_choice">1</a>\n                                        <a role="button" type="button" class="btn btn-secondary disabled o_preview_questions_choice">2</a>\n                                        <a role="button" type="button" class="btn btn-secondary disabled o_preview_questions_choice">3</a>\n                                    </div>\n                                    <div class="d-flex justify-content-between">\n                                        <div>Label</div>\n                                        <div>Label</div>\n                                        <div>Label</div>\n                                    </div>\n                                </div>\n                            </div>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page string="Answers" name="answers" invisible="is_page or question_type == 'text_box' or scoring_type == 'no_scoring' and question_type in ['numerical_box', 'date', 'datetime']">\n                            <group>\n                                <group invisible="question_type != 'scale'">\n                                    <field name="scale_min" placeholder="Scale Minimum Value (0 to 10)"/>\n                                    <field name="scale_max" placeholder="Scale Maximum Value (0 to 10)"/>\n                                </group>\n                                <group invisible="question_type != 'scale'">\n                                    <field name="scale_min_label" placeholder="Not likely at all"/>\n                                    <field name="scale_mid_label" placeholder="Neutral"/>\n                                    <field name="scale_max_label" placeholder="Extremely likely"/>\n                                </group>\n                                <group invisible="question_type not in ['char_box', 'numerical_box', 'date', 'datetime']">\n                                    <field name="answer_numerical_box" string="Correct Answer" class="oe_inline" invisible="question_type != 'numerical_box'" required="is_scored_question and question_type == 'numerical_box'"/>\n                                    <field name="answer_date" string="Correct Answer" class="oe_inline" invisible="question_type != 'date'" required="is_scored_question and question_type == 'date'"/>\n                                    <field name="answer_datetime" string="Correct Answer" class="oe_inline" invisible="question_type != 'datetime'" required="is_scored_question and question_type == 'datetime'"/>\n\n                                    <field name="validation_email" invisible="question_type != 'char_box'"/>\n                                    <field name="save_as_email" invisible="not validation_email or question_type != 'char_box'"/>\n                                    <field name="save_as_nickname" invisible="question_type != 'char_box'"/>\n                                </group>\n\n                                <group invisible="scoring_type == 'no_scoring' or question_type not in ['numerical_box', 'date', 'datetime']">\n                                    <label for="is_scored_question"/>\n                                    <div name="survey_scored_question">\n                                        <field name="is_scored_question" nolabel="1"/>\n                                        <field name="answer_score" class="w-50 mx-2" invisible="not is_scored_question" nolabel="1"/>\n                                        <span invisible="not is_scored_question">Points</span>\n                                    </div>\n                                </group>\n                            </group>\n                            <field name="suggested_answer_ids" context="{'default_question_id': id}" invisible="question_type not in ['simple_choice', 'multiple_choice', 'matrix']">\n                                <list editable="bottom">\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="value" string="Choices" required="not value_image"/>\n                                    <field name="is_correct" column_invisible="parent.scoring_type == 'no_scoring' or parent.question_type == 'matrix'"/>\n                                    <field name="answer_score" column_invisible="parent.scoring_type == 'no_scoring' or parent.question_type == 'matrix'"/>\n                                    <field name="value_image_filename" column_invisible="not parent.has_image_only_suggested_answer"/>\n                                    <field name="value_image" width="200px" filename="value_image_filename" options="{'accepted_file_extensions': 'image/*'}" column_invisible="parent.question_type in ['matrix', 'scale']" required="not value"/>\n                                </list>\n                            </field>\n\n                            <field name="matrix_row_ids" context="{'default_matrix_question_id': id}" invisible="question_type != 'matrix'">\n                                <list editable="bottom">\n                                    <field name="sequence" widget="handle"/>\n                                    <field name="value" string="Rows"/>\n                                </list>\n                            </field>\n                        </page>\n                        <page string="Description" name="survey_description">\n                            <field name="description" widget="html" options="{'embedded_components': false}" placeholder="e.g. Guidelines, instructions, picture, ... to help attendees answer"/>\n                        </page>\n                        <page string="Options" name="options" invisible="is_page">\n                            <group>\n                                <group string="Answers" invisible="question_type == 'scale'">\n                                    <!-- Global validation setting -->\n                                    <field name="validation_required" invisible="question_type not in ['char_box', 'numerical_box', 'date', 'datetime']"/>\n                                    <div class="o_wrap_label o_form_label" invisible="not validation_required">Min/Max Limits</div>\n                                    <div class="o_survey_question_validation_parameters" invisible="not validation_required">\n                                        <!-- Minima -->\n                                        <field name="validation_length_min" class="o_survey_question_validation_inline" nolabel="1" placeholder="Minimum" invisible="question_type != 'char_box'" required="validation_required and question_type == 'char_box'"/>\n                                        <field name="validation_min_float_value" class="o_survey_question_validation_inline" nolabel="1" placeholder="Minimum" invisible="question_type != 'numerical_box'" required="validation_required and question_type == 'numerical_box'"/>\n                                        <field name="validation_min_date" nolabel="1" placeholder="Minimum" invisible="question_type != 'date'" required="validation_required and question_type == 'date' and not validation_max_date"/>\n                                        <field name="validation_min_datetime" nolabel="1" placeholder="Minimum" invisible="question_type != 'datetime'" required="validation_required and question_type == 'datetime' and not validation_max_datetime"/>\n\n                                        <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon" title="Arrow"/>\n                                        <!-- Maxima -->\n                                        <field name="validation_length_max" class="o_survey_question_validation_inline" nolabel="1" placeholder="Maximum" invisible="question_type != 'char_box'" required="validation_required and question_type == 'char_box'"/>\n                                        <field name="validation_max_float_value" class="o_survey_question_validation_inline" nolabel="1" placeholder="Maximum" invisible="question_type != 'numerical_box'" required="validation_required and question_type == 'numerical_box'"/>\n                                        <field name="validation_max_date" nolabel="1" placeholder="Maximum" invisible="question_type != 'date'" required="validation_required and question_type == 'date' and not validation_min_date"/>\n                                        <field name="validation_max_datetime" nolabel="1" placeholder="Maximum" invisible="question_type != 'datetime'" required="validation_required and question_type == 'datetime' and not validation_min_datetime"/>\n                                    </div>\n                                    <field name="validation_error_msg" invisible="not validation_required" placeholder="Displayed when the answer entered is not valid."/>\n\n                                    <field name="matrix_subtype" invisible="question_type != 'matrix'" required="question_type == 'matrix'"/>\n                                    <field name="question_placeholder" invisible="question_type not in ['text_box', 'char_box', 'date', 'datetime', 'numerical_box']" placeholder="Help Participants know what to write"/>\n                                    <field name="comments_allowed" invisible="question_type not in ['simple_choice', 'multiple_choice', 'matrix']"/>\n                                    <field name="comments_message" invisible="question_type not in ['simple_choice', 'multiple_choice', 'matrix'] or not comments_allowed" placeholder="If other, please specify:"/>\n                                    <field name="comment_count_as_answer" invisible="question_type not in ['simple_choice', 'multiple_choice', 'matrix'] or not comments_allowed"/>\n                                </group>\n                                <group string="Conditional display">\n                                    <p class="text-muted" colspan="2" invisible="questions_selection == 'all'">\n                                        Conditional display is not available when questions are randomly picked.\n                                    </p>\n                                    <field name="allowed_triggering_question_ids" invisible="1"/>\n                                    <field name="triggering_answer_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}" domain="[('question_id', 'in', allowed_triggering_question_ids)]" invisible="questions_selection == 'random'" placeholder="Optional previous answers required"/>\n                                </group>\n                            </group>\n                            <group>\n                                <group string="Constraints">\n                                    <field name="constr_mandatory" string="Mandatory Answer"/>\n                                    <field name="constr_error_msg" invisible="not constr_mandatory" placeholder="This question requires an answer."/>\n                                </group>\n                                <group string="Live Sessions">\n                                    <field name="is_time_customized" invisible="True"/>\n                                    <field name="session_available" invisible="True"/>\n                                    <p class="text-muted" colspan="2" invisible="session_available">\n                                        Time limits are only available for Live Sessions.\n                                    </p>\n                                    <label for="is_time_limited" string="Time Limit (seconds)" invisible="not session_available"/>\n                                    <div invisible="not session_available">\n                                        <field name="is_time_limited" nolabel="1" class="oe_inline" widget="boolean_update_flag" options="{'flagFieldName': 'is_time_customized'}" context="{'referenceValue': survey_session_speed_rating}"/>\n                                        <field name="time_limit" nolabel="1" class="oe_inline" widget="integer_update_flag" options="{'flagFieldName': 'is_time_customized'}" context="{'referenceValue': survey_session_speed_rating_time_limit}" invisible="not is_time_limited"/>\n                                    </div>\n                                </group>\n                            </group>\n                        </page>\n                    </notebook>\n                </sheet>\n            </form>\n        	f	t	2026-09-05 15:59:51.744302	2026-09-05 15:59:51.744302	f
