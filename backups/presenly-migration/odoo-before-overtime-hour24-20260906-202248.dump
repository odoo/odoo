445	2	\N	1	1	calendar.event.form.quick_create	calendar.event	\N	form	calendar/views/calendar_views.xml	primary	{"en_US": "<form string=\\"Meetings\\" class=\\"o_calendar_event_form_quick_create\\" js_class=\\"calendar_quick_create_form_view\\">\\n                <field name=\\"invalid_email_partner_ids\\" invisible=\\"1\\"/> <!--used in many2many_attendees widget-->\\n                <div class=\\"d-flex align-items-center\\" colspan=\\"2\\">\\n                    <i class=\\"fa fa-tag text-600\\" title=\\"Booking Name\\"/>\\n                    <field name=\\"name\\" nolabel=\\"1\\" placeholder=\\"Add Title\\" class=\\"w-100 mb-0\\"/>\\n                </div>\\n                <div class=\\"d-flex align-items-center\\" colspan=\\"2\\">\\n                    <i class=\\"fa fa-clock-o text-600\\" title=\\"Dates\\"/>\\n                    <!--when \\"stop\\" is set manually, \\"duration\\" is computed. When \\"start\\" is changed\\n                    \\"stop\\" is computed based on the previously-computed \\"duration\\". Hence we need to\\n                    keep the last computed duration in the front-end model and send it with \\"start\\"\\n                    when it changes-->\\n                    <!--field is also used for custom behavior in default_get, check before removing-->\\n                    <field name=\\"duration\\" invisible=\\"1\\" force_save=\\"1\\"/>\\n                    <field name=\\"start\\" nolabel=\\"1\\" widget=\\"daterange\\" options=\\"{'end_date_field': 'stop'}\\" placeholder=\\"Dates\\" class=\\"w-100 mb-0\\" invisible=\\"allday\\"/>\\n                    <field name=\\"start_date\\" nolabel=\\"1\\" widget=\\"daterange\\" options=\\"{'end_date_field': 'stop_date'}\\" placeholder=\\"Dates\\" class=\\"w-100 mb-0\\" invisible=\\"not allday\\"/>\\n                    <span class=\\"ms-1 w-25\\">\\n                        <field name=\\"allday\\" class=\\"mb-0\\" title=\\"All Day\\" nolabel=\\"1\\"/>\\n                        <span>All day</span>\\n                    </span>\\n                    <field name=\\"stop\\" invisible=\\"1\\"/>\\n                </div>\\n                <div class=\\"d-flex\\" colspan=\\"2\\">\\n                    <i class=\\"fa fa-user mt-1 text-600\\" title=\\"Participants\\"/>\\n                    <field name=\\"partner_ids\\" nolabel=\\"1\\" widget=\\"many2many_tags\\" placeholder=\\"Participants\\" class=\\"w-75 mb-0\\"/>\\n                </div>\\n                <div class=\\"d-flex align-items-center\\" colspan=\\"2\\">\\n                    <i class=\\"fa fa-map text-600\\" title=\\"Location\\"/>\\n                    <field name=\\"location\\" nolabel=\\"1\\" placeholder=\\"Location\\" class=\\"w-100 mb-0\\"/>\\n                    <!--fields set via the fake front-end only actions must be force saved (see calendar_form)-->\\n                    <field name=\\"recurrence_update\\" invisible=\\"1\\"/>\\n                    <field name=\\"access_token\\" force_save=\\"1\\" invisible=\\"1\\"/>\\n                    <field name=\\"videocall_location\\" force_save=\\"1\\" invisible=\\"1\\"/>\\n                    <field name=\\"videocall_source\\" force_save=\\"1\\" invisible=\\"1\\"/>\\n                    <button name=\\"set_discuss_videocall_location\\" type=\\"object\\" class=\\"mx-1 btn-link text-nowrap\\" invisible=\\"videocall_location\\" context=\\"{'recurrence_update': recurrence_update}\\">\\n                        <span class=\\"fa fa-plus me-1\\"/>Video\\n                    </button>\\n                </div>\\n                <div class=\\"d-flex align-items-center\\" colspan=\\"2\\" invisible=\\"not videocall_location\\">\\n                    <i class=\\"fa fa-video-camera text-600\\" title=\\"Videocall URL\\"/>\\n                    <field name=\\"videocall_location\\" nolabel=\\"1\\" widget=\\"CopyClipboardChar\\" class=\\"w-100 mb-0 o_field_CopyClipboardChar\\"/>\\n                    <button name=\\"clear_videocall_location\\" class=\\"btn btn-sm px-0\\"><i class=\\"fa fa-remove\\" title=\\"Remove\\"/></button>\\n                </div>\\n                <div class=\\"d-flex align-items-center\\" colspan=\\"2\\">\\n                    <i class=\\"fa fa-lock text-600\\" title=\\"Visibility\\"/>\\n                    <field name=\\"privacy\\" nolabel=\\"1\\" class=\\"w-100 mb-0\\" placeholder=\\"Visibility\\"/>\\n                </div>\\n                <div class=\\"d-flex\\" colspan=\\"2\\">\\n                    <i class=\\"fa fa-sticky-note mt-2 text-600\\" title=\\"Notes\\"/> \\n                    <field name=\\"notes\\" nolabel=\\"1\\" class=\\"w-100\\" placeholder=\\"Notes\\" widget=\\"calendar_event_notes_html\\"/>\\n                </div>\\n            </form>"}	<?xml version="1.0"?>\n<form string="Meetings" class="o_calendar_event_form_quick_create" js_class="calendar_quick_create_form_view">\n                <field name="invalid_email_partner_ids" invisible="1"/> <!--used in many2many_attendees widget-->\n                <div class="d-flex align-items-center" colspan="2">\n                    <i class="fa fa-tag text-600" title="Booking Name"/>\n                    <field name="name" nolabel="1" placeholder="Add Title" class="w-100 mb-0"/>\n                </div>\n                <div class="d-flex align-items-center" colspan="2">\n                    <i class="fa fa-clock-o text-600" title="Dates"/>\n                    <!--when "stop" is set manually, "duration" is computed. When "start" is changed\n                    "stop" is computed based on the previously-computed "duration". Hence we need to\n                    keep the last computed duration in the front-end model and send it with "start"\n                    when it changes-->\n                    <!--field is also used for custom behavior in default_get, check before removing-->\n                    <field name="duration" invisible="1" force_save="1"/>\n                    <field name="start" nolabel="1" widget="daterange" options="{'end_date_field': 'stop'}" placeholder="Dates" class="w-100 mb-0" invisible="allday"/>\n                    <field name="start_date" nolabel="1" widget="daterange" options="{'end_date_field': 'stop_date'}" placeholder="Dates" class="w-100 mb-0" invisible="not allday"/>\n                    <span class="ms-1 w-25">\n                        <field name="allday" class="mb-0" title="All Day" nolabel="1"/>\n                        <span>All day</span>\n                    </span>\n                    <field name="stop" invisible="1"/>\n                </div>\n                <div class="d-flex" colspan="2">\n                    <i class="fa fa-user mt-1 text-600" title="Participants"/>\n                    <field name="partner_ids" nolabel="1" widget="many2many_tags" placeholder="Participants" class="w-75 mb-0"/>\n                </div>\n                <div class="d-flex align-items-center" colspan="2">\n                    <i class="fa fa-map text-600" title="Location"/>\n                    <field name="location" nolabel="1" placeholder="Location" class="w-100 mb-0"/>\n                    <!--fields set via the fake front-end only actions must be force saved (see calendar_form)-->\n                    <field name="recurrence_update" invisible="1"/>\n                    <field name="access_token" force_save="1" invisible="1"/>\n                    <field name="videocall_location" force_save="1" invisible="1"/>\n                    <field name="videocall_source" force_save="1" invisible="1"/>\n                    <button name="set_discuss_videocall_location" type="object" class="mx-1 btn-link text-nowrap" invisible="videocall_location" context="{'recurrence_update': recurrence_update}">\n                        <span class="fa fa-plus me-1"/>Video\n                    </button>\n                </div>\n                <div class="d-flex align-items-center" colspan="2" invisible="not videocall_location">\n                    <i class="fa fa-video-camera text-600" title="Videocall URL"/>\n                    <field name="videocall_location" nolabel="1" widget="CopyClipboardChar" class="w-100 mb-0 o_field_CopyClipboardChar"/>\n                    <button name="clear_videocall_location" class="btn btn-sm px-0"><i class="fa fa-remove" title="Remove"/></button>\n                </div>\n                <div class="d-flex align-items-center" colspan="2">\n                    <i class="fa fa-lock text-600" title="Visibility"/>\n                    <field name="privacy" nolabel="1" class="w-100 mb-0" placeholder="Visibility"/>\n                </div>\n                <div class="d-flex" colspan="2">\n                    <i class="fa fa-sticky-note mt-2 text-600" title="Notes"/> \n                    <field name="notes" nolabel="1" class="w-100" placeholder="Notes" widget="calendar_event_notes_html"/>\n                </div>\n            </form>\n        	f	t	2026-09-05 15:59:46.487049	2026-09-05 15:59:46.487049	\N
