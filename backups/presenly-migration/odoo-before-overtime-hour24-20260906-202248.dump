er gap-1\\">\\n                                        <field name=\\"activity_ids\\" widget=\\"kanban_activity\\" style=\\"margin-right: 2px\\"/>\\n                                        <b t-if=\\"record.rating_active.raw_value and record.rating_count.raw_value &gt; 0\\">\\n                                            <span class=\\"fa fa-fw fa-smile-o text-success rating_face\\" t-if=\\"record.rating_avg.raw_value &gt;= 3.66\\" title=\\"Average Rating: Happy\\" role=\\"img\\" aria-label=\\"Happy face\\"/>\\n                                            <span class=\\"fa fa-fw fa-meh-o text-warning rating_face\\" t-elif=\\"record.rating_avg.raw_value &gt;= 2.33\\" title=\\"Average Rating: Neutral\\" role=\\"img\\" aria-label=\\"Neutral face\\"/>\\n                                            <span class=\\"fa fa-fw fa-frown-o text-danger rating_face\\" t-else=\\"\\" title=\\"Average Rating: Unhappy\\" role=\\"img\\" aria-label=\\"Unhappy face\\"/>\\n                                        </b>\\n                                        <a t-if=\\"!record.project_id.raw_value\\" class=\\"text-muted\\" style=\\"font-size: 17px; margin-left: 1.5px\\">\\n                                            <i title=\\"Private Task\\" class=\\"fa fa-lock\\"/>\\n                                        </a>\\n                                        <t t-if=\\"record.project_id.raw_value and record.subtask_count.raw_value\\">\\n                                            <widget name=\\"subtask_counter\\" class=\\"me-1\\"/>\\n                                        </t>\\n                                        <field name=\\"priority\\" class=\\"pt-1\\" widget=\\"priority\\"/>\\n                                        <field name=\\"is_rotting\\" invisible=\\"1\\"/>\\n                                        <field name=\\"rotting_days\\" widget=\\"rotting\\" class=\\"ms-1 d-flex\\"/>\\n                                    </div>\\n                                    <div class=\\"d-fl