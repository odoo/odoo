 m-0\\" invisible=\\"not warning\\" t-att-title=\\"record.warning.raw_value\\"/>\\n                            <field name=\\"name\\" class=\\"text-truncate\\"/>\\n                            <button type=\\"delete\\" name=\\"delete\\" class=\\"btn fa fa-trash fa-xl px-3 ms-auto\\" title=\\"Delete Action\\"/>\\n                        </t>\\n                    </templates>\\n                </kanban>"}	<?xml version="1.0"?>\n<kanban>\n                    <control>\n                        <create string="Add an action"/>\n                    </control>\n                    <field name="state"/>\n                    <field name="evaluation_type"/>\n                    <field name="value"/>\n                    <field name="value_field_to_show"/>\n                    <field name="update_field_type"/>\n                    <field name="update_m2m_operation"/>\n                    <templates>\n                        <t t-name="card" class="o_draggable_norotate w-100 flex-row align-items-center gap-1">\n                            <field name="sequence" widget="handle" class="px-1"/>\n                            <!-- Icon section -->\n                            <i data-name="server_action_icon" t-att-title="record.state.value" class="fa fa-fw" t-att-class="{                                     'code': 'fa-code',                                     'object_create': 'fa-plus-square',                                     'object_copy': 'fa-clone',                                     'object_write': 'fa-pencil',                                     'multi': 'fa-list-ul',                                     'mail_post': 'fa-envelope',                                     'followers': 'fa-user',                                     'remove_followers': 'fa-user-times',                                     'next_activity': 'fa-clock-o',                                     'sms': 'fa-mobile',                                     'webhook': 'fa-paper-plane',                                     'whatsapp': 'fa-whatsapp',                                     'ai': 'fa-magic',                                 }[record.state.raw_value] || 'fa-circle-thin'"/>\n                            <i class="fa fa-warning text-warning px-2 m-0" invisible="not warning" t-att-title="record.warning.raw_value"/>\n                            <field name="name" class="text-truncate"/>\n                            <button type="delete" name="delete" class="btn fa fa-trash fa-xl px-3 ms-auto" title="Delete Action"/>\n                        </t>\n                    </templates>\n                </kanban>\n            	f	t	2026-09-05 15:58:45.179291	2026-09-05 15:58:45.179291	\N
