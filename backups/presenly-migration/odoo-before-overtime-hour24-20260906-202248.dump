--
-- Name: CONSTRAINT survey_question_positive_answer_score ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_positive_answer_score ON public.survey_question IS 'CHECK (answer_score >= 0)';


--
-- Name: CONSTRAINT survey_question_positive_len_max ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_positive_len_max ON public.survey_question IS 'CHECK (validation_length_max >= 0)';


--
-- Name: CONSTRAINT survey_question_positive_len_min ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_positive_len_min ON public.survey_question IS 'CHECK (validation_length_min >= 0)';


--
-- Name: CONSTRAINT survey_question_scale ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_scale ON public.survey_question IS 'CHECK (question_type != ''scale'' OR (scale_min >= 0 AND scale_max <= 10 AND scale_min < scale_max))';


--
-- Name: CONSTRAINT survey_question_scored_date_have_answers ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_scored_date_have_answers ON public.survey_question IS 'CHECK (is_scored_question != True OR question_type != ''date'' OR answer_date is not null)';


--
-- Name: CONSTRAINT survey_question_scored_datetime_have_answers ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_scored_datetime_have_answers ON public.survey_question IS 'CHECK (is_scored_question != True OR question_type != ''datetime'' OR answer_datetime is not null)';


--
-- Name: CONSTRAINT survey_question_validation_date ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_validation_date ON public.survey_question IS 'CHECK (validation_min_date <= validation_max_date)';


--
-- Name: CONSTRAINT survey_question_validation_datetime ON survey_question; Type: COMMENT; Schema: public; Owner: -
--

COMMENT ON CONSTRAINT survey_question_validation_datetime ON public.survey_question IS 'CHECK (validation_min_datetime <= validation_max_datetime)';


--
