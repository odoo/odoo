io\\" class=\\"o_row\\"/>\\n                                        <group class=\\"mt-2\\">\\n                                            <field name=\\"rating_status_period\\" invisible=\\"rating_status != 'periodic'\\" required=\\"rating_status == 'periodic'\\"/>\\n                                            <field name=\\"rating_template_id\\" placeholder=\\"Task: Rating Request\\" context=\\"{'default_model': 'project.task'}\\" required=\\"rating_active\\"/>\\n                                        </group>\\n                                        <span colspan=\\"2\\" class=\\"text-muted o_row ps-1\\">\\n                                            <i class=\\"fa fa-lightbulb-o pe-2\\"/>\\n                                            <span name=\\"rating_status_helper\\">\\n                                                <span invisible=\\"rating_status == 'periodic'\\">A rating request will be sent as soon as a task reaches this stage.</span>\\n                                                <span invisible=\\"rating_status == 'stage'\\">Rating requests will be sent as long as the task remains in this stage.</span>\\n                                            </span>\\n                                        </span>\\n                                    </div>\\n                                </setting>\\n                            </group>\\n                        </group>\\n                    </sheet>\\n                </form>"}	<?xml version="1.0"?>\n<form string="Task Stage" delete="0">\n                    <field name="active" invisible="1"/>\n                    <sheet>\n                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                        <group>\n                            <group>\n                                <field name="name" placeholder="e.g. To Do"/>\n                                <field name="fold"/>\n                                <field name="user_id" invisible="True"/>\n                                <field name="auto_validation_state" invisible="not rating_template_id"/>\n                                <field name="project_ids" widget="many2many_tags" options="{'color_field': 'color', 'edit_tags': True}" invisible="user_id" required="not user_id"/>\n                                <field name="rotting_threshold_days"/>\n                                <field name="color" widget="color_picker"/>\n                                <field name="sequence" groups="base.group_no_one"/>\n                            </group>\n                            <group>\n                                <field name="mail_template_id" context="{'default_model': 'project.task'}" invisible="user_id"/>\n                            </group>\n                            <group name="group_customer_rating" string="Customer Rating" class="row o_settings_container" invisible="user_id">\n                                <setting class="col-lg-12">\n                                    <field name="rating_active"/>\n                                    <div invisible="not rating_active">\n                                        <field name="rating_status" widget="radio" class="o_row"/>\n                                        <group class="mt-2">\n                                            <field name="rating_status_period" invisible="rating_status != 'periodic'" required="rating_status == 'periodic'"/>\n                                            <field name="rating_template_id" placeholder="Task: Rating Request" context="{'default_model': 'project.task'}" required="rating_active"/>\n                                        </group>\n                                        <span colspan="2" class="text-muted o_row ps-1">\n                                            <i class="fa fa-lightbulb-o pe-2"/>\n                                            <span name="rating_status_helper">\n                                                <span invisible="rating_status == 'periodic'">A rating request will be sent as soon as a task reaches this stage.</span>\n                                                <span invisible="rating_status == 'stage'">Rating requests will be sent as long as the task remains in this stage.</span>\n                                            </span>\n                                        </span>\n                                    </div>\n                                </setting>\n                            </group>\n                        </group>\n                    </sheet>\n                </form>\n            	f	t	2026-09-05 15:59:52.742806	2026-09-05 15:59:52.742806	f
