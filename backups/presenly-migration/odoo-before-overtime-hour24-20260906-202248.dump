795	16	\N	1	1	presenly.approval.route.step.form	presenly.approval.rule	\N	form	presenly/views/presenly_approval_views.xml	primary	{"en_US": "<form string=\\"Approval Step\\">\\n                <sheet>\\n                    <widget name=\\"web_ribbon\\" title=\\"Needs Configuration\\" bg_color=\\"text-bg-warning\\" invisible=\\"is_complete\\"/>\\n                    <widget name=\\"web_ribbon\\" title=\\"Archived\\" bg_color=\\"text-bg-danger\\" invisible=\\"active\\"/>\\n                    <field name=\\"is_complete\\" invisible=\\"1\\"/>\\n                    <field name=\\"active\\" invisible=\\"1\\"/>\\n                    <field name=\\"required\\" invisible=\\"1\\"/>\\n                    <div class=\\"oe_title\\">\\n                        <label for=\\"name\\" string=\\"Step Name\\"/>\\n                        <h1><field name=\\"name\\" placeholder=\\"e.g. Manager Review\\"/></h1>\\n                    </div>\\n                    <div class=\\"alert alert-info\\" role=\\"alert\\">\\n                        Each record is one mandatory approval step. Steps run from the smallest Order to the largest. Employees cannot submit when no complete route applies.\\n                    </div>\\n                    <group>\\n                        <group string=\\"1. Request Type\\">\\n                            <field name=\\"company_id\\" required=\\"1\\"/>\\n                            <field name=\\"is_overtime_route\\" string=\\"Overtime Route\\" help=\\"Mark this step as the Overtime / Lembur approval route for the company/location scope.\\"/>\\n                            <field name=\\"permission_type_id\\" string=\\"Permission Type\\" domain=\\"[('is_complete', '=', True), ('active', '=', True), ('company_id', '=', company_id)]\\" options=\\"{'no_create': True}\\" invisible=\\"leave_type_id or is_overtime_route\\"/>\\n                            <field name=\\"leave_type_id\\" string=\\"Time Off Type\\" domain=\\"[('active', '=', True), ('company_id', 'in', [False, company_id])]\\" options=\\"{'no_create': True}\\" invisible=\\"permission_type_id or is_overtime_route\\"/>\\n                            <div class=\\"alert alert-info\\" role=\\"alert\\" colspan=\\"2\\" invisible=\\"not is_overtime_route\\">\\n                                This step approves Presenly Overtime requests.\\n                            </div>\\n                            <field name=\\"request_type_display\\" readonly=\\"1\\"/>\\n                            <field name=\\"sequence\\" string=\\"Order\\" help=\\"Approval runs from the smallest Order to the largest. Suggested values: 10, 20, 30.\\"/>\\n                        </group>\\n                        <group string=\\"2. Work Location Scope\\">\\n                            <field name=\\"work_location_id\\" string=\\"Only at Work Location\\" domain=\\"[('active', '=', True), ('company_id', '=', company_id)]\\" options=\\"{'no_create': True}\\" help=\\"Leave empty for the company default route. Select a location only to override the default step at that site.\\"/>\\n                            <field name=\\"scope_display\\" readonly=\\"1\\"/>\\n                            <div class=\\"alert alert-light\\" role=\\"alert\\" colspan=\\"2\\">\\n                                A location-specific step replaces the company-default step with the same Order for that location.\\n                            </div>\\n                        </group>\\n                    </group>\\n                    <group>\\n                        <group string=\\"3. Who Approves\\">\\n                            <field name=\\"approver_type\\" string=\\"Approver Source\\"/>\\n                            <field name=\\"approver_user_id\\" string=\\"Specific User\\" widget=\\"many2one_avatar_user\\" domain=\\"[('active', '=', True), ('company_ids', 'in', company_id)]\\" options=\\"{'no_create': True}\\" invisible=\\"approver_type != 'user'\\"/>\\n                            <field name=\\"approver_group_id\\" string=\\"Odoo Group\\" options=\\"{'no_create': True}\\" invisible=\\"approver_type != 'group'\\"/>\\n                            <field name=\\"approver_display\\" readonly=\\"1\\"/>\\n                        </group>\\n                        <group string=\\"How Approvers Are Resolved\\">\\n                            <div class=\\"text-muted\\" colspan=\\"2\\">\\n                                <p><strong>Employee Manager:</strong> the employee's manager/Time Off approver.</p>\\n                                <p><strong>Work Location Manager:</strong> the Location Manager configured on the request's Work Location.</p>\\n                                <p><strong>HR Officer:</strong> active Time Off Officers in the request company.</p>\\n                                <p><strong>Specific User or Odoo Group:</strong> the selected active users in the request company.</p>\\n                            </div>\\n                        </group>\\n                    </group>\\n                    <div class=\\"alert alert-warning\\" role=\\"alert\\" invisible=\\"is_complete\\">\\n                        Complete Company, exactly one request type, Step Name, and the selected approver source. Incomplete steps are ignored, and a missing route blocks submission.\\n                    </div>\\n                </sheet>\\n            </form>"}	<form string="Approval Step">\n                <sheet>\n                    <widget name="web_ribbon" title="Needs Configuration" bg_color="text-bg-warning" invisible="is_complete"/>\n                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>\n                    <field name="is_complete" invisible="1"/>\n                    <field name="active" invisible="1"/>\n                    <field name="required" invisible="1"/>\n                    <div class="oe_title">\n                        <label for="name" string="Step Name"/>\n                        <h1><field name="name" placeholder="e.g. Manager Review"/></h1>\n                    </div>\n                    <div class="alert alert-info" role="alert">\n                        Each record is one mandatory approval step. Steps run from the smallest Order to the largest. Employees cannot submit when no complete route applies.\n                    </div>\n                    <group>\n                        <group string="1. Request Type">\n                            <field name="company_id" required="1"/>\n                            <field name="is_overtime_route" string="Overtime Route" help="Mark this step as the Overtime / Lembur approval route for the company/location scope."/>\n                            <field name="permission_type_id" string="Permission Type" domain="[('is_complete', '=', True), ('active', '=', True), ('company_id', '=', company_id)]" options="{'no_create': True}" invisible="leave_type_id or is_overtime_route"/>\n                            <field name="leave_type_id" string="Time Off Type" domain="[('active', '=', True), ('company_id', 'in', [False, company_id])]" options="{'no_create': True}" invisible="permission_type_id or is_overtime_route"/>\n                            <div class="alert alert-info" role="alert" colspan="2" invisible="not is_overtime_route">\n                                This step approves Presenly Overtime requests.\n                            </div>\n                            <field name="request_type_display" readonly="1"/>\n                            <field name="sequence" string="Order" help="Approval runs from the smallest Order to the largest. Suggested values: 10, 20, 30."/>\n                        </group>\n                        <group string="2. Work Location Scope">\n                            <field name="work_location_id" string="Only at Work Location" domain="[('active', '=', True), ('company_id', '=', company_id)]" options="{'no_create': True}" help="Leave empty for the company default route. Select a location only to override the default step at that site."/>\n                            <field name="scope_display" readonly="1"/>\n                            <div class="alert alert-light" role="alert" colspan="2">\n                                A location-specific step replaces the company-default step with the same Order for that location.\n                            </div>\n                        </group>\n                    </group>\n                    <group>\n                        <group string="3. Who Approves">\n                            <field name="approver_type" string="Approver Source"/>\n                            <field name="approver_user_id" string="Specific User" widget="many2one_avatar_user" domain="[('active', '=', True), ('company_ids', 'in', company_id)]" options="{'no_create': True}" invisible="approver_type != 'user'"/>\n                            <field name="approver_group_id" string="Odoo Group" options="{'no_create': True}" invisible="approver_type != 'group'"/>\n                            <field name="approver_display" readonly="1"/>\n                        </group>\n                        <group string="How Approvers Are Resolved">\n                            <div class="text-muted" colspan="2">\n                                <p><strong>Employee Manager:</strong> the employee's manager/Time Off approver.</p>\n                                <p><strong>Work Location Manager:</strong> the Location Manager configured on the request's Work Location.</p>\n                                <p><strong>HR Officer:</strong> active Time Off Officers in the request company.</p>\n                                <p><strong>Specific User or Odoo Group:</strong> the selected active users in the request company.</p>\n                            </div>\n                        </group>\n                    </group>\n                    <div class="alert alert-warning" role="alert" invisible="is_complete">\n                        Complete Company, exactly one request type, Step Name, and the selected approver source. Incomplete steps are ignored, and a missing route blocks submission.\n                    </div>\n                </sheet>\n            </form>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
799	16	\N	1	1	presenly.approval.request.search	presenly.approval.request	\N	search	presenly/views/presenly_approval_views.xml	primary	{"en_US": "<search string=\\"Approval Journeys\\">\\n                <field name=\\"target_display_name\\"/>\\n                <field name=\\"employee_id\\"/>\\n                <field name=\\"work_location_id\\"/>\\n                <filter name=\\"pending\\" string=\\"Pending\\" domain=\\"[('state', '=', 'pending')]\\"/>\\n                <filter name=\\"approved\\" string=\\"Approved\\" domain=\\"[('state', '=', 'approved')]\\"/>\\n                <filter name=\\"rejected\\" string=\\"Rejected\\" domain=\\"[('state', '=', 'rejected')]\\"/>\\n                <filter name=\\"cancelled\\" string=\\"Cancelled\\" domain=\\"[('state', '=', 'cancelled')]\\"/>\\n                <separator/>\\n                <filter name=\\"group_request_type\\" string=\\"Request Type\\" context=\\"{'group_by': 'target_model'}\\"/>\\n                <filter name=\\"group_employee\\" string=\\"Employee\\" context=\\"{'group_by': 'employee_id'}\\"/>\\n                <filter name=\\"group_location\\" string=\\"Work Location\\" context=\\"{'group_by': 'work_location_id'}\\"/>\\n                <filter name=\\"group_company\\" string=\\"Company\\" context=\\"{'group_by': 'company_id'}\\" groups=\\"base.group_multi_company\\"/>\\n            </search>"}	<search string="Approval Journeys">\n                <field name="target_display_name"/>\n                <field name="employee_id"/>\n                <field name="work_location_id"/>\n                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>\n                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>\n                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>\n                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>\n                <separator/>\n                <filter name="group_request_type" string="Request Type" context="{'group_by': 'target_model'}"/>\n                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>\n                <filter name="group_location" string="Work Location" context="{'group_by': 'work_location_id'}"/>\n                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>\n            </search>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
782	16	\N	1	1	presenly.schedule.generate.wizard.form	presenly.schedule.generate.wizard	\N	form	presenly/wizard/presenly_schedule_generate_views.xml	primary	{"en_US": "<form string=\\"Generate Locations from Working Hours\\">\\n                <sheet>\\n                    <div class=\\"oe_title\\">\\n                        <h1>Assign Work Locations to Working Hours</h1>\\n                    </div>\\n                    <div class=\\"alert alert-info\\" role=\\"alert\\">\\n                        Working Hours supplies the authoritative days and times. Review the preview and select the physical Work Location for every period.\\n                    </div>\\n                    <group>\\n                        <group string=\\"Source\\">\\n                            <field name=\\"employee_id\\" widget=\\"many2one_avatar_employee\\" readonly=\\"1\\"/>\\n                            <field name=\\"company_id\\" invisible=\\"1\\"/>\\n                            <field name=\\"calendar_id\\" readonly=\\"1\\"/>\\n                            <field name=\\"calendar_two_weeks\\" invisible=\\"1\\"/>\\n                        </group>\\n                        <group string=\\"Generation\\">\\n                            <field name=\\"generation_mode\\" widget=\\"radio\\"/>\\n                            <field name=\\"default_work_location_id\\" options=\\"{'no_create_edit': True}\\" help=\\"Used as the initial location for every preview row. Each row remains editable.\\"/>\\n                            <field name=\\"check_in_tolerance_minutes\\"/>\\n                            <field name=\\"line_count\\" readonly=\\"1\\"/>\\n                        </group>\\n                    </group>\\n                    <div class=\\"alert alert-warning\\" role=\\"alert\\" invisible=\\"generation_mode != 'replace'\\">\\n                        Replace mode deletes all regular Weekly location slots for this employee and rebuilds them from the preview. Specific Date exceptions are preserved.\\n                    </div>\\n                    <field name=\\"line_ids\\" nolabel=\\"1\\">\\n                        <list editable=\\"bottom\\" default_order=\\"weekday, week_type, hour_from\\">\\n                            <field name=\\"company_id\\" column_invisible=\\"True\\"/>\\n                            <field name=\\"weekday\\"/>\\n                            <field name=\\"week_type\\" optional=\\"hide\\"/>\\n                            <field name=\\"hour_from\\" widget=\\"float_time\\"/>\\n                            <field name=\\"hour_to\\" widget=\\"float_time\\"/>\\n                            <field name=\\"work_location_id\\" required=\\"1\\" options=\\"{'no_create_edit': True}\\"/>\\n                        </list>\\n                    </field>\\n                    <div class=\\"alert alert-info mt-3\\" role=\\"alert\\" invisible=\\"line_count == 0\\">\\n                        To assign two schools inside one work period, edit the first row's end time and add another row for the remaining time. Generated slots are validated against Working Hours.\\n                    </div>\\n                    <div class=\\"alert alert-success mt-3\\" role=\\"alert\\" invisible=\\"line_count != 0\\">\\n                        No unassigned fixed Working Hours periods were found. The regular schedule is already covered, or the Working Hours calendar is flexible/empty.\\n                    </div>\\n                </sheet>\\n                <footer>\\n                    <button name=\\"action_generate\\" type=\\"object\\" string=\\"Generate Location Slots\\" class=\\"btn-primary\\" invisible=\\"line_count == 0\\"/>\\n                    <button string=\\"Cancel\\" special=\\"cancel\\" class=\\"btn-secondary\\"/>\\n                </footer>\\n            </form>"}	<form string="Generate Locations from Working Hours">\n                <sheet>\n                    <div class="oe_title">\n                        <h1>Assign Work Locations to Working Hours</h1>\n                    </div>\n                    <div class="alert alert-info" role="alert">\n                        Working Hours supplies the authoritative days and times. Review the preview and select the physical Work Location for every period.\n                    </div>\n                    <group>\n                        <group string="Source">\n                            <field name="employee_id" widget="many2one_avatar_employee" readonly="1"/>\n                            <field name="company_id" invisible="1"/>\n                            <field name="calendar_id" readonly="1"/>\n                            <field name="calendar_two_weeks" invisible="1"/>\n                        </group>\n                        <group string="Generation">\n                            <field name="generation_mode" widget="radio"/>\n                            <field name="default_work_location_id" options="{'no_create_edit': True}" help="Used as the initial location for every preview row. Each row remains editable."/>\n                            <field name="check_in_tolerance_minutes"/>\n                            <field name="line_count" readonly="1"/>\n                        </group>\n                    </group>\n                    <div class="alert alert-warning" role="alert" invisible="generation_mode != 'replace'">\n                        Replace mode deletes all regular Weekly location slots for this employee and rebuilds them from the preview. Specific Date exceptions are preserved.\n                    </div>\n                    <field name="line_ids" nolabel="1">\n                        <list editable="bottom" default_order="weekday, week_type, hour_from">\n                            <field name="company_id" column_invisible="True"/>\n                            <field name="weekday"/>\n                            <field name="week_type" optional="hide"/>\n                            <field name="hour_from" widget="float_time"/>\n                            <field name="hour_to" widget="float_time"/>\n                            <field name="work_location_id" required="1" options="{'no_create_edit': True}"/>\n                        </list>\n                    </field>\n                    <div class="alert alert-info mt-3" role="alert" invisible="line_count == 0">\n                        To assign two schools inside one work period, edit the first row's end time and add another row for the remaining time. Generated slots are validated against Working Hours.\n                    </div>\n                    <div class="alert alert-success mt-3" role="alert" invisible="line_count != 0">\n                        No unassigned fixed Working Hours periods were found. The regular schedule is already covered, or the Working Hours calendar is flexible/empty.\n                    </div>\n                </sheet>\n                <footer>\n                    <button name="action_generate" type="object" string="Generate Location Slots" class="btn-primary" invisible="line_count == 0"/>\n                    <button string="Cancel" special="cancel" class="btn-secondary"/>\n                </footer>\n            </form>	f	t	2026-09-05 15:59:50.33502	2026-09-06 13:13:14.705541	f
