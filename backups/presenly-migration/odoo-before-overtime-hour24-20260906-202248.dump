 expr="//field[@name='note']" position="before">\n                <div invisible="activity_category != 'meeting'" class="text-muted text-center w-100">\n                    <div>\n                        <i class="fa fa-9x fa-calendar p-3" title="Calendar" aria-hidden="true"/>\n                    </div>\n                    <p>Schedule a meeting in your calendar</p>\n                </div>\n            </xpath>\n            <xpath expr="//button[@name='action_close_dialog']" position="before">\n                  <field name="calendar_event_id" invisible="1"/>\n                  <button string="Schedule" close="1" invisible="activity_category != 'meeting' or calendar_event_id" name="action_create_calendar_event" type="object" class="btn-primary"/>\n            </xpath>\n        </data>	f	t	2026-09-05 15:59:46.487049	2026-09-05 15:59:46.487049	\N
439	16	\N	1	1	Calendar Invitation Page for anonymous users	\N	calendar.invitation_page_anonymous	qweb	calendar/views/calendar_templates.xml	primary	{"en_US": "<t name=\\"Calendar Invitation Page for anonymous users\\" t-name=\\"calendar.invitation_page_anonymous\\">\\n        <t t-call=\\"web.layout\\">\\n            <t t-set=\\"head\\">\\n                <t t-call-assets=\\"web.assets_frontend\\" t-js=\\"false\\"/>\\n            </t>\\n\\n            <div class=\\"container\\">\\n                <div class=\\"o_logo\\">\\n                    <img t-attf-src=\\"/web/binary/company_logo?company={{ company.id }}\\" alt=\\"Logo\\"/>\\n                </div>\\n\\n                <div class=\\"card\\">\\n                    <div class=\\"card-header\\">\\n                        <h2>Calendar Invitation <small><t t-esc=\\"event.name\\"/></small></h2>\\n                    </div>\\n                    <div class=\\"card-body\\">\\n                        <div class=\\"clearfix mb16 d-flex justify-content-between align-content-center flex-grow-0\\">\\n                            <div class=\\"col d-flex\\">\\n                                <form t-if=\\"attendee.state != 'accepted'\\" method=\\"POST\\" t-attf-action=\\"/calendar/meeting/accept?{{keep_query()}}\\" class=\\"me-1 d-inline-block\\">\\n                                    <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                                    <button type=\\"submit\\" role=\\"button\\" class=\\"btn btn-primary btn-block\\">Accept</button>\\n                                </form>\\n                                <form t-if=\\"attendee.state != 'declined'\\" method=\\"POST\\" t-attf-action=\\"/calendar/meeting/decline?{{keep_query()}}\\" class=\\"ms-1 d-inline-block\\">\\n                                    <input type=\\"hidden\\" name=\\"csrf_token\\" t-att-value=\\"request.csrf_token()\\"/>\\n                                    <button type=\\"submit\\" role=\\"button\\" class=\\"btn btn-danger btn-block\\">Decline</button>\\n                                </form>\\n                            </div>\\n                            <span class=\\"float-end badge text-bg-info align-self-center\\" t-if=\\"attendee.state != 'needsAction'\\">\\n                                <t t-if=\\"attendee.state == 'accepted'\\">Yes I'm going.</t>\\n                                <t t-if=\\"attendee.state == 'declined'\\">No I'm not going.</t>\\n                                <t t-if=\\"attendee.state == 'tentative'\\">Tentative</t>\\n                                <t t-if=\\"attendee.state == 'needsAction'\\">No feedback yet</t>\\n                            </span>\\n                        </div>\\n\\n                        <div class=\\"table-responsive\\">\\n                            <table class=\\"o_event_table table table-striped\\">\\n                                <tr>\\n                                    <th>Invitation for</th>\\n                                    <td><t t-esc=\\"attendee.common_name\\"/> (<t t-esc=\\"attendee.email\\"/>)</td>\\n                                </tr>\\n                                <tr>\\n                                    <th>Date</th>\\n                                    <td><t t-esc=\\"event.display_time\\"/></td>\\n                                </tr>\\n                                <tr>\\n                                    <th>Location</th>\\n                                    <td><t t-esc=\\"event.location or '-'\\"/></td>\\n                                </tr>\\n                                <tr>\\n                                    <th>Attendees</th>\\n                                    <td>\\n                                        <ul>\\n                                            <li t-foreach=\\"event.attendee_ids\\" t-as=\\"attendee\\" t-attf-class=\\"o_#{attendee.state}\\">\\n                                                <t t-esc=\\"attendee.common_name\\"/>\\n                                            </li>\\n                                        </ul>\\n                                    </td>\\n                                </tr>\\n                                <tr>\\n                                    <th>Description</th>\\n                                    <td><t t-esc=\\"event.description or '-'\\"/></td>\\n                                </tr>\\n                            </table>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n        </t>\\n    </t>"}	<?xml version="1.0"?>\n<t name="Calendar Invitation Page for anonymous users" t-name="calendar.invitation_page_anonymous">\n        <t t-call="web.layout">\n            <t t-set="head">\n                <t t-call-assets="web.assets_frontend" t-js="false"/>\n            </t>\n\n            <div class="container">\n                <div class="o_logo">\n                    <img t-attf-src="/web/binary/company_logo?company={{ company.id }}" alt="Logo"/>\n                </div>\n\n                <div class="card">\n                    <div class="card-header">\n                        <h2>Calendar Invitation <small><t t-esc="event.name"/></small></h2>\n                    </div>\n                    <div class="card-body">\n                        <div class="clearfix mb16 d-flex justify-content-between align-content-center flex-grow-0">\n                            <div class="col d-flex">\n                                <form t-if="attendee.state != 'accepted'" method="POST" t-attf-action="/calendar/meeting/accept?{{keep_query()}}" class="me-1 d-inline-block">\n                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                                    <button type="submit" role="button" class="btn btn-primary btn-block">Accept</button>\n                                </form>\n                                <form t-if="attendee.state != 'declined'" method="POST" t-attf-action="/calendar/meeting/decline?{{keep_query()}}" class="ms-1 d-inline-block">\n                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>\n                                    <button type="submit" role="button" class="btn btn-danger btn-block">Decline</button>\n                                </form>\n                            </div>\n                            <span class="float-end badge text-bg-info align-self-center" t-if="attendee.state != 'needsAction'">\n                                <t t-if="attendee.state == 'accepted'">Yes I'm going.</t>\n                                <t t-if="attendee.state == 'declined'">No I'm not going.</t>\n                                <t t-if="attendee.state == 'tentative'">Tentative</t>\n                                <t t-if="attendee.state == 'needsAction'">No feedback yet</t>\n                            </span>\n                        </div>\n\n                        <div class="table-responsive">\n                            <table class="o_event_table table table-striped">\n                                <tr>\n                                    <th>Invitation for</th>\n                                    <td><t t-esc="attendee.common_name"/> (<t t-esc="attendee.email"/>)</td>\n                                </tr>\n                                <tr>\n                                    <th>Date</th>\n                                    <td><t t-esc="event.display_time"/></td>\n                                </tr>\n                                <tr>\n                                    <th>Location</th>\n                                    <td><t t-esc="event.location or '-'"/></td>\n                                </tr>\n                                <tr>\n                                    <th>Attendees</th>\n                                    <td>\n                                        <ul>\n                                            <li t-foreach="event.attendee_ids" t-as="attendee" t-attf-class="o_#{attendee.state}">\n                                                <t t-esc="attendee.common_name"/>\n                                            </li>\n                                        </ul>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <th>Description</th>\n                                    <td><t t-esc="event.description or '-'"/></td>\n                                </tr>\n                            </table>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </t>\n    </t>\n	f	t	2026-09-05 15:59:46.487049	2026-09-05 15:59:46.487049	\N
