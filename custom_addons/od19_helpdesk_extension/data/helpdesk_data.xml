<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Teams -->
    <record id="team_internal_it" model="helpdesk.ticket.team">
        <field name="name">Internal IT Helpdesk</field>
        <field name="team_type">internal</field>
        <field name="show_in_portal" eval="False" />
        <field name="sequence">10</field>
        <!-- Members: helpdesk_mgmt requires the user to belong to the team
             before "Assign to me" is allowed (see helpdesk.ticket.assign_to_me). -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <record id="team_sales_services" model="helpdesk.ticket.team">
        <field name="name">Sales Services</field>
        <field name="team_type">customer_service</field>
        <field name="show_in_portal" eval="True" />
        <field name="sequence">20</field>
    </record>

    <!-- Stages - Internal IT Helpdesk -->
    <record id="stage_internal_new" model="helpdesk.ticket.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
        <field name="unattended" eval="True" />
        <field name="team_ids" eval="[(6, 0, [ref('team_internal_it')])]" />
    </record>
    <record id="stage_internal_in_progress" model="helpdesk.ticket.stage">
        <field name="name">In Progress</field>
        <field name="sequence">2</field>
        <field name="team_ids" eval="[(6, 0, [ref('team_internal_it')])]" />
    </record>
    <record id="stage_internal_resolved" model="helpdesk.ticket.stage">
        <field name="name">Resolved</field>
        <field name="sequence">3</field>
        <field name="team_ids" eval="[(6, 0, [ref('team_internal_it')])]" />
    </record>
    <record id="stage_internal_closed" model="helpdesk.ticket.stage">
        <field name="name">Closed</field>
        <field name="sequence">4</field>
        <field name="closed" eval="True" />
        <field name="fold" eval="True" />
        <field name="team_ids" eval="[(6, 0, [ref('team_internal_it')])]" />
    </record>

    <!-- Stages - Sales Services -->
    <record id="stage_sales_new" model="helpdesk.ticket.stage">
        <field name="name">New</field>
        <field name="sequence">1</field>
        <field name="unattended" eval="True" />
        <field name="team_ids" eval="[(6, 0, [ref('team_sales_services')])]" />
    </record>
    <record id="stage_sales_confirmed" model="helpdesk.ticket.stage">
        <field name="name">Confirmed</field>
        <field name="sequence">2</field>
        <field name="team_ids" eval="[(6, 0, [ref('team_sales_services')])]" />
    </record>
    <record id="stage_sales_on_site" model="helpdesk.ticket.stage">
        <field name="name">On Site</field>
        <field name="sequence">3</field>
        <field name="team_ids" eval="[(6, 0, [ref('team_sales_services')])]" />
    </record>
    <record id="stage_sales_done" model="helpdesk.ticket.stage">
        <field name="name">Done</field>
        <field name="sequence">4</field>
        <field name="team_ids" eval="[(6, 0, [ref('team_sales_services')])]" />
    </record>
    <record id="stage_sales_invoiced" model="helpdesk.ticket.stage">
        <field name="name">Invoiced</field>
        <field name="sequence">5</field>
        <field name="closed" eval="True" />
        <field name="fold" eval="True" />
        <field name="team_ids" eval="[(6, 0, [ref('team_sales_services')])]" />
    </record>
</odoo>
