<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      ============================================================
      De pagina's naast de homepage
      ============================================================
      Nagebouwd op de proof of concept van Bosh & Bordon. Zelfde opbouw als
      de homepage: de bouwstenen uit homepage.xml (hero, getuigenis, vragen)
      met eigen inhoud, en geen `oe_structure`, zodat de website-builder er
      niet in kan en een deploy de pagina herstelt.
    -->

    <!-- ========================================================= -->
    <!-- Onze diensten                                              -->
    <!-- ========================================================= -->
    <template id="page_services" name="Our services">
        <t t-call="website.layout">
            <div id="wrap" class="o_byp_page">

                <t t-call="byp_website.byp_hero">
                    <t t-set="title_1">Your party.</t>
                    <t t-set="title_2">Your choice.</t>
                    <t t-set="lead">From tents and furniture to food trucks: choose what you need and put your party together easily, your way and within your budget.</t>
                    <t t-set="mascot" t-value="'frog-mascot-2.svg'"/>
                    <t t-set="mascot_w" t-value="193"/>
                    <t t-set="mascot_h" t-value="310"/>
                </t>

                <!-- Tenten: foto met de kop bovenaan en de uitleg onderaan. -->
                <section class="o_byp_photo o_byp_photo_wide"
                         style="background-image: url('/byp_website/static/src/img/de-juiste-setting.jpg');">
                    <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 101px;"/>
                    <div class="o_byp_grid">
                        <div class="row g-0 o_byp_cols">
                            <div class="col-lg-6">
                                <h2>Start with the right setting.</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 27px;"/>
                                <p>From canopy to party tent</p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 122px; --sp-xl: 222px;"/>
                                <p>Choose a tent that suits your location, number of guests and the atmosphere you want. From a compact canopy to a larger party tent with room for tables, a bar and a dance floor.</p>
                            </div>
                        </div>
                        <!-- De lege rechterkolom van B&B: 15px zolang ze onder
                             de tekst staat, tot lg. -->
                        <div class="o_byp_sp d-lg-none" style="--sp: 15px; --sp-md: 16px;"/>
                    </div>
                    <div class="o_byp_sp" style="--sp: 50px; --sp-xl: 65px;"/>
                </section>

                <!-- Meubilair -->
                <section class="o_byp_bg_blue">
                    <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 100px;"/>
                    <div class="o_byp_grid">
                        <h2 class="o_byp_title_narrow">Furnish your party entirely yourself</h2>
                        <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 27px;"/>
                        <p>From tables to chairs</p>
                    </div>
                    <div class="o_byp_sp" style="--sp: 50px; --sp-md: 80px; --sp-xl: 165px;"/>
                    <div class="o_byp_grid">
                        <div class="row g-0 o_byp_cols o_byp_offset_cols">
                            <div class="col-md-6">
                                <p>From tables and chairs to high tables, lighting, bars and other party furniture: choose what you need to make your venue practical and cosy.</p>
                                <div class="o_byp_sp" style="--sp: 30px; --sp-md: 0px;"/>
                            </div>
                            <div class="col-md-6">
                                <p>We deliver everything to you. You decide the layout and set everything up the way that suits your party. That way you easily create the right atmosphere, without unnecessary extra costs.</p>
                            </div>
                        </div>
                    </div>
                    <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 123px;"/>
                </section>

                <!-- Foodtrucks -->
                <section class="o_byp_split o_byp_bg_brown">
                    <div class="o_byp_grid">
                        <div class="row g-0">
                            <div class="col-md-6">
                                <img class="o_byp_split_img"
                                     src="/byp_website/static/src/img/smaakmakers.jpg" width="1054" height="950"
                                     alt="Food truck at a garden party"/>
                            </div>
                            <div class="col-md-6 o_byp_split_body">
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 100px;"/>
                                <h2>Flavour makers for every party</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 27px;"/>
                                <p>From street food to dessert</p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-xl: 79px;"/>
                                <p>From burgers and pizza to street food and sweets: choose a food truck that suits your party and your guests. That way you add atmosphere and great food to your event right away, without the hassle.</p>
                                <p>The food truck comes to your location and takes care of the rest on site. You choose what fits your party and budget, without having to organise full catering yourself.</p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 143px;"/>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-call="byp_website.byp_faq">
                    <t t-set="faq_id" t-value="'byp_faq_services'"/>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="1"/>
                        <t t-set="question">What kinds of tents can I choose?</t>
                        You choose from different sizes and layouts, depending on your location, number of guests and type of party.
                    </t>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="2"/>
                        <t t-set="question">Can I combine tents and furniture?</t>
                        Yes. You put together your own package and combine only the parts you need for your party.
                    </t>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="3"/>
                        <t t-set="question">Can I rent just furniture?</t>
                        Absolutely. You don't have to take a full package. Tables, chairs and other party furniture can also be chosen separately.
                    </t>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="4"/>
                        <t t-set="question">Which food trucks are available?</t>
                        The offer varies by date and location. In the tool you can see which food trucks are available and what they offer.
                    </t>
                </t>

                <!-- Events op maat: doorverwijzing naar Creact -->
                <section class="o_byp_split o_byp_bg_blue">
                    <div class="o_byp_grid">
                        <div class="row g-0">
                            <div class="col-md-6">
                                <img class="o_byp_split_img"
                                     src="/byp_website/static/src/img/op-maat.jpg" width="1054" height="952"
                                     alt="Banquet hall set for a large event"/>
                            </div>
                            <div class="col-md-6 o_byp_split_body">
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 100px;"/>
                                <h2>For tailor-made<br/>events</h2>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-xl: 76px;"/>
                                <p>For larger, more complex or fully supported events, you can turn to Creact.</p>
                                <p>From concept and planning to full execution: there you get support tailored to your event.</p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 124px;"/>
                                <a class="o_byp_btn" href="https://creact.be" target="_blank" rel="noopener">Go to Creact</a>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-xl: 73px;"/>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <record id="page_services_record" model="website.page">
        <field name="url">/onze-diensten</field>
        <field name="view_id" ref="page_services"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Our services - Build Your Party</field>
        <field name="website_meta_description">From tents and furniture to food trucks: choose what you need and put your party together easily, your way and within your budget.</field>
    </record>

    <!-- ========================================================= -->
    <!-- Over ons                                                   -->
    <!-- ========================================================= -->
    <template id="page_about" name="About us">
        <t t-call="website.layout">
            <div id="wrap" class="o_byp_page">

                <t t-call="byp_website.byp_hero">
                    <t t-set="title_1">More party.</t>
                    <t t-set="title_2">Less hassle.</t>
                    <t t-set="lead">Build Your Party makes it easier to pull off a great party yourself. With clear choices, a smart offer and a grip on your budget, you arrange more yourself.</t>
                    <t t-set="mascot" t-value="'frog-mascot-3.svg'"/>
                    <t t-set="mascot_w" t-value="310"/>
                    <t t-set="mascot_h" t-value="292"/>
                    <t t-set="mascot_class" t-value="'o_byp_mascot_wide'"/>
                    <t t-set="hero_class" t-value="'o_byp_hero_wide'"/>
                </t>

                <!-- Drie waarden -->
                <section class="o_byp_bg_blue">
                    <div class="o_byp_sp" style="--sp: 70px; --sp-md: 150px; --sp-xl: 254px;"/>
                    <div class="o_byp_grid">
                        <div class="row g-0 o_byp_cols o_byp_three">
                            <div class="col-md-4">
                                <h2>Simplicity</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 24px;"/>
                                <p>No complicated formulas or endless arranging. You choose what you need and know right away where you stand.</p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 0px;"/>
                            </div>
                            <div class="col-md-4">
                                <h2>Freedom</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 24px;"/>
