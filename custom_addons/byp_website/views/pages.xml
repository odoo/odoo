                            </div>
                        </div>
                    </div>
                    <div class="o_byp_sp" style="--sp: 50px; --sp-md: 70px; --sp-xl: 123px;"/>
                </section>

                <t t-call="byp_website.byp_quote">
                    <t t-set="image" t-value="'jarne.jpg'"/>
                    <t t-set="image_w" t-value="1056"/>
                    <t t-set="image_h" t-value="840"/>
                    <t t-set="name">Jarne Vercruysse</t>
                    <t t-set="quote">A great party doesn't have to be complicated. With the right choices, you get a long way.</t>
                </t>

            </div>
        </t>
    </template>

    <record id="page_about_record" model="website.page">
        <field name="url">/over-ons</field>
        <field name="view_id" ref="page_about"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">About us - Build Your Party</field>
        <field name="website_meta_description">Build Your Party makes it easier to pull off a great party yourself. With clear choices, a smart offer and a grip on your budget, you arrange more yourself.</field>
    </record>

    <!-- ========================================================= -->
    <!-- Professionals                                              -->
    <!-- ========================================================= -->
    <!--
      Het formulier is het standaard websiteformulier van Odoo
      (website/static/src/snippets/s_website_form), in de opmaak van B&B.
      Dezelfde motor als /contactus: het verstuurt een mail via mail.mail,
      met antispam en validatie inbegrepen.

      `email_to` moet een vaste waarde in de template zijn. Odoo ondertekent
      dat adres bij het compileren (website/tools.py, add_form_signature) en
      weigert bij verzending elk ander adres. Zo kan niemand het formulier
      misbruiken om naar willekeurige adressen te mailen.

      De velden zonder vaste plek in mail.mail (voornaam, naam, telefoon,
      bedrijf) zijn `s_website_form_custom`: Odoo zet ze netjes onder elkaar
      in de mail.
    -->
    <template id="page_professionals" name="Professionals">
        <t t-call="website.layout">
            <div id="wrap" class="o_byp_page">

                <t t-call="byp_website.byp_hero">
                    <t t-set="title_1">Build something</t>
                    <t t-set="title_2">together?</t>
                    <t t-set="hero_class" t-value="'o_byp_hero_small'"/>
                    <t t-set="sp_top" t-value="'--sp: 70px; --sp-md: 33px;'"/>
                    <t t-set="sp_gap" t-value="'--sp: 50px; --sp-xl: 64px;'"/>
                    <t t-set="sp_bottom" t-value="'--sp: 50px; --sp-md: 60px; --sp-xl: 85px;'"/>

                    <section class="s_website_form o_byp_form" data-snippet="s_website_form" data-vcss="001">
                        <form id="byp_professionals_form" action="/website/form/" method="post"
                              enctype="multipart/form-data"
                              data-model_name="mail.mail"
                              data-success-mode="message">
                            <div class="s_website_form_rows">

                                <div class="s_website_form_field s_website_form_dnone" data-type="char">
                                    <input type="hidden" class="form-control s_website_form_input"
                                           name="email_to" value="info@buildyourparty.be"/>
                                </div>
                                <div class="s_website_form_field s_website_form_dnone" data-type="char">
                                    <input type="hidden" class="form-control s_website_form_input"
                                           name="subject" value="New request via Professionals"/>
                                </div>

                                <div class="s_website_form_field s_website_form_custom s_website_form_required" data-type="char">
                                    <label class="visually-hidden s_website_form_label" for="byp_prof_firstname">
                                        <span class="s_website_form_label_content">First name</span>
                                    </label>
                                    <input id="byp_prof_firstname" class="form-control s_website_form_input"
                                           type="text" name="First name" placeholder="First name" required="1"/>
                                </div>
                                <div class="s_website_form_field s_website_form_custom s_website_form_required" data-type="char">
                                    <label class="visually-hidden s_website_form_label" for="byp_prof_lastname">
                                        <span class="s_website_form_label_content">Last name</span>
                                    </label>
                                    <input id="byp_prof_lastname" class="form-control s_website_form_input"
                                           type="text" name="Last name" placeholder="Last name" required="1"/>
                                </div>

                                <div class="s_website_form_field s_website_form_model_required" data-type="email">
                                    <label class="visually-hidden s_website_form_label" for="byp_prof_email">
                                        <span class="s_website_form_label_content">Email</span>
                                    </label>
                                    <input id="byp_prof_email" class="form-control s_website_form_input"
                                           type="email" name="email_from" placeholder="Email" required="1"/>
                                </div>
                                <div class="s_website_form_field s_website_form_custom s_website_form_required" data-type="tel">
                                    <label class="visually-hidden s_website_form_label" for="byp_prof_phone">
                                        <span class="s_website_form_label_content">Phone</span>
                                    </label>
                                    <input id="byp_prof_phone" class="form-control s_website_form_input"
                                           type="tel" name="Phone" placeholder="Phone" required="1"/>
                                </div>

                                <div class="o_byp_form_wide s_website_form_field s_website_form_custom s_website_form_required" data-type="char">
                                    <label class="visually-hidden s_website_form_label" for="byp_prof_company">
                                        <span class="s_website_form_label_content">Company</span>
                                    </label>
                                    <input id="byp_prof_company" class="form-control s_website_form_input"
                                           type="text" name="Company" placeholder="Company" required="1"/>
                                </div>

                                <div class="o_byp_form_wide o_byp_form_message s_website_form_field s_website_form_custom s_website_form_required" data-type="text">
                                    <label class="visually-hidden s_website_form_label" for="byp_prof_message">
                                        <span class="s_website_form_label_content">Message</span>
                                    </label>
                                    <textarea id="byp_prof_message" class="form-control s_website_form_input"
                                              name="Message" placeholder="Message" rows="1" required="1"/>
                                </div>

                                <div class="o_byp_form_wide o_byp_form_privacy s_website_form_field s_website_form_custom s_website_form_required" data-type="boolean">
                                    <div class="form-check d-flex align-items-center gap-3 ps-0">
                                        <input id="byp_prof_privacy" class="form-check-input s_website_form_input m-0"
                                               type="checkbox" name="Privacy policy accepted" value="Yes" required="1"/>
                                        <label class="form-check-label s_website_form_label" for="byp_prof_privacy">
                                            <span class="s_website_form_label_content">I agree to the <a href="/privacy-policy">privacy policy</a></span>
                                        </label>
                                    </div>
                                </div>

                                <div class="o_byp_form_wide o_byp_form_send s_website_form_submit">
                                    <a href="#" role="button" class="o_byp_btn s_website_form_send">Send message</a>
                                    <span id="s_website_form_result" class="d-block"/>
                                </div>
                            </div>
                        </form>
                        <!-- Succesmodus "message": Odoo verbergt het formulier
                             en toont dit element (form.js, _endMessage). Een
                             gewone tekst, dus vertaalbaar; een
                             data-attribuut zou dat niet zijn. -->
                        <div class="s_website_form_end_message d-none">
                            <p>Thank you! We will get back to you soon.</p>
                        </div>
                    </section>
                </t>

                <!-- Onze gegevens -->
                <section class="o_byp_bg_brown">
                    <div class="o_byp_sp" style="--sp: 70px; --sp-xl: 103px;"/>
                    <div class="o_byp_grid">
                        <h3 class="text-center">Our details</h3>
                    </div>
                    <div class="o_byp_sp" style="--sp: 50px; --sp-md: 80px; --sp-xl: 128px;"/>
                    <div class="o_byp_grid">
                        <div class="row g-0 o_byp_cols o_byp_three">
                            <div class="col-md-4">
                                <h2>Contact</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 24px;"/>
                                <p>
                                    <a href="tel:+32470213465">+32 470 21 34 65</a><br/>
                                    <a href="mailto:info@buildyourparty.be">info@buildyourparty.be</a>
                                </p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 0px;"/>
                            </div>
                            <div class="col-md-4">
                                <h2>Office</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 24px;"/>
                                <p>
                                    <a href="https://maps.app.goo.gl/xeSA5kAnBbRCJNMe9" target="_blank" rel="noopener">
                                        Gaversesteenweg 422 bus 001,<br/>9820 Merelbeke-Melle
                                    </a>
                                </p>
                                <div class="o_byp_sp" style="--sp: 50px; --sp-md: 0px;"/>
                            </div>
                            <div class="col-md-4">
                                <h2>Follow us</h2>
                                <div class="o_byp_sp" style="--sp: 15px; --sp-xl: 24px;"/>
                                <p>
                                    <a href="https://www.facebook.com/people/Creact/100070864295655/" target="_blank" rel="noopener">Facebook</a><br/>
                                    <a href="https://www.instagram.com/creactbv/" target="_blank" rel="noopener">Instagram</a>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="o_byp_sp" style="--sp: 70px; --sp-md: 120px; --sp-xl: 215px;"/>
                </section>

                <t t-call="byp_website.byp_faq">
                    <t t-set="faq_id" t-value="'byp_faq_prof'"/>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="1"/>
                        <t t-set="question">Can I become a supplier?</t>
                        Absolutely. We'd love to hear from companies that add something to the Build Your Party offer. Send us more information about your products, services, region and way of working, and we'll see whether there is a match.
                    </t>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="2"/>
                        <t t-set="question">What partners are you looking for?</t>
                        We're open to a wide range of collaborations within events, such as tents, furniture, catering, food trucks, equipment and additional services.
                    </t>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="3"/>
                        <t t-set="question">Do I need to be active across all of Belgium?</t>
                        Not necessarily. Clearly state the region you're active in, so we can immediately assess where a collaboration is possible.
                    </t>
                    <t t-call="byp_website.byp_faq_item">
                        <t t-set="faq_index" t-value="4"/>
                        <t t-set="question">Can I propose a new product or concept?</t>
                        Gladly. If you have something that fits the Build Your Party concept, feel free to send it over. We always look at new ideas in terms of the added value for our users.
                    </t>
                </t>

            </div>
        </t>
    </template>

    <record id="page_professionals_record" model="website.page">
        <field name="url">/professionals</field>
        <field name="view_id" ref="page_professionals"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Professionals - Build Your Party</field>
        <field name="website_meta_description">Want to become a supplier or partner of Build Your Party? Get in touch.</field>
    </record>

    <!--
      ============================================================
      De vier menu-items
      ============================================================
      Bewust ZONDER `website_id` en met `website.main_menu` als ouder.

      In website.menu.create (website/models/website_menu.py, regel 134) zit
      deze haak:

          if not parent_id or (default_menu and parent_id == default_menu.id):
              parent_id = website.menu_id.id

      Een item zonder website_id en onder het standaardmenu wordt dus
      automatisch gekopieerd naar de eigen menuboom van elke website. Zou je
      hier website_id invullen, dan komt het item alleen op die ene website en
      krijgt een tweede website later niets.

      Het vroegere item "Contact" (naar /contactus) is weg, zoals in het
      ontwerp van B&B: de contactgegevens staan nu op Professionals. Omdat het
      record uit dit bestand verdwenen is, ruimt een module-upgrade het op,
      en website.menu.unlink neemt de kopieën per website mee.
    -->

    <record id="menu_home" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/</field>
        <field name="page_id" ref="byp_website.homepage_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">10</field>
    </record>

    <record id="menu_services" model="website.menu">
        <field name="name">Our services</field>
        <field name="url">/onze-diensten</field>
        <field name="page_id" ref="byp_website.page_services_record"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>

    <record id="menu_about" model="website.menu">
        <field name="name">About us</field>
        <field name="url">/over-ons</field>
        <field name="page_id" ref="byp_website.page_about_record"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">30</field>
    </record>

    <record id="menu_professionals" model="website.menu">
        <field name="name">Professionals</field>
        <field name="url">/professionals</field>
        <field name="page_id" ref="byp_website.page_professionals_record"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">40</field>
    </record>

</odoo>
