<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      ============================================================
      De toolpagina: /bouw-je-feest
      ============================================================
      Dit is de bestemming van de knop "Naar de tool" in de navigatiebalk.

      De configurator zelf zit al in `event_builder.s_event_builder`, het
      website-blok dat je ook in de editor kan slepen. Hier roepen we dat
      template rechtstreeks aan met `t-call`. Zo staat de configurator maar
      op één plek: verandert de opbouw van het blok, dan verandert deze
      pagina mee, zonder dat we iets hoeven te kopieren.

      Het lege `data-config-id` in dat blok betekent "neem de eerste actieve
      configurator". Wil je hier een specifieke, dan kan je het blok in een
      eigen sectie zetten en het attribuut invullen.

      Net als de homepage: geen `oe_structure`, dus de website-builder kan er
      niet in en een module-upgrade herstelt de pagina.

      De kleuren van de configurator zelf staan niet hier maar in
      byp_website.scss, onder `.o_byp_tool`: daar worden de variabelen
      overschreven die event_builder en Bootstrap lezen. Zo blijft
      event_builder neutraal en draagt alleen deze pagina de huisstijl.
    -->
    <template id="tool_page" name="Build your party">
        <t t-call="website.layout">
            <div id="wrap" class="o_byp_tool">

                <!-- Dezelfde kop als op de andere pagina's, zonder mascotte:
                     de bezoeker moet hier snel aan de slag kunnen. -->
                <t t-call="byp_website.byp_hero">
                    <t t-set="title_1">Build your</t>
                    <t t-set="title_2">party.</t>
                    <t t-set="lead">Choose your date, the number of guests and your formula. The price updates live, and you book with a deposit.</t>
                </t>

                <!-- De configurator -->
                <t t-call="event_builder.s_event_builder"/>

            </div>
        </t>
    </template>

    <record id="tool_page_record" model="website.page">
        <field name="url">/bouw-je-feest</field>
        <field name="view_id" ref="tool_page"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Build your party - Build Your Party</field>
        <field name="website_meta_description">Put your event together, see right away what it costs and book with a deposit.</field>
    </record>

</odoo>
