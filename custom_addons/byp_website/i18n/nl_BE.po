#: model_terms:ir.ui.view,arch_db:byp_website.page_services
msgid "Food truck at a garden party"
msgstr "Foodtruck op een tuinfeest"

#. module: byp_website
#: model_terms:ir.ui.view,arch_db:byp_website.page_services
msgid ""
"For larger, more complex or fully supported events, you can turn to Creact."
msgstr ""
"Voor grotere, complexere of volledig begeleide events kan je terecht bij "
"Creact."

#. module: byp_website
#: model_terms:ir.ui.view,arch_db:byp_website.page_services
msgid "For tailor-made<br/>events"
msgstr "Voor events<br/>op maat"

#. module: byp_website
#: model_terms:ir.ui.view,arch_db:byp_website.page_about
msgid "Freedom"
