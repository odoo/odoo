<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_timesheet_invoice_wizard_form" model="ir.ui.view">
        <field name="name">od19.timesheet.invoice.wizard.form</field>
        <field name="model">od19.timesheet.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Timesheets">
                <group>
                    <field name="sale_order_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"
                           readonly="context.get('default_sale_order_ids')"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>
                <p class="text-muted">
                    ระบบจะเรียกเก็บเฉพาะ Timesheet ที่ผูกกับรายการขายแบบ
                    "เรียกเก็บตามเวลาที่ใช้" และยังไม่ถูกออกใบแจ้งหนี้
                </p>
                <footer>
                    <button name="action_create_invoices"
                            string="Create Invoices"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
