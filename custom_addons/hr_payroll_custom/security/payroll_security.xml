<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_payroll">
        <field name="name">Payroll</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_payroll_employee" model="res.groups">
        <field name="name">Employee: Read Own Payslips</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_payroll_user" model="res.groups">
        <field name="name">Officer: Manage Payroll</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_employee'))]"/>
    </record>

    <record id="group_payroll_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Company rules are global so they intersect with role-specific rules. -->
    <record id="rule_payroll_batch_multi_company" model="ir.rule">
        <field name="name">Payroll Batch Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Multi-company rule for custom.payroll.slip -->
    <record id="rule_payroll_slip_multi_company" model="ir.rule">
        <field name="name">Payroll Slip Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_slip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Multi-company rule for custom.payroll.tunjangan -->
    <record id="rule_payroll_tunjangan_multi_company" model="ir.rule">
        <field name="name">Payroll Tunjangan Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_tunjangan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Multi-company rule for custom.payroll.bpjs -->
    <record id="rule_payroll_bpjs_multi_company" model="ir.rule">
        <field name="name">Payroll BPJS Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_bpjs"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Multi-company rule for custom.payroll.potongan.tetap -->
    <record id="rule_payroll_potongan_tetap_multi_company" model="ir.rule">
        <field name="name">Payroll Potongan Tetap Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_potongan_tetap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_payroll_slip_employee" model="ir.rule">
        <field name="name">Employee: Read Own Paid Payslips</field>
        <field name="model_id" ref="model_custom_payroll_slip"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id), ('status', '=', 'paid')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_payroll_employee'))]"/>
    </record>

    <record id="rule_payroll_slip_officer" model="ir.rule">
        <field name="name">Payroll Officer: Manage Company Payslips</field>
        <field name="model_id" ref="model_custom_payroll_slip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>

    <record id="rule_payroll_slip_manager" model="ir.rule">
        <field name="name">Payroll Administrator: Full Payslip Access</field>
        <field name="model_id" ref="model_custom_payroll_slip"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_manager'))]"/>
    </record>

    <record id="rule_payroll_slip_detail_multi_company" model="ir.rule">
        <field name="name">Payslip Detail Multi Company</field>
        <field name="model_id" ref="model_custom_payroll_slip_detail"/>
        <field name="domain_force">[('slip_gaji_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_payroll_slip_detail_employee" model="ir.rule">
        <field name="name">Employee: Read Own Paid Payslip Details</field>
        <field name="model_id" ref="model_custom_payroll_slip_detail"/>
        <field name="domain_force">[('slip_gaji_id.employee_id.user_id', '=', user.id), ('slip_gaji_id.status', '=', 'paid')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_payroll_employee'))]"/>
    </record>

    <record id="rule_payroll_slip_detail_officer" model="ir.rule">
        <field name="name">Payroll Officer: Manage Company Payslip Details</field>
        <field name="model_id" ref="model_custom_payroll_slip_detail"/>
        <field name="domain_force">[('slip_gaji_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_user'))]"/>
    </record>

    <record id="rule_payroll_slip_detail_manager" model="ir.rule">
        <field name="name">Payroll Administrator: Full Payslip Detail Access</field>
        <field name="model_id" ref="model_custom_payroll_slip_detail"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_payroll_manager'))]"/>
    </record>
</odoo>
