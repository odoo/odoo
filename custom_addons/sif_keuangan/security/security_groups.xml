<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sif_keuangan_user" model="res.groups">
        <field name="name">Keuangan SIFNEXT: Staf</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sif_keuangan_manager" model="res.groups">
        <field name="name">Keuangan SIFNEXT: Super User</field>
        <field name="implied_ids" eval="[(4, ref('group_sif_keuangan_user'))]"/>
    </record>

    <record id="group_sif_keuangan_central_readonly" model="res.groups">
        <field name="name">Keuangan SIFNEXT: Finance Pusat (Read Only)</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="sif_jurnal_entry_company_rule" model="ir.rule">
        <field name="name">Jurnal: allowed companies</field>
        <field name="model_id" ref="model_sif_jurnal_entry"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sif_jurnal_line_company_rule" model="ir.rule">
        <field name="name">Journal lines: allowed companies</field>
        <field name="model_id" ref="model_sif_jurnal_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sif_general_ledger_company_rule" model="ir.rule">
        <field name="name">General ledger: allowed companies</field>
        <field name="model_id" ref="model_sif_buku_besar"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
