<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================= -->
    <!-- 1. POPUP WIZARD FILTER TANGGAL AWAL & AKHIR BUKU BESAR             -->
    <!-- ================================================================= -->
    <record id="view_sif_buku_besar_wizard_form" model="ir.ui.view">
        <field name="name">sif.buku.besar.wizard.form</field>
        <field name="model">sif.buku.besar.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Periode Buku Besar">
                <sheet>
                    <div class="oe_title">
                        <h2>Filter Periode Buku Besar</h2>
                    </div>
                    <group>
                        <group string="Rentang Tanggal">
                            <field name="date_from" string="Tanggal Awal"/>
                            <field name="date_to" string="Tanggal Akhir"/>
                        </group>
                        <group string="Filter Tambahan (Opsional)">
                            <field name="account_id" string="Account"/>
                            <field name="project_code" string="Kode Proyek"/>
                            <field name="unit_name" string="Unit Kerja"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_open_buku_besar" string="Tampilkan Buku Besar" type="object" class="btn-primary"/>
                        <button string="Batal" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sif_buku_besar_wizard" model="ir.actions.act_window">
        <field name="name">Filter Periode Buku Besar</field>
        <field name="res_model">sif.buku.besar.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================================================================= -->
    <!-- 2. VIEW BUKU BESAR (SEPERTI SISKEU LAMA + UNIT KERJA)             -->
    <!-- ================================================================= -->
    <record id="view_sif_buku_besar_list" model="ir.ui.view">
        <field name="name">sif.jurnal.line.list</field>
        <field name="model">sif.jurnal.line</field>
        <field name="arch" type="xml">
            <list string="Buku Besar" create="false" edit="false">
                <header>
                    <button name="%(action_sif_buku_besar_wizard)d" string="Ganti Periode Tanggal" type="action" class="btn-primary"/>
                </header>
                <field name="date" string="Tanggal"/>
                <field name="project_code" string="Kode Proy"/>
                <field name="unit_name" string="Unit Kerja"/>
                <field name="entry_number" string="Bukti / Nomer"/>
                <field name="kwitansi_ref" string="Kwitansi" optional="show"/>
                <field name="name" string="Keterangan"/>
                <field name="account_code" string="Account"/>
                <field name="account_name" string="Nama Account" optional="show"/>
                <field name="debit" string="Debet" sum="Total Debet"/>
                <field name="credit" string="Kredit" sum="Total Kredit"/>
            </list>
        </field>
    </record>

    <record id="view_sif_buku_besar_search" model="ir.ui.view">
        <field name="name">sif.jurnal.line.search</field>
        <field name="model">sif.jurnal.line</field>
        <field name="arch" type="xml">
            <search string="Pencarian Buku Besar">
                <field name="entry_number" string="Bukti / Nomer"/>
                <field name="project_code" string="Kode Proyek"/>
                <field name="unit_name" string="Unit Kerja"/>
                <field name="account_id" string="Account"/>
                <field name="name" string="Keterangan"/>
                <separator/>
                <filter string="Bulan Ini" name="this_month" 
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Per Akun (Buku Besar)" name="group_by_account" context="{'group_by':'account_id'}"/>
                <filter string="Per Kode Proyek" name="group_by_project" context="{'group_by':'project_code'}"/>
                <filter string="Per Unit Kerja" name="group_by_unit" context="{'group_by':'unit_name'}"/>
                <filter string="Per Tanggal" name="group_by_date" context="{'group_by':'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_sif_buku_besar" model="ir.actions.act_window">
        <field name="name">Buku Besar</field>
        <field name="res_model">sif.jurnal.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_sif_buku_besar_search"/>
        <field name="context">{}</field>
    </record>

    <!-- ================================================================= -->
    <!-- 3. VIEW JURNAL TRANSAKSI (HEADER DOKUMEN ENTRY)                  -->
    <!-- ================================================================= -->
    <record id="view_sif_jurnal_entry_list" model="ir.ui.view">
        <field name="name">sif.jurnal.entry.list</field>
        <field name="model">sif.jurnal.entry</field>
        <field name="arch" type="xml">
            <list string="Jurnal Transaksi">
                <field name="name" string="Nomor Bukti"/>
                <field name="date" string="Tanggal"/>
                <field name="project_code" string="Kode Proy"/>
                <field name="unit_name" string="Unit Kerja"/>
                <field name="ref" string="Referensi / Dokumen"/>
                <field name="narration" string="Keterangan"/>
                <field name="source_type" string="Sumber" widget="badge"
                       decoration-info="source_type == 'ppl'"
                       decoration-warning="source_type in ('asset_buy', 'asset_depr')"/>
                <field name="total_debit" string="Total Debet" sum="Total Debet"/>
                <field name="total_credit" string="Total Kredit" sum="Total Kredit"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'posted'" 
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_sif_jurnal_entry_form" model="ir.ui.view">
        <field name="name">sif.jurnal.entry.form</field>
        <field name="model">sif.jurnal.entry</field>
        <field name="arch" type="xml">
            <form string="Entri Jurnal">
                <header>
                    <button name="action_post" string="Posting" type="object" class="oe_highlight" 
                            invisible="state == 'posted'"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Bukti Jurnal"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="ref"/>
                            <field name="kwitansi_ref"/>
                        </group>
                        <group>
                            <field name="project_code"/>
                            <field name="unit_name"/>
                            <field name="partner_name"/>
                            <field name="source_type" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rincian Baris Jurnal">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="name" string="Keterangan"/>
                                    <field name="project_code" string="Kode Proy"/>
                                    <field name="unit_name" string="Unit Kerja"/>
                                    <field name="debit" sum="Total Debet"/>
                                    <field name="credit" sum="Total Kredit"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_debit"/>
                                <field name="total_credit"/>
                            </group>
                        </page>
                        <page string="Catatan Transaksi">
                            <field name="narration" placeholder="Catatan tambahan transaksi..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sif_jurnal_entry_search" model="ir.ui.view">
        <field name="name">sif.jurnal.entry.search</field>
        <field name="model">sif.jurnal.entry</field>
        <field name="arch" type="xml">
            <search string="Pencarian Jurnal Transaksi">
                <field name="name" string="Nomor Bukti"/>
                <field name="project_code" string="Kode Proyek"/>
                <field name="unit_name" string="Unit Kerja"/>
                <field name="ref" string="No. Referensi / PPL / Aset"/>
                <field name="partner_name" string="Vendor / Pihak Ketiga"/>
                <separator/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Dari PPL" name="filter_source_ppl" domain="[('source_type', '=', 'ppl')]"/>
                <filter string="Dari Aset" name="filter_source_asset" domain="[('source_type', 'in', ('asset_buy', 'asset_depr'))]"/>
                <separator/>
                <filter string="Per Kode Proyek" name="group_project" context="{'group_by':'project_code'}"/>
                <filter string="Per Unit Kerja" name="group_unit" context="{'group_by':'unit_name'}"/>
                <filter string="Per Sumber Transaksi" name="group_source" context="{'group_by':'source_type'}"/>
                <filter string="Per Tanggal" name="group_date" context="{'group_by':'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_sif_jurnal_entry" model="ir.actions.act_window">
        <field name="name">Jurnal Transaksi</field>
        <field name="res_model">sif.jurnal.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sif_jurnal_entry_search"/>
    </record>

</odoo>