<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sif_vendor_tree" model="ir.ui.view">
        <field name="name">sif.vendor.tree</field>
        <field name="model">sif.vendor</field>
        <field name="arch" type="xml">
            <list string="Vendor">
                <field name="code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sif_vendor_form" model="ir.ui.view">
        <field name="name">sif.vendor.form</field>
        <field name="model">sif.vendor</field>
        <field name="arch" type="xml">
            <form string="Vendor">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Alamat">
                        <field name="address" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sif_vendor" model="ir.actions.act_window">
        <field name="name">Vendor</field>
        <field name="res_model">sif.vendor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
