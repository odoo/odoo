<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View Lock Date -->
    <record id="view_sif_lock_date_form" model="ir.ui.view">
        <field name="name">sif.lock.date.form</field>
        <field name="model">sif.lock.date</field>
        <field name="arch" type="xml">
            <form string="Kunci Tanggal">
                <sheet>
                    <div class="oe_title">
                        <h1>Kunci Tanggal Akuntansi</h1>
                    </div>
                    <group>
                        <group string="Status Kunci Aktif">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="lock_pendapatan" string="Dikunci s/d (Pendapatan)"/>
                            <field name="lock_ppl" string="Dikunci s/d (PPL)"/>
                        </group>
                    </group>
                    <div class="mt-4 d-flex gap-3">
                        <button name="action_lock_pendapatan" type="object" string="Kunci Pendapatan" class="btn-warning"/>
                        <button name="action_lock_ppl" type="object" string="Kunci PPL" class="btn-warning"/>
                        <button name="action_lock_all" type="object" string="Kunci Semua (PPL + Pendapatan)" class="btn-danger"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wizard Pop-up -->
    <record id="view_sif_lock_date_wizard_form" model="ir.ui.view">
        <field name="name">sif.lock.date.wizard.form</field>
        <field name="model">sif.lock.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Kunci Tanggal">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="mode" readonly="1"/></h2>
                    </div>
                    <group>
                        <field name="lock_date" string="Kunci s/d Tanggal" required="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <div class="alert alert-warning mt-2" role="alert">
                        <strong>Perhatian:</strong> Setelah disimpan, semua transaksi pada atau sebelum tanggal yang dipilih tidak dapat ditambah atau diubah.
                    </div>
                </sheet>
                <footer>
                    <button name="action_save" string="Simpan Kunci" type="object" class="btn-danger"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Window Lock Date -->
    <record id="action_sif_lock_date" model="ir.actions.act_window">
        <field name="name">Kunci Tanggal</field>
        <field name="res_model">sif.lock.date</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
