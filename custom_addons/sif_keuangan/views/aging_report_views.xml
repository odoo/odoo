<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sif_aging_report_wizard_form" model="ir.ui.view">
        <field name="name">sif.aging.report.wizard.form</field>
        <field name="model">sif.aging.report.wizard</field>

        <field name="arch" type="xml">
            <form string="Umur Utang Dagang">

                <sheet>

                    <div class="oe_title">
                        <h1>Umur Utang Dagang</h1>
                    </div>

                    <group>
                        <group>
                            <field name="as_of_date" string="Sejak Tanggal"/>
                            <field name="vendor_id"
                                   string="Rekanan"
                                   options="{'no_create': True}"/>
                        </group>

                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_generate_report"
                                string="Tampilkan Laporan"
                                type="object"
                                class="btn-primary"/>

                        <button string="Tutup"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>

                    <notebook invisible="not line_ids">

                        <page string="Umur Utang Dagang">

                            <!-- Ringkasan nominal -->
                            <group class="oe_subtotal_footer">

                                <field name="total_current"
                                       string="Total Pada Tanggal"/>

                                <field name="total_1_30"
                                       string="Total 1-30"/>

                                <field name="total_31_60"
                                       string="Total 31-60"/>

                                <field name="total_61_90"
                                       string="Total 61-90"/>

                                <field name="total_91_120"
                                       string="Total 91-120"/>

                                <field name="total_older"
                                       string="Total Lebih Tua"/>

                                <field name="total_grand"
                                       class="oe_subtotal_footer_separator"
                                       string="Total Umur Utang Dagang"/>

                            </group>

                            <!-- Detail -->
                            <field name="line_ids" readonly="1">

                                <list create="false"
                                      edit="false"
                                      delete="false">

                                    <field name="vendor_name"
                                           string="Rekanan"/>

                                    <field name="ppl_name"
                                           string="Faktur / PPL"/>

                                    <field name="due_date"
                                           string="Pada Tanggal"/>

                                    <field name="age_1_30"
                                           string="1-30"/>

                                    <field name="age_31_60"
                                           string="31-60"/>

                                    <field name="age_61_90"
                                           string="61-90"/>

                                    <field name="age_91_120"
                                           string="91-120"/>

                                    <field name="age_older"
                                           string="Lebih Tua"/>

                                    <field name="total_amount"
                                           string="Total"
                                           sum="Total"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <record id="action_sif_aging_report_wizard"
            model="ir.actions.act_window">

        <field name="name">Umur Utang Dagang</field>
        <field name="res_model">sif.aging.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

</odoo>