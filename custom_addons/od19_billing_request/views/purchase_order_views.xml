<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_od19_billing_request" model="ir.ui.view">
        <field name="name">purchase.order.form.od19.billing.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_od19_create_billing_request" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not od19_billing_request_available"
                        groups="od19_billing_request.group_od19_billing_requester,od19_billing_request.group_od19_billing_accounting">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Billing Request</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
