<odoo>
    <!--
        Odoo 19 stores the list of user-facing tours in the database
        (model web_tour.tour). The actual tour steps stay in the JS
        registry (web_tour.tours); web_tour automatically merges the
        matching registry tour into a record that has no steps of its
        own (see web_tour/static/src/tour_plugin.js -> getTour).

        Therefore a DB record is REQUIRED for a tour to be:
          * listed under User Guide > Interactive Tours
          * listed under Settings > Technical > Tours
          * reachable with /odoo?tour=<name>

        custom = True keeps these guide tours out of the core *sequential*
        onboarding queue (get_current_tour only returns custom = False
        tours). They are instead started on demand by
        od19_guide_tour_service (static/src/js/od19_guide_tour_service.js):
        the first time a user opens an application, the tour registered for
        that application in web_tour.tour.OD19_GUIDE_APP_TOURS is started
        automatically. The remaining tours of the same application stay
        reachable from User Guide > Interactive Tours or from a direct link
        (/odoo?tour=<name>). The sequence only controls the order in the
        list.
    -->

    <!-- Contacts & Credit Risk -->
    <record id="tour_od19_contacts_credit_risk" model="web_tour.tour">
        <field name="name">od19_contacts_credit_risk_tour</field>
        <field name="sequence">10</field>
        <field name="url">/odoo</field>
