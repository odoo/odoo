<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_od19_tax_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.od19.tax.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Thai Tax Invoice (ใบกำกับภาษี)"
                       id="od19_tax_invoice_86_4">
                    <setting string="Validate full-form tax invoice (Section 86/4)"
                             help="When enabled, a sales tax invoice issued to a VAT-registered customer (juridical person with a tax ID) is blocked until all 8 particulars required by Section 86/4 of the Thai Revenue Code are complete.">
                        <field name="od19_enforce_86_4_validation"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_od19_ewht" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.od19.ewht</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="e-Withholding Tax (e-WHT)"
                       id="od19_ewht_settings">
                    <setting string="e-Withholding Tax (e-WHT)"
                             help="File withholding tax (ภาษีหัก ณ ที่จ่าย) electronically through the bank, which relays it to the Revenue Department.">
                        <field name="od19_ewht_enabled"/>
                        <div class="content-group mt16"
                             invisible="not od19_ewht_enabled">
                            <div class="row mt16">
                                <label for="od19_ewht_mode" class="col-lg-3 o_light_label"/>
                                <field name="od19_ewht_mode"/>
                            </div>
                            <div class="row">
                                <label for="od19_ewht_endpoint" class="col-lg-3 o_light_label"/>
                                <field name="od19_ewht_endpoint"
                                       placeholder="https://ewht.bank.example/api"/>
                            </div>
                            <div class="row">
                                <label for="od19_ewht_provider_id" class="col-lg-3 o_light_label"/>
                                <field name="od19_ewht_provider_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_od19_deferred_tax" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.od19.deferred.tax</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Deferred Tax (TAS 12 — ภาษีเงินได้รอตัดบัญชี)"
                       id="od19_deferred_tax_settings">
                    <setting string="Deferred Tax Rate"
                             help="อัตราภาษีเงินได้นิติบุคคลที่ใช้คำนวณภาษีเงินได้รอตัดบัญชี (ค่าเริ่มต้น 20%)">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="od19_deferred_tax_rate" class="col-lg-3 o_light_label"/>
                                <field name="od19_deferred_tax_rate"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Deferred Tax Accounts"
                             help="กำหนดบัญชีและสมุดรายวันสำหรับบันทึกรายการภาษีเงินได้รอตัดบัญชี">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="od19_deferred_tax_asset_account_id" class="col-lg-3 o_light_label"/>
                                <field name="od19_deferred_tax_asset_account_id"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="od19_deferred_tax_liability_account_id" class="col-lg-3 o_light_label"/>
                                <field name="od19_deferred_tax_liability_account_id"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="od19_deferred_tax_expense_account_id" class="col-lg-3 o_light_label"/>
                                <field name="od19_deferred_tax_expense_account_id"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="od19_deferred_tax_journal_id" class="col-lg-3 o_light_label"/>
                                <field name="od19_deferred_tax_journal_id"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
