<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sbc3_register">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">
                        แบบแสดงรายการนำส่งงบการเงิน (ส.บช.3)
                    </h2>
                    <h3 class="text-center">
                        Financial Statements filed with the DBD
                    </h3>

                    <!-- ส่วนที่ 1: ข้อมูลทั่วไปของกิจการ -->
                    <h4 class="mt-4">ส่วนที่ 1 — ข้อมูลทั่วไปของกิจการ</h4>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr>
                                <td style="width:35%"><strong>ชื่อกิจการ</strong></td>
                                <td><span t-out="company.name"/></td>
                            </tr>
                            <tr>
                                <td><strong>เลขทะเบียนนิติบุคคล</strong></td>
                                <td><span t-out="company_registration"/></td>
                            </tr>
                            <tr>
                                <td><strong>เลขประจำตัวผู้เสียภาษี</strong></td>
                                <td><span t-out="company_tax_id"/></td>
                            </tr>
                            <tr>
                                <td><strong>ที่อยู่</strong></td>
                                <td><span t-out="company_address" t-options='{"widget": "text"}'/></td>
                            </tr>
                            <tr>
                                <td><strong>รอบระยะเวลาบัญชี</strong></td>
                                <td>
                                    <span t-out="date_from" t-options='{"widget": "date"}'/>
                                    <span> ถึง </span>
                                    <span t-out="date_to" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>กำหนดเวลายื่นงบการเงิน</strong></td>
                                <td>
                                    <span t-out="filing_deadline" t-options='{"widget": "date"}'/>
                                    <span class="text-muted"> (ภายใน 150 วันนับจากวันสิ้นรอบระยะเวลาบัญชี)</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ส่วนที่ 2: งบแสดงฐานะการเงิน -->
                    <h4 class="mt-4">
                        ส่วนที่ 2 — งบแสดงฐานะการเงิน (Statement of Financial Position)
                    </h4>
                    <p class="text-muted mb-1">
                        ณ วันที่
                        <span t-out="date_to" t-options='{"widget": "date"}'/>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:15%">รหัสบัญชี</th>
                                <th>รายการ</th>
                                <th class="text-right" style="width:20%">จำนวนเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="font-weight-bold">
                                <td colspan="3">สินทรัพย์</td>
                            </tr>
                            <tr>
                                <td colspan="3"><em>สินทรัพย์หมุนเวียน</em></td>
                            </tr>
                            <t t-foreach="assets_current" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" class="text-right">รวมสินทรัพย์หมุนเวียน</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_assets_current)"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3"><em>สินทรัพย์ไม่หมุนเวียน</em></td>
                            </tr>
                            <t t-foreach="assets_non_current" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" class="text-right">รวมสินทรัพย์ไม่หมุนเวียน</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_assets_non_current)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">รวมสินทรัพย์</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_assets)"/>
                                </td>
                            </tr>

                            <tr class="font-weight-bold">
                                <td colspan="3">หนี้สิน</td>
                            </tr>
                            <tr>
                                <td colspan="3"><em>หนี้สินหมุนเวียน</em></td>
                            </tr>
                            <t t-foreach="liabilities_current" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" class="text-right">รวมหนี้สินหมุนเวียน</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_liabilities_current)"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="3"><em>หนี้สินไม่หมุนเวียน</em></td>
                            </tr>
                            <t t-foreach="liabilities_non_current" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" class="text-right">รวมหนี้สินไม่หมุนเวียน</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_liabilities_non_current)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">รวมหนี้สิน</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_liabilities)"/>
                                </td>
                            </tr>

                            <tr class="font-weight-bold">
                                <td colspan="3">ส่วนของผู้ถือหุ้น</td>
                            </tr>
                            <t t-foreach="equity_lines" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2">กำไร (ขาดทุน) สุทธิสำหรับงวด</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(net_profit)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">รวมส่วนของผู้ถือหุ้น</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_equity_with_result)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">
                                    รวมหนี้สินและส่วนของผู้ถือหุ้น
                                </td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_liabilities_equity)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ส่วนที่ 3: งบกำไรขาดทุน -->
                    <h4 class="mt-4">
                        ส่วนที่ 3 — งบกำไรขาดทุน (Statement of Profit or Loss)
                    </h4>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:15%">รหัสบัญชี</th>
                                <th>รายการ</th>
                                <th class="text-right" style="width:20%">จำนวนเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="font-weight-bold">
                                <td colspan="3">รายได้</td>
                            </tr>
                            <t t-foreach="income_lines" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" class="text-right">รวมรายได้</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_income)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="3">ค่าใช้จ่าย</td>
                            </tr>
                            <t t-foreach="expense_lines" t-as="line">
                                <tr>
                                    <td class="text-center"><span t-out="line['code']"/></td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="2" class="text-right">รวมค่าใช้จ่าย</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_expense)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">
                                    กำไร (ขาดทุน) สุทธิสำหรับงวด
                                </td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(net_profit)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ส่วนที่ 4: สรุปสาระสำคัญ -->
                    <h4 class="mt-4">ส่วนที่ 4 — สรุปสาระสำคัญ</h4>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr>
                                <td style="width:60%">รวมสินทรัพย์</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_assets)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>รวมหนี้สิน</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_liabilities)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>รวมส่วนของผู้ถือหุ้น</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_equity_with_result)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>รวมรายได้</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_income)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>รวมค่าใช้จ่าย</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_expense)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td>กำไร (ขาดทุน) สุทธิสำหรับงวด</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(net_profit)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ส่วนที่ 5: คำรับรองและลงนาม -->
                    <h4 class="mt-4">ส่วนที่ 5 — คำรับรอง</h4>
                    <p>
                        ข้าพเจ้าขอรับรองว่างบการเงินที่นำส่งฉบับนี้จัดทำขึ้น
                        ตามมาตรฐานการรายงานทางการเงินสำหรับกิจการที่ไม่มี
                        ส่วนได้เสียสาธารณะ และแสดงฐานะการเงิน ผลการดำเนินงาน
                        ของกิจการตามความเป็นจริง
                    </p>
                    <div class="row mt-5">
                        <div class="col-6 text-center">
                            <p>ลงชื่อ ....................................................</p>
                            <p>ผู้มีอำนาจลงนามแทนกิจการ</p>
                        </div>
                        <div class="col-6 text-center">
                            <p>ลงชื่อ ....................................................</p>
                            <p>ผู้สอบบัญชีรับอนุญาต</p>
                        </div>
                    </div>

                    <p class="mt-4 text-muted">
                        หมายเหตุ: งบการเงินนี้ต้องยื่นต่อกรมพัฒนาธุรกิจการค้า
                        ภายใน 150 วันนับจากวันสิ้นรอบระยะเวลาบัญชี
                        (พ.ร.บ.การบัญชี พ.ศ. 2543 มาตรา 11) และต้องจัดเก็บ
                        งบการเงินรวมทั้งเอกสารประกอบบัญชีไว้ไม่น้อยกว่า
                        <span t-out="retention_years"/>
                        ปี (มาตรา 14) · รายงานนี้สรุปจากยอดบัญชีที่ Post แล้ว
                        เท่านั้น
                    </p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_sbc3_register" model="ir.actions.report">
        <field name="name">SBC3 Financial Statement (ส.บช.3)</field>
        <field name="model">thai.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_thai_tax_reports.sbc3_register</field>
        <field name="report_file">od19_thai_tax_reports.sbc3_register</field>
    </record>
</odoo>
