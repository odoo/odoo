<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stamp_duty_register">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">รายงานทะเบียนอากรแสตมป์</h2>
                    <h3 class="text-center">Stamp Duty Register</h3>
                    <div class="row mt-3">
                        <div class="col-6">
                            <strong>บริษัท:</strong> <span t-out="company.name"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>เลขประจำตัวผู้เสียภาษี:</strong>
                            <span t-out="company.vat"/>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>ระหว่างวันที่:</strong>
                            <span t-out="date_from" t-options='{"widget": "date"}'/>
                            <strong> ถึง </strong>
                            <span t-out="date_to" t-options='{"widget": "date"}'/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered mt-3">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:5%">ลำดับ</th>
                                <th class="text-center" style="width:9%">วันที่ตราสาร</th>
                                <th class="text-center" style="width:11%">เลขที่ตราสาร</th>
                                <th class="text-center" style="width:6%">ลักษณะที่</th>
                                <th class="text-center">ลักษณะแห่งตราสาร</th>
                                <th class="text-center">คู่สัญญา</th>
                                <th class="text-right" style="width:13%">มูลค่าแห่งตราสาร</th>
                                <th class="text-right" style="width:11%">อากรที่ต้องชำระ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq" t-value="0"/>
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <span t-out="seq"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-out="line['instrument_date']" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td>
                                        <span t-out="line['name']"/>
                                        <t t-if="line['document_reference']">
                                            <span> / </span>
                                            <span t-out="line['document_reference']"/>
                                        </t>
                                    </td>
                                    <td class="text-center"><span t-out="line['rate_code']"/></td>
                                    <td><span t-out="line['rate_name']"/></td>
                                    <td><span t-out="line['partner_name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['base_amount'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['duty_amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="font-weight-bold">
                                <td colspan="6" class="text-right">รวมทั้งสิ้น</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_base)"/>
                                </td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_duty)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 class="mt-4">สรุปตามลักษณะแห่งตราสาร</h4>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:8%">ลักษณะที่</th>
                                <th class="text-center">ลักษณะแห่งตราสาร</th>
                                <th class="text-center" style="width:10%">จำนวนฉบับ</th>
                                <th class="text-right" style="width:18%">มูลค่ารวม</th>
                                <th class="text-right" style="width:15%">อากรรวม</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rate_summary" t-as="row">
                                <tr>
                                    <td class="text-center"><span t-out="row['code']"/></td>
                                    <td><span t-out="row['name']"/></td>
                                    <td class="text-center"><span t-out="row['count']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(row['base_amount'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(row['duty_amount'])"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <p class="mt-3 text-muted">
                        หมายเหตุ: อัตราอากรคำนวณตามบัญชีอัตราอากรแสตมป์
                        (ประมวลรัษฎากร หมวด 6) โดยกติกา "ทุกจำนวนเงิน X บาท
                        หรือเศษของ X บาท" ปัดขึ้นเป็นจำนวนเต็มหน่วย ·
                        ตราสารที่ไม่ได้ขีดฆ่าแสตมป์ถือว่าไม่ได้เสียอากร
                    </p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_stamp_duty_register" model="ir.actions.report">
        <field name="name">Stamp Duty Register (ทะเบียนอากรแสตมป์)</field>
        <field name="model">thai.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_thai_tax_reports.stamp_duty_register</field>
        <field name="report_file">od19_thai_tax_reports.stamp_duty_register</field>
    </record>
</odoo>
