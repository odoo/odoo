<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pnd50_register">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">
                        แบบแสดงรายการภาษีเงินได้นิติบุคคล (ภ.ง.ด.50)
                    </h2>
                    <h3 class="text-center">
                        Corporate Income Tax Return (PND50)
                    </h3>
                    <div class="row mt-3">
                        <div class="col-6">
                            <strong>ผู้มีหน้าที่เสียภาษี:</strong>
                            <span t-out="company.name"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>เลขประจำตัวผู้เสียภาษี:</strong>
                            <span t-out="company.vat"/>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <strong>รอบระยะเวลาบัญชี:</strong>
                            <span t-out="date_from" t-options='{"widget": "date"}'/>
                            <strong> ถึง </strong>
                            <span t-out="date_to" t-options='{"widget": "date"}'/>
                        </div>
                    </div>

                    <h4 class="mt-4">1. รายได้</h4>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:15%">รหัสบัญชี</th>
                                <th>ชื่อบัญชี</th>
                                <th class="text-right" style="width:20%">จำนวนเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="income_lines" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-out="line['code']"/>
                                    </td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">รวมรายได้</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_income)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 class="mt-4">2. ค่าใช้จ่าย</h4>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:15%">รหัสบัญชี</th>
                                <th>ชื่อบัญชี</th>
                                <th class="text-right" style="width:20%">จำนวนเงิน</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="expense_lines" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-out="line['code']"/>
                                    </td>
                                    <td><span t-out="line['name']"/></td>
                                    <td class="text-right">
                                        <span t-out="'{:,.2f}'.format(line['amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="font-weight-bold">
                                <td colspan="2" class="text-right">รวมค่าใช้จ่าย</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(total_expense)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 class="mt-4">3. การคำนวณภาษีเงินได้นิติบุคคล</h4>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr>
                                <td>กำไร (ขาดทุน) สุทธิตามบัญชี</td>
                                <td class="text-right" style="width:25%">
                                    <span t-out="'{:,.2f}'.format(net_profit)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>กำไรสุทธิเพื่อเสียภาษี</td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(taxable_profit)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    ภาษีเงินได้นิติบุคคล (อัตรา
                                    <span t-out="'{:.0f}'.format(tax_rate_percent)"/>%)
                                </td>
                                <td class="text-right">
                                    <span t-out="'{:,.2f}'.format(tax_amount)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <p class="mt-3 text-muted">
                        หมายเหตุ: รายงานนี้สรุปจากยอดบัญชีที่ Post แล้วเท่านั้น
                        ยังไม่รวมรายการบวกกลับ/หักออกตามประมวลรัษฎากร
                    </p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_pnd50_register" model="ir.actions.report">
        <field name="name">PND50 Register</field>
        <field name="model">thai.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_thai_tax_reports.pnd50_register</field>
        <field name="report_file">od19_thai_tax_reports.pnd50_register</field>
    </record>
</odoo>
