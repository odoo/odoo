<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pp30_register">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">แบบแสดงรายการภาษีมูลค่าเพิ่ม (ภ.พ.30)</h2>
                    <h3 class="text-center">VAT Return Register (PP30)</h3>
                    <div class="row mt-3">
                        <div class="col-6">
                            <strong>บริษัท:</strong> <span t-out="company.name"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>เลขประจำตัวผู้เสียภาษี:</strong>
                            <span t-out="company.vat"/>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>รอบระยะเวลาภาษี:</strong>
                            <span t-out="date_from" t-options='{"widget": "date"}'/>
                            <strong> ถึง </strong>
                            <span t-out="date_to" t-options='{"widget": "date"}'/>
                        </div>
                    </div>

                    <!-- 1) ภาษีขาย -->
                    <h4 class="mt-4">1. ภาษีขาย (Output VAT)</h4>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:5%">ลำดับ</th>
                                <th class="text-center" style="width:10%">วันที่</th>
                                <th class="text-center" style="width:14%">เลขที่เอกสาร</th>
                                <th class="text-center">ชื่อผู้ซื้อ</th>
                                <th class="text-center" style="width:13%">เลขผู้เสียภาษี</th>
                                <th class="text-right" style="width:13%">มูลค่าสินค้า/บริการ</th>
                                <th class="text-right" style="width:13%">ภาษีขาย</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq" t-value="0"/>
                            <t t-foreach="sales_lines" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <span t-esc="seq"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-out="line['invoice_date']" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td><span t-esc="line['name']"/></td>
                                    <td><span t-esc="line['partner_name']"/></td>
                                    <td class="text-center">
                                        <span t-esc="line['partner_vat']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:,.2f}'.format(line['tax_base'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:,.2f}'.format(line['vat_amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="font-weight-bold">
                                <td colspan="5" class="text-right">รวมภาษีขาย</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(sales_base)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(output_vat)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 2) ภาษีซื้อ -->
                    <h4 class="mt-4">2. ภาษีซื้อ (Input VAT)</h4>
                    <table class="table table-sm table-bordered">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center" style="width:5%">ลำดับ</th>
                                <th class="text-center" style="width:10%">วันที่</th>
                                <th class="text-center" style="width:14%">เลขที่เอกสาร</th>
                                <th class="text-center">ชื่อผู้ขาย</th>
                                <th class="text-center" style="width:12%">เลขผู้เสียภาษี</th>
                                <th class="text-right" style="width:12%">มูลค่าสินค้า/บริการ</th>
                                <th class="text-right" style="width:12%">ภาษีซื้อ (หักได้)</th>
                                <th class="text-right" style="width:12%">ภาษีซื้อต้องห้าม</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq" t-value="0"/>
                            <t t-foreach="purchase_lines" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <t t-set="seq" t-value="seq + 1"/>
                                        <span t-esc="seq"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-out="line['invoice_date']" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td><span t-esc="line['name']"/></td>
                                    <td><span t-esc="line['partner_name']"/></td>
                                    <td class="text-center">
                                        <span t-esc="line['partner_vat']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:,.2f}'.format(line['tax_base'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:,.2f}'.format(line['vat_amount'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:,.2f}'.format(line['non_deductible_amount'])"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="font-weight-bold">
                                <td colspan="5" class="text-right">รวมภาษีซื้อ</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(purchase_base)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(input_vat)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(non_deductible_vat)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- 3) สรุปกระทบยอด -->
                    <h4 class="mt-4">3. สรุปภาษีที่ต้องชำระ (VAT Reconciliation)</h4>
                    <table class="table table-sm table-bordered" style="width:70%">
                        <tbody>
                            <tr>
                                <td>(1) ยอดขายที่ต้องเสียภาษี</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(sales_base)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>(2) ภาษีขาย (Output VAT)</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(output_vat)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>(3) ยอดซื้อที่ต้องเสียภาษี</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(purchase_base)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>(4) ภาษีซื้อที่หักได้ (Input VAT Deductible)</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(input_vat)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>(5) ภาษีซื้อต้องห้าม (Non-Deductible)</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(non_deductible_vat)"/>
                                </td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td>(6) ภาษีที่ต้องชำระ/(ชำระเกิน) = (2) - (4)</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(net_vat)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>ภาษีที่ต้องชำระสุทธิ</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(vat_payable)"/>
                                </td>
                            </tr>
                            <tr>
                                <td>ภาษีชำระเกินยกไปเครดิตเดือนถัดไป</td>
                                <td class="text-right">
                                    <span t-esc="'{:,.2f}'.format(vat_overpaid)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_pp30_register" model="ir.actions.report">
        <field name="name">PP30 Register</field>
        <field name="model">thai.tax.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">od19_thai_tax_reports.pp30_register</field>
        <field name="report_file">od19_thai_tax_reports.pp30_register</field>
    </record>
</odoo>
