<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_payroll_batch_form_inherit_ppl" model="ir.ui.view">
        <field name="name">custom.payroll.batch.form.inherit.ppl</field>
        <field name="model">custom.payroll.batch</field>
        <field name="inherit_id" ref="hr_payroll_custom.view_custom_payroll_batch_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_create_ppl" 
                        type="object" 
                        string="Buat PPL Gaji" 
                        class="btn-primary" 
                        invisible="status != 'approved' or ppl_id != False"
                        groups="hr_payroll_custom.group_payroll_manager"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ppl" type="object" class="oe_stat_button" icon="fa-money" invisible="ppl_id == False">
                    <div class="o_stat_info">
                        <span class="o_stat_text">PPL Gaji</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="after">
                <field name="ppl_id" invisible="1"/>
            </xpath>

        </field>
    </record>
</odoo>
