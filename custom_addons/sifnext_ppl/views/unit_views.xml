<odoo>
    <record id="view_sifnext_unit_list" model="ir.ui.view">
        <field name="name">sifnext.unit.list</field>
        <field name="model">sifnext.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="journal_unit_dept"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sifnext_unit_form" model="ir.ui.view">
        <field name="name">sifnext.unit.form</field>
        <field name="model">sifnext.unit</field>
        <field name="arch" type="xml">
            <form string="Unit">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="journal_unit_dept"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sifnext_unit" model="ir.actions.act_window">
        <field name="name">Unit</field>
        <field name="res_model">sifnext.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_users_form_sifnext_unit" model="ir.ui.view">
        <field name="name">res.users.form.sifnext.unit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <field name="unit_id"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_sifnext_ppl_configuration" name="Konfigurasi"
              parent="menu_sifnext_finance_root" sequence="90"
              groups="sifnext_ppl.group_ppl_finance"/>
    <menuitem id="menu_sifnext_unit" name="Unit" parent="menu_sifnext_ppl_configuration"
              action="action_sifnext_unit" sequence="10"
              groups="sifnext_ppl.group_ppl_finance"/>
</odoo>
