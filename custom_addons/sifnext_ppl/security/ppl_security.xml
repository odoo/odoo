<odoo>
    <record id="module_category_sifnext_ppl" model="ir.module.category">
        <field name="name">SIFNEXT PPL</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_sifnext_ppl" model="res.groups.privilege">
        <field name="name">PPL</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_sifnext_ppl"/>
    </record>

    <record id="group_ppl_finance" model="res.groups">
        <field name="name">Keuangan</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_sifnext_ppl"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('account.group_account_user'))]"/>
    </record>

    <record id="group_ppl_approver" model="res.groups">
        <field name="name">Direktur</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_sifnext_ppl"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="unit_company_rule" model="ir.rule">
        <field name="name">Unit multi-company</field>
        <field name="model_id" ref="model_sifnext_unit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ppl_company_rule" model="ir.rule">
        <field name="name">PPL multi-company</field>
        <field name="model_id" ref="model_sifnext_ppl"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ppl_line_company_rule" model="ir.rule">
        <field name="name">PPL detail multi-company</field>
        <field name="model_id" ref="model_sifnext_ppl_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ppl_user_own_rule" model="ir.rule">
        <field name="name">PPL pegawai: pengajuan sendiri</field>
        <field name="model_id" ref="model_sifnext_ppl"/>
        <field name="domain_force">[('applicant_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="ppl_finance_all_rule" model="ir.rule">
        <field name="name">PPL Keuangan dan Direktur: seluruh pengajuan company</field>
        <field name="model_id" ref="model_sifnext_ppl"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_ppl_finance')), Command.link(ref('group_ppl_approver'))]"/>
    </record>

    <record id="ppl_line_user_own_rule" model="ir.rule">
        <field name="name">Detail PPL pegawai: pengajuan sendiri</field>
        <field name="model_id" ref="model_sifnext_ppl_line"/>
        <field name="domain_force">[('ppl_id.applicant_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="ppl_line_finance_all_rule" model="ir.rule">
        <field name="name">Detail PPL Keuangan dan Direktur: seluruh pengajuan company</field>
        <field name="model_id" ref="model_sifnext_ppl_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_ppl_finance')), Command.link(ref('group_ppl_approver'))]"/>
    </record>
</odoo>
