<odoo>
    <record id="seq_sifnext_ppl" model="ir.sequence">
        <field name="name">Nomor PPL</field>
        <field name="code">sifnext.ppl</field>
        <field name="prefix">PPL/%(month)s/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
        <field name="use_date_range" eval="True"/>
    </record>
</odoo>
