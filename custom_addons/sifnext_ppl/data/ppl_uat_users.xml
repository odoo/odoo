<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Akun berikut hanya ditujukan untuk lingkungan lokal/UAT.
        Jangan memuat fixture ini pada deployment produksi.
        noupdate mencegah upgrade modul mengembalikan password yang sudah diganti.
    -->
    <data noupdate="1">
        <record id="unit_uat_ppl" model="sifnext.unit">
            <field name="name">Unit UAT PPL</field>
            <field name="code">UAT</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="user_ppl_uat_employee" model="res.users" context="{'no_reset_password': True}">
            <field name="name">PPL UAT - Pegawai</field>
            <field name="login">ppl_user</field>
            <field name="password">ppl_user</field>
            <field name="email">ppl.user@example.invalid</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
            <field name="unit_id" ref="unit_uat_ppl"/>
            <field name="tz">Asia/Jakarta</field>
            <field name="group_ids" eval="[Command.set([ref('base.group_user')])]"/>
        </record>

        <record id="user_ppl_uat_finance" model="res.users" context="{'no_reset_password': True}">
            <field name="name">PPL UAT - Keuangan</field>
            <field name="login">ppl_finance</field>
            <field name="password">ppl_finance</field>
            <field name="email">ppl.finance@example.invalid</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
            <field name="unit_id" ref="unit_uat_ppl"/>
            <field name="tz">Asia/Jakarta</field>
            <field name="group_ids" eval="[Command.set([ref('sifnext_ppl.group_ppl_finance')])]"/>
        </record>

        <record id="user_ppl_uat_director" model="res.users" context="{'no_reset_password': True}">
            <field name="name">PPL UAT - Direktur</field>
            <field name="login">ppl_director</field>
            <field name="password">ppl_director</field>
            <field name="email">ppl.director@example.invalid</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
            <field name="unit_id" ref="unit_uat_ppl"/>
            <field name="tz">Asia/Jakarta</field>
            <field name="group_ids" eval="[Command.set([ref('sifnext_ppl.group_ppl_approver')])]"/>
        </record>
    </data>
</odoo>
