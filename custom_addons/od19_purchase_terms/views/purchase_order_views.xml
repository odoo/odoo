<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_inherit_od19_purchase_terms" model="ir.ui.view">
        <field name="name">purchase.order.form.od19.purchase.terms</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']" position="after">
                <page string="Terms" name="od19_terms">
                    <group>
                        <group string="Terms / เงื่อนไข">
                            <field name="od19_warranty_term_id"/>
                            <field name="od19_delivery_to_term_id"/>
                            <field name="od19_payment_term_id"/>
                            <field name="od19_shipment_term_id"/>
                            <field name="od19_weight_term_id"/>
                        </group>
                        <group string="Combined Terms Preview / ตัวอย่างข้อความเงื่อนไขทั้งหมด">
                            <field name="od19_terms_text" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
