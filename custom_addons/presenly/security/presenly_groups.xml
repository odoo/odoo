<odoo>
    <record id="res_groups_privilege_presenly" model="res.groups.privilege">
        <field name="name">Presenly</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_presenly_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="presenly.res_groups_privilege_presenly"/>
    </record>
    <record id="group_presenly_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="presenly.res_groups_privilege_presenly"/>
        <field name="implied_ids" eval="[(4, ref('presenly.group_presenly_employee'))]"/>
    </record>
    <record id="group_presenly_hr" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="presenly.res_groups_privilege_presenly"/>
        <field name="implied_ids" eval="[(4, ref('presenly.group_presenly_approver')), (4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>
    <record id="group_presenly_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="presenly.res_groups_privilege_presenly"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('presenly.group_presenly_hr')), (4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
