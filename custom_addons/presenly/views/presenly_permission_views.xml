<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permission type configuration -->
    <record id="view_presenly_permission_type_list" model="ir.ui.view">
        <field name="name">presenly.permission.type.list</field>
        <field name="model">presenly.permission.type</field>
        <field name="arch" type="xml">
            <list string="Permission Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="request_mode"/>
                <field name="requires_attachment" optional="show"/>
                <field name="affects_attendance" optional="show"/>
                <field name="paid_status" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="is_complete" string="Complete" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_presenly_permission_type_form" model="ir.ui.view">
        <field name="name">presenly.permission.type.form</field>
        <field name="model">presenly.permission.type</field>
        <field name="arch" type="xml">
            <form string="Permission Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_approval_routes" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="not id"
                                groups="presenly.group_presenly_manager"
                                help="Configure the ordered approval steps used when employees submit this permission type.">
                            <field name="approval_route_count" widget="statinfo" string="Ready Steps"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Incomplete" bg_color="text-bg-warning" invisible="is_complete"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="is_complete" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Late Arrival"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Request Policy">
                            <field name="request_mode"/>
                            <field name="requires_attachment"/>
                            <field name="affects_attendance"/>
                            <field name="paid_status"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="is_complete">
                        This permission type is saved as incomplete and cannot be selected until Name, Code, Company, Allowed Duration, and Paid Status are filled.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not id or approval_route_count">
                        <strong>Approval route not ready.</strong> Open Ready Steps and add at least one complete approval step. Employees cannot submit this Permission Type yet.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not id or not approval_route_count">
                        Open Ready Steps to review who approves this request and in what order. Location-specific steps may override company defaults.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_presenly_permission_type_search" model="ir.ui.view">
        <field name="name">presenly.permission.type.search</field>
        <field name="model">presenly.permission.type</field>
        <field name="arch" type="xml">
            <search string="Permission Types">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="complete" string="Complete" domain="[('is_complete', '=', True)]"/>
                <filter name="incomplete" string="Incomplete" domain="[('is_complete', '=', False)]"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_request_mode" string="Allowed Duration" context="{'group_by': 'request_mode'}"/>
                <filter name="group_paid_status" string="Paid Status" context="{'group_by': 'paid_status'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_presenly_permission_type" model="ir.actions.act_window">
        <field name="name">Permission Types</field>
        <field name="res_model">presenly.permission.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_presenly_permission_type_search"/>
        <field name="context">{'active_test': True}</field>
    </record>

    <!-- Permission request views -->
    <record id="view_presenly_permission_list" model="ir.ui.view">
        <field name="name">presenly.permission.list</field>
        <field name="model">presenly.permission</field>
        <field name="arch" type="xml">
            <list string="Permissions / Dispensations"
                  decoration-muted="state in ('draft', 'cancelled')"
                  decoration-info="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  sample="1">
                <field name="name" string="Reference"/>
                <field name="employee_id" widget="many2one_avatar_employee" optional="show"/>
                <field name="permission_type_id"/>
                <field name="work_location_id" optional="show"/>
                <field name="request_mode" optional="hide"/>
                <field name="date_from"/>
                <field name="date_to" optional="show"/>
                <field name="duration_display" string="Duration" optional="show"/>
                <field name="approval_progress_display" string="Approval" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ('draft', 'cancelled')"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_presenly_permission_form" model="ir.ui.view">
        <field name="name">presenly.permission.form</field>
        <field name="model">presenly.permission</field>
        <field name="arch" type="xml">
            <form string="Permission / Dispensation Request" duplicate="false">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="not can_submit"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="not can_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" invisible="not can_reject"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="not can_cancel or not id"/>
                    <button name="action_delete_with_confirm" type="object" string="Delete"
                            confirm="Delete this permission request and its approval journey?\nThis action cannot be undone."
                            groups="presenly.group_presenly_hr,presenly.group_presenly_manager"
                            invisible="not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <field name="can_submit" invisible="1"/>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_reject" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <field name="can_edit_request" invisible="1"/>
                    <field name="is_request_owner" invisible="1"/>
                    <field name="requires_attachment" invisible="1"/>
                    <field name="allowed_request_mode" invisible="1"/>

                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="name" string="Permission Request"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-info d-flex align-items-center" role="alert"
                         invisible="not requires_attachment or state != 'draft'">
                        <i class="fa fa-info-circle me-2" title="Information"/>
                        Supporting document is required for this permission type.
                    </div>

                    <group>
                        <group string="Request">
                            <field name="employee_id" widget="many2one_avatar_employee"
                                   readonly="not can_edit_request or is_request_owner"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="permission_type_id" readonly="not can_edit_request"
                                   domain="[('is_complete', '=', True), ('active', '=', True), ('company_id', '=', company_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="work_location_id" readonly="not can_edit_request"
                                   domain="[('active', '=', True), ('company_id', '=', company_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Approval">
                            <field name="approval_progress_display" string="Progress" readonly="1"/>
                            <field name="current_approver_ids" widget="many2many_tags" readonly="1"
                                   invisible="state != 'submitted'" options="{'no_open': True}"/>
                            <field name="presenly_approval_request_id" string="Approval Journey"
                                   readonly="1" invisible="not presenly_approval_request_id"/>
                            <field name="paid_status" readonly="1"/>
                            <field name="affects_attendance" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Duration">
                            <field name="request_mode" widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="not can_edit_request"
                                   invisible="allowed_request_mode != 'both'"/>
                            <label for="date_from" string="Date"/>
                            <div class="o_row">
                                <field name="date_from" widget="daterange"
                                       options="{'end_date_field': 'date_to', 'always_range': true}"
                                       readonly="not can_edit_request"/>
                                <field name="date_to" invisible="1"/>
                                <span class="text-muted">(<field name="duration_display" readonly="1" class="oe_inline"/>)</span>
                            </div>
                            <label for="hour_from" string="Hours" invisible="request_mode != 'hours'"/>
                            <div class="o_row" invisible="request_mode != 'hours'">
                                <field name="hour_from" widget="float_time" readonly="not can_edit_request" class="oe_inline"/>
                                <span class="mx-2">to</span>
                                <field name="hour_to" widget="float_time" readonly="not can_edit_request" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Details">
                            <field name="reason" widget="text" readonly="not can_edit_request"
                                   placeholder="Describe the reason for this request..."/>
                            <field name="rejection_reason" readonly="1" invisible="not rejection_reason"/>
                        </group>
                    </group>

                    <group string="Supporting Documents">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"
                               readonly="not can_edit_request" colspan="2"/>
                    </group>

                    <group string="Approval Journey" invisible="not presenly_approval_request_id">
                        <field name="presenly_approval_step_ids" nolabel="1" readonly="1" colspan="2">
                            <list create="0" edit="0" delete="0"
                                  decoration-info="state == 'pending'"
                                  decoration-success="state == 'approved'"
                                  decoration-danger="state == 'rejected'"
                                  decoration-muted="state in ('waiting', 'cancelled')">
                                <field name="level"/>
                                <field name="name"/>
                                <field name="assigned_user_ids" widget="many2many_tags"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'pending'"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-muted="state in ('waiting', 'cancelled')"/>
                                <field name="decision_user_id" widget="many2one_avatar_user" optional="show"/>
                                <field name="decision_date" optional="show"/>
                                <field name="decision_note" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter reload_on_post="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="view_presenly_permission_search" model="ir.ui.view">
        <field name="name">presenly.permission.search</field>
        <field name="model">presenly.permission</field>
        <field name="arch" type="xml">
            <search string="Permissions / Dispensations">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="permission_type_id"/>
                <field name="work_location_id"/>
                <field name="date_from"/>
                <separator/>
                <filter name="my_requests" string="My Requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date_from', '&lt;=', context_today()), ('date_to', '&gt;=', context_today())]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date_from', '&lt;', (context_today() + relativedelta(months=1, day=1))), ('date_to', '&gt;=', context_today().replace(day=1))]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_type" string="Permission Type" context="{'group_by': 'permission_type_id'}"/>
                <filter name="group_location" string="Work Location" context="{'group_by': 'work_location_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'date_from:month'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_presenly_permission" model="ir.actions.act_window">
        <field name="name">Dispensations</field>
        <field name="res_model">presenly.permission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_presenly_permission_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first permission or dispensation request</p>
            <p>Submit a full-day request or a partial-hours permission for approval.</p>
        </field>
    </record>
</odoo>
