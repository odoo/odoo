<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Time Off remains hr.leave, but Presenly is its only approval path. -->
    <record id="view_hr_leave_form_presenly" model="ir.ui.view">
        <field name="name">hr.leave.form.presenly.single.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_refuse']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_back_to_approval']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">presenly_approval_state != 'approved' or not can_cancel or not id</attribute>
            </xpath>
            <xpath expr="(//header/field[@name='state'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/field[@name='state'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="presenly_approval_state" widget="statusbar"
                       statusbar_visible="not_started,pending,approved,rejected,cancelled"/>
            </xpath>

            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="presenly_work_location_id"
                       domain="[('active', '=', True), ('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="not presenly_can_edit"/>
            </xpath>
            <xpath expr="//field[@name='request_date_from']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='request_date_from_period']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='request_date_to_period']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='request_hour_from']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='request_hour_to']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>
            <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                <attribute name="readonly">not presenly_can_edit</attribute>
            </xpath>

            <xpath expr="//div[hasclass('o_hr_leave_content')]" position="before">
                <field name="presenly_can_submit" invisible="1"/>
                <field name="presenly_can_approve" invisible="1"/>
                <field name="presenly_can_reject" invisible="1"/>
                <field name="presenly_can_cancel" invisible="1"/>
                <field name="presenly_can_edit" invisible="1"/>
                <field name="presenly_approval_engine" invisible="1"/>
                <field name="presenly_approval_request_id" invisible="1"/>
                <div class="d-flex flex-wrap gap-2 mb-3 o_presenly_leave_actions">
                    <button name="action_presenly_submit" type="object" string="Submit for Approval"
                            class="oe_highlight" invisible="not presenly_can_submit"/>
                    <button name="action_presenly_approve" type="object" string="Approve Current Level"
                            class="oe_highlight" invisible="not presenly_can_approve"/>
                    <button name="action_presenly_open_reject_wizard" type="object" string="Reject"
                            class="btn-secondary" invisible="not presenly_can_reject"/>
                    <button name="action_presenly_cancel" type="object" string="Cancel Request"
                            invisible="not presenly_can_cancel"
                            confirm="Cancel this request and its pending approval journey?"/>
                </div>
                <div class="alert alert-info d-flex align-items-center my-2" role="alert"
                     invisible="presenly_approval_state != 'not_started'">
                    <i class="fa fa-route me-2" title="Approval Journey"/>
                    Submission starts the Presenly Approval Journey. Native Time Off approval cannot bypass these levels.
                </div>
                <div class="alert alert-warning d-flex align-items-center my-2" role="alert"
                     invisible="presenly_approval_state != 'pending'">
                    <i class="fa fa-hourglass-half me-2" title="Pending Approval"/>
                    <div>
                        <strong><field name="presenly_approval_progress" class="oe_inline"/></strong>
                        <span class="ms-2">Waiting for</span>
                        <field name="presenly_current_approver_ids" widget="many2many_tags"
                               class="oe_inline ms-1" options="{'no_open': True}"/>
                    </div>
                </div>
                <div class="alert alert-danger my-2" role="alert"
                     invisible="not presenly_rejection_reason">
                    <strong>Rejection reason:</strong>
                    <field name="presenly_rejection_reason" readonly="1" nolabel="1"/>
                </div>
            </xpath>

            <xpath expr="//div[hasclass('o_hr_leave_content')]" position="after">
                <group string="Approval Journey" class="mt-3" invisible="not presenly_approval_request_id">
                    <field name="presenly_approval_step_ids" nolabel="1" readonly="1" colspan="2">
                        <list create="0" edit="0" delete="0"
                              decoration-info="state == 'pending'"
                              decoration-success="state == 'approved'"
                              decoration-danger="state == 'rejected'"
                              decoration-muted="state in ('waiting', 'cancelled')">
                            <field name="level"/>
                            <field name="name"/>
                            <field name="assigned_user_ids" widget="many2many_tags"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'pending'"
                                   decoration-success="state == 'approved'"
                                   decoration-danger="state == 'rejected'"
                                   decoration-muted="state in ('waiting', 'cancelled')"/>
                            <field name="decision_user_id" widget="many2one_avatar_user" optional="show"/>
                            <field name="decision_date" optional="show"/>
                            <field name="decision_note" optional="hide"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Remove native bulk/row approval affordances; server guards also block RPC bypass. -->
    <record id="view_hr_leave_tree_presenly" model="ir.ui.view">
        <field name="name">hr.leave.list.presenly.single.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Delete button appears only for Presenly HR / Administrator.
                 Server-side guards (native state rules + our journey purge)
                 still protect all other paths. -->
            <xpath expr="//header" position="inside">
                <button name="action_presenly_delete" type="object"
                        string="Delete" confirm="Delete this Time Off request and its approval journey?\nThis action cannot be undone."
                        class="btn-danger"
                        groups="presenly.group_presenly_hr,presenly.group_presenly_manager"/>
            </xpath>
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="string">Native Status</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="presenly_approval_state" string="Approval" widget="badge"
                       decoration-info="presenly_approval_state == 'pending'"
                       decoration-success="presenly_approval_state == 'approved'"
                       decoration-danger="presenly_approval_state == 'rejected'"
                       decoration-muted="presenly_approval_state in ('not_started', 'cancelled')" optional="show"/>
                <field name="presenly_approval_progress" string="Approval Progress" optional="show"/>
                <field name="presenly_work_location_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_leave_kanban_presenly" model="ir.ui.view">
        <field name="name">hr.leave.kanban.presenly.single.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="presenly_approval_state"/>
                <field name="presenly_approval_progress"/>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_kanban')]/widget[@name='web_ribbon'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_kanban')]/widget[@name='web_ribbon'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_hr_holidays_kanban')]/widget[@name='web_ribbon'][1]" position="after">
                <widget name="web_ribbon" title="Draft" bg_color="text-bg-secondary"
                        invisible="presenly_approval_state != 'not_started'"/>
                <widget name="web_ribbon" title="Pending Approval" bg_color="text-bg-warning"
                        invisible="presenly_approval_state != 'pending'"/>
            </xpath>
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Time Off type makes the single approval ownership explicit. -->
    <record id="view_hr_leave_type_presenly" model="ir.ui.view">
        <field name="name">hr.leave.type.presenly.single.approval</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_presenly_approval_routes" type="object"
                        class="oe_stat_button" icon="fa-sitemap"
                        invisible="not id"
                        groups="presenly.group_presenly_manager"
                        help="Configure the ordered Presenly approval steps for this Time Off Type.">
                    <field name="presenly_approval_route_count" widget="statinfo" string="Ready Steps"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='leave_validation_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='leave_validation_type']" position="after">
                <field name="presenly_approval_engine" widget="radio" readonly="1"/>
                <div class="alert alert-danger" role="alert" colspan="2"
                     invisible="presenly_approval_route_count">
                    <strong>Request approval route not ready.</strong> Add at least one complete step using Ready Steps. Employees cannot submit this Time Off Type yet.
                </div>
                <div class="alert alert-info" role="alert" colspan="2"
                     invisible="not presenly_approval_route_count">
                    <strong>Request approval:</strong> use Ready Steps to review who approves and in what order. Allocation approval remains native Odoo.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
