<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permission approval queue: domain is finalized server-side for current approver. -->
    <record id="action_presenly_permission_approvals" model="ir.actions.act_window">
        <field name="name">Permission Approvals</field>
        <field name="res_model">presenly.permission</field>
        <field name="view_mode">list,form,activity</field>
        <field name="search_view_id" ref="presenly.view_presenly_permission_search"/>
        <field name="domain">[('id', '=', 0)]</field>
        <field name="context">{'search_default_submitted': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No permission requests are waiting for your approval</p>
        </field>
    </record>

    <record id="action_server_presenly_permission_approvals" model="ir.actions.server">
        <field name="name">Permission Approvals</field>
        <field name="model_id" ref="presenly.model_presenly_permission"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_presenly_approval_queue()</field>
    </record>

    <!-- Time Off approval queue uses the native hr.leave model and views. -->
    <record id="action_presenly_leave_approvals" model="ir.actions.act_window">
        <field name="name">Time Off Approvals</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="search_view_id" ref="hr_holidays.hr_leave_view_search_manager"/>
        <field name="domain">[('id', '=', 0)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Time Off requests are waiting for your Presenly approval</p>
        </field>
    </record>

    <record id="action_server_presenly_leave_approvals" model="ir.actions.server">
        <field name="name">Time Off Approvals</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_presenly_approval_queue()</field>
    </record>

    <!-- Native reporting views for permissions / dispensations. -->
    <record id="view_presenly_permission_calendar" model="ir.ui.view">
        <field name="name">presenly.permission.calendar</field>
        <field name="model">presenly.permission</field>
        <field name="arch" type="xml">
            <calendar string="Permissions / Dispensations"
                      date_start="date_from"
                      date_stop="date_to"
                      color="permission_type_id"
                      quick_create="0"
                      event_open_popup="true">
                <field name="employee_id" filters="1" widget="many2one_avatar_employee"/>
                <field name="permission_type_id" filters="1"/>
                <field name="work_location_id" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_presenly_permission_pivot" model="ir.ui.view">
        <field name="name">presenly.permission.pivot</field>
        <field name="model">presenly.permission</field>
        <field name="arch" type="xml">
            <pivot string="Permission / Dispensation Analysis" sample="1">
                <field name="employee_id" type="row"/>
                <field name="permission_type_id" type="row"/>
                <field name="date_from" type="col" interval="month"/>
                <field name="id" type="measure" string="Requests"/>
            </pivot>
        </field>
    </record>

    <record id="view_presenly_permission_graph" model="ir.ui.view">
        <field name="name">presenly.permission.graph</field>
        <field name="model">presenly.permission</field>
        <field name="arch" type="xml">
            <graph string="Permission / Dispensation Analysis" sample="1">
                <field name="date_from" interval="month"/>
                <field name="state"/>
                <field name="id" type="measure" string="Requests"/>
            </graph>
        </field>
    </record>

    <record id="action_presenly_permission_reporting" model="ir.actions.act_window">
        <field name="name">Permissions / Dispensations</field>
        <field name="res_model">presenly.permission</field>
        <field name="view_mode">list,calendar,pivot,graph,form</field>
        <field name="search_view_id" ref="presenly.view_presenly_permission_search"/>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No permission or dispensation requests found</p>
        </field>
    </record>
</odoo>
