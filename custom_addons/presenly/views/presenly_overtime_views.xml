<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presenly_overtime_form" model="ir.ui.view">
        <field name="name">presenly.overtime.request.form</field>
        <field name="model">presenly.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Overtime / Lembur">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="d-flex flex-wrap gap-2 mb-3 o_presenly_overtime_actions">
                        <button name="action_submit" type="object" string="Submit for Approval"
                                class="oe_highlight" invisible="not can_submit"/>
                        <button name="action_presenly_approve" type="object" string="Approve Current Level"
                                class="oe_highlight" invisible="not can_approve"/>
                        <button name="action_presenly_open_reject_wizard" type="object" string="Reject"
                                class="btn-secondary" invisible="not can_reject"/>
                        <button name="action_cancel" type="object" string="Cancel Request"
                                invisible="not can_cancel"
                                confirm="Cancel this overtime request and its pending approval journey?"/>
                        <button name="action_delete_with_confirm" type="object" string="Delete"
                                confirm="Delete this overtime request and its approval journey?\nThis action cannot be undone."
                                groups="presenly.group_presenly_hr,presenly.group_presenly_manager"
                                invisible="not id"/>
                    </div>
                    <div class="alert alert-info d-flex align-items-center my-2" role="alert"
                         invisible="state != 'draft'">
                        <i class="fa fa-clock-o me-2"/>
                        Overtime duration is computed server-side. Only one request per employee per day is allowed and attendance evidence is required.
                    </div>
                    <div class="alert alert-warning d-flex align-items-center my-2" role="alert"
                         invisible="state != 'submitted'">
                        <i class="fa fa-hourglass-half me-2"/>
                        <div>
                            <strong><field name="approval_level" class="oe_inline"/></strong>
                            <span class="ms-2">Waiting for</span>
                            <field name="presenly_pending_approver_ids" widget="many2many_tags"
                                   class="oe_inline ms-1" options="{'no_open': True}"/>
                        </div>
                    </div>
                    <div class="alert alert-danger my-2" role="alert"
                         invisible="not rejection_reason">
                        <strong>Rejection reason:</strong>
                        <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </div>

                    <group string="Overtime Details">
                        <group>
                            <field name="employee_id"
                                   widget="many2one_avatar_employee"
                                   readonly="state != 'draft' or not can_change_employee"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="work_location_id"
                                   groups="presenly.group_presenly_manager"
                                   invisible="1"/>
                            <field name="work_location_id"
                                   domain="[('active', '=', True), ('company_id', '=', company_id)]"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Waktu">
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="hour_from" widget="float_time"
                                   readonly="state != 'draft'"/>
                            <field name="hour_to" widget="float_time"
                                   readonly="state != 'draft'"/>
                            <field name="duration_hours" readonly="1" widget="float_time"/>
                        </group>
                        <group>
                            <field name="reason" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Bukti Kehadiran">
                        <field name="has_attendance_evidence"/>
                    </group>

                    <group string="Approval Journey" class="mt-3"
                           invisible="not presenly_approval_request_id">
                        <field name="presenly_approval_step_ids" nolabel="1" readonly="1" colspan="2">
                            <list create="0" edit="0" delete="0"
                                  decoration-info="state == 'pending'"
                                  decoration-success="state == 'approved'"
                                  decoration-danger="state == 'rejected'"
                                  decoration-muted="state in ('waiting', 'cancelled')">
                                <field name="level"/>
                                <field name="name"/>
                                <field name="assigned_user_ids" widget="many2many_tags"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'pending'"
                                       decoration-success="state == 'approved'"
                                       decoration-danger="state == 'rejected'"
                                       decoration-muted="state in ('waiting', 'cancelled')"/>
                                <field name="decision_user_id" widget="many2one_avatar_user" optional="show"/>
                                <field name="decision_date" optional="show"/>
                                <field name="decision_note" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_presenly_overtime_tree" model="ir.ui.view">
        <field name="name">presenly.overtime.request.tree</field>
        <field name="model">presenly.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Overtime / Lembur">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="work_location_id"/>
                <field name="hour_from" widget="float_time" optional="show"/>
                <field name="hour_to" widget="float_time" optional="show"/>
                <field name="duration_hours" widget="float_time"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_presenly_overtime_search" model="ir.ui.view">
        <field name="name">presenly.overtime.request.search</field>
        <field name="model">presenly.overtime.request</field>
        <field name="arch" type="xml">
            <search string="Overtime / Lembur">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="date"/>
                <separator/>
                <filter name="my_requests" string="My Requests"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'submitted'), ('presenly_pending_approver_ids', 'in', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_location" string="Work Location" context="{'group_by': 'work_location_id'}"/>
                <filter name="group_by_date" string="Day" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_presenly_overtime" model="ir.actions.act_window">
        <field name="name">My Overtime</field>
        <field name="res_model">presenly.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_presenly_overtime_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_employee'))]"/>
    </record>

    <record id="action_presenly_overtime_approvals" model="ir.actions.act_window">
        <field name="name">Overtime Approvals</field>
        <field name="res_model">presenly.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_presenly_overtime_search"/>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_approver'))]"/>
    </record>

    <record id="action_presenly_overtime_reporting" model="ir.actions.act_window">
        <field name="name">Overtime / Lembur</field>
        <field name="res_model">presenly.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_presenly_overtime_search"/>
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_hr'))]"/>
    </record>

    <menuitem id="menu_presenly_my_overtime" name="My Overtime"
              parent="hr_attendance.menu_hr_attendance_overview"
              action="action_presenly_overtime" sequence="25"
              groups="presenly.group_presenly_employee"/>
    <!-- Overtime approvals live under the Attendances root (the historical
         Approvals subtree is disabled), so approvers can open the queue. -->
    <menuitem id="menu_presenly_overtime_approvals" name="Overtime Approvals"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_presenly_overtime_approvals" sequence="8"
              groups="presenly.group_presenly_approver" active="True"/>
    <menuitem id="menu_presenly_overtime_reporting" name="Overtime / Lembur"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="action_presenly_overtime_reporting" sequence="50"
              groups="presenly.group_presenly_hr"/>
</odoo>