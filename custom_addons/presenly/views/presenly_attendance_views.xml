<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presenly_attendance_event_list" model="ir.ui.view">
        <field name="name">presenly.attendance.event.list</field>
        <field name="model">presenly.attendance.event</field>
        <field name="arch" type="xml">
            <list string="Attendance Evidence" create="0"
                  decoration-success="validation_status == 'success'"
                  decoration-danger="validation_status == 'failed'">
                <field name="event_time"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="event_type"/>
                <field name="attendance_mode" optional="show"/>
                <field name="work_location_id" optional="show"/>
                <field name="schedule_id" optional="hide"/>
                <field name="distance_from_location" string="Distance (m)" optional="show"/>
                <field name="accuracy" string="Accuracy (m)" optional="hide"/>
                <field name="source" optional="show"/>
                <field name="validation_status" widget="badge"
                       decoration-success="validation_status == 'success'"
                       decoration-danger="validation_status == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_presenly_attendance_event_form" model="ir.ui.view">
        <field name="name">presenly.attendance.event.form</field>
        <field name="model">presenly.attendance.event</field>
        <field name="arch" type="xml">
            <form string="Attendance Evidence" create="0" duplicate="false">
                <sheet>
                    <widget name="web_ribbon" title="Valid" bg_color="text-bg-success"
                            invisible="validation_status != 'success'"/>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger"
                            invisible="validation_status != 'failed'"/>
                    <div class="oe_title">
                        <label for="employee_id" string="Attendance Evidence"/>
                        <h1><field name="employee_id" widget="many2one_avatar_employee"
                                   readonly="1" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group string="Event Identity">
                            <field name="attendance_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="event_type" readonly="1"/>
                            <field name="attendance_mode" readonly="1"/>
                            <field name="event_time"/>
                            <field name="schedule_id" readonly="1"/>
                            <field name="source"/>
                            <field name="device_id_hash" readonly="1" groups="presenly.group_presenly_manager"/>
                        </group>
                        <group string="Validation">
                            <field name="validation_status"/>
                            <field name="validation_message" placeholder="Explain a manual correction when needed..."/>
                            <field name="distance_from_location" string="Distance from Location (m)"/>
                            <field name="accuracy" string="GPS Accuracy (m)"/>
                        </group>
                    </group>
                    <separator string="Location Evidence"/>
                    <group>
                        <group>
                            <field name="work_location_id"
                                   domain="[('active', '=', True), ('company_id', '=', company_id)]"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <separator string="Selfie Evidence"/>
                    <group>
                        <field name="selfie_attachment_id"
                               widget="presenly_attachment_image_viewer" readonly="1"
                               nolabel="1" invisible="not selfie_attachment_id"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Authorized manual corrections use native Edit/Save behavior and are recorded in the chatter.
                    </div>
                </sheet>
                <chatter reload_on_post="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="view_presenly_attendance_event_search" model="ir.ui.view">
        <field name="name">presenly.attendance.event.search</field>
        <field name="model">presenly.attendance.event</field>
        <field name="arch" type="xml">
            <search string="Attendance Evidence">
                <field name="employee_id"/>
                <field name="attendance_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="work_location_id"/>
                <field name="attendance_mode"/>
                <field name="schedule_id"/>
                <field name="event_time"/>
                <filter name="check_in" string="Check In" domain="[('event_type', '=', 'check_in')]"/>
                <filter name="check_out" string="Check Out" domain="[('event_type', '=', 'check_out')]"/>
                <filter name="success" string="Valid" domain="[('validation_status', '=', 'success')]"/>
                <filter name="failed" string="Failed" domain="[('validation_status', '=', 'failed')]"/>
                <filter name="wfa" string="Work From Anywhere" domain="[('attendance_mode', '=', 'wfa')]"/>
                <filter name="today" string="Today"
                        domain="[('event_time', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0))), ('event_time', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0, 0, 0)))]"/>
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
                <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                <filter name="group_attendance_mode" string="Mode" context="{'group_by': 'attendance_mode'}"/>
                <filter name="group_status" string="Validation Status" context="{'group_by': 'validation_status'}"/>
                <filter name="group_location" string="Work Location" context="{'group_by': 'work_location_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'event_time:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_presenly_attendance_event" model="ir.actions.act_window">
        <field name="name">Attendance Evidence</field>
        <field name="res_model">presenly.attendance.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_presenly_attendance_event_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
