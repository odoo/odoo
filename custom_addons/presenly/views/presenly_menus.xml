<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Presenly remains a technical extension of native Attendances. -->
    <record id="hr_attendance.menu_hr_attendance_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_employee'))]"/>
    </record>
    <record id="hr_attendance.menu_hr_attendance_overview" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_employee'))]"/>
    </record>
    <record id="hr_attendance.menu_hr_attendance_reporting" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_hr'))]"/>
    </record>
    <record id="hr_attendance.menu_hr_attendance_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_manager'))]"/>
    </record>

    <!-- Keep Manage All Attendances/history available, but disable native
         Kiosk/RFID entry points without changing company configuration. -->
    <record id="hr_attendance.menu_action_open_form" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_attendance.menu_hr_attendance_onboarding" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
        <field name="context">{
            'create': False,
            'edit': False,
            'search_default_groupby_name': 1,
            'search_default_employee': 2,
        }</field>
    </record>
    <record id="hr_attendance.hr_attendance_management_action" model="ir.actions.act_window">
        <field name="context">{
            'create': False,
            'edit': False,
            'search_default_to_approve': 1,
            'search_default_activeemployees': 1,
        }</field>
    </record>

    <!-- Compatibility menu XML IDs retained but hidden. -->
    <menuitem id="menu_presenly_root" name="Presenly" sequence="10" active="False"/>
    <menuitem id="menu_presenly_configuration" name="Configuration"
              parent="menu_presenly_root" sequence="90" active="False"
              groups="presenly.group_presenly_manager"/>
    <record id="action_presenly_my_attendances" model="ir.actions.act_window">
        <field name="name">My Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'search_default_myattendances': 1}</field>
        <field name="group_ids" eval="[(4, ref('presenly.group_presenly_employee'))]"/>
    </record>
    <menuitem id="menu_presenly_my_attendances" name="My Attendances"
              parent="hr_attendance.menu_hr_attendance_overview"
              action="action_presenly_my_attendances" sequence="10"
              groups="presenly.group_presenly_employee"/>
    <menuitem id="menu_presenly_permissions"
              name="My Permissions / Dispensations"
              parent="hr_attendance.menu_hr_attendance_overview"
              action="action_presenly_permission" sequence="20"
              groups="presenly.group_presenly_employee"/>
    <menuitem id="menu_presenly_my_time_off"
              name="My Time Off"
              parent="hr_attendance.menu_hr_attendance_overview"
              action="hr_holidays.hr_leave_action_my" sequence="30"
              groups="presenly.group_presenly_employee"/>

    <menuitem id="menu_presenly_approvals" name="Approvals"
              parent="hr_attendance.menu_hr_attendance_root" sequence="7"
              groups="presenly.group_presenly_approver" active="False"/>
    <menuitem id="menu_presenly_my_approvals" name="My Approvals"
              parent="menu_presenly_approvals"
              action="action_server_presenly_my_approvals" sequence="10"
              groups="presenly.group_presenly_approver" active="False"/>
    <!-- Compatibility XML IDs retained but hidden after unifying the queue. -->
    <menuitem id="menu_presenly_permission_approvals" name="Permission Approvals"
              parent="menu_presenly_approvals"
              action="action_server_presenly_permission_approvals" sequence="20"
              groups="presenly.group_presenly_approver" active="False"/>
    <menuitem id="menu_presenly_leave_approvals" name="Time Off Approvals"
              parent="menu_presenly_approvals"
              action="action_server_presenly_leave_approvals" sequence="30"
              groups="presenly.group_presenly_approver" active="False"/>

    <menuitem id="menu_presenly_attendance_events" name="Attendance Evidence"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="action_presenly_attendance_event" sequence="20"
              groups="presenly.group_presenly_hr"/>
    <menuitem id="menu_presenly_permission_reporting"
              name="Permissions / Dispensations"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="action_presenly_permission_reporting" sequence="30"
              groups="presenly.group_presenly_hr"/>
    <menuitem id="menu_presenly_time_off_reporting" name="Time Off"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="hr_holidays.action_hr_available_holidays_report" sequence="40"
              groups="presenly.group_presenly_hr"/>

    <!-- Native multi-company and work-location configuration. -->
    <menuitem id="menu_presenly_companies" name="Companies"
              parent="hr_attendance.menu_hr_attendance_configuration"
              action="base.action_res_company_form" sequence="20"
              groups="presenly.group_presenly_manager"/>
    <menuitem id="menu_presenly_locations" name="Work Locations"
              parent="hr_attendance.menu_hr_attendance_configuration"
              action="hr.hr_work_location_action" sequence="30"
              groups="presenly.group_presenly_manager"/>
    <menuitem id="menu_presenly_work_location_schedules"
              name="Work Location Schedules"
              parent="hr_attendance.menu_hr_attendance_configuration"
              action="action_presenly_work_location_schedule" sequence="40"
              groups="presenly.group_presenly_manager"/>
    <menuitem id="menu_presenly_permission_types" name="Permission Types"
              parent="hr_attendance.menu_hr_attendance_configuration"
              action="action_presenly_permission_type" sequence="50"
              groups="presenly.group_presenly_manager"/>
    <!-- Disable the native Overtime Rulesets configuration menu; overtime is
         managed by Presenly Overtime requests and Presenly Approval Routes. -->
    <record id="hr_attendance.menu_hr_attendance_overtime_rulesets" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
