<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_advance_list" model="ir.ui.view">
        <field name="name">account.advance.list</field>
        <field name="model">account.advance</field>
        <field name="arch" type="xml">
            <list string="Advance Payments">
                <field name="name"/>
                <field name="date"/>
                <field name="advance_type"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="used_amount" sum="Used"/>
                <field name="remaining_amount" sum="Remaining"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted' or state == 'reconciled'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_account_advance_form" model="ir.ui.view">
        <field name="name">account.advance.form</field>
        <field name="model">account.advance</field>
        <field name="arch" type="xml">
            <form string="Advance Payment">
                <header>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            invisible="state != 'posted'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('posted', 'reconciled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,reconciled,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="advance_type"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="used_amount" readonly="1"/>
                            <field name="remaining_amount" readonly="1"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="journal_id"/>
                            <field name="advance_account_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="move_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_advance_search" model="ir.ui.view">
        <field name="name">account.advance.search</field>
        <field name="model">account.advance</field>
        <field name="arch" type="xml">
            <search string="Search Advance Payments">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Customer" name="customer" domain="[('advance_type', '=', 'customer')]"/>
                <filter string="Supplier" name="supplier" domain="[('advance_type', '=', 'supplier')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Reconciled" name="reconciled" domain="[('state', '=', 'reconciled')]"/>
                <filter string="Cancelled" name="cancel" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="action_account_advance" model="ir.actions.act_window">
        <field name="name">Advance Payments</field>
        <field name="res_model">account.advance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new advance payment
            </p>
        </field>
    </record>

    <menuitem
        id="menu_account_advance"
        name="Advance Payments"
        parent="account.menu_finance"
        action="action_account_advance"
        sequence="12"
    />

</odoo>
