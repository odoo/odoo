	<queryString language="SQL">
		<![CDATA[SELECT 
COALESCE(c.company_name_thai,'') AS company_name_thai,
COALESCE(c.company_name_en,'') AS company_name_en,
bill.id as bill_id,
bill.name as bill_no,
bill.date as bill_date,
bill.threshold_date as bill_actual_due_date,
inv.name as inv_no,
p.name as customer_name,
inv.invoice_date_due as invoice_date_due,
COALESCE(bill.narration, '') as remark,
COALESCE(pm.name, '') as payment_method,
(case
	when inv.dncn='cn' then inv.amount_total*-1
	else inv.amount_total
end) as inv_amount_total,
(case
	when inv.dncn='cn' then inv.amount_residual*-1
	else inv.amount_residual
end) as inv_amount_residual
FROM account_billing bill
LEFT JOIN account_billing_line rel ON rel.billing_id = bill.id
LEFT JOIN account_move inv ON inv.id = rel.move_id
LEFT JOIN res_partner p ON p.id = bill.partner_id
LEFT JOIN account_payment_method_line pm ON pm.id = inv.preferred_payment_method_line_id
LEFT JOIN company_address_header_report c ON c.id=bill.company_id
$P!{p_Where}]]>
	</queryString>
