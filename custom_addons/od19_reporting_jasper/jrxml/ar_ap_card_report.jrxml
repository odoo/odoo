	</parameter>
	<queryString>
		<![CDATA[select
    card.partner_id,
    p.ref as partner_ref,
    p.name as partner_name,
    aam.name as doc_no,
    case when paymt.id is null then null else paymt.od19_voucher_no end as voucher_no,
    case when card.move_line_id is null then 'ยอดยกมา' else aam.ref end as reference,
    case when card.move_line_id is null then $P{start_date}::date else aam.date end as date,
    aam.invoice_date_due as actual_due_date,
    t.name as payment_term,
    cu.name as currency_name,
    case when cu.id is null then null::int else (select rcr.rate from res_currency_rate rcr where rcr.currency_id = cu.id and rcr.company_id = aam.company_id and rcr.name <= coalesce(aam.date, $P{start_date}::date) order by rcr.name desc limit 1) end as exchange_rate,
    card.debit,
    card.credit
from
(select
        null::int as move_id,
        null::int as move_line_id,
        aml.partner_id,
        null::int as account_id,
        null::int as currency_id,
        case when sum(aml.debit) > sum(aml.credit) then sum(aml.debit) - sum(aml.credit) else 0 end as debit,
        case when sum(aml.debit) < sum(aml.credit) then -sum(aml.debit) + sum(aml.credit) else 0 end as credit
    from account_move am
    join account_move_line aml on am.id = aml.move_id
    join account_account aa on aml.account_id = aa.id
	left join res_partner rp ON aml.partner_id = rp.id
    where am.state = 'posted' and am.company_id = $P{company_id}
    and aa.account_type = case when '$P!{p_Type}' = 'ap' then 'liability_payable' else 'asset_receivable' end
    and (aml.account_id = any($P!{account_ids}) or $P!{account_ids} is null)
    and (aml.partner_id = any($P!{partner_ids}) or $P!{partner_ids} is null)
	and (case when '$P!{partner_type}' = 'customer' then rp.customer_rank > 0 else rp.supplier_rank > 0 end)
    and (
        (am.move_type = 'entry' and am.date < $P{start_date}::date)
        OR (am.move_type != 'entry' and am.invoice_date < $P{start_date}::date)
    )
    group by aml.partner_id, aml.account_id
    having sum(aml.debit) != sum(aml.credit)
    UNION ALL
    select
        aml.move_id,
        aml.id as move_line_id,
        aml.partner_id,
        aml.account_id,
        aml.currency_id,
        aml.debit,
        aml.credit
    from account_move am
    join account_move_line aml on am.id = aml.move_id
    join account_account aa on aml.account_id = aa.id
	left join res_partner rp ON aml.partner_id = rp.id
    left join res_currency cu on aml.currency_id = cu.id
    where am.state = 'posted' and am.company_id = $P{company_id}
    and aa.account_type = case when '$P!{p_Type}' = 'ap' then 'liability_payable' else 'asset_receivable' end
    and (aml.account_id = any($P!{account_ids}) or $P!{account_ids} is null)
    and (aml.partner_id = any($P!{partner_ids}) or $P!{partner_ids} is null)
	and (case when '$P!{partner_type}' = 'customer' then rp.customer_rank > 0 else rp.supplier_rank > 0 end)
    and (
        (am.move_type = 'entry' and am.date between $P{start_date}::date and $P{p_As_Date}::date)
        OR (am.move_type != 'entry' and am.invoice_date between $P{start_date}::date and $P{p_As_Date}::date)
    )
) card
join res_partner p on card.partner_id = p.id
left join account_move aam on card.move_id = aam.id
left join account_payment_term t on aam.invoice_payment_term_id = t.id
left join account_payment paymt on paymt.move_id = aam.id
left join res_currency cu on card.currency_id = cu.id
order by p.ref, p.id, card.account_id NULLS FIRST, aam.date, aam.create_date]]>
	</queryString>
