	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (3)"/>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE asset.state != 'draft'"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_reference_display" class="java.lang.String"/>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT asset_code, asset_name, invoice_no, purchase_date, asset_date, value, salvage_value, initial_depreciation, method_number, method_th, method_en,
accumulated_depreciation_bf, partner, serial_no, warranty, warranty_end, asset_value, freight_charge, transportation_charge, installation_charge,
other_expenses, total, MAX(depreciation_date) AS max_depreciation_date, company_name_thai, company_name_en, asset_id, currency_th, currency_en
FROM
(SELECT COALESCE(asset.code, '') AS asset_code,
c.name AS currency_th,
c.name AS currency_en,
asset.id AS asset_id,
COALESCE(com.name,'') AS company_name_thai,
COALESCE(com.name,'') AS company_name_en,
asset.name AS asset_name,
'-' AS invoice_no,
asset.date_start AS purchase_date,
asset.date_start AS asset_date,
asset.purchase_value AS value,
asset.salvage_value AS salvage_value,
0 AS initial_depreciation,
asset.method_number AS method_number,
(case
	when asset.method = 'linear' then 'เส้นตรง'
	else 'ลดลง'
end) AS method_th,
(case
	when asset.method = 'linear' then 'Linear'
	else 'Degressive'
end) AS method_en,
asset.value_depreciated AS accumulated_depreciation_bf,
COALESCE(p.complete_name, p.name, '') AS partner,
'' AS serial_no,
'' AS warranty,
NULL::date AS warranty_end,
asset.depreciation_base AS asset_value,
0.00 AS freight_charge,
0.00 AS transportation_charge,
0.00 AS installation_charge,
0.00 AS other_expenses,
asset.purchase_value AS total,
l.line_date AS depreciation_date
FROM account_asset asset
LEFT JOIN res_partner p ON p.id = asset.partner_id
LEFT JOIN account_asset_line l ON l.asset_id = asset.id
LEFT JOIN res_company com ON com.id = asset.company_id
LEFT JOIN res_currency c ON c.id = asset.currency_id
$P!{p_Where}
) a
GROUP BY asset_code, asset_name, invoice_no, purchase_date, asset_date, value, salvage_value, initial_depreciation, method_number, method_th, method_en,
accumulated_depreciation_bf, partner, serial_no, warranty, warranty_end, asset_value, freight_charge, transportation_charge, installation_charge,
other_expenses, total, company_name_thai, company_name_en, asset_id, currency_th, currency_en
ORDER BY asset_name]]>
	</queryString>
