	</field>
	<field name="final_cost" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="final_cost"/>
	</field>
	<field name="remaining_value" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="remaining_value"/>
	</field>
