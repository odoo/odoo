	<parameter name="p_account_asset_asset_id" class="java.lang.String"/>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT a.asset_value, a.asset_initial, a.asset_salvage_value, a.depreciation_year, SUM(a.line_amount) AS line_amount, MAX(a.depreciated_value) as depreciated_value, a.final_cost AS final_cost, MIN(a.remaining_value) AS remaining_value
FROM (
SELECT asset.purchase_value AS asset_value,
0 AS asset_initial,
asset.salvage_value AS asset_salvage_value,
EXTRACT(year FROM line.line_date) AS depreciation_year,
line.line_date AS depreciation_date,
line.amount AS line_amount,
line.depreciated_value AS depreciated_value,
line.remaining_value AS remaining_value,
(case
	when line2.remaining_value is not null then line2.remaining_value + asset.salvage_value
	else 0.00
end) AS final_cost
FROM account_asset_line line
LEFT JOIN account_asset asset ON line.asset_id = asset.id
LEFT JOIN account_asset_line line2 ON line2.id = (SELECT line3.id FROM account_asset_line line3 WHERE line3.asset_id = line.asset_id and EXTRACT(year FROM line3.line_date) = EXTRACT(year FROM line.line_date)-1 ORDER BY line3.line_date DESC limit 1)
LEFT JOIN account_move m ON m.id = line.move_id
WHERE line.asset_id = $P!{p_account_asset_asset_id} and m.state = 'posted'
ORDER BY depreciation_year,depreciation_date
) a
GROUP BY a.asset_value, a.asset_initial, a.asset_salvage_value, a.depreciation_year, a.final_cost]]>
	</queryString>
	<field name="asset_value" class="java.math.BigDecimal">
