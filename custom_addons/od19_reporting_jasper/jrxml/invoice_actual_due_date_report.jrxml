	<parameter name="p_Act_End_Date" class="java.lang.String"/>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE (inv.dncn = '' OR inv.dncn is null) AND inv.type in ('out_invoice', 'in_invoice')"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Group_By" class="java.lang.String"/>
	<parameter name="p_Order_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["ORDER BY inv.partner_id"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Order_By_Display" class="java.lang.String"/>
	<parameter name="p_Group_By_Display" class="java.lang.String"/>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
COALESCE(c.company_name_thai,'') AS company_name_thai,
COALESCE(c.company_name_en,'') AS company_name_en,
inv.invoice_user_id AS salesperson_id,
inv.partner_id AS partner_id,
pu.name AS salesperson,
p.name AS partner_name,
inv.dncn,
inv.invoice_date AS invoice_date,
inv.od19_actual_due_date AS actual_due_date,
inv.name AS invoice_no,
COALESCE(
	(SELECT b.name
	 FROM account_billing_line bl
	 LEFT JOIN account_billing b ON b.id = bl.billing_id
	 WHERE bl.move_id = inv.id
	 ORDER BY bl.id
	 LIMIT 1), '') as bill_no,
inv.amount_total AS amount_total,
inv.amount_residual AS amount_residual
FROM account_move inv
LEFT JOIN company_address_header_report c ON c.id=inv.company_id
LEFT JOIN res_partner p ON p.id = inv.partner_id
LEFT JOIN res_users u ON u.id = inv.invoice_user_id
LEFT JOIN res_partner pu ON pu.id = u.partner_id
$P!{p_Where}
$P!{p_Order_By}]]>
	</queryString>
