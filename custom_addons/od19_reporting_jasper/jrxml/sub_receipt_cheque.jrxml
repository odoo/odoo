	<parameter name="ids" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[select bank.name as bank_name,
        c.name as cheque_number,
		c.cheque_date as cheque_date,
		c.amount as cheque_amount
from account_cheque as c
inner join account_payment as pay on pay.id = c.payment_id
inner join res_bank as bank on bank.id = c.bank_id
where pay.id = $P{ids}]]>
	</queryString>
	<field name="bank_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="bank_name"/>
	</field>
	<field name="cheque_number" class="java.lang.String">
