	<field name="amount" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="amount"/>
	</field>
	<field name="payment_amount" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="payment_amount"/>
	</field>
	<field name="outstanding" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="outstanding"/>
	</field>
	<variable name="v_Sum_Amount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="v_Sum_Get_Back" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF(($F{c_id} != null && ($F{amount}.subtract(BigDecimal.valueOf($F{payment_amount})).compareTo(new BigDecimal(0)) == 1)), 
	ABS($F{amount}.subtract(BigDecimal.valueOf($F{payment_amount})))
	, 0
)]]></variableExpression>
	</variable>
	<variable name="v_Sum_Pay" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF(($F{c_id} != null && ($F{amount}.subtract(BigDecimal.valueOf($F{payment_amount})).compareTo(new BigDecimal(0)) <= 0)), 
	ABS($F{amount}.subtract(BigDecimal.valueOf($F{payment_amount})))
	, 0
)]]></variableExpression>
	</variable>
	<variable name="v_Sum_Outstanding" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{outstanding}]]></variableExpression>
	</variable>
