	<subDataset name="localhost" uuid="b8789400-9638-4f2c-83a4-1bb4710452e7">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (2)"/>
		<queryString>
			<![CDATA[]]>
		</queryString>
	</subDataset>
	<parameter name="p_language" class="java.lang.String"/>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_At_Date" class="java.lang.String"/>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE (req.state = 'approve' OR req.state = 'paid') AND (c.number IS NULL OR c.state = 'clear')"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_request_name" class="java.lang.String"/>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT *,
(case
	when a.c_id is null then a.cash_loans
	else a.used_amount
end) as amount,
(case
	when a.c_id is null then 0
	else a.used_amount
end) as payment_amount,
COALESCE(a.remaining_amount, 0) as outstanding
FROM (
SELECT req.id AS req_id ,
COALESCE(com.company_name_thai,'') AS company_name_thai,
COALESCE(com.company_name_en,'') AS company_name_en,
req.date AS req_date,
req.name AS req_number,
COALESCE(emp.name,'') AS emp_name,
COALESCE(req.note,'') AS req_name,
NULL::date AS due_date,
req.amount AS cash_loans,
CASE WHEN req.state = 'reconciled' THEN req.id ELSE NULL END AS c_id,
CASE WHEN req.state = 'reconciled' THEN req.name ELSE '' END AS clear_number,
CASE WHEN req.state = 'reconciled' THEN req.date ELSE NULL END AS clear_date,
COALESCE(req.used_amount, 0) AS used_amount,
COALESCE(req.remaining_amount, 0) AS remaining_amount
FROM account_advance req
LEFT JOIN account_journal j ON j.id = req.journal_id
LEFT JOIN company_address_header_report com ON com.id = j.company_id
LEFT JOIN res_partner emp ON emp.id = req.partner_id
$P!{p_Where}
ORDER BY req.date) a]]>
	</queryString>
