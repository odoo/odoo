	<parameter name="iscopy" class="java.lang.Integer"/>
	<parameter name="ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE pay.id  in (4929)"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.name as company_name,
        encode(c2.company_logo,'escape') AS company_logo,
        concat(cpartner.street) as company_address_1, 
        concat(cpartner.street2, cpartner.city,
       	            case when cp.name is not null then ' จังหวัด' else '' end,
                    cp.name, ' ', 
                    cpartner.zip,
                    case when cc.name is not null then ' ' else '' end,
                    cc.name) as company_address_2, 
        concat('โทรศัพท์ ', c.phone, ' แฟกซ์. ', c2.company_fax) as company_address_3, 
        cpartner.vat as company_tax, 
        case when c2.company_branch is null or c2.company_branch = '00000' then 'สำนักงานใหญ่' else c2.company_branch end as company_branch_code, 
        p.name as partner_name, 
        concat(p.street) as partner_address_1, 
        concat(p.street2, p.city, 
       	            case when pp.name is not null then ' จังหวัด' else '' end,
                    pp.name, ' ', 
                    p.zip,
                    case when pc.name is not null then ' ' else '' end,
                    pc.name) as partner_address_2,
        p.ref as partner_code, 
        p.vat as partner_tax,  
        case when p.branch_code is null or p.branch_code = '00000' then 'สำนักงานใหญ่' else p.branch_code end as partner_branch_code, 
        p.vat as partner_tax,
        p.phone as partner_phone,
        p.mobile as partner_mobile,
        pay.id as pay_id,
        pay.name as pay_name,
	pay.date as pay_date,
        up.name AS saleperson_name,
        null::text AS salearea_name,
		
	inv.name as invoice_number,
        inv.invoice_date as invoice_date,
        inv.invoice_date_due as invoice_due_date,
		inv.amount_total as invoice_amount,
		(inv.amount_total - apr.amount) as invoice_residual,
		apr.amount as invoice_payment_amount,
		
		pay.amount as pay_amount,
		convert_num_th_with_currency(pay.amount, pay.currency_id) AS pay_amount_total_bahttext,
		jn.name as pay_journal_name,
		case when jn.type = 'cash' then 1 else 0 end as is_cash,
		case when jn.type = 'bank' then 1 else 0 end as is_bank_transfer,
		case when pay.cheque_id is not null then 1 else 0 end as is_cheque,
		
		cur.symbol as currency_symbol,
        cur.position as currency_position
		
from account_payment as pay
inner join res_currency as cur on cur.id = pay.currency_id
inner join account_journal as jn on jn.id = pay.journal_id

inner join res_company as c on c.id = jn.company_id
inner join res_partner as cpartner on cpartner.id = c.partner_id
left outer join res_country_state as cp on cp.id = cpartner.state_id
left outer join res_country as cc on cc.id = cpartner.country_id
left outer join company_address_header_report c2 ON c2.id = jn.company_id

inner join res_partner as p on p.id = pay.partner_id
left outer join res_country_state as pp on pp.id = p.state_id
left outer join res_country as pc on pc.id = p.country_id

left outer join res_users as u on u.id = pay.create_uid
left outer join res_partner as up on up.id = u.partner_id
inner join account_move as am on am.id = pay.move_id
                                                    and am.state != 'cancel'
inner join account_move_line as aml on aml.move_id = am.id
inner join account_account as aa on aa.id = aml.account_id
                                       and aa.account_type = 'asset_receivable'
left outer join account_partial_reconcile as apr on apr.credit_move_id = aml.id
left outer join account_move_line as inv_aml on inv_aml.id = apr.debit_move_id
left outer join account_move as inv on inv.id = inv_aml.move_id
$P!{ids}]]>
	</queryString>
