		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT * FROM (
SELECT a.id AS account_id,
a.code_store->>(c.company_id::text) AS account_code,
COALESCE(a.name->>'th_TH', a.name->>'en_US') AS account_name,
'account.cheque' AS cheque_type,
c.state AS cheque_status,
c.name AS cheque_no,
p.date AS payment_date,
c.cheque_date AS cheque_date,
c.amount AS cheque_amount,
part.name AS partner,
p.name AS payment_name,
p.amount AS payment_amount_net,
COALESCE(com.company_name_thai,'') AS company_name_thai,
COALESCE(com.company_name_en,'') AS company_name_en
FROM account_cheque c
LEFT JOIN account_payment p ON p.id = c.payment_id
LEFT JOIN account_journal j ON j.id = c.journal_id
LEFT JOIN account_account a ON a.id = j.default_account_id
LEFT JOIN res_partner part ON part.id = c.partner_id
LEFT JOIN company_address_header_report com ON com.id = c.company_id
) a
$P!{p_Where}
ORDER BY a.cheque_type, a.account_code]]>
	</queryString>
