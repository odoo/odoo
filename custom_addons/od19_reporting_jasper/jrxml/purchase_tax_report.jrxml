	<title>
		<band height="100" splitType="Stretch">
			<textField>
				<reportElement x="0" y="-2" width="799" height="25" uuid="0ec500ef-b966-4285-a4ae-6fc4358abcd1">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="1" bottomPadding="1">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="TH Sarabun New" size="16" isBold="true"/>
					<paragraph rightIndent="0"/>
				</textElement>
				<textFieldExpression><![CDATA[IF($P{p_language}.toString().equals("thai"), "รายงานภาษีซื้อ", "Purchase Tax Report")]]></textFieldExpression>
			</textField>
			<textField>
