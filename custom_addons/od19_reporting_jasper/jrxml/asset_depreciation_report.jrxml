		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE asset.state != 'draft' and line.move_check = True"]]></defaultValueExpression>
	</parameter>
