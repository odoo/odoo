		<defaultValueExpression><![CDATA["ทั้งหมด"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT 
'' AS cost_center_code,
'No Cost Center' AS cost_center,
0 AS cost_center_id,
COALESCE(cat.name, '') AS category_name,
COALESCE(asset.code, '') AS asset_code,
asset.name AS asset_name,
asset.date_start AS asset_date,
asset.purchase_value AS asset_value,
CASE WHEN asset.method_number != 0 THEN (100/asset.method_number) ELSE 0 END AS percent,
line.amount AS depreciation_amount,
line.depreciated_value AS depreciation_value,
line.remaining_value AS remaining_value,
cat.id AS category_id,
asset.id AS asset_id,
COALESCE(com.name,'') AS company_name_thai,
COALESCE(com.name,'') AS company_name_en,
asset.salvage_value
FROM account_asset asset
LEFT JOIN account_asset_line line ON line.asset_id = asset.id
LEFT JOIN account_asset_profile cat ON cat.id = asset.profile_id
LEFT JOIN res_company com ON com.id = asset.company_id
$P!{p_Where}]]>
	</queryString>
