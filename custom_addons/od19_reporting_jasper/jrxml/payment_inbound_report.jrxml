	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (2)"/>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE pay.payment_type = 'inbound'"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Group_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Customer"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Group_By_Display" class="java.lang.String"/>
	<parameter name="p_Order_By_Display" class="java.lang.String"/>
