	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT 
	COALESCE(am.name,'') AS payment_name,
	COALESCE(c.company_name_thai,'') AS company_name_thai,
	COALESCE(c.company_name_en,'') AS company_name_en,
	pay.id AS payment_id,
	pm.name AS payment_method,
	pm.id AS payment_method_id,
	j.name AS journal,
	j.id AS journal_id,
	p.name AS partner_name,
	p.id AS partner_id,
	am.date AS payment_date,
	COALESCE(am.name, '') AS move_name,
	COALESCE(pay.od19_voucher_no,'') AS voucher_no,
	cur.name AS currency_name,
	pay.amount AS pay_amount,
	COALESCE(pay.od19_wht_amount,0) AS amount_wht,
	COALESCE(pay.fee_amount,0) AS amount_fee,
	(pay.amount + COALESCE(pay.fee_amount,0)) AS amount_with_fee,
	COALESCE(am.ref,'') AS remark,
	(SELECT SUM(residual.amount_residual) FROM (
		SELECT inv.amount_residual
		FROM account_move__account_payment rel
		LEFT JOIN account_move inv ON inv.id = rel.invoice_id
		WHERE rel.payment_id = pay.id
	)residual) AS inv_residual,
	(SELECT SUM(amount.amount_total) FROM (
		SELECT inv.amount_total
		FROM account_move__account_payment rel
		LEFT JOIN account_move inv ON inv.id = rel.invoice_id
		WHERE rel.payment_id = pay.id
	) amount) AS inv_amount
FROM account_payment pay
JOIN account_move pay2 ON pay2.id=pay.move_id
LEFT JOIN account_payment_method_line pm ON pm.id = pay.payment_method_line_id
LEFT JOIN account_move am ON am.id = pay.move_id
LEFT JOIN account_journal j ON j.id = am.journal_id
LEFT JOIN res_partner p ON p.id = pay.partner_id
LEFT JOIN company_address_header_report c ON c.id = pay.company_id
LEFT JOIN res_currency cur ON cur.id = pay.currency_id
$P!{p_Where}
$P!{p_Order_By}]]>
	</queryString>
