	<parameter name="path" class="java.lang.String" isForPrompting="false"/>
	<parameter name="iscopy" class="java.lang.Integer"/>
	<parameter name="ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["where inv.id in (4600,7231)"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.name as company_name,
       encode(c2.company_logo,'escape') AS company_logo,
       concat(cpartner.street) as company_address_1, 
       concat(cpartner.street2, cpartner.city,
       	            case when cp.name is not null then ' จังหวัด' else '' end,
                    cp.name, ' ', 
                    cpartner.zip,
                    case when cc.name is not null then ' ' else '' end,
                    cc.name) as company_address_2, 
       concat('โทรศัพท์ ', c.phone, ' แฟกซ์. ', cpartner.fax) as company_address_3, 
       cpartner.vat as company_tax, 
       case when cpartner.branch_code is null or cpartner.branch_code = '00000' then 'สำนักงานใหญ่' else cpartner.branch_code end as company_branch_code, 
       p.name as partner_name, 
       concat(p.street) as partner_address_1, 
       concat(p.street2, p.city, 
       	            case when pp.name is not null then ' จังหวัด' else '' end,
                    pp.name, ' ', 
                    p.zip,
                    case when pc.name is not null then ' ' else '' end,
                    pc.name) as partner_address_2,
       p.ref as partner_code, 
       p.vat as partner_tax,  
       case when p.branch_code is null or p.branch_code = '00000' then 'สำนักงานใหญ่' else p.branch_code end as partner_branch_code, 
       p.phone as partner_phone,
       p.mobile as partner_mobile,

       (select string_agg(distinct so.client_order_ref, ', ')
        from sale_order_line_invoice_rel as sinv
        left outer join account_move_line as invll on invll.id = sinv.invoice_line_id
        left outer join account_move as invv on invv.id = invll.move_id
        left outer join sale_order_line as sol on sol.id = sinv.order_line_id
	    left outer join sale_order as so on so.id = sol.order_id
        where invv.id = inv.id) AS partner_po_ref,

       inv.name AS invoice_no,
       inv.invoice_date AS invoice_date,
       (select string_agg(distinct so.name, ', ')
        from sale_order_line_invoice_rel as sinv
        left outer join account_move_line as invll on invll.id = sinv.invoice_line_id
        left outer join account_move as invv on invv.id = invll.move_id
        left outer join sale_order_line as sol on sol.id = sinv.order_line_id
	    left outer join sale_order as so on so.id = sol.order_id
        where invv.id = inv.id) AS invoice_sale_order,
        
       pt.note AS invoice_payment_term,
       inv.invoice_date_due AS invoice_due_date,
       up.name AS saleperson_name,
       NULL::varchar AS salearea_name,

       pro.default_code AS product_code,
       prot.name AS product_name,
       invl.quantity AS product_qty,
       uom.name AS product_uom,
       invl.price_unit AS product_price_unit,
       COALESCE(invl.discount,0) AS product_discount,
       case when COALESCE(invl.discount,0) <> 0 then '%' else '' end AS product_discount_sign,
       invl.price_subtotal AS product_price_total,
       inv.narration as invoice_remark,
       
       inv.amount_untaxed as invoice_untaxed_amount,
       0::numeric as invoice_trade_discount,
       inv.amount_untaxed as invoice_amount_before_tax,
       inv.amount_tax as invoice_tax,
       inv.amount_total as invoice_amount_total,
       
       cur.symbol as currency_symbol,
       cur.position as currency_position, 

       convert_num_th_with_currency(inv.amount_total, inv.currency_id) AS invoice_amount_total_bahttext
from account_move_line as invl
left join account_move as inv on inv.id = invl.move_id
inner join res_currency as cur on cur.id = inv.currency_id
left join uom_uom as uom on uom.id = invl.product_uom_id

inner join res_company as c on c.id = inv.company_id
inner join res_partner as cpartner on cpartner.id = c.partner_id
left outer join res_country_state as cp on cp.id = cpartner.state_id
left outer join res_country as cc on cc.id = cpartner.country_id
left outer join company_address_header_report c2 ON c2.id = inv.company_id

inner join res_partner as p on p.id = inv.partner_id
left outer join res_country_state as pp on pp.id = p.state_id
left outer join res_country as pc on pc.id = p.country_id

left join account_payment_term as pt on pt.id = inv.invoice_payment_term_id
left join res_users as u on u.id = inv.invoice_user_id
left join res_partner as up on up.id = u.partner_id
left join product_product as pro on pro.id = invl.product_id
left join product_template as prot on prot.id = pro.product_tmpl_id
$P!{ids}
  and invl.display_type = 'product'
order by invl.sequence, invl.id]]>
	</queryString>
