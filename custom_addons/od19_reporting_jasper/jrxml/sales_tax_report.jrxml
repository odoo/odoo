		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE v.state = 'confirm'"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_MonthYear" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
ROW_NUMBER () OVER (
   ORDER BY tinv.tax_invoice_date, tinv.tax_invoice_number
) as seq,
COALESCE(c.company_name_thai,'') AS company_name_thai,
COALESCE(c.company_name_en,'') AS company_name_en,
COALESCE(c.company_tax_id,'') AS company_tax_id,
COALESCE(c.company_branch,'00000') AS company_branch,
encode(c.company_logo,'escape') AS company_logo,
COALESCE(c.company_address_thai,'') AS company_address_thai,
COALESCE(c.company_address_en,'') AS company_address_en,
COALESCE(c.company_heaer_report,'') AS company_heaer_report,
COALESCE(c.company_footer_report,'') AS company_footer_report,
COALESCE(c.company_phone,'') AS company_phone,
COALESCE(c.company_fax,'') AS company_fax,
COALESCE(c.company_email,'') AS company_email,
COALESCE(c.company_website,'') AS company_website,
tinv.tax_invoice_date as vat_date,
mv.name as doc_no,
tinv.tax_invoice_number as vat_no,
COALESCE(part.tax_name, part.name, '') as name,
at.description as tax_code,
COALESCE(part.branch_code, '') AS branch_code,
tinv.tax_base_amount as amt_untaxed,
tinv.balance as amt_vat,
0::numeric as amt_nonvat,
mv.narration as remark,
tinv.company_id as company_id,
mv.dncn as dncn,
parent.name as parent_number,
parent.ref as parent_reference,
mv.name as move_name,
COALESCE(mv.name, '') as inv_no,
mv.state as inv_status,
mv.amount_total as amount_total
FROM account_move_tax_invoice tinv
JOIN account_tax at on at.id = tinv.tax_line_id
JOIN account_move mv on mv.id = tinv.move_id
LEFT JOIN res_partner part ON part.id = tinv.partner_id
LEFT JOIN account_move parent ON parent.id = mv.parent_id
LEFT JOIN company_address_header_report c ON c.id = tinv.company_id
$P!{p_Where}
ORDER BY tinv.tax_invoice_date, tinv.tax_invoice_number]]>
	</queryString>
