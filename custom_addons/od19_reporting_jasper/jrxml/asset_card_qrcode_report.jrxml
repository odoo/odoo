	<queryString>
		<![CDATA[select 
pt.id as asset_id,
generate_series(1, $P{p_Print}),
pt.name as product_name,pt.code
from account_asset pt

 $P!{p_Where} 
 
 order by pt.id]]>
	</queryString>
