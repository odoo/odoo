	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE asset.state != 'draft'"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_HeaderName" class="java.lang.String">
		<defaultValueExpression><![CDATA["รายงานมูลค่าสินทรัพย์"]]></defaultValueExpression>
