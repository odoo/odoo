		<defaultValueExpression><![CDATA["dd/MM/yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Admin"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["en"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Asset_Category" class="java.lang.String">
		<defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_AtDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["2021-11-30"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
cat.id AS category_id,
COALESCE(cat.name, '') AS category_name,
COALESCE(asset.code, '') AS asset_code,
asset.name AS asset_name,
asset.date_start AS received_date,
asset.purchase_value AS gross_value,
asset.method_number AS method_number,
COALESCE((SELECT SUM(a.amount) FROM account_asset_line a WHERE a.move_check = True and a.asset_id = asset.id and a.line_date <= date($P{p_AtDate} )), 0) AS depreciation_amount,
COALESCE(com.name,'') AS company_name_thai,
COALESCE(com.name,'') AS company_name_en
FROM account_asset asset
LEFT JOIN account_asset_profile cat ON cat.id = asset.profile_id
LEFT JOIN res_company com ON com.id = asset.company_id
$P!{p_Where}]]>
	</queryString>
