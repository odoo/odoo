		<defaultValueExpression><![CDATA["WHERE a.id = 1"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Path" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/home/dtr0048/DTR/Filestores/filestore/v13_Test/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a.code AS asset_code,
a.name AS asset_name,
'' AS asset_class,
ir.store_fname AS store_fname,
'' AS keeper,
aa.code_store ->> a.company_id::text AS account_asset_code,
ad.code_store ->> a.company_id::text AS account_depreciation_code,
'' AS project,
COALESCE(p.complete_name, p.name, '') AS partner,
COALESCE(p.ref, '') AS partner_code,
'' AS brand,
'' AS model,
'' AS inv_no,
a.date_start AS purchase_date,
'' AS serial,
a.purchase_value AS purchase_price,
a.depreciation_base AS cal_val,
a.method AS method,
a.value_depreciated AS accum_depre,
0.00 AS other_expenses,
'' AS insurance_name,
'' AS policy_no,
0.00 AS premium,
0.0 AS warranty_time,
NULL::date AS cover_end,
a.salvage_value AS salvage_value,
(SELECT MIN(ald.line_date) FROM account_asset_line ald WHERE ald.asset_id = a.id) AS depreciation_date
FROM account_asset a
LEFT JOIN account_asset_profile cat ON cat.id = a.profile_id
LEFT JOIN account_account aa ON aa.id = cat.account_asset_id
LEFT JOIN account_account ad ON ad.id = cat.account_depreciation_id
LEFT JOIN res_partner p ON p.id = a.partner_id
LEFT JOIN ir_attachment ir ON ir.res_id = a.id and ir.res_model = 'account.asset'
$P!{p_Where}]]>
	</queryString>
