	<queryString language="SQL">
		<![CDATA[SELECT
ch.name AS cheque_no,
ch.cheque_date AS cheque_date,
COALESCE(b.name,'') AS bank,
ch.amount AS cheque_amount,
ch.state AS state
FROM account_cheque ch
LEFT JOIN res_bank b ON b.id = ch.bank_id
WHERE ch.payment_id = $P!{p_Payment_Id}
ORDER BY ch.name]]>
	</queryString>
	<field name="cheque_no" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="cheque_no"/>
