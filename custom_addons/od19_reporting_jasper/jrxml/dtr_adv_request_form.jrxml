	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (3)"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE req.id in (1,5)"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
req.id AS req_id,
req.name AS doc_no,
req.date AS doc_date,
COALESCE(emp.name, '') AS emp_name,
req.amount AS cash_loans,
COALESCE(cur.currency_unit_label->>'th_TH', cur.currency_unit_label->>'en_US', '') AS label_th,
COALESCE(cur.currency_unit_label->>'en_US', cur.currency_unit_label->>'th_TH', '') AS label_en,
convert_num_th_with_currency(req.amount, req.currency_id) AS amount_total_th_txt,
convert_num_en_with_currency(req.amount, req.currency_id) AS amount_total_en_txt,
COALESCE(req.note, '') AS note,
COALESCE(c.company_name_thai,'') AS company_name_thai,
COALESCE(c.company_name_en,'') AS company_name_en,
COALESCE(c.company_tax_id,'') AS company_tax_id,
COALESCE(c.company_branch,'00000') AS company_branch,
COALESCE(c.company_address_thai,'') AS company_address_thai,
COALESCE(c.company_address_en,'') AS company_address_en,
COALESCE(c.company_heaer_report,'') AS company_heaer_report,
COALESCE(c.company_footer_report,'') AS company_footer_report,
COALESCE(c.company_phone,'') AS company_phone,
COALESCE(c.company_fax,'') AS company_fax,
COALESCE(c.company_email,'') AS company_email,
COALESCE(c.company_website,'') AS company_website
FROM account_advance req
LEFT JOIN account_journal j ON j.id = req.journal_id
LEFT JOIN company_address_header_report c ON c.id = j.company_id
LEFT JOIN res_partner emp ON emp.id = req.partner_id
LEFT JOIN res_currency cur ON cur.id = req.currency_id
$P!{p_Where}]]>
	</queryString>
