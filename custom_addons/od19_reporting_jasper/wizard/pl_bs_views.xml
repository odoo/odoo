<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Profit & Loss / Balance Sheet (งบกำไรขาดทุน / งบแสดงฐานะทางการเงิน).

        Both inherit the shared wizard layout (views/jasper_report_wizard.xml)
        and replace the placeholder <group name="parameters"/> with their own
        fields.  The wizards are reachable from Accounting > Reporting.
    -->
    <record id="view_profit_loss_report" model="ir.ui.view">
        <field name="name">profit.loss.report</field>
        <field name="model">profit.loss.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="rpt_nm" placeholder="Profit and Loss"/>
                        <field name="options" widget="radio" required="1"/>
                        <field name="rpt_month" invisible="options != 'total'"/>
                        <field name="rpt_year" invisible="options != 'total'"/>
                        <field name="period_start" invisible="options != 'period'"/>
                        <field name="period_end" invisible="options != 'period'"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="p_language" required="1"/>
                        <field name="target_move" widget="radio" required="1"/>
                        <field name="show_type" widget="radio" required="1"/>
                        <field name="report_template" required="1"/>
                        <field name="rpt_amt_flag"/>
                    </group>
                    <group colspan="4">
                        <field name="analytic_account_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_balance_sheet_report" model="ir.ui.view">
        <field name="name">balance.sheet.report</field>
        <field name="model">balance.sheet.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="rpt_nm" placeholder="Balance Sheet"/>
                        <field name="rpt_month" required="1"/>
                        <field name="rpt_year" required="1"/>
                        <field name="show_type" widget="radio" required="1"/>
                        <field name="rpt_amt_flag"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="p_language" required="1"/>
                        <field name="target_move" widget="radio" required="1"/>
                        <field name="report_template" required="1"/>
                        <field name="cmp_month" invisible="show_type != 'comp'"/>
                        <field name="cmp_year" invisible="show_type != 'comp'"/>
                    </group>
                    <group colspan="4">
                        <field name="analytic_account_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_profit_loss_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Profit and Loss</field>
        <field name="res_model">profit.loss.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_profit_loss_report"/>
        <field name="target">new</field>
    </record>

    <record id="action_balance_sheet_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Balance Sheet</field>
        <field name="res_model">balance.sheet.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_balance_sheet_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_profit_loss_report"
        name="(J-Report OD15) Profit and Loss"
        parent="account.menu_finance_reports"
        action="action_profit_loss_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="92"
    />
    <menuitem
        id="menu_balance_sheet_report"
        name="(J-Report OD15) Balance Sheet"
        parent="account.menu_finance_reports"
        action="action_balance_sheet_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="93"
    />

    <!--
        Level-3 / Level-4 variants of the financial statement.  The legacy
        ``pl_bs_lvl3`` / ``pl_bs_lvl4`` templates are the same physical report
        (``pl_bs.jrxml``) printed at a fixed depth, so both menus reuse the
        ``pl.bs.report`` model and simply pre-select ``report_template``.
    -->
    <record id="view_pl_bs_report" model="ir.ui.view">
        <field name="name">pl.bs.report</field>
        <field name="model">pl.bs.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="rpt_nm" placeholder="Financial Statement"/>
                        <field name="rpt_month" required="1"/>
                        <field name="rpt_year" required="1"/>
                        <field name="show_type" widget="radio" required="1"/>
                        <field name="rpt_amt_flag"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="p_language" required="1"/>
                        <field name="target_move" widget="radio" required="1"/>
                        <field name="report_template" required="1"/>
                        <field name="cmp_month" invisible="show_type != 'comp'"/>
                        <field name="cmp_year" invisible="show_type != 'comp'"/>
                    </group>
                    <group colspan="4">
                        <field name="analytic_account_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_pl_bs_lvl3" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Financial Statement (Level 3)</field>
        <field name="res_model">pl.bs.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pl_bs_report"/>
        <field name="target">new</field>
        <field name="context">{'default_report_template': 'pl_bs_lvl3'}</field>
    </record>

    <record id="action_pl_bs_lvl4" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Financial Statement (Level 4)</field>
        <field name="res_model">pl.bs.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pl_bs_report"/>
        <field name="target">new</field>
        <field name="context">{'default_report_template': 'pl_bs_lvl4'}</field>
    </record>

    <menuitem
        id="menu_pl_bs_lvl3"
        name="(J-Report OD15) งบการเงิน (ระดับ 3)"
        parent="account.menu_finance_reports"
        action="action_pl_bs_lvl3"
        groups="account.group_account_user,account.group_account_manager"
        sequence="88"
    />
    <menuitem
        id="menu_pl_bs_lvl4"
        name="(J-Report OD15) งบการเงิน (ระดับ 4)"
        parent="account.menu_finance_reports"
        action="action_pl_bs_lvl4"
        groups="account.group_account_user,account.group_account_manager"
        sequence="89"
    />

</odoo>
