<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        F-AC-007 Customer Receipt form (ใบเสร็จรับเงิน).

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the parameters
        this form needs.  Bound to account.payment so it appears in the Print
        menu of a payment.
    -->
    <record id="view_receipt_form" model="ir.ui.view">
        <field name="name">receipt.form</field>
        <field name="model">receipt.form</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language" required="1" default_focus="1"/>
                        <field name="p_Tax" required="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                    </group>
                    <group>
                        <field name="p_EName"/>
                        <field name="p_ESignature"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_receipt_form" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Receipt Form</field>
        <field name="res_model">receipt.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_receipt_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
