<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        R-AC-010 AR/AP Card.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the fields
        this report needs.  The wizard is reachable from the Accounting >
        Reporting menu.
    -->
    <record id="view_ar_ap_card_report" model="ir.ui.view">
        <field name="name">ar.ap.card.report</field>
        <field name="model">ar.ap.card.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="report_name"/>
                        <field name="start_date" required="1"/>
                        <field name="p_As_Date" required="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                        <field name="p_Type" widget="radio" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="account_ids" widget="many2many_tags"/>
                        <field name="customer_ids" widget="many2many_tags"
                               invisible="p_Type != 'ar'"/>
                        <field name="vendor_ids" widget="many2many_tags"
                               invisible="p_Type != 'ap'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_ar_ap_card_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) AR/AP Card</field>
        <field name="res_model">ar.ap.card.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ar_ap_card_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_ar_ap_card_report"
        name="(J-Report OD15) AR/AP Card"
        parent="account.menu_finance_reports"
        action="action_ar_ap_card_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="94"
    />

</odoo>
