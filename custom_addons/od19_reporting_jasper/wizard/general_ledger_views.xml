<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        General Ledger (รายงานบัญชีแยกประเภท).

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the fields
        this report needs.  The wizard is reachable from Accounting > Reporting.
    -->
    <record id="view_general_ledger_report" model="ir.ui.view">
        <field name="name">general.ledger.report</field>
        <field name="model">general.ledger.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_From_Date" required="1"/>
                        <field name="p_To_Date" required="1"/>
                        <field name="p_State" widget="radio" required="1"/>
                        <field name="p_Sort" widget="radio" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_format" required="1"/>
                        <field name="locale" required="1"/>
                        <field name="account_ids" widget="many2many_tags"/>
                        <field name="journal_ids" widget="many2many_tags"/>
                        <field name="analytic_account_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_general_ledger_report" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="res_model">general.ledger.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_general_ledger_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_general_ledger_report"
        name="General Ledger"
        parent="account.menu_finance_reports"
        action="action_general_ledger_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="90"
    />

</odoo>
