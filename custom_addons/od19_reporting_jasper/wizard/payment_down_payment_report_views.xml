<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        R-AC-005 Payment Down Payment.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the fields
        this report needs.  Not bound to a document: reached from the
        Accounting > Reporting menu.
    -->
    <record id="view_payment_down_payment_report" model="ir.ui.view">
        <field name="name">payment.down.payment.report</field>
        <field name="model">payment.down.payment.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language"/>
                        <field name="p_Order_By" required="1"/>
                        <field name="p_Group_By" required="1"/>
                        <field name="p_From_Date" required="1"/>
                        <field name="p_To_Date" required="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="p_Journal" widget="many2many_tags"/>
                        <field name="p_Partner" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_payment_down_payment_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Payment Down Payment</field>
        <field name="res_model">payment.down.payment.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payment_down_payment_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_payment_down_payment_report"
        name="(J-Report OD15) Payment Down Payment"
        parent="account.menu_finance_reports"
        action="action_payment_down_payment_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="102"
    />

</odoo>
