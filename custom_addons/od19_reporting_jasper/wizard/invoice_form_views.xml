<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        F-AC-001 Customer Invoice Form.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the parameters
        this form needs.  Everything else (hidden helper fields, the output
        section and the footer buttons) is reused as-is.
    -->
    <record id="view_invoice_form" model="ir.ui.view">
        <field name="name">invoice.form</field>
        <field name="model">invoice.form</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <field name="p_language" required="1" default_focus="1"/>
                    <field name="date_type" required="1"/>
                    <field name="date_format" required="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_invoice_form" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Customer Invoice Form</field>
        <field name="res_model">invoice.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_invoice_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="context">{'iscopy': 0}</field>
    </record>

    <record id="action_invoice_form_copy" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Customer Invoice Form (Copy)</field>
        <field name="res_model">invoice.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_invoice_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="context">{'iscopy': 1}</field>
    </record>

</odoo>
