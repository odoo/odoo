<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        R-AC-008 Invoice Actual Due Date.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the fields
        this report needs.  The wizard is not bound to a document, so it is
        reachable from the Accounting > Reporting menu.
    -->
    <record id="view_invoice_actual_due_date_report" model="ir.ui.view">
        <field name="name">invoice.actual.due.date.report</field>
        <field name="model">invoice.actual.due.date.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language" required="1"/>
                        <field name="p_Act_Start_Date" required="1"/>
                        <field name="p_Act_End_Date" required="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="p_Order_By" required="1"/>
                        <field name="p_Group_By" required="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_invoice_actual_due_date_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Invoice Actual Due Date</field>
        <field name="res_model">invoice.actual.due.date.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_invoice_actual_due_date_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_invoice_actual_due_date_report"
        name="(J-Report OD15) Invoice Actual Due Date"
        parent="account.menu_finance_reports"
        action="action_invoice_actual_due_date_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="99"
    />

</odoo>
