<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        R-AC-004 Prepayment Condition.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the fields
        this report needs.  Not bound to a document: reached from the
        Accounting > Reporting menu.
    -->
    <record id="view_prepayment_condition_report" model="ir.ui.view">
        <field name="name">prepayment.condition.report</field>
        <field name="model">prepayment.condition.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language"/>
                        <field name="p_Prepayment_Start_Date" required="1"/>
                        <field name="p_Prepayment_End_Date" required="1"/>
                        <field name="p_Act_Start_Date" required="1"/>
                        <field name="p_Act_End_Date" required="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="p_Vendor" widget="many2many_tags"/>
                        <field name="p_Payment_Method" widget="many2many_tags"/>
                        <field name="p_Currency" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_prepayment_condition_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Prepayment Condition</field>
        <field name="res_model">prepayment.condition.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_prepayment_condition_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_prepayment_condition_report"
        name="(J-Report OD15) Prepayment Condition"
        parent="account.menu_finance_reports"
        action="action_prepayment_condition_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="101"
    />

</odoo>
