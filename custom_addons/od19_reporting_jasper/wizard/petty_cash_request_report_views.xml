<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        R-PC-001 Petty Cash Request.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the fields
        this report needs.  The wizard is reachable from the Accounting >
        Reporting menu.
    -->
    <record id="view_petty_cash_request_report" model="ir.ui.view">
        <field name="name">petty.cash.request.report</field>
        <field name="model">petty.cash.request.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language" required="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_petty_cash_request_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Petty Cash Request Report</field>
        <field name="res_model">petty.cash.request.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_petty_cash_request_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_petty_cash_request_report"
        name="(J-Report OD15) Petty Cash Request Report"
        parent="account.menu_finance_reports"
        action="action_petty_cash_request_report"
        groups="account.group_account_user,account.group_account_manager"
        sequence="112"
    />

</odoo>
