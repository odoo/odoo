<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        F-AC-004 Journal Voucher / WHT form.

        Inherits the shared wizard layout (views/jasper_report_wizard.xml) and
        replaces the placeholder <group name="parameters"/> with the parameters
        this form needs.  It is bound to account.move, so it appears in the
        Print menu of a Journal Entry / Invoice.
    -->
    <record id="view_journal_voucher_form" model="ir.ui.view">
        <field name="name">journal.voucher.form</field>
        <field name="model">journal.voucher.form</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language" required="1" default_focus="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                    </group>
                    <group>
                        <field name="p_EName"/>
                        <field name="p_ESignature"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_journal_voucher_form" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Journal Voucher Form</field>
        <field name="res_model">journal.voucher.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_journal_voucher_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
