<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_petty_cash_transaction_list" model="ir.ui.view">
        <field name="name">petty.cash.transaction.list</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Transactions">
                <field name="date"/>
                <field name="fund_id"/>
                <field name="name"/>
                <field name="transaction_type"/>
                <field name="amount" sum="Total"/>
                <field name="od19_document_type" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_transaction_form" model="ir.ui.view">
        <field name="name">petty.cash.transaction.form</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Transaction">
                <header>
                    <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            invisible="state != 'posted'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'posted'"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <button name="%(action_report_payment_certificate)d" type="action"
                            string="พิมพ์ใบรับรองแทนใบเสร็จ"
                            invisible="od19_document_type != 'payment_certificate'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fund_id"/>
                            <field name="transaction_type"/>
                            <field name="expense_account_id" invisible="transaction_type != 'expense'"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                    <group string="เอกสารประกอบ / Document">
                        <group>
                            <field name="od19_document_type"/>
                            <field name="od19_certificate_number"
                                   invisible="od19_document_type != 'payment_certificate'"/>
                            <field name="od19_payee_name"
                                   invisible="od19_document_type != 'payment_certificate'"/>
                        </group>
                        <group>
                            <field name="od19_vat_creditable"/>
                        </group>
                    </group>
                    <group>
                        <field name="move_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_petty_cash_transaction_search" model="ir.ui.view">
        <field name="name">petty.cash.transaction.search</field>
        <field name="model">petty.cash.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Petty Cash Transactions">
                <field name="name"/>
                <field name="fund_id"/>
                <filter string="Expense" name="expense" domain="[('transaction_type', '=', 'expense')]"/>
                <filter string="Replenishment" name="replenishment" domain="[('transaction_type', '=', 'replenishment')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_transaction" model="ir.actions.act_window">
        <field name="name">Petty Cash Transactions</field>
        <field name="res_model">petty.cash.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_petty_cash_root"
        name="Petty Cash"
        parent="account.menu_finance"
        sequence="13"
    />

    <menuitem
        id="menu_petty_cash_fund"
        name="Funds"
        parent="menu_petty_cash_root"
        action="action_petty_cash_fund"
        sequence="10"
    />

    <menuitem
        id="menu_petty_cash_transaction"
        name="Transactions"
        parent="menu_petty_cash_root"
        action="action_petty_cash_transaction"
        sequence="20"
    />

</odoo>
