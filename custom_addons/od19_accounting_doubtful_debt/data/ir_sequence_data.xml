<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_od19_doubtful_debt_provision" model="ir.sequence">
            <field name="name">Doubtful Debt Provision Sequence</field>
            <field name="code">od19.doubtful.debt.provision</field>
            <field name="prefix">DDP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_od19_doubtful_debt_writeoff" model="ir.sequence">
            <field name="name">Bad Debt Write-off Sequence</field>
            <field name="code">od19.doubtful.debt.writeoff</field>
            <field name="prefix">DDW/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
