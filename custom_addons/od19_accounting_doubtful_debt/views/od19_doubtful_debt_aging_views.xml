<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_doubtful_debt_aging_list" model="ir.ui.view">
        <field name="name">od19.doubtful.debt.aging.line.list</field>
        <field name="model">od19.doubtful.debt.aging.line</field>
        <field name="arch" type="xml">
            <list string="Doubtful Debt Aging Buckets" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="from_days"/>
                <field name="to_days"/>
                <field name="provision_rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_od19_doubtful_debt_aging_form" model="ir.ui.view">
        <field name="name">od19.doubtful.debt.aging.line.form</field>
        <field name="model">od19.doubtful.debt.aging.line</field>
        <field name="arch" type="xml">
            <form string="Aging Bucket">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="from_days"/>
                            <field name="to_days"/>
                            <field name="provision_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_od19_doubtful_debt_aging" model="ir.actions.act_window">
        <field name="name">ช่วงอายุหนี้ (Aging Buckets)</field>
        <field name="res_model">od19.doubtful.debt.aging.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                กำหนดช่วงอายุหนี้และอัตราการตั้งค่าเผื่อหนี้สงสัยจะสูญ
            </p>
        </field>
    </record>
</odoo>
