<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_od19_credit_hold" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.od19.credit.hold</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Customer Credit Aging Hold"
                       id="od19_credit_aging_hold_settings">
                    <setting string="Automatic credit hold on overdue receivables"
                             help="Customers with approved credit are automatically placed on hold when their oldest overdue invoice or their total overdue amount exceeds the tolerance below. A customer on hold cannot be sold to on credit terms until the debt is settled.">
                        <field name="od19_credit_hold_enabled"/>
                        <div class="content-group mt16"
                             invisible="not od19_credit_hold_enabled">
                            <div class="row mt16">
                                <label for="od19_credit_hold_max_overdue_days"
                                       class="col-lg-3 o_light_label"/>
                                <field name="od19_credit_hold_max_overdue_days"/>
                            </div>
                            <div class="row">
                                <label for="od19_credit_hold_max_overdue_amount"
                                       class="col-lg-3 o_light_label"/>
                                <field name="od19_credit_hold_max_overdue_amount"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
