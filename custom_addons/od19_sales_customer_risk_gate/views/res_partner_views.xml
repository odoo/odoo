<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_od19_credit_gate" model="ir.ui.view">
        <field name="name">res.partner.form.od19.credit.gate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <widget name="web_ribbon"
                        title="Blacklisted"
                        bg_color="text-bg-danger"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer,base.group_partner_manager"
                        invisible="od19_blacklist_status != 'blacklisted'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_od19_request_credit"
                        type="object"
                        string="Request Credit"
                        class="btn-primary"
                        groups="base.group_user"
                        invisible="od19_credit_request_state in ('pending', 'approved')"/>
                <button name="action_od19_approve_credit"
                        type="object"
                        string="Approve Credit"
                        class="btn-success"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"
                        invisible="od19_credit_request_state != 'pending'"/>
                <button name="action_od19_reject_credit"
                        type="object"
                        string="Reject Credit"
                        class="btn-danger"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"
                        invisible="od19_credit_request_state != 'pending'"/>
                <button name="action_od19_set_blacklist"
                        type="object"
                        string="Blacklist"
                        class="btn-danger"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"
                        invisible="od19_blacklist_status == 'blacklisted'"/>
                <button name="action_od19_clear_blacklist"
                        type="object"
                        string="Clear Blacklist"
                        class="btn-secondary"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"
                        invisible="od19_blacklist_status != 'blacklisted'"/>
                <button name="action_od19_recheck_credit_aging"
                        type="object"
                        string="Re-check Aging"
                        class="btn-secondary"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer,base.group_partner_manager"/>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Credit &amp; Risk" name="od19_credit_risk">
                    <group>
                        <group string="Credit">
                            <field name="od19_credit_request_state"/>
                            <field name="od19_credit_sale_allowed"/>
                            <field name="od19_credit_limit_amount"/>
                            <field name="od19_credit_used_amount" readonly="1"/>
                            <field name="od19_credit_available" readonly="1"/>
                            <field name="od19_credit_expiry_date"/>
                            <field name="od19_credit_requested_by"/>
                            <field name="od19_credit_request_date"/>
                            <field name="od19_credit_review_owner_id"/>
                            <field name="od19_credit_review_date"/>
                            <field name="od19_credit_review_note"
                                   groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"/>
                        </group>
                        <group string="Aging Hold">
                            <field name="od19_credit_aging_hold_enabled"/>
                            <field name="od19_credit_on_hold"/>
                            <field name="od19_credit_hold_reason"/>
                            <field name="od19_credit_overdue_amount" readonly="1"/>
                            <field name="od19_credit_oldest_overdue_days" readonly="1"/>
                            <field name="od19_credit_rolling_limit" readonly="1"/>
                        </group>
                        <group string="Blacklist">
                            <field name="od19_blacklist_status"
                                   groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"/>
                            <field name="od19_blacklist_reason"
                                   groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_od19_risk_gate" model="ir.ui.view">
        <field name="name">res.partner.search.od19.risk.gate</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter string="Blacklisted" name="od19_blacklisted"
                        groups="od19_sales_customer_risk_gate.group_od19_credit_reviewer,base.group_partner_manager"
                        domain="[('od19_blacklist_status','=','blacklisted')]"/>
            </xpath>
        </field>
    </record>
</odoo>
