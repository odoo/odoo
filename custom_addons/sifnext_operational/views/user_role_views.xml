<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SIFNEXT Active Role pada My Preferences -->
    <record id="view_users_form_sifnext_role_preferences" model="ir.ui.view">
        <field name="name">res.users.preferences.sifnext.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="sifnext_active_role"/>
            </xpath>

        </field>
    </record>

    <!-- SIFNEXT Active Role pada form User di Settings -->
    <record id="view_users_form_sifnext_role" model="ir.ui.view">
        <field name="name">res.users.form.sifnext.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="sifnext_active_role"/>
            </xpath>

        </field>
    </record>

</odoo>