<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- LIST VIEW -->
    <!-- ========================================================= -->

    <record id="view_sifnext_vehicle_booking_list" model="ir.ui.view">

        <field name="name">sifnext.operational.vehicle.booking.list</field>
        <field name="model">sifnext.operational.vehicle.booking</field>

        <field name="arch" type="xml">

            <list string="Peminjaman Kendaraan"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">

                <field name="name"/>
                <field name="applicant_id"/>
                <field name="vehicle_id"/>
                <field name="destination"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="availability"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- FORM VIEW -->
    <!-- ========================================================= -->

    <record id="view_sifnext_vehicle_booking_form" model="ir.ui.view">

        <field name="name">sifnext.operational.vehicle.booking.form</field>
        <field name="model">sifnext.operational.vehicle.booking</field>

        <field name="arch" type="xml">

            <form string="Peminjaman Kendaraan">

                <!-- ================================================= -->
                <!-- HEADER / WORKFLOW BUTTONS -->
                <!-- ================================================= -->

                <header>

                    <!-- Active role user -->
                    <field name="sifnext_active_role" invisible="1"/>


                    <!-- ============================================= -->
                    <!-- USER : AJUKAN -->
                    <!-- ============================================= -->

                    <button name="action_submit"
                            string="Ajukan Peminjaman"
                            type="object"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="state != 'draft'"/>


                    <!-- ============================================= -->
                    <!-- SYSTEM : CEK KETERSEDIAAN -->
                    <!-- ============================================= -->

                    <button name="action_check_availability"
                            string="Cek Ketersediaan"
                            type="object"
                            class="btn-secondary"
                            icon="fa-search"
                            invisible="state != 'submitted'"/>


                    <!-- ============================================= -->
                    <!-- GA : APPROVAL -->
                    <!-- ============================================= -->

                    <button name="action_approve"
                            string="Setujui"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"
                            invisible="state != 'waiting_approval' or sifnext_active_role != 'ga'"/>

                    <button name="action_reject"
                            string="Tolak"
                            type="object"
                            class="btn-secondary"
                            icon="fa-times"
                            invisible="state != 'waiting_approval' or sifnext_active_role != 'ga'"/>


                    <!-- ============================================= -->
                    <!-- BOOKING -->
                    <!-- ============================================= -->

                    <button name="action_book"
                            string="Booking Jadwal"
                            type="object"
                            class="btn-primary"
                            icon="fa-calendar-check-o"
                            invisible="state != 'approved'"/>


                    <!-- ============================================= -->
                    <!-- DONE -->
                    <!-- ============================================= -->

                    <button name="action_done"
                            string="Tandai Selesai"
                            type="object"
                            class="btn-primary"
                            icon="fa-check-circle"
                            invisible="state != 'booked'"/>


                    <!-- ============================================= -->
                    <!-- CANCEL -->
                    <!-- ============================================= -->

                    <button name="action_cancel"
                            string="Batalkan"
                            type="object"
                            class="btn-secondary"
                            icon="fa-ban"
                            invisible="state in ('done', 'cancelled')"/>


                    <!-- ============================================= -->
                    <!-- RESET -->
                    <!-- ============================================= -->

                    <button name="action_reset_draft"
                            string="Kembalikan ke Draft"
                            type="object"
                            class="btn-secondary"
                            icon="fa-undo"
                            invisible="state != 'cancelled'"/>


                    <!-- ============================================= -->
                    <!-- STATUS BAR -->
                    <!-- ============================================= -->

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,waiting_approval,approved,booked,done"/>

                </header>


                <!-- ================================================= -->
                <!-- SHEET -->
                <!-- ================================================= -->

                <sheet>

                    <!-- ================================================= -->
                    <!-- TITLE -->
                    <!-- ================================================= -->

                    <div class="oe_title">

                        <span class="text-muted">
                            PEMINJAMAN KENDARAAN DINAS
                        </span>

                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>

                    </div>


                    <!-- ================================================= -->
                    <!-- WAITING APPROVAL ALERT -->
                    <!-- ================================================= -->

                    <div class="alert alert-warning sifnext-alert"
                         role="alert"
                         invisible="state != 'waiting_approval'">

                        <strong>Menunggu Approval GA</strong>

                        <br/>

                        Pengajuan sedang menunggu persetujuan
                        General Affair.

                    </div>


                    <!-- ================================================= -->
                    <!-- AVAILABLE ALERT -->
                    <!-- ================================================= -->

                    <div class="alert alert-success sifnext-alert"
                         role="alert"
                         invisible="availability != 'available'">

                        <strong>✓ Kendaraan Tersedia</strong>

                        <br/>

                        Kendaraan tersedia pada jadwal yang dipilih.

                    </div>


                    <!-- ================================================= -->
                    <!-- UNAVAILABLE ALERT -->
                    <!-- ================================================= -->

                    <div class="alert alert-danger sifnext-alert"
                         role="alert"
                         invisible="availability != 'unavailable'">

                        <strong>✕ Kendaraan Tidak Tersedia</strong>

                        <br/>

                        Silakan pilih kendaraan atau jadwal yang berbeda.

                    </div>


                    <!-- ================================================= -->
                    <!-- INFORMASI PENGAJUAN -->
                    <!-- ================================================= -->

                    <group>

                        <group string="Informasi Pengajuan">

                            <field name="applicant_id"/>

                            <field name="vehicle_id"
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>

                            <field name="passenger_count"
                                   readonly="state != 'draft'"/>

                            <field name="destination"
                                   placeholder="Contoh: Surabaya - Gresik"
                                   readonly="state != 'draft'"/>

                            <field name="purpose"
                                   placeholder="Contoh: Kunjungan kerja..."
                                   readonly="state != 'draft'"/>

                        </group>


                        <!-- ================================================= -->
                        <!-- JADWAL PERJALANAN -->
                        <!-- ================================================= -->

                        <group string="Jadwal Perjalanan">

                            <field name="start_datetime"
                                   readonly="state != 'draft'"/>

                            <field name="end_datetime"
                                   readonly="state != 'draft'"/>

                            <field name="availability"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ================================================= -->
                    <!-- CATATAN APPROVAL -->
                    <!-- ================================================= -->

                    <separator string="Catatan Approval"/>

                    <group>

                        <field name="rejection_reason"
                               placeholder="Isi alasan jika pengajuan ditolak..."
                               invisible="state not in ('waiting_approval', 'rejected')"/>

                    </group>


                    <!-- ================================================= -->
                    <!-- FLOW -->
                    <!-- ================================================= -->

                    <div class="sifnext-hint">

                        <strong>Alur Peminjaman</strong>

                        <div class="sifnext-flow">

                            <span class="sifnext-flow-item">
                                1. Ajukan
                            </span>

                            <span>
                                →
                            </span>

                            <span class="sifnext-flow-item">
                                2. Cek
                            </span>

                            <span>
                                →
                            </span>

                            <span class="sifnext-flow-item">
                                3. Approval GA
                            </span>

                            <span>
                                →
                            </span>

                            <span class="sifnext-flow-item">
                                4. Booking
                            </span>

                        </div>

                    </div>

                </sheet>


                <!-- ================================================= -->
                <!-- CHATTER -->
                <!-- ================================================= -->

                <chatter/>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- ACTION PEMINJAMAN KENDARAAN -->
    <!-- ========================================================= -->

    <record id="action_sifnext_vehicle_booking"
            model="ir.actions.act_window">

        <field name="name">Peminjaman Kendaraan</field>

        <field name="res_model">sifnext.operational.vehicle.booking</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ========================================================= -->
    <!-- MENU PENGAJUAN KENDARAAN -->
    <!-- ========================================================= -->

    <menuitem id="menu_sifnext_vehicle_booking"
              name="Pengajuan Kendaraan"
              parent="menu_sifnext_vehicle"
              action="action_sifnext_vehicle_booking"
              sequence="10"/>


    <!-- ========================================================= -->
    <!-- CALENDAR VIEW PEMINJAMAN KENDARAAN -->
    <!-- ========================================================= -->

    <record id="view_vehicle_booking_calendar"
            model="ir.ui.view">

        <field name="name">sifnext.operational.vehicle.booking.calendar</field>

        <field name="model">sifnext.operational.vehicle.booking</field>

        <field name="arch" type="xml">

            <calendar
                string="Jadwal Peminjaman Kendaraan"
                date_start="start_datetime"
                date_stop="end_datetime"
                color="vehicle_id"
                mode="month">

                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="applicant_id"/>
                <field name="destination"/>
                <field name="purpose"/>
                <field name="state"/>

            </calendar>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- ACTION JADWAL KENDARAAN -->
    <!-- ========================================================= -->

    <record id="action_vehicle_booking_calendar"
            model="ir.actions.act_window">

        <field name="name">Jadwal Peminjaman Kendaraan</field>

        <field name="res_model">sifnext.operational.vehicle.booking</field>

        <field name="view_mode">calendar,list,form</field>

        <field name="view_id"
               ref="view_vehicle_booking_calendar"/>

        <field name="domain">
            [('state', 'in', ['waiting_approval', 'approved', 'booked'])]
        </field>

    </record>


    <!-- ========================================================= -->
    <!-- MENU JADWAL KENDARAAN -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_vehicle_booking_calendar"
        name="Jadwal Peminjaman"
        parent="menu_sifnext_vehicle"
        action="action_vehicle_booking_calendar"
        sequence="20"
    />

</odoo>