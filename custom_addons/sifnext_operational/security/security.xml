<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_sifnext_operational"
            model="ir.module.category">
        <field name="name">SIFNEXT Operational</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_privilege_sifnext_operational"
            model="res.groups.privilege">
        <field name="name">SIFNEXT Operational</field>
        <field name="sequence">10</field>
        <field name="category_id"
               ref="sifnext_operational.module_category_sifnext_operational"/>
    </record>

    <!-- USER -->
    <record id="group_sifnext_operational_user"
            model="res.groups">
        <field name="name">SIFNEXT Operational User</field>
        <field name="sequence">10</field>
        <field name="privilege_id"
               ref="sifnext_operational.group_privilege_sifnext_operational"/>
    </record>

    <!-- GENERAL AFFAIR -->
    <record id="group_sifnext_operational_ga"
            model="res.groups">
        <field name="name">SIFNEXT Operational GA</field>
        <field name="sequence">20</field>
        <field name="privilege_id"
               ref="sifnext_operational.group_privilege_sifnext_operational"/>
        <field name="implied_ids"
               eval="[(4, ref('sifnext_operational.group_sifnext_operational_user'))]"/>
    </record>

    <!-- MANAGER -->
    <record id="group_sifnext_operational_manager"
            model="res.groups">
        <field name="name">SIFNEXT Operational Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id"
               ref="sifnext_operational.group_privilege_sifnext_operational"/>
        <field name="implied_ids"
               eval="[(4, ref('sifnext_operational.group_sifnext_operational_user'))]"/>
    </record>

</odoo>