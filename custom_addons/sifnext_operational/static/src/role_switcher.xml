<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="sifnext_operational.RoleSwitcher">

        <Dropdown>

            <button
                class="btn btn-secondary"
                title="Switch Role"
            >
                <i class="fa fa-user me-1"/>
                Switch Role
                <i class="fa fa-caret-down ms-1"/>
            </button>

            <t t-set-slot="content">

                <DropdownItem
                    onSelected="() => this.switchRole('user')"
                >
                    <i class="fa fa-user me-2"/>
                    Operational User
                </DropdownItem>

                <DropdownItem
                    onSelected="() => this.switchRole('ga')"
                >
                    <i class="fa fa-check-circle me-2"/>
                    General Affair
                </DropdownItem>

            </t>

        </Dropdown>

    </t>

</templates>