<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Privilege ===================== -->
    <!-- Named "Dashboard Builder" to stay distinct from the core
         "Dashboard" privilege (spreadsheet_dashboard) in Access Rights. -->
    <record id="res_groups_privilege_od19_dashboard" model="res.groups.privilege">
        <field name="name">Dashboard Builder</field>
        <field name="category_id" ref="base.module_category_productivity"/>
        <field name="sequence">80</field>
    </record>

    <!-- ===================== Groups ===================== -->
    <record id="group_od19_dashboard_user" model="res.groups">
        <field name="name">Dashboard Designer</field>
        <field name="comment">Design, customise and share personal dashboards with the in-browser builder.</field>
        <field name="privilege_id" ref="res_groups_privilege_od19_dashboard"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_od19_dashboard_manager" model="res.groups">
        <field name="name">Dashboard Manager</field>
        <field name="comment">Manage every shared dashboard and maintain the dashboard data sources.</field>
        <field name="privilege_id" ref="res_groups_privilege_od19_dashboard"/>
        <field name="implied_ids" eval="[Command.link(ref('group_od19_dashboard_user'))]"/>
    </record>

    <!-- System administrators inherit the manager role so the builder is
         usable out of the box; business roles are granted per user. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_od19_dashboard_manager'))]"/>
    </record>

    <!-- ===================== Record rules: dashboard ===================== -->
    <!-- Everybody sees the shared dashboards and the ones they own. -->
    <record id="rule_od19_dashboard_read" model="ir.rule">
        <field name="name">Dashboard: read shared or own</field>
        <field name="model_id" ref="model_od19_dashboard"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), '&amp;', ('shared', '=', True), '|', '&amp;', ('group_ids', '=', False), ('user_ids', '=', False), '|', ('group_ids', 'in', user.group_ids.ids), ('user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A designer only edits the dashboards they own. -->
    <record id="rule_od19_dashboard_write" model="ir.rule">
        <field name="name">Dashboard: edit own</field>
        <field name="model_id" ref="model_od19_dashboard"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Managers are not restricted (combined with OR). -->
    <record id="rule_od19_dashboard_manager" model="ir.rule">
        <field name="name">Dashboard: manager full access</field>
        <field name="model_id" ref="model_od19_dashboard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===================== Record rules: widget ===================== -->
    <record id="rule_od19_dashboard_widget_read" model="ir.rule">
        <field name="name">Dashboard widget: read from visible dashboard</field>
        <field name="model_id" ref="model_od19_dashboard_widget"/>
        <field name="domain_force">['|', ('dashboard_id.owner_id', '=', user.id), '&amp;', ('dashboard_id.shared', '=', True), '|', '&amp;', ('dashboard_id.group_ids', '=', False), ('dashboard_id.user_ids', '=', False), '|', ('dashboard_id.group_ids', 'in', user.group_ids.ids), ('dashboard_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_od19_dashboard_widget_write" model="ir.rule">
        <field name="name">Dashboard widget: edit on own dashboard</field>
        <field name="model_id" ref="model_od19_dashboard_widget"/>
        <field name="domain_force">[('dashboard_id.owner_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_od19_dashboard_widget_manager" model="ir.rule">
        <field name="name">Dashboard widget: manager full access</field>
        <field name="model_id" ref="model_od19_dashboard_widget"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===================== Record rules: widget status rule ===================== -->
    <record id="rule_od19_dashboard_widget_rule_read" model="ir.rule">
        <field name="name">Dashboard widget rule: read from visible dashboard</field>
        <field name="model_id" ref="model_od19_dashboard_widget_rule"/>
        <field name="domain_force">['|', ('widget_id.dashboard_id.owner_id', '=', user.id), '&amp;', ('widget_id.dashboard_id.shared', '=', True), '|', '&amp;', ('widget_id.dashboard_id.group_ids', '=', False), ('widget_id.dashboard_id.user_ids', '=', False), '|', ('widget_id.dashboard_id.group_ids', 'in', user.group_ids.ids), ('widget_id.dashboard_id.user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_od19_dashboard_widget_rule_write" model="ir.rule">
        <field name="name">Dashboard widget rule: edit on own dashboard</field>
        <field name="model_id" ref="model_od19_dashboard_widget_rule"/>
        <field name="domain_force">[('widget_id.dashboard_id.owner_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_od19_dashboard_widget_rule_manager" model="ir.rule">
        <field name="name">Dashboard widget rule: manager full access</field>
        <field name="model_id" ref="model_od19_dashboard_widget_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ===================== Record rules: named formula ===================== -->
    <!-- A named formula is shared across the company that owns it. -->
    <record id="rule_od19_dashboard_formula_read" model="ir.rule">
        <field name="name">Dashboard formula: read own company</field>
        <field name="model_id" ref="model_od19_dashboard_formula"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_od19_dashboard_formula_write" model="ir.rule">
        <field name="name">Dashboard formula: designer edit own company</field>
        <field name="model_id" ref="model_od19_dashboard_formula"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_od19_dashboard_formula_manager" model="ir.rule">
        <field name="name">Dashboard formula: manager full access</field>
        <field name="model_id" ref="model_od19_dashboard_formula"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_od19_dashboard_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
