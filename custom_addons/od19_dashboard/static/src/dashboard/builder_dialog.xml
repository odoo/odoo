<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="od19_dashboard.BuilderDialog">
        <div class="modal d-block od19-builder" role="dialog" t-on-click.self="props.onClose">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-sliders me-2"/>
                            <t t-esc="dialogTitle"/>
                        </h5>
                        <button type="button" class="btn-close" title="Close" aria-label="Close"
                                t-on-click="props.onClose"/>
                    </div>

                    <div class="modal-body">
                        <div class="alert alert-danger" role="alert" t-if="state.error" t-esc="state.error"/>

                        <div class="row g-4">
                            <div class="col-lg-8">

                        <!-- ===================== Identity ===================== -->
                        <h6 class="od19-builder__section">Content</h6>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label" for="od19_widget_name">Title</label>
                                <input id="od19_widget_name" type="text" class="form-control"
                                       placeholder="e.g. Revenue this month"
                                       t-model="state.draft.name"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="od19_widget_format">Value format</label>
                                <select id="od19_widget_format" class="form-select"
                                        t-model="state.draft.value_format">
                                    <option t-foreach="valueFormats" t-as="format" t-key="format.key"
                                            t-att-value="format.key">
                                        <t t-esc="format.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label" for="od19_widget_subtitle">Subtitle</label>
                                <input id="od19_widget_subtitle" type="text" class="form-control"
                                       placeholder="Optional caption"
                                       t-model="state.draft.subtitle"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="od19_widget_color">Accent colour</label>
                                <input id="od19_widget_color" type="text" class="form-control"
                                       placeholder="Default"
                                       t-model="state.draft.color"/>
                            </div>
                        </div>

                        <!-- ===================== Data ===================== -->
                        <h6 class="od19-builder__section">Data</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_type">Widget type</label>
                                <select id="od19_widget_type" class="form-select"
                                        t-model="state.draft.widget_type"
                                        t-on-change="onTypeChange">
                                    <option t-foreach="widgetTypes" t-as="type" t-key="type.key"
                                            t-att-value="type.key">
                                        <t t-esc="type.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_source">Data source</label>
                                <select id="od19_widget_source" class="form-select"
                                        t-model.number="state.draft.source_id"
                                        t-on-change="onSourceChange">
                                    <option t-att-value="0">— Select a source —</option>
                                    <option t-foreach="sources" t-as="source" t-key="source.id"
                                            t-att-value="source.id">
                                        <t t-esc="source.name"/>
                                    </option>
                                </select>
                                <small class="text-muted" t-if="sourceHint">
                                    <i class="fa fa-database me-1"/><t t-esc="sourceHint"/>
                                </small>
                            </div>
                            <div class="col-md-6" t-if="isFormula">
                                <label class="form-label" for="od19_widget_formula_mode">Formula</label>
                                <select id="od19_widget_formula_mode" class="form-select"
                                        t-model="state.draft.formula_mode"
                                        t-on-change="onFormulaModeChange">
                                    <option t-foreach="formulaModes" t-as="mode" t-key="mode.key"
                                            t-att-value="mode.key">
                                        <t t-esc="mode.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6" t-if="isFormula">
                                <label class="form-label" for="od19_widget_formula_basis">
                                    Period used by the formula
                                </label>
                                <select id="od19_widget_formula_basis" class="form-select"
                                        t-model="state.draft.formula_basis"
                                        t-on-change="onFormulaChange">
                                    <option t-foreach="periodBases" t-as="basis" t-key="basis.key"
                                            t-att-value="basis.key">
                                        <t t-esc="basis.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6" t-if="isPresetFormula">
                                <label class="form-label" for="od19_widget_formula_type">Preset</label>
                                <select id="od19_widget_formula_type" class="form-select"
                                        t-model="state.draft.formula_type"
                                        t-on-change="onFormulaTypeChange">
                                    <option t-att-value="null">— Select a formula —</option>
                                    <option t-foreach="formulaTypes" t-as="formula" t-key="formula.key"
                                            t-att-value="formula.key">
                                        <t t-esc="formula.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-12" t-if="isPresetFormula and selectedFormula">
                                <div class="od19-slots">
                                    <div class="od19-slots__row" t-foreach="slotRows" t-as="slot" t-key="slot.key">
                                        <label class="od19-slots__label" t-att-for="'od19_slot_' + slot.key">
                                            <t t-esc="slot.label"/>
                                        </label>
                                        <select t-if="!slot.is_weight"
                                                t-att-id="'od19_slot_' + slot.key"
                                                class="form-select form-select-sm"
                                                t-att-value="slot.value"
                                                t-on-change="(ev) => this.setSlot(slot.key, ev.target.value)">
                                            <option t-att-value="">— Select a measure —</option>
                                            <option t-foreach="measures" t-as="measure" t-key="measure.key"
                                                    t-att-value="measure.key">
                                                <t t-esc="measure.label"/>
                                            </option>
                                        </select>
                                        <input t-else="" type="number" step="any" min="0"
                                               t-att-id="'od19_slot_' + slot.key"
                                               class="form-control form-control-sm"
                                               t-att-value="slot.value"
                                               t-on-change="(ev) => this.setSlot(slot.key, ev.target.value)"/>
                                    </div>
                                    <button type="button" class="btn btn-link btn-sm p-0" t-if="canAddSlot"
                                            t-on-click="addSlot">
                                        <i class="fa fa-plus me-1"/>Add a slot
                                    </button>
                                    <small class="text-muted d-block" t-if="selectedFormula.expression">
                                        Expression: <code t-esc="selectedFormula.expression"/>
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6" t-if="isLibraryFormula">
                                <label class="form-label" for="od19_widget_formula_id">
                                    Formula library
                                </label>
                                <select id="od19_widget_formula_id" class="form-select"
                                        t-model.number="state.draft.formula_id"
                                        t-on-change="onFormulaSelect">
                                    <option t-att-value="0">— Select a formula —</option>
                                    <option t-foreach="formulaLibrary" t-as="formula" t-key="formula.id"
                                            t-att-value="formula.id">
                                        <t t-esc="formula.name"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-12" t-if="isLibraryFormula and selectedLibraryFormula">
                                <small class="text-muted d-block" t-if="selectedLibraryFormula.description"
                                       t-esc="selectedLibraryFormula.description"/>
                                <small class="text-muted">
                                    Expression: <code t-esc="selectedLibraryFormula.expression"/>
                                    <t t-if="selectedLibraryFormula.names and selectedLibraryFormula.names.length">
                                        · Names: <code t-esc="selectedLibraryFormula.names.join(', ')"/>
                                    </t>
                                </small>
                            </div>
                            <div class="col-12" t-if="isLibraryFormula and !formulaLibrary.length">
                                <p class="text-muted mb-0">
                                    The formula library is empty. Ask an administrator to add a
                                    reusable formula.
                                </p>
                            </div>
                            <div class="col-12" t-if="isCustomFormula">
                                <label class="form-label" for="od19_widget_expression">Expression</label>
                                <textarea id="od19_widget_expression" rows="2" class="form-control"
                                          placeholder="a / b * 100"
                                          t-model="state.draft.formula_expression"
                                          t-on-input="onFormulaChange"/>
                                <div class="od19-slots__names">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            t-foreach="insertableNames" t-as="name" t-key="name"
                                            t-on-click="() => this.insertName(name)">
                                        <t t-esc="name"/>
                                    </button>
                                </div>
                                <small class="text-muted">
                                    Allowed: <code>+ - * / % **</code>, comparisons,
                                    <code>and</code> / <code>or</code>, <code>min</code>,
                                    <code>max</code>, <code>abs</code>, <code>round</code>.
                                </small>
                            </div>
                            <div class="col-md-6" t-if="!isFormula">
                                <label class="form-label" for="od19_widget_measure">Measure</label>
                                <select id="od19_widget_measure" class="form-select"
                                        t-model="state.draft.measure_key"
                                        t-on-change="onFormulaChange">
                                    <option t-foreach="measures" t-as="measure" t-key="measure.key"
                                            t-att-value="measure.key">
                                        <t t-esc="measure.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6" t-if="isChart">
                                <label class="form-label" for="od19_widget_groupby">Group by</label>
                                <select id="od19_widget_groupby" class="form-select"
                                        t-model="state.draft.groupby_key">
                                    <option t-att-value="">— Select a field —</option>
                                    <option t-foreach="groupbys" t-as="groupby" t-key="groupby.key"
                                            t-att-value="groupby.key">
                                        <t t-esc="groupby.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_date">Period field</label>
                                <select id="od19_widget_date" class="form-select"
                                        t-model="state.draft.date_key">
                                    <option t-att-value="">— No period filter —</option>
                                    <option t-foreach="dates" t-as="date" t-key="date.key"
                                            t-att-value="date.key">
                                        <t t-esc="date.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_range">Default period</label>
                                <select id="od19_widget_range" class="form-select"
                                        t-model="state.draft.date_range">
                                    <option t-foreach="dateRanges" t-as="range" t-key="range.key"
                                            t-att-value="range.key">
                                        <t t-esc="range.label"/>
                                    </option>
                                </select>
                                <p class="text-muted small mb-0 mt-1"
                                   t-if="state.draft.date_range === 'overdue'">
                                    Overdue reads every record dated up to yesterday and sets no start
                                    bound. Pair it with a status or due-date condition in the filter
                                    (for example invoices not paid, or deliveries not done) so the
                                    figure really means "still open and late".
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_limit">
                                    <t t-if="state.draft.widget_type === 'list'">Rows to display</t>
                                    <t t-else="">Number of points</t>
                                </label>
                                <input id="od19_widget_limit" type="number" min="1" max="100"
                                       class="form-control" t-model.number="state.draft.limit"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="od19_widget_domain">Filter (Odoo domain)</label>
                                <textarea id="od19_widget_domain" rows="2" class="form-control"
                                          placeholder="[('state', '=', 'sale')]"
                                          t-model="state.draft.domain"/>
                                <small class="text-muted">
                                    Extra domain applied on top of the data source, e.g.
                                    <code>[('move_type', '=', 'out_invoice')]</code>.
                                </small>
                            </div>
                        </div>

                        <!-- ===================== Display ===================== -->
                        <h6 class="od19-builder__section">Display</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="od19_widget_visible">
                                    Show this widget only when
                                </label>
                                <textarea id="od19_widget_visible" rows="2" class="form-control"
                                          placeholder="e.g. count_records > 0"
                                          t-model="state.draft.visible_expression"
                                          t-on-input="onFormulaChange"/>
                                <small class="text-muted">
                                    Leave empty to always show the widget. The computed value is
                                    available as <code>value</code>; the measures of the source and
                                    <code>count_records</code> may be used too.
                                </small>
                            </div>
                        </div>

                        <!-- ===================== Targets ===================== -->
                        <h6 class="od19-builder__section">Target &amp; status</h6>
                        <div class="row g-3">
                            <div class="col-md-4" t-if="showGoal">
                                <label class="form-label" for="od19_widget_goal">Goal value</label>
                                <input id="od19_widget_goal" type="number" step="any"
                                       class="form-control" t-model.number="state.draft.goal_value"
                                       t-on-change="onFormulaChange"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="od19_widget_default_status">
                                    When no rule matches
                                </label>
                                <select id="od19_widget_default_status" class="form-select"
                                        t-model="state.draft.default_status"
                                        t-on-change="onFormulaChange">
                                    <option t-foreach="statuses" t-as="status" t-key="status.key"
                                            t-att-value="status.key">
                                        <t t-esc="status.label"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4" t-if="state.draft.widget_type === 'kpi'">
                                <div class="form-check mt-md-4">
                                    <input id="od19_widget_delta" type="checkbox" class="form-check-input"
                                           t-model="state.draft.show_delta" t-on-change="onFormulaChange"/>
                                    <label class="form-check-label" for="od19_widget_delta">
                                        Show the period comparison
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4"
                                 t-if="state.draft.widget_type === 'kpi' and state.draft.show_delta">
                                <label class="form-label" for="od19_widget_delta_basis">
                                    Comparison period
                                </label>
                                <select id="od19_widget_delta_basis" class="form-select"
                                        t-model="state.draft.delta_basis"
                                        t-on-change="onFormulaChange">
                                    <option t-foreach="periodBases" t-as="basis" t-key="basis.key"
                                            t-att-value="basis.key">
                                        <t t-esc="basis.label"/>
                                    </option>
                                </select>
                                <p class="text-muted small mb-0 mt-1"
                                   t-if="state.draft.delta_basis === 'mtm' or state.draft.delta_basis === 'qtq'">
                                    Previous month / quarter shifts the whole period window back by one
                                    month or three months and keeps its length. On a short period such
                                    as This Month it lands on the previous month, but on a long period
                                    such as This Year it moves the whole year-long window instead.
                                </p>
                            </div>
                        </div>

                        <!-- ===================== Status rules ===================== -->
                        <h6 class="od19-builder__section">
                            Status rules
                            <button type="button" class="btn btn-outline-secondary btn-sm ms-2"
                                    t-on-click="addRule">
                                <i class="fa fa-plus me-1"/>Add rule
                            </button>
                        </h6>
                        <p class="text-muted od19-rules__hint">
                            The first matching rule, from the top, decides the colour of the widget.
                            Drag the handle or use the arrows to change the order.
                            "Previous month" and "Previous quarter" shift the whole period window back,
                            keeping its length — the same behaviour as the KPI comparison period.
                        </p>
                        <div class="table-responsive" t-if="ruleRows.length">
                            <table class="table table-sm align-middle od19-rules">
                                <thead>
                                    <tr>
                                        <th style="width: 2rem"></th>
                                        <th style="width: 18%">Operator</th>
                                        <th style="width: 22%">Compare with</th>
                                        <th style="width: 16%">Value</th>
                                        <th style="width: 14%">Colour</th>
                                        <th style="width: 22%">Alert message</th>
                                        <th style="width: 5rem"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="ruleRows" t-as="rule" t-key="rule._key"
                                        class="od19-rules__row" draggable="true"
                                        t-on-dragstart="(ev) => this.onRuleDragStart(ev, rule.index)"
                                        t-on-dragover="onRuleDragOver"
                                        t-on-dragend="onRuleDragEnd"
                                        t-on-drop="(ev) => this.onRuleDrop(ev, rule.index)">
                                        <td class="od19-rules__handle" title="Drag to reorder">
                                            <i class="fa fa-bars"/>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    t-att-value="rule.operator"
                                                    t-on-change="(ev) => this.updateRule(rule.index, 'operator', ev.target.value)">
                                                <option t-foreach="operators" t-as="operator" t-key="operator.key"
                                                        t-att-value="operator.key">
                                                    <t t-esc="operator.label"/>
                                                </option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    t-att-value="rule.compare_type"
                                                    t-on-change="(ev) => this.updateRule(rule.index, 'compare_type', ev.target.value)">
                                                <option t-foreach="compareTypes" t-as="compare" t-key="compare.key"
                                                        t-att-value="compare.key">
                                                    <t t-esc="compare.label"/>
                                                </option>
                                            </select>
                                        </td>
                                        <td>
                                            <input t-if="rule.is_constant" type="number" step="any"
                                                   class="form-control form-control-sm"
                                                   t-att-value="rule.compare_value"
                                                   t-on-change="(ev) => this.updateRule(rule.index, 'compare_value', ev.target.value)"/>
                                            <div t-elif="rule.is_percent" class="input-group input-group-sm">
                                                <input type="number" step="any" min="0"
                                                       class="form-control"
                                                       t-att-value="rule.compare_percent"
                                                       t-on-change="(ev) => this.updateRule(rule.index, 'compare_percent', ev.target.value)"/>
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <select t-elif="rule.is_widget" class="form-select form-select-sm"
                                                    t-att-value="rule.compare_widget_id"
                                                    t-on-change="(ev) => this.updateRule(rule.index, 'compare_widget_id', parseInt(ev.target.value, 10) || false)">
                                                <option t-att-value="false">— Select a widget —</option>
                                                <option t-foreach="widgetOptions" t-as="option" t-key="option.id"
                                                        t-att-value="option.id">
                                                    <t t-esc="option.name"/>
                                                </option>
                                            </select>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm"
                                                    t-att-value="rule.status"
                                                    t-on-change="(ev) => this.updateRule(rule.index, 'status', ev.target.value)">
                                                <option t-foreach="statuses" t-as="status" t-key="status.key"
                                                        t-att-value="status.key">
                                                    <t t-esc="status.label"/>
                                                </option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Shown on the widget"
                                                   t-att-value="rule.alert_message"
                                                   t-on-change="(ev) => this.updateRule(rule.index, 'alert_message', ev.target.value)"/>
                                        </td>
                                        <td class="od19-rules__actions">
                                            <button type="button" class="od19-icon-btn od19-icon-btn--sm"
                                                    title="Move up" t-on-click="() => this.moveRule(rule.index, -1)">
                                                <i class="fa fa-arrow-up"/>
                                            </button>
                                            <button type="button" class="od19-icon-btn od19-icon-btn--sm"
                                                    title="Move down" t-on-click="() => this.moveRule(rule.index, 1)">
                                                <i class="fa fa-arrow-down"/>
                                            </button>
                                            <button type="button"
                                                    class="od19-icon-btn od19-icon-btn--sm od19-icon-btn--danger"
                                                    title="Remove rule" t-on-click="() => this.removeRule(rule.index)">
                                                <i class="fa fa-trash-o"/>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p class="text-muted" t-else="">
                            No rule yet: the widget keeps the colour chosen above.
                        </p>

                        <!-- ===================== Layout ===================== -->
                        <h6 class="od19-builder__section">Layout</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_grid_w">Width (columns)</label>
                                <input id="od19_widget_grid_w" type="number"
                                       t-att-min="props.meta.grid ? props.meta.grid.min_w : 2"
                                       t-att-max="props.meta.grid ? props.meta.grid.max_w : 12"
                                       class="form-control" t-model.number="state.draft.grid_w"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="od19_widget_grid_h">Height (rows)</label>
                                <input id="od19_widget_grid_h" type="number"
                                       t-att-min="props.meta.grid ? props.meta.grid.min_h : 1"
                                       t-att-max="props.meta.grid ? props.meta.grid.max_h : 6"
                                       class="form-control" t-model.number="state.draft.grid_h"/>
                            </div>
                        </div>

                            </div>

                            <!-- ===================== Preview ===================== -->
                            <div class="col-lg-4">
                                <div class="od19-preview">
                                    <div class="od19-preview__header">
                                        <h6 class="od19-builder__section mb-0">Preview</h6>
                                        <button type="button" class="od19-icon-btn od19-icon-btn--sm"
                                                title="Refresh the preview" t-on-click="_refreshPreview">
                                            <i class="fa fa-refresh"/>
                                        </button>
                                    </div>

                                    <div class="text-muted" t-if="state.preview.loading">
                                        <i class="fa fa-spinner fa-spin me-1"/>Computing…
                                    </div>
                                    <div class="alert alert-warning" role="alert"
                                         t-if="state.preview.error" t-esc="state.preview.error"/>
                                    <div class="text-muted" t-if="!state.preview.data and !state.preview.loading and !state.preview.error">
                                        Fill in the title and the data source to see the result.
                                    </div>

                                    <t t-if="state.preview.data and !state.preview.loading">
                                        <div class="od19-preview__value">
                                            <span t-attf-class="od19-preview__dot od19-status-{{ state.preview.data.status }}"/>
                                            <span t-esc="previewValue"/>
                                        </div>
                                        <ul class="od19-preview__meta">
                                            <li>
                                                Records collected:
                                                <strong t-esc="previewRecords"/>
                                            </li>
                                            <li>
                                                Status:
                                                <strong t-esc="previewStatusLabel"/>
                                                <span class="text-muted"
                                                      t-esc="state.preview.data.status_source === 'rule' ? '(rule)' : '(default)'"/>
                                            </li>
                                            <li>
                                                Display:
                                                <strong t-esc="previewVisible ? 'shown' : 'hidden'"/>
                                            </li>
                                        </ul>
                                        <div class="od19-preview__message" t-if="previewStatusMessage"
                                             t-esc="previewStatusMessage"/>
                                        <div class="od19-preview__message" t-if="state.preview.data.message"
                                             t-esc="state.preview.data.message"/>
                                        <div class="od19-preview__expression" t-if="previewExpression">
                                            <small class="text-muted">Expression</small>
                                            <code t-esc="previewExpression"/>
                                        </div>
                                        <table class="table table-sm od19-preview__table" t-if="previewOperands.length">
                                            <thead>
                                                <tr><th>Slot</th><th>Value</th></tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="previewOperands" t-as="operand" t-key="operand.key">
                                                    <td t-esc="operand.label"/>
                                                    <td t-esc="operand.text"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <table class="table table-sm od19-preview__table" t-if="previewSeries.length">
                                            <thead>
                                                <tr><th>Group</th><th>Value</th></tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="previewSeries" t-as="point" t-key="point.key">
                                                    <td t-esc="point.label"/>
                                                    <td t-esc="point.text"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" t-on-click="props.onClose">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary" t-on-click="onSave">
                            <i class="fa fa-check me-1"/>Save widget
                        </button>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal-backdrop show" t-on-click="props.onClose"/>
    </t>

</templates>
