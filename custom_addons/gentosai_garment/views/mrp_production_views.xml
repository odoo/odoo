<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_list_garment" model="ir.ui.view">
        <field name="name">mrp.production.list.garment</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="garment_stage" widget="badge" optional="show"/>
            </field>
        </field>
    </record>

    <record id="mrp_production_form_garment" model="ir.ui.view">
        <field name="name">mrp.production.form.garment</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <button name="action_start" position="after">
                <button name="action_advance_garment_stage"
                        string="Tahap Berikutnya"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('confirmed', 'progress', 'to_close') or garment_stage == 'done'"/>
            </button>
            <div name="qty" position="after">
                <field name="garment_stage" widget="statusbar"/>
            </div>
        </field>
    </record>
</odoo>
