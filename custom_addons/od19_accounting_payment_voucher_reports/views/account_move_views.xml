<odoo>

    <!-- Back-link ตรวจสอบย้อนหลัง: จากใบตั้งหนี้/ใบแจ้งหนี้ -> ใบสำคัญจ่าย/รับ
         ยังคงมองเห็นได้แม้เอกสารถูก reconcile แล้ว (ข้อมูลเก็บที่ account.payment) -->
    <record id="view_move_form_od19_voucher" model="ir.ui.view">
        <field name="name">account.move.form.od19.voucher</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_od19_open_vouchers"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book"
                        invisible="not od19_voucher_count">
                    <field name="od19_voucher_count" widget="statinfo"
                           string="ใบสำคัญจ่าย/รับ"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="od19_voucher_summary"
                       readonly="1"
                       invisible="not od19_voucher_count"/>
            </xpath>
        </field>
    </record>

</odoo>
