<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_retention_due_reminder" model="ir.cron">
        <field name="name">Sales Retention: Release Due Reminders</field>
        <field name="model_id" ref="model_od19_sales_retention"/>
        <field name="state">code</field>
        <field name="code">model._cron_retention_due_reminder(days=30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_retention_overdue_alert" model="ir.cron">
        <field name="name">Sales Retention: Overdue Release Alerts</field>
        <field name="model_id" ref="model_od19_sales_retention"/>
        <field name="state">code</field>
        <field name="code">model._cron_retention_overdue_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
