<odoo>

    <!-- Test entry point for the two native sale order print forms.
         The list opens sale orders in every state so both the classic and the
         modern variant can be checked before the layout is frozen. -->
    <record id="action_od19_sale_order_print_test" model="ir.actions.act_window">
        <field name="name">รายงานพิมพ์ใบสั่งขาย (ทดสอบ) / Sale Order Print (Test)</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ยังไม่มีใบสั่งขายสำหรับทดสอบรายงาน / No sale order to print yet.
            </p>
        </field>
    </record>

    <menuitem id="menu_od19_sale_order_print_test"
              name="รายงานพิมพ์ใบสั่งขาย (ทดสอบ)"
              parent="sale.menu_sale_report"
              action="action_od19_sale_order_print_test"
              groups="sales_team.group_sale_salesman"
              sequence="95"/>

</odoo>
