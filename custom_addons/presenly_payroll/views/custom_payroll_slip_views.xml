<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_payroll_slip_form_presenly_overtime" model="ir.ui.view">
        <field name="name">custom.payroll.slip.form.presenly.overtime</field>
        <field name="model">custom.payroll.slip</field>
        <field name="inherit_id" ref="hr_payroll_custom.view_custom_payroll_slip_form"/>
        <field name="arch" type="xml">
            <page name="overtime" position="inside">
                <group string="Approved Presenly Overtime Requests"
                       col="2">
                    <group>
                        <field name="presenly_approved_count" readonly="1"
                               string="Approved Requests"/>
                        <field name="presenly_approved_hours" readonly="1"
                               string="Approved Hours"/>
                    </group>
                    <group>
                        <button name="action_refresh_overtime" type="object"
                                string="Refresh Overtime"
                                class="btn-secondary"
                                groups="hr_payroll_custom.group_payroll_user"
                                invisible="status in ('paid', 'cancelled')"/>
                    </group>
                    <field name="presenly_approved_request_ids" readonly="1"
                           nolabel="1" col="2"
                           invisible="not presenly_approved_request_ids">
                        <list create="0" edit="0" delete="0">
                            <field name="date"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="work_location_id"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </group>
            </page>
            <field name="overtime_threshold_hours" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <div class="text-muted mt16" position="replace">
                <div class="text-muted mt16">
                    <p><strong>How overtime is calculated:</strong></p>
                    <ul>
                        <li>Hourly rate = contract wage / 173 (standard monthly hours).</li>
                        <li>Overtime hours = total hours of <strong>approved</strong>
                            Presenly Overtime Requests within the payroll period.</li>
                        <li>Legacy attendance extra-hours calculation is disabled;
                            only Presenly requests (state = approved) are paid.</li>
                        <li>If Manual Override is greater than 0, the automatic
                            calculation is bypassed.</li>
                    </ul>
                </div>
            </div>
        </field>
    </record>

    <record id="view_custom_payroll_slip_list_presenly_overtime" model="ir.ui.view">
        <field name="name">custom.payroll.slip.list.presenly.overtime</field>
        <field name="model">custom.payroll.slip</field>
        <field name="inherit_id" ref="hr_payroll_custom.view_custom_payroll_slip_list"/>
        <field name="arch" type="xml">
            <field name="total_lembur" position="after">
                <field name="presenly_approved_hours" string="OT Hours (Presenly)" optional="show"/>
                <field name="presenly_approved_count" string="OT Requests" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>