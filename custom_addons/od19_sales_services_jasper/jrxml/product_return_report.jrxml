	</parameter>
	<parameter name="p_Start_Date" class="java.lang.String"/>
	<parameter name="p_End_Date" class="java.lang.String"/>
	<parameter name="p_Customer" class="java.lang.String"/>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE pr.state not in ('draft')"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
ROW_NUMBER () OVER (
   ORDER BY pr.id
) as seq,
pr.id AS pr_id,
pn.ref AS customer_code,
pr.return_date AS pr_date,
claim.name AS claim_no,
pr.id as line_id,
pr.quantity as quantity,
uom.name AS uom_name,
COALESCE(t.name->>'th_TH', t.name->>'en_US', '-') AS product_name,
lot.name AS lot_name,
pn.display_name AS customer_name,
pn.street as partner_address,
pn.street2 as partner_address2,
COALESCE(pn.name,'') AS customer_contact,
COALESCE(pn.phone,'') AS customer_phone,
COALESCE(pn.fax,'') AS customer_fax,
COALESCE(c.company_name_thai,'') AS company_name_thai
,COALESCE(c.company_name_en,'') AS company_name_en
,COALESCE(c.company_tax_id,'') AS company_tax_id
,COALESCE(c.company_branch,'00000') AS company_branch
,encode(c.company_logo,'escape') AS company_logo      
,COALESCE(c.company_address_thai,'') AS company_address_thai
,COALESCE(c.company_address_en,'') AS company_address_en
,COALESCE(c.company_heaer_report,'') AS company_heaer_report
,COALESCE(c.company_footer_report,'') AS company_footer_report
,COALESCE(c.company_phone,'') AS company_phone
,COALESCE(c.company_fax,'') AS company_fax
,COALESCE(c.company_email,'') AS company_email
,COALESCE(c.company_website,'') AS company_website,
pr.name AS pr_name
FROM od19_product_return pr
LEFT JOIN company_address_header_report c ON c.id = pr.company_id
LEFT JOIN res_partner pn ON pn.id = pr.partner_id
LEFT JOIN od19_warranty_claim claim ON claim.id = pr.warranty_claim_id
LEFT JOIN product_product p ON p.id = pr.product_id
LEFT JOIN product_template t ON t.id = p.product_tmpl_id
LEFT JOIN stock_lot lot ON lot.id = pr.lot_id
LEFT JOIN uom_uom uom ON uom.id = p.uom_id
 $P!{p_Where}
 ORDER BY pr.id]]>
	</queryString>
