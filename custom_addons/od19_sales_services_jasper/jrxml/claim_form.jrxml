	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE claim.id in (1,2)"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
ROW_NUMBER () OVER (
   ORDER BY claim.id
) as seq,
claim.id AS claim_id,
claim.claim_date AS claim_date,
claim.name AS claim_no,
'' AS ss_name,
'-' AS invoice_no,
coalesce(ct.name->>'th_TH', ct.name->>'en_US', '-') AS claim_product_name,
c_lot.name AS claim_lot_name,
'' AS wc_name,

1 AS line_id,
1 AS quantity,
'' AS line_product_name,
'' AS line_lot_name,
'' AS line_claim_product,

pn.ref AS customer_code,
pn.display_name AS customer_name,
pn.street as partner_address,
pn.street2 as partner_address2,
'' AS customer_contact,
COALESCE(pn.phone,'') AS customer_phone,
COALESCE(pn.fax,'') AS customer_fax,
COALESCE(c.company_name_thai,'') AS company_name_thai
,COALESCE(c.company_name_en,'') AS company_name_en
,COALESCE(c.company_tax_id,'') AS company_tax_id
,COALESCE(c.company_branch,'00000') AS company_branch
,encode(c.company_logo,'escape') AS company_logo      
,COALESCE(c.company_address_thai,'') AS company_address_thai
,COALESCE(c.company_address_en,'') AS company_address_en
,COALESCE(c.company_heaer_report,'') AS company_heaer_report
,COALESCE(c.company_footer_report,'') AS company_footer_report
,COALESCE(c.company_phone,'') AS company_phone
,COALESCE(c.company_fax,'') AS company_fax
,COALESCE(c.company_email,'') AS company_email
,COALESCE(c.company_website,'') AS company_website
FROM od19_warranty_claim claim
LEFT JOIN company_address_header_report c ON c.id = claim.company_id
LEFT JOIN res_partner pn ON pn.id = claim.partner_id
LEFT JOIN product_product cp ON cp.id = claim.product_id
LEFT JOIN product_template ct ON ct.id = cp.product_tmpl_id
LEFT JOIN stock_lot c_lot ON c_lot.id = claim.lot_id
 $P!{p_Where}
 ORDER BY claim.id]]>
	</queryString>
