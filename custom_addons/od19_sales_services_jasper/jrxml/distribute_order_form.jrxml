	<parameter name="ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["where dto.id in (2)"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_language" class="java.lang.String"/>
	<parameter name="p_DateFormat" class="java.lang.String"/>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
		<queryString>
		<![CDATA[select 1 as row_sequence,
       1 as row_index,
       1 as row_condition,
       coalesce(c.company_name_en,'') as company_name_en,
       coalesce(c.company_name_thai,'') as company_name_thai,
       coalesce(c.company_address_thai,'') as company_address_thai,
       coalesce(c.company_address_en,'') as company_address_en,
       coalesce(c.company_branch,'00000') as company_branch,
       coalesce(c.company_tax_id,'') as company_tax_id,
       encode(c.company_logo,'escape') as company_logo,
       c.company_phone as company_phone,
       c.company_fax as company_fax,
       v.license_plate as vehicle_license_plate,
       '' as vehicle_truck_size,
       vp.display_name as vehivle_driver,
       dto.date as delivery_date,
       '' as trip_period,
       0 as trip_no,
       dto.name as document_no,
       dto.date as document_date,
       dto.transport_cost as delivery_fee,
       0 as truck_opened_fee,
       dto.transport_cost as total_amount,
       '' as product_code,
       '' as product_name,
       '' as product_lot_name,
       '' as product_barcode,
       0 as product_qty,
       '' as product_uom,
       '' as grand_total
from od19_transport_order dto
left join company_address_header_report c on c.id = dto.company_id
left join fleet_vehicle v on v.id = dto.vehicle_id
left join res_partner vp on vp.id = v.driver_id
 $P!{ids}
order by dto.id]]>
	</queryString>
