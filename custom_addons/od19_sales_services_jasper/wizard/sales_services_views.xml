<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  F-SS-001 Sales Services Form (ใบรับงานบริการ)                  -->
    <!-- ============================================================ -->
    <record id="view_sales_services_form" model="ir.ui.view">
        <field name="name">sales.services.form</field>
        <field name="model">sales.services.form</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <field name="p_language" required="1" default_focus="1"/>
                    <field name="date_type" required="1"/>
                    <field name="date_format" required="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_sales_services_form" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Sales Services Form</field>
        <field name="res_model">sales.services.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sales_services_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="od19_service_card.model_od19_service_card"/>
        <field name="binding_type">report</field>
        <field name="context">{'iscopy': 0}</field>
    </record>

