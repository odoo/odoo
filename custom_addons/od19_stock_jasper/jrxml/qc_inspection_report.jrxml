	<group name="Received_No" isStartNewColumn="true" isStartNewPage="true" isResetPageNumber="true" isReprintHeaderOnEachPage="true" footerPosition="StackAtBottom">
		<groupExpression><![CDATA[$F{qc_name}]]></groupExpression>
		<groupHeader>
			<band height="272">
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<rectangle radius="10">
					<reportElement key="" x="454" y="0" width="100" height="70" backcolor="#EDEDED" uuid="605f667e-cf2f-4971-8203-7959e5c6730b"/>
				</rectangle>
				<textField>
					<reportElement x="0" y="129" width="356" height="20" uuid="3601e463-f15d-4c04-9067-15c8e4a7d5f5"/>
					<textElement>
						<font fontName="TH Sarabun New" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA[IF($P{p_language}.toString().equals("thai"), "วันที่เอกสาร : " + (IF($F{inspection_date}==null,"", new SimpleDateFormat($P{p_DateFormat}, new Locale($P{p_locale}, $P{p_locale})).format($F{inspection_date}))),
	 "Inspection Date : " + (IF($F{inspection_date}==null,"", new SimpleDateFormat($P{p_DateFormat}, new Locale($P{p_locale}, $P{p_locale})).format($F{inspection_date})))
)]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="149" width="410" height="20" uuid="b18df3e8-66af-4046-b8c0-b4df3ce7d533"/>
					<textElement>
						<font fontName="TH Sarabun New" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA[IF($P{p_language}.toString().equals("thai"),
"เอกสารอ้างอิง : " +IF( $F{source_no}==null,"",$F{source_no} ) + " - "+ IF($F{recived_no}==null,"",$F{recived_no}),
"Source Document : " +IF( $F{source_no}==null,"",$F{source_no} ) + " - "+ IF($F{recived_no}==null,"",$F{recived_no})
)]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="169" width="280" height="20" uuid="42f8a5a6-1c8c-4302-af05-fff0425fac5d"/>
					<textElement>
						<font fontName="TH Sarabun New" size="12"/>
					</textElement>
					<textFieldExpression><![CDATA[IF($P{p_language}.toString().equals("thai"),
"ผู้รับ : " +IF($F{receive_by}==null,"",$F{receive_by}),
"Received By : " +IF($F{receive_by}==null,"",$F{receive_by})
)]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true">
					<reportElement x="456" y="0" width="98" height="70" uuid="8e59c86b-355f-47c3-96e7-836a2fd9a82d"/>
					<box leftPadding="1" bottomPadding="1">
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
