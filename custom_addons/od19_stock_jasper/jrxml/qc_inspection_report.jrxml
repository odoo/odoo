	<queryString>
		<![CDATA[SELECT 
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	   
	,qc.id AS qc_no
	,qc.name AS qc_name
	,qc.create_date AS inspection_date
	,sp.name AS recived_no
	,sp.origin AS source_no
	 ,COALESCE(qc.notes,'') AS remark
	  
	,(SELECT a.default_code
	   FROM product_product a 
	   LEFT JOIN product_template b ON b.id=a.product_tmpl_id
	   WHERE a.id=qc.product_id
	  )AS product_code

	,(SELECT b.name ->> 'th_TH'
	   FROM product_product a 
	   LEFT JOIN product_template b ON b.id=a.product_tmpl_id
	   WHERE a.id=qc.product_id
	  )AS product_name

	,(SELECT c.name ->> 'th_TH'
	   FROM product_product a 
	   LEFT JOIN product_template b ON b.id=a.product_tmpl_id
	   LEFT JOIN uom_uom c ON c.id=b.uom_id
	   WHERE a.id=qc.product_id
	  )AS product_uom
	  
	,(SELECT a.name
	   FROM stock_lot a 
	   WHERE a.id=qc.lot_id
	  )AS lot_no


	  ,qc.qty_tested AS order_qty
	  ,qc.qty_accepted AS pass_qty
	  ,qc.qty_rejected AS failed_qty
	  
	  ,''::text AS failed_reason
	  


	  ,''::text AS pass_location_name

	 ,''::text AS failed_location_name

	 ,(SELECT e.name
		FROM hr_employee e
		WHERE e.user_id=sp.write_uid limit 1
	  ) AS receive_by

	 ,(SELECT e.name
	    FROM hr_employee e
	    WHERE e.user_id=qc.inspector_id
	  ) AS inspection_by

 ,qc.state AS state
	  -- *********************************************************************************************** For Prepare By
	  ,qc.write_date as prepare_date
	  
	  ,(SELECT e.name FROM hr_employee e WHERE e.user_id=qc.write_uid LIMIT 1) AS prepare_name
	 
	 ,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id=e.current_version_id LEFT JOIN hr_job j ON j.id=v.job_id WHERE e.user_id=qc.write_uid LIMIT 1) AS prepare_position
	  
	   ,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id=e.current_version_id LEFT JOIN hr_department d ON d.id=v.department_id WHERE e.user_id=qc.write_uid LIMIT 1) AS prepare_department
	  
	 ,(SELECT s.store_fname FROM ir_attachment s LEFT JOIN hr_employee e ON e.id=s.res_id WHERE s.res_model='hr.employee' AND s.res_field='signature' AND e.user_id=qc.write_uid LIMIT 1) AS prepare_signature
	 
	   -- *********************************************************************************************** For Pre Approval By
	   
	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
	   
	   	,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
		
		,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
		
		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
	   
	   	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature
		
	  -- *********************************************************************************************** For Final Approval By
	  
	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
		
		,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
		
		,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
		
		,(SELECT reviewed_date FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided

		,(SELECT status FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id ORDER BY sequence DESC LIMIT 1) AS approved_status
				
	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='od19.qc.inspection' and res_id=qc.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
	 -- *********************************************************************************************** 
	 
FROM od19_qc_inspection qc
LEFT JOIN stock_picking sp ON sp.id=qc.picking_id
LEFT JOIN company_address_header_report c ON c.id=qc.company_id

 $P!{p_Receive_No}

ORDER BY qc.id]]>
	</queryString>
