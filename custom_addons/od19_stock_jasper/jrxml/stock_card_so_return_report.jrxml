	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="AVERA"/>
	<parameter name="p_Date_As_Off" class="java.lang.String" isForPrompting="false"/>
	<parameter name="p_Product_No" class="java.lang.Integer" isForPrompting="false"/>
	<queryString>
		<![CDATA[select 
COALESCE(sum (c.quantity),0) as qty_done
,d.usage
,c.product_id

from stock_picking a 
left join stock_move b on b.picking_id=a.id
left join stock_move_line c on c.move_id=b.id 
left join stock_location d on d.id=b.location_dest_id
where 
lower(a.origin) like 'return of%' 
and a.state='done' 
and d.usage ='customer'
and c.product_id =$P{p_Product_No} 
and b.date<=date($P{p_Date_As_Off})
AND EXTRACT(YEAR FROM date(b.date))=EXTRACT(YEAR FROM date($P{p_Date_As_Off}))


group by c.product_id,d.usage]]>
	</queryString>
	<field name="qty_done" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="qty_done"/>
	</field>
	<field name="usage" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="usage"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_location"/>
	</field>
	<field name="product_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="product_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_move_line"/>
	</field>
	<variable name="v_Return_Qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF($F{qty_done}==null,0,$F{qty_done})]]></variableExpression>
	</variable>
