	<parameter name="p_Where" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[" WHERE sm.state='done' AND sm.location_id = 43 AND date(sml.date) <= '2020-06-30' AND pt.id in (3483) OR sm.state='done' AND sm.location_dest_id = 43 AND date(sml.date) <= '2020-06-30' AND pt.id in (3483) and sm.company_id = 1 "]]></defaultValueExpression>
	</parameter>
