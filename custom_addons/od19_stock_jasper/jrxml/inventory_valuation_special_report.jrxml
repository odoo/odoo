	<variable name="v_BF_Qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name">
		<variableExpression><![CDATA[$V{v_BF_Qty}]]></variableExpression>
		<initialValueExpression><![CDATA[0.00]]></initialValueExpression>
	</variable>
	<variable name="v_BF_Values" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name">
		<variableExpression><![CDATA[$V{v_BF_Values}]]></variableExpression>
		<initialValueExpression><![CDATA[100.00]]></initialValueExpression>
	</variable>
	<variable name="v_unit_price_cal" class="java.lang.Double">
		<variableExpression><![CDATA[IF($P{p_Internal}==1
		,$F{price_unit_line}
		,$F{price_unit_line}
)]]></variableExpression>
	</variable>
	<variable name="v_unit_price" class="java.lang.Double">
		<variableExpression><![CDATA[IF($P{p_Internal}==1
		,$F{price_unit_line}
		,$F{price_unit_line}
)]]></variableExpression>
	</variable>
	<variable name="v_accu_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($P{p_Location_ID}==0 
		,0
		,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
			,0
			,IF($F{location_dest_id}==$P{p_Location_ID}.intValue() 
				,$F{qty}.doubleValue()
				,$F{qty}.doubleValue()*-1
				)
		)
	)
,IF($F{qty_report}.doubleValue()==1,$F{qty}.doubleValue(),$F{qty}.doubleValue()*-1)
)]]></variableExpression>
	</variable>
	<variable name="v_accu_value" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($P{p_Location_ID}==0 
		,0
		,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
			,0
			,IF($F{location_id}==$P{p_Location_ID}.intValue() 
				,($F{qty}.doubleValue()*$V{v_unit_price}.doubleValue())*-1
				,($F{qty}.doubleValue()*$V{v_unit_price}.doubleValue())
				)
		)
	)
,IF($F{qty_report}.doubleValue()==1,($F{qty}.doubleValue()*$V{v_unit_price_cal}.doubleValue()),(($F{qty}.doubleValue())*$V{v_unit_price_cal}.doubleValue())*-1)
)]]></variableExpression>
	</variable>
	<variable name="v_sub_buy_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("supplier") && $F{location_dest_usage}.equals("internal")
	,$F{qty}.doubleValue()
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_sub_sale_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("customer")
	,$F{qty}.doubleValue()*-1
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_sub_sale_values" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("customer")
	,$F{qty}.doubleValue()*$V{v_unit_price}.doubleValue()*-1
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_sub_buy_values" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("supplier") && $F{location_dest_usage}.equals("internal")
	,$F{qty}.doubleValue()*$V{v_unit_price}.doubleValue()
	,0.00
)]]></variableExpression>
