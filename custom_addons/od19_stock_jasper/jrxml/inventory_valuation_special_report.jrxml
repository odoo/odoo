,IF($F{qty_report}.doubleValue()==1,$F{qty}.doubleValue(),$F{qty}.doubleValue()*-1)
)]]></variableExpression>
	</variable>
	<variable name="v_total_values" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($P{p_Location_ID}==0 
		,0
		,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
			,0
			,IF($F{location_id}==$P{p_Location_ID}.intValue() 
				,($F{qty}.doubleValue()*$V{v_unit_price}.doubleValue())*-1
				,($F{qty}.doubleValue()*$V{v_unit_price}.doubleValue())
				)
		)
	)
,IF($F{qty_report}.doubleValue()==1,$F{qty}.doubleValue()*$V{v_unit_price_cal}.doubleValue(),(($F{qty}.doubleValue())*$V{v_unit_price_cal}.doubleValue()*-1))
)]]></variableExpression>
	</variable>
