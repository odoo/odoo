	<parameter name="p_Header_Name" class="java.lang.String" isForPrompting="false"/>
	<parameter name="p_Show_Satisfation" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["False"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Company_No" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Receive_No" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["WHERE sp.id  in ('229')"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Show_Serial" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="p_ISO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="p_Path" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/Users/Dataroot/AppData/Local/OpenERP S.A/Odoo/filestore/odoo_avera/"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_ESignature" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="p_EName" class="java.lang.Boolean" isForPrompting="false">
		<defaultValueExpression><![CDATA[true]]></defaultValueExpression>
	</parameter>
	<parameter name="p_language" class="java.lang.String"/>
	<parameter name="p_DateFormat" class="java.lang.String"/>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT *
FROM (
SELECT 
	att.store_fname AS logo_iso
	,c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	,pn.name AS vendor_name
	,sp.od19_contact_name as contact_name
	,sp.od19_contact_phone as contact_phone
	,CONCAT(pn.street,' ',pn.street2) as vendor_address
	,pn.phone AS phone
	,pn.mobile AS mobile
	,sp.name AS receive_no
	,sm.id AS move_id
	,sm.product_id as product_id
	
	,NULL::integer                 AS project_id
	,NULL::varchar                 AS project_name
	,NULL::varchar                 AS project_code
			
	,COALESCE(sp.origin,'')AS vendor_bill_source
	, sp.scheduled_date AS receive_date
	
	,(SELECT a.complete_name
	    FROM stock_location a 
	    WHERE a.id=sm.location_id --AND a.company_id=sm.company_id
	   )AS source_location
	   
	,sl.complete_name AS destionation_location
	,sl2.complete_name AS destionation_location_line
	,NULL AS invoice_no
	,NULL AS invoice_dae
	,NULL AS invoice_status
	,pp.default_code AS internal_reference
	,pt.name AS product_name
	,COALESCE(NULLIF(pt.description_sale, ''), NULLIF(pt.name, ''), '') AS product_discription
	,pp.barcode AS product_barcode
	,sm.product_uom_qty AS product_order
	,sml.lot_id as lot_id
	
	,COALESCE(sml.quantity, 0) AS product_receive
	--,(SELECT sum(a.qty_done)
	--	FROM stock_move_line a
	--	WHERE a.picking_id=sp.id and a.move_id=sm.id   and a.product_id=sm.product_id
	 --)AS product_receive
	 
	,pu.name AS product_uom
	
 	 ,(SELECT a.name
		FROM stock_lot a
		WHERE a.id=sml.lot_id limit 1
	 )AS lot_no_actual
	 
	 ,(SELECT a.lot_name
		FROM stock_move_line a
		WHERE a.picking_id=sp.id and a.move_id=sm.id and a.product_id=sm.product_id limit 1
	 )AS lot_no
	 
	 
	--,sm.serial_no_from AS serial_status

	,(SELECT e.name FROM hr_employee e WHERE e.user_id=sm.write_uid LIMIT 1) AS receive_by
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id=e.current_version_id LEFT JOIN hr_department d ON d.id=v.department_id WHERE e.user_id=sm.write_uid LIMIT 1) AS receive_department
	,sp.note AS receive_note
	,COALESCE(sp.od19_delivery_reason_display, '') AS delivery_reason_display
	
	,sp.od19_goods_issue_reason AS reference_good_issue
	
	--,(SELECT a.name
	--    FROM document_group a 
	 --   WHERE a.id=sp.group 
	 --  ) AS document_group
	   
	,st.code AS operation_type
	
,(
 SELECT he.name
 FROM hr_employee he
 WHERE he.user_id = COALESCE(so.user_id, sp.write_uid)
 LIMIT 1
) AS sale_person
	  
	  ,sp.state AS state
	  -- *********************************************************************************************** For Prepare By
	  ,sm.write_date as prepare_date
	  ,sp.date_done as validate_date
	  
,(
 SELECT he.name
 FROM res_users ru
 LEFT JOIN hr_employee he ON he.user_id = ru.id
 WHERE ru.id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_name

,(
 SELECT j.name->>'th_TH'
 FROM hr_employee e
 LEFT JOIN hr_version v ON v.id = e.current_version_id
 LEFT JOIN hr_job j ON j.id = v.job_id
 WHERE e.user_id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_position
	  
,(
 SELECT d.name->>'th_TH'
 FROM hr_employee e
 LEFT JOIN hr_version v ON v.id = e.current_version_id
 LEFT JOIN hr_department d ON d.id = v.department_id
 WHERE e.user_id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_department
	  
,(
 SELECT s.store_fname
 FROM ir_attachment s
 LEFT JOIN hr_employee e ON e.id = s.res_id
 WHERE s.res_model='hr.employee' AND s.res_field='signature'
   AND e.user_id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_signature
	 
	   -- *********************************************************************************************** For Pre Approval By
	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_approved_name

	   ,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_department

	    ,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_position

		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_signature

	  -- *********************************************************************************************** For Final Approval By
	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name

		,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department

		,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position

		,(SELECT reviewed_date FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided

	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature

	,(SELECT status FROM tier_review WHERE model='stock.picking' and res_id=sp.id ORDER BY sequence DESC LIMIT 1) AS approved_status
	 -- ***********************************************************************************************
	 --, sp.partner_ref as vendor_ref
	 ,st.code as picking_type
	 ,NULL::text as convert_uom
	 ,NULL::numeric as convert_product_uom_qty
	 ,NULL::numeric as qty_done_convert
	 ,(SELECT a.complete_name
	    FROM stock_location a 
	    WHERE a.id=sml.location_id --AND a.company_id=sm.company_id
	   )AS sml_source_location
	 ,COALESCE(sm.sequence, sm.id) AS report_sequence
	 ,'product' AS line_type
	 ,0 AS line_type_sort_order
	 ,COALESCE(sml.id, sm.id) AS source_id
	 ,NULL::varchar AS additional_note
	   
FROM stock_picking sp
LEFT JOIN sale_order so on so.id = sp.sale_id 
LEFT JOIN company_address_header_report c ON c.id=sp.company_id
LEFT JOIN res_company comp ON comp.id = sp.company_id
LEFT JOIN ir_attachment att ON att.res_id = comp.id and att.res_model = 'res.company' and att.res_field='logo_iso'
LEFT JOIN res_partner pn ON pn.id=sp.partner_id
LEFT JOIN stock_move sm ON sm.picking_id=sp.id AND sm.company_id=sp.company_id
LEFT JOIN stock_move_line sml ON sml.move_id=sm.id
LEFT JOIN product_product pp on pp.id=sm.product_id 
LEFT JOIN product_template pt ON pt.id=pp.product_tmpl_id

LEFT JOIN uom_uom pu on pu.id=sm.product_uom
LEFT JOIN stock_location sl on sl.id=sm.location_dest_id
LEFT JOIN stock_location sl2 on sl2.id=sml.location_dest_id
LEFT JOIN stock_picking_type st ON st.id=sp.picking_type_id 

 $P!{p_Receive_No} 

UNION ALL

SELECT
	att.store_fname AS logo_iso
	,c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	,pn.name AS vendor_name
	,sp.od19_contact_name as contact_name
	,sp.od19_contact_phone as contact_phone
	,CONCAT(pn.street,' ',pn.street2) as vendor_address
	,pn.phone AS phone
	,pn.mobile AS mobile
	,sp.name AS receive_no
	,NULL::integer AS move_id
	,NULL::integer AS product_id

	,NULL::integer AS project_id
	,NULL::varchar AS project_name
	,NULL::varchar AS project_code

	,COALESCE(sp.origin,'')AS vendor_bill_source
	,sp.scheduled_date AS receive_date

	,NULL::varchar AS source_location

	,NULL::varchar AS destionation_location
	,NULL::varchar AS destionation_location_line
	,NULL AS invoice_no
	,NULL AS invoice_dae
	,NULL AS invoice_status
	,NULL::varchar AS internal_reference
	,apl.name AS product_name
	,COALESCE(apl.name, '') AS product_discription
	,NULL::varchar AS product_barcode
	,NULL::numeric AS product_order
	,NULL::integer AS lot_id

	,COALESCE(apl.quantity, 0) AS product_receive

	,COALESCE(apu.name, '') AS product_uom

	,NULL::varchar AS lot_no_actual

	,NULL::varchar AS lot_no

	,NULL::varchar AS receive_by
	,NULL::varchar AS receive_department
	,sp.note AS receive_note
	,COALESCE(sp.od19_delivery_reason_display, '') AS delivery_reason_display

	,sp.od19_goods_issue_reason AS reference_good_issue

	,st.code AS operation_type

,(
 SELECT he.name
 FROM hr_employee he
 WHERE he.user_id = COALESCE(so.user_id, sp.write_uid)
 LIMIT 1
) AS sale_person

	  ,sp.state AS state
	  ,NULL::timestamp AS prepare_date
	  ,sp.date_done as validate_date

,(
 SELECT he.name
 FROM res_users ru
 LEFT JOIN hr_employee he ON he.user_id = ru.id
 WHERE ru.id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_name

,(
 SELECT j.name->>'th_TH'
 FROM hr_employee e
 LEFT JOIN hr_version v ON v.id = e.current_version_id
 LEFT JOIN hr_job j ON j.id = v.job_id
 WHERE e.user_id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_position

,(
 SELECT d.name->>'th_TH'
 FROM hr_employee e
 LEFT JOIN hr_version v ON v.id = e.current_version_id
 LEFT JOIN hr_department d ON d.id = v.department_id
 WHERE e.user_id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_department

,(
 SELECT s.store_fname
 FROM ir_attachment s
 LEFT JOIN hr_employee e ON e.id = s.res_id
 WHERE s.res_model='hr.employee' AND s.res_field='signature'
   AND e.user_id = COALESCE(sp.od19_sale_user_id, so.user_id, so.create_uid, sp.write_uid)
 LIMIT 1
) AS prepare_signature

	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_approved_name

	   ,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_department

	    ,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_position

		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = sp.od19_dept_manager_id
		  AND b.company_id = sp.company_id
		LIMIT 1) AS pre_signature

	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name

		,(SELECT d.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_department d ON d.id = v.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department

		,(SELECT j.name->>'th_TH' FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_version v ON v.id = b.current_version_id
		LEFT JOIN hr_job j ON j.id = v.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position

		,(SELECT reviewed_date FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided

	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='stock.picking' and res_id=sp.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature

	,(SELECT status FROM tier_review WHERE model='stock.picking' and res_id=sp.id ORDER BY sequence DESC LIMIT 1) AS approved_status
	 ,st.code as picking_type
	 ,NULL::text as convert_uom
	 ,NULL::numeric as convert_product_uom_qty
	 ,NULL::numeric as qty_done_convert
	 ,NULL::varchar AS sml_source_location
	 ,COALESCE(apl.sequence, 999999) AS report_sequence
	 ,'additional' AS line_type
	 ,1 AS line_type_sort_order
	 ,apl.id AS source_id
	 ,NULL::varchar AS additional_note

FROM stock_picking sp
LEFT JOIN sale_order so on so.id = sp.sale_id
LEFT JOIN company_address_header_report c ON c.id=sp.company_id
LEFT JOIN res_company comp ON comp.id = sp.company_id
LEFT JOIN ir_attachment att ON att.res_id = comp.id and att.res_model = 'res.company' and att.res_field='logo_iso'
LEFT JOIN res_partner pn ON pn.id=sp.partner_id
LEFT JOIN stock_picking_type st ON st.id=sp.picking_type_id
JOIN od19_stock_picking_additional_line apl ON apl.picking_id = sp.id
LEFT JOIN uom_uom apu ON apu.id = apl.product_uom_id

 $P!{p_Receive_No}
) delivery_lines

ORDER BY receive_no, report_sequence, line_type_sort_order, source_id]]>
	</queryString>
	<field name="logo_iso" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="logo_iso"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="ir_attachment"/>
	</field>
	<field name="company_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="company_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_name_thai" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_name_thai"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_name_en" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_name_en"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_tax_id" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_tax_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_branch" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_branch"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_logo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_logo"/>
	</field>
	<field name="company_address_thai" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_address_thai"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_address_en" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_address_en"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_heaer_report" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_heaer_report"/>
