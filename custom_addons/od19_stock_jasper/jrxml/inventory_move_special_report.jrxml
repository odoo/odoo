	<queryString>
		<![CDATA[SELECT 
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website
	   
	,sp.name AS picking_name
	,sp.origin AS picking_origin
	,COALESCE(NULLIF(sm.description_picking_manual,''), sm.reference) as move_name
	
	,sm.location_id AS location_id
	,sl.usage AS location_usage
	,sl.name AS location_name
	
	,sm.location_dest_id as location_dest_id
	
	,(SELECT a.usage
	   FROM stock_location a
	   WHERE a.id=sm.location_dest_id
	  )AS location_dest_usage
	  
	,(SELECT a.name
	   FROM stock_location a
	   WHERE a.id=sm.location_dest_id
	  )AS location_dest_name
	  
	,sm.product_id AS product_id
	,pp.default_code AS product_internal_code
	
	,sm.product_id AS product_id
	,(SELECT c.name->>'th_TH'
	   FROM product_product a 
	   LEFT JOIN product_template b ON b.id=a.product_tmpl_id
	   LEFT JOIN uom_uom c ON c.id=b.uom_id
	   WHERE a.id=sm.product_id
	  )AS product_uom
	  
	,sm.date AS move_date
	,case
		when date(sml.date) between date( $P{p_Start_Date} ) and  date( $P{p_To_Date} ) then 'period'
		else 'bf'
	end as period
	 
	,pt.name->>'th_TH' AS product_name

	,lot.name AS lot_no 
	,lot.expiration_date AS lot_expired 
	 
	,sml.quantity AS qty
	
	,case 
		when (sm.value)=0 and 
							(SELECT a.usage
								FROM stock_location a
								WHERE a.id=sm.location_dest_id
							)='customer' 
						then -1
		when (sm.value) <0 then -1
		when (sm.value)=0 and 
							(SELECT a.usage
								FROM stock_location a
								WHERE a.id=sm.location_dest_id
							)='inventory'
						then -1	
	
     	else 1
     end AS qty_report
     
	, CASE WHEN sm.product_uom_qty <> 0 THEN (sm.value) / sm.product_uom_qty ELSE 0 END as unit_price
	, (sm.value) as svalues

	,CASE WHEN sm.product_uom_qty <> 0 THEN (sm.value) / sm.product_uom_qty ELSE 0 END as price_unit_cal
	
	
	,(SELECT c.name->>'th_TH'
	   FROM product_product a 
	   LEFT JOIN product_template b ON b.id=a.product_tmpl_id
	   LEFT JOIN uom_uom c ON c.id=b.uom_id
	   WHERE a.id=sm.product_id
	  )AS product_uom
	  
	,(SELECT b.name
	    FROM res_users a 
	    LEFT JOIN hr_employee b on b.user_id=a.id
	    WHERE a.id= $P{p_User_ID}  limit 1
	  ) AS reqeust_by
	  
	  	,(SELECT he.name
	    FROM res_users ru
	    LEFT JOIN hr_employee he ON he.user_id = ru.id
	    WHERE ru.id= $P{p_User_ID}  limit 1
	  ) AS prepare_name
	  
	   ,(SELECT d.name->>'th_TH'
	    FROM hr_employee e
	    LEFT JOIN hr_version v ON v.id = e.current_version_id
	    LEFT JOIN hr_department d ON d.id = v.department_id
	    WHERE e.user_id= $P{p_User_ID}  limit 1
	  ) AS department_name
	  
	   ,(SELECT j.name->>'th_TH'
	    FROM hr_employee e
	    LEFT JOIN hr_version v ON v.id = e.current_version_id
	    LEFT JOIN hr_job j ON j.id = v.job_id
	    WHERE e.user_id= $P{p_User_ID}  limit 1
	  ) AS position_name
	  
	  ,(SELECT s.store_fname
	    FROM ir_attachment s
	    LEFT JOIN hr_employee e ON e.id = s.res_id
	    WHERE s.res_model='hr.employee' AND s.res_field='signature' AND e.user_id = $P{p_User_ID} LIMIT 1
	  ) AS prepare_signature
	
FROM product_product pp
LEFT JOIN stock_move sm ON pp.id=sm.product_id 
LEFT JOIN stock_move_line sml ON sml.move_id=sm.id
LEFT JOIN company_address_header_report c ON c.id=sm.company_id
LEFT JOIN stock_picking sp ON sp.id=sm.picking_id and sp.company_id=sm.company_id
LEFT JOIN stock_location sl ON sl.id=sm.location_id
--LEFT JOIN product_product pp ON pp.id=sm.product_id 
LEFT JOIN product_template pt ON pt.id=pp.product_tmpl_id
LEFT JOIN stock_lot lot ON lot.id = sml.lot_id

 $P!{p_Where} 
 
ORDER BY  
sm.product_id
,case
		when date(sml.date) between date( $P{p_Start_Date} ) and  date( $P{p_To_Date} ) then 'period'
		else 'bf'
 end 
 $P!{p_oder_by}]]>
	</queryString>
