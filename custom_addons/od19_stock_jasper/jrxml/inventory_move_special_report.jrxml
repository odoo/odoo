	<variable name="v_BF_Qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name">
		<variableExpression><![CDATA[$V{v_BF_Qty}]]></variableExpression>
		<initialValueExpression><![CDATA[0.00]]></initialValueExpression>
	</variable>
	<variable name="v_BF_Values" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name">
		<variableExpression><![CDATA[$V{v_BF_Values}]]></variableExpression>
		<initialValueExpression><![CDATA[100.00]]></initialValueExpression>
	</variable>
	<variable name="v_unit_price_cal" class="java.math.BigDecimal">
		<variableExpression><![CDATA[IF($P{p_Internal}==1
		,$F{price_unit_cal}
		,$F{unit_price}
)]]></variableExpression>
	</variable>
	<variable name="v_unit_price" class="java.math.BigDecimal">
		<variableExpression><![CDATA[IF($P{p_Internal}==1
		,ABS($F{price_unit_cal})
		,ABS($F{unit_price})
)]]></variableExpression>
	</variable>
	<variable name="v_accu_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Product_Name" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($P{p_Location_ID}==0 
		,0
		,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
			,0
			,IF($F{location_dest_id}==$P{p_Location_ID}.intValue() 
				,$F{qty}.doubleValue()
				,$F{qty}.doubleValue()*-1
				)
		)
	)
,IF($F{qty_report}.doubleValue()==1,$F{qty}.doubleValue(),$F{qty}.doubleValue()*-1)
)]]></variableExpression>
	</variable>
	<variable name="v_sub_buy_qty" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("supplier") && $F{location_dest_usage}.equals("internal")
	,$F{qty}
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_sub_buy_return_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("supplier")
	,$F{qty}.doubleValue()
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_sub_sale_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("customer")
	,$F{qty}.doubleValue()
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_sub_sale_return_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("customer") && $F{location_dest_usage}.equals("internal")
	,$F{qty}.doubleValue()
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_sub_usage_in_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($P{p_Location_ID}==0 &&$F{location_usage}.equals( $F{location_dest_usage})
	,$F{qty}.doubleValue()
	,IF($F{location_usage}.equals("inventory") && $F{location_dest_usage}.equals("internal") 
		|| $F{location_usage}.equals("production") && $F{location_dest_usage}.equals("internal") 
			,$F{qty}.doubleValue()
			,0.00
	)
)]]></variableExpression>
	</variable>
	<variable name="v_sub_usage_out_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($P{p_Location_ID}==0 &&$F{location_usage}.equals( $F{location_dest_usage})
	,$F{qty}.doubleValue()
	,IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("inventory") 
		|| $F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("production") 
			,$F{qty}.doubleValue()
			,0.00
		)
)]]></variableExpression>
	</variable>
	<variable name="v_sub_in_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
		,0.00
		,IF($F{location_dest_id}==$P{p_Location_ID}.intValue() 
			,$F{qty}.doubleValue()
			,0.00
			)
	)
,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_sub_out_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Period" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
		,0.00
		,IF($F{location_id}==$P{p_Location_ID}.intValue() 
			,$F{qty}.doubleValue()
			,0.00
			)
	)
,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_location_buy_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Location_No" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("supplier") && $F{location_dest_usage}.equals("internal")
	,$F{qty}.doubleValue()
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_location_buy_return_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Location_No" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("supplier")
	,$F{qty}.doubleValue()
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_location_sale_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Location_No" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("customer")
	,$F{qty}.doubleValue()
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_location_sale_return_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Location_No" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals("customer") && $F{location_dest_usage}.equals("internal")
	,$F{qty}.doubleValue()
	,0.00
)]]></variableExpression>
	</variable>
	<variable name="v_location_usage_in_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Location_No" calculation="Sum">
		<variableExpression><![CDATA[IF($P{p_Location_ID}==0 &&$F{location_usage}.equals( $F{location_dest_usage})
	,$F{qty}.doubleValue()
	,IF($F{location_usage}.equals("inventory") && $F{location_dest_usage}.equals("internal") 
		|| $F{location_usage}.equals("production") && $F{location_dest_usage}.equals("internal") 
			,$F{qty}.doubleValue()
			,0.00
	)
)]]></variableExpression>
	</variable>
	<variable name="v_location_usage_out_qty" class="java.lang.Double" resetType="Group" resetGroup="Group_Location_No" calculation="Sum">
		<variableExpression><![CDATA[IF($P{p_Location_ID}==0 &&$F{location_usage}.equals( $F{location_dest_usage})
	,$F{qty}.doubleValue()
	,IF($F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("inventory") 
		|| $F{location_usage}.equals("internal") && $F{location_dest_usage}.equals("production") 
			,$F{qty}.doubleValue()
			,0.00
		)
)]]></variableExpression>
	</variable>
	<variable name="v_location_in_qty" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
		,0
		,IF($F{location_dest_id}==$P{p_Location_ID}.intValue() 
			,$F{qty}.doubleValue()
			,0
			)
	)
,0
)]]></variableExpression>
	</variable>
	<variable name="v_location_out_qty" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
		,0
		,IF($F{location_id}==$P{p_Location_ID}.intValue() 
			,$F{qty}.doubleValue()
			,0
			)
	)
,0
)]]></variableExpression>
	</variable>
	<variable name="v_total_qty" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[IF($F{location_usage}.equals( $F{location_dest_usage})
	,IF($P{p_Location_ID}==0 
		,0
		,IF($F{location_id}==$P{p_Location_ID}.intValue() && $F{location_dest_id}==$P{p_Location_ID}.intValue()
			,0
			,IF($F{location_dest_id}==$P{p_Location_ID}.intValue() 
				,$F{qty}.doubleValue()
				,$F{qty}.doubleValue()*-1
				)
		)
	)
,IF($F{qty_report}.doubleValue()==1,$F{qty}.doubleValue(),$F{qty}.doubleValue()*-1)
)]]></variableExpression>
	</variable>
