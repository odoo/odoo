<!-- Created with Jaspersoft Studio version 6.10.0.final using JasperReports Library version 6.10.0-unknown  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="dead_stock_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ab8a7b74-bdcc-441a-9599-a031c5a34703">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Localhost"/>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print_By" class="java.lang.String">
		<defaultValueExpression><![CDATA["Test"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_location" class="java.lang.String"/>
	<parameter name="p_days" class="java.lang.String"/>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["where a.remaining_qty != 0"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_location_dest_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="p_location_src_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[select *, CASE WHEN a.remaining_qty != 0 THEN (a.remaining_value / a.remaining_qty) ELSE 0 END as unit_cost from (select ptp.name->>'th_TH' as product_name, lot.id as lot_id, lot.name as lot_name, sum(q.quantity) as product_qty,
COALESCE(c.company_name_thai,'') AS company_name_thai,
COALESCE(c.company_name_en,'') AS company_name_en,
(select CASE WHEN ml.date is null THEN ml.create_date ELSE ml.date END from stock_move_line ml
left join stock_picking pick on pick.id = ml.picking_id
left join stock_move m on m.id = ml.move_id
left join stock_picking_type pt1 on pt1.id = pick.picking_type_id
left join stock_picking_type pt2 on pt2.id = m.picking_type_id
where ml.lot_id = lot.id and (pt1.code in ('incoming', 'mrp_operation') or pt2.code in ('incoming', 'mrp_operation')) and ml.date is not null and ml.state = 'done'
order by ml.date asc
limit 1) as first_incoming_date,
(select ml.date from stock_move_line ml
left join stock_picking pick on pick.id = ml.picking_id
left join stock_move m on m.id = ml.move_id
left join stock_picking_type pt1 on pt1.id = pick.picking_type_id
left join stock_picking_type pt2 on pt2.id = m.picking_type_id
where ml.lot_id = lot.id and (pt1.code = 'outgoing' or pt1.code = 'outgoing') and ml.state = 'done'
order by ml.date desc
limit 1) as last_outgoing_date,
(sum(q.quantity) * COALESCE(NULLIF((lot.standard_price->>(lot.company_id::text))::numeric, 0), (p.standard_price->>(lot.company_id::text))::numeric, 0)) as remaining_value,
sum(q.quantity) as remaining_qty,
uom.name->>'th_TH' as uom_name,
lot.company_id as company_id
from stock_lot lot
inner join stock_quant q on lot.id = q.lot_id
inner join stock_location loc on q.location_id = loc.id
inner join product_product p on p.id = lot.product_id
left join product_template ptp on ptp.id = p.product_tmpl_id
left join company_address_header_report c ON c.id = lot.company_id
left join uom_uom uom on uom.id = ptp.uom_id
where loc.usage in ('internal', 'transit') and ptp.sale_ok = True $P!{p_location_src_id}
group by lot.name, lot.id, ptp.name, c.company_name_thai, c.company_name_en, uom.name, lot.company_id, p.standard_price) a
$P!{p_Where}
order by a.product_name, a.lot_name]]>
	</queryString>
