	<parameter name="ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["where sp.id in (15045,15408,15409)"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select c.name as company_name,
       encode(c2.company_logo,'escape') AS company_logo,
       concat(cpartner.street) as company_address_1, 
       concat(cpartner.street2, cpartner.city,
       	            case when cp.name is not null then ' จังหวัด' else '' end,
                    cp.name, ' ', 
                    cpartner.zip,
                    case when cc.name is not null then ' ' else '' end,
                    cc.name) as company_address_2, 
       concat('โทรศัพท์ ', cpartner.phone, ' แฟกซ์. ', cpartner.fax) as company_address_3, 
       cpartner.vat as company_tax, 
       case when c2.company_branch is null or c2.company_branch = '00000' then 'สำนักงานใหญ่' else c2.company_branch end as company_branch_code, 
       
	   p.name as partner_name, 
       concat(p.street) as partner_address_1, 
       concat(p.street2, p.city, 
       	            case when pp.name is not null then ' จังหวัด' else '' end,
                    pp.name, ' ', 
                    p.zip,
                    case when pc.name is not null then ' ' else '' end,
                    pc.name) as partner_address_2,
			  
       p.ref as partner_code, 
       p.vat as partner_tax,  
       case when p.branch_code is null or p.branch_code = '00000' then 'สำนักงานใหญ่' else p.branch_code end as partner_branch_code, 
       p.vat as partner_tax,
       p.phone as partner_phone,
       p.mobile as partner_mobile,
	   
	   sp.name as doc_number,
	   sp.scheduled_date as doc_date,
	   sp.origin as origin,
       NULL::text AS salearea_name,
	   
       pro.default_code AS product_code,
       prot.name ->> 'th_TH' AS product_name,	   
       pro.default_code AS product_barcode,
	   loc.complete_name as product_location_name,
	   case when sml_lot.name = null then sml.lot_name else sml_lot.name end as product_lot,
       sm.product_uom_qty AS product_qty,
       uom.name ->> 'th_TH' AS product_uom

from stock_move as sm
left outer join stock_move_line as sml on sml.move_id = sm.id
left outer join stock_lot as sml_lot on sml_lot.id = sml.lot_id
inner join stock_picking as sp on sp.id = sm.picking_id
inner join stock_location as loc on loc.id = sm.location_id
inner join uom_uom as uom on uom.id = sm.product_uom

inner join res_company as c on c.id = sp.company_id
inner join res_partner as cpartner on cpartner.id = c.partner_id
left outer join res_country_state as cp on cp.id = cpartner.state_id
left outer join res_country as cc on cc.id = cpartner.country_id
left join company_address_header_report c2 ON c2.id = sp.company_id

inner join res_partner as p on p.id = sp.partner_id
left outer join res_country_state as pp on pp.id = p.state_id
left outer join res_country as pc on pc.id = p.country_id

inner join product_product as pro on pro.id = sm.product_id
inner join product_template as prot on prot.id = pro.product_tmpl_id
$P!{ids}]]>
	</queryString>
