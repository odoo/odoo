<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="stock_card_so_report" pageWidth="595" pageHeight="842" columnWidth="575" leftMargin="0" rightMargin="20" topMargin="0" bottomMargin="0" uuid="25108754-ceae-464e-9e6d-53c491f29d80">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="localhost.xml"/>
	<parameter name="p_Product_No" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="p_Date_As_Off" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT 
	so.id
	,so.company_id
	,so.date_order
	,sl.product_id
	,COALESCE(sl.product_uom_qty,0) as product_uom_qty
	,sl.qty_delivered
	,sl.qty_invoiced
	,false AS premium
	
FROM sale_order so
LEFT JOIN sale_order_line sl ON sl.order_id=so.id and sl.company_id=so.company_id

WHERE  so.state in ('sale','done')
AND sl.product_id= $P{p_Product_No} 
AND date(so.date_order) <= date($P{p_Date_As_Off})
AND EXTRACT(YEAR FROM date(so.date_order))=EXTRACT(YEAR FROM date($P{p_Date_As_Off}))]]>
	</queryString>
	<field name="id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order"/>
	</field>
