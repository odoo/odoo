	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Report_Testing"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="inch"/>
	<parameter name="p_Company_Name" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["Demo Company Limited"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Currency" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["THB"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[" where pd.id in(1) "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
generate_series(1, $P{p_Print} ),pd.name as lot_name
,pt.name as product_name,pt.list_price,pp.barcode,pp.default_code as internal_reference,pu.name as uom 
from stock_lot pd
left join product_template pt on pt.id=pd.product_id
left join product_product pp on pp.product_tmpl_id=pt.id
left join uom_uom pu on pu.id=pd.product_uom_id

 $P!{p_Where} 
 
 order by pd.id]]>
	</queryString>
