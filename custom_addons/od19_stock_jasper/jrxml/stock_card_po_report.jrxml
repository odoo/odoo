	<parameter name="p_Product_No" class="java.lang.Integer" isForPrompting="false"/>
	<parameter name="p_Date_As_Off" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT 
	COALESCE(sum(pl.product_qty), 0) as product_qty

FROM purchase_order po
LEFT JOIN purchase_order_line pl on pl.order_id=po.id and pl.company_id=po.company_id

WHERE po.state in ('purchase','done')
AND	pl.product_id=  $P{p_Product_No} 
AND date(po.date_order) <= date( $P{p_Date_As_Off} )
AND EXTRACT(YEAR FROM date(po.date_order))=EXTRACT(YEAR FROM date( $P{p_Date_As_Off} ))]]>
	</queryString>
	<field name="product_qty" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="product_qty"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="purchase_order_line"/>
	</field>
	<variable name="v_Purchase_Qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{product_qty}]]></variableExpression>
	</variable>
