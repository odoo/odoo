	<parameter name="p_location_ids" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["(7, 36, 382, 315, 383, 314, 37, 8, 38, 318, 39, 313, 323, 324, 175, 176, 177, 178, 179, 180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199, 200, 201, 202, 203, 204, 205, 206, 207, 208, 209, 210, 211, 212, 213, 214, 215, 216, 217, 218, 219, 220, 221, 222, 223, 224, 225, 226, 227, 228, 229, 230, 231, 232, 233, 234, 235, 236, 237, 238, 239, 240, 241, 242, 243, 244, 245, 246, 247, 248, 249, 353, 354, 355, 356, 357, 358, 359, 360, 361, 362, 363, 364, 365, 366, 367, 368, 369, 370, 371, 372, 373, 374, 375, 381, 377, 378, 379, 380, 250, 325, 326, 327, 328, 329, 330, 331, 332, 333, 334, 335, 348, 337, 338, 339, 349, 341, 342, 343, 344, 345, 346, 385, 386, 347, 350, 351, 352, 251, 252, 253, 254, 255, 256, 257, 258, 259, 260, 261, 262, 263, 264, 265, 266, 267, 268, 269, 270, 271, 272, 273, 274, 275, 276, 277, 278, 279, 280, 281, 282, 283, 284, 285, 286, 287, 288, 289, 290, 291, 292, 293, 35, 316)"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT move.date, move.product_id, move.product_qty,
                move.product_uom_qty, move.product_uom, move.reference,
                move.location_id, move.location_dest_id,
                case when move.location_dest_id in $P!{p_location_ids}
                    then move.product_qty else 0 end as product_in,
                case when move.location_id in $P!{p_location_ids}
                    then move.product_qty else 0 end as product_out,
                move.picking_id,
                (select STRING_AGG(lot.name || ' (' || sml.quantity || ' ' || sml_uom.name->>'th_TH' || ')', CHR(10)) from stock_move_line sml
                left join stock_lot lot on lot.id = sml.lot_id
                left join uom_uom sml_uom on sml_uom.id = sml.product_uom_id
                where sml.move_id = move.id) AS lot_no,
		pt.name->>'th_TH' AS product_name,
		pp.default_code AS product_internal_code,
		move.date AS move_date,
		src.complete_name AS location_name,
		dest.complete_name AS location_dest_name,
		
         c.id AS company_id
		,COALESCE(c.company_name_thai,'') AS company_name_thai
		,COALESCE(c.company_name_en,'') AS company_name_en
		,COALESCE(c.company_tax_id,'') AS company_tax_id
		,COALESCE(c.company_branch,'00000') AS company_branch
		,encode(c.company_logo,'escape') AS company_logo      
		,COALESCE(c.company_address_thai,'') AS company_address_thai
		,COALESCE(c.company_address_en,'') AS company_address_en
		,COALESCE(c.company_heaer_report,'') AS company_heaer_report
		,COALESCE(c.company_footer_report,'') AS company_footer_report
		,COALESCE(c.company_phone,'') AS company_phone
		,COALESCE(c.company_fax,'') AS company_fax
		,COALESCE(c.company_email,'') AS company_email
		,COALESCE(c.company_website,'') AS company_website

	,case
		when date(move.date) between date( $P{p_Start_Date} ) and  date( $P{p_To_Date} ) then 'period'
		else 'bf'
	 end as period

		,(SELECT he.name
	    FROM res_users ru
	    LEFT JOIN hr_employee he ON he.user_id = ru.id
	    WHERE ru.id = $P{p_User_ID} LIMIT 1
	  ) AS prepare_name

	  ,(SELECT s.store_fname
	    FROM ir_attachment s
	    LEFT JOIN hr_employee e ON e.id = s.res_id
	    WHERE s.res_model='hr.employee' AND s.res_field='signature' AND e.user_id = $P{p_User_ID} LIMIT 1
	  ) AS prepare_signature

            FROM stock_move move
            LEFT JOIN company_address_header_report c ON c.id=move.company_id
            LEFT JOIN product_product pp ON pp.id = move.product_id
            LEFT JOIN product_template pt ON pt.id=pp.product_tmpl_id
            LEFT JOIN uom_uom uom ON uom.id = move.product_uom
            LEFT JOIN stock_location src ON src.id = move.location_id
            LEFT JOIN stock_location dest ON dest.id = move.location_dest_id
            $P!{p_Where}
            ORDER BY move.product_id
            ,case
				when date(move.date) between date( $P{p_Start_Date} ) and  date( $P{p_To_Date} ) then 'period'
				else 'bf'
 			end, move.date, move.id;]]>
	</queryString>
