		<defaultValueExpression><![CDATA[" WHERE sm.state='done' AND sm.location_id = 12 AND date(sml.date) <= '2020-01-22' OR sm.state='done' AND sm.location_dest_id = 12  AND date(sml.date) <= '2020-01-22'"]]></defaultValueExpression>
