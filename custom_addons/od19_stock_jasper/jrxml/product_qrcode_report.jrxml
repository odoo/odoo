	<parameter name="p_Currency" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["THB"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Print" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[5]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Show_Price" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["False"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Where" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[" where pt.id in(1,2,3,4,5) "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
generate_series(1, $P{p_Print}),
pt.name as product_name,pt.list_price,pp.barcode,pp.default_code as internal_reference,pu.name as uom 
from product_template pt
left join product_product pp on pp.product_tmpl_id=pt.id
left join uom_uom pu on pu.id=pt.uom_id
 $P!{p_Where} 
 
 order by pt.id]]>
	</queryString>
