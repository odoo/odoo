	<queryString>
		<![CDATA[with cte as (
select
svl.value as total_cost
,svl.quantity
,svl.company_id
,svl.product_id
from stock_move svl
left join product_product pp on pp.id = svl.product_id
left join product_template pt on pt.id = pp.product_tmpl_id
left join uom_uom uom on uom.id = pt.uom_id
$P!{p_Where}
),
cte2 as (select
coalesce(pt.default_code, '') as product_code
,pp.id as product_id
,coalesce(pt.name->>'th_TH', '') as product_name
,uom.name->>'th_TH' as uom_name
,sum(cte.quantity) as quantity
,sum(cte.total_cost) as total_cost
,cte.company_id
from cte
left join product_product pp on pp.id = cte.product_id
left join product_template pt on pt.id = pp.product_tmpl_id
left join uom_uom uom on uom.id = pt.uom_id
group by pt.default_code, pp.id, pt.name, uom.name, cte.company_id)
select
COALESCE(c.company_name_thai,'') AS company_name_thai
,COALESCE(c.company_name_en,'') AS company_name_en
,COALESCE(c.company_tax_id,'') AS company_tax_id
,COALESCE(c.company_branch,'00000') AS company_branch
,encode(c.company_logo,'escape') AS company_logo      
,COALESCE(c.company_address_thai,'') AS company_address_thai
,COALESCE(c.company_address_en,'') AS company_address_en
,COALESCE(c.company_phone,'') AS company_phone
,COALESCE(c.company_fax,'') AS company_fax
,COALESCE(c.company_email,'') AS company_email
,COALESCE(c.company_website,'') AS company_website
,cte2.*
,case when cte2.quantity != 0 then cte2.total_cost / cte2.quantity else 0 end as unit_cost
from cte2
left join company_address_header_report c ON c.id=cte2.company_id
where cte2.quantity != 0
order by cte2.product_code]]>
	</queryString>
