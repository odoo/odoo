	<subDataset name="DETAIL" uuid="6470c85f-c022-45ac-bc06-2ebe067d5046">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Localhost"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="207"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="785"/>
		<parameter name="p_To_Date" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["2023-08-08"]]></defaultValueExpression>
		</parameter>
		<parameter name="p_WhereProduct" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["AND mv.product_id in (296, 297, 298)"]]></defaultValueExpression>
		</parameter>
		<parameter name="p_WhereLocation" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["AND loc_id in (8,27,28)"]]></defaultValueExpression>
		</parameter>
		<parameter name="p_WhereLot" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["AND (mv.lot_id between 77 and 80 or mv.lot_id is null)"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
    format('%s%s', pp.default_code||': ', pt.name->>'th_TH') as product,
    lc.complete_name as location,
    lt.name as lot,
    grp.qty,
    u.name->>'th_TH' as uom,
    grp.value
FROM
(
    SELECT
        product_id, product_uom_id, loc_id, lot_id,
        sum(qty) as qty,
        round(sum(coalesce(value, qty*cum_value/NULLIF(cum_qty,0))),4) as value
    FROM
    (
        SELECT
            mv.product_id,
            mv.product_uom_id,
            loc.id as loc_id,
            mv.lot_id,
            case when vl.quantity = 0 then 0
                when (loc.id = mv.location_dest_id) then mv.quantity
                when (loc.id = mv.location_id) then -mv.quantity
            end as qty,
            case when vl.quantity = 0 then vl.value
                when (loc.id = mv.location_dest_id) then mv.quantity*(vl.value/vl.quantity)
                when (loc.id = mv.location_id) then -mv.quantity*(vl.value/vl.quantity)
            end as value,
            sum(
                case when vl.quantity = 0 then 0
                    when (loc.id = mv.location_dest_id) then mv.quantity
                    when (loc.id = mv.location_id) then -mv.quantity
                end) over w_lot as cum_qty,
            sum(
                case when vl.quantity = 0 then vl.value
                    when (loc.id = mv.location_dest_id) then mv.quantity*(vl.value/vl.quantity)
                    when (loc.id = mv.location_id) then -mv.quantity*(vl.value/vl.quantity)
                end) over w_lot as cum_value
        FROM stock_location loc
        JOIN stock_move_line mv on (mv.location_dest_id = loc.id) OR (mv.location_id = loc.id)
        LEFT JOIN stock_move vl on mv.move_id = vl.id
        WHERE mv.location_dest_id != mv.location_id AND mv.state = 'done' AND loc.usage = 'internal'
            AND mv.date < (to_timestamp('$P!{p_To_Date}', 'YYYY-MM-DD')+Interval '1 day') at time zone 'UTC'
            $P!{p_WhereProduct}
            $P!{p_WhereLot}
        WINDOW w_lot as (partition by mv.product_id, mv.product_uom_id, mv.lot_id order by mv.date, mv.id, vl.id)
        ORDER BY mv.product_id, mv.product_uom_id, mv.date, loc.id, mv.id, vl.id
    ) AS raw
    GROUP BY product_id, product_uom_id, loc_id, lot_id
    HAVING sum(qty) > 0
) AS grp
JOIN stock_location lc ON grp.loc_id = lc.id
JOIN product_product pp ON grp.product_id = pp.id
JOIN product_template pt ON pp.product_tmpl_id = pt.id
JOIN uom_uom u ON grp.product_uom_id = u.id
LEFT JOIN stock_lot lt ON grp.lot_id = lt.id
WHERE 1=1
    $P!{p_WhereLocation}
ORDER BY pp.default_code, pt.name->>'th_TH', pt.id, lc.complete_name, lc.id]]>
		</queryString>
		<field name="product" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="product"/>
		</field>
		<field name="location" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="location"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="stock_location"/>
		</field>
		<field name="lot" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="lot"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="stock_lot"/>
		</field>
		<field name="qty" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="qty"/>
		</field>
		<field name="uom" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="uom"/>
		</field>
		<field name="value" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="value"/>
		</field>
	</subDataset>
