		<defaultValueExpression><![CDATA[" where st.id in(12) "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
generate_series(1, $P{p_Print} ),
co.name as company_name,
barcode,
st.complete_name as name,
NULL::integer as posx,
NULL::integer as posy,
NULL::integer as posz,
FALSE as scrap_location,
FALSE as return_location,
FALSE as manufacturing_location
from stock_location st
left join res_company co on co.id=st.company_id
 $P!{p_Where} 
 
 order by st.id]]>
	</queryString>
