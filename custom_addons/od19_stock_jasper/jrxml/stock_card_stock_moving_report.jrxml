<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="stock_card_stock_moving_report" pageWidth="595" pageHeight="842" columnWidth="587" leftMargin="8" rightMargin="0" topMargin="0" bottomMargin="0" uuid="55b81a43-9398-452d-80a6-05b369a98db1">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="localhost.xml"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="p_Date_As_Off" class="java.lang.String"/>
	<parameter name="p_Product_No" class="java.lang.Integer"/>
	<parameter name="p_WH_No" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT 
      sml.id AS stockmove_id
      ,sml.date AS stockmove_date
      ,sml.location_id AS source_location_id
      
      ,(SELECT a.name
	FROM stock_location a
	WHERE a.id=sml.location_id 
       )AS source_location_name

      ,sml.location_dest_id AS destination_location_id
      
      ,(SELECT a.name
	FROM stock_location a
	WHERE a.id=sml.location_dest_id 
       )AS destination_location_name

      ,(SELECT b.name ->> 'th_TH'
	 FROM product_product a 
	 LEFT JOIN product_template b ON b.id=a.product_tmpl_id
	 WHERE a.id=sml.product_id
	)AS product_name
	  
       ,COALESCE(sml.quantity,0) AS qty
       ,st.code AS stockmove_type
       
FROM stock_move_line sml
LEFT JOIN stock_picking sp ON sp.id=sml.picking_id
LEFT JOIN stock_picking_type st ON st.id=sp.picking_type_id

WHERE  sml.state='done'
AND sml.product_id= $P{p_Product_No} 
AND date(sml.date) <= date( $P{p_Date_As_Off} )
AND EXTRACT(YEAR FROM date(sml.date))=EXTRACT(YEAR FROM date($P{p_Date_As_Off}))]]>
	</queryString>
	<field name="stockmove_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="stockmove_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_move_line"/>
	</field>
	<field name="stockmove_date" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.label" value="stockmove_date"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_move_line"/>
	</field>
	<field name="source_location_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="source_location_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_move_line"/>
	</field>
	<field name="source_location_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="source_location_name"/>
	</field>
	<field name="destination_location_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="destination_location_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_move_line"/>
	</field>
	<field name="destination_location_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="destination_location_name"/>
	</field>
	<field name="product_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="product_name"/>
	</field>
	<field name="qty" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="qty"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_move_line"/>
	</field>
	<field name="stockmove_type" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="stockmove_type"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="stock_picking_type"/>
	</field>
	<variable name="v_Delivery_Qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF($F{stockmove_type}.toString().equals("outgoing") 
	,IF($F{source_location_id}.equals($P{p_WH_No})
		,IF($F{qty}==null,0,$F{qty})
		,0
	)
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_Receive_Qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF($F{stockmove_type}.toString().equals("incoming") 
	,IF($F{destination_location_id}.equals($P{p_WH_No})
		,$F{qty}
		,0
	)
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_Internal_OUT_Qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF($F{stockmove_type}.toString().equals("internal") || $F{stockmove_type}==null 
	,IF($F{source_location_id}.equals($P{p_WH_No})
		,$F{qty}
		,0
	)
	,0
)]]></variableExpression>
	</variable>
	<variable name="v_Internal_IN_Qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[IF($F{stockmove_type}.toString().equals("internal") || $F{stockmove_type}==null 
	,IF($F{destination_location_id}.equals($P{p_WH_No})
		,$F{qty}
		,0
	)
	,0
)]]></variableExpression>
	</variable>
