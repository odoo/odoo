<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        F-IV-001 Stock Card (บัตรสินค้า).

        Inherits the shared wizard layout and is reached from
        Inventory > Reporting > Stock Reports (J-Report OD15).
    -->
    <record id="view_stock_card_report" model="ir.ui.view">
        <field name="name">stock.card.report</field>
        <field name="model">stock.card.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <field name="p_language" required="1" default_focus="1"/>
                    <field name="date_type" required="1"/>
                    <field name="date_format" required="1"/>
                    <field name="date_option" required="1"/>
                    <field name="start_date" invisible="date_option != 'range'" required="date_option == 'range'"/>
                    <field name="end_date" invisible="date_option != 'range'" required="date_option == 'range'"/>
                    <field name="asdate" invisible="date_option != 'asof'" required="date_option == 'asof'"/>
                    <field name="wh"/>
                    <field name="p_Product" widget="many2many_tags"/>
                    <field name="product_category_ids" widget="many2many_tags"/>
                    <field name="company_id"/>
                    <field name="p_EName"/>
                    <field name="p_ESignature"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_stock_card_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Stock Card</field>
        <field name="res_model">stock.card.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_stock_card_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_stock_card_report"
        name="(J-Report OD15) Stock Card"
        parent="menu_stock_report_od15"
        action="action_stock_card_report"
        sequence="70"
    />

</odoo>
