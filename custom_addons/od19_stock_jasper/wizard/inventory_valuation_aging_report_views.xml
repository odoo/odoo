<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        F-IV-007 Product Valuation (Aging) (มูลค่าสินค้า - อายุคงค้าง).

        Inherits the shared wizard layout and is reached from
        Inventory > Reporting > Stock Reports (J-Report OD15).
    -->
    <record id="view_inventory_valuation_aging_report" model="ir.ui.view">
        <field name="name">inventory.valuation.aging.report</field>
        <field name="model">inventory.valuation.aging.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <field name="p_language" required="1" default_focus="1"/>
                    <field name="date_type" required="1"/>
                    <field name="date_format" required="1"/>
                    <field name="p_Days" required="1"/>
                    <field name="p_Start_Date" required="1"/>
                    <field name="p_To_Date" required="1"/>
                    <field name="wh"/>
                    <field name="p_Product" widget="many2many_tags"/>
                    <field name="p_Show_BF_Detail"/>
                    <field name="p_Show_Transaction_Detail"/>
                    <field name="p_Internal"/>
                    <field name="p_oder_by" required="1"/>
                    <field name="p_EName"/>
                    <field name="p_ESignature"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_inventory_valuation_aging_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Product Valuation (Aging)</field>
        <field name="res_model">inventory.valuation.aging.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_inventory_valuation_aging_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_inventory_valuation_aging_report"
        name="(J-Report OD15) Product Valuation (Aging)"
        parent="menu_stock_report_od15"
        action="action_inventory_valuation_aging_report"
        sequence="130"
    />

</odoo>
