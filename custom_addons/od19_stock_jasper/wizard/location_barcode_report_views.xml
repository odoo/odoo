<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        F-IV-014 Location Barcode label (ป้ายบาร์โค้ดตำแหน่ง).
    -->
    <record id="view_location_barcode_report" model="ir.ui.view">
        <field name="name">location.barcode.report</field>
        <field name="model">location.barcode.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <field name="p_Print" required="1" default_focus="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_location_barcode_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Location Barcode</field>
        <field name="res_model">location.barcode.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_location_barcode_report"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">report</field>
    </record>

    <menuitem
        id="menu_location_barcode_report"
        name="(J-Report OD15) Location Barcode"
        parent="menu_stock_report_od15"
        action="action_location_barcode_report"
        sequence="50"
    />

</odoo>
