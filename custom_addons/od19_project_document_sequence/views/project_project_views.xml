<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_project_form_inherit_od19_seq" model="ir.ui.view">
            <field name="name">project.project.form.inherit.od19.seq</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <!-- Move fields out of the title bar into the labelled info group -->
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="od19_project_type"/>
                    <field name="od19_sale_person_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_project_tree_inherit_od19_seq" model="ir.ui.view">
            <field name="name">project.project.list.inherit.od19.seq</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="od19_project_type" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
