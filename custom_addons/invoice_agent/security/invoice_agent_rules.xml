<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================
         Record Rule: Multi-company restriction on extraction lines
         
         Global rules AND together. Group rules OR together.
         This rule has a group, so it ORs with other group rules for
         the same model, then ANDs with global rules.
         
         Domain: user can only see extraction lines belonging to
         companies the user has access to.
         ============================================================ -->
    <record id="invoice_agent_extraction_line_comp_rule" model="ir.rule">
        <field name="name">Invoice Agent: extraction line multi-company</field>
        <field name="model_id" ref="model_invoice_agent_extraction_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('invoice_agent.group_invoice_agent_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Note: account.move records are already protected by account_move_comp_rule
         from the account module. We don't need an additional rule for account.move
         since our groups imply account.group_account_invoice which already has
         the see-all rule (account_move_see_all). The account module handles
         multi-company for account.move via account_move_comp_rule. -->
</odoo>
