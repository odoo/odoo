<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Outbox queue view — invoices waiting to be published to RabbitMQ
         (v0.9: dead-letter column + Requeue button, see
         invoice_agent_job.action_requeue)
         ============================================================ -->
    <record id="view_invoice_agent_job_list" model="ir.ui.view">
        <field name="name">invoice.agent.job.list</field>
        <field name="model">invoice.agent.job</field>
        <field name="arch" type="xml">
            <list string="AMQP Outbox" multi_edit="1"
                  decoration-warning="state == 'pending' and error_message"
                  decoration-danger="state == 'dead'">
                <field name="attachment_id" optional="show"/>
                <field name="job_uuid" optional="show"
                       string="Job UUID"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'dead'"
                       optional="show"/>
                <field name="published_at" optional="show"/>
                <field name="dead_reason" optional="hide"
                       string="Dead-Letter Reason"/>
                <field name="x_death_count" optional="hide"
                       string="x-death Count"/>
                <field name="error_message" optional="hide"/>
                <!-- Requeue: reset a dead-lettered job back to pending so
                     the drain cron republishes it (action_requeue). -->
                <button name="action_requeue" type="object"
                        string="Requeue"
                        icon="fa-rotate-right"
                        class="btn-link"
                        confirm="Requeue this dead-lettered job? It will be republished to RabbitMQ by the drain cron (idempotent by job_uuid)."
                        invisible="state != 'dead'"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_agent_job_search" model="ir.ui.view">
        <field name="name">invoice.agent.job.search</field>
        <field name="model">invoice.agent.job</field>
        <field name="arch" type="xml">
            <search string="Search Queue Jobs">
                <field name="attachment_id"/>
                <field name="state"/>
                <field name="job_uuid"/>
                <separator/>
                <!-- Quick filters: dead-lettered jobs the accountant must
                     review or requeue. -->
                <filter string="Dead-Lettered" name="dead"
                        domain="[('state', '=', 'dead')]"/>
                <filter string="Pending" name="pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Sent" name="sent"
                        domain="[('state', '=', 'sent')]"/>
            </search>
        </field>
    </record>

    <record id="action_invoice_agent_job" model="ir.actions.act_window">
        <field name="name">AMQP Outbox</field>
        <field name="res_model">invoice.agent.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_invoice_agent_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No queued extraction jobs.
            </p>
            <p>
                Rows appear here when the Extract button enqueues a job.
                The drain cron publishes them to RabbitMQ within a minute.
                Jobs the worker dead-lettered land in the Dead-Lettered
                column with the poison reason — use Requeue to re-process.
            </p>
        </field>
    </record>

    <record id="menu_ai_agent_outbox" model="ir.ui.menu">
        <field name="name">AMQP Outbox</field>
        <field name="parent_id" ref="account.menu_finance_payables"/>
        <field name="action" ref="action_invoice_agent_job"/>
        <field name="sequence" eval="16"/>
        <field name="group_ids" eval="[(4, ref('invoice_agent.group_invoice_agent_manager'))]"/>
    </record>
</odoo>
