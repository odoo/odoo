<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================
             ir.cron: OCR pending bills every 2 minutes

             Claims up to 10 pending OCR records per tick (the batch size
             default of account.move._cron_ocr_pending_bills), processing
             each record inside its own commit so one bad scan cannot
             poison the batch.

             Why a cron and not a synchronous flow:
               - A single OCR job takes ~20 s (pdf2image rasterize at 300
                 DPI + Tesseract). Running that inside an HTTP worker would
                 pin a request thread for the duration and pile up under
                 load — the cron keeps the work off the request path.
               - Batch size + max_cron_threads (odoo.conf) bound peak
                 Tesseract concurrency, so a burst of uploaded scans never
                 OOMs the container.

             State flow: pending -> running -> done | failed, all driven by
             account.move._ocr_process_one. Stuck 'running' records are
             recycled by the retry cron in automation_data.xml (which is
             state-agnostic on ocr_state by design; OCR 'running' records
             older than the threshold are reset to 'pending' there via
             _cron_retry_stuck_extractions extended below — see the model).
             ============================================================ -->
        <record id="cron_ocr_pending_bills" model="ir.cron">
            <field name="name">Invoice Agent: OCR Pending Bills</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_ocr_pending_bills(batch_size=10)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- ============================================================
             ir.cron: Claude extraction queue (week 7)

             Consumes moves that finished OCR ('ocr_state == done') and are
             waiting in 'ai_extraction_status == processing'. Each record is
             processed inside its own commit: OCR -> Claude extraction ->
             calibrated confidence scoring -> kanban routing (Auto /
             Needs Review / Approved). Sub-threshold extractions get one
             high-effort Claude pass (effort='high') before final routing.

             This cron is the queue-side twin of the OCR cron: it pairs
             with it to complete the end-to-end scan-to-draft pipeline.
             ============================================================ -->
        <record id="cron_extract_pending_bills" model="ir.cron">
            <field name="name">Invoice Agent: Extract Pending Bills</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_extract_pending_bills(batch_size=5)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">6</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- ============================================================
             ir.cron: RAG vendor-doc embedding backfill (v0.10)

             Embeds posted vendor bills that have no live embedding yet
             (ai_indexed == False) in batches of 100 via
             account.move._cron_backfill_embeddings_all, which runs until
             the corpus is caught up. ai_indexed is the resume marker:
             a restart mid-backfill re-runs from where it stopped without
             re-embedding already-indexed bills, and the UNIQUE(move_id)
             on invoice_agent_vendor_doc makes every retry idempotent.

             When the embed service is unavailable the batch returns 0 and
             keeps ai_indexed=False — the next tick retries. This cron is
             the safety net behind the best-effort live embed on
             action_post.
             ============================================================ -->
        <record id="cron_backfill_embeddings" model="ir.cron">
            <field name="name">Invoice Agent: Backfill Vendor-Doc Embeddings</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_backfill_embeddings_all()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">4</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
