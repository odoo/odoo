<odoo>

    <record id="view_account_payment_form_od19" model="ir.ui.view">
        <field name="name">account.payment.form.od19</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Payer / Payee -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_payer_id"
                       string="ผู้จ่ายเงิน / Payer"/>
                <field name="od19_payee_id"
                       string="ผู้รับเงิน / Payee"/>
            </xpath>

            <!-- WHT section -->
            <xpath expr="//sheet" position="inside">
                <group string="Withholding Tax (WHT)"
                       invisible="payment_type == 'inbound'">
                    <group>
                        <field name="od19_wht_type_id" string="WHT Type"/>
                        <field name="od19_wht_rate" string="WHT Rate"/>
                    </group>
                    <group>
                        <field name="od19_wht_invoice_base_amount"
                               string="WHT Base Amount"
                               readonly="1"/>
                        <field name="od19_wht_invoice_amount"
                               string="WHT Amount"
                               readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
