<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="service_card_view_list" model="ir.ui.view">
        <field name="name">od19.service.card.list</field>
        <field name="model">od19.service.card</field>
        <field name="arch" type="xml">
            <list string="Service Cards">
                <field name="name"/>
                <field name="service_date"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="hide"/>
                <field name="service_type"/>
                <field name="team_id" optional="hide"/>
                <field name="technician_id" optional="hide"/>
                <field name="sla_hours" optional="hide"/>
                <field name="sla_deadline" optional="hide"/>
                <field name="is_sla_breached" optional="hide"/>
                <field name="next_service_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="service_card_view_form" model="ir.ui.view">
        <field name="name">od19.service.card.form</field>
        <field name="model">od19.service.card</field>
        <field name="arch" type="xml">
            <form string="Service Card">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Done" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="service_date"/>
                            <field name="service_type"/>
                            <field name="service_interval"/>
                            <field name="team_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="technician_id"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="next_service_date" readonly="1"/>
                        <field name="user_id"/>
                    </group>
                    <group string="SLA &amp; Time Tracking">
                        <group>
                            <field name="sla_hours"/>
                            <field name="sla_deadline" readonly="1"/>
                            <field name="is_sla_breached" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="service_card_view_search" model="ir.ui.view">
        <field name="name">od19.service.card.search</field>
        <field name="model">od19.service.card</field>
        <field name="arch" type="xml">
            <search string="Service Cards">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="service_type"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="SLA Breached" name="sla_breached" domain="[('is_sla_breached', '=', True)]"/>
                <group>
                    <filter string="Customer" name="partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="product" context="{'group_by': 'product_id'}"/>
                    <filter string="Type" name="type" context="{'group_by': 'service_type'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="service_card_action" model="ir.actions.act_window">
        <field name="name">Service Cards</field>
        <field name="res_model">od19.service.card</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="service_card_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a service card</p>
        </field>
    </record>

    <menuitem id="menu_service_card" name="Service Cards"
              parent="stock.menu_stock_inventory_control" action="service_card_action" sequence="50"/>
</odoo>
