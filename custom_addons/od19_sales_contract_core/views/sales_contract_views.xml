<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_od19_sales_contract_tree" model="ir.ui.view">
        <field name="name">od19.sales.contract.tree</field>
        <field name="model">od19.sales.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="od19_project_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="limit_amount"/>
                <field name="consumed_amount"/>
                <field name="consumed_from_orders"/>
                <field name="over_limit_policy"/>
            </list>
        </field>
    </record>

    <record id="view_od19_sales_contract_form" model="ir.ui.view">
        <field name="name">od19.sales.contract.form</field>
        <field name="model">od19.sales.contract</field>
        <field name="arch" type="xml">
            <form string="Sales Contract">
                <header>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_activate"
                            type="object"
                            string="Activate"
                            class="btn-primary"
                            invisible="state not in ('approved', 'draft')"/>
                    <button name="action_close"
                            type="object"
                            string="Close"
                            class="btn-secondary"
                            invisible="state not in ('approved', 'active')"/>
                    <button name="action_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state != 'closed'"/>
                    <button name="action_create_next_billing_invoice"
                            type="object"
                            string="Create Next Installment Invoice"
                            class="btn-primary"
                            invisible="not billing_line_ids"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,active,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="od19_project_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="over_limit_policy"/>
                        </group>
                        <group>
                            <field name="limit_amount"/>
                            <field name="consumed_amount" readonly="1"/>
                            <field name="consumed_from_orders" readonly="1"/>
                        </group>
                        <group string="Billing">
                            <field name="billing_scheduled_amount" readonly="1"/>
                            <field name="billing_invoiced_amount" readonly="1"/>
                            <field name="billing_remaining_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities">
                            <field name="contract_activity_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="amount_to_consume"/>
                                </list>
                            </field>
                        </page>
                        <page string="Amendments">
                            <field name="amendment_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="added_limit_amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Billing Schedule">
                            <field name="billing_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="line_type"/>
                                    <field name="percent"/>
                                    <field name="amount"/>
                                    <field name="due_date"/>
                                    <field name="progress_percent"/>
                                    <field name="sale_order_id"/>
                                    <field name="state"/>
                                    <field name="invoice_id" readonly="1"/>
                                    <button name="action_create_invoice"
                                            type="object"
                                            string="Create Invoice"
                                            invisible="state == 'invoiced'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_od19_sales_contract" model="ir.actions.act_window">
        <field name="name">Sales Contracts</field>
        <field name="res_model">od19.sales.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_od19_sales_contract"
        name="Sales Contracts"
        parent="sale.sale_menu_root"
        action="action_od19_sales_contract"
        sequence="31"
    />
</odoo>
