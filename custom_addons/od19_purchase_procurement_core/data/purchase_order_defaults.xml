<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Persisted default for purchase.order.order_type.

        Root cause (2026-11-06): migrated/imported Purchase Orders were left with
        an empty order_type, which made the Billing Request wizard abort silently
        with o_field_invalid. The default used to live only in the database
        (ir.default is not tracked by Git), so it is now stored as module data to
        survive database resets/restores.

        The value always resolves to the OCA "Regular" purchase order type via its
        XML ID (purchase_order_type.po_type_regular), never a hardcoded DB id.
        Scoped to the main company so it cannot clash with the OCA constraint that
        a PO and its type must belong to the same company.
    -->
    <record id="ir_default_purchase_order_order_type" model="ir.default">
        <field name="field_id" ref="purchase_order_type.field_purchase_order__order_type"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="json_value" eval="str(ref('purchase_order_type.po_type_regular'))"/>
    </record>
</odoo>
