	</parameter>
	<parameter name="p_locale" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_EName" class="java.lang.Boolean" isForPrompting="false"/>
	<parameter name="p_ESignature" class="java.lang.Boolean" isForPrompting="false"/>
	<parameter name="p_Path" class="java.lang.String" isForPrompting="false"/>
	<parameter name="p_ISO" class="java.lang.String" isForPrompting="false"/>
		<queryString>
		<![CDATA[select po_line.sequence as seq,
c.name as company_name,
       COALESCE(c2.company_name_thai,'') AS company_name_thai
	,COALESCE(c2.company_name_en,'') AS company_name_en
	,COALESCE(c2.company_tax_id,'') AS company_tax_id
	,COALESCE(c2.company_branch,'00000') AS company_branch
	,encode(c2.company_logo,'escape') AS company_logo
	,COALESCE(c2.company_address_thai,'') AS company_address_thai
	,COALESCE(c2.company_address_en,'') AS company_address_en
	,COALESCE(c2.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c2.company_footer_report,'') AS company_footer_report
	,COALESCE(c2.company_phone,'') AS company_phone
	,COALESCE(c2.company_fax,'') AS company_fax
	,COALESCE(c2.company_email,'') AS company_email
	,COALESCE(c2.company_website,'') AS company_website,
       COALESCE(p.complete_name, p.name) as partner_name,
       concat(p.street) as partner_address_1,
       concat(p.street2) as partner_address_2,
       p.ref as partner_code,
       p.vat as partner_tax,
       case when p.branch_code is null then '00000' else p.branch_code end as partner_branch_code,
       p.phone as partner_phone,
       p.mobile as partner_mobile,
       p.fax as partner_fax,
       p.email as partner_email,

	   po.name as po_number,
	   po.date_order as po_date,
	   po.date_planned as po_date_planned,
	   COALESCE(pt.name, '') AS po_payment_term,
       (select string_agg(distinct pr.name, ', ')
        from purchase_request_purchase_order_line_rel as pr_rel
        inner join purchase_request_line prl ON prl.id = pr_rel.purchase_request_line_id
        inner join purchase_request as pr ON pr.id = prl.request_id
        where pr_rel.purchase_order_line_id = po_line.id) AS pr_ref,
	   dept.name->>'th_TH' as po_department,

       po_line.display_type AS display_type,
       pro.default_code AS product_code,
       REPLACE(po_line.name, CONCAT('[', pro.default_code, ']'), '') AS product_name,
       po_line.product_qty AS product_qty,
       COALESCE(uom.name->>'th_TH', uom.name->>'en_US', '') AS product_uom,
       po_line.price_unit AS product_price_unit,
       po_line.discount AS product_discount,
       case when COALESCE(po_line.discount, 0) <> 0 then '%' else '' end AS product_discount_sign,
       po_line.price_subtotal AS product_price_total,

       po.amount_untaxed as po_untaxed_amount,
       0::numeric as po_trade_discount,
       po.amount_untaxed as po_amount_before_tax,
       po.amount_tax as po_tax,
       po.amount_total as po_amount_total,
	   up2.name AS creator_name,

	   cur.symbol as currency_symbol,
       cur.position as currency_position,

	   po.note as remark,
       convert_num_th_with_currency(po.amount_total, po.currency_id) AS po_amount_total_bahttext,
       convert_num_en_with_currency(po.amount_total, po.currency_id) AS po_amount_total_bahttext_en

       -- *********************************************************************************************** For Prepare By
	  ,po.write_date as prepare_date
	  ,po.create_date as create_date

	  ,(SELECT e.name FROM hr_employee e WHERE e.user_id = po.create_uid LIMIT 1) AS prepare_name
	  ,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = po.create_uid LIMIT 1) AS prepare_position
	  ,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = po.create_uid LIMIT 1) AS prepare_department
	  ,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = po.create_uid LIMIT 1) AS prepare_signature

	    -- *********************************************************************************************** For Pre Approval By
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_approved_name
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_department
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_position
	,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) AS pre_date_decided
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_signature

	  -- *********************************************************************************************** For Final Approval By
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_name
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_department
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_position
	,(SELECT reviewed_date FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.order' and res_id=po.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_signature
	 ,(SELECT status FROM tier_review WHERE model='purchase.order' and res_id=po.id ORDER BY sequence DESC LIMIT 1) AS approved_status

from purchase_order_line as po_line
inner join purchase_order as po on po.id = po_line.order_id
inner join res_currency as cur on cur.id = po.currency_id
left outer join hr_department as dept on dept.id = po.department_id
left outer join uom_uom as uom on uom.id = po_line.product_uom_id

inner join res_company as c on c.id = po.company_id
inner join res_partner as cpartner on cpartner.id = c.partner_id
left outer join res_country_state as cp on cp.id = cpartner.state_id
left outer join res_country as cc on cc.id = cpartner.country_id
left outer join company_address_header_report c2 ON c2.id = po.company_id

inner join res_partner as p on p.id = po.partner_id
left outer join res_country_state as pp on pp.id = p.state_id
left outer join res_country as pc on pc.id = p.country_id

left outer join account_payment_term as pt on pt.id = po.payment_term_id
left outer join product_product as pro on pro.id = po_line.product_id
left outer join product_template as prot on prot.id = pro.product_tmpl_id
left outer join res_users as u2 on u2.id = po.write_uid
left outer join res_partner as up2 on up2.id = u2.partner_id
$P!{p_Where}
order by po.id, po_line.sequence, po_line.id]]>
	</queryString>
