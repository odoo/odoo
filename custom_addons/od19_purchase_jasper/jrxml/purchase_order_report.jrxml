+ "    สาขา : " + IF($F{partner_branch_code}.toString().equals("00000"), "สำนักงานใหญ่", $F{partner_branch_code})
+ "\nโทรศัพท์ : " + IF($F{partner_phone}==null, "", $F{partner_phone}) + IF($F{partner_mobile}==null, "", $F{partner_mobile})
+ IF($F{partner_fax}==null, "", ("  แฟกซ์ : " + $F{partner_fax})) 
