		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
		<queryString>
		<![CDATA[SELECT
	ROW_NUMBER () OVER (
   		PARTITION BY p.id
   		ORDER BY p.id, pl.id
	) as seq,
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	--For PR Header
	,COALESCE(p.name,'') AS pr_no
	,p.date_start AS pr_date
	,''::text AS project_name
	,''::text as pr_reason
	,COALESCE(hr.name,'') AS pr_request_by
	,COALESCE(hd.name->>'th_TH','') AS pr_reqeust_department

	--For PR Details
	,pd.id AS product_id
	,COALESCE(pd.default_code,'') AS product_code
	,COALESCE(pt.name->>'th_TH', pt.name->>'en_US', '') AS product_name
	,COALESCE(pl.product_qty,0) AS product_qty

	,CASE WHEN pt.type = 'service' THEN 0 ELSE COALESCE((SELECT sum(quantity)
			FROM stock_quant a
			WHERE a.product_id=pd.id AND a.company_id=c.id
			),0) END AS product_qty_onhand

	,0::numeric AS product_qty_forecast

	,COALESCE((SELECT product_min_qty
			FROM stock_warehouse_orderpoint a
			WHERE a.product_id=pd.id AND a.company_id=c.id limit 1
			),0)AS product_qty_min

	,COALESCE((SELECT product_max_qty
			FROM stock_warehouse_orderpoint a
			WHERE a.product_id=pd.id AND a.company_id=c.id limit 1
			),0)AS product_qty_max

	,COALESCE(pu.name->>'th_TH', pu.name->>'en_US','') AS product_uom

	,COALESCE((SELECT sum(a.product_uom_qty)
			FROM sale_order_line a
			WHERE a.product_id=pd.id AND a.company_id=c.id AND date_part('year',a.create_date) = date_part('year',current_date)
			),0)AS product_all_sale_qty

	,COALESCE((SELECT sum(a.price_total)
			FROM sale_order_line a
			WHERE a.product_id=pd.id AND a.company_id=c.id AND date_part('year',a.create_date) = date_part('year',current_date)
			),0)AS product_all_sale_amount

	,COALESCE(pt.list_price,0) AS product_sale_price

	,p.state AS state
	  -- *********************************************************************************************** For Prepare By
	  ,p.write_date as prepare_date
	  ,p.create_date as create_date

	  ,(SELECT e.name FROM hr_employee e WHERE e.user_id = p.create_uid LIMIT 1) AS prepare_name
	  ,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = p.create_uid LIMIT 1) AS prepare_position
	  ,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = p.create_uid LIMIT 1) AS prepare_department
	  ,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = p.create_uid LIMIT 1) AS prepare_signature

	   -- *********************************************************************************************** For Pre Approval By
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_approved_name
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_department
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_position
	,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) AS pre_date_decided
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_signature

	  -- *********************************************************************************************** For Final Approval By
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_name
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_department
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_position
	,(SELECT reviewed_date FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = (SELECT done_by FROM tier_review WHERE model='purchase.request' and res_id=p.id and status='approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_signature
	 -- ***********************************************************************************************
	 ,(SELECT status FROM tier_review WHERE model='purchase.request' and res_id=p.id ORDER BY sequence DESC LIMIT 1) AS approved_status

FROM purchase_request p
	LEFT JOIN company_address_header_report c ON c.id=p.company_id
	LEFT JOIN hr_employee hr on hr.user_id = p.requested_by
	LEFT JOIN hr_version hv on hv.id = hr.current_version_id
	LEFT JOIN hr_department hd on hd.id=hv.department_id
	LEFT JOIN purchase_request_line pl on pl.request_id=p.id
	LEFT JOIN product_product pd on pd.id=pl.product_id
	LEFT JOIN uom_uom pu on pu.id=pl.product_uom_id
	LEFT JOIN product_template pt on pt.id=pd.product_tmpl_id
 $P!{p_PRNo}
 order by p.id, pl.id]]>
	</queryString>
