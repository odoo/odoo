		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
		<queryString>
		<![CDATA[SELECT
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	,pn.name AS vendor_name
	,ai.name AS vendor_bill_no
	,ai.invoice_date AS vendor_bill_date
	,ai.amount_total AS vendor_bill_amount
	,ai.ref AS reference
	,cu.name AS curency_name
	, sp.name AS receive_no
	, sp.scheduled_date AS receive_date
	,po.name as origin
	,po.date_order as origin_date
	,ai.state AS state

	,(SELECT e.name
	    FROM hr_employee e
	    WHERE e.user_id= $P{p_User_ID}  limit 1
	  ) AS reqeust_by

	,(SELECT e.name
	    FROM hr_employee e
	    WHERE e.user_id= $P{p_User_ID}  limit 1
	  ) AS prepare_name

	 ,(SELECT d.name->>'th_TH'
	    FROM hr_employee e
	    LEFT JOIN hr_version v ON v.id=e.current_version_id
	    LEFT JOIN hr_department d ON d.id=v.department_id
	    WHERE e.user_id= $P{p_User_ID}  limit 1
	  ) AS department_name

	 ,(SELECT j.name->>'th_TH'
	    FROM hr_employee e
	    LEFT JOIN hr_version v ON v.id=e.current_version_id
	    LEFT JOIN hr_job j ON j.id=v.job_id
	    WHERE e.user_id= $P{p_User_ID}  limit 1
	  ) AS position_name

	  ,(SELECT a.store_fname
	    FROM ir_attachment a
	    LEFT JOIN hr_employee e ON e.id=a.res_id
	    WHERE a.res_model='hr.employee' AND a.res_field='signature' AND e.user_id= $P{p_User_ID} limit 1
	  ) AS prepare_signature

FROM account_move ai
LEFT JOIN account_move_line al on al.move_id=ai.id and al.company_id=ai.company_id
LEFT JOIN company_address_header_report c ON c.id=ai.company_id
LEFT JOIN res_currency cu ON cu.id=ai.currency_id
LEFT JOIN res_partner pn ON pn.id=ai.partner_id
LEFT JOIN purchase_order_line pl ON pl.id = al.purchase_line_id
LEFT JOIN purchase_order po on po.id = pl.order_id
LEFT JOIN stock_move sm ON sm.purchase_line_id = pl.id
LEFT JOIN stock_picking sp ON sp.id = sm.picking_id

WHERE
	 ai.move_type like'in%' AND al.display_type = 'product'
 AND
 	ai.invoice_date BETWEEN   date($P{p_StartDate}) AND date($P{p_ToDate})
 AND
	not(ai.state in('draft','cancel'))

$P!{p_VendorID}

Group By
	c.id
	,c.company_name_thai
	,c.company_name_en
	,company_tax_id
	,company_branch
	,encode(c.company_logo,'escape')
	,c.company_address_thai
	,c.company_address_en
	,c.company_heaer_report
	,c.company_footer_report
	,c.company_phone
	,c.company_fax
	,c.company_email
	,c.company_website

	,pn.name
	,ai.name
	,ai.invoice_date
	,ai.amount_total
	,ai.ref
	,cu.name
	, sp.name
	, sp.scheduled_date
	,po.name
	,po.date_order
	,ai.state

ORDER By pn.name,ai.name,ai.invoice_date]]>
	</queryString>
