<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        r_p_002 Received Purchase Order By Period
        (ใบสั่งซื้อที่รับแล้วตามช่วงเวลา).

        Reachable from Purchase > Reporting > Purchases Report (J-Report OD15).
    -->
    <record id="view_received_purchase_order_period_report" model="ir.ui.view">
        <field name="name">received.purchase.order.period.report</field>
        <field name="model">received.purchase.order.period.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language" required="1" default_focus="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                        <field name="startdate" required="1"/>
                        <field name="todate" required="1"/>
                    </group>
                    <group>
                        <field name="p_EName"/>
                        <field name="p_ESignature"/>
                        <field name="partner" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <button name="action_clear_partner"
                                type="object"
                                string="Clear"
                                class="btn-link"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_received_purchase_order_period_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Received Order By Period</field>
        <field name="res_model">received.purchase.order.period.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_received_purchase_order_period_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_received_purchase_order_period_report"
        name="(J-Report OD15) Received Order By Period"
        parent="menu_purchases_report_od15"
        action="action_received_purchase_order_period_report"
        sequence="30"
    />

</odoo>
