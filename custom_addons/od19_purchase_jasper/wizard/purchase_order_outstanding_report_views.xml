<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        r_p_003 Purchase Order Outstanding By Period (รายการใบสั่งซื้อค้างรับ).

        Reachable from Purchase > Reporting > Purchases Report (J-Report OD15).
    -->
    <record id="view_purchase_order_outstanding_report" model="ir.ui.view">
        <field name="name">purchase.order.outstanding.report</field>
        <field name="model">purchase.order.outstanding.report</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <group>
                        <field name="p_language" required="1" default_focus="1"/>
                        <field name="date_type" required="1"/>
                        <field name="date_format" required="1"/>
                        <field name="startdate" required="1"/>
                        <field name="todate" required="1"/>
                    </group>
                    <group>
                        <field name="p_EName"/>
                        <field name="p_ESignature"/>
                        <field name="p_Show_Picture"/>
                        <field name="partner" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <button name="action_clear_partner"
                                type="object"
                                string="Clear"
                                class="btn-link"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_purchase_order_outstanding_report" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Purchase Order Outstanding By Period</field>
        <field name="res_model">purchase.order.outstanding.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_purchase_order_outstanding_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_purchase_order_outstanding_report"
        name="(J-Report OD15) Purchase Order Outstanding By Period"
        parent="menu_purchases_report_od15"
        action="action_purchase_order_outstanding_report"
        sequence="20"
    />

</odoo>
