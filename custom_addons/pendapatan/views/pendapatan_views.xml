<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- 1. TREE VIEW                                                 -->
    <!-- ============================================================ -->
    <record id="view_pendapatan_list" model="ir.ui.view">
        <field name="name">pendapatan.pendapatan.list</field>
        <field name="model">pendapatan.pendapatan</field>
        <field name="arch" type="xml">
            <list string="Daftar Pendapatan"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Nomor"/>
                <field name="tanggal" string="Tanggal"/>
                <field name="category_id" string="Kategori"/>
                <field name="period_label" string="Label Periode"/>
                <field name="company_id" string="Perusahaan"/>
                <field name="department_id" string="Departemen"/>
                <field name="amount" string="Nominal" sum="Total Pendapatan"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'posted')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 2. FORM VIEW                                                 -->
    <!-- ============================================================ -->
    <record id="view_pendapatan_form" model="ir.ui.view">
        <field name="name">pendapatan.pendapatan.form</field>
        <field name="model">pendapatan.pendapatan</field>
        <field name="arch" type="xml">
            <form string="Pendapatan">
                <header>
                    <button name="action_submit" string="Ajukan"
                            type="object" class="oe_highlight"
                            groups="pendapatan.group_pendapatan_user"
                            invisible="state != 'draft' or finance_central_readonly"/>
                    <button name="action_approve" string="Setujui"
                            type="object" class="oe_highlight"
                            groups="pendapatan.group_pendapatan_manager"
                            invisible="state != 'submitted' or finance_central_readonly"/>
                    <button name="action_reject" string="Tolak / Revisi"
                            type="object"
                            groups="pendapatan.group_pendapatan_manager"
                            invisible="state != 'submitted' or finance_central_readonly"/>
                    <button name="action_post" string="Posting (Buat Jurnal)"
                            type="object" class="oe_highlight"
                            groups="pendapatan.group_pendapatan_manager"
                            invisible="state != 'approved' or finance_central_readonly"/>
                    <button name="action_cancel" string="Batalkan"
                            type="object"
                            groups="pendapatan.group_pendapatan_manager"
                            invisible="state in ('draft', 'cancelled', 'posted') or finance_central_readonly"/>
                    <button name="action_reset_to_draft" string="Reset ke Draft"
                            type="object"
                            groups="pendapatan.group_pendapatan_manager"
                            invisible="state in ('draft', 'posted', 'cancelled') or finance_central_readonly"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <field name="finance_central_readonly" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Nomor Pendapatan"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group string="Informasi Pendapatan">
                            <field name="tanggal" readonly="finance_central_readonly"/>
                            <field name="company_id" readonly="1"/>
                            <field name="department_id"
                                   required="1"
                                   readonly="finance_central_readonly"
                                   domain="[('company_id', '=', company_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="category_id"
                                   readonly="finance_central_readonly"
                                   domain="[('company_id', '=', company_id), ('active', '=', True)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="period_label"
                                   readonly="finance_central_readonly"
                                   placeholder='Contoh: "Januari 2026" atau "Semester Genap 2025/2026"'/>
                            <field name="amount" widget="monetary"
                                   readonly="finance_central_readonly"
                                   options="{'currency_field': 'currency_id', 'no_edit_currency': True}"/>
                        </group>
                        <group string="Detail">
                            <field name="source_partner_id"
                                   readonly="finance_central_readonly"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="attachment" filename="name" widget="binary"
                                   readonly="finance_central_readonly"/>
                        </group>
                    </group>
                    <group string="Keterangan">
                        <field name="description" nolabel="1"
                               readonly="finance_central_readonly"
                               placeholder="Uraian detail pendapatan (opsional)..."/>
                    </group>
                    <notebook>
                        <page string="Workflow / Approval"
                              groups="pendapatan.group_pendapatan_manager">
                            <group>
                                <group>
                                    <field name="submitted_by_id" readonly="1"/>
                                    <field name="submitted_date" readonly="1"/>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="posted_by_id" readonly="1"/>
                                    <field name="posted_date" readonly="1"/>
                                    <field name="cancel_reason"
                                           readonly="finance_central_readonly"
                                           placeholder="Wajib diisi jika ada pembatalan"/>
                                </group>
                            </group>
                        </page>
                        <page string="Jurnal Terkait"
                              invisible="not journal_id">
                            <group>
                                <field name="journal_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 3. SEARCH VIEW                                              -->
    <!-- ============================================================ -->
    <record id="view_pendapatan_search" model="ir.ui.view">
        <field name="name">pendapatan.pendapatan.search</field>
        <field name="model">pendapatan.pendapatan</field>
        <field name="arch" type="xml">
            <search string="Pencarian Pendapatan">
                <field name="name" string="Nomor"/>
                <field name="period_label" string="Label Periode"/>
                <field name="department_id" string="Departemen"/>
                <field name="company_id" string="Perusahaan"/>
                <field name="category_id" string="Kategori"/>
                <field name="source_partner_id" string="Pemberi"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Diajukan" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Disetujui" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Terposting" name="filter_posted"
                        domain="[('state', '=', 'posted')]"/>
                <filter string="Dibatalkan" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Per Kategori" name="group_category"
                        context="{'group_by': 'category_id'}"/>
                <filter string="Per Departemen" name="group_department"
                        context="{'group_by': 'department_id'}"/>
                <filter string="Per Perusahaan" name="group_company"
                        context="{'group_by': 'company_id'}"/>
                <filter string="Per Tanggal (Bulan)" name="group_date_month"
                        context="{'group_by': 'tanggal:month'}"/>
                <filter string="Per Status" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 4. ACTIONS                                                  -->
    <!-- ============================================================ -->
    <record id="action_pendapatan_all" model="ir.actions.act_window">
        <field name="name">Daftar Pendapatan</field>
        <field name="res_model">pendapatan.pendapatan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pendapatan_search"/>
    </record>
</odoo>
