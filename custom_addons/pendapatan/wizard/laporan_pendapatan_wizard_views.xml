<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pendapatan_laporan_wizard_form" model="ir.ui.view">
        <field name="name">pendapatan.laporan.wizard.form</field>
        <field name="model">pendapatan.laporan.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Laporan Pendapatan">
                <sheet>
                    <div class="oe_title">
                        <h2>Filter Laporan Pendapatan</h2>
                    </div>
                    <group>
                        <group string="Rentang Tanggal (Opsional)">
                            <field name="date_from" string="Tanggal Awal"
                                   placeholder="Kosongkan jika semua tanggal"/>
                            <field name="date_to" string="Tanggal Akhir"
                                   placeholder="Kosongkan jika semua tanggal"/>
                        </group>
                        <group string="Filter Tambahan">
                            <field name="company_id" string="Perusahaan"/>
                            <field name="category_id" string="Kategori"
                                   options="{'no_create': True}"
                                   placeholder="Kosongkan jika semua kategori"/>
                        </group>
                    </group>
                    <group>
                        <group string="Filter Lanjutan">
                            <field name="department_id" string="Departemen"
                                   options="{'no_create': True}"
                                   placeholder="Kosongkan jika semua departemen"/>
                            <field name="state" string="Status"/>
                        </group>
                        <group string="Tampilan">
                            <field name="group_by" string="Kelompokkan"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_tampilkan_laporan"
                                string="Tampilkan Laporan"
                                type="object" class="btn-primary"/>
                        <button string="Batal"
                                class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pendapatan_laporan_wizard" model="ir.actions.act_window">
        <field name="name">Laporan Pendapatan</field>
        <field name="res_model">pendapatan.laporan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
