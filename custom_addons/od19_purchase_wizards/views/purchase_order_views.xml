<odoo>

    <record id="purchase_order_form_inherit_od19" model="ir.ui.view">
        <field name="name">purchase.order.form.od19</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_od19_trade_discount"
                        type="object"
                        string="Trade Discount"
                        invisible="state != 'draft'"
                        groups="purchase.group_purchase_user"/>
                <button name="action_od19_create_vendor_bill"
                        type="object"
                        string="Create Bill"
                        invisible="state not in ('purchase', 'done')"
                        class="oe_highlight"
                        groups="account.group_account_invoice"/>
            </header>
            <field name="partner_ref" position="after">
                <field name="od19_your_ref"/>
            </field>
        </field>
    </record>

</odoo>
