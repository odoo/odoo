<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cheque_list" model="ir.ui.view">
        <field name="name">account.cheque.list</field>
        <field name="model">account.cheque</field>
        <field name="arch" type="xml">
            <list string="Cheques" create="1" delete="1">
                <field name="name"/>
                <field name="cheque_date"/>
                <field name="due_date"/>
                <field name="cheque_type"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="journal_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft' or state == 'available'"
                       decoration-warning="state == 'confirmed' or state == 'to_pay' or state == 'deposited'"
                       decoration-success="state in ('cleared', 'paid')"
                       decoration-danger="state == 'bounced' or state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_account_cheque_form" model="ir.ui.view">
        <field name="name">account.cheque.form</field>
        <field name="model">account.cheque</field>
        <field name="arch" type="xml">
            <form string="Cheque">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            invisible="state not in ('available', 'draft')"/>
                    <button name="action_to_pay" type="object" string="To Pay"
                            invisible="state != 'confirmed'"/>
                    <button name="action_deposit" type="object" string="Deposit"
                            invisible="state not in ('confirmed', 'to_pay')"/>
                    <button name="action_clear" type="object" string="Clear"
                            invisible="state != 'deposited'"/>
                    <button name="action_paid" type="object" string="Mark Paid"
                            invisible="state not in ('to_pay', 'deposited', 'cleared')"/>
                    <button name="action_bounce" type="object" string="Bounce"
                            invisible="state not in ('confirmed', 'deposited', 'cleared')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cleared', 'paid', 'cancelled')"/>
                    <button name="action_back_to_available" type="object"
                            string="Back to Available"
                            invisible="not cheque_book_id or state not in ('confirmed', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            invisible="state not in ('confirmed', 'to_pay', 'deposited', 'cleared', 'paid')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,draft,confirmed,to_pay,deposited,cleared,paid,bounced,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_print_cheque" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <span>Print Cheque</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cheque_type"/>
                            <field name="cheque_book_id" readonly="1"/>
                            <field name="journal_id"/>
                            <field name="partner_id"/>
                            <field name="pay_to"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="cheque_date"/>
                            <field name="due_date"/>
                            <field name="clear_date"/>
                            <field name="ac_payee"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bank_id"/>
                            <field name="bank_branch"/>
                            <field name="memo"/>
                        </group>
                        <group>
                            <field name="payment_id" readonly="1"/>
                            <field name="received_move_id" readonly="1"/>
                            <field name="deposited_move_id" readonly="1"/>
                            <field name="issue_move_id" readonly="1"/>
                            <field name="paid_move_id" readonly="1"/>
                            <field name="paid_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_cheque_search" model="ir.ui.view">
        <field name="name">account.cheque.search</field>
        <field name="model">account.cheque</field>
        <field name="arch" type="xml">
            <search string="Search Cheques">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="journal_id"/>
                <filter string="Customer" name="customer" domain="[('cheque_type', '=', 'customer')]"/>
                <filter string="Supplier" name="supplier" domain="[('cheque_type', '=', 'supplier')]"/>
                <separator/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="To Pay" name="to_pay" domain="[('state', '=', 'to_pay')]"/>
                <filter string="Deposited" name="deposited" domain="[('state', '=', 'deposited')]"/>
                <filter string="Cleared" name="cleared" domain="[('state', '=', 'cleared')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Bounced" name="bounced" domain="[('state', '=', 'bounced')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="action_account_cheque" model="ir.actions.act_window">
        <field name="name">Cheques</field>
        <field name="res_model">account.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_customer': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new cheque
            </p>
        </field>
    </record>

    <menuitem
        id="menu_account_cheque"
        name="Cheques"
        parent="account.menu_finance"
        action="action_account_cheque"
        sequence="11"
    />

</odoo>
