<odoo>
    <record id="rka_budget_company_rule" model="ir.rule">
        <field name="name">RKA: allowed companies</field>
        <field name="model_id" ref="model_sif_rka_budget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rka_month_company_rule" model="ir.rule">
        <field name="name">RKA monthly budget: allowed companies</field>
        <field name="model_id" ref="model_sif_rka_budget_month"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
