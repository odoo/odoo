<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the mileage-category flag next to "can be expensed" on the
         product form. Only shown when the product can be expensed. -->
    <record id="view_product_template_od19_mileage_category" model="ir.ui.view">
        <field name="name">product.template.form.inherit.od19.mileage.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="hr_expense.view_product_hr_expense_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='can_be_expensed']/.." position="after">
                <span class="d-inline-flex" invisible="not can_be_expensed">
                    <field name="od19_is_mileage_category"/>
                    <label for="od19_is_mileage_category"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
