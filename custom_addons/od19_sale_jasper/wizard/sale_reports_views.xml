<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  F-S-003 Quotation Form (ใบเสนอราคา)                          -->
    <!-- ============================================================ -->
    <record id="view_sale_quotation_form" model="ir.ui.view">
        <field name="name">sale.quotation.form</field>
        <field name="model">sale.quotation.form</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="od19_reporting_jasper.view_jasper_report_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='parameters']" position="replace">
                <group name="parameters" invisible="state != 'input'">
                    <field name="p_language" required="1" default_focus="1"/>
                    <field name="date_type" required="1"/>
                    <field name="date_format" required="1"/>
                    <field name="p_EName"/>
                    <field name="p_ESignature"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_sale_quotation_form" model="ir.actions.act_window">
        <field name="name">(J-Report OD15) Quotation Form</field>
        <field name="res_model">sale.quotation.form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_quotation_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="context">{'iscopy': 0}</field>
    </record>

