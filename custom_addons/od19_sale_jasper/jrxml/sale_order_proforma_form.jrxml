	<queryString>
		<![CDATA[SELECT sl.sequence as seq
	,c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website
	,so.id AS so_id
	,so.name
	,so.date_order AS confirmation_date
	,EXTRACT(YEAR FROM date(so.date_order)) AS sale_year
	,EXTRACT(MONTH FROM date(so.date_order)) AS sale_month
	,to_char(so.date_order, 'YYYY-MM') AS sale_year_month
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = so.user_id LIMIT 1) AS sale_name
	,pn.ref AS customer_code
	,pn.complete_name AS customer_name
	,COALESCE(pn.name,'') AS customer_contact
	,COALESCE(pn.phone,'') AS customer_phone
	,COALESCE(pn.fax,'') AS customer_fax
	,COALESCE(pn.vat,'') AS customer_tax
	,COALESCE(pn.branch_code,'') AS customer_branch
	,COALESCE((SELECT p.name FROM res_partner p WHERE p.id = so.partner_shipping_id),'') AS customer_shipping_name
	,COALESCE((SELECT rp.name_en FROM hr_employee e LEFT JOIN res_partner rp ON rp.id = e.work_contact_id WHERE e.user_id = so.user_id LIMIT 1),'') AS sale_person1_en
	,COALESCE((SELECT e.name FROM hr_employee e WHERE e.user_id = so.user_id LIMIT 1),'') AS sale_person1_thai
	,COALESCE((SELECT e.mobile_phone FROM hr_employee e WHERE e.user_id = so.user_id LIMIT 1),'') AS sale_person1_mobile_phone
	,COALESCE((SELECT e.work_phone FROM hr_employee e WHERE e.user_id = so.user_id LIMIT 1),'') AS sale_person1_work_phone
	,'' AS sale_person2_en
	,'' AS sale_person2_thai
	,'' AS sale_person2_mobile_phone
	,'' AS sale_person2_work_phone
	,COALESCE(pn1.complete_name,'') AS customer_shipping_contact
	,COALESCE(pn1.phone,'') AS customer_shipping_phone
	,COALESCE(pn1.fax,'') AS customer_shipping_fax
	,COALESCE(pn1.branch_code,'') AS customer_shipping_branch
	,COALESCE(pn2.complete_name,'') AS customer_invoice_contact
	,COALESCE(pn2.phone,'') AS customer_invoice_phone
	,COALESCE(pn2.fax,'') AS customer_invoice_fax
	,COALESCE(pn2.branch_code,'') AS customer_invoice_branch
	,(SELECT COALESCE(a.name->>'th_TH', a.name->>'en_US', '') FROM account_payment_term a WHERE a.id = so.payment_term_id) AS payment_term
	,pn.street AS partner_address
	,pn.street2 AS partner_address2
	,pn1.street AS partner_shipping_address
	,pn1.street2 AS partner_shipping_address2
	,pn2.street AS partner_invoice_address
	,pn2.street2 AS partner_invoice_address2
	,so.commitment_date::date AS plan_delivery_date
	,so.effective_date
	,sl.name AS product_name
	,sl.product_uom_qty AS so_qty
	,COALESCE(pu.name->>'th_TH', pu.name->>'en_US', '') AS product_uom
	,sl.price_unit AS product_unitprice
	,sl.discount AS product_discount
	,sl.price_reduce_taxexcl AS price_reduce
	,sl.price_subtotal
	,so.note
	,(SELECT max(b.amount)
		FROM account_tax_sale_order_line_rel a
		LEFT JOIN account_tax b ON b.id = a.account_tax_id
		LEFT JOIN sale_order_line c ON c.id = a.sale_order_line_id
		LEFT JOIN sale_order d ON d.id = c.order_id
		WHERE d.id = so.id) AS so_taxes
	,(SELECT a.name FROM res_currency a WHERE a.id = sl.currency_id) AS currency_name
	,so.currency_rate AS exchange_rate
	,so.client_order_ref
	,so.state
	,so.amount_untaxed
	,0::numeric AS amount_trade_discount
	,so.amount_untaxed AS amount_untaxed_before_trade_discount
	,so.amount_untaxed AS amount_untaxed_trade_discount
	,so.amount_untaxed AS amount_subtotal_before_tax
	,so.amount_tax
	,so.amount_total
	,convert_num_th_with_currency(so.amount_total, sl.currency_id) AS so_amout_total_bahttext
	,convert_num_en_with_currency(so.amount_total, sl.currency_id) AS so_amout_total_engtext
	,sl.price_subtotal AS amount_total_item
	,sl.product_uom_qty
	,sl.qty_delivered
	,sl.display_type
	,so.write_date AS prepare_date
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = so.create_uid LIMIT 1) AS prepare_name
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = so.create_uid LIMIT 1) AS prepare_position
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = so.create_uid LIMIT 1) AS prepare_department
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = so.create_uid LIMIT 1) AS prepare_signature
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_approved_name
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_department
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_position
	,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) AS pre_date_decided
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1) LIMIT 1) AS pre_signature
	,(SELECT e.name FROM hr_employee e WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_name
	,(SELECT d.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_department d ON d.id = v.department_id WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_department
	,(SELECT j.name->>'th_TH' FROM hr_employee e LEFT JOIN hr_version v ON v.id = e.current_version_id LEFT JOIN hr_job j ON j.id = v.job_id WHERE e.user_id = (SELECT done_by FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_position
	,(SELECT reviewed_date FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
	,(SELECT a.store_fname FROM ir_attachment a LEFT JOIN hr_employee e ON e.id = a.res_id WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = (SELECT done_by FROM tier_review WHERE model = 'sale.order' AND res_id = so.id AND status = 'approved' ORDER BY sequence DESC LIMIT 1) LIMIT 1) AS approved_signature
FROM sale_order so
LEFT JOIN sale_order_line sl ON sl.order_id = so.id
LEFT JOIN company_address_header_report c ON c.id = so.company_id
LEFT JOIN res_partner pn ON pn.id = so.partner_id
LEFT JOIN res_partner pn1 ON pn1.id = so.partner_shipping_id
LEFT JOIN res_partner pn2 ON pn2.id = so.partner_invoice_id
LEFT JOIN uom_uom pu ON pu.id = sl.product_uom_id
$P!{p_Where}
ORDER BY so.id, sl.sequence, sl.id]]>
	</queryString>
