	<parameter name="p_Condition" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[" where a.company_id = 1 and  a.state ='done'  or a.company_id = 1 and  a.state ='sale'"]]></defaultValueExpression>
	</parameter>
