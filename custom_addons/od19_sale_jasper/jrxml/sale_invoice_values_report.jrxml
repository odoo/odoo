	<queryString>
		<![CDATA[SELECT
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

		,a.id,a.name as so_name,a.date_order,a.state,a.amount_total,COALESCE(a.client_order_ref,'')AS client_order_ref,a.currency_rate AS exchange_rate
		,aa.name as product_name,COALESCE(uom.name->>'th_TH', uom.name->>'en_US','') as uom_name,
		aa.product_uom_qty as qty_ordered,aa.qty_delivered,aa.qty_invoiced,aa.price_unit as unit_price,aa.price_subtotal as sub_total
		
		,(SELECT e.name
	    	FROM hr_employee e
	    	WHERE e.user_id = a.user_id limit 1
	  	  ) AS sale_person1
		  
		  ,'' AS sale_person2
		 
		,(SELECT b.display_name
		  FROM res_partner b
		  WHERE b.id=a.partner_id
		 )AS partner_name
		 
		 ,(SELECT c.name
		  FROM product_pricelist b
		  LEFT JOIN res_currency c ON c.id=b.currency_id
		  WHERE b.id=a.pricelist_id
		 )AS currency
		 
		 ,COALESCE((CASE $P{p_Group}
		 	WHEN  1
		 		THEN aa.name
		 	WHEN 2
		 		THEN COALESCE(pc.name,'')
		 	WHEN 3
		 		THEN ''
		 	WHEN 4
		 		THEN res.name
		 	WHEN 5
		 		THEN a.name
		 	ELSE 
		   		COALESCE((SELECT h.name
						FROM hr_employee h
						WHERE h.user_id = a.user_id  limit 1),'')
		 	END
		   ),'')AS group_report
					
	--**********************************************************************************************************
	,(SELECT b.name
	    FROM hr_employee b 
	    WHERE b.user_id = $P{p_User_ID}  limit 1
	  ) AS reqeust_by
	  
	,(SELECT e.name 
	    FROM hr_employee e 
	    WHERE e.user_id = $P{p_User_ID}  limit 1
	  ) AS prepare_name
	  
	 ,(SELECT d.name->>'th_TH' 
	    FROM hr_employee e 
	    LEFT JOIN hr_version v ON v.id = e.current_version_id
	    LEFT JOIN hr_department d ON d.id = v.department_id
	    WHERE e.user_id = $P{p_User_ID}  limit 1
	  ) AS department_name
	  
	 ,(SELECT j.name->>'th_TH' 
	    FROM hr_employee e 
	    LEFT JOIN hr_version v ON v.id = e.current_version_id
	    LEFT JOIN hr_job j ON j.id = v.job_id
	    WHERE e.user_id = $P{p_User_ID}  limit 1
	  ) AS position_name
	  
	  ,(SELECT a.store_fname 
	    FROM ir_attachment a 
	    LEFT JOIN hr_employee e ON e.id = a.res_id
	    WHERE a.res_model = 'hr.employee' AND a.res_field = 'signature' AND e.user_id = $P{p_User_ID}  limit 1
	  ) AS prepare_signature
	 
FROM sale_order a
LEFT JOIN sale_order_line  aa on aa.order_id=a.id
LEFT JOIN uom_uom uom on uom.id=aa.product_uom_id
LEFT JOIN res_partner res on res.id=a.partner_id
LEFT JOIN product_product pp on pp.id=aa.product_id
LEFT JOIN product_template pt on pt.id=pp.product_tmpl_id
LEFT JOIN product_category pc on pc.id=pt.categ_id
LEFT JOIN company_address_header_report c ON c.id = a.company_id

WHERE a.state ='done' AND date(a.date_order) BETWEEN  date($P{p_Start_Date})  AND date($P{p_To_Date})
			  OR
			  a.state ='sale' AND date(a.date_order) BETWEEN  date($P{p_Start_Date})  AND date($P{p_To_Date})
ORDER BY 	
			(CASE $P{p_Group} 
		 	WHEN  1
		 		THEN aa.name
		 	WHEN 2
		 		THEN COALESCE(pc.name,'')
		 	WHEN 3
		 		THEN ''
		 	WHEN 4
		 		THEN res.name
		 	WHEN 5
		 		THEN a.name
		 	ELSE 
		   		COALESCE((SELECT h.name
						FROM hr_employee h
						WHERE h.user_id = a.user_id  limit 1),'')
		 	END
		   )]]>
	</queryString>
