	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA[" where claim.id in (0) "]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["thai"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
	claim.id as wc_id,
	claim.name as warraty_name,
	coalesce(claim.warranty_start_date, pd.warranty_start_date) as install_date,
	coalesce(pd.warranty_end_date,
		case when claim.warranty_start_date is not null
			then claim.warranty_start_date + (case pt.warranty_type when 'days' then pt.warranty_duration when 'months' then pt.warranty_duration * 30 when 'years' then pt.warranty_duration * 365 else 0 end) * interval '1 day'
		end)::date as exp_date,
	coalesce(res.name, '-') as partner_name,
	coalesce(pp.default_code, '-') as internal_ref,
	coalesce(pt.name->>'th_TH', pt.name->>'en_US', '-') as product_name,
	case when pt.tracking = 'lot' then pd.name else coalesce(pd.ref, '-') end as lot_name,
	case when pt.tracking = 'serial' then pd.name else '-' end as serial_name,
	coalesce((select am.name from account_move am
		where am.move_type = 'out_invoice'
		and am.invoice_origin = (select so.name from repair_order ro left join sale_order so on so.id = ro.sale_order_id where ro.id = claim.repair_order_id limit 1)
		order by am.id desc limit 1), '-') as invoice_name
from od19_warranty_claim claim
left join res_partner res on res.id = claim.partner_id
left join product_product pp on pp.id = claim.product_id
left join product_template pt on pt.id = pp.product_tmpl_id
left join stock_lot pd on pd.id = claim.lot_id
 $P!{p_Where} 
 order by claim.id]]>
	</queryString>
