<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.project.form.od19.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_project_type_id"
                       domain="[('project_ok', '=', True)]"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Job Assignment" name="od19_job_assignment">
                        <group>
                            <group string="Assignment">
                                <field name="od19_responsible_person_ids"
                                       widget="many2many_tags"
                                       string="Responsible Persons"/>
                                <field name="od19_coordinator_ids"
                                       widget="many2many_tags"
                                       string="Coordinators"/>
                            </group>
                            <group string="Documents">
                                <field name="od19_scope_of_work"
                                       string="Scope of Work"/>
                                <field name="od19_document_requirements"
                                       string="Document Requirements"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_project_project_list_inherit_od19_enhanced" model="ir.ui.view">
        <field name="name">project.project.list.od19.enhanced</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="od19_project_type_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- D7: data quality KPIs -->
    <record id="view_project_project_kpi_list" model="ir.ui.view">
        <field name="name">project.project.kpi.list</field>
        <field name="model">project.project</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Projects" create="false" delete="false">
                <field name="name"/>
                <field name="job_no"/>
                <field name="od19_department_id" optional="show"/>
                <field name="od19_project_type_id" optional="show"/>
                <field name="partner_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_od19_project_without_job_no" model="ir.actions.act_window">
        <field name="name">Projects without Job Number</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_project_kpi_list"/>
        <field name="domain">[('job_no', '=', False)]</field>
    </record>

    <record id="action_od19_project_without_analytic" model="ir.actions.act_window">
        <field name="name">Projects without Analytic Account</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_project_project_kpi_list"/>
        <field name="domain">[('account_id', '=', False)]</field>
    </record>

    <menuitem
        id="menu_od19_project_without_job_no"
        name="Projects without Job Number"
        parent="project.menu_main_pm"
        action="action_od19_project_without_job_no"
        sequence="97"
        groups="project.group_project_manager"
    />
    <menuitem
        id="menu_od19_project_without_analytic"
        name="Projects without Analytic Account"
        parent="project.menu_main_pm"
        action="action_od19_project_without_analytic"
        sequence="98"
        groups="project.group_project_manager"
    />
</odoo>
