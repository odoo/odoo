<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sifnext_asset_category_list" model="ir.ui.view">
        <field name="name">sifnext.asset.category.list</field>
        <field name="model">sifnext.asset.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Aset">
                <field name="name"/>
                <field name="useful_life_years"/>
                <field name="depreciation_method"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sifnext_asset_category_form" model="ir.ui.view">
        <field name="name">sifnext.asset.category.form</field>
        <field name="model">sifnext.asset.category</field>
        <field name="arch" type="xml">

            <form string="Kategori Aset">
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="Pengaturan Penyusutan">

                        <group>
                            <field name="useful_life_years"/>
                            <field name="depreciation_method"/>
                        </group>

                        <group>
                            <field name="residual_value"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active"/>
                        </group>

                    </group>

                </sheet>
            </form>

        </field>
    </record>

    <record id="action_sifnext_asset_category" model="ir.actions.act_window">
        <field name="name">Kategori Aset</field>
        <field name="res_model">sifnext.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_sifnext_asset_category"
        name="Kategori Aset"
        parent="menu_sifnext_asset"
        action="action_sifnext_asset_category"
        sequence="5"
    />

</odoo>