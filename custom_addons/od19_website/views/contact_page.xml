<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Contact Us Page – override the default Odoo contact page       -->
    <!-- ============================================================ -->
    <template id="od19_contact_page" name="Contact Page" inherit_id="website.contactus" priority="20">

        <!-- Replace the default parallax title band with a branded hero -->
        <xpath expr="//section[hasclass('s_title')]" position="replace">
            <section class="od19-page-hero od19-pc-reveal">
                <div class="od19-page-hero-overlay"/>
                <div class="container">
                    <span class="od19-eyebrow">Get in Touch</span>
                    <h1>Contact Us</h1>
                    <p class="od19-lead">
                        Talk to our engineers about industrial, building or terminal automation —
                        quotations, service contracts, spare parts or a long-term partnership.
                    </p>
                    <div class="od19-hero-actions">
                        <a href="tel:+6629345410" class="btn btn-hero">
                            <i class="fa fa-phone"/> +66 2 934 5410-6
                        </a>
                        <a href="mailto:sales@auto-info.co.th" class="btn btn-ghost-light">
                            <i class="fa fa-envelope"/> sales@auto-info.co.th
                        </a>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Replace the default "My Company" sidebar with Auto-Info details -->
        <xpath expr="//div[hasclass('col-lg-4') and .//h5[text()='My Company']]" position="replace">
            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                <h5 style="color:var(--od19-primary);font-weight:700;">
                    <i class="fa fa-building me-2"/>The Auto-Info Co., Ltd.
                </h5>
                <ul class="list-unstyled mb-0 ps-2">
                    <li class="mb-2">
                        <i class="fa fa-map-marker fa-fw me-2" style="color:var(--od19-secondary);"/>
                        1359 Soi Ladprao 94 (Panjamitr), Ladprao Rd., Plubpla, Wangthonglang, Bangkok 10310
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-phone fa-fw me-2" style="color:var(--od19-secondary);"/>
                        +66 2 934 5410-6
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-fax fa-fw me-2" style="color:var(--od19-secondary);"/>
                        +66 2 934 5417
                    </li>
                    <li>
                        <i class="fa fa-envelope fa-fw me-2" style="color:var(--od19-secondary);"/>
                        sales@auto-info.co.th
                    </li>
                </ul>
            </div>
        </xpath>

        <!-- SP6: replace the default form (which posts to mail.mail and only
             sends an e-mail) with a structured RFQ form that creates a real
             crm.lead and lets the backend route it by enquiry type. -->
        <xpath expr="//form[@id='contactus_form']" position="replace">
            <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data"
                  class="o_mark_required od19-rfq-form" data-mark="*"
                  data-model_name="crm.lead" data-success-mode="redirect"
                  data-success-page="/contactus-thank-you" data-pre-fill="true">
                <div class="s_website_form_rows row s_col_no_bgcolor">

                    <!-- Full name -->
                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_name">
                            <span class="s_website_form_label_content">Full Name</span>
                            <span class="s_website_form_mark"> *</span>
                        </label>
                        <input id="od19_rfq_name" type="text" class="form-control s_website_form_input"
                               name="contact_name" required="" data-fill-with="name"/>
                    </div>

                    <!-- Company -->
                    <div class="mb-3 col-lg-6 s_website_form_field" data-type="char" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_company">
                            <span class="s_website_form_label_content">Company</span>
                        </label>
                        <input id="od19_rfq_company" type="text" class="form-control s_website_form_input"
                               name="partner_name" data-fill-with="commercial_company_name"/>
                    </div>

                    <!-- Email -->
                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_email">
                            <span class="s_website_form_label_content">Email</span>
                            <span class="s_website_form_mark"> *</span>
                        </label>
                        <input id="od19_rfq_email" type="email" class="form-control s_website_form_input"
                               name="email_from" required="" data-fill-with="email"/>
                    </div>

                    <!-- Phone -->
                    <div class="mb-3 col-lg-6 s_website_form_field" data-type="tel" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_phone">
                            <span class="s_website_form_label_content">Phone</span>
                        </label>
                        <input id="od19_rfq_phone" type="tel" class="form-control s_website_form_input"
                               name="phone" data-fill-with="phone"/>
                    </div>

                    <!-- Enquiry type (drives the CRM routing) -->
                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required" data-type="selection" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_enquiry">
                            <span class="s_website_form_label_content">Enquiry Type</span>
                            <span class="s_website_form_mark"> *</span>
                        </label>
                        <select id="od19_rfq_enquiry" class="form-select s_website_form_input"
                                name="Enquiry Type" required="">
                            <option value="" disabled="disabled" selected="selected">&#8212; Please choose &#8212;</option>
                            <t t-foreach="website.od19_enquiry_types()" t-as="etype">
                                <option t-att-value="etype['key']" t-esc="etype['label']"/>
                            </t>
                        </select>
                    </div>

                    <!-- Product of interest -->
                    <div class="mb-3 col-lg-6 s_website_form_field" data-type="selection" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_product">
                            <span class="s_website_form_label_content">Product of Interest</span>
                        </label>
                        <select id="od19_rfq_product" class="form-select s_website_form_input"
                                name="Product of Interest">
                            <option value="" selected="selected">&#8212; Not specified &#8212;</option>
                            <t t-foreach="website.od19_products()" t-as="prod">
                                <option t-att-value="prod['name']" t-esc="prod['name']"/>
                            </t>
                        </select>
                    </div>

                    <!-- Message -->
                    <div class="mb-3 col-12 s_website_form_field s_website_form_required" data-type="text" data-name="Field">
                        <label class="s_website_form_label" for="od19_rfq_message">
                            <span class="s_website_form_label_content">How can we help?</span>
                            <span class="s_website_form_mark"> *</span>
                        </label>
                        <textarea id="od19_rfq_message" class="form-control s_website_form_input"
                                  name="description" required="" rows="6"/>
                    </div>

                    <!-- PDPA consent -->
                    <div class="mb-3 col-12 s_website_form_field s_website_form_required od19-rfq-consent" data-type="boolean" data-name="Field">
                        <div class="form-check">
                            <input id="od19_rfq_consent" type="checkbox"
                                   class="form-check-input s_website_form_input"
                                   name="PDPA Consent" value="yes" required=""/>
                            <label class="form-check-label" for="od19_rfq_consent">
                                I agree that The Auto-Info Co., Ltd. may use my details to respond to
                                this enquiry, in line with the <a href="/privacy">Privacy Policy</a>.
                            </label>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label od19-rfq-submit-row" data-name="Submit Button">
                        <a href="#" role="button" class="btn btn-hero s_website_form_send od19-rfq-submit">
                            Send Request <i class="fa fa-paper-plane ms-1"/>
                        </a>
                        <span id="s_website_form_result"/>
                    </div>
                </div>
            </form>
        </xpath>

        <!-- Append our additional contact cards (Head Office, Engineering Center, Hours) -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="od19-section bg-light">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="od19-contact-card">
                                <h4><i class="fa fa-building me-2"/>Head Office</h4>
                                <p>1359 Soi Ladprao 94 (Panjamitr),<br/>
                                   Ladprao Rd., Plubpla,<br/>
                                   Wangthonglang, Bangkok 10310</p>
                                <p><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                                <p><i class="fa fa-fax"/> +66 2 934 5417</p>
                                <p><i class="fa fa-envelope"/> sales@auto-info.co.th</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="od19-contact-card">
                                <h4><i class="fa fa-cogs me-2"/>Engineering Center</h4>
                                <p>ZENTRO Port Lumlukka K8<br/>
                                   36/8 Moo 13 Buengkhamphroi,<br/>
                                   Lam Luk Ka, Pathumthani 12150</p>
                                <p><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                                <p><i class="fa fa-envelope"/> admin@auto-info.co.th</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="od19-contact-card">
                                <h4><i class="fa fa-clock-o me-2"/>Business Hours</h4>
                                <p><strong>Monday &#8211; Friday</strong><br/>08:00 &#8211; 17:00</p>
                                <p><strong>Saturday &#8211; Sunday</strong><br/>Closed</p>
                                <p><strong>Public Holiday</strong><br/>Closed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Department contact channels -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="od19-section">
                <div class="container">
                    <div class="od19-section-title">
                        <h2>Talk to the Right Team</h2>
                        <div class="od19-divider"/>
                        <p class="od19-careers-lead">
                            Reach the department that matches your enquiry — every message is routed
                            to a specialist who can help.
                        </p>
                    </div>
                    <div class="od19-cap-grid">
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-line-chart"/></div>
                            <h4>Sales &amp; Quotation</h4>
                            <p>Product enquiries, integrated solutions and project quotations.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:sales@auto-info.co.th">sales@auto-info.co.th</a></p>
                            <p class="od19-channel-line"><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                        </div>
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-wrench"/></div>
                            <h4>Service &amp; Maintenance</h4>
                            <p>Preventive maintenance, calibration and long-term service contracts.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:admin@auto-info.co.th">admin@auto-info.co.th</a></p>
                            <p class="od19-channel-line"><i class="fa fa-clock-o"/> On-call support</p>
                        </div>
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-cubes"/></div>
                            <h4>Spare Parts</h4>
                            <p>Genuine spare parts, replacements and upgrade components.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:admin@auto-info.co.th">admin@auto-info.co.th</a></p>
                            <p class="od19-channel-line"><i class="fa fa-phone"/> +66 2 934 5410-6</p>
                        </div>
                        <div class="od19-cap-card od19-pc-reveal">
                            <div class="od19-cap-icon"><i class="fa fa-briefcase"/></div>
                            <h4>Careers</h4>
                            <p>Join our engineering, service and project delivery teams.</p>
                            <p class="od19-channel-line"><i class="fa fa-envelope"/> <a href="mailto:hr@auto-info.co.th">hr@auto-info.co.th</a></p>
                            <p class="mt-3">
                                <a href="/careers" class="btn btn-hero">View Openings <i class="fa fa-arrow-right"/></a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Find us: map and directions -->
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="od19-section bg-light">
                <div class="container">
                    <div class="od19-section-title">
                        <h2>Find Us</h2>
                        <div class="od19-divider"/>
                    </div>
                    <div class="row g-4 align-items-stretch">
                        <div class="col-lg-7">
                            <div class="od19-img-frame od19-map-frame">
                                <!-- The whole map is a link: it opens the visitor's own
                                     navigation app (Google Maps on Android/iOS/desktop,
                                     which itself hands over to Apple Maps on iOS). -->
                                <a class="od19-map-link" target="_blank" rel="noopener"
                                   title="Open the Auto-Info head office in your navigation app"
                                   href="https://www.google.com/maps/dir/?api=1&amp;destination=1359%20Soi%20Ladprao%2094%20Panjamitr%20Ladprao%20Rd%20Plubpla%20Wangthonglang%20Bangkok%2010310">
                                    <iframe title="Auto-Info Head Office location" loading="lazy"
                                            referrerpolicy="no-referrer-when-downgrade"
                                            src="https://www.google.com/maps?q=1359%20Soi%20Ladprao%2094%20Wangthonglang%20Bangkok&amp;output=embed"/>
                                    <span class="od19-map-cta">
                                        <i class="fa fa-location-arrow"/> Open in Maps &amp; Navigate
                                    </span>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="od19-contact-card h-100">
                                <h4><i class="fa fa-map-marker me-2"/>Getting Here</h4>
                                <p><strong>Head Office</strong><br/>
                                   1359 Soi Ladprao 94 (Panjamitr), Ladprao Rd.,<br/>
                                   Plubpla, Wangthonglang, Bangkok 10310</p>
                                <p><i class="fa fa-car"/> Ample on-site parking</p>
                                <p><i class="fa fa-subway"/> MRT Lat Phrao (Exit 4), about 10 minutes on foot</p>
                                <p><i class="fa fa-clock-o"/> Monday&#8211;Friday 08:00&#8211;17:00 only</p>
                                <div class="od19-map-actions">
                                    <a class="btn btn-hero" target="_blank" rel="noopener"
                                       href="https://www.google.com/maps/dir/?api=1&amp;destination=1359%20Soi%20Ladprao%2094%20Panjamitr%20Ladprao%20Rd%20Plubpla%20Wangthonglang%20Bangkok%2010310">
                                        <i class="fa fa-location-arrow"/> Get Directions
                                    </a>
                                    <a class="btn btn-ghost-dark" target="_blank" rel="noopener"
                                       href="https://maps.apple.com/?daddr=1359%20Soi%20Ladprao%2094%20Wangthonglang%20Bangkok%2010310">
                                        <i class="fab fa-apple"/> Apple Maps
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

    </template>

    <!-- ============================================================ -->
    <!-- Thank You page – override the default Odoo confirmation page   -->
    <!-- ============================================================ -->
    <!-- website.contactus_thanks is a website.page (_inherits ir.ui.view);
         its backing view is exposed through the auto-generated xmlid
         website.contactus_thanks_ir_ui_view, which is what we inherit. -->
    <template id="od19_contactus_thanks" name="Thank You (Contact us)"
              inherit_id="website.contactus_thanks_ir_ui_view" priority="20">

        <!-- Replace the placeholder "My Company" column (fake address/phone)
             with the real Auto-Info details so the confirmation page is
             consistent with the contact page and shows no dummy data. -->
        <xpath expr="//div[hasclass('col-lg-4') and .//h5[text()='My Company']]" position="replace">
            <div class="col-lg-4 offset-lg-1">
                <h5 class="od19-thanks-company">
                    <i class="fa fa-building me-2"/>The Auto-Info Co., Ltd.
                </h5>
                <ul class="list-unstyled mb-0 ps-2">
                    <li class="mb-2">
                        <i class="fa fa-map-marker fa-fw me-2" style="color:var(--od19-secondary);"/>
                        1359 Soi Ladprao 94 (Panjamitr), Ladprao Rd., Plubpla, Wangthonglang, Bangkok 10310
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-phone fa-fw me-2" style="color:var(--od19-secondary);"/>
                        <span class="o_force_ltr">+66 2 934 5410-6</span>
                    </li>
                    <li>
                        <i class="fa fa-envelope fa-fw me-2" style="color:var(--od19-secondary);"/>
                        <a href="mailto:sales@auto-info.co.th">sales@auto-info.co.th</a>
                    </li>
                </ul>
                <p class="mt-3 mb-0">
                    <a href="/contactus" class="btn btn-hero od19-thanks-back">
                        <i class="fa fa-reply me-1"/>Back to Contact
                    </a>
                </p>
            </div>
        </xpath>
    </template>

</odoo>
