<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Job Application - attachments (referenced from the form)      -->
    <!-- Must be declared before the form that links to the action.    -->
    <!-- ============================================================ -->
    <record id="view_od19_job_application_attachment_list" model="ir.ui.view">
        <field name="name">od19.job.application.attachment.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Documents" create="false">
                <field name="name"/>
                <field name="mimetype"/>
                <field name="file_size" string="Size"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_od19_job_application_attachments" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_od19_job_application_attachment_list"/>
        <field name="domain">[('res_model', '=', 'od19.job.application'), ('res_id', '=', active_id)]</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>

    <!-- ============================================================ -->
    <!-- Job Application - list                                        -->
    <!-- ============================================================ -->
    <record id="view_od19_job_application_list" model="ir.ui.view">
        <field name="name">od19.job.application.list</field>
        <field name="model">od19.job.application</field>
        <field name="arch" type="xml">
            <list string="Applications" decoration-success="state == 'hired'"
                  decoration-danger="state == 'refused'">
                <field name="reference"/>
                <field name="name" string="Candidate"/>
                <field name="application_type" optional="show"/>
                <field name="job_id"/>
                <field name="applied_position" optional="hide"/>
                <field name="department" optional="show"/>
                <field name="preferred_department" optional="hide"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="years_experience" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="create_date" string="Applied On"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Job Application - form                                        -->
    <!-- ============================================================ -->
    <record id="view_od19_job_application_form" model="ir.ui.view">
        <field name="name">od19.job.application.form</field>
        <field name="model">od19.job.application</field>
        <field name="arch" type="xml">
            <form string="Job Application">
                <header>
                    <button name="action_shortlist" type="object" string="Shortlist"
                            class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_interview" type="object" string="Schedule Interview"
                            class="oe_highlight" invisible="state not in ('new', 'shortlisted')"/>
                    <button name="action_offer" type="object" string="Send Offer"
                            class="oe_highlight" invisible="state not in ('shortlisted', 'interview')"/>
                    <button name="action_hired" type="object" string="Mark as Hired"
                            class="oe_highlight" invisible="state not in ('interview', 'offer')"/>
                    <button name="action_refuse" type="object" string="Not Selected"
                            invisible="state in ('hired', 'refused')"/>
                    <button name="action_reset" type="object" string="Reset to New"
                            invisible="state == 'new'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,shortlisted,interview,offer,hired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(od19_website.action_od19_job_application_attachments)d"
                                type="action" class="oe_stat_button" icon="fa-paperclip"
                                invisible="document_count == 0">
                            <div class="o_stat_info">
                                <field name="document_count" class="o_stat_value"/>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Candidate"/>
                        <h1><field name="name" placeholder="Full name"/></h1>
                        <group>
                            <field name="reference" readonly="1"/>
                        </group>
                    </div>
                    <group>
                        <group name="position" string="Applied Position">
                            <field name="application_type"/>
                            <field name="job_id" options="{'no_create': True}"
                                   invisible="application_type == 'speculative'"/>
                            <field name="applied_position"
                                   invisible="application_type == 'specific'"/>
                            <field name="department"
                                   invisible="application_type == 'speculative'"/>
                            <field name="preferred_department"
                                   invisible="application_type == 'specific'"/>
                        </group>
                        <group name="application" string="Application">
                            <field name="create_date" string="Applied On"/>
                            <field name="source"/>
                            <field name="consent_privacy" readonly="1"/>
                            <field name="consent_date" readonly="1"
                                   invisible="not consent_privacy"/>
                        </group>
                    </group>
                    <group>
                        <group name="contact" string="Contact Details">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="available_date"/>
                            <field name="preferred_location"/>
                        </group>
                        <group name="profile" string="Professional Profile">
                            <field name="current_company"/>
                            <field name="current_position"/>
                            <field name="years_experience"/>
                            <field name="education_level"/>
                            <field name="expected_salary"/>
                            <field name="notice_period"/>
                            <field name="willing_to_travel"/>
                            <field name="portfolio_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cover Letter / Message" name="cover_letter">
                            <field name="cover_letter" placeholder="Message from the candidate..."/>
                        </page>
                        <page string="Documents" name="documents">
                            <group>
                                <field name="resume_filename" invisible="1"/>
                                <field name="resume" filename="resume_filename"/>
                            </group>
                            <field name="document_ids" widget="many2many_binary"
                                   string="Supporting Documents"/>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="note" placeholder="Interview feedback and internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Job Application - search                                      -->
    <!-- ============================================================ -->
    <record id="view_od19_job_application_search" model="ir.ui.view">
        <field name="name">od19.job.application.search</field>
        <field name="model">od19.job.application</field>
        <field name="arch" type="xml">
            <search string="Applications">
                <field name="name" string="Candidate"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="reference"/>
                <field name="job_id"/>
                <field name="applied_position"/>
                <separator/>
                <filter name="filter_specific" string="Specific Position"
                        domain="[('application_type', '=', 'specific')]"/>
                <filter name="filter_speculative" string="General Application"
                        domain="[('application_type', '=', 'speculative')]"/>
                <separator/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_shortlisted" string="Shortlisted" domain="[('state', '=', 'shortlisted')]"/>
                <filter name="filter_interview" string="Interview" domain="[('state', '=', 'interview')]"/>
                <filter name="filter_offer" string="Offer Sent" domain="[('state', '=', 'offer')]"/>
                <filter name="filter_hired" string="Hired" domain="[('state', '=', 'hired')]"/>
                <filter name="filter_refused" string="Not Selected" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter name="filter_industrial" string="Industrial" domain="[('department', '=', 'industrial')]"/>
                <filter name="filter_building" string="Building" domain="[('department', '=', 'building')]"/>
                <filter name="filter_terminal" string="Terminal" domain="[('department', '=', 'terminal')]"/>
                <group>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Application Type" domain="[]" context="{'group_by': 'application_type'}"/>
                    <filter name="group_job" string="Job Position" domain="[]" context="{'group_by': 'job_id'}"/>
                    <filter name="group_department" string="Department" domain="[]" context="{'group_by': 'department'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Job Application - action                                      -->
    <!-- ============================================================ -->
    <record id="action_od19_job_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">od19.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_od19_job_application_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No applications yet</p>
            <p>Applications submitted through the careers page will appear here.</p>
        </field>
    </record>

</odoo>
