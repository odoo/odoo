<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Employee Portal Homepage                                      -->
    <!-- ============================================================ -->
    <template id="od19_employee_portal" name="Employee Portal">
        <t t-call="website.layout">
            <t t-set="no_footer" t-value="True"/>
            <div id="wrap" class="oe_structure">

                <!-- Welcome Hero -->
                <section class="od19-portal-hero">
                    <div class="container d-flex justify-content-between align-items-center">
                        <div>
                            <h2>
                                <i class="fa fa-user-circle me-2"/>
                                สวัสดีค่ะ <span t-esc="user.name"/>
                            </h2>
                            <p class="mb-0" style="opacity:0.85;">
                                ยินดีต้อนรับสู่ Employee Portal ของ The Auto-Info
                            </p>
                        </div>
                        <div class="text-end">
                            <small class="d-block mb-2" style="opacity:0.7;" t-esc="datetime.datetime.now().strftime('%A, %d %B %Y')"/>
                            <a href="/web" class="btn btn-sm od19-portal-back">
                                <i class="fa fa-th me-1"/>กลับหน้าหลังบ้าน
                            </a>
                        </div>
                    </div>
                </section>

                <div class="container">

                    <!-- Announcements -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0" style="color:var(--od19-dark);font-weight:700;">
                                        <i class="fa fa-bullhorn me-2" style="color:var(--od19-secondary);"/>
                                        ประกาศล่าสุด (Latest Announcements)
                                    </h5>
                                    <a href="/web#action=od19_announcement.announcement_action"
                                       class="btn btn-sm btn-outline-primary">ดูทั้งหมด</a>
                                </div>
                                <div class="card-body">
                                    <t t-if="announcements">
                                        <t t-foreach="announcements" t-as="ann">
                                            <div class="mb-3 pb-3 border-bottom">
                                                <div class="d-flex justify-content-between">
                                                    <strong t-esc="ann.name"/>
                                                    <span class="od19-announcement-badge"
                                                          t-att-class="{
                                                              'bg-warning text-dark': ann.announcement_type == 'warning',
                                                              'bg-danger': ann.announcement_type == 'mandatory',
                                                              'bg-primary': ann.announcement_type == 'info',
                                                          }"
                                                          t-esc="dict(info='Info', warning='Warning', mandatory='Mandatory').get(ann.announcement_type, ann.announcement_type)"/>
                                                </div>
                                                <small class="text-muted" t-esc="ann.published_date and ann.published_date.strftime('%d %b %Y') or ''"/>
                                                <div class="mt-1" t-out="ann.body"/>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <p class="text-muted mb-0">ไม่มีประกาศในขณะนี้</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Meeting Room Booking (self-service, one screen) -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="od19-booking-panel">
                                <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                                    <h5 class="mb-0" style="color:var(--od19-dark);font-weight:700;">
                                        <i class="fa fa-calendar-check-o me-2" style="color:var(--od19-primary);"/>
                                        จองห้องประชุม (Meeting Room Booking)
                                    </h5>
                                    <small class="text-muted">เลือกห้อง กรอกหัวข้อ และเวลา แล้วกดจองได้ทันที</small>
                                </div>

                                <t t-if="booked">
                                    <div class="alert alert-success py-2 mb-3">
                                        <i class="fa fa-check-circle me-1"/>จองห้องประชุมเรียบร้อยแล้ว เลขที่ <strong t-esc="booked"/>
                                    </div>
                                </t>
                                <t t-if="booking_error">
                                    <div class="alert alert-danger py-2 mb-3">
                                        <i class="fa fa-exclamation-triangle me-1"/><span t-esc="booking_error"/>
                                    </div>
                                </t>

                                <!-- Live status of every room; click opens its schedule -->
                                <div class="row g-2 mb-3">
                                    <t t-foreach="rooms" t-as="entry">
                                        <div class="col-lg-3 col-md-6">
                                            <a t-attf-class="od19-room-tile od19-room-#{entry['status']}"
                                               t-att-href="'#od19-room-modal-%s' % entry['room'].id"
                                               t-att-data-bs-target="'#od19-room-modal-%s' % entry['room'].id"
                                               data-bs-toggle="modal">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <strong t-esc="entry['room'].name"/>
                                                    <span t-attf-class="od19-room-badge od19-badge-#{entry['status']}" t-esc="entry['status_label']"/>
                                                </div>
                                                <div class="od19-room-meta">
                                                    <i class="fa fa-users me-1"/><span t-esc="entry['room'].capacity"/> ที่นั่ง
                                                    <t t-if="entry['room'].floor">
                                                        <span class="mx-1">·</span><i class="fa fa-building-o me-1"/>ชั้น <span t-esc="entry['room'].floor"/>
                                                    </t>
                                                </div>
                                                <div class="od19-room-icons">
                                                    <i t-if="entry['room'].has_projector" class="fa fa-video-camera" title="โปรเจคเตอร์"/>
                                                    <i t-if="entry['room'].has_video_conference" class="fa fa-wifi" title="ประชุมทางไกล"/>
                                                    <i t-if="entry['room'].has_whiteboard" class="fa fa-pencil-square-o" title="ไวท์บอร์ด"/>
                                                    <i t-if="entry['room'].has_display" class="fa fa-television" title="จอแสดงผล"/>
                                                </div>
                                                <div class="od19-room-note">
                                                    <t t-if="entry['status'] == 'busy' and entry['busy_until']">
                                                        ว่างอีกครั้ง <span t-esc="entry['busy_until']"/>
                                                    </t>
                                                    <t t-elif="entry['status'] == 'reserved' and entry['next_label']">
                                                        จองถัดไป <span t-esc="entry['next_label']"/>
                                                    </t>
                                                    <t t-else="">
                                                        พร้อมใช้งาน
                                                    </t>
                                                </div>
                                                <div class="od19-room-hint">
                                                    <i class="fa fa-clock-o me-1"/>ดูตารางการใช้ห้อง
                                                </div>
                                            </a>
                                        </div>
                                    </t>
                                </div>

                                <!-- Room schedule popup: what is taken, past and ahead -->
                                <t t-foreach="rooms" t-as="entry">
                                    <div class="modal fade od19-room-modal" tabindex="-1" aria-hidden="true"
                                         t-att-id="'od19-room-modal-%s' % entry['room'].id">
                                        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">
                                                        <i class="fa fa-calendar-check-o me-2" style="color:var(--od19-primary);"/>
                                                        <span t-esc="entry['room'].name"/>
                                                        <small class="text-muted ms-2">
                                                            <i class="fa fa-users me-1"/><span t-esc="entry['room'].capacity"/> ที่นั่ง
                                                            <t t-if="entry['room'].floor">
                                                                · ชั้น <span t-esc="entry['room'].floor"/>
                                                            </t>
                                                        </small>
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"/>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="od19-schedule-note mb-2">
                                                        <i class="fa fa-info-circle me-1"/>
                                                        แสดงตารางการใช้ห้องย้อนหลัง <span t-esc="booking_window_months"/> เดือน
                                                        และล่วงหน้า <span t-esc="booking_window_months"/> เดือน
                                                    </p>
                                                    <div class="od19-room-schedule" t-att-data-room-id="entry['room'].id">
                                                        <p class="text-muted small mb-0">
                                                            <i class="fa fa-spinner fa-spin me-1"/>กำลังโหลดตารางการใช้ห้อง…
                                                        </p>
                                                    </div>

                                                    <!-- Book this room without leaving the popup -->
                                                    <form action="/employee-portal/book-room" method="post" class="od19-booking-form mt-3">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <input type="hidden" name="room_id" t-att-value="entry['room'].id"/>
                                                        <div class="od19-subheading">จองห้องนี้</div>
                                                        <div class="row g-2 align-items-end">
                                                            <div class="col-lg-6">
                                                                <label class="od19-field-label">หัวข้อการประชุม</label>
                                                                <input type="text" name="name" class="form-control"
                                                                       placeholder="เช่น ประชุมทีมขาย" required="required"/>
                                                            </div>
                                                            <div class="col-lg-2 col-md-4">
                                                                <label class="od19-field-label">วันที่</label>
                                                                <input type="date" name="booking_date" class="form-control"
                                                                       t-att-value="today.strftime('%Y-%m-%d')"
                                                                       t-att-min="min_booking_date.strftime('%Y-%m-%d')"
                                                                       t-att-max="max_booking_date.strftime('%Y-%m-%d')"
                                                                       required="required"/>
                                                            </div>
                                                            <div class="col-lg-2 col-md-4">
                                                                <label class="od19-field-label">เริ่ม</label>
                                                                <input type="time" name="start_time" class="form-control"
                                                                       value="09:00" required="required"/>
                                                            </div>
                                                            <div class="col-lg-2 col-md-4">
                                                                <label class="od19-field-label">ถึง</label>
                                                                <input type="time" name="end_time" class="form-control"
                                                                       value="10:00" required="required"/>
                                                            </div>
                                                            <div class="col-lg-12">
                                                                <button type="submit" class="btn od19-btn-book mt-2">
                                                                    <i class="fa fa-calendar-plus-o me-1"/>จองห้องนี้
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                                <!-- One-row booking form -->
                                <form action="/employee-portal/book-room" method="post" class="od19-booking-form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="row g-2 align-items-end">
                                        <div class="col-lg-3 col-md-6">
                                            <label class="od19-field-label">ห้องประชุม</label>
                                            <select name="room_id" class="form-control" required="required">
                                                <option value="">-- เลือกห้อง --</option>
                                                <t t-foreach="rooms" t-as="entry">
                                                    <option t-att-value="entry['room'].id"
                                                            t-att-disabled="entry['status'] == 'busy' or None"
                                                            t-esc="entry['room'].name"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-lg-3 col-md-6">
                                            <label class="od19-field-label">หัวข้อการประชุม</label>
                                            <input type="text" name="name" class="form-control"
                                                   placeholder="เช่น ประชุมทีมขาย" required="required"/>
                                        </div>
                                        <div class="col-lg-2 col-md-4">
                                            <label class="od19-field-label">วันที่</label>
                                            <input type="date" name="booking_date" class="form-control"
                                                   t-att-value="today.strftime('%Y-%m-%d')"
                                                   t-att-min="min_booking_date.strftime('%Y-%m-%d')"
                                                   t-att-max="max_booking_date.strftime('%Y-%m-%d')"
                                                   required="required"/>
                                        </div>
                                        <div class="col-lg-1 col-md-4">
                                            <label class="od19-field-label">เริ่ม</label>
                                            <input type="time" name="start_time" class="form-control"
                                                   value="09:00" required="required"/>
                                        </div>
                                        <div class="col-lg-1 col-md-4">
                                            <label class="od19-field-label">ถึง</label>
                                            <input type="time" name="end_time" class="form-control"
                                                   value="10:00" required="required"/>
                                        </div>
                                        <div class="col-lg-2 col-md-6">
                                            <label class="od19-field-label">ผู้เข้าร่วม</label>
                                            <input type="number" name="participant_count" class="form-control"
                                                   value="2" min="1"/>
                                        </div>
                                        <div class="col-lg-12">
                                            <button type="submit" class="btn od19-btn-book mt-2">
                                                <i class="fa fa-calendar-plus-o me-1"/>จองทันที
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <!-- My upcoming bookings -->
                                <div t-if="my_bookings" class="mt-4">
                                    <div class="od19-subheading">การจองของฉัน (My Upcoming Bookings)</div>
                                    <div class="table-responsive">
                                        <table class="table table-sm od19-my-bookings mb-0">
                                            <thead>
                                                <tr>
                                                    <th>หัวข้อ</th>
                                                    <th>ห้อง</th>
                                                    <th>เริ่ม</th>
                                                    <th>ถึง</th>
                                                    <th>สถานะ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="my_bookings" t-as="bk">
                                                    <td t-esc="bk['name']"/>
                                                    <td t-esc="bk['room']"/>
                                                    <td t-esc="bk['start']"/>
                                                    <td t-esc="bk['end']"/>
                                                    <td><span class="od19-room-badge od19-badge-reserved" t-esc="bk['state_label']"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Access -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5 style="color:var(--od19-dark);font-weight:700;margin-bottom:20px;">
                                <i class="fa fa-th-large me-2" style="color:var(--od19-primary);"/>
                                เมนูด่วน (Quick Access)
                            </h5>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-check-square-o"/></div>
                                <h5>รายการอนุมัติ</h5>
                                <p>Approval Center</p>
                                <a href="/my/approvals">เปิดใช้งาน →</a>
                            </div>
                            <div class="od19-approval-badge d-none" data-od19-approval-summary="/my/approvals/summary">
                                <small class="text-danger d-block mt-1">
                                    <i class="fa fa-clock-o me-1"/>
                                    รออนุมัติ <span class="od19-approval-count">0</span> รายการ
                                    <span class="od19-approval-age d-none">
                                        (เก่าสุด <span class="od19-approval-max-age">0</span> วัน)
                                    </span>
                                </small>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-ticket"/></div>
                                <h5>แจ้งปัญหาภายใน</h5>
                                <p>Internal Issue / Helpdesk</p>
                                <a href="/web#action=helpdesk_mgmt.helpdesk_ticket_action">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-archive"/></div>
                                <h5>ยืมอุปกรณ์</h5>
                                <p>Asset &amp; Tool Loan</p>
                                <a href="/web#action=od19_asset_loan.asset_loan_action">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-calendar-check-o"/></div>
                                <h5>จองห้องประชุม</h5>
                                <p>Meeting Room Booking</p>
                                <a href="/web#action=od19_meeting_room_booking.action_meeting_room_booking">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-book"/></div>
                                <h5>ฐานความรู้</h5>
                                <p>Knowledge Base</p>
                                <a href="/web#action=document_page.action_browse_all_content">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-bullhorn"/></div>
                                <h5>ประกาศ</h5>
                                <p>Announcements</p>
                                <a href="/web#action=od19_announcement.announcement_action">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-money"/></div>
                                <h5>ค่าใช้จ่าย</h5>
                                <p>HR Expense</p>
                                <a href="/web#action=hr_expense.hr_expense_actions_my_all">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-truck"/></div>
                                <h5>จัดซื้อ</h5>
                                <p>Purchase Requisition</p>
                                <a href="/web#action=purchase.purchase_form_action">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-users"/></div>
                                <h5>ฝ่ายบุคคล</h5>
                                <p>Employee Directory</p>
                                <a href="/web#action=hr.open_view_employee_list_my">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-bar-chart"/></div>
                                <h5>แดชบอร์ด</h5>
                                <p>My Dashboard</p>
                                <a href="/web">เปิดใช้งาน →</a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                            <div class="od19-portal-card">
                                <div class="od19-portal-icon"><i class="fa fa-book"/></div>
                                <h5>คู่มือการใช้งาน</h5>
                                <p>User Guide</p>
                                <a href="/web#action=web_tour.tour_action">เปิดใช้งาน →</a>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5 style="color:var(--od19-dark);font-weight:700;margin-bottom:20px;">
                                <i class="fa fa-bolt me-2" style="color:var(--od19-secondary);"/>
                                ทำงานด่วน (Quick Actions)
                            </h5>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a href="/web#action=helpdesk_mgmt.helpdesk_ticket_action"
                               class="btn btn-primary btn-lg w-100 text-start" style="background:var(--od19-primary);border:none;">
                                <i class="fa fa-plus-circle me-2"/>แจ้งปัญหาใหม่
                            </a>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a href="/web#action=od19_asset_loan.asset_loan_action"
                               class="btn btn-lg w-100 text-start" style="background:var(--od19-secondary);border:none;color:#fff;">
                                <i class="fa fa-plus-circle me-2"/>ขอยืมอุปกรณ์
                            </a>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a href="/web#action=od19_meeting_room_booking.action_meeting_room_booking"
                               class="btn btn-lg w-100 text-start" style="background:#6b1f1f;border:none;color:#fff;">
                                <i class="fa fa-calendar-plus-o me-2"/>จองห้องประชุม
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
