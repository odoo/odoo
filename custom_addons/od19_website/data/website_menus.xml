<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- Website Menu (Top Navigation)                                 -->
    <!-- Menus are created under website.main_menu and re-parented to  -->
    <!-- the website's actual top menu by post_init_hook.  noupdate=1 -->
    <!-- ensures the re-parenting persists across module upgrades.    -->
    <!-- ============================================================ -->

    <record id="menu_home" model="website.menu">
        <field name="name">Home</field>
        <field name="url">/</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="10"/>
    </record>

    <record id="menu_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">#</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="20"/>
    </record>

    <record id="menu_services_industrial" model="website.menu">
        <field name="name">Industrial Automation</field>
        <field name="url">/industrial-automation</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="menu_services"/>
        <field name="sequence" eval="10"/>
    </record>

    <record id="menu_services_building" model="website.menu">
        <field name="name">Building Automation</field>
        <field name="url">/building-automation</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="menu_services"/>
        <field name="sequence" eval="20"/>
    </record>

    <record id="menu_services_terminal" model="website.menu">
        <field name="name">Terminal Automation</field>
        <field name="url">/terminal-automation</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="menu_services"/>
        <field name="sequence" eval="30"/>
    </record>

    <record id="menu_products" model="website.menu">
        <field name="name">Products</field>
        <field name="url">/products</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="30"/>
    </record>

    <record id="menu_quality" model="website.menu">
        <field name="name">Quality</field>
        <field name="url">/quality-certifications</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="35"/>
    </record>

    <record id="menu_about" model="website.menu">
        <field name="name">About</field>
        <field name="url">/about-us</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="40"/>
    </record>

    <record id="menu_portfolio" model="website.menu">
        <field name="name">References</field>
        <field name="url">/portfolio</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="42"/>
    </record>

    <record id="menu_careers" model="website.menu">
        <field name="name">Careers</field>
        <field name="url">/careers</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="45"/>
    </record>

    <record id="menu_news" model="website.menu">
        <field name="name">News &amp; Events</field>
        <field name="url">/blog</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="50"/>
    </record>

    <record id="menu_contact" model="website.menu">
        <field name="name">Contact</field>
        <field name="url">/contactus</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="60"/>
    </record>

    <!-- "Employee Portal" is intentionally NOT a public top-level menu: the
         page requires an authenticated user and belongs to staff, not visitors.
         It is surfaced from the footer instead (see views/website_templates.xml)
         and from the backend systray shortcut (od19_shortcut_menu.js).  A stale
         copy created by an earlier revision is removed by
         website.menu.od19_configure_menus(). -->

    <!-- The menu clean-up / re-parenting runs from data/setup_functions.xml:
         <function> tags inside a noupdate="1" block are skipped on upgrade. -->

</odoo>
