<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper Format: the statement carries its own title block, so no header band is reserved.
         Narrow side margins: the PDF body container adds ~4mm padding on top of these. -->
    <record id="paperformat_customer_payment_statement" model="report.paperformat">
        <field name="name">Customer Payment Statement</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top" eval="10"/>
        <field name="margin_bottom" eval="10"/>
        <field name="margin_left" eval="6"/>
        <field name="margin_right" eval="6"/>
        <field name="header_line" eval="False"/>
        <field name="header_spacing" eval="0"/>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_customer_payment" model="ir.actions.report">
        <field name="name">Customer Payment Statement</field>
        <field name="model">customer.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_payment.report_customer_payment_document</field>
        <field name="report_file">customer_payment.report_customer_payment_document</field>
        <field name="paperformat_id" ref="paperformat_customer_payment_statement"/>
        <field name="binding_model_id" ref="model_customer_payment"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Customer Payment - %s' % object.name</field>
    </record>

    <!-- Report Template: Khmer Customer Summary Statement -->
    <template id="report_customer_payment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="partner" t-value="o.partner_id"/>
                <t t-set="partner_address" t-value="' '.join(filter(None, [partner.street, partner.street2, partner.city, partner.state_id.name]))"/>
                <t t-set="invoices" t-value="o.invoice_ids.sorted(key=lambda inv: (inv.invoice_date or inv.date, inv.id))"/>
                <t t-set="all_payments" t-value="(o.previous_payment_entry_ids + o.payment_entry_ids).sorted(key=lambda p: (p.payment_date, p.id))"/>
                <!-- Period runs from the first bill to the last bill (whole year when there is no bill) -->
                <t t-set="invoice_dates" t-value="invoices.filtered('invoice_date').mapped('invoice_date')"/>
                <t t-set="date_from" t-value="min(invoice_dates) if invoice_dates else datetime.date(o.year, 1, 1)"/>
                <t t-set="date_to" t-value="max(invoice_dates) if invoice_dates else datetime.date(o.year, 12, 31)"/>
                <t t-set="km_months" t-value="['មករា', 'កុម្ភៈ', 'មីនា', 'មេសា', 'ឧសភា', 'មិថុនា', 'កក្កដា', 'សីហា', 'កញ្ញា', 'តុលា', 'វិច្ឆិកា', 'ធ្នូ']"/>

                <div class="article o_cp_statement" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
                    <style>
                        .o_cp_statement { color: #000; font-size: 18px; line-height: 1.5; }
                        .o_cp_statement table.o_cp_letterhead { margin-bottom: 15px; table-layout: fixed; }
                        .o_cp_statement .o_cp_letterhead td { width: 25%; padding: 0; vertical-align: middle; }
                        .o_cp_statement .o_cp_letterhead td.o_cp_company_info { width: 50%; font-size: 16px; text-align: center; }
                        .o_cp_statement .o_cp_letterhead img { height: 200px; width: auto; margin-left: -70px; }
                        .o_cp_statement .o_cp_company { font-size: 32px; font-weight: bold; line-height: 1.2; }
                        .o_cp_statement .o_cp_tagline { margin-bottom: 5px; font-size: 18px; font-weight: bold; line-height: 1.2; }
                        .o_cp_statement table { width: 100%; border-collapse: collapse; }
                        .o_cp_statement table + table.o_cp_table { margin-top: -1px; }
                        .o_cp_statement table.o_cp_customer { border: 1px solid #000; background-color: #C6E0B4; }
                        .o_cp_statement .o_cp_customer td { padding: 5px 12px; vertical-align: top; }
                        .o_cp_statement .o_cp_customer td.o_cp_report_info { width: 40%; white-space: nowrap; }
                        .o_cp_statement .o_cp_customer td.o_cp_customer_info { text-align: right; }
                        .o_cp_statement .o_cp_customer .o_cp_title,
                        .o_cp_statement .o_cp_customer .o_cp_label { font-weight: bold; }
                        .o_cp_statement table.o_cp_table { table-layout: fixed; }
                        .o_cp_statement .o_cp_table th,
                        .o_cp_statement .o_cp_table td { padding: 6px 12px; border: 1px solid #000; vertical-align: middle; }
                        .o_cp_statement .o_cp_table th { background-color: #DDEBF7; font-weight: bold; text-align: center; }
                        .o_cp_statement .o_cp_table tr { page-break-inside: avoid; }
                        .o_cp_statement .o_cp_center { text-align: center; }
                        .o_cp_statement .o_cp_amount { text-align: right; white-space: nowrap; }
                        .o_cp_statement .o_cp_symbol { float: left; }
                        .o_cp_statement .o_cp_total td { padding-top: 8px; padding-bottom: 8px; font-size: 20px; font-weight: bold; }
                        .o_cp_statement .o_cp_total .o_cp_amount { color: #FF0000; }
                        .o_cp_statement .o_cp_notes { margin-top: 12px; }
                        .o_cp_statement table.o_cp_signatures { margin-top: 24px; page-break-inside: avoid; }
                        .o_cp_statement .o_cp_signatures td { width: 34%; padding-bottom: 90px; font-weight: bold; text-align: center; }
                        .o_cp_statement .o_cp_signatures td.o_cp_spacer { width: 32%; }
                    </style>
                    <div class="page">
                        <!-- Header: company letterhead as on the Khmer invoice. The empty right cell mirrors
                             the logo column so the company details stay centered on the page. -->
                        <table class="o_cp_letterhead">
                            <tr>
                                <td>
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Company Logo"/>
                                </td>
                                <td class="o_cp_company_info">
                                    <div class="o_cp_company"><span t-field="o.company_id.name"/></div>
                                    <div class="o_cp_tagline">រោងម៉ាស៊ីនតកិនស្រូវ ទិញ លក់ ស្រូវ អង្ករ ជី និងថ្នាំកសិកម្មគ្រប់ប្រភេទ</div>
                                    <div t-if="o.company_id.street or o.company_id.street2">
                                        <span t-field="o.company_id.street"/>
                                        <span t-if="o.company_id.street2" t-field="o.company_id.street2"/>
                                    </div>
                                    <div t-if="o.company_id.phone">Tel: <span t-field="o.company_id.phone"/></div>
                                </td>
                                <td class="o_cp_spacer"></td>
                            </tr>
                        </table>

                        <!-- Customer Information: report title and period on the left (left aligned),
                             customer details on the right (right aligned) -->
                        <table class="o_cp_customer">
                            <tr>
                                <td class="o_cp_report_info o_cp_title">របាយការណ៍អតិថិជន</td>
                                <td class="o_cp_customer_info"><span class="o_cp_label">អតិថិជនឈ្មោះ:</span> <span t-field="partner.name"/></td>
                            </tr>
                            <tr>
                                <td class="o_cp_report_info">ចាប់ពីប៊ុង: <span t-out="'%02d-%s-%d' % (date_from.day, km_months[date_from.month - 1], date_from.year)"/></td>
                                <td class="o_cp_customer_info"><span class="o_cp_label">អាស័យដ្ឋាន:</span> <span t-out="partner_address"/></td>
                            </tr>
                            <tr>
                                <td class="o_cp_report_info">រហូតដល់: <span t-out="'%02d-%s-%d' % (date_to.day, km_months[date_to.month - 1], date_to.year)"/></td>
                                <td class="o_cp_customer_info"><span class="o_cp_label">ទូរស័ព្ទ:</span> <span t-field="partner.phone"/></td>
                            </tr>
                        </table>

                        <!-- Invoices Section -->
                        <table class="o_cp_table">
                            <colgroup>
                                <col style="width: 8%;"/>
                                <col style="width: 22%;"/>
                                <col style="width: 32%;"/>
                                <col style="width: 38%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>ល.រ</th>
                                    <th>ថ្ងៃ.ខែ.ឆ្នាំ</th>
                                    <th>សរុបទឹកប្រាក់ក្នុងប៊ុង</th>
                                    <th>ផ្សេងៗ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="invoices" t-as="invoice">
                                    <td class="o_cp_center"><span t-out="invoice_index + 1"/></td>
                                    <td class="o_cp_center"><span t-out="invoice.invoice_date and invoice.invoice_date.strftime('%d-%m-%y')"/></td>
                                    <td class="o_cp_amount">
                                        <span class="o_cp_symbol" t-out="invoice.currency_id.symbol"/>
                                        <span t-out="invoice.amount_total" t-options="{'widget': 'float', 'precision': invoice.currency_id.decimal_places}"/>
                                    </td>
                                    <td class="o_cp_center"><span t-field="invoice.name"/></td>
                                </tr>
                                <tr t-if="not invoices">
                                    <td>&#160;</td><td></td><td></td><td></td>
                                </tr>
                                <tr class="o_cp_total">
                                    <td colspan="2" class="o_cp_center">សរុបនៅខ្វះ</td>
                                    <td colspan="2" class="o_cp_amount">
                                        <span class="o_cp_symbol" t-out="o.currency_id.symbol"/>
                                        <span t-out="o.total_invoice_amount" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Payment Entries Section (previous + current records) -->
                        <table class="o_cp_table">
                            <colgroup>
                                <col style="width: 8%;"/>
                                <col style="width: 22%;"/>
                                <col style="width: 32%;"/>
                                <col style="width: 38%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>ល.រ</th>
                                    <th>ថ្ងៃ.ខែ.ឆ្នាំ</th>
                                    <th>ទឹកប្រាក់បានសង</th>
                                    <th>ផ្សេងៗ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="all_payments" t-as="payment">
                                    <td class="o_cp_center"><span t-out="payment_index + 1"/></td>
                                    <td class="o_cp_center"><span t-out="payment.payment_date.strftime('%d-%m-%y')"/></td>
                                    <td class="o_cp_amount">
                                        <span class="o_cp_symbol" t-out="payment.currency_id.symbol"/>
                                        <span t-out="payment.amount" t-options="{'widget': 'float', 'precision': payment.currency_id.decimal_places}"/>
                                    </td>
                                    <td class="o_cp_center"><span t-field="payment.note"/></td>
                                </tr>
                                <tr t-if="not all_payments">
                                    <td>&#160;</td><td></td><td></td><td></td>
                                </tr>
                                <tr class="o_cp_total">
                                    <td colspan="2" class="o_cp_center">សរុបសងបាន</td>
                                    <td colspan="2" class="o_cp_amount">
                                        <span class="o_cp_symbol" t-out="o.currency_id.symbol"/>
                                        <span t-out="o.total_payment_amount" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/>
                                    </td>
                                </tr>
                                <tr class="o_cp_total">
                                    <td colspan="2" class="o_cp_center">សរុបនៅខ្វះ</td>
                                    <td colspan="2" class="o_cp_amount">
                                        <span class="o_cp_symbol" t-out="o.currency_id.symbol"/>
                                        <span t-out="o.balance" t-options="{'widget': 'float', 'precision': o.currency_id.decimal_places}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Notes Section -->
                        <div t-if="o.notes" class="o_cp_notes">
                            <strong>កំណត់សម្គាល់:</strong> <span t-field="o.notes"/>
                        </div>

                        <!-- Signatures -->
                        <table class="o_cp_signatures">
                            <tr>
                                <td>អ្នកលក់ ហត្ថលេខា</td>
                                <td class="o_cp_spacer"></td>
                                <td>អ្នកទិញ ហត្ថលេខា</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
