<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record id="fs_report_balance_sheet" model="fs.report">
      <field name="name">Balance Sheet</field>
      <field name="code">BS</field>
      <field name="report_type">balance_sheet</field>
    </record>

    <!-- ASSETS -->
    <record id="bs_assets" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/>
      <field name="sequence">10</field><field name="code">TA</field><field name="name">ASSETS</field>
      <field name="formula_type">none</field>
      <field name="horizontal_split_side">left</field>
    </record>
    <record id="bs_current_assets" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_assets"/>
      <field name="sequence">10</field><field name="code">CA</field><field name="name">Current Assets</field>
      <field name="formula_type">none</field>
    </record>
    <record id="bs_bank" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_assets"/>
      <field name="sequence">10</field><field name="code">BANK</field><field name="name">Bank and Cash Accounts</field>
      <field name="formula_type">account_type</field><field name="account_types">asset_cash</field>
    </record>
    <record id="bs_receivable" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_assets"/>
      <field name="sequence">20</field><field name="code">REC</field><field name="name">Receivables</field>
      <field name="formula_type">account_type</field><field name="account_types">asset_receivable</field>
    </record>
    <record id="bs_current_assets_other" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_assets"/>
      <field name="sequence">30</field><field name="code">CAO</field><field name="name">Current Assets</field>
      <field name="formula_type">account_type</field><field name="account_types">asset_current</field>
    </record>
    <record id="bs_prepayments" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_assets"/>
      <field name="sequence">40</field><field name="code">PRE</field><field name="name">Prepayments</field>
      <field name="formula_type">account_type</field><field name="account_types">asset_prepayments</field>
    </record>
    <record id="bs_fixed_assets" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_assets"/>
      <field name="sequence">20</field><field name="code">FA</field><field name="name">Fixed Assets</field>
      <field name="formula_type">account_type</field><field name="account_types">asset_fixed</field>
    </record>
    <record id="bs_non_current_assets" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_assets"/>
      <field name="sequence">30</field><field name="code">NCA</field><field name="name">Non-current Assets</field>
      <field name="formula_type">account_type</field><field name="account_types">asset_non_current</field>
    </record>

    <!-- LIABILITIES (sign -1 so credits show positive; green_on_positive=False like Enterprise) -->
    <record id="bs_liab_equity" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/>
      <field name="sequence">20</field><field name="code">TL</field><field name="name">LIABILITIES</field>
      <field name="formula_type">none</field>
      <field name="green_on_positive" eval="False"/>
      <field name="horizontal_split_side">right</field>
    </record>
    <record id="bs_current_liab" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_liab_equity"/>
      <field name="sequence">10</field><field name="code">CL</field><field name="name">Current Liabilities</field>
      <field name="formula_type">none</field>
      <field name="green_on_positive" eval="False"/>
    </record>
    <record id="bs_cl_other" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_liab"/>
      <field name="sequence">10</field><field name="code">CLO</field><field name="name">Current Liabilities</field>
      <field name="formula_type">account_type</field><field name="account_types">liability_current</field><field name="sign">-1</field>
      <field name="green_on_positive" eval="False"/>
    </record>
    <record id="bs_credit_card" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_liab"/>
      <field name="sequence">15</field><field name="code">CC</field><field name="name">Credit Card</field>
      <field name="formula_type">account_type</field><field name="account_types">liability_credit_card</field><field name="sign">-1</field>
      <field name="green_on_positive" eval="False"/>
    </record>
    <record id="bs_payable" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_current_liab"/>
      <field name="sequence">20</field><field name="code">PAY</field><field name="name">Payables</field>
      <field name="formula_type">account_type</field><field name="account_types">liability_payable</field><field name="sign">-1</field>
      <field name="green_on_positive" eval="False"/>
    </record>
    <record id="bs_ncl" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_liab_equity"/>
      <field name="sequence">20</field><field name="code">NCL</field><field name="name">Non-current Liabilities</field>
      <field name="formula_type">account_type</field><field name="account_types">liability_non_current</field><field name="sign">-1</field>
      <field name="green_on_positive" eval="False"/>
    </record>

    <!-- EQUITY (& EARNINGS) -->
    <record id="bs_equity" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/>
      <field name="sequence">30</field><field name="code">EQE</field><field name="name">EQUITY (&amp; EARNINGS)</field>
      <field name="formula_type">none</field>
      <field name="horizontal_split_side">right</field>
    </record>
    <record id="bs_retained" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_equity"/>
      <field name="sequence">10</field><field name="code">EQ</field><field name="name">Equity</field>
      <field name="formula_type">account_type</field><field name="account_types">equity</field><field name="sign">-1</field>
    </record>
    <record id="bs_unaff" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_equity"/>
      <field name="sequence">20</field><field name="code">ERN</field><field name="name">Earnings</field>
      <field name="formula_type">none</field>
    </record>
    <record id="bs_cye" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_unaff"/>
      <field name="sequence">10</field><field name="code">CYE</field><field name="name">Current Year Unallocated Earnings</field>
      <field name="formula_type">current_earnings</field><field name="sign">-1</field>
      <!-- Enterprise: action_id → Profit and Loss (name rendered as .clickable / action color). -->
      <field name="action_id" ref="action_fs_profit_and_loss"/>
    </record>
    <record id="bs_pye" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_unaff"/>
      <field name="sequence">20</field><field name="code">PYE</field><field name="name">Previous Years Earnings</field>
      <field name="formula_type">previous_earnings</field><field name="sign">-1</field>
    </record>

    <record id="bs_oci" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_equity"/>
      <field name="sequence">30</field><field name="code">OCI</field><field name="name">Other Comprehensive Income</field>
      <field name="formula_type">none</field><field name="hide_if_zero" eval="True"/>
    </record>
    <record id="bs_cta" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/><field name="parent_id" ref="bs_oci"/>
      <field name="sequence">10</field><field name="code">CTA</field><field name="name">Cumulative Translation Adjustments</field>
      <field name="formula_type">aggregation</field><field name="aggregation">TA-TL-EQ-ERN</field>
      <field name="hide_if_zero" eval="True"/>
    </record>

    <!-- TOTAL — Enterprise LE expression green_on_positive=False → red on increase -->
    <record id="bs_total_le" model="fs.report.line">
      <field name="report_id" ref="fs_report_balance_sheet"/>
      <field name="sequence">40</field><field name="code">TLE</field><field name="name">LIABILITIES + EQUITY</field>
      <field name="formula_type">aggregation</field><field name="aggregation">TL+EQE</field>
      <field name="green_on_positive" eval="False"/>
      <field name="horizontal_split_side">right</field>
    </record>
  </data>
</odoo>
