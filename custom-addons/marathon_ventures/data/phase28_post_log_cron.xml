<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Phase 28 - Post Log Import background processor.
         Runs every 2 minutes (auto-triggered on Queue Import; the
         schedule is just a safety net for anything left in queued
         state). Each execution processes every queued job in
         create-date order, one transaction per job so a failure
         doesn't block the next. -->
    <record id="cron_mv_post_log_import" model="ir.cron">
      <field name="name">Marathon Ventures: Process Post Log Import queue</field>
      <field name="model_id" ref="model_mv_post_log_import"/>
      <field name="state">code</field>
      <field name="code">model._cron_process_queued()</field>
      <field name="interval_number">2</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
