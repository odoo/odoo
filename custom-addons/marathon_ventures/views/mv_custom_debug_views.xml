<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_custom_debug_list" model="ir.ui.view">
    <field name="name">mv.custom_debug.list</field>
    <field name="model">mv.custom_debug</field>
    <field name="arch" type="xml">
      <list string="Custom Debug">
        <field name="name"/>
        <field name="classname"/>
        <field name="exceptionmessage"/>
        <field name="exceptiontype"/>
        <field name="linenumber"/>
        <field name="log"/>
        <field name="type"/>
      </list>
    </field>
  </record>

  <record id="view_mv_custom_debug_form" model="ir.ui.view">
    <field name="name">mv.custom_debug.form</field>
    <field name="model">mv.custom_debug</field>
    <field name="arch" type="xml">
      <form string="Custom Debug">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="type"/>
                <field name="classname"/>
                <field name="exceptionmessage"/>
              </group>
              <group>
                <field name="exceptiontype"/>
                <field name="log"/>
                <field name="linenumber"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_custom_debug_search" model="ir.ui.view">
    <field name="name">mv.custom_debug.search</field>
    <field name="model">mv.custom_debug</field>
    <field name="arch" type="xml">
      <search string="Custom Debug">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_custom_debug" model="ir.actions.act_window">
    <field name="name">Custom Debug</field>
    <field name="res_model">mv.custom_debug</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_custom_debug" name="Custom Debug" parent="menu_mv_finance" action="action_mv_custom_debug"/>
</odoo>
