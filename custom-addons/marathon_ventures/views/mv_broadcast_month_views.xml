<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_broadcast_month_list" model="ir.ui.view">
    <field name="name">mv.broadcast_month.list</field>
    <field name="model">mv.broadcast_month</field>
    <field name="arch" type="xml">
      <list string="Broadcast Month">
        <field name="name"/>
        <field name="end_date"/>
        <field name="start_date"/>
      </list>
    </field>
  </record>

  <record id="view_mv_broadcast_month_form" model="ir.ui.view">
    <field name="name">mv.broadcast_month.form</field>
    <field name="model">mv.broadcast_month</field>
    <field name="arch" type="xml">
      <form string="Broadcast Month">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="end_date"/>
              </group>
              <group>
                <field name="start_date"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_broadcast_month_search" model="ir.ui.view">
    <field name="name">mv.broadcast_month.search</field>
    <field name="model">mv.broadcast_month</field>
    <field name="arch" type="xml">
      <search string="Broadcast Month">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_broadcast_month" model="ir.actions.act_window">
    <field name="name">Broadcast Month</field>
    <field name="res_model">mv.broadcast_month</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_broadcast_month" name="Broadcast Month" parent="menu_mv_finance" action="action_mv_broadcast_month"/>
</odoo>
