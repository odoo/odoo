<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_opportunity_line_item_list" model="ir.ui.view">
    <field name="name">mv.opportunity_line_item.list</field>
    <field name="model">mv.opportunity_line_item</field>
    <field name="arch" type="xml">
      <list string="Opportunity Line Item">
        <field name="description"/>
        <field name="discount"/>
        <field name="listprice"/>
        <field name="name"/>
        <field name="opportunityid"/>
        <field name="product2id"/>
        <field name="productcode"/>
      </list>
    </field>
  </record>

  <record id="view_mv_opportunity_line_item_form" model="ir.ui.view">
    <field name="name">mv.opportunity_line_item.form</field>
    <field name="model">mv.opportunity_line_item</field>
    <field name="arch" type="xml">
      <form string="Opportunity Line Item">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="opportunityid"/>
                <field name="product2id"/>
                <field name="serviceenddate"/>
                <field name="description"/>
                <field name="discount"/>
                <field name="listprice"/>
              </group>
              <group>
                <field name="productcode"/>
                <field name="quantity"/>
                <field name="servicedate"/>
                <field name="subtotal"/>
                <field name="totalprice"/>
                <field name="unitprice"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_opportunity_line_item_search" model="ir.ui.view">
    <field name="name">mv.opportunity_line_item.search</field>
    <field name="model">mv.opportunity_line_item</field>
    <field name="arch" type="xml">
      <search string="Opportunity Line Item">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_opportunity_line_item" model="ir.actions.act_window">
    <field name="name">Opportunity Line Item</field>
    <field name="res_model">mv.opportunity_line_item</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_opportunity_line_item" name="Opportunity Line Item" parent="menu_mv_finance" action="action_mv_opportunity_line_item"/>
</odoo>
