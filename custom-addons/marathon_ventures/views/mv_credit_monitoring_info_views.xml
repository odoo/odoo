<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_credit_monitoring_info_list" model="ir.ui.view">
    <field name="name">mv.credit_monitoring_info.list</field>
    <field name="model">mv.credit_monitoring_info</field>
    <field name="arch" type="xml">
      <list string="Credit Monitoring Info">
        <field name="name"/>
        <field name="batch_id"/>
        <field name="errors"/>
        <field name="status"/>
      </list>
    </field>
  </record>

  <record id="view_mv_credit_monitoring_info_form" model="ir.ui.view">
    <field name="name">mv.credit_monitoring_info.form</field>
    <field name="model">mv.credit_monitoring_info</field>
    <field name="arch" type="xml">
      <form string="Credit Monitoring Info">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="batch_id"/>
                <field name="errors"/>
              </group>
              <group>
                <field name="status"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_credit_monitoring_info_search" model="ir.ui.view">
    <field name="name">mv.credit_monitoring_info.search</field>
    <field name="model">mv.credit_monitoring_info</field>
    <field name="arch" type="xml">
      <search string="Credit Monitoring Info">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_credit_monitoring_info" model="ir.actions.act_window">
    <field name="name">Credit Monitoring Info</field>
    <field name="res_model">mv.credit_monitoring_info</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_credit_monitoring_info" name="Credit Monitoring Info" parent="menu_mv_finance" action="action_mv_credit_monitoring_info"/>
</odoo>
