<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_tape_list" model="ir.ui.view">
    <field name="name">mv.tape.list</field>
    <field name="model">mv.tape</field>
    <field name="arch" type="xml">
      <list string="Tape">
        <field name="name"/>
        <field name="account"/>
        <field name="advertiser"/>
        <field name="brand"/>
        <field name="flight_end"/>
        <field name="flight_start"/>
        <field name="isci_2"/>
        <field name="isci_3"/>
      </list>
    </field>
  </record>

  <record id="view_mv_tape_form" model="ir.ui.view">
    <field name="name">mv.tape.form</field>
    <field name="model">mv.tape</field>
    <field name="arch" type="xml">
      <form string="Tape">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="account"/>
                <field name="brand"/>
                <field name="program"/>
                <field name="length"/>
                <field name="rotation"/>
                <field name="flight_end"/>
              </group>
              <group>
                <field name="flight_start"/>
                <field name="advertiser"/>
                <field name="isci"/>
                <field name="isci_2"/>
                <field name="isci_3"/>
                <field name="x800_number"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_tape_search" model="ir.ui.view">
    <field name="name">mv.tape.search</field>
    <field name="model">mv.tape</field>
    <field name="arch" type="xml">
      <search string="Tape">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_tape" model="ir.actions.act_window">
    <field name="name">Tape</field>
    <field name="res_model">mv.tape</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_tape" name="Tape" parent="menu_mv_finance" action="action_mv_tape"/>
</odoo>
