<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Phase 25 - Bundle Paperwork wizard view.
    Modal with a single primary button: Generate Paperwork. After
    generation the wizard reopens with the generated files listed so
    they can be downloaded directly from the dialog too (they also
    appear under the Deal's Related tab and its Attachments box).
  -->

  <record id="view_mv_bundle_paperwork_wizard_form" model="ir.ui.view">
    <field name="name">mv.bundle_paperwork.wizard.form</field>
    <field name="model">mv.bundle_paperwork.wizard</field>
    <field name="arch" type="xml">
      <form string="Bundle Paperwork">
        <sheet>
          <div class="oe_title">
            <h2>Bundle Paperwork</h2>
          </div>

          <div style="margin-bottom: 18px;">
            <button name="action_generate_paperwork"
                    type="object"
                    string="Generate Paperwork"
                    class="btn-primary"/>
          </div>

          <field name="deal_id" invisible="1"/>
          <field name="state" invisible="1"/>

          <div invisible="not attachment_ids">
            <h4>Generated Files</h4>
            <field name="attachment_ids" nolabel="1" readonly="1">
              <list create="false" edit="false" delete="false"
                    decoration-info="1">
                <field name="name" string="File"/>
                <field name="mv_bundle_paperwork_kind" string="Kind"/>
                <field name="datas" widget="binary_download"
                       filename="name" string="Download"/>
              </list>
            </field>
          </div>

          <div invisible="attachment_ids"
               class="text-muted"
               style="margin-top: 12px;">
            <p>
              Click <b>Generate Paperwork</b> to build the bundle XML
              (one file per station) and the Excel summary. Files are
              attached to this Deal and will also appear under the
              Deal's Related tab and Attachments box.
            </p>
          </div>
        </sheet>

        <footer>
          <button string="Close" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_mv_bundle_paperwork_wizard" model="ir.actions.act_window">
    <field name="name">Bundle Paperwork</field>
    <field name="res_model">mv.bundle_paperwork.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
