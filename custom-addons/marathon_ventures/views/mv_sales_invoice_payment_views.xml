<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_sales_invoice_payment_list" model="ir.ui.view">
    <field name="name">mv.sales_invoice_payment.list</field>
    <field name="model">mv.sales_invoice_payment</field>
    <field name="arch" type="xml">
      <list string="Sales Invoice Payment">
        <field name="name"/>
        <field name="amount"/>
        <field name="document_number"/>
        <field name="payment_date"/>
        <field name="payment_method"/>
        <field name="payment_recordkey"/>
        <field name="payment_type"/>
        <field name="posting_date"/>
      </list>
    </field>
  </record>

  <record id="view_mv_sales_invoice_payment_form" model="ir.ui.view">
    <field name="name">mv.sales_invoice_payment.form</field>
    <field name="model">mv.sales_invoice_payment</field>
    <field name="arch" type="xml">
      <form string="Sales Invoice Payment">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="sales_invoice"/>
                <field name="payment_date"/>
                <field name="posting_date"/>
                <field name="receipt_date"/>
                <field name="document_number"/>
              </group>
              <group>
                <field name="payment_method"/>
                <field name="payment_recordkey"/>
                <field name="payment_type"/>
                <field name="amount"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_sales_invoice_payment_search" model="ir.ui.view">
    <field name="name">mv.sales_invoice_payment.search</field>
    <field name="model">mv.sales_invoice_payment</field>
    <field name="arch" type="xml">
      <search string="Sales Invoice Payment">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_sales_invoice_payment" model="ir.actions.act_window">
    <field name="name">Sales Invoice Payment</field>
    <field name="res_model">mv.sales_invoice_payment</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_sales_invoice_payment" name="Sales Invoice Payment" parent="menu_mv_finance" action="action_mv_sales_invoice_payment"/>
</odoo>
