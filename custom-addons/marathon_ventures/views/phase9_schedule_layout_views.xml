<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- PHASE 9 - Schedule Creation form redesign (regrouped per Arianna). -->

  <record id="view_mv_schedules_form_phase9_layout" model="ir.ui.view">
    <field name="name">mv.schedules.form.phase9.layout</field>
    <field name="model">mv.schedules</field>
    <field name="inherit_id" ref="marathon_ventures.view_mv_schedules_form"/>
    <field name="priority">200</field>
    <field name="arch" type="xml">

      <xpath expr="//form" position="attributes">
        <attribute name="class">mv-deal-redesign</attribute>
      </xpath>

      <!-- (A) Banner: record name on left, Record Type radio on right. -->
      <xpath expr="//div[hasclass('oe_title')]" position="replace">
        <div class="mv-deal-banner d-flex justify-content-between align-items-center">
          <span>
            <span invisible="id">New Schedule</span>
            <span invisible="not id">
              <field name="name" readonly="1" nolabel="1" class="oe_inline"/>
            </span>
          </span>
          <span class="d-flex align-items-center">
            <span class="mv-section-label me-2"
                  style="margin:0; border:0; padding:0;">RECORD TYPE</span>
            <field name="sf_record_type" widget="radio"
                   options="{'horizontal': true}" nolabel="1"/>
          </span>
        </div>
      </xpath>

      <!-- (B) Replace Details page with the regrouped layout. -->
      <xpath expr="//notebook/page[1]" position="replace">
        <page string="Details" name="page_details">

          <!-- ===== 1. TIMING ===== -->
          <div class="mv-section-label">TIMING</div>
          <group col="4" name="grp_timing"
                 class="mv-essentials-grid mv-essentials-grid-4">
            <group>
              <field name="week" string="Start Week" required="1"/>
            </group>
            <group>
              <field name="start_time"/>
            </group>
            <group>
              <field name="end_time"/>
            </group>
            <group>
              <field name="days_allowed" widget="many2many_tags"/>
            </group>
          </group>

          <!-- ===== 2. PRICING ===== -->
          <div class="mv-section-label">PRICING</div>
          <group col="4" name="grp_pricing"
                 class="mv-essentials-grid mv-essentials-grid-4">
            <group>
              <field name="rate" required="1" widget="monetary"/>
            </group>
            <group>
              <field name="units_available" required="1"/>
            </group>
            <group>
              <field name="cap"/>
            </group>
            <group>
              <field name="total_dollars" widget="monetary" readonly="1"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>

          <!-- ===== 3. TARGETING ===== -->
          <div class="mv-section-label">TARGETING</div>
          <group col="3" name="grp_targeting" class="mv-essentials-grid">
            <group>
              <field name="networks"/>
            </group>
            <group>
              <field name="daypart" readonly="1"/>
            </group>
            <group>
              <field name="program" readonly="1"/>
              <field name="deal_parent"/>
            </group>
          </group>

          <!-- ===== 4. ADDITIONAL ===== -->
          <div class="mv-section-label">ADDITIONAL</div>
          <group col="2" name="grp_additional_sched"
                 class="mv-essentials-grid mv-essentials-grid-2">
            <group>
              <field name="additional_weeks"/>
            </group>
            <group>
              <field name="end_week_auto" string="End Week (auto-filled)"/>
            </group>
          </group>

          <!-- Campaign Total card sits below Pricing-related sections. -->
          <div class="mv-campaign-total">
            <span class="mv-campaign-total-label">CAMPAIGN TOTAL (ALL WEEKS)</span>
            <span class="mv-campaign-total-value">
              <field name="total_dollars" widget="monetary"
                     readonly="1" nolabel="1"/>
            </span>
            <span class="mv-campaign-total-formula">
              = Rate &#215; Units Available &#215; (1 + Additional Weeks)
            </span>
          </div>

          <!-- ===== ADVANCED (collapse bar) ===== -->
          <div class="mv-additional-bar" name="mv_advanced_bar">
            <span>
              <button name="action_toggle_advanced_schedule"
                      type="object"
                      class="btn btn-link p-0 mv-additional-caret"
                      string=" "/>
              <span class="mv-additional-label">
                Advanced (max per day, sub-day-part overrides, custom flags)
              </span>
            </span>
            <span class="mv-additional-hint">
              <span invisible="show_advanced_schedule">collapsed by default</span>
              <span invisible="not show_advanced_schedule">expanded</span>
            </span>
          </div>
          <field name="show_advanced_schedule" invisible="1"/>

          <group col="2" name="grp_advanced"
                 invisible="not show_advanced_schedule">
            <group string="Spot Constraints">
              <field name="max_per_day"/>
              <field name="status"/>
              <field name="priority_rank"/>
              <field name="long_form"/>
              <field name="special"/>
              <field name="program_specific"/>
            </group>
            <group string="Rollup / Computed">
              <field name="equiv_30" readonly="1"/>
              <field name="adus_estimated" readonly="1"/>
              <field name="adus_generated" readonly="1"/>
              <field name="total_schedules" readonly="1"/>
              <field name="start_end_time" readonly="1"/>
              <field name="weighted_priority" readonly="1"/>
            </group>
          </group>

          <!-- ===== FOOTER ===== -->

          <!-- ===== FOOTER ===== -->
          <div class="mv-form-footer">
            <button name="action_cancel_schedule" type="object"
                    string="Cancel" class="btn btn-secondary"/>
            <button name="action_save_record" type="object"
                    string="Save Schedule" class="btn btn-primary"/>
          </div>

        </page>
      </xpath>
    </field>
  </record>
</odoo>
