<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_credit_monitoring_list" model="ir.ui.view">
    <field name="name">mv.credit_monitoring.list</field>
    <field name="model">mv.credit_monitoring</field>
    <field name="arch" type="xml">
      <list string="Credit Monitoring">
        <field name="name"/>
        <field name="advertiser"/>
        <field name="agency"/>
        <field name="credit_application"/>
        <field name="credit_limit_percentage"/>
        <field name="credit_limit"/>
        <field name="credit_monitoring_name"/>
        <field name="cumulative_gross_uninvoiced_dollars"/>
      </list>
    </field>
  </record>

  <record id="view_mv_credit_monitoring_form" model="ir.ui.view">
    <field name="name">mv.credit_monitoring.form</field>
    <field name="model">mv.credit_monitoring</field>
    <field name="arch" type="xml">
      <form string="Credit Monitoring">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="credit_application"/>
                <field name="week"/>
                <field name="advertiser"/>
                <field name="agency"/>
                <field name="credit_monitoring_name"/>
                <field name="credit_limit"/>
                <field name="credit_limit_percentage"/>
              </group>
              <group>
                <field name="cumulative_gross_uninvoiced_dollars"/>
                <field name="cumulative_net_uninvoiced_dollars"/>
                <field name="intacct_open_balances"/>
                <field name="open_credit"/>
                <field name="remaining_credit_limit"/>
                <field name="total_open_balance"/>
                <field name="week_gross_uninvoiced_dollars"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_credit_monitoring_search" model="ir.ui.view">
    <field name="name">mv.credit_monitoring.search</field>
    <field name="model">mv.credit_monitoring</field>
    <field name="arch" type="xml">
      <search string="Credit Monitoring">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_credit_monitoring" model="ir.actions.act_window">
    <field name="name">Credit Monitoring</field>
    <field name="res_model">mv.credit_monitoring</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_credit_monitoring" name="Credit Monitoring" parent="menu_mv_finance" action="action_mv_credit_monitoring"/>
</odoo>
