<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Basic list + form for Deal Lines (admin access). The OWL Units
       Grid is the primary UI but admins / power users may want raw
       record management. -->

  <record id="view_mv_deal_line_list" model="ir.ui.view">
    <field name="name">mv.deal_line.list</field>
    <field name="model">mv.deal_line</field>
    <field name="arch" type="xml">
      <list string="Deal Lines">
        <field name="deal_id"/>
        <field name="daypart"/>
        <field name="time_range"/>
        <field name="rate" widget="monetary"/>
        <field name="run_start"/>
        <field name="run_end"/>
        <field name="total_spots"/>
        <field name="total_revenue" widget="monetary"/>
        <field name="currency_id" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_mv_deal_line_form" model="ir.ui.view">
    <field name="name">mv.deal_line.form</field>
    <field name="model">mv.deal_line</field>
    <field name="arch" type="xml">
      <form string="Deal Line">
        <sheet>
          <group col="3">
            <group>
              <field name="deal_id"/>
              <field name="daypart"/>
              <field name="time_range"/>
            </group>
            <group>
              <field name="rate" widget="monetary"/>
              <field name="run_start"/>
              <field name="run_end"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group string="Days of Week">
              <field name="day_mon"/>
              <field name="day_tue"/>
              <field name="day_wed"/>
              <field name="day_thu"/>
              <field name="day_fri"/>
              <field name="day_sat"/>
              <field name="day_sun"/>
            </group>
          </group>
          <group>
            <field name="total_spots" readonly="1"/>
            <field name="total_revenue" widget="monetary" readonly="1"/>
          </group>
          <notebook>
            <page string="Schedules">
              <field name="schedule_ids">
                <list>
                  <field name="week"/>
                  <field name="units_available"/>
                  <field name="rate" widget="monetary"/>
                  <field name="total_dollars" widget="monetary"/>
                  <field name="status"/>
                  <field name="cap"/>
                  <field name="currency_id" column_invisible="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_mv_deal_line" model="ir.actions.act_window">
    <field name="name">Deal Lines</field>
    <field name="res_model">mv.deal_line</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_deal_line"
            name="Deal Lines"
            parent="menu_mv_sales_ops"
            action="action_mv_deal_line"
            sequence="15"/>

  <!-- Add a "Units Report" tab to the Deal form that mounts the OWL
       widget. The widget reads its deal id from the form's record id
       (via the `mv_units_grid` field name we register in JS). -->
  <record id="view_mv_deal_form_phase10_units" model="ir.ui.view">
    <field name="name">mv.deal.form.phase10.units</field>
    <field name="model">mv.deal</field>
    <field name="inherit_id" ref="marathon_ventures.view_mv_deal_form"/>
    <field name="priority">250</field>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Units Report" name="page_units_report"
              invisible="not id">
          <!-- The OWL widget hooks onto this div via an mv_units_grid
               field widget. We give it a hidden tech field so Odoo's
               record loader passes the deal id through. -->
          <field name="id" widget="mv_units_grid" nolabel="1"/>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
