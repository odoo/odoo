<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_agency_double_check_list" model="ir.ui.view">
    <field name="name">mv.agency_double_check.list</field>
    <field name="model">mv.agency_double_check</field>
    <field name="arch" type="xml">
      <list string="Agency Double Check">
        <field name="name"/>
        <field name="deal_account"/>
        <field name="prelog_agency"/>
      </list>
    </field>
  </record>

  <record id="view_mv_agency_double_check_form" model="ir.ui.view">
    <field name="name">mv.agency_double_check.form</field>
    <field name="model">mv.agency_double_check</field>
    <field name="arch" type="xml">
      <form string="Agency Double Check">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="deal_account"/>
              </group>
              <group>
                <field name="prelog_agency"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_agency_double_check_search" model="ir.ui.view">
    <field name="name">mv.agency_double_check.search</field>
    <field name="model">mv.agency_double_check</field>
    <field name="arch" type="xml">
      <search string="Agency Double Check">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_agency_double_check" model="ir.actions.act_window">
    <field name="name">Agency Double Check</field>
    <field name="res_model">mv.agency_double_check</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_agency_double_check" name="Agency Double Check" parent="menu_mv_finance" action="action_mv_agency_double_check"/>
</odoo>
