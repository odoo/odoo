  <record id="view_mv_rating_detail_search" model="ir.ui.view">
    <field name="name">mv.rating_detail.search</field>
    <field name="model">mv.rating_detail</field>
    <field name="arch" type="xml">
      <search string="Rating Detail">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_rating_detail" model="ir.actions.act_window">
    <field name="name">Rating Detail</field>
    <field name="res_model">mv.rating_detail</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_rating_detail" name="Rating Detail" parent="menu_mv_finance" action="action_mv_rating_detail"/>
