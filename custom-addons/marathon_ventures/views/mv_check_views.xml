<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_check_list" model="ir.ui.view">
    <field name="name">mv.check.list</field>
    <field name="model">mv.check</field>
    <field name="arch" type="xml">
      <list string="Check">
        <field name="name"/>
        <field name="checkdate"/>
        <field name="check_number"/>
        <field name="program"/>
        <field name="total_dollars"/>
      </list>
    </field>
  </record>

  <record id="view_mv_check_form" model="ir.ui.view">
    <field name="name">mv.check.form</field>
    <field name="model">mv.check</field>
    <field name="arch" type="xml">
      <form string="Check">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="check_number"/>
                <field name="program"/>
              </group>
              <group>
                <field name="checkdate"/>
                <field name="total_dollars"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_check_search" model="ir.ui.view">
    <field name="name">mv.check.search</field>
    <field name="model">mv.check</field>
    <field name="arch" type="xml">
      <search string="Check">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_check" model="ir.actions.act_window">
    <field name="name">Check</field>
    <field name="res_model">mv.check</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_check" name="Check" parent="menu_mv_finance" action="action_mv_check"/>
</odoo>
