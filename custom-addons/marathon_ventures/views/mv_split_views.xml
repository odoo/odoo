<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_split_list" model="ir.ui.view">
    <field name="name">mv.split.list</field>
    <field name="model">mv.split</field>
    <field name="arch" type="xml">
      <list string="Split">
        <field name="name"/>
        <field name="active"/>
        <field name="days_allowed" widget="many2many_tags"/>
        <field name="double_check_date"/>
        <field name="double_check"/>
        <field name="end_date"/>
        <field name="end_time"/>
        <field name="isci_no_char"/>
      </list>
    </field>
  </record>

  <record id="view_mv_split_form" model="ir.ui.view">
    <field name="name">mv.split.form</field>
    <field name="model">mv.split</field>
    <field name="arch" type="xml">
      <form string="Split">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="traffic"/>
                <field name="video_file"/>
                <field name="length"/>
                <field name="double_check_date"/>
                <field name="end_date"/>
                <field name="start_date"/>
                <field name="isci"/>
                <field name="isci_no_char"/>
              </group>
              <group>
                <field name="spot_name"/>
                <field name="x800_number"/>
                <field name="active"/>
                <field name="double_check"/>
                <field name="days_allowed" widget="mv_days_picker"/>
                <field name="end_time"/>
                <field name="rotation"/>
                <field name="start_time"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_split_search" model="ir.ui.view">
    <field name="name">mv.split.search</field>
    <field name="model">mv.split</field>
    <field name="arch" type="xml">
      <search string="Split">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_split" model="ir.actions.act_window">
    <field name="name">Split</field>
    <field name="res_model">mv.split</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_split" name="Split" parent="menu_mv_sales_ops" action="action_mv_split"/>
</odoo>
