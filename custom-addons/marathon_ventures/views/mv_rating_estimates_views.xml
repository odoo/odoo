<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_rating_estimates_list" model="ir.ui.view">
    <field name="name">mv.rating_estimates.list</field>
    <field name="model">mv.rating_estimates</field>
    <field name="arch" type="xml">
      <list string="Rating Estimates">
        <field name="name"/>
        <field name="a25_54_000"/>
        <field name="a25_54"/>
        <field name="end_date"/>
        <field name="hh_000"/>
        <field name="hh"/>
        <field name="program"/>
        <field name="season"/>
      </list>
    </field>
  </record>

  <record id="view_mv_rating_estimates_form" model="ir.ui.view">
    <field name="name">mv.rating_estimates.form</field>
    <field name="model">mv.rating_estimates</field>
    <field name="arch" type="xml">
      <form string="Rating Estimates">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="program"/>
                <field name="season"/>
                <field name="end_date"/>
                <field name="start_date"/>
              </group>
              <group>
                <field name="a25_54"/>
                <field name="a25_54_000"/>
                <field name="hh"/>
                <field name="hh_000"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_rating_estimates_search" model="ir.ui.view">
    <field name="name">mv.rating_estimates.search</field>
    <field name="model">mv.rating_estimates</field>
    <field name="arch" type="xml">
      <search string="Rating Estimates">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_rating_estimates" model="ir.actions.act_window">
    <field name="name">Rating Estimates</field>
    <field name="res_model">mv.rating_estimates</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_rating_estimates" name="Rating Estimates" parent="menu_mv_finance" action="action_mv_rating_estimates"/>
</odoo>
