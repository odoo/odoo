<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_pto_list" model="ir.ui.view">
    <field name="name">mv.pto.list</field>
    <field name="model">mv.pto</field>
    <field name="arch" type="xml">
      <list string="Pto">
        <field name="name"/>
        <field name="employee"/>
      </list>
    </field>
  </record>

  <record id="view_mv_pto_form" model="ir.ui.view">
    <field name="name">mv.pto.form</field>
    <field name="model">mv.pto</field>
    <field name="arch" type="xml">
      <form string="Pto">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="employee"/>
              </group>
              <group>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_pto_search" model="ir.ui.view">
    <field name="name">mv.pto.search</field>
    <field name="model">mv.pto</field>
    <field name="arch" type="xml">
      <search string="Pto">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_pto" model="ir.actions.act_window">
    <field name="name">Pto</field>
    <field name="res_model">mv.pto</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_pto" name="Pto" parent="menu_mv_finance" action="action_mv_pto"/>
</odoo>
