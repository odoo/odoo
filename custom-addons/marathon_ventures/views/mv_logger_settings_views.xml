<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_logger_settings_list" model="ir.ui.view">
    <field name="name">mv.logger_settings.list</field>
    <field name="model">mv.logger_settings</field>
    <field name="arch" type="xml">
      <list string="Logger Settings">
        <field name="name"/>
        <field name="enabled"/>
      </list>
    </field>
  </record>

  <record id="view_mv_logger_settings_form" model="ir.ui.view">
    <field name="name">mv.logger_settings.form</field>
    <field name="model">mv.logger_settings</field>
    <field name="arch" type="xml">
      <form string="Logger Settings">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="enabled"/>
              </group>
              <group>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_logger_settings_search" model="ir.ui.view">
    <field name="name">mv.logger_settings.search</field>
    <field name="model">mv.logger_settings</field>
    <field name="arch" type="xml">
      <search string="Logger Settings">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_logger_settings" model="ir.actions.act_window">
    <field name="name">Logger Settings</field>
    <field name="res_model">mv.logger_settings</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_logger_settings" name="Logger Settings" parent="menu_mv_finance" action="action_mv_logger_settings"/>
</odoo>
