<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_clearance_list" model="ir.ui.view">
    <field name="name">mv.clearance.list</field>
    <field name="model">mv.clearance</field>
    <field name="arch" type="xml">
      <list string="Clearance">
        <field name="name"/>
        <field name="aa_hh"/>
        <field name="affiliate"/>
        <field name="call_letters"/>
        <field name="clearance_list"/>
        <field name="daypart"/>
        <field name="first_time_period"/>
        <field name="launch_date"/>
      </list>
    </field>
  </record>

  <record id="view_mv_clearance_form" model="ir.ui.view">
    <field name="name">mv.clearance.form</field>
    <field name="model">mv.clearance</field>
    <field name="arch" type="xml">
      <form string="Clearance">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="clearance_list"/>
                <field name="launch_date"/>
                <field name="station"/>
                <field name="daypart"/>
                <field name="off_air_date"/>
                <field name="affiliate"/>
              </group>
              <group>
                <field name="call_letters"/>
                <field name="first_time_period"/>
                <field name="market"/>
                <field name="second_time_period"/>
                <field name="aa_hh"/>
                <field name="us_hh"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_clearance_search" model="ir.ui.view">
    <field name="name">mv.clearance.search</field>
    <field name="model">mv.clearance</field>
    <field name="arch" type="xml">
      <search string="Clearance">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_clearance" model="ir.actions.act_window">
    <field name="name">Clearance</field>
    <field name="res_model">mv.clearance</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_clearance" name="Clearance" parent="menu_mv_finance" action="action_mv_clearance"/>
</odoo>
