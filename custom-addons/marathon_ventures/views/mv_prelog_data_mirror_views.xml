<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_prelog_data_mirror_list" model="ir.ui.view">
    <field name="name">mv.prelog_data_mirror.list</field>
    <field name="model">mv.prelog_data_mirror</field>
    <field name="arch" type="xml">
      <list string="Prelog Data Mirror">
        <field name="name"/>
        <field name="advertiserproduct"/>
        <field name="agency"/>
        <field name="airdate"/>
        <field name="batch_id"/>
        <field name="breakcode"/>
        <field name="commercial_type"/>
        <field name="current_home"/>
      </list>
    </field>
  </record>

  <record id="view_mv_prelog_data_mirror_form" model="ir.ui.view">
    <field name="name">mv.prelog_data_mirror.form</field>
    <field name="model">mv.prelog_data_mirror</field>
    <field name="arch" type="xml">
      <form string="Prelog Data Mirror">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="version"/>
                <field name="deal"/>
                <field name="prelogdata"/>
                <field name="schedule"/>
                <field name="removal_reason"/>
                <field name="airdate"/>
                <field name="week"/>
                <field name="advertiserproduct"/>
                <field name="agency"/>
                <field name="batch_id"/>
                <field name="breakcode"/>
                <field name="commercial_type"/>
                <field name="current_home"/>
                <field name="field1"/>
                <field name="log_schedule"/>
              </group>
              <group>
                <field name="materialdescription"/>
                <field name="network"/>
                <field name="networkdealnumber"/>
                <field name="orderproductdescription"/>
                <field name="product"/>
                <field name="reason_for_unmatched"/>
                <field name="scheduleadid"/>
                <field name="schedulelength"/>
                <field name="scheduletime"/>
                <field name="timeperiod"/>
                <field name="problem"/>
                <field name="processrequired"/>
                <field name="errorreason"/>
                <field name="line"/>
                <field name="rate"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_prelog_data_mirror_search" model="ir.ui.view">
    <field name="name">mv.prelog_data_mirror.search</field>
    <field name="model">mv.prelog_data_mirror</field>
    <field name="arch" type="xml">
      <search string="Prelog Data Mirror">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_prelog_data_mirror" model="ir.actions.act_window">
    <field name="name">Prelog Data Mirror</field>
    <field name="res_model">mv.prelog_data_mirror</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_prelog_data_mirror" name="Prelog Data Mirror" parent="menu_mv_operations" action="action_mv_prelog_data_mirror" sequence="12"/>
</odoo>
