<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_ratings_compiled_list" model="ir.ui.view">
    <field name="name">mv.ratings_compiled.list</field>
    <field name="model">mv.ratings_compiled</field>
    <field name="arch" type="xml">
      <list string="Ratings Compiled">
        <field name="name"/>
        <field name="aur"/>
        <field name="adjustedholidayrevenue"/>
        <field name="budget_label"/>
        <field name="cpm"/>
        <field name="current_version"/>
        <field name="daypart"/>
        <field name="demographic"/>
      </list>
    </field>
  </record>

  <record id="view_mv_ratings_compiled_form" model="ir.ui.view">
    <field name="name">mv.ratings_compiled.form</field>
    <field name="model">mv.ratings_compiled</field>
    <field name="arch" type="xml">
      <form string="Ratings Compiled">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="program"/>
                <field name="budget_label"/>
                <field name="daypart"/>
                <field name="playback"/>
                <field name="rc_order"/>
                <field name="type"/>
                <field name="month"/>
                <field name="week"/>
                <field name="demographic"/>
                <field name="ratings_id"/>
                <field name="reconciled"/>
                <field name="source"/>
                <field name="current_version"/>
              </group>
              <group>
                <field name="adjustedholidayrevenue"/>
                <field name="aur"/>
                <field name="cpm"/>
                <field name="distribution"/>
                <field name="dollar_amount"/>
                <field name="holiday_adjustment"/>
                <field name="hours_in_time_period"/>
                <field name="impressions"/>
                <field name="inv"/>
                <field name="us_m_hh"/>
                <field name="week_in_year"/>
                <field name="year"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_ratings_compiled_search" model="ir.ui.view">
    <field name="name">mv.ratings_compiled.search</field>
    <field name="model">mv.ratings_compiled</field>
    <field name="arch" type="xml">
      <search string="Ratings Compiled">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_ratings_compiled" model="ir.actions.act_window">
    <field name="name">Ratings Compiled</field>
    <field name="res_model">mv.ratings_compiled</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_ratings_compiled" name="Ratings Compiled" parent="menu_mv_finance" action="action_mv_ratings_compiled"/>
</odoo>
