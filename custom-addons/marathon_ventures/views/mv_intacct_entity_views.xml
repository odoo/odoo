<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_intacct_entity_list" model="ir.ui.view">
    <field name="name">mv.intacct_entity.list</field>
    <field name="model">mv.intacct_entity</field>
    <field name="arch" type="xml">
      <list string="Intacct Entity">
        <field name="name"/>
        <field name="parent_entity"/>
      </list>
    </field>
  </record>

  <record id="view_mv_intacct_entity_form" model="ir.ui.view">
    <field name="name">mv.intacct_entity.form</field>
    <field name="model">mv.intacct_entity</field>
    <field name="arch" type="xml">
      <form string="Intacct Entity">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="parent_entity"/>
              </group>
              <group>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_intacct_entity_search" model="ir.ui.view">
    <field name="name">mv.intacct_entity.search</field>
    <field name="model">mv.intacct_entity</field>
    <field name="arch" type="xml">
      <search string="Intacct Entity">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_intacct_entity" model="ir.actions.act_window">
    <field name="name">Intacct Entity</field>
    <field name="res_model">mv.intacct_entity</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_intacct_entity" name="Intacct Entity" parent="menu_mv_finance" action="action_mv_intacct_entity"/>
</odoo>
