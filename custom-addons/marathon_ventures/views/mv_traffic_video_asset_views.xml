<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_traffic_video_asset_list" model="ir.ui.view">
    <field name="name">mv.traffic_video_asset.list</field>
    <field name="model">mv.traffic_video_asset</field>
    <field name="arch" type="xml">
      <list string="Traffic Video Asset">
        <field name="name"/>
        <field name="deal"/>
        <field name="traffic"/>
        <field name="video_asset"/>
      </list>
    </field>
  </record>

  <record id="view_mv_traffic_video_asset_form" model="ir.ui.view">
    <field name="name">mv.traffic_video_asset.form</field>
    <field name="model">mv.traffic_video_asset</field>
    <field name="arch" type="xml">
      <form string="Traffic Video Asset">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="deal"/>
                <field name="traffic"/>
              </group>
              <group>
                <field name="video_asset"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_traffic_video_asset_search" model="ir.ui.view">
    <field name="name">mv.traffic_video_asset.search</field>
    <field name="model">mv.traffic_video_asset</field>
    <field name="arch" type="xml">
      <search string="Traffic Video Asset">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_traffic_video_asset" model="ir.actions.act_window">
    <field name="name">Traffic Video Asset</field>
    <field name="res_model">mv.traffic_video_asset</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_traffic_video_asset" name="Traffic Video Asset" parent="menu_mv_finance" action="action_mv_traffic_video_asset"/>
</odoo>
