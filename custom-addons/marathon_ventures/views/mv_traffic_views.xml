<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mv_traffic_list" model="ir.ui.view">
    <field name="name">mv.traffic.list</field>
    <field name="model">mv.traffic</field>
    <field name="arch" type="xml">
      <list string="Traffic Instructions">
        <field name="name"/>
        <field name="access_code"/>
        <field name="advertiser"/>
        <field name="agency"/>
        <field name="brands"/>
        <field name="campaign"/>
        <field name="client_code"/>
        <field name="deal"/>
      </list>
    </field>
  </record>

  <record id="view_mv_traffic_form" model="ir.ui.view">
    <field name="name">mv.traffic.form</field>
    <field name="model">mv.traffic</field>
    <field name="arch" type="xml">
      <form string="Traffic Instructions">
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <notebook>
            <page string="Details">
              <group>
                <field name="agency"/>
                <field name="brands"/>
                <field name="deal"/>
                <field name="program"/>
                <field name="traffic_contact"/>
                <field name="length"/>
                <field name="access_code"/>
                <field name="advertiser"/>
                <field name="campaign"/>
              </group>
              <group>
                <field name="client_code"/>
                <field name="end_date"/>
                <field name="estimate"/>
                <field name="hiatused_dates"/>
                <field name="product_code"/>
                <field name="product_description"/>
                <field name="start_date"/>
                <field name="year"/>
                <field name="quarter"/>
              </group>
            </page>
            <page string="SF Metadata">
              <group>
                <field name="sf_external_id"/>
                <field name="sf_legacy_data"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_mv_traffic_search" model="ir.ui.view">
    <field name="name">mv.traffic.search</field>
    <field name="model">mv.traffic</field>
    <field name="arch" type="xml">
      <search string="Traffic Instructions">
        <field name="name"/>
        <field name="sf_external_id"/>
      </search>
    </field>
  </record>

  <record id="action_mv_traffic" model="ir.actions.act_window">
    <field name="name">Traffic Instructions</field>
    <field name="res_model">mv.traffic</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_mv_traffic" name="Traffic Instructions" parent="menu_mv_sales_ops" action="action_mv_traffic"/>
</odoo>
