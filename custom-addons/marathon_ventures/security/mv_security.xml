<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ================================================================
       Data Loader security group (Phase 17).
       Only members of this group can access the Data Loader menu,
       upload files, and run imports/deletes/exports. Read-only
       history is available to any user with backend access via the
       ACLs in ir.model.access.csv.

       Auto-grant: this group is implied by base.group_system so any
       Odoo Settings admin gets Data Loader Manager access without
       manual assignment. Regular internal users still have to be
       explicitly added.

       NOTE: Odoo 19 dropped res.groups.category_id in favour of
       res.groups.privilege_id. Neither is strictly required; leaving
       both out is safe.
       ================================================================ -->
  <record id="group_dataloader_manager" model="res.groups">
    <field name="name">Data Loader Manager</field>
    <field name="comment">Members can create and execute Data Loader import/export jobs.</field>
  </record>

  <!-- Make base.group_system imply group_dataloader_manager so
       Settings admins auto-inherit it. Kept in a separate record
       so upgrading the module doesn't wipe custom user->group
       assignments (implied_ids is set-based, not overwrite-based
       when using (4, id) tuples). -->
  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('marathon_ventures.group_dataloader_manager'))]"/>
  </record>

  <data noupdate="1">
    <record id="module_category_marathon_ventures" model="ir.module.category">
      <field name="name">Marathon Ventures</field>
      <field name="sequence">35</field>
    </record>

    <record id="privilege_prelog_fuzzy_matching" model="res.groups.privilege">
      <field name="name">Prelog Fuzzy Matching</field>
      <field name="category_id" ref="module_category_marathon_ventures"/>
    </record>

    <record id="group_prelog_fuzzy_matching" model="res.groups">
      <field name="name">Operator</field>
      <field name="comment">
        Review unmatched Prelog Data and attach schedules, including confirmed
        manual overrides.
      </field>
      <field name="privilege_id" ref="privilege_prelog_fuzzy_matching"/>
      <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
      <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

    <record id="privilege_postlog_matching" model="res.groups.privilege">
      <field name="name">Postlog Data Matching</field>
      <field name="category_id" ref="module_category_marathon_ventures"/>
    </record>

    <record id="group_postlog_matching" model="res.groups">
      <field name="name">Operator</field>
      <field name="comment">
        Review unmatched Postlog Data and attach schedules, including confirmed
        manual overrides.
      </field>
      <field name="privilege_id" ref="privilege_postlog_matching"/>
      <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
      <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
  </data>

  <data noupdate="1">
    <!-- Record rules placeholder.  Uncomment + adapt if a SF object has OWD = Private. -->
    <!--
    <record id="rule_mv_example_owner" model="ir.rule">
      <field name="name">mv.example: own records</field>
      <field name="model_id" ref="model_mv_example"/>
      <field name="domain_force">[("user_id","=",user.id)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    -->
  </data>
</odoo>
