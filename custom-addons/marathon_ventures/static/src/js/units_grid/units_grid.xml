<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="marathon_ventures.MvUnitsGrid">
    <div class="mv-units-grid-wrap"
         t-on-click="() => this.closeMenu()">

      <!-- Delete confirmation dialog -->
      <div t-if="state.pendingDeleteRow"
           class="mv-confirm-overlay"
           t-on-click.stop="() => this.cancelDelete()">
        <div class="mv-confirm-dialog"
             t-on-click.stop="() => {}">
          <div class="mv-confirm-dialog__title">Delete Day Part?</div>
          <div class="mv-confirm-dialog__body">
            Are you sure you want to delete this row?
            <span t-if="state.pendingDeleteRow.daypart_label">
              (<t t-esc="state.pendingDeleteRow.daypart_label"/>)
            </span>
            <br/>
            <small class="text-muted">
              This will also remove every schedule linked to this Day Part
              when you click Save.
            </small>
          </div>
          <div class="mv-confirm-dialog__footer">
            <button class="btn btn-light"
                    t-on-click.stop.prevent="() => this.cancelDelete()">
              Cancel
            </button>
            <button class="btn btn-danger"
                    t-on-click.stop.prevent="() => this.confirmDelete()">
              Confirm
            </button>
          </div>
        </div>
      </div>

      <!-- Discard confirmation dialog. Opens when the planner clicks
           the Discard button in the Save bar so accidental clicks
           don't blow away unsaved edits. -->
      <div t-if="state.pendingDiscard"
           class="mv-confirm-overlay"
           t-on-click.stop="() => this.cancelDiscard()">
        <div class="mv-confirm-dialog"
             t-on-click.stop="() => {}">
          <div class="mv-confirm-dialog__title">Discard changes?</div>
          <div class="mv-confirm-dialog__body">
            Are you sure you want to discard all the changes made?
            <br/>
            <small class="text-muted">
              This action cannot be undone. Any edits you've made since
              the last save will be lost.
            </small>
          </div>
          <div class="mv-confirm-dialog__footer">
            <button class="btn btn-light"
                    t-on-click.stop.prevent="() => this.cancelDiscard()">
              Cancel
            </button>
            <button class="btn btn-danger"
                    t-on-click.stop.prevent="() => this.confirmDiscard()">
              Discard
            </button>
          </div>
        </div>
      </div>

      <!-- Phase 12: deal-level start date strip (drives the week columns) -->
      <div t-if="state.loaded and state.payload" class="mv-deal-startdate-strip">
        <label class="mv-deal-startdate-label">Deal Start Date</label>
        <input type="date" class="mv-deal-startdate-input"
               t-att-value="state.payload.deal.units_start_date || ''"
               t-on-change="(ev) => this.onDealStartDateChange(ev)"/>
        <span class="mv-deal-startdate-hint">
          Week columns run through the last Monday of this quarter.
        </span>
      </div>

      <!-- Save bar -->
      <div class="mv-units-savebar">
        <span t-if="state.dirty" class="mv-units-savebar__pending">
          You have unsaved changes
        </span>
        <span t-elif="state.justSaved" class="mv-units-savebar__saved">
          All changes saved
        </span>
        <button t-if="state.dirty"
                class="btn btn-light mv-units-discard"
                t-on-click.prevent="onDiscard"
                t-att-disabled="state.saving">Discard</button>
        <button t-if="state.dirty"
                class="btn btn-primary"
                t-on-click.prevent="onSave"
                t-att-disabled="state.saving">
          <t t-esc="state.saving ? 'Saving...' : 'Save'"/>
        </button>
      </div>

      <div t-if="!state.loaded" class="mv-units-loading">Loading units grid...</div>

      <!-- The grid - rendered as soon as we know the week columns -->
      <table t-if="state.loaded and state.payload" class="mv-units-table">
        <thead>
          <tr>
            <th class="mv-daypart-col">DAYPART</th>
            <th t-foreach="state.payload.weeks" t-as="w" t-key="w" class="mv-week-col">
              <div class="mv-week-col__date" t-esc="fmtWeekShort(w)"/>
              <div class="mv-week-col__dow">Mon</div>
            </th>
            <th class="mv-total-col">TOTAL</th>
            <th class="mv-row-actions-col"></th>
          </tr>
        </thead>

        <tbody>
          <!-- Body rows (existing + freshly-added).
               Each row in payload.rows renders as TWO <tr>s:
                 1. The data row (daypart / week cells / total / actions)
                 2. The bulk-allocation row beneath it.
               Wrapped in a <t t-foreach> so the bulk row iterates with
               the data row instead of rendering only once. -->
          <t t-foreach="state.payload.rows" t-as="row" t-key="row.id">
          <tr>

            <td class="mv-daypart-cell">
              <!-- Daypart selector (always editable; planners can switch) -->
              <select class="mv-daypart-select"
                      t-on-change="(ev) => this.onDaypartChange(row, ev)">
                <option t-foreach="dayparts" t-as="opt" t-key="opt.value"
                        t-att-value="opt.value"
                        t-att-selected="opt.value === row.daypart ? 'selected' : null">
                  <t t-esc="opt.label"/>
                </option>
              </select>
              <span class="mv-daypart-range" t-esc="row.time_range"/>

              <!-- Day toggles -->
              <div class="mv-day-toggles">
                <span t-foreach="['M','T','W','T','F','S','S']" t-as="dl" t-key="dl_index"
                      t-att-class="'mv-day-toggle' + (row.days_mask[dl_index] ? ' mv-day-toggle--on' : '')"
                      t-on-click="() => this.onDayToggle(row, dl_index)">
                  <t t-esc="dl"/>
                </span>
              </div>

              <!-- Phase 12: only Rate stays at the row level. Run dates
                   moved to the deal-level Start Date strip above. -->
              <div class="mv-daypart-foot">
                <label class="mv-foot-label">Rate</label>
                <input type="number" step="0.01" class="mv-foot-input mv-foot-input--rate"
                       t-att-value="row.rate || 0"
                       t-on-input="(ev) => this.onRateChange(row, ev)"/>
              </div>
            </td>

            <!-- Week cells -->
            <td t-foreach="row.cells" t-as="cell" t-key="cell.week"
                t-att-class="cellClasses(row, cell)">
              <input t-if="cell.state !== 'hatched'"
                     type="number"
                     class="mv-cell-input"
                     t-att-value="cell.units || ''"
                     t-on-input="(ev) => this.onCellInput(row, cell, ev)"/>
              <!-- Cancelled-units annotation: `x: 0/<units>` in red,
                   only shown if this week has cancelled history. -->
              <div t-if="(cell.cancelled_units || 0) > 0"
                   class="mv-cell-cancelled-note"
                   t-att-title="'Cancelled units: ' + cell.cancelled_units">
                x: 0/<t t-esc="cell.cancelled_units"/>
              </div>
            </td>

            <!-- Row total -->
            <td class="mv-row-total">
              <div class="mv-row-total__spots">
                <t t-esc="(row.total_spots || 0).toLocaleString()"/> spots
              </div>
              <div t-if="(row.total_cancelled || 0) > 0"
                   class="mv-row-total__cancelled">
                Cancelled: <t t-esc="(row.total_cancelled || 0).toLocaleString()"/>
              </div>
              <div class="mv-row-total__money">
                <t t-esc="fmtCurrency(row.total_revenue)"/>
              </div>
            </td>

            <!-- Row context menu (⋯) -->
            <td class="mv-row-actions">
              <div class="mv-row-menu-wrap">
                <button class="btn btn-link mv-row-menu-btn"
                        title="Row actions"
                        t-on-click.stop.prevent="() => this.toggleMenu(row)">
                  &#8942;
                </button>
                <div t-if="state.openMenuRowId === row.id"
                     class="mv-row-menu-dropdown">
                  <button class="mv-row-menu-item mv-row-menu-item--danger"
                          t-on-click.stop.prevent="() => this.requestDelete(row)">
                    Delete
                  </button>
                </div>
              </div>
            </td>
          </tr>


          <!-- Bulk allocation strip - aligned directly UNDER the week
               cells inside the same row container (no separator between
               data and bulk). Empty cells flank the strip so DAYPART /
               TOTAL / ACTIONS columns stay visually clean. -->
          <tr class="mv-bulk-row">
            <td t-att-colspan="state.payload.weeks.length + 3"
                class="mv-bulk-row__cell">
              <div class="mv-bulk-wrap">

                <div class="mv-bulk-section">
                  <span class="mv-bulk-field">
                    <span class="mv-bulk-field__label">From</span>
                    <input type="date"
                           class="mv-bulk-input mv-bulk-input--locked"
                           readonly="readonly"
                           t-att-value="state.payload.deal.units_start_date || ''"/>
                  </span>
                  <span class="mv-bulk-field">
                    <span class="mv-bulk-field__label">To</span>
                    <input type="date" class="mv-bulk-input mv-bulk-input--date"
                           t-att-value="(row._bulk and row._bulk.sec1_end) || ''"
                           t-on-input="(ev) => this.onBulkInputChange(row, 'sec1_end', ev)"/>
                  </span>
                  <span class="mv-bulk-field">
                    <span class="mv-bulk-field__label">Units</span>
                    <input type="number" min="0"
                           class="mv-bulk-input mv-bulk-input--units"
                           t-att-value="(row._bulk and row._bulk.sec1_units) || ''"
                           t-on-input="(ev) => this.onBulkInputChange(row, 'sec1_units', ev)"/>
                  </span>
                  <button class="btn btn-primary btn-sm mv-bulk-go"
                          t-on-click.prevent="() => this.applyBulkAllocation(row, 'sec1')">
                    Go
                  </button>
                </div>

                <div class="mv-bulk-section mv-bulk-section--secondary">
                  <span class="mv-bulk-field">
                    <span class="mv-bulk-field__label">To</span>
                    <input type="date" class="mv-bulk-input mv-bulk-input--date"
                           t-att-value="(row._bulk and row._bulk.sec2_end) || ''"
                           t-on-input="(ev) => this.onBulkInputChange(row, 'sec2_end', ev)"/>
                  </span>
                  <button class="btn btn-primary btn-sm mv-bulk-go"
                          t-on-click.prevent="() => this.applyBulkAllocation(row, 'sec2')"
                          title="Mark every week after this date as Cancelled">
                    Go
                  </button>
                </div>

              </div>
            </td>
          </tr>
          </t>

          <!-- Add Day Part row: ALWAYS visible, just under the last row -->
          <tr class="mv-add-row">
            <td t-att-colspan="state.payload.weeks.length + 3" class="mv-add-cell">
              <button class="btn btn-link mv-add-daypart"
                      t-on-click.prevent="addRow">
                + Add Day Part
              </button>
              <span t-if="state.payload.rows.length === 0"
                    class="mv-add-hint">
                Click to add your first Day Part. You can pick the daypart,
                set the rate, choose the run weeks, and enter unit counts
                per week.
              </span>
              <span t-if="state.payload.rows.length === 0"
                    class="mv-add-hint">
                Click to add your first Day Part. You can pick the daypart,
                set the rate, choose the run weeks, and enter unit counts
                per week.
              </span>
            </td>
          </tr>

          <!-- Grand total row -->
          <tr t-if="state.payload.rows.length > 0" class="mv-grand-row">
            <td class="mv-grand-cell">
              <t t-esc="(state.payload.grand_total_spots || 0).toLocaleString()"/> spots total
              <span t-if="(state.payload.grand_total_cancelled || 0) > 0"
                    class="mv-grand-cell__cancelled">
                (Cancelled: <t t-esc="(state.payload.grand_total_cancelled || 0).toLocaleString()"/>)
              </span>
            </td>
            <td t-att-colspan="state.payload.weeks.length"></td>
            <td t-att-colspan="2" class="mv-grand-cell mv-grand-cell--money">
              <t t-esc="fmtCurrency(state.payload.grand_total_revenue)"/> total revenue
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </t>

</templates>
