diff --git a/addons/l10n_it_stock_ddt/tests/test_ddt.py b/addons/l10n_it_stock_ddt/tests/test_ddt.py
index fa8813ab2e8f..f0c8768e7b99 100644
--- a/addons/l10n_it_stock_ddt/tests/test_ddt.py
+++ b/addons/l10n_it_stock_ddt/tests/test_ddt.py
@@ -170,3 +170,23 @@ class TestDDT(TestSaleCommon):
             {'l10n_it_ddt_number': so.picking_ids[-1].l10n_it_ddt_number},
             {'l10n_it_ddt_number': so.picking_ids[-2].l10n_it_ddt_number},
         ])
+
+    def test_ddt_sequence_follows_warehouse(self):
+        """
+            Renaming the sequence of a warehouse's delivery operation type must
+            rename its DDT sequence as well.
+        """
+        warehouse = self.env['stock.warehouse'].create({
+            'name': 'Milano',
+            'code': 'MIL',
+            'company_id': self.company_data['company'].id,
+        })
+        picking_type = warehouse.out_type_id
+        self.assertTrue(picking_type.l10n_it_ddt_sequence_id, 'An Italian delivery operation type gets a DDT sequence')
+
+        picking_type.write({'sequence_code': 'MOUT', 'warehouse_id': warehouse.id})
+        self.assertEqual(picking_type.l10n_it_ddt_sequence_id.prefix, 'MOUTDDT')
+        self.assertEqual(picking_type.l10n_it_ddt_sequence_id.name, 'Milano Sequence MOUT')
+
+        name, prefix = picking_type._get_dtt_ir_seq_vals(warehouse, 'MOUT')
+        self.assertEqual((name, prefix), ('Milano Sequence MOUT', 'MOUTDDT'))
