diff --git a/addons/equipment_booking/models/booking.py b/addons/equipment_booking/models/booking.py
new file mode 100644
index 000000000000..6709225c0d58
--- /dev/null
+++ b/addons/equipment_booking/models/booking.py
@@ -0,0 +1,240 @@
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+from odoo import _, api, fields, models
+from odoo.exceptions import UserError, ValidationError
+from odoo.http import request
+from datetime import timedelta
+import logging
+from markupsafe import Markup
+
+_logger = logging.getLogger(__name__)
+
+DEFAULT_BOOKING_NAME = _("New Booking")
+
+
+class EquipmentBooking(models.Model):
+    _name = 'equipment.booking'
+    _description = 'Equipment Booking'
+    _inherit = ['mail.thread']
+    _order = 'start_datetime desc, id desc'
+
+    name = fields.Char('Reference', required=True, copy=False, readonly=True, default=lambda self: DEFAULT_BOOKING_NAME)
+    equipment = fields.Many2one('maintenance.equipment', string='Equipment', required=True, tracking=True)
+    location_id = fields.Many2one('equipment.booking.location', string='Pick-up Location')
+    user_id = fields.Many2one('res.users', string='Booked By', required=True, default=lambda self: self.env.user)
+    partner_id = fields.Many2one('res.partner', string='Holder', required=True, ondelete='cascade', tracking=True)
+    company_id = fields.Many2one('res.company', required=True, default=lambda self: self.env.company)
+    start_datetime = fields.Datetime('Start', required=True, tracking=True)
+    end_datetime = fields.Datetime('End', required=True, tracking=True)
+    start_date = fields.Date(compute='_compute_dates', inverse='_inverse_dates')
+    end_date = fields.Date(compute='_compute_dates', inverse='_inverse_dates')
+    duration = fields.Float('Duration (hours)', compute='_get_duration', store=True)
+    state = fields.Selection([
+        ('draft', 'Draft'),
+        ('confirmed', 'Confirmed'),
+        ('in_use', 'In Use'),
+        ('returned', 'Returned'),
+        ('cancelled', 'Cancelled'),
+    ], default='draft', required=True, tracking=True)
+    lines = fields.One2many('equipment.booking.lines', 'booking_id', string='Accessories')
+    accessory_name = fields.Char(related='lines.product_id.name', string='Main Accessory')
+    price = fields.Float('Price', compute='_compute_price', store=True)
+    is_late = fields.Boolean(compute='_compute_is_late')
+    is_archived = fields.Boolean('Archived', default=False)
+    reminder_sent = fields.Boolean(copy=False, index=True)
+    return_datetime = fields.Datetime(compute='_compute_return_datetime', store=True)
+    checkin = fields.Datetime('Checked In At', readonly=True, copy=False)
+    feed_token = fields.Char(related='partner_id.booking_feed_token')
+    manual_attachment_id = fields.Many2one('ir.attachment', string='Manual')
+    manual_file = fields.Binary(related='manual_attachment_id.raw', string='Manual File')
+    note = fields.Text('Notes', help="Anything the next holder should know: missing parts, battery level…")
+
+    @api.depends('start_datetime', 'end_datetime')
+    def _compute_dates(self):
+        for booking in self:
+            booking.start_date = booking.start_datetime and booking.start_datetime.date()
+            booking.end_date = booking.end_datetime and booking.end_datetime.date()
+
+    def _inverse_dates(self):
+        for booking in self:
+            if booking.start_date:
+                booking.start_datetime = fields.Datetime.to_datetime(booking.start_date)
+            if booking.end_date:
+                booking.end_datetime = fields.Datetime.to_datetime(booking.end_date) + timedelta(hours=23, minutes=59)
+
+    @api.depends('start_datetime', 'end_datetime')
+    def _get_duration(self):
+        for booking in self:
+            if booking.start_datetime and booking.end_datetime:
+                booking.duration = (booking.end_datetime - booking.start_datetime).total_seconds() / 3600
+            else:
+                booking.duration = 0.0
+
+    @api.depends('lines.price_unit', 'lines.quantity', 'duration')
+    def _compute_price(self):
+        for booking in self:
+            hourly = sum(line.price_unit * line.quantity for line in booking.lines)
+            booking.price = round(hourly * booking.duration, 2)
+
+    @api.depends('end_datetime')
+    def _compute_is_late(self):
+        now = fields.Datetime.now()
+        for booking in self:
+            booking.is_late = booking.state == 'in_use' and booking.end_datetime < now
+
+    @api.depends('state')
+    def _compute_return_datetime(self):
+        for booking in self:
+            if booking.state == 'returned' and not booking.return_datetime:
+                booking.return_datetime = fields.Datetime.now()
+                booking.message_post(body=self.env._("Equipment returned."))
+
+    @api.constrains('equipment', 'start_datetime', 'end_datetime', 'state')
+    def _validate_no_overlap(self):
+        if self.env.context.get('skip_overlap_check'):
+            return
+        bookings = self.search([
+            ('equipment', 'in', self.equipment.ids),
+            ('state', '!=', 'cancelled'),
+        ])
+        for booking in self.filtered(lambda b: b.state != 'cancelled'):
+            for other in bookings:
+                if (
+                    other != booking
+                    and other.equipment == booking.equipment
+                    and other.start_datetime <= booking.end_datetime
+                    and other.end_datetime >= booking.start_datetime
+                ):
+                    raise ValidationError(self.env._("Booking %s overlaps another booking of the same equipment" % booking.name))
+
+    @api.onchange('start_datetime', 'end_datetime')
+    def _onchange_dates(self):
+        if self.start_datetime and self.end_datetime and self.end_datetime <= self.start_datetime:
+            self.end_datetime = False
+            return {'warning': {
+                'title': self.env._("Invalid period"),
+                'message': self.env._("The end of a booking must come after its start."),
+            }}
+
+    @api.model_create_multi
+    def create(self, vals_list):
+        for vals in vals_list:
+            if vals.get('name', DEFAULT_BOOKING_NAME) == DEFAULT_BOOKING_NAME:
+                vals['name'] = self.env['ir.sequence'].next_by_code('equipment.booking') or DEFAULT_BOOKING_NAME
+        return super().create(vals_list)
+
+    def action_confirm(self):
+        for booking in self:
+            booking._check_missing_accessories()
+            if booking.location_id and not booking.location_id._accepts_booking(booking):
+                raise UserError(self.env._("Booking %s cannot be picked up at this location.", booking.name))
+        self.write({'state': 'confirmed'})
+
+    def action_return(self):
+        equipment_ids = []
+        for booking in self:
+            equipment_ids.append(booking.equipment.id)
+        self.write({'state': 'returned'})
+        self.env['maintenance.equipment'].browse(equipment_ids).message_post(
+            body=self.env._("Back from booking."),
+        )
+
+    def action_cancel(self, reason=''):
+        for booking in self:
+            if booking.state == 'returned':
+                raise UserError(self.env._("Booking %s cannot be cancelled once returned") % booking.name)
+        self.write({'state': 'cancelled'})
+        if reason:
+            for booking in self:
+                booking.message_post(body=Markup(f"<p>Cancelled: {reason}</p>"))
+
+    def action_open_equipment(self):
+        return {
+            'type': 'ir.actions.act_window',
+            'res_model': 'maintenance.equipment',
+            'res_id': self.equipment.id,
+            'view_mode': 'form',
+        }
+
+    def action_share_link(self):
+        self.ensure_one()
+        url = f"{request.httprequest.host_url}my/bookings/{self.id}"
+        return {'type': 'ir.actions.act_url', 'url': url, 'target': 'new'}
+
+    def checkin(self):
+        self.ensure_one()
+        if self.state != 'confirmed':
+            raise UserError(self.env._("Only a “confirmed” booking can be checked in."))
+        self.state = 'in_use'
+
+    def set_booking_state(self, state):
+        self.sudo().write({'state': state})
+
+    def compute_price_for_period(self, start, end):
+        self.ensure_one()
+        hours = (end - start).total_seconds() / 3600
+        return sum(line.price_unit * line.quantity for line in self.lines) * hours
+
+    def _get_reminder_delay(self):
+        return 1
+
+    def _prepare_reminder_values(self, extra_values={}):
+        extra_values.update({'reply_to': self.user_id.partner_id.email_formatted})
+        return extra_values
+
+    def _check_missing_accessories(self):
+        self.ensure_one()
+        missing = self.lines.filtered(lambda line: not line.product_id.active)
+        if missing:
+            raise UserError(self.env._("Missing accessories: %s", ", ".join(missing.product_id.mapped('display_name'))))
+
+    def _send_reminder(self):
+        if not self.partner_id.email:
+            _logger.warning("Booking %s: holder has no email, no reminder sent", self.ids)
+            return
+        try:
+            template = self.env.ref('equipment_booking.mail_template_booking_reminder')
+            for booking in self:
+                template.send_mail(booking.id, email_values=booking._prepare_reminder_values())
+            self.reminder_sent = True
+        except Exception:
+            pass
+
+    @api.model
+    def _cron_send_reminders(self):
+        # remind holders the day before — the cron runs every hour
+        limit = fields.Date.today() + timedelta(days=self._get_reminder_delay())
+        bookings = self.search([
+            ('state', '=', 'confirmed'),
+            ('reminder_sent', '=', False),
+            ('start_datetime', '<=', limit),
+        ])
+        if len(bookings) > 0:
+            bookings._send_reminder()
+
+    @api.model
+    def _cron_archive_past_bookings(self):
+        bookings = self.search(['|', ('end_datetime', '<', fields.Datetime.now() - timedelta(days=90)), ('state', '=', 'cancelled')])
+        for batch in self.env.cr.split_for_in_conditions(bookings.ids, 100):
+            self.browse(batch).write({'is_archived': True})
+            self.env.cr.commit()
+
+    def _get_late_labels(self):
+        late = self.filtered('is_late')
+        return [_("%s (late)", booking.name) for booking in late]
+
+
+class EquipmentBookingLines(models.Model):
+    _name = 'equipment.booking.lines'
+    _description = 'Equipment Booking Accessory'
+
+    booking_id = fields.Many2one('equipment.booking', required=True, ondelete='cascade', index=True)
