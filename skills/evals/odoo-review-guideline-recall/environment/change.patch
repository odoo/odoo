@@ -0,0 +1,71 @@
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+from datetime import timedelta
+from unittest.mock import patch
+
+from odoo import Command, fields
+from odoo.exceptions import ValidationError
+from odoo.tests import TransactionCase, tagged
+
+
+@tagged('post_install', 'at_install')
+class TestEquipmentBooking(TransactionCase):
+
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        cls.partner = cls.env.ref('base.res_partner_2')
+        cls.equipment = cls.env['maintenance.equipment'].create({'name': 'Cordless Drill', 'bookable': True})
+        cls.start = fields.Datetime.now().replace(microsecond=0) + timedelta(hours=12)
+        cls.booking = cls.env['equipment.booking'].create({
+            'equipment': cls.equipment.id,
+            'partner_id': cls.partner.id,
+            'start_datetime': cls.start,
+            'end_datetime': cls.start + timedelta(hours=8),
+        })
+
+    def test_overlap_rejected(self):
+        with self.assertRaises(ValidationError):
+            self.env['equipment.booking'].create({
+                'equipment': self.equipment.id,
+                'partner_id': self.partner.id,
+                'start_datetime': self.start + timedelta(hours=2),
+                'end_datetime': self.start + timedelta(hours=10),
+            })
+
+    def test_price(self):
+        battery = self.env['product.product'].create({'name': 'Spare Battery'})
+        with self.assertQueryCount(60):
+            self.booking.lines = [Command.create({'product_id': battery.id, 'quantity': 2, 'price_unit': 1.25})]
+            self.booking.flush_recordset()
+        self.assertEqual(self.booking.price, 20.0)
+
+    def test_reminder_without_email(self):
+        self.partner.email = False
+        self.booking.action_confirm()
+        self.env['equipment.booking']._cron_send_reminders()
+        self.assertFalse(self.booking.reminder_sent)
+
+    def test_reminder_sent(self):
+        self.booking.action_confirm()
+        Booking = self.env.registry['equipment.booking']
+        with patch.object(Booking, '_send_reminder') as send_reminder:
+            self.env['equipment.booking']._cron_send_reminders()
+        send_reminder.assert_called_once()
+
+    def test_cancel(self):
+        self.booking.action_cancel()
+        self.assertTrue(self.booking.state)
+
+
+class TestEquipmentBookingManager(TestEquipmentBooking):
+
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        manager = cls.env['res.users'].create({
+            'name': 'Booking Manager',
+            'login': 'booking_manager',
+            'group_ids': [Command.set(cls.env.ref('equipment_booking.group_booking_manager').ids)],
+        })
+        cls.env = cls.env(user=manager)
