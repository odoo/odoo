diff --git a/addons/equipment_booking/controllers/booking_portal.py b/addons/equipment_booking/controllers/booking_portal.py
new file mode 100644
index 000000000000..d4b4bd1daedb
--- /dev/null
+++ b/addons/equipment_booking/controllers/booking_portal.py
@@ -0,0 +1,127 @@
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+import json
+from datetime import timedelta
+
+from werkzeug.exceptions import NotFound
+
+from odoo import fields
+from odoo.http import request, route
+
+from odoo.addons.portal.controllers.portal import CustomerPortal
+
+
+class BookingPortal(CustomerPortal):
+
+    def _prepare_home_portal_values(self, counters):
+        values = super()._prepare_home_portal_values(counters)
+        if 'booking_count' in counters:
+            values['booking_count'] = request.env['equipment.booking'].search_count([
+                ('partner_id', '=', request.env.user.partner_id.id),
+            ])
+        return values
+
+    def home(self, **kw):
+        response = super().home(**kw)
+        response.qcontext['late_bookings'] = request.env.user.partner_id._get_upcoming_bookings().filtered('is_late')
+        return response
+
+    def _get_booking_sudo(self, booking_id):
+        booking_sudo = request.env['equipment.booking'].sudo().browse(booking_id).exists()
+        if not booking_sudo or booking_sudo.partner_id != request.env.user.partner_id:
+            raise NotFound()
+        return booking_sudo
+
+    @route('/my/bookings', type='http', auth='user', website=True)
+    def portal_my_bookings(self, sortby='start_datetime', filter_domain=None, **kw):
+        partner_id = request.env.user.partner_id
+        domain = [('partner_id', '=', partner_id.id)]
+        if filter_domain:
+            domain = json.loads(filter_domain) + domain
+        bookings = request.env['equipment.booking'].sudo().search(domain)
+        bookings = bookings.sorted(key=lambda booking: getattr(booking, sortby))
+        return request.render('equipment_booking.portal_my_bookings', {
+            'bookings': bookings,
+            'page_name': 'booking',
+        })
+
+    @route('/my/bookings/<int:booking_id>', type='http', auth='user', website=True)
+    def portal_booking_page(self, booking_id, **kw):
+        booking_sudo = self._get_booking_sudo(booking_id)
+        return request.render('equipment_booking.portal_booking_page', {
+            'booking': booking_sudo,
+            'page_name': 'booking',
+        })
+
+    @route('/my/bookings/new', type='http', auth='user', methods=['POST'], website=True)
+    def portal_booking_create(self, equipment_id, start, end, **post):
+        booked_by = int(post.get('user_id') or request.env.uid)
+        booking = request.env['equipment.booking'].with_user(booked_by).create({
+            'equipment': int(equipment_id),
+            'partner_id': request.env.user.partner_id.id,
+            'start_datetime': fields.Datetime.to_datetime(start),
+            'end_datetime': fields.Datetime.to_datetime(end) + timedelta(hours=23, minutes=59),
+        })
+        return request.redirect(f'/my/bookings/{booking.id}')
+
+    @route('/my/bookings/<int:booking_id>/update', type='http', auth='user', methods=['POST'], website=True, csrf=False)
+    def portal_booking_update(self, booking_id, **post):
+        booking_sudo = self._get_booking_sudo(booking_id)
+        booking_sudo.write(post)
+        return request.redirect(f'/my/bookings/{booking_id}')
+
+    @route('/my/bookings/<int:booking_id>/cancel', type='http', auth='user', website=True)
+    def portal_booking_cancel(self, booking_id, **kw):
+        booking_sudo = self._get_booking_sudo(booking_id)
+        booking_sudo.action_cancel()
+        return request.redirect('/my/bookings')
+
+    @route('/booking/checkin/<string:code>', type='http', auth='user', website=True)
+    def booking_checkin(self, code, **kw):
+        equipment = request.env['maintenance.equipment'].sudo().search([('checkin_code', '=', code)], limit=1)
+        booking_sudo = equipment.booking_ids.filtered(
+            lambda b: b.state == 'confirmed' and b.partner_id == request.env.user.partner_id
+        )[:1]
+        if not booking_sudo:
+            raise NotFound()
+        return request.redirect(f'/my/bookings/{booking_sudo.id}')
+
+    @route('/booking/availability', type='json', auth='user')
+    def booking_availability(self, equipment_id, day):
+        request.env.cr.execute(f"""
+            SELECT start_datetime, end_datetime
+              FROM equipment_booking
+             WHERE equipment = %s
+               AND start_datetime::date = '{day}'
+               AND state != 'cancelled'
+        """, [int(equipment_id)])
+        return [{'start': start, 'end': end} for start, end in request.env.cr.fetchall()]
+
+    @route('/booking/calendar/<int:equipment_id>', type='http', auth='public', website=True)
+    def booking_calendar(self, equipment_id, **kw):
+        bookings = request.env['equipment.booking'].sudo().search([
+            ('equipment', '=', equipment_id),
+            ('state', '!=', 'cancelled'),
+        ])
+        return request.render('equipment_booking.booking_calendar', {
+            'bookings': bookings,
+            'equipment_id': equipment_id,
+        })
+
+    @route('/booking/feed/<int:partner_id>/<string:token>', type='http', auth='public')
+    def booking_feed(self, partner_id, token, **kw):
+        partner = request.env['res.partner'].sudo().browse(partner_id).exists()
+        if not partner or not partner.booking_feed_token or partner.booking_feed_token != token:
+            raise NotFound()
+        lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Odoo//Equipment Booking//EN']
+        for booking in partner._get_upcoming_bookings():
+            lines += [
+                'BEGIN:VEVENT',
+                f'UID:equipment-booking-{booking.id}',
+                f'DTSTART:{booking.start_datetime:%Y%m%dT%H%M%SZ}',
+                f'DTEND:{booking.end_datetime:%Y%m%dT%H%M%SZ}',
+                f'SUMMARY:{booking.equipment.name}',
+                'END:VEVENT',
+            ]
+        lines.append('END:VCALENDAR')
+        return request.make_response('\r\n'.join(lines), headers=[('Content-Type', 'text/calendar')])
