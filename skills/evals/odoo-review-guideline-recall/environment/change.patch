@@ -0,0 +1,57 @@
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+from odoo import api, fields, models
+from odoo.tools.safe_eval import safe_eval
+
+
+class EquipmentBookingLocation(models.Model):
+    _name = 'equipment.booking.location'
+    _description = 'Equipment Pick-up Location'
+    _inherits = {'res.partner': 'partner_id'}
+    _order = 'complete_name'
+
+    @api.model_create_multi
+    def create(self, vals_list):
+        for vals in vals_list:
+            vals.setdefault('is_company', True)
+        return super().create(vals_list)
+
+    partner_id = fields.Many2one('res.partner', string='Address', required=True, ondelete='restrict')
+    parent_id = fields.Many2one('equipment.booking.location', string='Parent Location', ondelete='cascade')
+    child_ids = fields.One2many('equipment.booking.location', 'parent_id', string='Sub-locations')
+    complete_name = fields.Char(compute='_compute_complete_name', store=True, recursive=True)
+    booking_condition = fields.Char(
+        'Booking Condition',
+        help="Python expression a booking must satisfy to be picked up here, e.g. booking.duration <= 8",
+    )
+
+    _sql_constraints = [
+        ('code_uniq', 'unique(partner_id)', 'A location already uses this address.'),
+    ]
+
+    @api.depends('name', 'parent_id.complete_name')
+    def _compute_complete_name(self):
+        for location in self:
+            if location.parent_id:
+                location.complete_name = f"{location.parent_id.complete_name} / {location.name}"
+            else:
+                location.complete_name = location.name
+
+    def _accepts_booking(self, booking):
+        self.ensure_one()
+        if not self.booking_condition:
+            return True
+        return bool(safe_eval(self.booking_condition, {'booking': booking}))
+
+    def _get_bookings_in_subtree(self):
+        return self.env['equipment.booking'].search([('location_id', 'child_of', self.ids)])
+
+    def action_view_bookings(self):
+        self.ensure_one()
+        return {
+            'type': 'ir.actions.act_window',
+            'name': self.env._("Bookings"),
+            'res_model': 'equipment.booking',
+            'view_mode': 'list,form',
+            'domain': [('id', 'in', self._get_bookings_in_subtree().ids)],
+        }
