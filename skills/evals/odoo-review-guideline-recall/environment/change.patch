@@ -0,0 +1,59 @@
+import { Component, markup, useProps } from "@odoo/owl";
+import { registry } from "@web/core/registry";
+import { _t } from "@web/core/l10n/translation";
+import { useService } from "@web/core/utils/hooks";
+import { standardActionServiceProps } from "@web/webclient/actions/action_plugin";
+import { useBoardBookings } from "@equipment_booking/hooks/use_board_bookings";
+
+/**
+ * The booking board: one column per equipment with its current and upcoming
+ * bookings, so the desk sees at a glance what goes out and what is late.
+ */
+export class BookingBoard extends Component {
+    static template = "equipment_booking.BookingBoard";
+    props = useProps(standardActionServiceProps);
+
+    setup() {
+        this.action = useService("action");
+        this.board = useBoardBookings();
+    }
+
+    get title() {
+        return _t("Booking Board");
+    }
+
+    get lateCount() {
+        return this.board.state.bookings.filter((booking) => booking.is_late).length;
+    }
+
+    columns() {
+        const byEquipment = new Map();
+        for (const booking of this.board.state.bookings) {
+            const [id, name] = booking.equipment;
+            if (!byEquipment.has(id)) {
+                byEquipment.set(id, { id, name, bookings: [] });
+            }
+            byEquipment.get(id).bookings.push(booking);
+        }
+        return [...byEquipment.values()];
+    }
+
+    noteHtml(booking) {
+        return markup(booking.note || "");
+    }
+
+    timeLeft(booking) {
+        return window.reltime.until(booking.end_datetime);
+    }
+
+    onClickBooking(booking) {
+        this.action.doAction({
+            type: "ir.actions.act_window",
+            res_model: "equipment.booking",
+            res_id: booking.id,
+            views: [[false, "form"]],
+        });
+    }
+}
+
+registry.category("actions").add("equipment_booking.board", BookingBoard);
