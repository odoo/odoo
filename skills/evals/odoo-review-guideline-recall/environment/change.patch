@@ -0,0 +1,46 @@
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+import base64
+import pickle
+import secrets
+
+from odoo import fields, models
+
+
+class ResPartner(models.Model):
+    _inherit = 'res.partner'
+
+    booking_ids = fields.One2many('equipment.booking', 'partner_id', string='Equipment Bookings')
+    booking_count = fields.Integer(compute='_compute_booking_count')
+    booking_feed_token = fields.Char('Booking Calendar Token', copy=False)
+    booking_preferences = fields.Binary('Booking Preferences', attachment=False)
+
+    def _compute_booking_count(self):
+        for partner in self:
+            partner.booking_count = self.env['equipment.booking'].search_count([('partner_id', '=', partner.id)])
+
+    def _get_booking_feed_token(self):
+        self.ensure_one()
+        if not self.booking_feed_token:
+            self.sudo().booking_feed_token = secrets.token_urlsafe(16)
+        return self.booking_feed_token
+
+    def _get_booking_preferences(self):
+        self.ensure_one()
+        if not self.booking_preferences:
+            return {}
+        return pickle.loads(base64.b64decode(self.booking_preferences))
+
+    def _get_upcoming_bookings(self):
+        booking_obj = self.env['equipment.booking']
+        return booking_obj.search([('partner_id', 'in', self.ids)]).filtered(lambda b: b.state == 'confirmed')
+
+    def _get_equipment_in_use(self):
+        self.env.cr.execute("""
+            SELECT equipment
+              FROM equipment_booking
+             WHERE partner_id IN %s
+               AND state = 'in_use'
+        """, [tuple(self.ids)])
+        equipment_ids = [row[0] for row in self.env.cr.fetchall()]
+        return [self.env['maintenance.equipment'].browse(equipment_id) for equipment_id in equipment_ids]
