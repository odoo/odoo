+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+from odoo import fields, models
+
+
+class EquipmentBookingExtend(models.TransientModel):
+    _name = 'equipment.booking.extend'
+    _description = 'Extend an Equipment Booking'
+
+    booking_id = fields.Many2one('equipment.booking', required=True)
+    new_end_datetime = fields.Datetime('New End', required=True)
+    extra_product_ids = fields.Many2many('product.product', string='Extra Accessories')
+    force = fields.Boolean('Ignore Next Bookings', help="Extend even if the equipment is booked right after.")
+
+    def action_extend(self):
+        self.ensure_one()
+        booking = self.booking_id
+        if self.force:
+            booking = booking.with_context(skip_overlap_check=True)
+        booking.end_datetime = self.new_end_datetime
+        for product in self.extra_product_ids:
+            self.env['equipment.booking.lines'].create({
+                'booking_id': booking.id,
+                'product_id': product.id,
+                'price_unit': product.lst_price,
+            })
+        return {'type': 'ir.actions.act_window_close'}
