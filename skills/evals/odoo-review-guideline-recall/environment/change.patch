+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+import base64
+import os
+
+import phonenumbers
+
+from odoo import api, models
+from odoo.tools import config
+
+
+class ReportEquipmentBookingLabel(models.AbstractModel):
+    _name = 'report.equipment_booking.report_booking_label'
+    _description = 'Equipment Booking Label'
+
+    @api.model
+    def _get_report_values(self, docids, data=None):
+        bookings = self.env['equipment.booking'].browse(docids)
+        return {
+            'localized': {booking.id: booking.with_context(lang=booking.partner_id.lang) for booking in bookings},
+            'holder_phones': {booking.id: self._format_phone(booking.partner_id) for booking in bookings},
+            'pictures': {booking.id: self._get_equipment_picture(booking.equipment) for booking in bookings},
+        }
+
+    def _format_phone(self, partner):
+        if not partner.phone:
+            return ''
+        try:
+            number = phonenumbers.parse(partner.phone, partner.country_id.code or None)
+        except phonenumbers.NumberParseException:
+            return partner.phone
+        return phonenumbers.format_number(number, phonenumbers.PhoneNumberFormat.INTERNATIONAL)
+
+    def _get_equipment_picture(self, equipment):
+        path = os.path.join(config['data_dir'], 'equipment_pictures', f'{equipment.serial_number}.png')
+        if not os.path.exists(path):
+            return False
+        with open(path, 'rb') as picture:
+            return base64.b64encode(picture.read()).decode()
