diff --git a/addons/equipment_booking/static/src/hooks/use_board_bookings.js b/addons/equipment_booking/static/src/hooks/use_board_bookings.js
new file mode 100644
index 000000000000..1da13252d327
--- /dev/null
+++ b/addons/equipment_booking/static/src/hooks/use_board_bookings.js
@@ -0,0 +1,34 @@
+import { onWillStart, proxy } from "@odoo/owl";
+import { useService } from "@web/core/utils/hooks";
+
+export const BOARD_FIELDS = [
+    "name",
+    "equipment",
+    "partner_id",
+    "start_datetime",
+    "end_datetime",
+    "state",
+    "is_late",
+    "note",
+];
+
+/**
+ * Loads the bookings shown on the board: the confirmed ones and the ones in
+ * use, oldest start first.
+ */
+export function useBoardBookings() {
+    const orm = useService("orm");
+    const state = proxy({ bookings: [] });
+
+    async function load() {
+        state.bookings = await orm.searchRead(
+            "equipment.booking",
+            [["state", "in", ["confirmed", "in_use"]]],
+            BOARD_FIELDS,
+            { order: "start_datetime" }
+        );
+    }
+
+    onWillStart(load);
+    return { state, load };
+}
