@@ -0,0 +1,39 @@
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+import hashlib
+import hmac
+
+from odoo import api, fields, models
+
+
+class MaintenanceEquipment(models.Model):
+    _inherit = 'maintenance.equipment'
+
+    equipment_assign_to = fields.Selection(
+        selection_add=[('booking', 'Booking Holder')], ondelete={'booking': 'set other'})
+    bookable = fields.Boolean('Bookable', help="Employees and portal customers can book this equipment.")
+    booking_ids = fields.One2many('equipment.booking', 'equipment', string='Bookings')
+    checkin_code = fields.Char('Check-in Code', compute='_compute_checkin_code', store=True, copy=False)
+
+    @api.depends('serial_number')
+    def _compute_checkin_code(self):
+        for equipment in self:
+            signer = equipment.get_label_signer()
+            signer.update(f"{equipment.id}-{equipment.serial_number or ''}".encode())
+            equipment.checkin_code = signer.hexdigest()[:12]
+
+    def _get_owner_methods_by_equipment_assign_to(self, date=None):
+        owner_methods = super()._get_owner_methods_by_equipment_assign_to(date=date)
+        owner_methods['booking'] = lambda equipment: equipment._get_holder_user(date).id or self.env.user.id
+        return owner_methods
+
+    def _get_holder_user(self, date):
+        self.ensure_one()
+        booking = self.booking_ids.filtered(
+            lambda b: b.state in ('confirmed', 'in_use') and b.start_datetime.date() <= date <= b.end_datetime.date()
+        )[:1]
+        return booking.user_id
+
+    def get_label_signer(self):
+        secret = self.env['ir.config_parameter'].sudo().get_str('database.secret')
+        return hmac.new(secret.encode(), digestmod=hashlib.sha256)
