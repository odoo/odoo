#!/usr/bin/env bash
# Every commit about to leave this checkout passes ./gates.sh first, on a
# detached worktree of exactly that commit, so a peer's dirty file cannot
# fail -- or pass -- someone else's push. Enabled per checkout with
#     git config core.hooksPath .githooks
# and skipped for one push with `git push --no-verify`, which git prints in
# the refusal below.
set -u
ROOT="$(git rev-parse --show-toplevel)"
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;   # a delete pushes the null sha; nothing to check
    esac
    if ! "$ROOT/gates.sh" --ref "$local_sha"; then
        echo "pre-push: gates are red on $local_sha; fix, or push --no-verify with a reason" >&2
        exit 1
    fi
done
exit 0
