<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reuse and style standard Contact menu instead of creating a second one -->
        <record id="website.menu_contactus" model="website.menu">
            <field name="name">Contact</field>
            <field name="sequence" type="int">30</field>
        </record>

        <!-- Custom Harvard University Navigation Menus with Fixed XML IDs -->
        <record id="menu_jobs" model="website.menu">
            <field name="name">Job</field>
            <field name="url">/jobs</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">10</field>
        </record>

        <record id="menu_about_us" model="website.menu">
            <field name="name">About</field>
            <field name="url">/aboutus</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>

        <record id="menu_events" model="website.menu">
            <field name="name">Events</field>
            <field name="url">/events</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">40</field>
        </record>

        <record id="menu_courses" model="website.menu">
            <field name="name">Courses</field>
            <field name="url">/courses</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">50</field>
        </record>

        <record id="menu_admissions" model="website.menu">
            <field name="name">Apply Online</field>
            <field name="url">/admission/apply</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">60</field>
        </record>
    </data>
</odoo>
