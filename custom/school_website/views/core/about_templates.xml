<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- University About Us (/aboutus) -->
    <template id="about_page_template" name="About Harvard University">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Header Hero Banner -->
                <section class="py-5 text-white" style="background: linear-gradient(135deg, #101c30 0%, #A51C30 100%);">
                    <div class="container py-4 text-center">
                        <span class="text-uppercase fw-bold text-danger small">Truth • Excellence • Discovery</span>
                        <h1 class="display-4 fw-bold mt-2 mb-3">About Harvard University</h1>
                        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 720px;">
                            Dedicated to excellence in teaching, learning, and research, and to developing leaders in many disciplines who make a positive difference in the world.
                        </p>
                    </div>
                </section>

                <!-- Mission & Vision -->
                <section class="py-5 bg-white">
                    <div class="container py-3">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-6">
                                <span class="text-uppercase fw-bold text-danger small">Our Foundation</span>
                                <h2 class="display-6 fw-bold text-dark mt-2 mb-4">A Legacy of Learning &amp; Leadership</h2>
                                <p class="text-muted lead">
                                    Harvard University is devoted to advancing knowledge, educating students, and stimulating innovation across the arts, sciences, and professional studies.
                                </p>
                                <p class="text-muted">
                                    Through world-class faculty, state-of-the-art research laboratories, and diverse academic communities, Harvard fosters an environment where curiosity thrives and transformative discoveries take shape every day.
                                </p>
                                <div class="d-flex gap-3 mt-4">
                                    <a href="/courses" class="btn btn-danger px-4 py-2 fw-bold">Explore Programs</a>
                                    <a href="/admission/apply" class="btn btn-outline-dark px-4 py-2 fw-bold">Apply Online</a>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="p-4 rounded-3 shadow-sm border bg-light">
                                    <div class="d-flex align-items-center gap-3 mb-4">
                                        <div class="p-3 bg-danger text-white rounded-circle">
                                            <i class="fa fa-graduation-cap fa-2x"/>
                                        </div>
                                        <div>
                                            <h4 class="h5 fw-bold mb-1">Academic Distinction</h4>
                                            <p class="text-muted small mb-0">Undergraduate, Master's, and Doctoral degrees recognized globally.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3 mb-4">
                                        <div class="p-3 bg-dark text-white rounded-circle">
                                            <i class="fa fa-globe fa-2x"/>
                                        </div>
                                        <div>
                                            <h4 class="h5 fw-bold mb-1">Global Community</h4>
                                            <p class="text-muted small mb-0">Scholars and researchers from over 120 nations worldwide.</p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="p-3 bg-danger text-white rounded-circle">
                                            <i class="fa fa-flask fa-2x"/>
                                        </div>
                                        <div>
                                            <h4 class="h5 fw-bold mb-1">Pioneering Research</h4>
                                            <p class="text-muted small mb-0">Cutting-edge laboratories addressing society's most pressing challenges.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- University Stats Bar -->
                <section class="py-5 text-white" style="background-color: #101c30;">
                    <div class="container">
                        <t t-set="stats" t-value="website.get_university_stats()"/>
                        <div class="row text-center g-4">
                            <div class="col-6 col-md-3">
                                <h3 class="display-5 fw-bold text-white mb-1"><t t-esc="stats.get('programs_count', 24)"/>+</h3>
                                <p class="text-white-50 mb-0">Degree Programs</p>
                            </div>
                            <div class="col-6 col-md-3">
                                <h3 class="display-5 fw-bold text-white mb-1"><t t-esc="stats.get('departments_count', 8)"/></h3>
                                <p class="text-white-50 mb-0">Academic Departments</p>
                            </div>
                            <div class="col-6 col-md-3">
                                <h3 class="display-5 fw-bold text-white mb-1"><t t-esc="stats.get('teachers_count', 50)"/>+</h3>
                                <p class="text-white-50 mb-0">Faculty Members</p>
                            </div>
                            <div class="col-6 col-md-3">
                                <h3 class="display-5 fw-bold text-white mb-1"><t t-esc="stats.get('students_count', 1200)"/>+</h3>
                                <p class="text-white-50 mb-0">Enrolled Students</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Academic Departments Grid -->
                <section class="py-5 bg-light" t-if="departments">
                    <div class="container py-3">
                        <div class="text-center mb-5">
                            <span class="text-uppercase fw-bold text-danger small">Our Structure</span>
                            <h2 class="display-6 fw-bold text-dark mt-1">Academic Departments &amp; Faculties</h2>
                        </div>
                        <div class="row g-4">
                            <t t-foreach="departments" t-as="dept">
                                <div class="col-md-6 col-lg-4">
                                    <div class="bg-white p-4 rounded-3 shadow-sm border h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span class="badge bg-danger"><t t-esc="dept.code or 'DEPT'"/></span>
                                                <i class="fa fa-university text-muted"/>
                                            </div>
                                            <h4 class="h5 fw-bold text-dark mb-2" t-esc="dept.name"/>
                                            <p class="text-muted small mb-0">
                                                <i class="fa fa-book me-1"/> <t t-esc="dept.program_count"/> Programs • <i class="fa fa-user me-1"/> <t t-esc="dept.teacher_count"/> Faculty
                                            </p>
                                        </div>
                                        <div class="mt-3 pt-3 border-top">
                                            <a href="/courses" class="text-danger fw-bold small text-decoration-none">View Programs <i class="fa fa-arrow-right ms-1"/></a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- CTA Banner -->
                <section class="py-5 text-center text-white" style="background: linear-gradient(135deg, #A51C30 0%, #801424 100%);">
                    <div class="container py-3">
                        <h2 class="display-6 fw-bold mb-3">Join Harvard University</h2>
                        <p class="lead mb-4 mx-auto" style="max-width: 600px;">Begin your application online or connect with our admissions counselors today.</p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="/admission/apply" class="btn btn-light btn-lg px-4 fw-bold text-danger">Apply Now</a>
                            <a href="/contactus" class="btn btn-outline-light btn-lg px-4 fw-bold">Contact Us</a>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
