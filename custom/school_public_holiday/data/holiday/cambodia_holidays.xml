<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. International New Year Day -->
        <record id="holiday_cambodia_international_new_year" model="public.holiday">
            <field name="name">International New Year</field>
            <field name="name_km">ទិវាចូលឆ្នាំសកល</field>
            <field name="date_from">2026-01-01</field>
            <field name="date_to">2026-01-01</field>
            <field name="note">Fixed annual public holiday on January 1.</field>
        </record>

        <!-- 2. Victory over Genocide Day -->
        <record id="holiday_cambodia_victory_day" model="public.holiday">
            <field name="name">Victory over Genocide Day</field>
            <field name="name_km">ទិវាជ័យជម្នះលើរបបប្រល័យពូជសាសន៍</field>
            <field name="date_from">2026-01-07</field>
            <field name="date_to">2026-01-07</field>
            <field name="note">Fixed annual public holiday commemorating January 7, 1979.</field>
        </record>

        <!-- 3. International Women's Day -->
        <record id="holiday_cambodia_womens_day" model="public.holiday">
            <field name="name">International Women's Day</field>
            <field name="name_km">ទិវាអន្តរជាតិនារី</field>
            <field name="date_from">2026-03-08</field>
            <field name="date_to">2026-03-08</field>
            <field name="note">Fixed annual holiday on March 8.</field>
        </record>

        <!-- 4. Khmer New Year (3 days) -->
        <record id="holiday_cambodia_khmer_new_year" model="public.holiday">
            <field name="name">Khmer New Year</field>
            <field name="name_km">ពិធីបុណ្យចូលឆ្នាំថ្មីប្រពៃណីជាតិ</field>
            <field name="date_from">2026-04-14</field>
            <field name="date_to">2026-04-16</field>
            <field name="note">Three days celebration in mid-April (Moha Sangkranta, Virak Vanabat, Vearak Loeng Sak).</field>
        </record>

        <!-- 5. International Labour Day -->
        <record id="holiday_cambodia_labour_day" model="public.holiday">
            <field name="name">International Labour Day</field>
            <field name="name_km">ទិវាពលកម្មអន្តរជាតិ</field>
            <field name="date_from">2026-05-01</field>
            <field name="date_to">2026-05-01</field>
            <field name="note">Fixed public holiday on May 1.</field>
        </record>

        <!-- 6. King Norodom Sihamoni's Birthday -->
        <record id="holiday_cambodia_kings_birthday" model="public.holiday">
            <field name="name">King's Birthday</field>
            <field name="name_km">ព្រះរាជពិធីបុណ្យចម្រើនព្រះជន្មព្រះមហាក្សត្រ</field>
            <field name="date_from">2026-05-14</field>
            <field name="date_to">2026-05-14</field>
            <field name="note">Fixed public holiday on May 14 celebrating His Majesty King Norodom Sihamoni's Birthday.</field>
        </record>

        <!-- 7. Visak Bochea Day (Lunar) -->
        <record id="holiday_cambodia_visak_bochea" model="public.holiday">
            <field name="name">Visak Bochea</field>
            <field name="name_km">ពិធីបុណ្យវិសាខបូជា</field>
            <field name="date_from">2026-05-31</field>
            <field name="date_to">2026-05-31</field>
            <field name="note">Khmer Buddhist holy day determined by lunar calendar (Full moon of Visakha). Exact dates must be entered or imported each year.</field>
        </record>

        <!-- 8. Royal Plowing Ceremony (Special/Lunar) -->
        <record id="holiday_cambodia_royal_plowing" model="public.holiday">
            <field name="name">Royal Plowing Ceremony</field>
            <field name="name_km">ព្រះរាជពិធីច្រត់ព្រះនង្គ័ល</field>
            <field name="date_from">2026-06-04</field>
            <field name="date_to">2026-06-04</field>
            <field name="note">Royal agricultural ceremony determined by the lunar calendar. Exact dates must be entered or imported each year.</field>
        </record>

        <!-- 9. Constitution Day -->
        <record id="holiday_cambodia_constitution_day" model="public.holiday">
            <field name="name">Constitution Day</field>
            <field name="name_km">ទិវាប្រកាសរដ្ឋធម្មនុញ្ញ</field>
            <field name="date_from">2026-09-24</field>
            <field name="date_to">2026-09-24</field>
            <field name="note">Commemoration of the formal promulgation of the Kingdom's Constitution on September 24, 1993.</field>
        </record>

        <!-- 10. Pchum Ben (Lunar - 3 days) -->
        <record id="holiday_cambodia_pchum_ben" model="public.holiday">
            <field name="name">Pchum Ben</field>
            <field name="name_km">ពិធីបុណ្យភ្ជុំបិណ្ឌ</field>
            <field name="date_from">2026-10-10</field>
            <field name="date_to">2026-10-12</field>
            <field name="note">Cambodian Ancestors' Day festival determined by the lunar calendar. Exact dates must be entered or imported each year.</field>
        </record>

        <!-- 11. Commemoration of the King Father -->
        <record id="holiday_cambodia_king_father_day" model="public.holiday">
            <field name="name">King Father's Memorial Day</field>
            <field name="name_km">ទិវារំលឹកវិញ្ញាណក្ខន្ធព្រះបរមរតនកោដ្ឋ</field>
            <field name="date_from">2026-10-15</field>
            <field name="date_to">2026-10-15</field>
            <field name="note">Commemoration of His Majesty King Father Norodom Sihanouk on October 15.</field>
        </record>

        <!-- 12. King's Coronation Day -->
        <record id="holiday_cambodia_coronation_day" model="public.holiday">
            <field name="name">Coronation Day</field>
            <field name="name_km">ព្រះរាជពិធីគ្រងរាជសម្បត្តិ</field>
            <field name="date_from">2026-10-29</field>
            <field name="date_to">2026-10-29</field>
            <field name="note">Anniversary of King Norodom Sihamoni's Coronation on October 29.</field>
        </record>

        <!-- 13. Independence Day -->
        <record id="holiday_cambodia_independence_day" model="public.holiday">
            <field name="name">Independence Day</field>
            <field name="name_km">ទិវាបុណ្យឯករាជ្យជាតិ</field>
            <field name="date_from">2026-11-09</field>
            <field name="date_to">2026-11-09</field>
            <field name="note">National Independence Day (November 9, 1953).</field>
        </record>

        <!-- 14. Water Festival (Lunar - 3 days) -->
        <record id="holiday_cambodia_water_festival" model="public.holiday">
            <field name="name">Water Festival</field>
            <field name="name_km">ព្រះរាជពិធីបុណ្យអុំទូក បណ្តែតប្រទីប និងសំពះព្រះខែ</field>
            <field name="date_from">2026-11-23</field>
            <field name="date_to">2026-11-25</field>
            <field name="note">Bon Om Touk (Water Festival) determined by the lunar calendar. Exact dates must be entered or imported each year.</field>
        </record>

        <!-- 15. Peace Day -->
        <record id="holiday_cambodia_peace_day" model="public.holiday">
            <field name="name">Peace Day</field>
            <field name="name_km">ទិវាសន្តិភាព</field>
            <field name="date_from">2026-12-29</field>
            <field name="date_to">2026-12-29</field>
            <field name="note">National Peace Day commemorating the end of civil war and peace across Cambodia on December 29.</field>
        </record>
    </data>
</odoo>
