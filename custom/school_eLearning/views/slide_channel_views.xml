<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit slide.channel form view from website_slides -->
    <record id="view_slide_channel_form_inherit_school" model="ir.ui.view">
        <field name="name">slide.channel.form.inherit.school</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_section_members" type="object"
                        string="Sync Section Students" class="btn-secondary"
                        invisible="not class_section_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_class_section" type="object"
                        class="oe_stat_button" icon="fa-users"
                        invisible="not class_section_id">
                    <field name="section_student_count" widget="statinfo" string="Section Students"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='course']" position="after">
                <group name="academic" string="Academic Information">
                    <field name="subject_id" options="{'no_create_edit': False}"/>
                    <field name="teacher_id"
                           domain="subject_id and [('active', '=', True), ('subject_ids', 'in', [subject_id])] or [('active', '=', True)]"
                           options="{'no_create_edit': False}"/>
                    <field name="class_section_id"
                           domain="subject_id and [('subject_id', '=', subject_id)] or []"
                           options="{'no_create_edit': False}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit slide.channel list/tree view -->
    <record id="view_slide_channel_view_tree_inherit_school" model="ir.ui.view">
        <field name="name">slide.channel.view.list.inherit.school</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.slide_channel_view_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="subject_id" optional="show"/>
                <field name="teacher_id" optional="show"/>
                <field name="class_section_id" optional="show"/>
                <field name="section_student_count" string="Section Enrolled" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Inherit slide.channel search view -->
    <record id="view_slide_channel_view_search_inherit_school" model="ir.ui.view">
        <field name="name">slide.channel.view.search.inherit.school</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.slide_channel_view_search"/>
        <field name="arch" type="xml">
            <field name="slide_ids" position="after">
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="class_section_id"/>
            </field>
            <filter name="inactive" position="after">
                <group>
                    <filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Class Section" name="group_by_class_section" context="{'group_by': 'class_section_id'}"/>
                </group>
            </filter>
        </field>
    </record>
</odoo>
