<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Class Section: Inherit university.class.section to add eLearning button -->
    <record id="view_university_class_section_form_inherit_elearning" model="ir.ui.view">
        <field name="name">university.class.section.form.inherit.elearning</field>
        <field name="model">university.class.section</field>
        <field name="inherit_id" ref="school_management.view_university_class_section_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_slide_channels"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-graduation-cap"
                        groups="school_management.group_school_admin,school_management.group_school_teacher,school_management.group_school_hod,school_management.group_school_dean,website_slides.group_website_slides_officer">
                    <field name="slide_channel_count" widget="statinfo" string="eLearning"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
