<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student: Inherit university.student to add eLearning Courses button & tab -->
    <record id="view_university_student_form_inherit_elearning" model="ir.ui.view">
        <field name="name">university.student.form.inherit.elearning</field>
        <field name="model">university.student</field>
        <field name="inherit_id" ref="school_management.view_university_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_slide_channels"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-graduation-cap">
                    <field name="slide_channel_count" widget="statinfo" string="eLearning"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="eLearning Courses"
                      name="elearning_tab">
                    <field name="slide_channel_ids" readonly="1">
                        <list string="eLearning Courses">
                            <field name="name" string="Course Title"/>
                            <field name="subject_id" string="Subject"/>
                            <field name="teacher_id" string="Instructor"/>
                            <field name="class_section_id" string="Section"/>
                            <field name="total_slides" string="Lessons"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
