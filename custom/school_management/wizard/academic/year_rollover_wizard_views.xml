<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_year_rollover_wizard_form" model="ir.ui.view">
        <field name="name">university.year.rollover.wizard.form</field>
        <field name="model">university.year.rollover.wizard</field>
        <field name="arch" type="xml">
            <form string="Academic Year Rollover">
                <group>
                    <field name="source_year_id"/>
                    <field name="new_year_name"/>
                    <field name="new_year_start_date"/>
                </group>
                <footer>
                    <button name="action_rollover" string="Create New Year" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
