<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_university_teacher_account_wizard_form" model="ir.ui.view">
        <field name="name">university.teacher.account.wizard.form</field>
        <field name="model">university.teacher.account.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Teacher Login Accounts">
                <group>
                    <field name="teacher_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_create_accounts" string="Create Accounts" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_university_teacher_account_wizard" model="ir.actions.act_window">
        <field name="name">Create Teacher Login Accounts</field>
        <field name="res_model">university.teacher.account.wizard</field>
        <field name="view_mode">form</field>
        <field name="limit">10</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_university_teacher"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
