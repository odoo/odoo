<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_attendance_print_wizard_form" model="ir.ui.view">
        <field name="name">university.attendance.print.wizard.form</field>
        <field name="model">university.attendance.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Reports &amp; Export">
                <group>
                    <group>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                    <group>
                        <field name="section_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <p class="text-muted">
                            Leave the class sections empty to include every section you are
                            allowed to see.
                        </p>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF (Grid)" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button name="action_export_xlsx" type="object" string="Export XLSX" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_export_csv" type="object" string="Export CSV (Grid)" class="btn-secondary" icon="fa-file-text-o"/>
                    <button name="action_export_at_risk_csv" type="object" string="At-Risk CSV" class="btn-secondary" icon="fa-exclamation-triangle"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_university_attendance_print_wizard" model="ir.actions.act_window">
        <field name="name">Reports &amp; Export</field>
        <field name="res_model">university.attendance.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="limit">10</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'large'}</field>
    </record>
</odoo>
