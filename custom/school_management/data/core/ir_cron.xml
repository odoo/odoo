<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_update_department_term_states" model="ir.cron">
        <field name="name">University: Update Department Term States</field>
        <field name="model_id" ref="model_university_department_term"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_notify_department_term_deadlines" model="ir.cron">
        <field name="name">University: Department Term Deadline Notifications</field>
        <field name="model_id" ref="model_university_department_term"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_deadline_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_update_timetable_slot_states" model="ir.cron">
        <field name="name">University: Update Timetable Slot States</field>
        <field name="model_id" ref="model_university_timetable_slot"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_states()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
