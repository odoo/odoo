<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_university_fee" model="ir.sequence">
        <field name="name">University Fee Invoice</field>
        <field name="code">university.fee</field>
        <field name="prefix">INV-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_university_payment" model="ir.sequence">
        <field name="name">University Fee Payment</field>
        <field name="code">university.payment</field>
        <field name="prefix">PAY-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_university_document_signature" model="ir.sequence">
        <field name="name">University Document Signature</field>
        <field name="code">university.document.signature</field>
        <field name="prefix">SIGN-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_university_admission_application" model="ir.sequence">
        <field name="name">University Admission Application</field>
        <field name="code">university.admission.application</field>
        <field name="prefix">ADM-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_university_report_card" model="ir.sequence">
        <field name="name">University Report Card</field>
        <field name="code">university.report.card</field>
        <field name="prefix">RC-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_university_transcript" model="ir.sequence">
        <field name="name">University Transcript</field>
        <field name="code">university.transcript</field>
        <field name="prefix">TRN-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_university_transcript_request" model="ir.sequence">
        <field name="name">University Transcript Request</field>
        <field name="code">university.transcript.request</field>
        <field name="prefix">TR-%(year)s-</field>
        <field name="padding" eval="4"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
