<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Semester Subject List View -->
    <record id="view_university_semester_subject_tree" model="ir.ui.view">
        <field name="name">university.semester.subject.list</field>
        <field name="model">university.semester.subject</field>
        <field name="arch" type="xml">
            <list string="Semester Subjects" sample="1" limit="10">
                <field name="subject_code" decoration-bf="1" string="Code"/>
                <field name="subject_id" decoration-bf="1"/>
                <field name="credits" widget="badge" decoration-info="1"/>
                <field name="semester_id"/>
                <field name="academic_year_id" optional="show"/>
                <field name="department_id"/>
<!--                <field name="is_current"/>-->
                <field name="faculty_id" optional="hide"/>
                <field name="section_count" string="Sections" widget="badge" decoration-success="section_count &gt; 0" decoration-muted="section_count == 0"/>
                <field name="enrollment_count" string="Enrolled" widget="badge" decoration-primary="enrollment_count &gt; 0" optional="show"/>
                <button name="action_view_sections" type="object" string="View Sections" icon="fa-users" class="btn-sm btn-link" invisible="section_count == 0"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Semester Subject Form View -->
    <record id="view_university_semester_subject_form" model="ir.ui.view">
        <field name="name">university.semester.subject.form</field>
        <field name="model">university.semester.subject</field>
        <field name="arch" type="xml">
            <form string="Semester Subject Offering">
                <header>
                    <button name="action_view_sections" type="object" string="View Class Sections" class="btn-primary" icon="fa-users" invisible="section_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sections" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="section_count" widget="statinfo" string="Sections"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="badge rounded-pill text-bg-primary mb-2 px-3 py-1 fs-6" invisible="not subject_code">
                        <field name="subject_code"/>
                    </div>
                    <div class="oe_title">
                        <label for="subject_id" string="Offered Subject"/>
                        <h1>
                            <field name="subject_id" placeholder="Select Subject..."/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="display_name" readonly="1"/>
                        </h4>
                    </div>
                    <group>
                        <group string="Semester &amp; Academic Period">
                            <field name="semester_id" options="{'no_create_edit': True}"/>
                            <field name="academic_year_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Department &amp; Accreditation">
                            <field name="department_id"/>
                            <field name="faculty_id"/>
                            <field name="credits"/>
                            <field name="enrollment_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructors" name="instructors">
                            <field name="teacher_ids">
                                <list limit="10" string="Assigned Instructors">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="department_id"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Semester Subject Search View -->
    <record id="view_university_semester_subject_search" model="ir.ui.view">
        <field name="name">university.semester.subject.search</field>
        <field name="model">university.semester.subject</field>
        <field name="arch" type="xml">
            <search string="Search Semester Subjects">
                <field name="subject_id"/>
                <field name="semester_id"/>
                <field name="academic_year_id"/>
                <field name="department_id"/>
                <field name="faculty_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                    <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Faculty" name="group_by_faculty" context="{'group_by': 'faculty_id'}"/>
                </group>
                <searchpanel>
                    <field name="academic_year_id" icon="fa-calendar" enable_counters="1"/>
                    <field name="department_id" icon="fa-building" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Enhanced Kanban View -->
    <record id="view_university_semester_subject_kanban" model="ir.ui.view">
        <field name="name">university.semester.subject.kanban</field>
        <field name="model">university.semester.subject</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="semester_id" quick_create="false" limit="10">
                <field name="subject_id"/>
                <field name="subject_code"/>
                <field name="semester_id"/>
                <field name="academic_year_id"/>
                <field name="department_id"/>
                <field name="credits"/>
                <field name="section_count"/>
                <field name="enrollment_count"/>
                <field name="display_name"/>
                <templates>
                    <t t-name="card">
                        <main class="p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge text-bg-primary px-2 py-1 font-monospace fw-bold" t-if="record.subject_code.value">
                                    <field name="subject_code"/>
                                </span>
                                <span class="badge rounded-pill text-bg-light border text-dark">
                                    <field name="credits"/> Credits
                                </span>
                            </div>
                            <div class="o_kanban_record_headings mb-2">
                                <strong class="fs-6 text-dark d-block text-truncate" t-att-title="record.subject_id.value">
                                    <field name="subject_id"/>
                                </strong>
                            </div>
                            <div class="text-muted small mb-1" t-if="record.department_id.value">
                                <i class="fa fa-building-o text-secondary me-1" title="Department"/>
                                <field name="department_id"/>
                            </div>
                            <div class="text-muted small mb-2" t-if="record.semester_id.value">
                                <i class="fa fa-calendar-check-o text-primary me-1" title="Semester"/>
                                <field name="semester_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-2">
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="fa fa-users me-1" title="Sections"/> <t t-esc="record.section_count.raw_value"/> Sections
                                </span>
                                <span class="badge bg-info-subtle text-info border border-info-subtle" t-if="record.enrollment_count.raw_value &gt; 0">
                                    <t t-esc="record.enrollment_count.raw_value"/> Enrolled
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_university_semester_subject" model="ir.actions.act_window">
        <field name="name">Semester Subjects</field>
        <field name="res_model">university.semester.subject</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_university_semester_subject_search"/>
        <field name="limit">10</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new Semester Subject Offering!
            </p>
            <p>
                Link academic subjects to specific academic semesters to define courses on offer.
            </p>
        </field>
    </record>

</odoo>
