<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =================================================================== -->
    <!-- WIZARD: Reject Transcript Request                                   -->
    <!-- =================================================================== -->
    <record id="view_university_transcript_request_reject_wizard_form" model="ir.ui.view"   >
        <field name="name">university.transcript.request.reject.wizard.form</field>
        <field name="model">university.transcript.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Transcript Request">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fa fa-info-circle me-1" title="Info"/>
                        Please specify the administrative, academic, or disciplinary reason for rejecting this transcript request. This explanation will be logged in the chatter and visible to the student.
                    </div>
                    <group>
                        <field name="request_id" readonly="1"/>
                        <field name="reject_reason" placeholder="e.g. Incomplete semester grades, financial balance unresolved, academic warning..." rows="4"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Confirm Rejection" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- WIZARD: Admin Override Transcript Request                           -->
    <!-- =================================================================== -->
    <record id="view_university_transcript_request_override_wizard_form" model="ir.ui.view">
        <field name="name">university.transcript.request.override.wizard.form</field>
        <field name="model">university.transcript.request.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Transcript Request (Override Holds)">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
                        Active hold(s) are currently blocking approval. As an authorized administrator, you may override these holds. You must provide a formal reason (minimum 10 characters). This action will be logged in the chatter and audit records.
                    </div>
                    <group>
                        <field name="request_id" invisible="1"/>
                        <field name="reason" placeholder="Explain why holds are being bypassed (minimum 10 characters)..." rows="4"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_override" type="object" string="Confirm" class="btn-warning"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- LIST VIEW                                                           -->
    <!-- =================================================================== -->
    <record id="view_university_transcript_request_list" model="ir.ui.view">
        <field name="name">university.transcript.request.list</field>
        <field name="model">university.transcript.request</field>
        <field name="arch" type="xml">
            <list limit="10" string="Transcript Requests" sample="1">
                <field name="name" string="Reference"/>
                <field name="student_id"/>
                <field name="program_id" optional="show"/>
                <field name="request_type" widget="badge"/>
                <field name="copies"/>
                <field name="purpose"/>
                <field name="delivery_method"/>
                <field name="create_date" string="Requested On" optional="show"/>
                <field name="fee_amount" string="Request Fee" optional="hide"/>
                <field name="payment_state" string="Request Fee Status" widget="badge" optional="hide"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'pending'"
                       decoration-muted="payment_state == 'not_required'"/>
                <field name="has_holds" widget="boolean_toggle" optional="show" string="Holds"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-primary="state == 'approved'"
                       decoration-success="state in ['issued', 'delivered']"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- KANBAN VIEW (Odoo 19 style: t-name="card")                          -->
    <!-- =================================================================== -->
    <record id="view_university_transcript_request_kanban" model="ir.ui.view">
        <field name="name">university.transcript.request.kanban</field>
        <field name="model">university.transcript.request</field>
        <field name="arch" type="xml">
            <kanban limit="10" default_group_by="state" sample="1" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="student_id"/>
                <field name="request_type"/>
                <field name="purpose"/>
                <field name="state"/>
                <field name="has_holds"/>
                <field name="show_holds_alert"/>
                <field name="verification_code"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column h-100 p-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-primary fs-6"><field name="name"/></strong>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'submitted'"
                                       decoration-primary="state == 'approved'"
                                       decoration-success="state in ['issued', 'delivered']"
                                       decoration-danger="state == 'rejected'"
                                       decoration-muted="state == 'cancelled'"/>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <field name="student_id" widget="many2one_avatar"/>
                            </div>
                            <div class="text-muted small mb-2">
                                <span class="badge bg-light text-dark border me-1"><field name="request_type"/></span>
                                <span class="badge bg-light text-dark border"><field name="purpose"/></span>
                            </div>
                            <div t-if="record.show_holds_alert.raw_value" class="alert alert-warning py-1 px-2 mb-2 small" role="alert">
                                <i class="fa fa-exclamation-triangle me-1" title="Hold warning"/>Holds Detected
                            </div>
                            <div t-if="record.verification_code.raw_value" class="mb-2">
                                <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace very-small">
                                    <i class="fa fa-qrcode me-1" title="Code"/><field name="verification_code"/>
                                </span>
                            </div>
                            <div class="mt-auto d-flex justify-content-between align-items-center text-muted very-small pt-2 border-top">
                                <span><i class="fa fa-envelope me-1" title="Delivery"/><field name="delivery_method"/></span>
                                <span><field name="create_date"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- FORM VIEW                                                           -->
    <!-- =================================================================== -->
    <record id="view_university_transcript_request_form" model="ir.ui.view">
        <field name="name">university.transcript.request.form</field>
        <field name="model">university.transcript.request</field>
        <field name="arch" type="xml">
            <form string="Transcript Request">
                <header>
                    <button name="action_submit" type="object" string="Submit Request" class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            groups="school_management.group_school_registrar"
                            invisible="state != 'submitted'"/>

                    <button name="action_open_override_wizard" type="object" string="Approve Anyway" class="btn-warning"
                            groups="school_management.group_school_admin,school_management.group_school_registrar"
                            invisible="not has_block_holds or state != 'submitted'"/>

                    <button name="action_open_reject_wizard" type="object" string="Reject" class="btn-secondary"
                            groups="school_management.group_school_registrar"
                            invisible="state != 'submitted'"/>

                    <button name="action_issue" type="object" string="Issue Transcript" class="btn-success"
                            groups="school_management.group_school_registrar"
                            invisible="state != 'approved'"/>

                    <button name="action_deliver" type="object" string="Mark Delivered" class="btn-primary"
                            groups="school_management.group_school_registrar"
                            invisible="state != 'issued'"/>

                    <button name="action_download_transcript" type="object" string="Download Transcript (PDF)"
                            class="btn-outline-primary"
                            invisible="not can_download_transcript"/>

                    <button name="action_cancel" type="object" string="Cancel Request" class="btn-secondary"
                            invisible="state not in ['draft', 'submitted']"/>

                    <button name="action_reset_draft" type="object" string="Reset to Draft" class="btn-secondary"
                            groups="school_management.group_school_registrar"
                            invisible="state not in ['rejected', 'cancelled']"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,issued,delivered"/>
                </header>
                <sheet>
                    <field name="has_holds" invisible="1"/>
                    <field name="has_block_holds" invisible="1"/>
                    <field name="show_holds_alert" invisible="1"/>
                    <field name="can_download_transcript" invisible="1"/>

                    <!-- Hold Notification Banner & Indicators -->
                    <div class="alert alert-warning mb-3" role="alert" invisible="not show_holds_alert">
                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-start">
                                <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning mt-1" title="Active Holds"/>
                                <div>
                                    <h5 class="mb-1 fw-bold">Active Academic or Financial Hold(s) Detected</h5>
                                    <field name="holds_summary" readonly="1" class="mb-0"/>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 ms-auto">
                                <field name="grades_status" widget="badge"
                                       decoration-success="grades_status == 'Grades: OK'"
                                       decoration-danger="grades_status == 'Grades: Missing'"/>
                                <field name="finance_status" widget="badge"
                                       decoration-success="finance_status == 'Finance: Clear'"
                                       decoration-danger="finance_status != 'Finance: Clear'"/>
                            </div>
                        </div>
                    </div>

                    <!-- Rejection Notice Banner -->
                    <div class="alert alert-danger mb-3" role="alert" invisible="state != 'rejected'">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-times-circle fa-2x me-3 text-danger" title="Rejected"/>
                            <div>
                                <h5 class="mb-1 fw-bold">Request Rejected</h5>
                                <p class="mb-0"><b>Reason: </b><field name="reject_reason" readonly="1" class="d-inline"/></p>
                            </div>
                        </div>
                    </div>

                    <!-- Issued Transcript Banner -->
                    <div class="alert alert-success mb-3" role="alert" invisible="state not in ['issued', 'delivered']">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-check-circle fa-2x me-3 text-success" title="Issued"/>
                                <div>
                                    <h5 class="mb-0 fw-bold">Official Transcript Issued</h5>
                                    <span class="small">Verification Code: <strong class="font-monospace"><field name="verification_code" readonly="1"/></strong></span>
                                </div>
                            </div>
                            <button name="action_download_transcript" type="object" string="Print Official Document"
                                    class="btn btn-sm btn-success" invisible="not transcript_id">
                                <i class="fa fa-print me-1" title="Print"/>Print PDF
                            </button>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Transcript Request Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Student &amp; Academic Program">
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="program_id" readonly="1"/>
                            <field name="request_type" readonly="state != 'draft'"/>
                            <field name="copies" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"/>
                            <field name="purpose_other" invisible="purpose != 'other'" readonly="state != 'draft'"/>
                        </group>
                        <group string="Delivery &amp; Logistics">
                            <field name="delivery_method" readonly="state != 'draft'"/>
                            <field name="recipient" readonly="state != 'draft'"/>
                            <field name="delivery_address" invisible="delivery_method != 'mail'" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="fee_amount" widget="monetary" readonly="1" string="Request Fee"/>
                            <field name="payment_state" widget="badge" string="Request Fee Status"
                                   decoration-success="payment_state == 'paid'"
                                   decoration-warning="payment_state == 'pending'"
                                   decoration-muted="payment_state == 'not_required'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Approval &amp; Issuance Details" invisible="state in ['draft', 'submitted']">
                            <group>
                                <group string="Approval Audit">
                                    <field name="approved_by" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                </group>
                                <group string="Issued Credentials">
                                    <field name="transcript_id" readonly="1"/>
                                    <field name="verification_code" readonly="1"/>
                                </group>
                            </group>
                            <group string="Administrative Hold Override" invisible="not override_user_id">
                                <field name="override_user_id" readonly="1"/>
                                <field name="override_date" readonly="1"/>
                                <field name="override_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- SEARCH VIEW                                                         -->
    <!-- =================================================================== -->
    <record id="view_university_transcript_request_search" model="ir.ui.view">
        <field name="name">university.transcript.request.search</field>
        <field name="model">university.transcript.request</field>
        <field name="arch" type="xml">
            <search string="Search Transcript Requests">
                <field name="name" string="Reference"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="recipient"/>
                <field name="verification_code"/>

                <filter string="Pending Approval" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Issued" name="filter_issued" domain="[('state', '=', 'issued')]"/>
                <filter string="Delivered" name="filter_delivered" domain="[('state', '=', 'delivered')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Official Only" name="filter_official" domain="[('request_type', '=', 'official')]"/>
                <separator/>
                <filter string="My Requests" name="filter_my_requests" domain="[('student_id.user_id', '=', uid)]"/>

                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Student" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Academic Program" name="group_by_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Request Type" name="group_by_request_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Purpose" name="group_by_purpose" context="{'group_by': 'purpose'}"/>
                    <filter string="Delivery Method" name="group_by_delivery_method" context="{'group_by': 'delivery_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- WINDOW ACTIONS                                                      -->
    <!-- =================================================================== -->
    <!-- Admin & Registrar Action -->
    <record id="action_university_transcript_request" model="ir.actions.act_window">
        <field name="name">Transcript Requests</field>
        <field name="res_model">university.transcript.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="limit">10</field>
        <field name="search_view_id" ref="view_university_transcript_request_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transcript requests found.
            </p>
            <p>
                Students can request official or unofficial transcripts. Registrars review holds, approve, and issue verified transcripts.
            </p>
        </field>
    </record>

    <!-- Student Action (scoped to their own student user) -->
    <record id="action_university_transcript_request_student" model="ir.actions.act_window">
        <field name="name">My Transcript Requests</field>
        <field name="res_model">university.transcript.request</field>
        <field name="view_mode">list,form</field>
        <field name="limit">10</field>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': True}</field>
    </record>
</odoo>
