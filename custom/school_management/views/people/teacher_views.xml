    <record id="action_open_university_teacher_profile" model="ir.actions.server">
        <field name="name">Open My Profile</field>
        <field name="model_id" ref="model_university_teacher"/>
        <field name="group_ids" eval="[(6, 0, [ref('school_management.group_university_teacher'), ref('school_management.group_school_student')])]"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
if env.user.has_group('school_management.group_school_student'):
    action = env['university.student'].action_open_own_profile()
else:
    action = env['university.teacher'].action_open_own_profile()
        ]]></field>
    </record>

