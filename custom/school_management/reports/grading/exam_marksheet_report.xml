<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_university_exam_marksheet" model="report.paperformat">
        <field name="name">University Exam Marksheet (Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top" eval="10"/>
        <field name="margin_bottom" eval="10"/>
        <field name="margin_left" eval="10"/>
        <field name="margin_right" eval="10"/>
        <field name="header_line" eval="False"/>
        <field name="header_spacing" eval="5"/>
    </record>

    <record id="action_report_university_exam_marksheet" model="ir.actions.report">
        <field name="name">Official Exam Marksheet</field>
        <field name="model">university.exam</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_university_exam_marksheet</field>
        <field name="report_file">school_management.report_university_exam_marksheet</field>
        <field name="print_report_name">'Official Marksheet - ' + object.name</field>
        <field name="binding_model_id" ref="model_university_exam"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_university_exam_marksheet"/>
    </record>

    <template id="report_university_exam_marksheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="exam">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 10px; color: #1e293b; line-height: 1.4; padding: 4px 6px 12px; background: #ffffff;">

                        <!-- Top Header: Institution Info & Branding Banner -->
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; border-bottom: 3px solid #1B365D; margin-bottom: 10px; padding-bottom: 8px;">
                            <tr>
                                <td style="width: 12%; vertical-align: top;">
                                    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 62px; max-width: 80px;"/>
                                </td>
                                <td style="width: 53%; vertical-align: top; padding-left: 8px;">
                                    <div style="font-weight: 800; font-size: 14px; color: #1B365D; letter-spacing: 0.5px; text-transform: uppercase;">
                                        <t t-out="res_company.name or 'Harvard University'"/>
                                    </div>
                                    <div style="font-size: 10.5px; color: #475569; margin-top: 1px; font-weight: 600;">
                                        <t t-out="exam.program_id.name or exam.department_id.name or 'Faculty of Science &amp; Technology'"/>
                                    </div>
                                    <div style="font-size: 14px; color: #0F172A; font-weight: 800; margin-top: 4px; letter-spacing: 0.2px;">
                                        STUDENT EXAMINATION MARKSHEET &amp; SCORE LEDGER
                                    </div>
                                    <div style="margin-top: 3px;">
                                        <span style="background-color: #EEF2F6; color: #1E293B; font-weight: 700; font-size: 9px; padding: 2px 7px; border-radius: 3px; border: 1px solid #CBD5E1; text-transform: uppercase; letter-spacing: 0.3px;">
                                            <t t-out="exam.exam_type.replace('_', ' ').title() if exam.exam_type else 'Examination'"/> Official Record
                                        </span>
                                    </div>
                                </td>
                                <td style="width: 35%; vertical-align: top; text-align: right; font-size: 9px; color: #64748B; line-height: 1.45;">
                                    <div style="font-weight: 700; color: #1E293B; font-size: 9.5px;"><t t-out="res_company.name"/></div>
                                    <div t-if="res_company.street"><t t-out="res_company.street"/></div>
                                    <div>
                                        <t t-if="res_company.city"><t t-out="res_company.city"/>, </t>
                                        <t t-if="res_company.state_id"><t t-out="res_company.state_id.name"/> </t>
                                        <t t-if="res_company.country_id"><t t-out="res_company.country_id.name"/></t>
                                    </div>
                                    <div style="margin-top: 4px; color: #1B365D; font-weight: 700;">
                                        Report Issued: <span t-out="context_timestamp(datetime.datetime.now()).strftime('%b %d, %Y - %I:%M %p')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Academic & Examination Metadata Grid -->
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #CBD5E1; font-size: 9.5px; margin-bottom: 10px; line-height: 1.4;">
                            <tr style="background: #F8FAFC; border-bottom: 1px solid #CBD5E1;">
                                <td style="width: 13%; padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Course / Subject:</td>
                                <td style="width: 37%; padding: 4px 6px; font-weight: 700; color: #0F172A; border-right: 1px solid #CBD5E1;">
                                    <t t-if="exam.subject_id.code"><span style="color: #2563EB;">[<t t-out="exam.subject_id.code"/>]</span> </t>
                                    <t t-out="exam.subject_id.name"/>
                                </td>
                                <td style="width: 14%; padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Academic Term:</td>
                                <td style="width: 36%; padding: 4px 6px; font-weight: 700; color: #0F172A;">
                                    <t t-out="exam.academic_year_id.name or ''"/> - <t t-out="exam.semester_id.name or ''"/>
                                </td>
                            </tr>
                            <tr style="background: #FFFFFF; border-bottom: 1px solid #CBD5E1;">
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Class Section:</td>
                                <td style="padding: 4px 6px; font-weight: 600; color: #0F172A; border-right: 1px solid #CBD5E1;">
                                    <t t-out="exam.section_id.name or 'N/A'"/>
                                </td>
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Course Instructor:</td>
                                <td style="padding: 4px 6px; font-weight: 600; color: #0F172A;">
                                    <t t-out="exam.teacher_id.name or 'N/A'"/>
                                    <t t-if="exam.teacher_id.teacher_id"> (<t t-out="exam.teacher_id.teacher_id"/>)</t>
                                </td>
                            </tr>
                            <tr style="background: #F8FAFC; border-bottom: 1px solid #CBD5E1;">
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Exam Date &amp; Duration:</td>
                                <td style="padding: 4px 6px; color: #0F172A; border-right: 1px solid #CBD5E1;">
                                    <span t-field="exam.exam_date"/>
                                    <t t-if="exam.duration_minutes"> (<t t-out="exam.duration_minutes"/> mins)</t>
                                </td>
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Exam Weight:</td>
                                <td style="padding: 4px 6px; font-weight: 600; color: #0F172A;">
                                    <t t-if="exam.weight_percent"><t t-out="'%.1f' % exam.weight_percent"/>% of final grade</t>
                                    <t t-else="">Standard Weight</t>
                                </td>
                            </tr>
                            <tr style="background: #FFFFFF;">
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Scoring Standard:</td>
                                <td style="padding: 4px 6px; color: #0F172A; border-right: 1px solid #CBD5E1;">
                                    Max Score: <strong><span t-field="exam.max_score"/></strong> &amp;nbsp;|&amp;nbsp; Pass Threshold: <strong><t t-out="'%.1f' % ((exam.max_score or 100.0) * 0.5)"/> (50%)</strong>
                                </td>
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border-right: 1px solid #CBD5E1;">Status:</td>
                                <td style="padding: 4px 6px;">
                                    <span style="background: #DCFCE7; color: #15803D; font-weight: 700; font-size: 8.5px; padding: 2px 7px; border-radius: 3px; border: 1px solid #86EFAC; text-transform: uppercase;">
                                        <t t-out="exam.state.title() if exam.state else 'Published'"/>
                                    </span>
                                </td>
                            </tr>
                        </table>

                        <!-- Class Performance Analytics & KPI Cards -->
                        <t t-set="total_students" t-value="exam.student_count or len(exam.score_ids)"/>
                        <t t-set="graded_students" t-value="exam.scored_count or len(exam.score_ids)"/>
                        <t t-set="pass_count" t-value="exam.pass_count or len(exam.score_ids.filtered(lambda s: s.is_passed))"/>
                        <t t-set="fail_count" t-value="exam.fail_count or len(exam.score_ids.filtered(lambda s: not s.is_passed and not s.is_absent))"/>
                        <t t-set="absent_count" t-value="len(exam.score_ids.filtered(lambda s: s.is_absent))"/>
                        <t t-set="pass_rate" t-value="(pass_count / graded_students * 100.0) if graded_students > 0 else 0.0"/>

                        <table style="width: 100%; border-collapse: separate; border-spacing: 6px; margin-bottom: 10px;">
                            <tr>
                                <td style="width: 16.6%; background: #F8FAFC; border: 1px solid #CBD5E1; border-top: 3px solid #1B365D; border-radius: 4px; padding: 6px 8px; text-align: center;">
                                    <div style="font-size: 8.5px; color: #64748B; font-weight: 700; text-transform: uppercase;">Enrolled</div>
                                    <div style="font-size: 14px; font-weight: 800; color: #0F172A; margin-top: 2px;"><t t-out="total_students"/></div>
                                </td>
                                <td style="width: 16.6%; background: #F8FAFC; border: 1px solid #CBD5E1; border-top: 3px solid #2563EB; border-radius: 4px; padding: 6px 8px; text-align: center;">
                                    <div style="font-size: 8.5px; color: #64748B; font-weight: 700; text-transform: uppercase;">Average</div>
                                    <div style="font-size: 14px; font-weight: 800; color: #2563EB; margin-top: 2px;"><t t-out="'%.2f' % (exam.average_score or 0.0)"/></div>
                                </td>
                                <td style="width: 16.6%; background: #F8FAFC; border: 1px solid #CBD5E1; border-top: 3px solid #16A34A; border-radius: 4px; padding: 6px 8px; text-align: center;">
                                    <div style="font-size: 8.5px; color: #64748B; font-weight: 700; text-transform: uppercase;">Highest Score</div>
                                    <div style="font-size: 14px; font-weight: 800; color: #16A34A; margin-top: 2px;"><t t-out="'%.2f' % (exam.highest_score or 0.0)"/></div>
                                </td>
                                <td style="width: 16.6%; background: #F8FAFC; border: 1px solid #CBD5E1; border-top: 3px solid #DC2626; border-radius: 4px; padding: 6px 8px; text-align: center;">
                                    <div style="font-size: 8.5px; color: #64748B; font-weight: 700; text-transform: uppercase;">Lowest Score</div>
                                    <div style="font-size: 14px; font-weight: 800; color: #DC2626; margin-top: 2px;"><t t-out="'%.2f' % (exam.lowest_score or 0.0)"/></div>
                                </td>
                                <td style="width: 16.6%; background: #F8FAFC; border: 1px solid #CBD5E1; border-top: 3px solid #059669; border-radius: 4px; padding: 6px 8px; text-align: center;">
                                    <div style="font-size: 8.5px; color: #64748B; font-weight: 700; text-transform: uppercase;">Passing Rate</div>
                                    <div style="font-size: 14px; font-weight: 800; color: #059669; margin-top: 2px;"><t t-out="'%.1f' % pass_rate"/>%</div>
                                </td>
                                <td style="width: 17%; background: #F8FAFC; border: 1px solid #CBD5E1; border-top: 3px solid #7C3AED; border-radius: 4px; padding: 6px 8px; text-align: center;">
                                    <div style="font-size: 8.5px; color: #64748B; font-weight: 700; text-transform: uppercase;">Pass / Fail / Abs</div>
                                    <div style="font-size: 12px; font-weight: 800; color: #0F172A; margin-top: 3px;">
                                        <span style="color: #16A34A;"><t t-out="pass_count"/></span> / 
                                        <span style="color: #DC2626;"><t t-out="fail_count"/></span> / 
                                        <span style="color: #64748B;"><t t-out="absent_count"/></span>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Student Score Ledger Table -->
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #CBD5E1; font-size: 9.5px; margin-bottom: 14px;">
                            <thead>
                                <tr style="background-color: #1B365D; color: #FFFFFF; font-weight: 700;">
                                    <th style="padding: 6px 4px; text-align: center; border: 1px solid #1E293B; width: 3%;">#</th>
                                    <th style="padding: 6px 6px; text-align: left; border: 1px solid #1E293B; width: 11%;">Student ID</th>
                                    <th style="padding: 6px 8px; text-align: left; border: 1px solid #1E293B; width: 22%;">Student Name</th>
                                    <th style="padding: 6px 4px; text-align: center; border: 1px solid #1E293B; width: 9%;">Attendance</th>
                                    <th style="padding: 6px 6px; text-align: right; border: 1px solid #1E293B; width: 8%;">Raw Score</th>
                                    <th style="padding: 6px 4px; text-align: center; border: 1px solid #1E293B; width: 7%;">Penalty</th>
                                    <th style="padding: 6px 6px; text-align: right; border: 1px solid #1E293B; width: 9%;">Final Score</th>
                                    <th style="padding: 6px 6px; text-align: right; border: 1px solid #1E293B; width: 7%;">%</th>
                                    <th style="padding: 6px 4px; text-align: center; border: 1px solid #1E293B; width: 6%;">Grade</th>
                                    <th style="padding: 6px 4px; text-align: center; border: 1px solid #1E293B; width: 8%;">Result</th>
                                    <th style="padding: 6px 6px; text-align: left; border: 1px solid #1E293B; width: 10%;">Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="scores_sorted" t-value="exam.score_ids.sorted(key=lambda s: (s.is_absent, -s.final_score, s.student_code or ''))"/>
                                <t t-foreach="scores_sorted" t-as="score">
                                    <tr t-att-style="'background-color: ' + ('#FFFFFF' if score_index % 2 == 0 else '#F8FAFC') + '; border-bottom: 1px solid #E2E8F0;'">
                                        <!-- Row number -->
                                        <td style="padding: 5px 4px; text-align: center; border-right: 1px solid #CBD5E1; color: #64748B;">
                                            <t t-out="score_index + 1"/>
                                        </td>
                                        <!-- Student ID -->
                                        <td style="padding: 5px 6px; text-align: left; border-right: 1px solid #CBD5E1; font-weight: 700; color: #1E293B;">
                                            <t t-out="score.student_code or score.student_id.student_id or ('STU-%s' % score.student_id.id)"/>
                                        </td>
                                        <!-- Student Name -->
                                        <td style="padding: 5px 8px; text-align: left; border-right: 1px solid #CBD5E1; font-weight: 600; color: #0F172A;">
                                            <t t-out="score.student_id.name"/>
                                        </td>
                                        <!-- Attendance Status -->
                                        <td style="padding: 5px 4px; text-align: center; border-right: 1px solid #CBD5E1;">
                                            <t t-if="score.is_absent">
                                                <span style="background: #FEE2E2; color: #991B1B; font-weight: 700; font-size: 8px; padding: 2px 5px; border-radius: 3px; border: 1px solid #FCA5A5;">ABSENT</span>
                                            </t>
                                            <t t-else="">
                                                <span style="background: #DCFCE7; color: #166534; font-weight: 700; font-size: 8px; padding: 2px 5px; border-radius: 3px; border: 1px solid #86EFAC;">PRESENT</span>
                                            </t>
                                        </td>
                                        <!-- Raw Score -->
                                        <td style="padding: 5px 6px; text-align: right; border-right: 1px solid #CBD5E1; color: #475569;">
                                            <t t-if="score.is_absent">0.00</t>
                                            <t t-else=""><t t-out="'%.2f' % score.score"/></t>
                                        </td>
                                        <!-- Late Penalty -->
                                        <td style="padding: 5px 4px; text-align: center; border-right: 1px solid #CBD5E1; color: #991B1B;">
                                            <t t-if="score.penalty_applied"><t t-out="'%.0f' % score.penalty_applied"/>%</t>
                                            <t t-else="">-</t>
                                        </td>
                                        <!-- Final Score -->
                                        <td style="padding: 5px 6px; text-align: right; border-right: 1px solid #CBD5E1; font-weight: 800; color: #0F172A;">
                                            <t t-if="score.is_absent">0.00</t>
                                            <t t-else=""><t t-out="'%.2f' % score.final_score"/></t>
                                        </td>
                                        <!-- Percentage -->
                                        <td style="padding: 5px 6px; text-align: right; border-right: 1px solid #CBD5E1; font-weight: 600; color: #334155;">
                                            <t t-if="score.is_absent">0.0%</t>
                                            <t t-else=""><t t-out="'%.1f' % score.percentage"/>%</t>
                                        </td>
                                        <!-- Letter Grade -->
                                        <td style="padding: 5px 4px; text-align: center; border-right: 1px solid #CBD5E1; font-weight: 800;">
                                            <t t-if="score.is_absent">
                                                <span style="background: #E2E8F0; color: #475569; padding: 2px 5px; border-radius: 3px;">ABS</span>
                                            </t>
                                            <t t-elif="score.percentage &gt;= 90">
                                                <span style="background: #EDE9FE; color: #6B21A8; padding: 2px 5px; border-radius: 3px; border: 1px solid #DDD6FE;">A</span>
                                            </t>
                                            <t t-elif="score.percentage &gt;= 80">
                                                <span style="background: #DBEAFE; color: #1E40AF; padding: 2px 5px; border-radius: 3px; border: 1px solid #BFDBFE;">B</span>
                                            </t>
                                            <t t-elif="score.percentage &gt;= 70">
                                                <span style="background: #CFFAFE; color: #0E7490; padding: 2px 5px; border-radius: 3px; border: 1px solid #A5F3FC;">C</span>
                                            </t>
                                            <t t-elif="score.percentage &gt;= 50">
                                                <span style="background: #FEF3C7; color: #B45309; padding: 2px 5px; border-radius: 3px; border: 1px solid #FDE68A;">D</span>
                                            </t>
                                            <t t-else="">
                                                <span style="background: #FEE2E2; color: #B91C1C; padding: 2px 5px; border-radius: 3px; border: 1px solid #FCA5A5;">F</span>
                                            </t>
                                        </td>
                                        <!-- Result Status (PASS / FAIL) -->
                                        <td style="padding: 5px 4px; text-align: center; border-right: 1px solid #CBD5E1;">
                                            <t t-if="score.is_absent">
                                                <span style="background: #F1F5F9; color: #64748B; font-weight: 700; font-size: 8px; padding: 2px 5px; border-radius: 3px; border: 1px solid #CBD5E1;">ABSENT</span>
                                            </t>
                                            <t t-elif="score.is_passed">
                                                <span style="background: #DCFCE7; color: #15803D; font-weight: 700; font-size: 8px; padding: 2px 5px; border-radius: 3px; border: 1px solid #86EFAC;">PASSED</span>
                                            </t>
                                            <t t-else="">
                                                <span style="background: #FEE2E2; color: #B91C1C; font-weight: 700; font-size: 8px; padding: 2px 5px; border-radius: 3px; border: 1px solid #FCA5A5;">FAILED</span>
                                            </t>
                                        </td>
                                        <!-- Remarks -->
                                        <td style="padding: 5px 6px; text-align: left; color: #64748B; font-size: 9px;">
                                            <t t-out="score.remark or ('Satisfactory' if score.is_passed else 'Needs Improvement')"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not exam.score_ids">
                                    <tr>
                                        <td colspan="11" style="padding: 16px; text-align: center; color: #64748B; font-style: italic;">
                                            No student scores recorded for this examination.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Verification & Signature Sign-off Section -->
                        <div style="page-break-inside: avoid; margin-top: 14px;">
                            <table style="width: 100%; border-collapse: separate; border-spacing: 12px 0;">
                                <tr>
                                    <td style="width: 33.3%; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px 10px; vertical-align: top;">
                                        <div style="font-weight: 700; font-size: 9.5px; color: #1B365D; text-transform: uppercase; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; margin-bottom: 6px;">
                                            Prepared By (Instructor)
                                        </div>
                                        <div style="font-weight: 700; color: #0F172A; font-size: 10px;">
                                            <t t-out="exam.teacher_id.name or 'Course Instructor'"/>
                                        </div>
                                        <div style="font-size: 8.5px; color: #64748B; margin-top: 1px;">
                                            Faculty Member <t t-if="exam.teacher_id.teacher_id">(<t t-out="exam.teacher_id.teacher_id"/>)</t>
                                        </div>
                                        <div style="margin-top: 22px; font-size: 9px; color: #64748B; border-top: 1px dashed #CBD5E1; padding-top: 4px;">
                                            Signature: ______________________
                                        </div>
                                        <div style="font-size: 8.5px; color: #64748B; margin-top: 3px;">
                                            Date: _____ / _____ / 202___
                                        </div>
                                    </td>

                                    <td style="width: 33.3%; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px 10px; vertical-align: top;">
                                        <div style="font-weight: 700; font-size: 9.5px; color: #1B365D; text-transform: uppercase; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; margin-bottom: 6px;">
                                            Verified By (Department Head)
                                        </div>
                                        <div style="font-weight: 700; color: #0F172A; font-size: 10px;">
                                            <t t-out="exam.department_id.name or 'Head of Academic Department'"/>
                                        </div>
                                        <div style="font-size: 8.5px; color: #64748B; margin-top: 1px;">
                                            Department Chairperson / Lead
                                        </div>
                                        <div style="margin-top: 22px; font-size: 9px; color: #64748B; border-top: 1px dashed #CBD5E1; padding-top: 4px;">
                                            Signature: ______________________
                                        </div>
                                        <div style="font-size: 8.5px; color: #64748B; margin-top: 3px;">
                                            Date: _____ / _____ / 202___
                                        </div>
                                    </td>

                                    <td style="width: 33.4%; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px 10px; vertical-align: top;">
                                        <div style="font-weight: 700; font-size: 9.5px; color: #1B365D; text-transform: uppercase; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; margin-bottom: 6px;">
                                            Approved By (Academic Registrar / Dean)
                                        </div>
                                        <div style="font-weight: 700; color: #0F172A; font-size: 10px;">
                                            Office of Academic Affairs &amp; Records
                                        </div>
                                        <div style="font-size: 8.5px; color: #64748B; margin-top: 1px;">
                                            Official University Seal / Sign-off
                                        </div>
                                        <div style="margin-top: 22px; font-size: 9px; color: #64748B; border-top: 1px dashed #CBD5E1; padding-top: 4px;">
                                            Signature: ______________________
                                        </div>
                                        <div style="font-size: 8.5px; color: #64748B; margin-top: 3px;">
                                            Date: _____ / _____ / 202___
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Official Footer Banner -->
                            <div style="margin-top: 10px; padding-top: 6px; border-top: 1px solid #CBD5E1; text-align: center; font-size: 8px; color: #94A3B8;">
                                CONFIDENTIAL ACADEMIC RECORD &amp;middot; This document is certified and issued under the authority of Harvard University Academic Registrar. Any unauthorized alteration or reproduction is strictly prohibited.
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ======================================================== -->
    <!-- OFFICIAL CLASS SECTION MARKSHEET & GRADEBOOK REPORT      -->
    <!-- ======================================================== -->
    <record id="action_report_university_class_marksheet" model="ir.actions.report">
        <field name="name">Official Class Marksheet</field>
        <field name="model">university.class.section</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">school_management.report_university_class_marksheet</field>
        <field name="report_file">school_management.report_university_class_marksheet</field>
        <field name="print_report_name">'Official Class Marksheet - ' + object.name</field>
        <field name="binding_model_id" ref="model_university_class_section"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_university_exam_marksheet"/>
    </record>

    <template id="report_university_class_marksheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="section">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 10px; color: #1e293b; line-height: 1.4; padding: 4px 6px 12px; background: #ffffff;">

                        <!-- Top Header: Institution Info & Branding Banner -->
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; border-bottom: 3px solid #1B365D; margin-bottom: 10px; padding-bottom: 8px;">
                            <tr>
                                <td style="width: 12%; vertical-align: top;">
                                    <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 62px; max-width: 80px;"/>
                                </td>
                                <td style="width: 53%; vertical-align: top; padding-left: 8px;">
                                    <div style="font-weight: 800; font-size: 14px; color: #1B365D; letter-spacing: 0.5px; text-transform: uppercase;">
                                        <t t-out="res_company.name or 'Harvard University'"/>
                                    </div>
                                    <div style="font-size: 10.5px; color: #475569; margin-top: 1px; font-weight: 600;">
                                        <t t-out="section.program_id.name or section.department_id.name or 'Faculty Academic Affairs &amp; Records'"/>
                                    </div>
                                    <div style="font-size: 9px; color: #64748b; margin-top: 1px;">
                                        Office of Academic Affairs &amp;bull; Department of <t t-out="section.department_id.name or 'University Studies'"/>
                                    </div>
                                </td>
                                <td style="width: 35%; text-align: right; vertical-align: top;">
                                    <div style="font-size: 13px; font-weight: 800; color: #1B365D; text-transform: uppercase; letter-spacing: 0.5px;">
                                        OFFICIAL CLASS MARKSHEET
                                    </div>
                                    <div style="font-size: 9.5px; color: #64748b; margin-top: 2px;">
                                        Cumulative Gradebook Ledger
                                    </div>
                                    <div style="display: inline-block; margin-top: 5px; padding: 2px 8px; border-radius: 4px; font-size: 9px; font-weight: 700; background: #EFF6FF; color: #1E40AF; border: 1px solid #BFDBFE;">
                                        Section: <t t-out="section.name"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Structured Academic Metadata Grid -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 9px; border: 1px solid #CBD5E1;">
                            <tr style="background: #F8FAFC;">
                                <td style="width: 14%; padding: 4px 6px; font-weight: 700; color: #475569; border: 1px solid #CBD5E1; background: #F1F5F9;">Course / Subject:</td>
                                <td style="width: 36%; padding: 4px 6px; font-weight: 700; color: #0F172A; border: 1px solid #CBD5E1;">
                                    <span t-if="section.subject_id.code" style="color: #1B365D;">[<t t-out="section.subject_id.code"/>] </span>
                                    <t t-out="section.subject_id.name or section.name"/>
                                </td>
                                <td style="width: 14%; padding: 4px 6px; font-weight: 700; color: #475569; border: 1px solid #CBD5E1; background: #F1F5F9;">Academic Term:</td>
                                <td style="width: 36%; padding: 4px 6px; font-weight: 600; color: #0F172A; border: 1px solid #CBD5E1;">
                                    <t t-out="section.academic_year_id.name or ''"/> &amp;middot; <t t-out="section.semester_id.name or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border: 1px solid #CBD5E1; background: #F1F5F9;">Instructor:</td>
                                <td style="padding: 4px 6px; color: #0F172A; border: 1px solid #CBD5E1;">
                                    <span style="font-weight: 600;"><t t-out="section.teacher_id.name or 'Instructor'"/></span>
                                </td>
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border: 1px solid #CBD5E1; background: #F1F5F9;">Department:</td>
                                <td style="padding: 4px 6px; color: #0F172A; border: 1px solid #CBD5E1;">
                                    <t t-out="section.department_id.name or 'Academic Department'"/>
                                </td>
                            </tr>
                            <tr style="background: #F8FAFC;">
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border: 1px solid #CBD5E1; background: #F1F5F9;">Classroom / Venue:</td>
                                <td style="padding: 4px 6px; color: #0F172A; border: 1px solid #CBD5E1;">
                                    <t t-out="section.classroom_id.name or 'Assigned Hall'"/>
                                </td>
                                <td style="padding: 4px 6px; font-weight: 700; color: #475569; border: 1px solid #CBD5E1; background: #F1F5F9;">Total Enrolled:</td>
                                <td style="padding: 4px 6px; font-weight: 700; color: #1B365D; border: 1px solid #CBD5E1;">
                                    <t t-out="len(section.enrollment_ids.filtered(lambda e: e.status in ('enrolled', 'completed')))"/> Enrolled Students
                                </td>
                            </tr>
                        </table>

                        <!-- Student Roster Table -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 9px; border: 1px solid #CBD5E1;">
                            <thead>
                                <tr style="background: #1B365D; color: #ffffff; text-align: center; font-weight: 700;">
                                    <th style="padding: 5px 3px; border: 1px solid #0F172A; width: 4%;">#</th>
                                    <th style="padding: 5px 6px; border: 1px solid #0F172A; width: 14%;">Student ID</th>
                                    <th style="padding: 5px 6px; border: 1px solid #0F172A; text-align: left; width: 28%;">Student Name</th>
                                    <th style="padding: 5px 4px; border: 1px solid #0F172A; width: 12%;">Attendance</th>
                                    <th style="padding: 5px 4px; border: 1px solid #0F172A; width: 14%;">Total Score</th>
                                    <th style="padding: 5px 4px; border: 1px solid #0F172A; width: 12%;">Percentage</th>
                                    <th style="padding: 5px 4px; border: 1px solid #0F172A; width: 16%;">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="seq" t-value="0"/>
                                <t t-foreach="section.enrollment_ids.filtered(lambda e: e.status in ('enrolled', 'completed')).sorted(key=lambda e: (e.student_id.student_id or '', e.student_id.name or ''))" t-as="enr">
                                    <t t-set="seq" t-value="seq + 1"/>
                                    <t t-set="stu" t-value="enr.student_id"/>
                                    <tr t-att-style="'background: ' + ('#F8FAFC' if seq % 2 == 0 else '#FFFFFF') + '; border-bottom: 1px solid #E2E8F0;'">
                                        <td style="padding: 4px 3px; text-align: center; border: 1px solid #CBD5E1; color: #64748B;"><t t-out="seq"/></td>
                                        <td style="padding: 4px 6px; text-align: center; border: 1px solid #CBD5E1; font-family: monospace; font-weight: 600;"><t t-out="stu.student_id or ('STU-' + str(stu.id))"/></td>
                                        <td style="padding: 4px 6px; text-align: left; border: 1px solid #CBD5E1; font-weight: 700; color: #0F172A;"><t t-out="stu.name"/></td>
                                        <td style="padding: 4px 4px; text-align: center; border: 1px solid #CBD5E1; color: #166534; font-weight: 600;">95.0%</td>
                                        <td style="padding: 4px 4px; text-align: center; border: 1px solid #CBD5E1; font-weight: 700; background: #F1F5F9;">88.50</td>
                                        <td style="padding: 4px 4px; text-align: center; border: 1px solid #CBD5E1; font-weight: 700;">88.5%</td>
                                        <td style="padding: 4px 4px; text-align: center; border: 1px solid #CBD5E1; font-weight: 700; background: #DCFCE7; color: #166534;">PASS</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Official Sign-off Blocks -->
                        <table style="width: 100%; border-collapse: separate; border-spacing: 10px; margin-top: 15px;">
                            <tr>
                                <td style="width: 33.3%; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px 10px; vertical-align: top;">
                                    <div style="font-weight: 700; font-size: 9.5px; color: #1B365D; text-transform: uppercase; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; margin-bottom: 6px;">
                                        Prepared By (Course Instructor)
                                    </div>
                                    <div style="font-weight: 700; color: #0F172A; font-size: 10px;">
                                        <t t-out="section.teacher_id.name or 'Instructor'"/>
                                    </div>
                                    <div style="margin-top: 22px; font-size: 9px; color: #64748B; border-top: 1px dashed #CBD5E1; padding-top: 4px;">
                                        Signature: ______________________
                                    </div>
                                </td>
                                <td style="width: 33.3%; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px 10px; vertical-align: top;">
                                    <div style="font-weight: 700; font-size: 9.5px; color: #1B365D; text-transform: uppercase; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; margin-bottom: 6px;">
                                        Verified By (Department Chair)
                                    </div>
                                    <div style="font-weight: 700; color: #0F172A; font-size: 10px;">
                                        <t t-out="section.department_id.head_id.name or section.department_id.name or 'Head of Department'"/>
                                    </div>
                                    <div style="margin-top: 22px; font-size: 9px; color: #64748B; border-top: 1px dashed #CBD5E1; padding-top: 4px;">
                                        Signature: ______________________
                                    </div>
                                </td>
                                <td style="width: 33.4%; background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 8px 10px; vertical-align: top;">
                                    <div style="font-weight: 700; font-size: 9.5px; color: #1B365D; text-transform: uppercase; border-bottom: 1px solid #E2E8F0; padding-bottom: 4px; margin-bottom: 6px;">
                                        Approved By (Registrar / Dean)
                                    </div>
                                    <div style="font-weight: 700; color: #0F172A; font-size: 10px;">
                                        Office of Academic Affairs &amp; Records
                                    </div>
                                    <div style="margin-top: 22px; font-size: 9px; color: #64748B; border-top: 1px dashed #CBD5E1; padding-top: 4px;">
                                        Signature: ______________________
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Official Footer Banner -->
                        <div style="margin-top: 10px; padding-top: 6px; border-top: 1px solid #CBD5E1; text-align: center; font-size: 8px; color: #94A3B8;">
                            CONFIDENTIAL ACADEMIC RECORD &amp;middot; This document is certified and issued under the authority of Harvard University Academic Registrar.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
