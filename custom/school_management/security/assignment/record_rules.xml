<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="rule_student_own_assignments" model="ir.rule">
        <field name="name">Student: own assignments</field>
        <field name="model_id" ref="model_university_assignment" />
        <field name="groups" eval="[(4, ref('group_school_student'))]" />
        <field name="domain_force">['|', ('student_id.user_id', '=', user.id), ('section_id.enrollment_ids', 'any', [('student_id.user_id', '=', user.id), ('status', '=', 'enrolled')])]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_student_own_submissions" model="ir.rule">
        <field name="name">Student: own submissions</field>
        <field name="model_id" ref="model_university_assignment_submission" />
        <field name="groups" eval="[(4, ref('group_school_student'))]" />
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_teacher_own_assignments_teaching" model="ir.rule">
        <field name="name">Teacher: own teaching assignments</field>
        <field name="model_id" ref="model_university_assignment" />
        <field name="groups" eval="[(4, ref('group_university_teacher'))]" />
        <field name="domain_force">[('section_id.teacher_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="rule_teacher_own_assignment_submissions" model="ir.rule">
        <field name="name">Teacher: submissions for own assignments</field>
        <field name="model_id" ref="model_university_assignment_submission" />
        <field name="groups" eval="[(4, ref('group_university_teacher'))]" />
        <field name="domain_force">[('assignment_id.section_id.teacher_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_admin_all_assignments_learning" model="ir.rule">
        <field name="name">Admin: all assignments</field>
        <field name="model_id" ref="model_university_assignment" />
        <field name="groups" eval="[(4, ref('group_school_admin'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="rule_admin_all_assignment_submissions" model="ir.rule">
        <field name="name">Admin: all assignment submissions</field>
        <field name="model_id" ref="model_university_assignment_submission" />
        <field name="groups" eval="[(4, ref('group_school_admin'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>