<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="rule_student_own_service_hours" model="ir.rule">
        <field name="name">Student: own service hours</field>
        <field name="model_id" ref="model_university_service_hour" />
        <field name="groups" eval="[(4, ref('group_school_student'))]" />
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_teacher_own_service_hours" model="ir.rule">
        <field name="name">Teacher: own service hours</field>
        <field name="model_id" ref="model_university_service_hour" />
        <field name="groups" eval="[(4, ref('group_university_teacher'))]" />
        <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_admin_all_service_hours" model="ir.rule">
        <field name="name">Admin: all service hours</field>
        <field name="model_id" ref="model_university_service_hour" />
        <field name="groups" eval="[(4, ref('group_school_admin'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="rule_service_request_student" model="ir.rule">
        <field name="name">Student: own service requests</field>
        <field name="model_id" ref="model_university_service_request" />
        <field name="groups" eval="[(4, ref('group_school_student'))]" />
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_service_request_staff" model="ir.rule">
        <field name="name">Staff: all service requests</field>
        <field name="model_id" ref="model_university_service_request" />
        <field name="groups" eval="[(4, ref('group_school_admin')), (4, ref('group_school_registrar'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>