        </record>
        <record id="one2many_message_0_1" model="test_orm.one2many.message">
            <field name="discussion" ref="one2many_discussion_0"/>
            <field name="body">What's up?</field>
        </record>
        <record id="one2many_message_0_2" model="test_orm.one2many.message">
            <field name="discussion" ref="one2many_discussion_0"/>
