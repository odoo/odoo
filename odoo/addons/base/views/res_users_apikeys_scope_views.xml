<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_apikeys_scope_view_form" model="ir.ui.view">
        <field name="name">res.users.apikeys.scope.form</field>
        <field name="model">res.users.apikeys.scope</field>
        <field name="arch" type="xml">
            <form string="API Key Scope">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. MCP" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key" />
                            <field name="active" invisible="1" />
                            <field name="door_only" />
                            <field name="closed_when_empty" invisible="door_only" />
                            <field name="max_depth" invisible="door_only" />
                        </group>
                        <group string="Budget">
                            <field name="budget_requests" />
                            <field name="budget_window_seconds" />
                        </group>
                    </group>
                    <notebook>
                        <page name="models" string="Models">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field
                                        name="model_id"
                                        options="{'no_create': True}" />
                                    <field name="allow_read" />
                                    <field name="allow_create" />
                                    <field name="allow_write" />
                                    <field name="allow_unlink" />
                                    <field name="allow_call" />
                                    <field
                                        name="denied_field_ids"
                                        widget="many2many_tags"
                                        options="{'no_create': True}" />
                                    <field name="notes" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_users_apikeys_scope_view_list" model="ir.ui.view">
        <field name="name">res.users.apikeys.scope.list</field>
        <field name="model">res.users.apikeys.scope</field>
        <field name="arch" type="xml">
            <list string="API Key Scopes">
                <field name="key" />
                <field name="name" />
                <field name="max_depth" optional="hide" />
                <field name="budget_requests" optional="hide" />
            </list>
        </field>
    </record>

    <record id="res_users_apikeys_scope_view_search" model="ir.ui.view">
        <field name="name">res.users.apikeys.scope.search</field>
        <field name="model">res.users.apikeys.scope</field>
        <field name="arch" type="xml">
            <search string="API Key Scopes">
                <field name="key" />
                <field name="name" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_res_users_apikeys_scope" model="ir.actions.act_window">
        <field name="name">API Key Scopes</field>
        <field name="res_model">res.users.apikeys.scope</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
