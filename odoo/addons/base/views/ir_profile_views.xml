<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_profile_view_search" model="ir.ui.view">
        <field name="name">IR Profile Search</field>
        <field name="model">ir.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="session" string="Session"/>
                <filter name="group_session" string="Session" context="{'group_by':'session'}"/>
            </search>
        </field>
    </record>

    <record id="ir_profile_view_list" model="ir.ui.view">
        <field name="name">IR Profile List</field>
        <field name="model">ir.profile</field>
        <field name="arch" type="xml">
            <list string="Profile Session" default_order="session desc, id desc" create="0">
                <header>
                    <button name="action_view_speedscope" type="object" string="View in speedscope"/>
                </header>
                <field name="create_date"/>
                <field name="session"/>
                <field name="name"/>
                <field name="entry_count"/>
                <field name="sql_count" optional="hide"/>
                <field name="speedscope_url" widget="url"/>
                <field name="config_url" widget="url"/>
                <field name="duration"/>
                <field name="cpu_duration" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ir_profile_view_form" model="ir.ui.view">
        <field name="name">IR Profile Form</field>
        <field name="model">ir.profile</field>
        <field name="arch" type="xml">
            <form string="IR Profile">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_sql_queries"
                        class="oe_stat_button"
                        icon="database"
                        invisible="sql_count == 0"
                        type="object">
                         <field string="SQL queries" name="sql_count" widget="statinfo"/>
                    </button>
                </div>
                <group>
                    <field name="name"/>
                    <field name="session"/>
                    <field name="cpu_duration"/>
                    <field name="entry_count"/>
                    <field name="speedscope_url" widget="url"/>
                    <field name="config_url" widget="url"/>
                </group>
                <group invisible="not qweb">
                    <field name="qweb" widget="profiling_qweb_view" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="ir_profile_query_view_search" model="ir.ui.view">
        <field name="name">IR Profile Query Search</field>
        <field name="model">ir.profile.query</field>
        <field name="arch" type="xml">
            <search>
                <field name="query"/>
                <field name="full_query"/>
            </search>
        </field>
    </record>

    <record id="ir_profile_query_view_list" model="ir.ui.view">
        <field name="name">IR Profile Query List</field>
        <field name="model">ir.profile.query</field>
        <field name="arch" type="xml">
            <list>
                <field name="time"/>
                <field name="query_preview"/>
                <field name="formatted_query" string="Copy query" widget="CopyClipboardButton" options="{'btn_class': 'btn-link'}"/>
                <button
                    name="action_explain_analyse" string="Explain Analyze" type="object" invisible="plan"
                    title="EXPLAIN ANALYZE really runs this query: data changes are rolled back, but it takes the same locks and can be as slow as the original execution."
                />
                <field name="plan" string="Copy plan" widget="CopyClipboardButton" invisible="not plan"/>
            </list>
        </field>
    </record>

    <record id="ir_profile_query_view_form" model="ir.ui.view">
        <field name="name">IR Profile Query Form</field>
        <field name="model">ir.profile.query</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="profile_id"/>
                    <field name="time"/>
                </group>
                <group string="Query">
                    <field name="formatted_query" string="Copy query" widget="CopyClipboardButton" nolabel="1"
                        colspan="2" class="oe_inline mb-2" options="{'btn_class': 'secondary btn-sm'}"/>
                    <field name="formatted_query" nolabel="1" colspan="2" class="font-monospace"/>
                </group>
                <group string="Query Plan">
                    <button
                        name="action_explain_analyse" string="Explain Analyze" type="object" invisible="plan"
                        colspan="2" class="btn-primary btn-sm"
                        title="EXPLAIN ANALYZE really runs this query: data changes are rolled back, but it takes the same locks and can be as slow as the original execution."
                    />
                    <field name="plan" string="Copy query plan" widget="CopyClipboardButton" nolabel="1"
                        colspan="2" class="oe_inline mb-2" options="{'btn_class': 'secondary btn-sm'}"/>
                    <field name="plan" nolabel="1" colspan="2" class="font-monospace"/>
                </group>
            </form>
        </field>
    </record>

    <record id="ir_profile_query_action_explain" model="ir.actions.server">
        <field name="name">Explain Analyze</field>
        <field name="model_id" ref="base.model_ir_profile_query"/>
        <field name="binding_model_id" ref="base.model_ir_profile_query"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_explain_analyse()</field>
        <field name="group_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

    <record id="enable_profiling_wizard" model="ir.ui.view">
        <field name="name">Enable profiling</field>
        <field name="model">base.enable.profiling.wizard</field>
        <field name="arch" type="xml">
            <form string="Enable profiling">
                <div class="alert alert-warning" role="alert">
                    <h3>Profiling is currently disabled.</h3>
                    Profiling is a developer feature that should be used with caution on production database.
                    It may add some load on the server, and potentially make it less responsive.
                    Enabling the profiling here allows all users to activate profiling on their session.
                    Profiling can be disabled at any moment in the settings.
                </div>
                <group>
                    <field name="duration"/>
                    <field name="expiration"/>
                </group>
                <footer>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                    <button string="Enable profiling" type="object" name="submit" class="btn btn-primary" data-hotkey="q"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_menu_ir_profile" model="ir.actions.act_window">
        <field name="name">Ir profile</field>
        <field name="res_model">ir.profile</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_session': 1}</field>
    </record>

</odoo>
