<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_tree" model="ir.ui.view">
        <field name="name">res.company.list</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list string="Companies" decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field
                    name="image_1920"
                    widget="image"
                    width="30"
                    nolabel="1"
                    options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}"
                    invisible="not image_1920" />
                <field name="code" optional="show" />
                <field name="name" />
                <field name="partner_id" required="0" />
                <field
                    name="child_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}" />
            </list>
        </field>
    </record>

    <record id="view_res_company_kanban" model="ir.ui.view">
        <field name="name">res.company.kanban</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{!selection_mode ? 'text-center' : ''}">
                            <i
                                class="fa-solid fa-building"
                                role="img"
                                aria-label="Enterprise"
                                title="Enterprise" />
                            <field
                                name="code"
                                invisible="not code"
                                class="fw-bold fs-5" />
                            <field name="name" class="fs-6" />
                        </div>
                        <hr class="mt4 mb4" />
                        <div class="row" t-if="!selection_mode">
                            <div t-if="record.email.value" class="col-6 text-center">
                                <strong>Email:</strong>
                            </div>
                            <div
                                t-if="record.phone_ids.raw_value.length"
                                class="col-6 text-center">
                                <strong>Phone</strong>
                            </div>
                            <div t-if="record.email.value" class="col-6 text-center">
                                <field name="email" />
                            </div>
                            <div
                                t-if="record.phone_ids.raw_value.length"
                                class="col-6 text-center o_force_ltr">
                                <field name="phone_ids" widget="many2many_tags" />
                            </div>
                        </div>
                        <div t-else="">
                            <div t-if="record.email.value">
                                <strong>Email:</strong>
                                <field name="email" />
                            </div>
                            <div
                                t-if="record.phone_ids.raw_value.length"
                                class="o_force_ltr">
                                <strong>Phone:</strong>
                                <field name="phone_ids" widget="many2many_tags" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="Company" duplicate="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_all_company_branches"
                            type="object"
                            string="Branches"
                            icon="fa-sitemap"
                            invisible="not all_child_ids"
                            class="oe_stat_button" />
                    </div>
                    <div class="d-flex gap-2">
                        <field
                            name="image_1920"
                            widget="contact_image"
                            options="{'size': [100,100], 'img_class': 'rounded-4'}"
                            class="oe_avatar text-start float-none" />
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" placeholder="e.g. My Company" />
                            </h1>
                            <label for="code" />
                            <h2>
                                <field name="code" placeholder="e.g. MYCO" />
                            </h2>
                        </div>
                    </div>
                    <notebook colspan="4">
                        <page name="general_info" string="General Information">
                            <group>
                                <group>
                                    <field
                                        name="partner_id"
                                        string="Contact"
                                        groups="base.group_no_one"
                                        readonly="1"
                                        required="0" />
                                    <label for="street" string="Address" />
                                    <div class="o_address_format">
                                        <field
                                            name="street"
                                            placeholder="Street..."
                                            class="o_address_street" />
                                        <field
                                            name="street2"
                                            placeholder="Street 2..."
                                            class="o_address_street" />
                                        <field
                                            name="city"
                                            placeholder="City"
                                            class="o_address_city" />
                                        <field
                                            name="state_id"
                                            placeholder="State"
                                            context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"
                                            options="{'no_open': True, 'no_quick_create': True}"
                                            class="o_address_state" />
                                        <field
                                            name="zip"
                                            placeholder="ZIP"
                                            class="o_address_zip" />
                                        <field
                                            name="country_id"
                                            placeholder="Country"
                                            options="{'no_open': True, 'no_create': True}"
                                            class="o_address_country" />
                                    </div>
                                    <field name="vat" />
                                    <field
                                        name="company_registry_placeholder"
                                        invisible="1" />
                                    <field
                                        name="company_registry"
                                        options="{'placeholder_field': 'company_registry_placeholder'}" />
                                    <field
                                        name="currency_id"
                                        id="company_currency"
                                        context="{'active_test': False}"
                                        options="{'no_create': True, 'no_open': True}" />
                                </group>
                                <group>
                                    <field name="phone_ids" widget="many2many_tags" />
                                    <field name="email" />
                                    <field
                                        name="website"
                                        string="Website"
                                        placeholder="e.g. https://www.odoo.com"
                                        widget="url" />
                                    <field
                                        name="parent_id"
                                        groups="base.group_no_one" />
                                    <field name="color" widget="color_picker" />
                                </group>
                                <group name="social_media" />
                            </group>
                        </page>
                        <page name="branches" string="Branches">
                            <field
                                name="child_ids"
                                context="{'default_parent_id': id}" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_company_form" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.company</field>
        <field name="path">companies</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new company
            </p>
            <p>
                Create and manage the companies that will be managed by Odoo from here. Shops or
                subsidiaries can be created and maintained from here.
            </p>
        </field>
    </record>

</odoo>
