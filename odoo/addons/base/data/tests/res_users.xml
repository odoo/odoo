<?xml version="1.0" encoding="utf-8"?>
<data>
    <record id="test_user" model="res.users">
        <field name="name">Test User</field>
        <field name="company_id" ref="test_company"/>
            <field name="company_ids" eval="[Command.link(ref('test_company'))]"/>
        <field name="login">test</field>
        <field name="password">test</field>
    </record>

    <!-- Website/portal tours commonly log in as the admin user (login='admin') to view
         content created by tests under test_company. res.company.create() only grants access
         to the superuser automatically, so base.user_admin needs it explicitly. -->
    <record id="base.user_admin" model="res.users">
        <field name="company_ids" eval="[Command.link(ref('test_company'))]"/>
    </record>
</data>
